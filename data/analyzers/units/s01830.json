{"scene_id": "s01830", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01830.fountain", "heading": "INT. VICTORIAN PARLOR - EVENING", "cast": [{"id": 0, "name": "LADY CORDELIA ASHWORTH", "names": ["LADY CORDELIA ASHWORTH", "LADY CORDELIA"], "gender": "f", "first": 4, "spoke": 6}, {"id": 1, "name": "SIR REGINALD ASHWORTH", "names": ["SIR REGINALD ASHWORTH", "SIR REGINALD"], "gender": "m", "first": 4, "spoke": 3}, {"id": 2, "name": "PHILIPPA MARLOWE", "names": ["PHILIPPA MARLOWE", "PHILIPPA"], "gender": "f", "first": 6, "spoke": 1}, {"id": 3, "name": "EZEKIEL FROST", "names": ["EZEKIEL FROST", "MR. FROST"], "gender": "?", "first": 7, "spoke": 4}, {"id": 4, "name": "HARGREAVES", "names": ["HARGREAVES"], "gender": "?", "first": 8, "spoke": 4}, {"id": 5, "name": "CAPTAIN JULIAN VANE", "names": ["CAPTAIN JULIAN VANE", "CAPTAIN VANE"], "gender": "m", "first": 9, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. VICTORIAN PARLOR - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "1893.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Gaslight, heavy drapes, a piano no one has touched in years.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A dinner is being given and nothing has been eaten.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LADY CORDELIA ASHWORTH, 50s, black silk, sits very straight at the head of a small table.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Beside her, her husband SIR REGINALD ASHWORTH, 60s, whiskers waxed, studies a fork.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Opposite, their niece PHILIPPA MARLOWE, 20s, pale blue gown, turns her water glass a quarter turn and back.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Next to her, the family solicitor MR. EZEKIEL FROST, 50s, spectacles, holds a folded paper he has not yet unfolded.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "By the sideboard stands the butler HARGREAVES, 60s, white gloves, expressionless.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "And at the foot of the table, hat still on, sits CAPTAIN JULIAN VANE, 30s, in a regimental coat with one button missing.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "A clock ticks.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "Nobody lifts a spoon.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Hargreaves. The soup is cold.", "name": "LADY CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "It was cold when it was served, madam.", "name": "HARGREAVES", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Then take it away.", "name": "LADY CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Hargreaves does not move.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Sir Reginald sets the fork down.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Philippa stares at the captain's missing button.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Frost. You had something to read.", "name": "SIR REGINALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "I had, Sir Reginald. After dinner.", "name": "MR. FROST", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "There is no dinner.", "name": "SIR REGINALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Quite.", "name": "MR. FROST", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Mr. Frost unfolds the paper.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "He smooths it twice.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Captain Vane takes off his hat and sets it, crown down, beside his plate.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Philippa lifts her eyes to the ceiling.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "A bell rings in the hall.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "The house telephone, a new brass horn on the wall, rattles.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Hargreaves slips out to the hall.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "The receiver is lifted.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "His voice carries back through the open door.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Yes. Yes. I will convey it.", "name": "HARGREAVES", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "The receiver is set down with great care.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "He returns.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Well?", "name": "LADY CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "The constable, madam. He is at the gate.", "name": "HARGREAVES", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Captain Vane stands.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "His chair scrapes.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Sir Reginald does not look at him.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Julian.", "name": "PHILIPPA", "speaker": 2, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Sit down, Pippa.", "name": "CAPTAIN VANE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "She does not sit down, because she has not stood.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "She holds the glass.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Lady Cordelia dabs her mouth with a napkin that has touched nothing.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Reginald, the paper.", "name": "LADY CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Frost.", "name": "SIR REGINALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "\"I, Hartley Ashworth, being of sound mind--\"", "name": "MR. FROST", "speaker": 3, "ext": [], "paren": ["reading"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "Stop.", "name": "CAPTAIN VANE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "Captain, I must.", "name": "MR. FROST", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "Not that one. The other.", "name": "CAPTAIN VANE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "Mr. Frost turns the page over.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "There is a second sheet beneath it.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "He reads it silently.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "His face loses color.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "He passes it to Sir Reginald, who reads and passes it to his wife.", "para": 10, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "Lady Cordelia folds it into a square, then a smaller square, then places it in the candle flame.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "The paper curls and blackens.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "Nobody breathes.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "dialogue", "text": "Shall I admit the constable, madam?", "name": "HARGREAVES", "speaker": 4, "ext": [], "paren": ["at the door, quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "Not yet.", "name": "LADY CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "action", "text": "She takes up her spoon.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "She tastes the cold soup.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "She sets the spoon down.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "dialogue", "text": "Now.", "name": "LADY CORDELIA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}