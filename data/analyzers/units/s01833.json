{"scene_id": "s01833", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01833.fountain", "heading": "INT. DEPARTMENT STORE ELEVATOR - DAY", "cast": [{"id": 0, "name": "MISS GWENDOLYN FAIRWEATHER", "names": ["MISS GWENDOLYN FAIRWEATHER", "GWENDOLYN"], "gender": "f", "first": 4, "spoke": 27}, {"id": 1, "name": "HERBERT PUMPHREY", "names": ["HERBERT PUMPHREY", "HERBERT"], "gender": "m", "first": 5, "spoke": 27}], "units": [{"u": 0, "kind": "heading", "text": "INT. DEPARTMENT STORE ELEVATOR - DAY", "present": []}, {"u": 1, "kind": "action", "text": "An old brass-and-mahogany elevator with a folding gate.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A mirror on every wall.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Soft music from a hidden speaker.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MISS GWENDOLYN FAIRWEATHER, 30s, in a bright hat and white gloves, is the lift operator.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "HERBERT PUMPHREY, 50s, a floorwalker with a carnation in his lapel, stands in the corner clutching a hatbox.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Third floor. Ladies' gloves, hosiery, and sundries.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "I am not going to the third floor.", "name": "HERBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Then why did you press three?", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I did not press three. I pressed the nine.", "name": "HERBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "There is no nine.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "There is a nine. The nine is the executive offices.", "name": "HERBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "The executive offices are the eighth.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Miss Fairweather, I have worked in this store for twenty-two years.", "name": "HERBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "And in twenty-two years you've never learned the numbers?", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I know the numbers perfectly. It is you who has moved them.", "name": "HERBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "I operate the lift, Mr. Pumphrey. The floors are the floors.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Then explain the hatbox.", "name": "HERBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "What hatbox?", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "The one I am holding.", "name": "HERBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "You are holding that?", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "It was given to me by a woman on the second floor. She said, \"Take this to the manager.\" She did not say which manager.", "name": "HERBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Then it is likely for Mr. Trout.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Mr. Trout retired.", "name": "HERBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Then it is for his son.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "His son is on the ninth.", "name": "HERBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Which does not exist.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "You see my difficulty.", "name": "HERBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "I see two difficulties, Mr. Pumphrey, and neither is mine.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "What are they?", "name": "HERBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "You are carrying a box you cannot deliver, and you have been riding up and down for an hour.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "It has been forty minutes.", "name": "HERBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "It has been an hour. I have a log.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Then you are keeping a log of me?", "name": "HERBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Of the lift. You happened to be in it.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Miss Fairweather, I am not accustomed to being a happenstance.", "name": "HERBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Mr. Pumphrey, I am not accustomed to being accused of misplacing a floor.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Then what shall we do?", "name": "HERBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Open the box.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "It is not mine to open.", "name": "HERBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Whose is it?", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "The manager's.", "name": "HERBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Which manager?", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "That is the very question.", "name": "HERBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Then it belongs to whoever opens it first.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "That is not the law.", "name": "HERBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "It is the law of the elevator.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "Since when?", "name": "HERBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Since now.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Hold the box.", "name": "HERBERT", "speaker": 1, "ext": [], "paren": ["after a pause"], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "I'm operating the lift.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Hold it with one hand.", "name": "HERBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "I only have two, Mr. Pumphrey, and both are in use.", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "Then I shall open it myself.", "name": "HERBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "He lifts the lid.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "The music swells, a harp glissando, unaccountably.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "Gwendolyn leans in.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "They both look.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "Well?", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "It is a hat.", "name": "HERBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "What sort of hat?", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "A very ugly hat.", "name": "HERBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "Whose?", "name": "GWENDOLYN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "Yours.", "name": "HERBERT", "speaker": 1, "ext": [], "paren": ["reading the label"], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "Gwendolyn takes off her bright hat, looks at it, looks at the hatbox, and begins to laugh.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "After a moment Herbert, appalled, joins her.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "The elevator stops.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 67, "kind": "action", "text": "The gate rattles.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "Neither moves.", "para": 4, "sent": 2, "present": [0, 1]}]}