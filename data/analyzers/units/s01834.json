{"scene_id": "s01834", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01834.fountain", "heading": "INT. CLINIC WAITING ROOM - NIGHT", "cast": [{"id": 0, "name": "ANGELIQUE MBEKI", "names": ["ANGELIQUE MBEKI", "ANGELIQUE"], "gender": "?", "first": 3, "spoke": 4}, {"id": 1, "name": "PETRUS", "names": ["PETRUS"], "gender": "?", "first": 4, "spoke": 3}, {"id": 2, "name": "ZANELE", "names": ["ZANELE"], "gender": "?", "first": 5, "spoke": 1}, {"id": 3, "name": "ABERNATHY GRIGGS", "names": ["ABERNATHY GRIGGS"], "gender": "m", "first": 6, "spoke": 0}, {"id": 4, "name": "NURSE", "names": ["NURSE"], "gender": "?", "first": 7, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. CLINIC WAITING ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Vinyl chairs bolted in rows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A television mounted high plays a muted game show.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "ANGELIQUE MBEKI, 40s, scrubs under a parka, sits with a clipboard.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "Her husband PETRUS, 40s, jiggles one knee.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Their daughter ZANELE, 16, earbuds in, stares at the floor.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "An old man, MR. ABERNATHY GRIGGS, 80s, dozes.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "A NURSE, 30s, stands behind the glass.", "para": 1, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "The intercom crackles.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Mbeki family?", "name": "NURSE", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Angelique stands.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Yes.", "name": "ANGELIQUE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Dr. Okafor will see you now.", "name": "NURSE", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Finally.", "name": "PETRUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Petrus.", "name": "ANGELIQUE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Four hours.", "name": "PETRUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Petrus.", "name": "ANGELIQUE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "He stops.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Zanele takes out one earbud.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Is it Gran?", "name": "ZANELE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Nobody answers.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "The buzzer sounds on the inner door.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Mr. Griggs wakes, looks at them, and closes his eyes again.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Petrus shoves the nearest chair.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "It scrapes six inches across the tile, and the whole room hears it.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Not here.", "name": "ANGELIQUE", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Then where?", "name": "PETRUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}