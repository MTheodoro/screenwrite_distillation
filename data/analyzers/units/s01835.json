{"scene_id": "s01835", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01835.fountain", "heading": "EXT. DRY CREEK BED - SUNSET", "cast": [{"id": 0, "name": "MARSHAL JEB TRASK", "names": ["MARSHAL JEB TRASK", "TRASK"], "gender": "m", "first": 4, "spoke": 9}, {"id": 1, "name": "ALMA SOTELO", "names": ["ALMA SOTELO", "ALMA"], "gender": "?", "first": 8, "spoke": 8}, {"id": 2, "name": "TOMASO", "names": ["TOMASO"], "gender": "?", "first": 11, "spoke": 2}, {"id": 3, "name": "DEPUTY HOLLIS FINCH", "names": ["DEPUTY HOLLIS FINCH", "HOLLIS"], "gender": "m", "first": 14, "spoke": 3}, {"id": 4, "name": "^TOMASO", "names": ["^TOMASO"], "gender": "?", "first": 35, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DRY CREEK BED - SUNSET", "present": []}, {"u": 1, "kind": "action", "text": "Cracked clay.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A dead cottonwood.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Four riders have dismounted.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MARSHAL JEB TRASK, 50s.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Gray mustache.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Badge pinned crooked.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "He watches.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Across the dry bed, ALMA SOTELO, 30s.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Rifle across her saddle.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Black hat.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Beside her, her brother TOMASO, 20s.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Hand on his holster.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Sweat.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Behind them, DEPUTY HOLLIS FINCH, 19.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Shotgun.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Too big for him.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Nobody speaks.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Wind.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "A tumbleweed rolls through, stops against Trask's boot.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Alma.", "name": "TRASK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Marshal.", "name": "ALMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Long ride.", "name": "TRASK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Longer back.", "name": "ALMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Tomaso laughs, high and nervous.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Don't talk to him, Alma.", "name": "TOMASO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Be quiet, Tomaso.", "name": "ALMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "You've got the mule.", "name": "TRASK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "It's my mule.", "name": "ALMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "It was Dalton's.", "name": "TRASK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Alma shrugs.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Hollis licks his lips.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Marshal, I got a bad feeling.", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Everybody has.", "name": "TRASK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Everybody has.", "name": "ALMA", "speaker": 1, "ext": [], "paren": ["simultaneously"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Everybody has.", "name": "^TOMASO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Silence.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Trask almost smiles.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Alma. Put the rifle down.", "name": "TRASK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "You first.", "name": "ALMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Hollis.", "name": "TRASK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Sir?", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Put yours down.", "name": "TRASK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Sir?", "name": "HOLLIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Do it.", "name": "TRASK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Hollis lowers the shotgun.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Trask unbuckles his gun belt, drops it.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Alma watches.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Slowly she slides the rifle from the saddle and lays it flat in the dust.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Tomaso does not move.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Tomaso.", "name": "ALMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "They'll hang us.", "name": "TOMASO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "They'll hang you. Not me.", "name": "ALMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "She turns her back on the marshal.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "Walks to Tomaso.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Takes his gun hand in both of hers.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Opens the fingers one at a time.", "para": 13, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "The pistol falls.", "para": 13, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Trask exhales.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "Hollis sits down on the clay.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "The tumbleweed rolls on.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4]}]}