{"scene_id": "s01836_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01836.fountain", "heading": "INT. TELEGRAPH OFFICE - CONTINUOUS", "cast": [{"id": 0, "name": "CLEM", "names": ["CLEM"], "gender": "f", "first": 6, "spoke": 17}, {"id": 1, "name": "ODOM", "names": ["ODOM"], "gender": "f", "first": 6, "spoke": 0}, {"id": 2, "name": "MARCUS", "names": ["MARCUS", "STRANGER"], "gender": "m", "first": 9, "spoke": 17}, {"id": 3, "name": "VOICE ON THE WIRE", "names": ["VOICE ON THE WIRE"], "gender": "m", "first": 26, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. TELEGRAPH OFFICE - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "A narrow room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A counter with brass grille.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A key and sounder on a desk, silent.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A wall clock stopped at 4:10.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Dust motes hang in a bar of light from the lone window.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "CLEMENTINE \"CLEM\" ODOM, 40s, sits behind the counter in a sleeve garter and green eyeshade.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Lean, quiet, careful with her hands.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She is sorting tickets into pigeonholes when the bell on the door jingles.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "A STRANGER enters.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Late thirties, a long gray coat patched at the elbow, a hat pulled low over a face the sun has worked on for years.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He carries a saddlebag over one shoulder and does not take it off.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Afternoon.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Afternoon.", "name": "CLEM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "You the operator?", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "I am.", "name": "CLEM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "I need to send a wire.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Where to?", "name": "CLEM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Cheyenne.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "She slides a form across the counter and a pencil beside it.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "He looks at the pencil, then at her, and picks it up with his left hand.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Clem notes this and says nothing.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Fifteen words for a quarter. Each one after is two cents.", "name": "CLEM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "I'll keep it short.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "He writes slowly.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Clem returns to her pigeonholes, but watches him sidelong.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The saddlebag shifts on his shoulder with a faint metallic clink.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "That heavy?", "name": "CLEM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Some.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "You can set it down.", "name": "CLEM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "I'm fine.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "He finishes, pushes the form back.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "She reads it, lips barely moving.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "\"Arrived. Will wait. Send word by Tuesday.\" No name.", "name": "CLEM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "No name.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "They'll want to know who it's from.", "name": "CLEM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "They'll know.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "A silence.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "The sounder on the desk begins to chatter, a rapid stutter of clicks.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Clem turns, listens, takes up a pencil, and writes on a pad as the code runs.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Her face changes by degrees.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "The Stranger watches her pencil.", "para": 6, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "You want to tell me your name, mister?", "name": "CLEM", "speaker": 0, "ext": ["CONT'D"], "paren": ["without turning"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Why?", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Because this just came over the line for a man matching your description.", "name": "CLEM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "She tears off the sheet, holds it up between two fingers.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "He doesn't take it.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "What's it say?", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "It says \"Deputy Marcus Reyes, lawman, last seen heading north with a stolen payroll.\"", "name": "CLEM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "The Stranger's right hand drifts toward his coat.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Clem's drifts under the counter.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Ma'am.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Marcus.", "name": "CLEM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "He stops.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Put your hand where I can see it.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "I will when you've shown me yours.", "name": "CLEM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "He slowly lifts both hands away from his coat.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "The saddlebag slides to the floor with a heavy chunk.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "That's not the payroll.", "name": "MARCUS", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "Then what is it?", "name": "CLEM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "Evidence.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "Of what?", "name": "CLEM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "Of who took it.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "Clem's hand comes up from beneath the counter, empty.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "She lays the sheet down on the grille.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "Then you'd best read the rest of this.", "name": "CLEM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "He steps up, reads.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "His lips tighten.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "The sounder chatters again.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "dialogue", "text": "Marshal's office confirms. Reyes is clean. Hold him. Dangerous man trails.", "name": "VOICE ON THE WIRE", "speaker": 3, "ext": ["V.O."], "paren": ["telegraph operator, Cheyenne; read aloud by Clem"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "Marcus lifts his eyes from the page and meets Clem's.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "Outside, at the end of the street, the clatter of hooves begins and grows.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "That'd be your dangerous man.", "name": "CLEM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "Lock the door.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "She does.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "He pulls the shade.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "In the dim, they stand a pace apart, listening, while the hoofbeats come on and the sounder, on its desk, goes quiet.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}]}