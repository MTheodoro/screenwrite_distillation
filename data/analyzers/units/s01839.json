{"scene_id": "s01839", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01839.fountain", "heading": "INT. THRONE ROOM OF THE GLASS KING - NIGHT", "cast": [{"id": 0, "name": "KING ORIVEN CLEAR", "names": ["KING ORIVEN CLEAR", "KING ORIVEN"], "gender": "m", "first": 4, "spoke": 7}, {"id": 1, "name": "LADY MYRRHEN", "names": ["LADY MYRRHEN"], "gender": "?", "first": 5, "spoke": 2}, {"id": 2, "name": "SER BRANDOLF GRAYMANE", "names": ["SER BRANDOLF GRAYMANE", "SER BRANDOLF"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "GRIMBOLD STONEHAND", "names": ["GRIMBOLD STONEHAND", "GRIMBOLD"], "gender": "f", "first": 7, "spoke": 3}, {"id": 4, "name": "THISTLE", "names": ["THISTLE"], "gender": "f", "first": 7, "spoke": 5}, {"id": 5, "name": "BROTHER ANSELM", "names": ["BROTHER ANSELM"], "gender": "?", "first": 7, "spoke": 3}, {"id": 6, "name": "^SER BRANDOLF", "names": ["^SER BRANDOLF"], "gender": "?", "first": 6, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. THRONE ROOM OF THE GLASS KING - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A hall of translucent pillars lit from within by drifting blue flame.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Snow falls indoors from a ceiling that has no ceiling.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "At the far end, a crystalline throne.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "KING ORIVEN THE CLEAR, 60s, crowned in frost, sits motionless upon it.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "At his right stands his sorceress sister LADY MYRRHEN, 50s, hooded.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "To his left, the captain of his guard, SER BRANDOLF GRAYMANE, 40s, in silver plate.", "para": 1, "sent": 2, "present": [0, 1, 2, 6]}, {"u": 7, "kind": "action", "text": "Before the throne, kneeling on cold stone, are three travelers: a tattooed dwarf-smith named GRIMBOLD STONEHAND, a young archer with a green scarf named THISTLE, and a robed monk named BROTHER ANSELM.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 8, "kind": "action", "text": "Snowflakes catch on their shoulders.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 9, "kind": "dialogue", "text": "Rise.", "name": "KING ORIVEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "action", "text": "They rise.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "action", "text": "Thistle stumbles.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "action", "text": "Grimbold steadies her.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "You carry the Ember.", "name": "KING ORIVEN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "We carry nothing.", "name": "GRIMBOLD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "We carry a letter.", "name": "THISTLE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "We carry a request.", "name": "BROTHER ANSELM", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "They carry the Ember.", "name": "LADY MYRRHEN", "speaker": 1, "ext": [], "paren": ["simultaneously"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "They carry a lie.", "name": "^SER BRANDOLF", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "action", "text": "King Oriven raises one hand.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "action", "text": "Silence.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "action", "text": "A flake lands on his open palm and does not melt.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Show me the letter.", "name": "KING ORIVEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "Thistle fumbles at her satchel.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "Grimbold holds up his hand to stop her.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "It's not for you.", "name": "GRIMBOLD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "You speak to a king.", "name": "SER BRANDOLF", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "I speak to a man with a very cold hall.", "name": "GRIMBOLD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "Grimbold.", "name": "THISTLE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "Peace, friends. Majesty, the letter is for the Queen of the Ash Court.", "name": "BROTHER ANSELM", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "There is no Queen of the Ash Court.", "name": "LADY MYRRHEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "There was.", "name": "BROTHER ANSELM", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "The Ash Court burned.", "name": "SER BRANDOLF", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "That's why we need her.", "name": "THISTLE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "Enough.", "name": "KING ORIVEN", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "Everyone stops.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "He stands, slowly, his crown ringing like a struck bell.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "He descends one step, then another.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "He stops in front of Thistle and looks into her scarf, her face, her quiver.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "Child. Who gave you that scarf?", "name": "KING ORIVEN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "My mother.", "name": "THISTLE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "dialogue", "text": "And her name?", "name": "KING ORIVEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "dialogue", "text": "Ashlyn.", "name": "THISTLE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "Lady Myrrhen's hood falls back.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "Ser Brandolf's hand lowers from his sword.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "action", "text": "King Oriven closes his eyes.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "dialogue", "text": "Then the letter is for me.", "name": "KING ORIVEN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}