{"scene_id": "s01840", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01840.fountain", "heading": "INT. MIDNIGHT BOWLING ALLEY - NIGHT", "cast": [{"id": 0, "name": "RICO VALDEZ", "names": ["RICO", "RICO VALDEZ"], "gender": "?", "first": 4, "spoke": 24}, {"id": 1, "name": "DAISY MORALES", "names": ["DAISY MORALES", "DAISY"], "gender": "m", "first": 22, "spoke": 24}], "units": [{"u": 0, "kind": "heading", "text": "INT. MIDNIGHT BOWLING ALLEY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Lane 14.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Neon pins.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The ball return coughs.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A scoreboard overhead flickers and shows two names: RICO and BLANK.", "para": 0, "sent": 3, "present": [0]}, {"u": 5, "kind": "action", "text": "RICO VALDEZ, 40s, a heavy man in a purple league shirt, sits on the bench retying his shoes.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "His ball is a scuffed black orb with initials in gold.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "He has bowled a perfect game twice in his life, and tonight he is eleven frames in.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "On the lane beside him, no one.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "The scoreboard says BLANK.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "The seat is empty.", "para": 2, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "He rises, takes the ball, steps to the line.", "para": 3, "sent": 0, "present": [0]}, {"u": 12, "kind": "action", "text": "He breathes.", "para": 3, "sent": 1, "present": [0]}, {"u": 13, "kind": "action", "text": "Rolls.", "para": 3, "sent": 2, "present": [0]}, {"u": 14, "kind": "action", "text": "The ball hooks gently and blasts the pocket.", "para": 3, "sent": 3, "present": [0]}, {"u": 15, "kind": "action", "text": "Strike.", "para": 3, "sent": 4, "present": [0]}, {"u": 16, "kind": "action", "text": "The scoreboard dings.", "para": 3, "sent": 5, "present": [0]}, {"u": 17, "kind": "action", "text": "He does not celebrate.", "para": 4, "sent": 0, "present": [0]}, {"u": 18, "kind": "action", "text": "He walks to the ball return and waits.", "para": 4, "sent": 1, "present": [0]}, {"u": 19, "kind": "action", "text": "A shadow falls across the approach.", "para": 5, "sent": 0, "present": [0]}, {"u": 20, "kind": "action", "text": "A figure stands in the doorway of the lane, small, a tiny silhouette.", "para": 5, "sent": 1, "present": [0]}, {"u": 21, "kind": "action", "text": "A girl, maybe nine, in a pink hoodie, holds a ball two sizes too heavy for her.", "para": 5, "sent": 2, "present": [0]}, {"u": 22, "kind": "action", "text": "The girl is DAISY MORALES, and she has been looking at him since the ninth frame.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Closed to the public.", "name": "RICO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "I'm not the public.", "name": "DAISY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Who are you, then?", "name": "RICO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "The next frame.", "name": "DAISY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "That's not a thing.", "name": "RICO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "It is on your scoreboard.", "name": "DAISY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "He turns.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "The scoreboard above reads BLANK.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "As he watches, the letters rearrange.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "DAISY.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Somebody typed that.", "name": "RICO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Somebody did.", "name": "DAISY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Who?", "name": "RICO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "My dad. He said you'd show me how.", "name": "DAISY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Your dad.", "name": "RICO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "He bowled here. Before.", "name": "DAISY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Before what?", "name": "RICO", "speaker": 0, "ext": [], "paren": ["slowly"], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Before you took the last frame.", "name": "DAISY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Rico stares.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "The ball return rumbles.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "His ball rolls up and bumps against his hand, and he does not pick it up.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Kid. What's your father's name?", "name": "RICO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Manuel.", "name": "DAISY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Manny Morales.", "name": "RICO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "Yes.", "name": "DAISY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Manny's dead.", "name": "RICO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "I know.", "name": "DAISY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "He had a seven-ten split in the tenth. Twenty-three years ago. I bowled against him.", "name": "RICO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "He said you let him have it.", "name": "DAISY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "I didn't let him.", "name": "RICO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "He said you did.", "name": "DAISY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "He missed. He missed the seven.", "name": "RICO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "He didn't miss. You moved the pin.", "name": "DAISY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "Rico laughs, a dry bark.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "Then he stops.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "Who told you that?", "name": "RICO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "My dad. In a letter. He wrote it before.", "name": "DAISY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "Before.", "name": "RICO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "He wanted me to ask you why.", "name": "DAISY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "Rico sinks onto the bench.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "The neon buzzes.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "Daisy walks the length of the lane toward him, ball dragging, until she stands in front of him.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "Because I was twenty-two, kid. Because I wanted to be the guy who bowled a three hundred in the state final. And he was better, and I knew it.", "name": "RICO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "So you cheated.", "name": "DAISY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "I did.", "name": "RICO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "Did you win?", "name": "DAISY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "I won.", "name": "RICO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "Did you bowl three hundred?", "name": "DAISY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "dialogue", "text": "No. Two seventy-one.", "name": "RICO", "speaker": 0, "ext": [], "paren": ["barely audible"], "dual": false, "present": [0, 1]}, {"u": 72, "kind": "dialogue", "text": "Dad said you'd say two seventy-one.", "name": "DAISY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "Silence.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 74, "kind": "action", "text": "Rico looks at her, at the ball, at the empty lane.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 75, "kind": "dialogue", "text": "What do you want from me?", "name": "RICO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 76, "kind": "dialogue", "text": "Show me how to throw.", "name": "DAISY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 77, "kind": "dialogue", "text": "That's all?", "name": "RICO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 78, "kind": "dialogue", "text": "That's all.", "name": "DAISY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 79, "kind": "action", "text": "He rises.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 80, "kind": "action", "text": "He places her fingers in the holes.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 81, "kind": "action", "text": "He adjusts her wrist.", "para": 12, "sent": 2, "present": [0, 1]}, {"u": 82, "kind": "dialogue", "text": "Don't look at the pins. Look at the arrow.", "name": "RICO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 83, "kind": "dialogue", "text": "Which arrow?", "name": "DAISY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 84, "kind": "dialogue", "text": "The one in the middle.", "name": "RICO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 85, "kind": "action", "text": "She rolls.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 86, "kind": "action", "text": "The ball wobbles down the lane, drifts left, and drops into the gutter.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 87, "kind": "action", "text": "Daisy deflates.", "para": 13, "sent": 2, "present": [0, 1]}, {"u": 88, "kind": "dialogue", "text": "That's bad.", "name": "DAISY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 89, "kind": "dialogue", "text": "That's a start.", "name": "RICO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 90, "kind": "dialogue", "text": "Again?", "name": "DAISY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 91, "kind": "action", "text": "He fetches her ball.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 92, "kind": "action", "text": "She rolls.", "para": 14, "sent": 1, "present": [0, 1]}, {"u": 93, "kind": "action", "text": "It strikes three pins.", "para": 14, "sent": 2, "present": [0, 1]}, {"u": 94, "kind": "action", "text": "She jumps.", "para": 14, "sent": 3, "present": [0, 1]}, {"u": 95, "kind": "action", "text": "Rico, for the first time in the scene, smiles, and the scoreboard dings.", "para": 14, "sent": 4, "present": [0, 1]}]}