{"scene_id": "s01841", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01841.fountain", "heading": "INT. FISH MARKET OFFICE - EARLY MORNING", "cast": [{"id": 0, "name": "MIRIAM KOSKI", "names": ["MIRIAM KOSKI", "MIRIAM"], "gender": "f", "first": 4, "spoke": 3}, {"id": 1, "name": "DETECTIVE ANSEL WOO", "names": ["DETECTIVE ANSEL WOO", "WOO"], "gender": "?", "first": 7, "spoke": 3}, {"id": 2, "name": "DETECTIVE RUTH DELACROIX", "names": ["DETECTIVE RUTH DELACROIX", "RUTH"], "gender": "?", "first": 9, "spoke": 2}, {"id": 3, "name": "ENZO FERRARA", "names": ["ENZO FERRARA", "ENZO"], "gender": "f", "first": 10, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. FISH MARKET OFFICE - EARLY MORNING", "present": []}, {"u": 1, "kind": "action", "text": "A glass-walled office above the ice floor.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fluorescent hum.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A wall calendar of tuna.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MIRIAM KOSKI, 50s, the market's bookkeeper, sits at a steel desk.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her ledger is open.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Her cardigan smells faintly of brine.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "Across from her sits DETECTIVE ANSEL WOO, 40s, notebook out.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He smiles pleasantly.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Behind him, leaning on the filing cabinet, is his partner DETECTIVE RUTH DELACROIX, 30s, silent, chewing gum.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Near the door stands the owner, ENZO FERRARA, 60s, in rubber boots, wiping his hands on a rag.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "He has been wiping them for some time.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Quiet morning.", "name": "WOO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "They start at four.", "name": "MIRIAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "And the books balance.", "name": "WOO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "They always balance.", "name": "MIRIAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Ruth pushes off the cabinet and drifts to the window.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Enzo steps aside to let her pass, and as she goes by she picks a pen off the desk, rolls it in her fingers, sets it back.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Miriam watches the pen.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Woo flips a page of the notebook.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Enzo tosses the rag onto a chair, crosses the room to the door, and locks it, quietly, with a click that makes Miriam's shoulders lift.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Ruth turns from the window.", "para": 4, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Miriam. Where's the second ledger?", "name": "RUTH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "There isn't a second.", "name": "MIRIAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "She says there isn't.", "name": "RUTH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "He says there isn't, too.", "name": "WOO", "speaker": 1, "ext": [], "paren": ["to Enzo"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "There isn't.", "name": "ENZO", "speaker": 3, "ext": [], "paren": ["tight smile"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Miriam lowers her eyes to the ledger.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Her finger finds a column, and a drop of sweat falls onto the page.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}]}