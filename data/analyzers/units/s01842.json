{"scene_id": "s01842", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01842.fountain", "heading": "EXT. WAGON CIRCLE - DUSK", "cast": [{"id": 0, "name": "WALT BREDEN", "names": ["WALT BREDEN", "WALT"], "gender": "m", "first": 6, "spoke": 4}, {"id": 1, "name": "DOROTHEA", "names": ["DOROTHEA"], "gender": "f", "first": 7, "spoke": 3}, {"id": 2, "name": "HENRY", "names": ["HENRY"], "gender": "?", "first": 8, "spoke": 3}, {"id": 3, "name": "LUIS ARRIAGA", "names": ["LUIS ARRIAGA", "LUIS"], "gender": "m", "first": 9, "spoke": 3}, {"id": 4, "name": "CATHERINE MULDOON", "names": ["CATHERINE MULDOON", "CATHERINE"], "gender": "f", "first": 10, "spoke": 1}, {"id": 5, "name": "ABEL", "names": ["ABEL"], "gender": "?", "first": 11, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. WAGON CIRCLE - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "Six wagons drawn into a ring on a wind-scoured flat.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A fire burns low in the center.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The sky is bruise-colored.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Far off, a coyote starts and stops.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The company is at supper.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "WALT BREDEN, 50s, the wagon master, sits on an upturned barrel with a tin plate on his knee.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "His wife DOROTHEA, 40s, stirs the pot and slaps a fly off her arm.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Their son HENRY, 13, whittles a stick to nothing.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "The scout LUIS ARRIAGA, 30s, squats by the fire with a coffee pot, pouring into mismatched cups for the others.", "para": 1, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "The widow CATHERINE MULDOON, 60s, rocks in a canvas chair, knitting, her needles clicking.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "And the stranger they picked up two days back, a heavy-set man with a limp who calls himself ABEL, 40s, sits a little way off with his plate untouched.", "para": 1, "sent": 6, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "Nobody says much.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "The knitting needles click.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "We make the river by Thursday if the oxen hold.", "name": "WALT", "speaker": 0, "ext": [], "paren": ["to everyone"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "They'll hold. It's the wheels I'd worry about.", "name": "LUIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Eat your beans.", "name": "DOROTHEA", "speaker": 1, "ext": [], "paren": ["to Henry"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "I'm not hungry.", "name": "HENRY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Eat them anyway.", "name": "DOROTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Walt sets his plate aside, rises, and walks the length of the circle with his thumbs in his belt, checking each wagon's brake.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Luis fills his own cup.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Catherine knits.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Henry flips the stick into the fire.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Dorothea snatches the plate from his hands and hands it to Abel instead, who accepts it with a nod and begins to eat.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Walt, at the far wagon, stops and mutters to himself.", "para": 3, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Third spoke's cracked.", "name": "WALT", "speaker": 0, "ext": [], "paren": ["muttered"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "What's that?", "name": "LUIS", "speaker": 3, "ext": [], "paren": ["from the fire"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Nothing.", "name": "WALT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "He kneels to inspect it.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Catherine's needles stop.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "There's a rider.", "name": "CATHERINE", "speaker": 4, "ext": [], "paren": ["to no one in particular"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Everyone turns.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Far across the flat, a single horseman crests a low rise and halts, black against the afterglow.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Is it Indians?", "name": "HENRY", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Hush.", "name": "DOROTHEA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "He's alone.", "name": "LUIS", "speaker": 3, "ext": [], "paren": ["low, to Walt"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Then he's no trouble. Henry, fetch the rifle.", "name": "WALT", "speaker": 0, "ext": [], "paren": ["rising"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Yes, sir.", "name": "HENRY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "He scrambles to the wagon, rummages, returns with it.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Walt takes it, checks the chamber, and lays it across his arm.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Abel has stopped eating.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "He has set his plate on the ground and is looking, not at the rider, but at Luis, who is looking back.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Catherine resumes her knitting.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "The rider does not move.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "The fire pops.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Told him not to follow.", "name": "ABEL", "speaker": 5, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Nobody hears him but Luis.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}