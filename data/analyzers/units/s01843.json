{"scene_id": "s01843", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01843.fountain", "heading": "INT. TRAUMA BAY - NIGHT", "cast": [{"id": 0, "name": "SADIE OYELARAN", "names": ["SADIE OYELARAN", "SADIE"], "gender": "f", "first": 5, "spoke": 17}, {"id": 1, "name": "BEN", "names": ["BEN"], "gender": "f", "first": 6, "spoke": 7}, {"id": 2, "name": "KOWALCZYK", "names": ["KOWALCZYK"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "ILSE VANTERPOOL", "names": ["ILSE VANTERPOOL", "ILSE"], "gender": "f", "first": 7, "spoke": 4}, {"id": 4, "name": "MOSES HARGROVE", "names": ["MOSES HARGROVE", "HARGROVE"], "gender": "m", "first": 8, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. TRAUMA BAY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A curtained bay under hard white light.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Monitors beep.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A gurney sits canted in the center, stained sheets bunched at the foot.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Instruments on a steel tray, a red crash cart, a clock that reads 2:47.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. SADIE OYELARAN, 30s, surgical cap, sleeves pushed up, stands over the gurney with both hands on the chest of an unseen patient and counts under her breath.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across the gurney, NURSE BENEDICT \"BEN\" KOWALCZYK, 40s, squeezes a bag-valve mask on a rhythm.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "At the foot, with a clipboard, stands the resident DR. ILSE VANTERPOOL, 20s, pale, hair coming loose.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Nearest the door, arms folded, watches the attending, DR. MOSES HARGROVE, 60s, silver hair, a stethoscope draped like a scarf.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Thirty. Check.", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "No pulse.", "name": "BEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Again.", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "She resumes compressions.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "The monitor spikes, flatlines, spikes.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Ilse writes a note and drops the pen.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Dr. Hargrove, we're at twelve minutes.", "name": "ILSE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "I can read a clock, Dr. Vanterpool.", "name": "HARGROVE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Sir, I think we should--", "name": "ILSE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Think quietly.", "name": "HARGROVE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Sadie, your arms.", "name": "BEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "They're fine.", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Switch with me.", "name": "BEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "I said they're fine.", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "He lets go of the mask, rounds the gurney, and puts a hand on her shoulder.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "She does not look up.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "He waits.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "After a beat she steps aside, wiping her brow with her forearm, and he takes her place.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "She takes the bag-valve mask.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Ben. Count.", "name": "SADIE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "One, two, three, four.", "name": "BEN", "speaker": 1, "ext": [], "paren": ["compressing"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "The monitor beeps once.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Everyone freezes.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "It beeps again, uneven.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Ilse looks up.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Hargrove uncrosses his arms.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "That's a rhythm.", "name": "ILSE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "That's an artifact.", "name": "HARGROVE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "That's a rhythm.", "name": "SADIE", "speaker": 0, "ext": [], "paren": ["still bagging"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Dr. Oyelaran.", "name": "HARGROVE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Look at the screen, Moses.", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "He does.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "A ragged line climbs and descends, climbs and descends.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Pulse. I've got a pulse.", "name": "BEN", "speaker": 1, "ext": [], "paren": ["breathless"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Pressure?", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Seventy over forty.", "name": "ILSE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Fluids. Wide open.", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Ilse darts to the cart.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Hargrove steps forward, takes the stethoscope from his neck, presses it to the patient's chest, and listens.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "The line on the monitor holds.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "He straightens slowly.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Good work.", "name": "HARGROVE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "That's not a thing you say. That's a thing you do.", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "Meaning?", "name": "HARGROVE", "speaker": 4, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "Meaning you called time of death in your head six minutes ago.", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "I did not.", "name": "HARGROVE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "You did.", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Ben's compressions slow.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "Ilse has stopped midway to the cart.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "Sadie.", "name": "BEN", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "No. He did. Say it, Moses.", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "I did.", "name": "HARGROVE", "speaker": 4, "ext": [], "paren": ["after a long pause"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "Thank you.", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "She steps back, peels off a glove, and flexes her hand.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "Ben takes the mask and bags, gently.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "Ilse brings a bag of fluids and hangs it on the pole.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "The monitor beeps on, steady, small, alive.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "Hargrove turns to the door.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "action", "text": "He pauses there, back to them.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "dialogue", "text": "I'll tell the family.", "name": "HARGROVE", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "dialogue", "text": "No. I will.", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "dialogue", "text": "They'll ask who made the call.", "name": "HARGROVE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "dialogue", "text": "Then I'll tell them she did.", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "action", "text": "She looks at Ilse.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "action", "text": "Ilse looks at her.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "action", "text": "Neither says anything.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "action", "text": "Hargrove exits.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 76, "kind": "action", "text": "The curtain swings behind him.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "Sadie leans over the sink and runs cold water over her wrists.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "action", "text": "Ben watches her.", "para": 11, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "dialogue", "text": "You okay?", "name": "BEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "dialogue", "text": "Ask me in an hour.", "name": "SADIE", "speaker": 0, "ext": [], "paren": ["to the water"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "action", "text": "Ilse pulls the sheet up over the patient's chest and, after a moment, tucks it under the chin as if the patient were a child.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}]}