{"scene_id": "s01845", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01845.fountain", "heading": "INT. CHEESE CAVE - DAY", "cast": [{"id": 0, "name": "BARNABY QUILL", "names": ["BARNABY QUILL", "BARNABY"], "gender": "?", "first": 4, "spoke": 20}, {"id": 1, "name": "INGRID SOLBERG", "names": ["INGRID SOLBERG", "INGRID"], "gender": "?", "first": 5, "spoke": 20}, {"id": 2, "name": "^INGRID", "names": ["^INGRID"], "gender": "?", "first": 39, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. CHEESE CAVE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Damp stone.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wheels of cheese on wooden racks stretch into the dark.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single bare bulb.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "BARNABY QUILL, 40s, in a hairnet and white coat, taps a wheel with a wooden mallet and listens.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Behind him stands INGRID SOLBERG, 30s, an inspector in a lanyard, with a clipboard and a thermometer.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Mr. Quill. Your humidity's at ninety-four percent.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "That's the idea.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "The code says ninety.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "The cheese says ninety-four.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "The cheese doesn't write the code.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "The cheese is older than the code.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She checks her clipboard.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He taps another wheel.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "There's mold on the north wall.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "That's a feature.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "It's black.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "That's a deluxe feature.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "It's growing on the cheese.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "That's the cheese.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Mr. Quill.", "name": "INGRID", "speaker": 1, "ext": [], "paren": ["flat"], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Ms. Solberg.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "She thrusts the thermometer into the nearest wheel.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "A long beat.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She pulls it out and reads it.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Fifty-four degrees.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Perfect.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "It should be fifty.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Perfect plus four.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "I'm writing you up.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "You're writing me up for being warm?", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "For several things.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Name three.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Humidity. Temperature. Mold.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Name a fourth.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Smell.", "name": "INGRID", "speaker": 1, "ext": [], "paren": ["pausing, scanning the room"], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Now you're getting it.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": ["delighted"], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "It's not a compliment.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "It's not a crime.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": ["simultaneously"], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "It's not a compliment.", "name": "^INGRID", "speaker": 2, "ext": [], "paren": ["simultaneously"], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "They stare at each other.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "The bulb flickers.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "A drop of water lands on her clipboard.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Ms. Solberg, would you like to taste?", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "No.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Just a sliver.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "I am an inspector. I cannot be bribed.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "It's not a bribe. It's an appetizer.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "She hesitates.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "He cuts a thin wedge with a wire, offers it on the blade.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "She takes it between two fingers, sniffs, and chews once.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Her eyes close.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Oh, no.", "name": "INGRID", "speaker": 1, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Yes.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "Oh, that's unfair.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "Ninety-four percent.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "She sits down on a wheel of cheese, still chewing, and writes a single line on the clipboard.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "\"Approved with reservations.\"", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "What reservations?", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "That I get another piece.", "name": "INGRID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}