{"scene_id": "s01846", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01846.fountain", "heading": "INT. DERELICT TERRAFORMING STATION - ATRIUM - DAY", "cast": [{"id": 0, "name": "SERAFINA KOWALSKI", "names": ["SERAFINA KOWALSKI", "SERAFINA"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "ISAAC WREN", "names": ["ISAAC WREN", "ISAAC"], "gender": "?", "first": 8, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. DERELICT TERRAFORMING STATION - ATRIUM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A vast greenhouse dome, cracked, vines pushing through.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rust-red dust drifts in sunbeams.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rows of dead hydroponic trays, a collapsed gantry, a fountain that flows blue, impossibly, in the center.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SERAFINA KOWALSKI, 40s, weathered pressure suit, helmet cradled under one arm, steps through a broken airlock.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She stops.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Scans.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "A scanner on her wrist pings.", "para": 1, "sent": 3, "present": [0]}, {"u": 8, "kind": "action", "text": "Ten meters behind her, ISAAC WREN, 20s, her tech, ducks through the same gap.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He is thin, too young for the suit, visor fogged.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Don't touch anything.", "name": "SERAFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I wasn't.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She walks on.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He follows, hands visibly clasped behind his back.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She crouches by a tray and brushes dust from a withered plant.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "He peers over her shoulder.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "That's not possible.", "name": "ISAAC", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "It's dead.", "name": "SERAFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "It's dead and still green.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She turns it over.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "The underside is rough, silvery, almost metal.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She snaps a leaf.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "It rings.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "That's a bell.", "name": "ISAAC", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "It's a plant.", "name": "SERAFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "It's a bell with roots.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "She stands.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Her boot scrapes.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "The whole dome hums, one low note, like a struck glass.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Isaac freezes.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "She raises a hand.", "para": 5, "sent": 4, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "The note builds.", "para": 5, "sent": 5, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Back to the airlock.", "name": "SERAFINA", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "I'm trying.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "He steps back and bumps a tray.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "A hundred leaves ring at once, a chord that rolls across the atrium and returns.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Both of them cover their helmets with their hands.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "The fountain's blue turns white, then green.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "She grabs his arm.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "They run.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Behind them the plants begin to bend toward the sound, every dead stalk leaning like a congregation.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "At the airlock she shoves him through and follows, slamming the hatch.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "They stand panting in the cramped chamber.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Outside the viewport, the dome glows.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Are we going back?", "name": "ISAAC", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "No.", "name": "SERAFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Good.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "She watches the glow.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "A faint smile.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "We're going to need a bigger microphone.", "name": "SERAFINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}