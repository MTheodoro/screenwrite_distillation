{"scene_id": "s01847", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01847.fountain", "heading": "INT. LOCKER ROOM - DAY", "cast": [{"id": 0, "name": "COACH ELLIOT PRUITT", "names": ["COACH ELLIOT PRUITT", "COACH PRUITT"], "gender": "m", "first": 6, "spoke": 9}, {"id": 1, "name": "RAFI", "names": ["RAFI"], "gender": "m", "first": 7, "spoke": 6}, {"id": 2, "name": "DELGADO", "names": ["DELGADO"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "DUKE ANDERSON", "names": ["DUKE ANDERSON", "DUKE"], "gender": "m", "first": 8, "spoke": 4}, {"id": 4, "name": "MARCUS WYNN", "names": ["MARCUS WYNN", "MARCUS"], "gender": "m", "first": 9, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. LOCKER ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A cinderblock locker room under a low ceiling.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Benches bolted to the floor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A whiteboard with a play half erased.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The air smells of liniment and wet tape.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "They lost by one point, and nobody has moved to the showers.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "COACH ELLIOT PRUITT, 50s, sits on the bench by the door with his cap in his hands.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "At the far locker, still in uniform, sits RAFAEL \"RAFI\" DELGADO, 24, the point guard, staring into his open locker.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "His backup, DUKE ANDERSON, 22, towers over the bench with a towel around his neck.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "And the team captain, MARCUS WYNN, 28, leans against the whiteboard with his arms crossed over a ruined jersey.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Listen up.", "name": "COACH PRUITT", "speaker": 0, "ext": [], "paren": ["to all of them"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Nobody does.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Rafi pulls his shoe off, studies it, puts it back on.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "I said listen up.", "name": "COACH PRUITT", "speaker": 0, "ext": ["CONT'D"], "paren": ["louder"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "We're listening.", "name": "DUKE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "We're listening, Coach.", "name": "MARCUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Should've passed.", "name": "RAFI", "speaker": 1, "ext": [], "paren": ["muttering to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "What was that, Rafi?", "name": "COACH PRUITT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Nothing.", "name": "RAFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "He said he should've passed.", "name": "MARCUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "I said nothing.", "name": "RAFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "You had Marcus open.", "name": "DUKE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Marcus was not open.", "name": "RAFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "I was wide open.", "name": "MARCUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "You were covered.", "name": "RAFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "By a guy half my size.", "name": "MARCUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Enough.", "name": "COACH PRUITT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "He had the lane.", "name": "DUKE", "speaker": 3, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "It was a double team.", "name": "RAFI", "speaker": 1, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "It was one guy.", "name": "MARCUS", "speaker": 4, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "I said enough!", "name": "COACH PRUITT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "His voice cracks against the cinderblock.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "The three of them go still.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Coach Pruitt puts his cap on, takes it off, sets it on his knee.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "That was my call. The last play. I drew it up. Not Rafi's.", "name": "COACH PRUITT", "speaker": 0, "ext": ["CONT'D"], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Rafi looks at him.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Marcus uncrosses his arms.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Coach.", "name": "MARCUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Nobody's showering yet. We sit here for five minutes and nobody says one word.", "name": "COACH PRUITT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Five minutes?", "name": "DUKE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Duke, that's a word.", "name": "COACH PRUITT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Duke sits.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Rafi takes off the other shoe.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Marcus slides down the whiteboard until he is on the floor.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Coach Pruitt looks at the clock.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Four fifty-eight.", "name": "COACH PRUITT", "speaker": 0, "ext": ["CONT'D"], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}]}