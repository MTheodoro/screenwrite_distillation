{"scene_id": "s01848_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01848.fountain", "heading": "INT. SALOON - CONTINUOUS", "cast": [{"id": 0, "name": "SHERIFF PIKE", "names": ["SHERIFF PIKE"], "gender": "?", "first": 12, "spoke": 9}, {"id": 1, "name": "CRANE", "names": ["CRANE"], "gender": "f", "first": 12, "spoke": 9}, {"id": 2, "name": "BARKEEP", "names": ["BARKEEP"], "gender": "m", "first": 23, "spoke": 0}, {"id": 3, "name": "JONAH PIKE", "names": ["JONAH", "JONAH PIKE"], "gender": "m", "first": 49, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. SALOON - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Dim.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Empty tables.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A man at the bar, his back to her.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Black hat.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Long coat.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "He does not turn.", "para": 0, "sent": 5, "present": []}, {"u": 7, "kind": "action", "text": "She steps in.", "para": 1, "sent": 0, "present": []}, {"u": 8, "kind": "action", "text": "Boots on boards.", "para": 1, "sent": 1, "present": []}, {"u": 9, "kind": "action", "text": "Slow.", "para": 1, "sent": 2, "present": []}, {"u": 10, "kind": "action", "text": "He lifts a glass.", "para": 2, "sent": 0, "present": []}, {"u": 11, "kind": "action", "text": "Drinks.", "para": 2, "sent": 1, "present": []}, {"u": 12, "kind": "dialogue", "text": "Mr. Crane.", "name": "SHERIFF PIKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Sheriff.", "name": "CRANE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "You're a long way from Laramie.", "name": "SHERIFF PIKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "He's longer.", "name": "CRANE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Who?", "name": "SHERIFF PIKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "The man you're looking for.", "name": "CRANE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She moves to the bar.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Stands two stools down.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "That so?", "name": "SHERIFF PIKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Ask the barkeep.", "name": "CRANE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "She looks.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Behind the bar a man slumps on the floor, hands tied, mouth gagged.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The BARKEEP, 50s.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "His eyes plead.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "She keeps her face still.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Untie him.", "name": "SHERIFF PIKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Don't think so.", "name": "CRANE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "I wasn't asking.", "name": "SHERIFF PIKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "He turns, finally.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Pale eyes.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "A thin smile.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Augusta. We both know who's in the back room.", "name": "CRANE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Her hand tightens on the holster.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Say it.", "name": "SHERIFF PIKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Your brother.", "name": "CRANE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "She says nothing.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "The storm howls against the shutters.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "A floorboard groans overhead.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "He wants to talk.", "name": "CRANE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Does he.", "name": "SHERIFF PIKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Before the hanging.", "name": "CRANE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "She draws.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "So does he.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Both guns level.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Neither fires.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "The barkeep whimpers.", "para": 9, "sent": 4, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "From the back stair, a voice, rough and tired.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Gus. Put it down.", "name": "JONAH", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "She doesn't.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Crane doesn't.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "The piano, somewhere, plays the same bar again.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Then she lowers the gun.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Crane smiles.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "She turns to the stair.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Jonah.", "name": "SHERIFF PIKE", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "The stair creaks.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "JONAH PIKE, 40s, her brother, descends out of the dark.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "Shackles on his wrists.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "A gaunt, unshaven man.", "para": 13, "sent": 3, "present": [0, 1, 2, 3]}]}