{"scene_id": "s01849", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01849.fountain", "heading": "INT. HOSPITAL ROOM 412 - NIGHT", "cast": [{"id": 0, "name": "AMINA FAROUK", "names": ["AMINA FAROUK", "AMINA"], "gender": "f", "first": 5, "spoke": 18}, {"id": 1, "name": "WALTER NKEMELU", "names": ["WALTER NKEMELU", "WALTER"], "gender": "m", "first": 6, "spoke": 18}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOSPITAL ROOM 412 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A single bed.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "An IV pole.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A window onto a dark parking lot.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The monitor's green line crawls.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. AMINA FAROUK, 40s, rumpled scrubs, white coat over her arm, sits on the edge of a chair, a tablet balanced on her knee.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "In the bed lies WALTER NKEMELU, 70s, a retired bus driver, oxygen cannula in his nose, one hand taped to a board.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Amina scrolls through the chart.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Walter watches the ceiling tile.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Your numbers are better than yesterday.", "name": "AMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I'm a bus driver. I know what that means.", "name": "WALTER", "speaker": 1, "ext": [], "paren": ["hoarse"], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "It means better.", "name": "AMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "It means you're being polite.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "I'm being accurate.", "name": "AMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "That's the same thing in your line of work.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She sets the tablet down.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Okay.", "name": "AMINA", "speaker": 0, "ext": [], "paren": ["to the room, softly"], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Who are you talking to?", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Nobody. Habit.", "name": "AMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He turns his head on the pillow.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "You say that when you're about to tell me something I won't like.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "I do not.", "name": "AMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "You do. Last Tuesday. Before you said the word \"biopsy.\"", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She picks at the cuff of her coat.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "The scan came back.", "name": "AMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "And?", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "And it's not what we hoped.", "name": "AMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Walter says nothing.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "The monitor beeps.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "She speaks without looking at him.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Come on, Amina.", "name": "AMINA", "speaker": 0, "ext": ["CONT'D"], "paren": ["to herself"], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Say it plain.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "It's spread. To the liver.", "name": "AMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Walter closes his eyes.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "His fingers curl on the board, the tape pulling.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "How long?", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "I don't want to guess.", "name": "AMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Guess.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Months. Maybe six.", "name": "AMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Maybe.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "I'm sorry.", "name": "AMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Don't apologize. You didn't give it to me.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "No.", "name": "AMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Sit closer. I can't see you.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "She slides the chair to the bed.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "He opens his eyes and finds her face.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "My daughter's flying in Thursday.", "name": "WALTER", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "I'll make sure the visiting hours are flexible.", "name": "AMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "I'd like to tell her myself.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Of course.", "name": "AMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Not on the phone.", "name": "WALTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Not on the phone.", "name": "AMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "He nods.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "Then, quietly, to the empty air:", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "Six months. Might as well finish the route.", "name": "WALTER", "speaker": 1, "ext": ["CONT'D"], "paren": ["muttered"], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "Amina laughs, a short wet sound, and wipes her eye with her sleeve.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "Walter pats her hand with the one that isn't taped.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "All right, then.", "name": "WALTER", "speaker": 1, "ext": ["CONT'D"], "paren": ["to the room"], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "All right.", "name": "AMINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}