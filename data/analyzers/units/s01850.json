{"scene_id": "s01850", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01850.fountain", "heading": "INT. RIVERBOAT STATEROOM - NIGHT", "cast": [{"id": 0, "name": "CAPTAIN SILAS BARROW", "names": ["CAPTAIN SILAS BARROW", "SILAS"], "gender": "m", "first": 6, "spoke": 15}, {"id": 1, "name": "MADAME CELESTINE ROUX", "names": ["MADAME CELESTINE ROUX", "CELESTINE"], "gender": "?", "first": 7, "spoke": 10}, {"id": 2, "name": "^CELESTINE", "names": ["^CELESTINE"], "gender": "?", "first": 31, "spoke": 1}, {"id": 3, "name": "MARGUERITE", "names": ["MARGUERITE"], "gender": "?", "first": 39, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. RIVERBOAT STATEROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "1871.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A cramped cabin lit by a swaying oil lamp.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A trunk, a washstand, a narrow bunk.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The paddlewheel thuds somewhere beneath the floor.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Rain streaks the porthole.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "CAPTAIN SILAS BARROW, 50s, in a rumpled blue coat, sits on the trunk with a ledger on his knee.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Across from him, in the only chair, sits MADAME CELESTINE ROUX, 40s, black lace, a small valise in her lap.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She has not taken her gloves off.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "You've paid for passage to Natchez, Madame Roux.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I have.", "name": "CELESTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "We reach Natchez at dawn.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I am aware.", "name": "CELESTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Then I wonder why you ask to speak with me at midnight.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Because midnight is when truths wake.", "name": "CELESTINE", "speaker": 1, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I beg your pardon?", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Nothing, Captain. A habit of mine.", "name": "CELESTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He closes the ledger.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "The lamp swings.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Shadows run across the walls and back.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Madame, I run a respectable boat.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "No one doubts it.", "name": "CELESTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Then you'll understand that when a lady boards with no luggage but a valise, and a name that is not the one on her papers, I am obliged to ask.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Ask.", "name": "CELESTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Who are you?", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I am the sister of the man you hanged in Vicksburg.", "name": "CELESTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Silas stands.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "The ledger slides to the floor.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Celestine does not move.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "The paddlewheel thuds on.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "I did not hang him.", "name": "SILAS", "speaker": 0, "ext": [], "paren": ["simultaneously"], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "You signed the paper.", "name": "^CELESTINE", "speaker": 2, "ext": [], "paren": ["simultaneously"], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "They stare.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Silas lowers himself back onto the trunk.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "That was war, Madame.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "War ended in sixty-five.", "name": "CELESTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "He was a spy.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "He was a boy of nineteen with a letter.", "name": "CELESTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Madame Roux--", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "You may call me Marguerite. That is my name.", "name": "CELESTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Marguerite.", "name": "SILAS", "speaker": 0, "ext": [], "paren": ["slowly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "She opens the valise.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Inside, on a bed of black velvet, lie a revolver and a folded paper.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Silas looks at them for a long moment.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "So it ends.", "name": "SILAS", "speaker": 0, "ext": ["CONT'D"], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "No. That is for you to choose.", "name": "MARGUERITE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "She takes out the paper, unfolds it, and lays it on his knee.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "He reads it.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "His lips move.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "He finishes.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "He looks up.", "para": 6, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "This is a confession.", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "It is yours to sign.", "name": "MARGUERITE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "And if I do not?", "name": "SILAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "She lifts the revolver from the velvet and sets it beside the paper on his knee, butt first.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Then you will have both.", "name": "MARGUERITE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Rain hammers the porthole.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "The lamp steadies.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "Silas reaches slowly for the pen on the washstand.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}]}