{"scene_id": "s01854", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01854.fountain", "heading": "INT. COURTHOUSE CONFERENCE ROOM - DAY", "cast": [{"id": 0, "name": "DEFENSE ATTORNEY LEONOR ASTURIAS", "names": ["DEFENSE ATTORNEY LEONOR ASTURIAS", "LEONOR"], "gender": "f", "first": 5, "spoke": 11}, {"id": 1, "name": "PROSECUTOR", "names": ["PROSECUTOR"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "DESMOND TULLY", "names": ["DESMOND TULLY", "DESMOND"], "gender": "?", "first": 7, "spoke": 8}, {"id": 3, "name": "DEPUTY OWEN PRATT", "names": ["DEPUTY OWEN PRATT", "OWEN"], "gender": "m", "first": 8, "spoke": 13}, {"id": 4, "name": "^OWEN", "names": ["^OWEN"], "gender": "?", "first": 13, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. COURTHOUSE CONFERENCE ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A windowless room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A long table scarred by decades of folders.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A water pitcher beading with sweat.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Fluorescent light hums like a distant insect.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DEFENSE ATTORNEY LEONOR ASTURIAS, 40s, charcoal suit, reading glasses pushed into her hair, shuffles exhibits into a neat pile.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across from her, a PROSECUTOR, 30s, crisp, a pen behind his ear, taps a laptop.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Between them, at the end of the table, sits their client MR. DESMOND TULLY, 50s, in an ill-fitting suit that smells of mothballs, hands clasped.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "The prosecutor, DEPUTY DA OWEN PRATT, looks at the clock.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "We have ten minutes before the judge.", "name": "OWEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "We have as long as it takes.", "name": "LEONOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Can I say something?", "name": "DESMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "No.", "name": "LEONOR", "speaker": 0, "ext": [], "paren": ["simultaneously"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Please.", "name": "^OWEN", "speaker": 4, "ext": [], "paren": ["simultaneously"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "They look at each other.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Desmond looks at both.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "I was going to say I'd like some water.", "name": "DESMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Leonor pours.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Her hand is steady.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Owen's pen is not.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Ms. Asturias. The offer is five years.", "name": "OWEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "My client doesn't accept.", "name": "LEONOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "It's a fair number.", "name": "OWEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "It's a number.", "name": "LEONOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Ten minutes, he said?", "name": "DESMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Nine.", "name": "OWEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Mr. Pratt, I'd like a word with my client.", "name": "LEONOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Of course.", "name": "OWEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "He doesn't move.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "She does not either.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "The pitcher drips.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Desmond sips from the paper cup, studies the rim, and sets it down very carefully.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "I didn't do it.", "name": "DESMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "We know.", "name": "LEONOR", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "The evidence says otherwise.", "name": "OWEN", "speaker": 3, "ext": [], "paren": ["also quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Then the evidence is wrong.", "name": "DESMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "It's a very strong file, Mr. Tully.", "name": "OWEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "My wife says you can make a file say anything.", "name": "DESMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Your wife testified.", "name": "OWEN", "speaker": 3, "ext": [], "paren": ["a flicker of something"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "She said what she saw.", "name": "DESMOND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "She said what she believed.", "name": "LEONOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "That's the same thing in a courtroom.", "name": "OWEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Leonor pulls a single sheet from the middle of her pile and slides it across the table.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Owen reads it.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "The pen stops tapping.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "His color changes by degrees.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Where did you get this?", "name": "OWEN", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "It was in your discovery.", "name": "LEONOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "It wasn't.", "name": "OWEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Page four hundred and twelve.", "name": "LEONOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "That's not possible.", "name": "OWEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "Is it good?", "name": "DESMOND", "speaker": 2, "ext": [], "paren": ["to no one"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "Mr. Tully, it's very good.", "name": "LEONOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Owen reaches for his laptop.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "His fingers hover over the keys.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Outside, a bailiff's voice calls a case number, and a door slams.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Give me a minute.", "name": "OWEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "Take nine.", "name": "LEONOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}