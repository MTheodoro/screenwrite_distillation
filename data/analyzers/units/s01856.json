{"scene_id": "s01856", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01856.fountain", "heading": "INT. COUNTRY HOUSE LIBRARY - NIGHT", "cast": [{"id": 0, "name": "INSPECTOR HORACE LANGLEY", "names": ["INSPECTOR HORACE LANGLEY", "LANGLEY"], "gender": "?", "first": 4, "spoke": 10}, {"id": 1, "name": "LADY PRUDENCE WHITMORE", "names": ["LADY PRUDENCE WHITMORE", "PRUDENCE"], "gender": "f", "first": 5, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. COUNTRY HOUSE LIBRARY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Leather, mahogany, a banked fire.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A grandfather clock strikes eleven.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain beats at the French windows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "INSPECTOR HORACE LANGLEY, 50s, trench coat draped over a chair, stands at the mantelpiece studying a small bronze statue.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "At the desk by the window sits LADY PRUDENCE WHITMORE, 60s, black dress, hands folded over a closed ledger.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "A telephone sits between them.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "A lovely piece.", "name": "LANGLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "My late husband's.", "name": "PRUDENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "He had taste.", "name": "LANGLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "He had money.", "name": "PRUDENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "They're not always the same.", "name": "LANGLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She does not smile.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He sets the statue down and turns it a quarter inch, so its face looks toward the door.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "The butler says he found the body at seven.", "name": "LANGLEY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "He did.", "name": "PRUDENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "And you were?", "name": "LANGLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "In the conservatory. Watering the orchids.", "name": "PRUDENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "At seven in the evening.", "name": "LANGLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Orchids keep their own hours.", "name": "PRUDENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "The telephone rings.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Both look at it.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "It rings again.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Prudence lifts the receiver, listens, and holds it out to Langley.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "For you.", "name": "PRUDENCE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Langley takes the receiver and carries it, on its long cord, out through the door into the hall.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Prudence listens.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "She cannot see him, and his voice reaches her only in pieces.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Langley. Yes. The gardener. He saw whom?", "name": "LANGLEY", "speaker": 0, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "A pause.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Lady Whitmore. In the garden, at half past six. Carrying a spade. Thank you, Sergeant.", "name": "LANGLEY", "speaker": 0, "ext": ["O.S.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "The receiver is replaced.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "He returns, trailing the cord, and sets the telephone down.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "The clock ticks.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "The fire pops.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Prudence folds her hands over the ledger, a little tighter.", "para": 6, "sent": 4, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Orchids need potting, Inspector.", "name": "PRUDENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "So they do.", "name": "LANGLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "He lifts the bronze statue and weighs it in his palm.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Lady Whitmore. I think we should begin again.", "name": "LANGLEY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}]}