{"scene_id": "s01857", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01857.fountain", "heading": "INT. PARKING GARAGE LEVEL P4 - NIGHT", "cast": [{"id": 0, "name": "NORA VESS", "names": ["NORA VESS", "NORA"], "gender": "f", "first": 4, "spoke": 25}, {"id": 1, "name": "ELISE MARCHETTI", "names": ["ELISE MARCHETTI", "ELISE"], "gender": "f", "first": 8, "spoke": 26}], "units": [{"u": 0, "kind": "heading", "text": "INT. PARKING GARAGE LEVEL P4 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Concrete.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sodium light.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single car, hood up.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "NORA VESS, 30s, journalist.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Leather jacket.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "She stands behind a pillar.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "Thirty feet away, in the car's glow, a woman waits.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "DR. ELISE MARCHETTI, 50s.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Raincoat.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "A briefcase.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Nora steps out.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "You're early.", "name": "NORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "So are you.", "name": "ELISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "You said midnight.", "name": "NORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I said when it was safe.", "name": "ELISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Nora walks closer.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Her heels echo.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Elise watches.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Is it safe?", "name": "NORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "No.", "name": "ELISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Then why are we here?", "name": "NORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Because it won't get safer.", "name": "ELISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Elise sets the briefcase on the hood.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Her hands tremble.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "She lifts the latches.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Before I open this. One condition.", "name": "ELISE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Name it.", "name": "NORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "My name stays out of it.", "name": "ELISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Your name is the story.", "name": "NORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Then there's no story.", "name": "ELISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Nora folds her arms.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Elise doesn't blink.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "You called me.", "name": "NORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "I know.", "name": "ELISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "You said they'd kill you.", "name": "NORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "I said they might.", "name": "ELISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Does that change the condition?", "name": "NORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "It makes it firm.", "name": "ELISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "A car engine growls somewhere above.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Both women look up.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "The sound passes.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Where do they park?", "name": "NORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Level two. Executive spaces.", "name": "ELISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Then we have time.", "name": "NORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "We have fifteen minutes.", "name": "ELISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Nora pulls a recorder from her jacket and sets it on the hood beside the case.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "She presses record.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "A red light glows.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Say it for the tape.", "name": "NORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "I can't.", "name": "ELISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Then show me.", "name": "NORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "Elise opens the lid.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "Papers, hundreds of them, and a small drive.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "She lifts a page and holds it under the light.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "Lot four-four-one-seven. The shipment dates are wrong.", "name": "ELISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "Wrong how?", "name": "NORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "Backdated. All of them.", "name": "ELISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "By how long?", "name": "NORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "Six months.", "name": "ELISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "That's fraud.", "name": "NORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "It's worse.", "name": "ELISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "She hands the page across.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "Nora reads.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "Her lips move.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "She looks up.", "para": 10, "sent": 3, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "Those are drug trials.", "name": "NORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "Yes.", "name": "ELISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "Patients died.", "name": "NORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "Eleven.", "name": "ELISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "And they knew.", "name": "NORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "dialogue", "text": "They knew in March.", "name": "ELISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "Nora lets the page fall to the hood.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "Her face is pale.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 74, "kind": "dialogue", "text": "You signed the reports.", "name": "NORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 75, "kind": "dialogue", "text": "I did.", "name": "ELISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 76, "kind": "dialogue", "text": "Then you're in it.", "name": "NORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 77, "kind": "dialogue", "text": "I know.", "name": "ELISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 78, "kind": "dialogue", "text": "So why come to me?", "name": "NORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 79, "kind": "dialogue", "text": "Because I'd rather go down with the truth than up with the lie.", "name": "ELISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 80, "kind": "action", "text": "Nora studies her.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 81, "kind": "action", "text": "The light buzzes overhead.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 82, "kind": "action", "text": "In the distance, a second engine starts.", "para": 12, "sent": 2, "present": [0, 1]}, {"u": 83, "kind": "dialogue", "text": "Keep talking.", "name": "NORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 84, "kind": "dialogue", "text": "Not here.", "name": "ELISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 85, "kind": "dialogue", "text": "Where?", "name": "NORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 86, "kind": "dialogue", "text": "Take the case. Go.", "name": "ELISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 87, "kind": "dialogue", "text": "And you?", "name": "NORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 88, "kind": "dialogue", "text": "I'll be right behind you.", "name": "ELISE", "speaker": 1, "ext": [], "paren": ["a thin smile"], "dual": false, "present": [0, 1]}, {"u": 89, "kind": "action", "text": "Nora snaps the case shut, lifts it, and backs toward the ramp.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 90, "kind": "action", "text": "Elise watches her go.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 91, "kind": "action", "text": "The engine closes in.", "para": 13, "sent": 2, "present": [0, 1]}]}