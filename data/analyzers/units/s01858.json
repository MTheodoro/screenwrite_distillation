{"scene_id": "s01858", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01858.fountain", "heading": "INT. JUNKYARD OFFICE TRAILER - NIGHT", "cast": [{"id": 0, "name": "TESSA MORRIS", "names": ["TESSA MORRIS", "TESSA"], "gender": "?", "first": 6, "spoke": 10}, {"id": 1, "name": "DEKE MORRIS", "names": ["DEKE MORRIS", "DEKE"], "gender": "m", "first": 6, "spoke": 13}, {"id": 2, "name": "^TESSA", "names": ["^TESSA"], "gender": "?", "first": 51, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. JUNKYARD OFFICE TRAILER - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped trailer office.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A fluorescent tube buzzes over a metal desk piled with receipts.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A space heater glows orange.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "On the wall, a calendar from 2009.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "An old CB radio crackles on a shelf.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "TESSA MORRIS, 16, in a hoodie too big for her, sits on a broken office chair, knees up, a Polaroid camera in her lap.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Across from her, perched on the desk, is her older cousin DEKE MORRIS, 19, hoodie of his own, a rolled cigarette behind his ear.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You don't have to do this.", "name": "DEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Yes I do.", "name": "TESSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Mom's not gonna know.", "name": "DEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "That's not why.", "name": "TESSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Then why?", "name": "DEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Because he said I couldn't.", "name": "TESSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Who said?", "name": "DEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Dad.", "name": "TESSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Uncle Roy said a lot of things.", "name": "DEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "He said I couldn't take a picture worth keeping. He said I'd quit.", "name": "TESSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "You've been at it two years.", "name": "DEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "That's quitting to him.", "name": "TESSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She winds the camera.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Deke picks at the cuff of his hoodie.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Outside, headlights sweep across the window.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "An engine growls, idles, and cuts out.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Both of them freeze.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "A truck door slams.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Boots crunch on gravel.", "para": 3, "sent": 4, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "It's not him.", "name": "DEKE", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "It could be.", "name": "TESSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Roy doesn't drive a rig.", "name": "DEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "He borrows one.", "name": "TESSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Deke slides off the desk and eases the trailer door open a crack.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "He peers out, then slips through it and pulls it shut behind him.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Tessa sits alone, camera clutched in both hands, listening to the buzz of the tube.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Hey! Gate's closed! Come back tomorrow!", "name": "DEKE", "speaker": 1, "ext": ["O.S."], "paren": ["muffled, calling out"], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "A heavy voice answers, too low to understand.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Deke laughs, a nervous bark.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Nah, man, he doesn't work here anymore!", "name": "DEKE", "speaker": 1, "ext": ["O.S.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Tessa's knuckles whiten on the camera.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "A long silence.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "The engine starts again, backs, and fades up the road.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "The door opens.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Deke leans in, grinning with relief, and Tessa raises the camera and the flash pops white.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Hey!", "name": "DEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Keeper.", "name": "TESSA", "speaker": 0, "ext": [], "paren": ["smiling at last"], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "He wipes the spots from his eyes.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "She waves the Polaroid until the picture begins to bloom.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "Let me see.", "name": "DEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Not yet.", "name": "TESSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "They both lean over it, shoulders touching, as his face slowly appears out of the gray.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "That's terrible.", "name": "DEKE", "speaker": 1, "ext": [], "paren": ["simultaneously"], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "That's perfect.", "name": "^TESSA", "speaker": 2, "ext": [], "paren": ["simultaneously"], "dual": false, "present": [0, 1, 2]}]}