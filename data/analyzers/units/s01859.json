{"scene_id": "s01859", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01859.fountain", "heading": "INT. LAUNDROMAT - NIGHT", "cast": [{"id": 0, "name": "LUCY", "names": ["LUCY"], "gender": "f", "first": 5, "spoke": 7}, {"id": 1, "name": "TEO REYES", "names": ["REYES", "TEO REYES", "ADELA REYES", "ADELA", "TEO"], "gender": "f", "first": 5, "spoke": 17}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAUNDROMAT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Twenty-four-hour laundromat on a dead corner.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fluorescent tubes buzz.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rows of dryers tumble in the dark.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A row of orange plastic chairs faces a window onto the empty street.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LUCINDA \"LUCY\" REYES, 30s, scrubs under a coat, sits slumped in the nearest chair watching a dryer turn.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Beside her, her younger brother TEO REYES, 22, thin, new haircut, holds a plastic basket of folded shirts on his lap like a shield.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "At the change machine, feeding quarters one at a time, stands their mother ADELA REYES, 60s, in a church dress and sneakers.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "The coins ring in the dispenser.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Teo. Come help me.", "name": "ADELA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I'm busy.", "name": "TEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "With what?", "name": "ADELA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Sitting.", "name": "TEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "He's being a man.", "name": "LUCY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Lucy.", "name": "TEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Sorry. Being a grown-up.", "name": "LUCY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Adela collects the quarters in her cupped hands and carries them over.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Two loads. Forty minutes.", "name": "ADELA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Mom, it's midnight.", "name": "LUCY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "So? We have forty minutes.", "name": "ADELA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She sits between them.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She sets the quarters on her knee and counts them.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Teo sets down the basket.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Lucy tilts her head back against the wall.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "I got the job.", "name": "TEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Adela's fingers stop.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "What job?", "name": "LUCY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "The one in Tucson.", "name": "TEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Tucson?", "name": "LUCY", "speaker": 0, "ext": [], "paren": ["sitting up"], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "I leave Friday.", "name": "TEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "The dryers hum.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Adela resumes counting.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "That's good.", "name": "ADELA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "You're not mad?", "name": "TEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Why would I be?", "name": "ADELA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Because you said--", "name": "TEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "I said a lot of things.", "name": "ADELA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Teo, Mom's crying.", "name": "LUCY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "I'm not crying.", "name": "ADELA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "You are.", "name": "LUCY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "It's the lint.", "name": "ADELA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Teo takes the quarters from his mother's knee and puts them in her palm, and she closes her fingers around his hand.", "para": 7, "sent": 0, "present": [0, 1]}]}