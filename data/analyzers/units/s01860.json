{"scene_id": "s01860", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01860.fountain", "heading": "INT. BALLROOM OF THE GRAND CAPRICE HOTEL - NIGHT", "cast": [{"id": 0, "name": "AUGUSTUS PEMBERTON-HYDE", "names": ["AUGUSTUS PEMBERTON-HYDE", "PEMBERTON-HYDE"], "gender": "?", "first": 7, "spoke": 2}, {"id": 1, "name": "ODETTE FUSSELL", "names": ["ODETTE FUSSELL", "ODETTE"], "gender": "?", "first": 10, "spoke": 2}, {"id": 2, "name": "BARNEY", "names": ["BARNEY"], "gender": "m", "first": 13, "spoke": 1}, {"id": 3, "name": "KRUPP", "names": ["KRUPP"], "gender": "?", "first": 13, "spoke": 0}, {"id": 4, "name": "MISS FLORENCE LOVELACE", "names": ["MISS FLORENCE LOVELACE", "FLORENCE"], "gender": "?", "first": 14, "spoke": 1}, {"id": 5, "name": "TALL MAN", "names": ["TALL MAN"], "gender": "?", "first": 16, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. BALLROOM OF THE GRAND CAPRICE HOTEL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A faded ballroom in a faded resort.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A crystal chandelier swings gently, missing every third bulb.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Red velvet curtains droop.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A banner reads \"SENIOR SINGLES MIXER\" in glitter.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Thirty folding chairs stand in rows, nearly empty.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "A tall, stately man in a white dinner jacket stands at the doorway, shaking out a wet umbrella.", "para": 1, "sent": 0, "present": []}, {"u": 7, "kind": "action", "text": "He is MR. AUGUSTUS PEMBERTON-HYDE, 70s.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "He sweeps one white glove across his hair, adjusts his tie, and surveys the room as if reviewing troops.", "para": 1, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "At the punch bowl, a small woman in a feathered hat and an enormous corsage ladles with great seriousness.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "She is MRS. ODETTE FUSSELL, 60s.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She hums.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Across the dance floor, a stout man in a paisley vest sits alone, tapping his foot to music only he hears.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He is MR. BARTHOLOMEW \"BARNEY\" KRUPP, 60s.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "And at the piano, in a sequined gown that hasn't fit since 1985, sits MISS FLORENCE LOVELACE, 70s, who thumps a single chord and waits.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "The tall man clears his throat.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Good evening.", "name": "TALL MAN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "He bows.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Odette curtsies with the ladle.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Barney waves.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Florence thumps the chord again.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Mr. Pemberton-Hyde! Punch?", "name": "ODETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Madam, I would be honored.", "name": "PEMBERTON-HYDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "He crosses the floor with his stiff, ceremonious stride.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "She hands him a cup.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "He sips.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "His face goes through three expressions.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Is this... gravy?", "name": "PEMBERTON-HYDE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Oh, dear.", "name": "ODETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "I told her it was gravy!", "name": "BARNEY", "speaker": 2, "ext": [], "paren": ["calling"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Is anyone going to dance, or must I play to the walls?", "name": "FLORENCE", "speaker": 4, "ext": [], "paren": ["from the piano"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Odette takes the cup back.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "She and Pemberton-Hyde look at each other, and then, without a word, she takes his arm and he leads her out to the center of the floor.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Florence strikes up a waltz, off-key.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Barney leaps to his feet and applauds.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "The chandelier swings.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "A bulb pops.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Nobody minds.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}