{"scene_id": "s01861", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01861.fountain", "heading": "EXT. ROOFTOP WATER TOWER - DAWN", "cast": [{"id": 0, "name": "JUNE WEBER", "names": ["JUNE WEBER", "JUNE"], "gender": "?", "first": 4, "spoke": 8}, {"id": 1, "name": "OSCAR PELL", "names": ["OSCAR PELL", "OSCAR"], "gender": "m", "first": 14, "spoke": 10}, {"id": 2, "name": "KID", "names": ["KID"], "gender": "?", "first": 35, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ROOFTOP WATER TOWER - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A rusted water tower on a flat tar roof above a sleeping town.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Pigeons.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A pink smear of sky.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "JUNE WEBER, 17, fraying denim jacket, climbs the last rung.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Chewed fingernails.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "A paper bag in her teeth.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "She hauls over the lip.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Looks around.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "Nobody.", "para": 3, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "She sits.", "para": 4, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "Takes a donut from the bag.", "para": 4, "sent": 1, "present": [0]}, {"u": 12, "kind": "action", "text": "A scrape behind her.", "para": 5, "sent": 0, "present": [0]}, {"u": 13, "kind": "action", "text": "She spins.", "para": 6, "sent": 0, "present": [0]}, {"u": 14, "kind": "action", "text": "OSCAR PELL, 17, skinny, dyed-blond hair, up the other ladder.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Out of breath.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Grinning.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Told you I'd beat you.", "name": "OSCAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "You didn't.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "I got here at five.", "name": "OSCAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Then why were you climbing?", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "I went down for coffee.", "name": "OSCAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "He holds up two paper cups.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Hands her one.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She takes it, suspicious.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "It's cold.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "It's iced.", "name": "OSCAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "It's November.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "It's committed.", "name": "OSCAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "She laughs despite herself.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Drinks.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Below, a milk truck rattles down Main Street.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "The light spreads.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "A third voice, below, thin and sharp.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "A kid's.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Oscar! Mom says come home!", "name": "KID", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Oscar closes his eyes.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Ten minutes!", "name": "OSCAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "She says now!", "name": "KID", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Who's that?", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "My sister.", "name": "OSCAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "How old?", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Nine. Terrifying.", "name": "OSCAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "He stands.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Offers June a hand.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "She takes it.", "para": 13, "sent": 2, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Tomorrow?", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Same tower.", "name": "OSCAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Bring hot coffee.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Bring a better donut.", "name": "OSCAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}