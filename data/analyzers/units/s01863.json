{"scene_id": "s01863", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01863.fountain", "heading": "INT. INTERROGATION ROOM - NIGHT", "cast": [{"id": 0, "name": "AGENT MAREN SOLOMON", "names": ["AGENT MAREN SOLOMON", "MAREN"], "gender": "?", "first": 5, "spoke": 12}, {"id": 1, "name": "THEO VANCE", "names": ["THEO VANCE", "THEO"], "gender": "?", "first": 9, "spoke": 9}, {"id": 2, "name": "^THEO", "names": ["^THEO"], "gender": "?", "first": 42, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. INTERROGATION ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A bare room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A steel table bolted to the floor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A one-way mirror.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single chair on each side.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "AGENT MAREN SOLOMON, 40s, sits with a manila folder squared in front of her and does not open it.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her sleeves are pressed.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Her face gives nothing.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "Opposite her, wrists in plastic ties, a man in a gray hoodie.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "THEO VANCE, 30s.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He studies the table, then the mirror, then her hands.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Do you want water?", "name": "MAREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "No.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Coffee?", "name": "MAREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "No.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "You've been here six hours.", "name": "MAREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Eight.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She glances at her watch.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He is right.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She makes no remark.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Eight.", "name": "MAREN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "You don't believe me.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "I believe your watch is better than mine.", "name": "MAREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "He tilts his head, almost smiling.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "He lifts his bound wrists to scratch his nose.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "She watches the movement closely, then looks away.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Tell me about the drive.", "name": "MAREN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "What drive?", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "The one in your sock.", "name": "MAREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "His smile goes.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "He lowers his hands.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Under the table, a shoe taps twice and stops.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "I don't have a drive.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "We have a photograph of the drive.", "name": "MAREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Then you don't need me.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "She opens the folder at last.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Slides a single glossy photo across the steel.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "He doesn't look at it.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "His eyes stay on her.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Who gave it to you?", "name": "MAREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Nobody.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Who gave it to you?", "name": "MAREN", "speaker": 0, "ext": [], "paren": ["simultaneously"], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Nobody gave it.", "name": "^THEO", "speaker": 2, "ext": [], "paren": ["simultaneously"], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "The ventilation fan clicks on, then off.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Maren reaches across and, slowly, takes his hand in both of hers, as if comforting him.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Turns it over.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Examines the palm.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "A faint blue smear of ink on the heel of it.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "She lets go.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "He pulls the hand back, and tucks it under his other arm.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "That's from the stamp at the locker.", "name": "MAREN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Theo says nothing.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "The shoe starts tapping again.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Maren closes the folder.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "She stands, tucks her chair beneath the table, and goes to the door.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "At the threshold she turns.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "Eight hours, Mr. Vance. I think you'd like a coffee now.", "name": "MAREN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "Black.", "name": "THEO", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2]}]}