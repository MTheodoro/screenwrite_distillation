{"scene_id": "s01864", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01864.fountain", "heading": "INT. SYNERGY PARTNERS - OPEN OFFICE - MORNING", "cast": [{"id": 0, "name": "DEBORAH PRZYBYLSKI", "names": ["DEBORAH PRZYBYLSKI", "DEBORAH"], "gender": "?", "first": 5, "spoke": 9}, {"id": 1, "name": "VP", "names": ["VP"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "SANJAY RAO", "names": ["SANJAY RAO", "SANJAY"], "gender": "?", "first": 6, "spoke": 4}, {"id": 3, "name": "KENDRA OYELOWO", "names": ["KENDRA OYELOWO", "KENDRA"], "gender": "f", "first": 6, "spoke": 3}, {"id": 4, "name": "BRAD", "names": ["BRAD"], "gender": "m", "first": 6, "spoke": 3}, {"id": 5, "name": "FITCH", "names": ["FITCH"], "gender": "?", "first": 6, "spoke": 0}, {"id": 6, "name": "MR. LYLE", "names": ["MR. LYLE"], "gender": "?", "first": 23, "spoke": 9}, {"id": 7, "name": "^BRAD", "names": ["^BRAD"], "gender": "?", "first": 48, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. SYNERGY PARTNERS - OPEN OFFICE - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "A sea of gray cubicles.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A foosball table nobody uses.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A neon sign reads \"BE THE CHANGE.\"", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A printer in the corner beeps in distress.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DEBORAH PRZYBYLSKI, 40s, regional VP, strides in carrying a laptop and a green smoothie.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Behind her trail four employees: SANJAY RAO, 30s; KENDRA OYELOWO, 20s; BRADLEY \"BRAD\" FITCH, 30s; and a thin man in an ill-fitting suit.", "para": 1, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 7, "kind": "dialogue", "text": "Team! Huddle!", "name": "DEBORAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "action", "text": "They gather.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "action", "text": "The thin man hangs back.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Q3 numbers are in. We are crushing it. Crushing. Is anyone not crushing?", "name": "DEBORAH", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "Nobody speaks.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "The printer beeps.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "We missed target by thirty percent.", "name": "SANJAY", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "What was that?", "name": "DEBORAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "I said we're... trending.", "name": "SANJAY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Good word. Trending.", "name": "DEBORAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Who is that guy?", "name": "KENDRA", "speaker": 3, "ext": [], "paren": ["to Brad"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "HR, I think.", "name": "BRAD", "speaker": 4, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "He's been here an hour.", "name": "KENDRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "He's been in the printer room.", "name": "BRAD", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Team. I want to introduce someone.", "name": "DEBORAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "She gestures at the thin man, who steps forward and clutches his clipboard.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "This is Mr. Lyle, from Corporate.", "name": "DEBORAH", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "Hello.", "name": "MR. LYLE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "Mr. Lyle is here to help us optimize.", "name": "DEBORAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "I'm here to make cuts.", "name": "MR. LYLE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "Deborah's smile does not move.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "Sanjay's eyes widen.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "Kendra covers her mouth.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "Brad slowly raises his hand.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "Is that a joke?", "name": "BRAD", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "No.", "name": "MR. LYLE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "It's a figure of speech.", "name": "DEBORAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "It is not.", "name": "MR. LYLE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "Mr. Lyle, may I have a word.", "name": "DEBORAH", "speaker": 0, "ext": [], "paren": ["through teeth"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "Certainly.", "name": "MR. LYLE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "They step aside.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "The three employees watch.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "Lyle speaks, quietly, and Deborah's face cracks.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "She snatches her smoothie, takes a long pull through the straw, and, finding it empty, sucks on air.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "Lyle returns, alone.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "Deborah remains by the foosball table, staring at it.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "dialogue", "text": "Ms. Przybylski has decided to take personal leave.", "name": "MR. LYLE", "speaker": 6, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "Indefinitely?", "name": "SANJAY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "dialogue", "text": "Effective immediately.", "name": "MR. LYLE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "dialogue", "text": "Who's in charge?", "name": "KENDRA", "speaker": 3, "ext": [], "paren": ["simultaneously"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "dialogue", "text": "Who's in charge?", "name": "^BRAD", "speaker": 7, "ext": [], "paren": ["simultaneously"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 49, "kind": "action", "text": "Lyle looks at them.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 50, "kind": "action", "text": "He glances at the clipboard.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 51, "kind": "dialogue", "text": "Mr. Rao.", "name": "MR. LYLE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 52, "kind": "dialogue", "text": "Me?", "name": "SANJAY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 53, "kind": "dialogue", "text": "Congratulations. You're trending.", "name": "MR. LYLE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}