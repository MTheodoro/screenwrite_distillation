{"scene_id": "s01865", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01865.fountain", "heading": "INT. REPAIR SHOP - DAY", "cast": [{"id": 0, "name": "PRIYA DESAI", "names": ["PRIYA DESAI", "PRIYA"], "gender": "f", "first": 5, "spoke": 3}, {"id": 1, "name": "HIRAM PELL", "names": ["HIRAM", "HIRAM PELL"], "gender": "m", "first": 6, "spoke": 4}, {"id": 2, "name": "ZEKE", "names": ["ZEKE"], "gender": "m", "first": 8, "spoke": 1}, {"id": 3, "name": "^ZEKE", "names": ["^ZEKE"], "gender": "?", "first": 27, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. REPAIR SHOP - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A cramped clock repair shop.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Hundreds of ticking clocks on every wall, none in agreement.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A bell on the door.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A workbench cluttered with gears.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "At the counter, a young woman named PRIYA DESAI, 20s, taps her fingers, glancing at the wall of clocks.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "dialogue", "text": "Be right with you!", "name": "HIRAM", "speaker": 1, "ext": ["O.S."], "paren": ["from the back room"], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Take your time.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "A delivery man named ZEKE, brown uniform, 30s, crashes through the door with a huge box and trips on the rug.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "HIRAM PELL, 60s, in a leather apron and jeweler's loupe, bursts through the beaded curtain with a pocket watch in his fist, just as the box flies.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Hiram throws up his arms.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Priya ducks.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Zeke sprawls across the floor.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "The box lands on the counter with a crash.", "para": 2, "sent": 5, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "A hundred clocks chime at once.", "para": 2, "sent": 6, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "My cuckoos!", "name": "HIRAM", "speaker": 1, "ext": [], "paren": ["shouting over it"], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Sorry!", "name": "ZEKE", "speaker": 2, "ext": [], "paren": ["shouting back"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Priya covers her ears.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Hiram lunges for the box.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Zeke scrambles to his feet.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "They both grab the lid at the same time and tug.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "It pops open, and a spring-loaded cuckoo bird flies out and hits Priya in the forehead.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "She yelps.", "para": 3, "sent": 5, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Hiram and Zeke look at her, then at each other, then at the bird.", "para": 3, "sent": 6, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The chimes die away.", "para": 3, "sent": 7, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "I came in to pick up my grandfather's watch.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": ["rubbing her head"], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Which watch?", "name": "HIRAM", "speaker": 1, "ext": [], "paren": ["simultaneously"], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Sign here, please.", "name": "^ZEKE", "speaker": 3, "ext": [], "paren": ["simultaneously"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "The one that stopped.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": ["into the silence"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Hiram lifts the pocket watch from the bench and holds it up by its chain.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "It swings.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "It ticks.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "It's running.", "name": "HIRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}