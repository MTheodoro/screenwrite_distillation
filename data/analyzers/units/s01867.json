{"scene_id": "s01867", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01867.fountain", "heading": "INT. FINISHING SCHOOL DRAWING ROOM - AFTERNOON", "cast": [{"id": 0, "name": "MISS EUGENIA THORNE", "names": ["MISS EUGENIA THORNE", "EUGENIA"], "gender": "f", "first": 7, "spoke": 8}, {"id": 1, "name": "LADY ARABELLA FENWICK", "names": ["LADY ARABELLA FENWICK", "ARABELLA"], "gender": "?", "first": 8, "spoke": 5}, {"id": 2, "name": "MISS CLARA PENROSE", "names": ["MISS CLARA PENROSE", "CLARA"], "gender": "?", "first": 8, "spoke": 4}, {"id": 3, "name": "THEODORE ABERCROMBIE", "names": ["THEODORE ABERCROMBIE", "THEODORE"], "gender": "?", "first": 9, "spoke": 2}, {"id": 4, "name": "MARTHA GRUBB", "names": ["MARTHA GRUBB", "MARTHA"], "gender": "?", "first": 10, "spoke": 2}, {"id": 5, "name": "MADAME ODILE VASSEUR", "names": ["MADAME ODILE VASSEUR", "MADAME VASSEUR"], "gender": "f", "first": 11, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. FINISHING SCHOOL DRAWING ROOM - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "1912.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A high-ceilinged drawing room in a draughty English manor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Chintz sofas, a tea service on a mahogany trolley, a portrait of a long-dead headmistress above the cold hearth.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A grandfather clock ticks with ostentatious calm.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Pale spring light slants through lace curtains.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "Six figures occupy the room.", "para": 1, "sent": 0, "present": []}, {"u": 7, "kind": "action", "text": "MISS EUGENIA THORNE, 50s, headmistress, steel-gray hair, a cameo brooch at her throat, presides from a wing chair with her teacup on her knee.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "To her right, on a settee, sit two of her pupils: LADY ARABELLA FENWICK, 17, ringlets, bored, and her cousin MISS CLARA PENROSE, 16, plain and watchful, her hands folded.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Standing by the window, hands clasped behind his back, is MR. THEODORE ABERCROMBIE, 40s, the visiting music master, in a tweed jacket with a violin case at his feet.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Beside the tea trolley, pouring, is the maid MARTHA GRUBB, 20s, in cap and apron, eyes lowered.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "And in the corner, half hidden behind a potted fern, sits MADAME ODILE VASSEUR, 60s, the French instructress, with a book she isn't reading.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Martha, the milk.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Yes, Miss Thorne.", "name": "MARTHA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Arabella, sit up.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "I am up.", "name": "ARABELLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "You are slumped.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Arabella straightens by a quarter inch.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Clara stifles a smile.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "I thought we might begin with the Schubert.", "name": "THEODORE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "We shall begin with tea, Mr. Abercrombie. Music follows digestion.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Of course.", "name": "THEODORE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "He bends to the violin case, thinks better of it, and straightens.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Martha hands Eugenia the milk jug.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Their fingers brush.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Martha steps back.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Mademoiselle Clara. Your posture is excellent.", "name": "MADAME VASSEUR", "speaker": 5, "ext": [], "paren": ["from behind the fern"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Thank you, Madame.", "name": "CLARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Teacher's pet.", "name": "ARABELLA", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Ninny.", "name": "CLARA", "speaker": 2, "ext": [], "paren": ["lower"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Eugenia sets down her cup.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "The saucer rings.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "The room stills.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Is there something the young ladies wish to share?", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "No, Miss Thorne.", "name": "ARABELLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "No, Miss Thorne.", "name": "CLARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Splendid.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "The clock strikes four.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "A carriage rattles on the gravel outside.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Martha crosses to the window, parts the lace, and looks out.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "She stiffens.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Martha?", "name": "EUGENIA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "A boy on a bicycle, ma'am. He's left a telegram on the step.", "name": "MARTHA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "The room holds its breath.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Madame Vasseur lowers her book.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Theodore turns from the window.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Eugenia rises to her full height, smooths her skirt, and walks to the door without a word.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "She opens it.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "Beyond, in the hall, a small envelope lies on the silver salver, left there by a messenger who has already gone.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "For me?", "name": "EUGENIA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "She turns it over, reads the name, and holds the envelope out to Arabella, who has come up behind her.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Arabella takes it.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "She tears it open.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "She reads.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "The color drains from her ringlets down to her collar.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "Father.", "name": "ARABELLA", "speaker": 1, "ext": [], "paren": ["very small"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "Bella?", "name": "CLARA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "He's coming. Tonight.", "name": "ARABELLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "Eugenia places a hand on the girl's shoulder.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "Behind them, the clock ticks on.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}