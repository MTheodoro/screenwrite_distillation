{"scene_id": "s01868", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01868.fountain", "heading": "INT. ER NURSES' STATION - 3 A.M.", "cast": [{"id": 0, "name": "NKECHI ADEBAYO", "names": ["NKECHI ADEBAYO", "NKECHI"], "gender": "f", "first": 4, "spoke": 3}, {"id": 1, "name": "LUIS FERNANDEZ", "names": ["LUIS FERNANDEZ", "LUIS"], "gender": "?", "first": 5, "spoke": 3}, {"id": 2, "name": "HENRY WU", "names": ["HENRY WU", "HENRY"], "gender": "m", "first": 6, "spoke": 3}, {"id": 3, "name": "NURSE GRACE TOLLIVER", "names": ["GRACE", "NURSE GRACE TOLLIVER"], "gender": "?", "first": 8, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. ER NURSES' STATION - 3 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent lights.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A whiteboard of patient names.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A coffee pot at its last inch.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. NKECHI ADEBAYO, 30s, charts.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Orderly LUIS FERNANDEZ, 20s, mops.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Dr. HENRY WU, 40s, drinks from a mug that reads WORLD'S OKAYEST DOC.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "The overhead speaker clicks.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "It is Nurse Grace Tolliver at triage.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Code blue, bay six. Code blue, bay six.", "name": "GRACE", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Nkechi drops her pen.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Bay six. Go.", "name": "NKECHI", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "NURSE GRACE TOLLIVER, 50s, bursts around the corner pushing the crash cart.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Got the cart.", "name": "GRACE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Who's in six?", "name": "HENRY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "The kid. Car accident.", "name": "LUIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Luis, ambu bag.", "name": "NKECHI", "speaker": 0, "ext": [], "paren": ["already moving"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "On it.", "name": "LUIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "They sprint.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Henry, lingering, mutters to himself.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Please be the dog. Please be the dog.", "name": "HENRY", "speaker": 2, "ext": [], "paren": ["under his breath"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "He sets down the mug and follows.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "The whiteboard marker rolls off the ledge and clatters on the floor.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "At the end of the hall a curtain whips open.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "A small, familiar bark.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "It's a dog!", "name": "NKECHI", "speaker": 0, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "It's a golden retriever!", "name": "GRACE", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Doc, he's waking up!", "name": "LUIS", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Thank God.", "name": "HENRY", "speaker": 2, "ext": [], "paren": ["sagging"], "dual": false, "present": [0, 1, 2, 3]}]}