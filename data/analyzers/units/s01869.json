{"scene_id": "s01869", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01869.fountain", "heading": "INT. PEDIATRIC WARD NURSES' STATION - NIGHT", "cast": [{"id": 0, "name": "CAMILLE ROUSSEAU", "names": ["CAMILLE ROUSSEAU", "CAMILLE"], "gender": "f", "first": 4, "spoke": 19}, {"id": 1, "name": "NURSE ISAAC OBI", "names": ["NURSE ISAAC OBI", "ISAAC"], "gender": "f", "first": 8, "spoke": 2}, {"id": 2, "name": "TATIANA VOLKOV", "names": ["TATIANA VOLKOV", "TATIANA"], "gender": "f", "first": 11, "spoke": 21}], "units": [{"u": 0, "kind": "heading", "text": "INT. PEDIATRIC WARD NURSES' STATION - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Soft lights.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A mural of cartoon whales.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The ward is hushed.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. CAMILLE ROUSSEAU, 40s.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Tired eyes.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Hair in a clip.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "She stands at the desk, flipping a chart.", "para": 1, "sent": 3, "present": [0]}, {"u": 8, "kind": "action", "text": "NURSE ISAAC OBI, 30s, across from her.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Scrubs with cartoon bears.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He is tapping at a keyboard.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Between them, a parent: MRS. TATIANA VOLKOV, 30s.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Coat still on.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Purse clutched.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Mrs. Volkov. Please. Sit.", "name": "CAMILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "I'll stand.", "name": "TATIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "It's about Misha.", "name": "CAMILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I know it's about Misha.", "name": "TATIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Can I get you water?", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "No.", "name": "TATIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Isaac steps back.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Camille closes the chart.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "His fever broke at two.", "name": "CAMILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Thank God.", "name": "TATIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "That's good news.", "name": "CAMILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Then why do you look like that?", "name": "TATIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Like what?", "name": "CAMILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Like you have more.", "name": "TATIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Camille glances at Isaac.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "He nods, almost invisibly.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "The blood work came back.", "name": "CAMILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "And?", "name": "TATIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "There are some numbers I don't like.", "name": "CAMILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Which numbers?", "name": "TATIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "His white count.", "name": "CAMILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "What does that mean?", "name": "TATIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "It could mean a lot of things. Infection. A reaction to the medication.", "name": "CAMILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Or?", "name": "TATIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Or something we need to look at more closely.", "name": "CAMILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Say it.", "name": "TATIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "I'd like to run more tests before I say anything.", "name": "CAMILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "You are saying something.", "name": "TATIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Mrs. Volkov.", "name": "CAMILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "You're a doctor. You said \"more closely.\" That is a doctor word for a bad word.", "name": "TATIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Camille sets her hands flat on the desk.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "We don't know yet. I promise you. When we know, you will know, first, from me.", "name": "CAMILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "When?", "name": "TATIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Tomorrow afternoon.", "name": "CAMILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "That's sixteen hours.", "name": "TATIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "I know.", "name": "CAMILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "What do I do for sixteen hours?", "name": "TATIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Sit with him. Hold his hand. Be his mother.", "name": "CAMILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Tatiana looks at the whale mural, as if to read it.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "He likes whales.", "name": "TATIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "I know. He told me.", "name": "CAMILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "He told you?", "name": "TATIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "Nine whale facts. At the bedside. Before I took his temperature.", "name": "CAMILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Tatiana smiles, a small crooked smile.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "She puts down her purse.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "Which is his favorite?", "name": "TATIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "The blue whale. Its heart is the size of a car.", "name": "CAMILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Then it's big enough.", "name": "TATIANA", "speaker": 2, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "She sits at last.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "Isaac pulls a chair beside her.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "Camille leans on the desk.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "Mrs. Volkov, I'll get you that water now.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "Yes. Please.", "name": "TATIANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "He crosses to the water cooler.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "The cup fills with a slow gurgle.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "Tatiana holds her hands out for it, and they are steady.", "para": 10, "sent": 2, "present": [0, 1, 2]}]}