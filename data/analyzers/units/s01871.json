{"scene_id": "s01871", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01871.fountain", "heading": "EXT. FLOODED RICE PADDY DIKE - DAWN", "cast": [{"id": 0, "name": "SERGEANT NIKOLAI BRZEZINSKI", "names": ["SERGEANT NIKOLAI BRZEZINSKI", "BRZEZINSKI"], "gender": "m", "first": 4, "spoke": 7}, {"id": 1, "name": "CORPORAL ADAEZE OBI", "names": ["CORPORAL ADAEZE OBI", "OBI"], "gender": "?", "first": 5, "spoke": 6}, {"id": 2, "name": "SPARROW", "names": ["SPARROW"], "gender": "?", "first": 5, "spoke": 4}, {"id": 3, "name": "LANGE", "names": ["LANGE"], "gender": "?", "first": 5, "spoke": 0}, {"id": 4, "name": "PRIVATE HARUTO KAWASAKI", "names": ["PRIVATE HARUTO KAWASAKI", "KAWASAKI"], "gender": "?", "first": 5, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FLOODED RICE PADDY DIKE - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Mist on brown water.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A narrow dike, the only dry line for a mile.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Four soldiers crouch behind a collapsed water buffalo shed.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SERGEANT NIKOLAI BRZEZINSKI (40s, gray stubble, field radio on his back) counts heads.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "CORPORAL ADAEZE OBI (20s, medic's bag) wraps a bandage around PRIVATE TOMMY \"SPARROW\" LANGE (19, freckled, pale).", "para": 1, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 6, "kind": "action", "text": "PRIVATE HARUTO KAWASAKI (30s, glasses taped at the hinge) watches the treeline through a rifle scope.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "action", "text": "The shooting has stopped.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "Somewhere, a duck complains.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "That's the last of it. Report.", "name": "BRZEZINSKI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Sparrow's through-and-through, left arm.", "name": "OBI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "It's fine, it's--", "name": "SPARROW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "It's not fine, hold still.", "name": "OBI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Treeline is quiet. Nothing moving.", "name": "KAWASAKI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Quiet is not nothing.", "name": "BRZEZINSKI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Sarge, are we gonna wait for the--", "name": "SPARROW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Stop talking.", "name": "OBI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "I count two. Maybe three. Walking away.", "name": "KAWASAKI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Away?", "name": "BRZEZINSKI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Away. Rifles slung.", "name": "KAWASAKI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "They're done too.", "name": "OBI", "speaker": 1, "ext": [], "paren": ["tying off"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "How do you know?", "name": "SPARROW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Because they're walking.", "name": "BRZEZINSKI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "A long pause.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Brzezinski unslings the radio, thumbs the handset.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Tango Two, this is Tango Four. Hold fire. Say again, hold fire.", "name": "BRZEZINSKI", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Sergeant, I can see their faces. They're kids.", "name": "KAWASAKI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "So is Sparrow.", "name": "OBI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "I'm twenty in March.", "name": "SPARROW", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Nobody is anything in March. Obi, finish. Kawasaki, keep the glass on them till they're gone.", "name": "BRZEZINSKI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Gone.", "name": "KAWASAKI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "He lowers the scope.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Exhales.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Brzezinski sits down hard in the mud.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Sarge. You're bleeding too.", "name": "OBI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Am I?", "name": "BRZEZINSKI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "He looks at his sleeve.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Surprised, almost polite.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}]}