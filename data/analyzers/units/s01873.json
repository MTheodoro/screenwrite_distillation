{"scene_id": "s01873", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01873.fountain", "heading": "INT. LIGHTHOUSE KEEPER'S KITCHEN - DUSK", "cast": [{"id": 0, "name": "ELOWEN PASCOE", "names": ["ELOWEN PASCOE", "ELOWEN"], "gender": "?", "first": 3, "spoke": 1}, {"id": 1, "name": "CALLUM PASCOE", "names": ["CALLUM PASCOE", "CALLUM"], "gender": "?", "first": 3, "spoke": 2}, {"id": 2, "name": "FINN ARDEN", "names": ["FINN ARDEN", "FINN"], "gender": "m", "first": 12, "spoke": 1}, {"id": 3, "name": "MAIRI PASCOE", "names": ["MAIRI PASCOE", "MAIRI"], "gender": "?", "first": 3, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. LIGHTHOUSE KEEPER'S KITCHEN - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "Salt has eaten the window frames pale.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Soup steams on a black stove, and four chipped cups wait on an oilcloth the color of old teeth.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "ELOWEN PASCOE (30s, wool cardigan, a woman who has learned to move quietly) ladders bread onto a board.", "para": 1, "sent": 0, "present": [0, 1, 3]}, {"u": 4, "kind": "action", "text": "Across the table, her husband CALLUM PASCOE (30s, broad, sunburnt) peels an orange in one unbroken spiral, offering her the whole bright ribbon of it.", "para": 1, "sent": 1, "present": [0, 1, 3]}, {"u": 5, "kind": "dialogue", "text": "Thought you'd like it.", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 6, "kind": "dialogue", "text": "You remembered.", "name": "ELOWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 7, "kind": "action", "text": "She takes it.", "para": 2, "sent": 0, "present": [0, 1, 3]}, {"u": 8, "kind": "action", "text": "Smiles.", "para": 2, "sent": 1, "present": [0, 1, 3]}, {"u": 9, "kind": "action", "text": "The kettle sings.", "para": 2, "sent": 2, "present": [0, 1, 3]}, {"u": 10, "kind": "action", "text": "It is a good evening, the kind that asks nothing.", "para": 2, "sent": 3, "present": [0, 1, 3]}, {"u": 11, "kind": "action", "text": "Boots on the stair.", "para": 3, "sent": 0, "present": [0, 1, 3]}, {"u": 12, "kind": "action", "text": "FINN ARDEN (20s, oilskin, rain in his hair) fills the doorway with his hat in his hands.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Behind him, the youngest, MAIRI PASCOE (12, braids), clutches the banister.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Evening, Mrs. Pascoe.", "name": "FINN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Elowen drops the orange peel.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Callum looks at her, then at him, then at her again, and all three of them stand quite still.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Mam? Why does Da have Finn's letters?", "name": "MAIRI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Callum opens his coat.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "A bundle of envelopes tied with blue thread.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Elowen's handwriting on every one.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Sit down, both of you.", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Neither sits.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "The soup begins, quietly, to boil over.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}]}