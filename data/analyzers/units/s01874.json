{"scene_id": "s01874", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01874.fountain", "heading": "INT. COLD-STORAGE LOCKER, FISH MARKET - NIGHT", "cast": [{"id": 0, "name": "DETECTIVE RHEA SOLOMON", "names": ["DETECTIVE RHEA SOLOMON", "SOLOMON"], "gender": "f", "first": 4, "spoke": 3}, {"id": 1, "name": "ARTUR VOSS", "names": ["ARTUR VOSS", "VOSS"], "gender": "m", "first": 5, "spoke": 3}, {"id": 2, "name": "NICO FERRANTE", "names": ["NICO FERRANTE", "NICO"], "gender": "?", "first": 6, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. COLD-STORAGE LOCKER, FISH MARKET - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Frost on steel.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A bare bulb.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Three people in a room built for crates of herring.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DETECTIVE RHEA SOLOMON (40s, parka) holds the door ajar with her boot.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "ARTUR VOSS (50s, soaked suit) stands over an open ice chest.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "NICO FERRANTE (20s, apron) sits on a pallet, knees up.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Nobody leaves. Hands where I can see them.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Voss lifts the lid higher.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Looks in.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Not here. Not here. Where is it.", "name": "VOSS", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Artur. Step back.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Nico, did you move it?", "name": "VOSS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "No, sir.", "name": "NICO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Voss turns.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Too fast.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Solomon's hand goes to her hip.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Last warning. Everyone calm down.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "I'm calm. I'm so calm.", "name": "NICO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "The compressor shuts off.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Total quiet.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Forty years. Forty years.", "name": "VOSS", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Voss pulls a hand from his coat.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Phone, not a gun.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "He holds it up like a lantern.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Nico bolts.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Solomon spins.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "The door slams.", "para": 6, "sent": 2, "present": [0, 1, 2]}]}