{"scene_id": "s01875", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01875.fountain", "heading": "EXT. DRIVE-IN SCREEN, ABANDONED - LATE AFTERNOON", "cast": [{"id": 0, "name": "KES", "names": ["KES"], "gender": "m", "first": 2, "spoke": 11}, {"id": 1, "name": "WILLOW ODUYA", "names": ["ODUYA", "WILLOW ODUYA", "WILLOW"], "gender": "?", "first": 2, "spoke": 8}, {"id": 2, "name": "BASTIEN LEROUX", "names": ["BASTIEN LEROUX", "BASTIEN"], "gender": "?", "first": 4, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DRIVE-IN SCREEN, ABANDONED - LATE AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "A rusted frame stands over a field gone to goldenrod.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "KESTREL \"KES\" ODUYA (16) lies flat on the hood of a hatchback, shoes off.", "para": 0, "sent": 1, "present": [0, 1]}, {"u": 3, "kind": "action", "text": "His sister WILLOW ODUYA (13) sits on the bumper, kicking gravel.", "para": 0, "sent": 2, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "Their cousin BASTIEN LEROUX (17) arrives on a bicycle, one wheel ticking.", "para": 0, "sent": 3, "present": [0, 1, 2]}, {"u": 5, "kind": "action", "text": "He drops the bike.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "She watches him come.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Kes doesn't turn his head.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "You said four.", "name": "BASTIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "It's four.", "name": "KES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "It's four-twenty.", "name": "BASTIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "He's been lying there since three.", "name": "WILLOW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Thinking.", "name": "KES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "About what?", "name": "BASTIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Nothing. That's the point of it.", "name": "KES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "You said you'd teach me to drive today.", "name": "WILLOW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "I said maybe.", "name": "KES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "You said Saturday, and it's Saturday.", "name": "WILLOW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "She's got a point.", "name": "BASTIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Nobody asked you.", "name": "KES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "You're the one who asked me to come.", "name": "BASTIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "I know.", "name": "KES", "speaker": 0, "ext": [], "paren": ["a long pause"], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Is this about Dad?", "name": "WILLOW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "No.", "name": "KES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "It's about Dad.", "name": "WILLOW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Willow.", "name": "BASTIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "What? He moved out in April. We're allowed to say it.", "name": "WILLOW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "It's not about Dad. It's about the screen. They used to show movies on it. Did you know that? Mom said they'd park here and nobody watched. They'd just sit.", "name": "KES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Sounds nice.", "name": "BASTIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "That's what I mean. It sounds nice.", "name": "KES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Can I still sit behind the wheel?", "name": "WILLOW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Come on. Keys are in the visor.", "name": "KES", "speaker": 0, "ext": [], "paren": ["sitting up, finally"], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Do I get a turn?", "name": "BASTIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "After her.", "name": "KES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Ha.", "name": "WILLOW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}