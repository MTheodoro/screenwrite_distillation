{"scene_id": "s01878", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01878.fountain", "heading": "INT. FUNERAL HOME EMBALMING ROOM - NIGHT", "cast": [{"id": 0, "name": "DELPHINE ROUX", "names": ["DELPHINE ROUX", "DELPHINE"], "gender": "?", "first": 5, "spoke": 4}, {"id": 1, "name": "OSEI BANDELE", "names": ["OSEI BANDELE", "OSEI"], "gender": "m", "first": 6, "spoke": 2}, {"id": 2, "name": "WALT KOWALCZYK", "names": ["WALT KOWALCZYK", "WALT"], "gender": "m", "first": 7, "spoke": 2}, {"id": 3, "name": "MOTHER ALDER", "names": ["ALDER", "MOTHER ALDER"], "gender": "?", "first": 12, "spoke": 1}, {"id": 4, "name": "DEACON FIRMIN", "names": ["DEACON FIRMIN"], "gender": "?", "first": 34, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. FUNERAL HOME EMBALMING ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Tile.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Drains.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "One steel table, covered.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A radio hums static in the corner.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DELPHINE ROUX (30s, mortician's apron) checks a clipboard.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her assistant, OSEI BANDELE (20s, headphones around his neck), eats crackers from the sleeve.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "At the door, WALT KOWALCZYK (60s, groundskeeper, flashlight), keeps his back to the wall.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "She frowns.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "The clipboard lists one body.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "The table is lumpy under the sheet, wrong somehow.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Osei. How many did we take in?", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "One. Mr. Alder.", "name": "OSEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Then why is it that big?", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "He stops chewing.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Walt's flashlight beam trembles on the floor.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Don't lift it.", "name": "WALT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Walt.", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Don't. Please.", "name": "WALT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "She lifts it anyway.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Underneath lies old MR. ALDER, gray, still.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "And on his chest, curled like a cat, sits a girl of about eight in a wet nightgown, eyes open, humming along with the radio.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Sweetheart, whose are you?", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "^Oh no. No no no.", "name": "OSEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "The girl stops humming.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Looks at her.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Smiles with all her teeth.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Marnie. Come away from there.", "name": "MOTHER ALDER", "speaker": 3, "ext": ["O.S."], "paren": ["from the hallway"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "The lights flicker.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Walt drops the flashlight.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "It rolls to the drain and goes out.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "They back toward the door.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "He grabs the knob.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "It's already turning from the other side.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Open up. Please. She's followed me home too.", "name": "DEACON FIRMIN", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}