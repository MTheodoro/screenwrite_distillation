{"scene_id": "s01880", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01880.fountain", "heading": "INT. COIN LAUNDRY, ALL-NIGHT - NIGHT", "cast": [{"id": 0, "name": "MARCHETTI", "names": ["MARCHETTI"], "gender": "?", "first": 5, "spoke": 11}, {"id": 1, "name": "ARCHIE PENNYWHISTLE", "names": ["ARCHIE PENNYWHISTLE", "ARCHIE"], "gender": "m", "first": 6, "spoke": 7}, {"id": 2, "name": "RENATA", "names": ["RENATA"], "gender": "?", "first": 7, "spoke": 2}, {"id": 3, "name": "MEZ-LUND", "names": ["MEZ-LUND"], "gender": "?", "first": 7, "spoke": 0}, {"id": 4, "name": "TOMASZ BRZOZOWSKI", "names": ["TOMASZ BRZOZOWSKI", "TOMASZ"], "gender": "?", "first": 36, "spoke": 4}, {"id": 5, "name": "WIN", "names": ["WIN"], "gender": "?", "first": 59, "spoke": 2}, {"id": 6, "name": "ABARA", "names": ["ABARA"], "gender": "?", "first": 59, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. COIN LAUNDRY, ALL-NIGHT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dryers turning.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fluorescent hum.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Orange plastic chairs bolted in rows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A vending machine sells soap and nothing else.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DET. SOLEDAD \"SOL\" MARCHETTI (40s, windbreaker, paper cup) takes the chair nearest the door.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Opposite her, ARCHIE PENNYWHISTLE (60s, flannel, crossword) folds towels with a care that borders on ceremony.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Near the dryers, RENATA G\u00d3MEZ-LUND (30s, scrubs, earbuds) watches a spinning load of white shirts.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Marchetti sips.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Looks at no one in particular.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Slow night.", "name": "MARCHETTI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "They all are, now.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "He sets a towel on the pile.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Squares the corners.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "You work here long?", "name": "MARCHETTI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Eleven years. Owner's my cousin. He doesn't come in.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Nice. A quiet job.", "name": "MARCHETTI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "It is until it isn't.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Renata pulls out an earbud.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Glances at Marchetti.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Looks away.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Her load stops.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "She opens the door and pulls the shirts into a basket, one by one.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Each is folded before it is warm.", "para": 4, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Those look like hospital shirts.", "name": "MARCHETTI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "They're mine.", "name": "RENATA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "All of them?", "name": "MARCHETTI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "It's a big family.", "name": "RENATA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Archie turns the page of his crossword.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Pencils in a word.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Erases it.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Seven letters. \"Alibi.\"", "name": "MARCHETTI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Excuse?", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Six. Excuse is six.", "name": "MARCHETTI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Then I don't have one.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "The bell on the door.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "TOMASZ BRZOZOWSKI (30s, leather jacket, wet hair) enters with a duffel and stops.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "His eyes go to Renata.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Then to Marchetti's windbreaker, to the badge clipped beneath it.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "He nods once, pleasantly, like a man at the wrong party.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Evening.", "name": "TOMASZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Evening.", "name": "MARCHETTI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Machine three is broken, friend. Use five.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "I've got my own, thanks.", "name": "TOMASZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "He unzips the duffel.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Takes out a single folded shirt.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Holds it up to the light.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Renata drops the basket.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Nobody speaks.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "A dryer thuds, thuds, thuds.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "A coin rattles down inside it.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "^Machine five. It's good.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "^Mr. Brzozowski. Sit down.", "name": "MARCHETTI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Tomasz folds the shirt into quarters.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "Then smaller.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "A kind of smile.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "I haven't given my name.", "name": "TOMASZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "You didn't need to.", "name": "MARCHETTI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "From the back, a door opens.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "WINSTON \"WIN\" ABARA (50s, owner's cousin's lawyer, expensive coat) steps out of the supply closet, buttoning his jacket.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 60, "kind": "action", "text": "He looks at the room.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 61, "kind": "action", "text": "Nobody looks at him.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 62, "kind": "dialogue", "text": "It's all right, Tomasz. They only have the one.", "name": "WIN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 63, "kind": "dialogue", "text": "The one what?", "name": "TOMASZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 64, "kind": "dialogue", "text": "The one thing, son. The rest is dryer lint.", "name": "WIN", "speaker": 5, "ext": [], "paren": ["gently"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 65, "kind": "action", "text": "Marchetti stands.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 66, "kind": "action", "text": "Her cup is empty.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 67, "kind": "action", "text": "She sets it very neatly on the chair.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 68, "kind": "dialogue", "text": "Then let's start with the one.", "name": "MARCHETTI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 69, "kind": "action", "text": "Renata picks up the basket again.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 70, "kind": "action", "text": "Archie closes his crossword.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 71, "kind": "action", "text": "The dryers keep turning.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}]}