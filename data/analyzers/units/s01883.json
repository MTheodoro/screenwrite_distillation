{"scene_id": "s01883", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01883.fountain", "heading": "INT. UNDERWATER HABITAT KITCHEN, SEA STATION ALDEBARAN - NIGHT", "cast": [{"id": 0, "name": "ZEKE", "names": ["ZEKE"], "gender": "?", "first": 4, "spoke": 2}, {"id": 1, "name": "ROMANOV-ABARA", "names": ["ROMANOV-ABARA"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "TAMSIN VOYLE", "names": ["TAMSIN VOYLE", "TAMSIN"], "gender": "f", "first": 5, "spoke": 2}, {"id": 3, "name": "NIMA TSERING", "names": ["NIMA TSERING", "NIMA"], "gender": "?", "first": 26, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. UNDERWATER HABITAT KITCHEN, SEA STATION ALDEBARAN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Steel counters.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Portholes full of black.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A kettle ticks as it cools.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "EZEKIEL \"ZEKE\" ROMANOV-ABARA (50s, lined face, heavy cardigan) stands at the counter slicing bread into even squares.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "TAMSIN VOYLE (30s, shaved head, rubber gloves) dries a plate she has dried before.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "She watches the water rather than him.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "He sets the knife down.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "She sets the plate down.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Neither speaks.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Pipes knock somewhere far off.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He pours two cups of tea.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Slides one toward her.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She lets it sit and cool.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "He sits.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "She does not.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "After a while she picks up the cup, looks into it, and puts it back without drinking.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "His eyes follow her hand.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "He turns the bread over.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "She turns her back.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "At the porthole, a pale shape glides past: a long, slow, luminous thing.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "They both see it.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Neither remarks on it.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "He folds his hands.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "She wipes the counter, which is already clean.", "para": 6, "sent": 4, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "A hatch clunks.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "NIMA TSERING (20s, wool cap, tool belt) comes in with a clipboard, hesitates, reads the room like a gauge.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Pressure's holding. Thought you'd want to know.", "name": "NIMA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Thank you.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Is everything all right?", "name": "NIMA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Fine.", "name": "TAMSIN", "speaker": 2, "ext": [], "paren": ["very evenly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Nima waits.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Nobody adds anything.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "She nods, writes something down, and goes.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "The hatch clunks again.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "He takes a slice of bread, tears it in half, and offers her one piece.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "She looks at it.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "She takes it.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Eats.", "para": 9, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "They both look at the porthole, where the shape has returned and is now circling.", "para": 9, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "It follows the light.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "So do we.", "name": "TAMSIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}