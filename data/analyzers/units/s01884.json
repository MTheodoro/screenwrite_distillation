{"scene_id": "s01884", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01884.fountain", "heading": "INT. COMMUNITY CENTER BASEMENT, BINGO NIGHT - NIGHT", "cast": [{"id": 0, "name": "MAGS", "names": ["MAGS"], "gender": "f", "first": 4, "spoke": 9}, {"id": 1, "name": "DELACOURT-PIKE", "names": ["DELACOURT-PIKE"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "DARNELL FONTAINE", "names": ["DARNELL FONTAINE", "DARNELL"], "gender": "?", "first": 5, "spoke": 13}, {"id": 3, "name": "LORRAINE FONTAINE", "names": ["LORRAINE FONTAINE", "LORRAINE"], "gender": "m", "first": 5, "spoke": 12}, {"id": 4, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 24, "spoke": 2}, {"id": 5, "name": "CALVIN", "names": ["CALVIN"], "gender": "?", "first": 28, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. COMMUNITY CENTER BASEMENT, BINGO NIGHT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Folding tables, fluorescent flicker, a coffee urn the size of a toddler.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Forty chairs, eleven players.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cage of numbered balls spins slowly.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Behind the microphone, MARGUERITE \"MAGS\" DELACOURT-PIKE (60s, cardigan, rhinestone glasses) holds a ball.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "At table three, DARNELL FONTAINE (30s, delivery uniform) hunches over four cards.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "action", "text": "Beside him, his mother LORRAINE FONTAINE (60s, church hat) marks each number with a stub of crayon.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "B-nine.", "name": "MAGS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "That's yours.", "name": "LORRAINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "I know it's mine.", "name": "DARNELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "I-twenty-two.", "name": "MAGS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Mama, I told you I'd come on Thursday.", "name": "DARNELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "You said Thursday, and then you said Friday, and then you said next week.", "name": "LORRAINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "N-forty-one.", "name": "MAGS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "I've been working doubles.", "name": "DARNELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Doing what?", "name": "LORRAINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Deliveries. The same as last time you asked.", "name": "DARNELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "G-fifty-six.", "name": "MAGS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Funny. I called the depot. They said you quit in May.", "name": "LORRAINE", "speaker": 3, "ext": [], "paren": ["marking"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Darnell's crayon stops.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "He puts it down.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "You called my work.", "name": "DARNELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "I called a number on your jacket.", "name": "LORRAINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "O-seventy-one.", "name": "MAGS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "A STRANGER (40s, windbreaker, clipboard) sits at the edge of table three.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Nobody saw him arrive.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Mr. Fontaine. I'm sorry to interrupt.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Who are you?", "name": "DARNELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Calvin Ortega, county clerk's office. You missed three hearings.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "What hearings?", "name": "LORRAINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Mama, don't.", "name": "DARNELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "I only need a signature, sir. Right here.", "name": "CALVIN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Table three, keep it down, please. B-four.", "name": "MAGS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Darnell takes the pen.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Signs.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "His hand shakes.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Lorraine reads the form over his shoulder, then looks at the cards, then at him.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "You lost the apartment.", "name": "LORRAINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "In June.", "name": "DARNELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Where have you been sleeping?", "name": "LORRAINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "In the van. Until they took the van.", "name": "DARNELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "B-nine. Again. Somebody's got a B-nine.", "name": "MAGS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Lorraine stands.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "The chair scrapes.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Heads turn.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "She takes off her church hat and puts it down on the table, very gently, like laying a flag.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "You come home. Tonight.", "name": "LORRAINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "Mama--", "name": "DARNELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "I am not asking.", "name": "LORRAINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "Why are you doing this here? In front of everyone?", "name": "DARNELL", "speaker": 2, "ext": [], "paren": ["rising, voice cracking"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "Because everywhere else you stop picking up the phone.", "name": "LORRAINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "He flings the cards.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "They scatter.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "Marked or not, they rain across the floor.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "I didn't want you to see me like this!", "name": "DARNELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "Table three!", "name": "MAGS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "Like what? Like a man who failed?", "name": "DARNELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "Calvin retreats three steps, clipboard raised like a shield.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "Mags has gone silent, one ball in her fist.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "Eleven players watch.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "action", "text": "The cage creaks once more and stops.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "dialogue", "text": "Like my son.", "name": "LORRAINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "He stands there.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "She does not move.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "Mags, very softly, into the microphone.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "dialogue", "text": "Bingo, I think. If anyone's asking.", "name": "MAGS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}