{"scene_id": "s01885", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01885.fountain", "heading": "INT. GLASSBLOWER'S STUDIO, MURANO - LATE AFTERNOON", "cast": [{"id": 0, "name": "CHIARA BELLINI-OKADA", "names": ["CHIARA BELLINI-OKADA", "CHIARA"], "gender": "?", "first": 3, "spoke": 5}, {"id": 1, "name": "ELIAS WARDLAW", "names": ["ELIAS WARDLAW", "ELIAS"], "gender": "?", "first": 4, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. GLASSBLOWER'S STUDIO, MURANO - LATE AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "The furnace roars.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Orange light on every wall.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "CHIARA BELLINI-OKADA (30s, leather apron, burn scars on both forearms) turns a rod of molten glass.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "ELIAS WARDLAW (30s, rumpled linen, a stranger to heat) stands too close to the bench with a notebook.", "para": 0, "sent": 3, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "Is it always this hot?", "name": "ELIAS", "speaker": 1, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Always. You'll melt before the glass does.", "name": "CHIARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "They laugh.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "The glass swells on the pipe, a glowing teardrop, and for a moment the studio feels very small and very kind.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He steps in to see.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She swings the rod without looking.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "The blob drips to the floor.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "They both leap back, collide, and fall in a heap, his notebook skidding under the bench.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "I am so sorry.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "You should be.", "name": "CHIARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She is laughing again.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He is not.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Stupid. Stupid. Stupid.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She reaches over, tilts his chin toward the light, and inspects a small red mark on his jaw.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "You're burned.", "name": "CHIARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "I'm fine.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Hold still.", "name": "CHIARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "They freeze.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Her thumb rests on his cheek.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "The furnace roars.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Neither breathes.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "My father says never look at the fire. Only at the glass.", "name": "CHIARA", "speaker": 0, "ext": ["CONT'D"], "paren": ["quietly"], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "And where do I look?", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "She doesn't answer.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "He does not look at the glass.", "para": 6, "sent": 1, "present": [0, 1]}]}