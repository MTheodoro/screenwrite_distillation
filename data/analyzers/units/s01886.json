{"scene_id": "s01886", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01886.fountain", "heading": "INT. ABANDONED PLANETARIUM - NIGHT", "cast": [{"id": 0, "name": "GIGI", "names": ["GIGI"], "gender": "?", "first": 5, "spoke": 8}, {"id": 1, "name": "HALVORSEN", "names": ["HALVORSEN"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "DEZ", "names": ["DEZ"], "gender": "?", "first": 6, "spoke": 6}, {"id": 3, "name": "OYELARAN-PRICE", "names": ["OYELARAN-PRICE"], "gender": "?", "first": 6, "spoke": 0}, {"id": 4, "name": "MARI", "names": ["MARI"], "gender": "f", "first": 7, "spoke": 6}, {"id": 5, "name": "CASTELLANOS", "names": ["CASTELLANOS"], "gender": "?", "first": 7, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED PLANETARIUM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dust.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A cracked dome.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The projector sits in the center like a sleeping insect.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Three flashlights wander across the ceiling, snagging on fallen plaster.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "GRETA \"GIGI\" HALVORSEN (17, hoodie, camera around her neck) climbs onto the star-seat rail.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "DESMOND \"DEZ\" OYELARAN-PRICE (18, varsity jacket, sweating) follows.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "MARISOL \"MARI\" CASTELLANOS (17, headlamp, cracked phone) stays at the door, one hand on the frame.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "dialogue", "text": "Dez. Mari. Check it out. It's still plugged in.", "name": "GIGI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "Gigi, nothing here is plugged in.", "name": "DEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Tell that to the little red light.", "name": "GIGI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "She points.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "A tiny red diode on the projector's base, glowing steadily.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "Dez swallows.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "Mari lowers her phone.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Gigi, I'm serious. Let's go.", "name": "MARI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "We came all this way, Mari.", "name": "GIGI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "We came because you dared us. I'm daring us the other way.", "name": "MARI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "She has a point, Gigi.", "name": "DEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "You two are such babies.", "name": "GIGI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "She crosses to the projector and wipes the dust from the lens with her sleeve.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Dez hovers at her shoulder, and Mari edges in from the doorway, until all three huddle around the old machine, flashlights pooled on its brass.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Don't touch the switch.", "name": "DEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Don't tell me what to touch.", "name": "GIGI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Seriously, Gigi, don't.", "name": "MARI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Gigi touches the switch.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Click.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Nothing.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Then, far overhead, a hum.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "The dome fills with stars: soft, warm, and wrong, slowly drifting out of order, constellations sliding into new shapes.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "That's not the sky.", "name": "MARI", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "It's a planetarium, Mari. It's supposed to not be the sky.", "name": "DEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "It's beautiful.", "name": "GIGI", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "She raises her camera and the shutter clicks.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Stars turn.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "The shapes settle into letters, then words.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "All three read them together without meaning to.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "\"Gigi. Dez. Mari.\"", "name": "DEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "It knows our names.", "name": "MARI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "It's a trick. Someone planned this.", "name": "GIGI", "speaker": 0, "ext": [], "paren": ["lowering the camera"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Who? Nobody knew we were coming.", "name": "DEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "I told no one. I swear.", "name": "MARI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Then who wrote it?", "name": "GIGI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "The stars shift again.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "One more word, slowly forming.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "\"STAY.\"", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}