{"scene_id": "s01887", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01887.fountain", "heading": "EXT. ROADSIDE, STALLED SCHOOL BUS - AFTERNOON", "cast": [{"id": 0, "name": "EZRA PLUMLEY", "names": ["EZRA PLUMLEY", "PLUMLEY"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "TOBIAS KRALL", "names": ["TOBIAS KRALL", "TOBIAS"], "gender": "m", "first": 6, "spoke": 1}, {"id": 2, "name": "NGOZI ADEBAYO", "names": ["NGOZI ADEBAYO", "NGOZI"], "gender": "f", "first": 7, "spoke": 2}, {"id": 3, "name": "RAFF", "names": ["RAFF"], "gender": "?", "first": 8, "spoke": 8}, {"id": 4, "name": "BOONE", "names": ["BOONE"], "gender": "?", "first": 8, "spoke": 0}, {"id": 5, "name": "MEI-LIN SOONG", "names": ["MEI-LIN SOONG", "MEI-LIN"], "gender": "?", "first": 9, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ROADSIDE, STALLED SCHOOL BUS - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Heat shimmer.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Corn on both sides.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The hood is up and smoke curls from the engine.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MR. EZRA PLUMLEY (50s, driver, cap pulled low) peers at the radiator.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "On the curb, four teens sit in a row.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "TOBIAS KRALL (16, lanky, headphones).", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "NGOZI ADEBAYO (16, braids, a worn paperback).", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "RAFFERTY \"RAFF\" BOONE (17, football jacket, bouncing knee).", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "MEI-LIN SOONG (15, sketchbook shut).", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "How long?", "name": "RAFF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Until it stops smoking.", "name": "PLUMLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "That's not a time.", "name": "RAFF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "NGOZI turns a page.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "Doesn't read it.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "TOBIAS pulls one earphone out.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Puts it back.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Raff, you're shaking the curb.", "name": "MEI-LIN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "I'm not.", "name": "RAFF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "He is.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "He stops.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Starts again.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Somebody toss me the water jug.", "name": "PLUMLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Nobody moves.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Tobias stands.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Gets the jug from the bus steps.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Hands it over without a word.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Sits again, closer to Ngozi than before.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "You hate this book.", "name": "NGOZI", "speaker": 2, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "I never said that.", "name": "TOBIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "You've been holding it upside down for ten minutes.", "name": "NGOZI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "He looks.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "She's right.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "He turns it.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "She hides a smile in the page.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Okay, seriously. We're missing the game.", "name": "RAFF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "It's a scrimmage.", "name": "MEI-LIN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "It's the scrimmage.", "name": "RAFF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Not today, son.", "name": "PLUMLEY", "speaker": 0, "ext": [], "paren": ["from under the hood"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Raff kicks a pebble into the corn.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Silence.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Plumley's wrench clinks.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "A crow somewhere.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "Raff.", "name": "MEI-LIN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "What.", "name": "RAFF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Your dad's not coming, is he.", "name": "MEI-LIN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Raff stops.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "His whole body stops.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "The knee, the hands, the breath.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "NGOZI closes her book.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "TOBIAS takes off his headphones, finally.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "I told him two-thirty.", "name": "RAFF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "It's four.", "name": "MEI-LIN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "He's probably stuck behind a tractor.", "name": "RAFF", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "Nobody answers.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "Plumley slams the hood.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "The smoke is gone.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "All right, folks. Load up.", "name": "PLUMLEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "They rise in order.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "Raff last.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "action", "text": "He looks down the empty road one more time, then climbs the steps and sits alone, three seats from anyone, jacket collar up.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}