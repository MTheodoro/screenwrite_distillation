{"scene_id": "s01888", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01888.fountain", "heading": "INT. MARS COLONY MESS TENT - EVENING", "cast": [{"id": 0, "name": "CAPTAIN BRYONY ASHWORTH", "names": ["CAPTAIN BRYONY ASHWORTH", "ASHWORTH"], "gender": "f", "first": 4, "spoke": 7}, {"id": 1, "name": "ENGINEER TAVITA FETU", "names": ["ENGINEER TAVITA FETU", "TAVITA"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "BOTANIST LAILA NASSIR", "names": ["BOTANIST LAILA NASSIR", "LAILA"], "gender": "?", "first": 6, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. MARS COLONY MESS TENT - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Plastic tables.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sand drifting under the flap.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A lamp swings from the ridgepole.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CAPTAIN BRYONY ASHWORTH (40s, sunburnt) deals protein bars out of a crate like cards.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "ENGINEER TAVITA FETU (30s, broad) leans against the pole.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "BOTANIST LAILA NASSIR (30s, thin, notes) writes in a ledger.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Two each. Tavita, you have three coming.", "name": "ASHWORTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "I'll take two.", "name": "TAVITA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "You'll take three. You haul the panels.", "name": "ASHWORTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Others haul too.", "name": "TAVITA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Everyone hauls. It's tent rules.", "name": "LAILA", "speaker": 2, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "It's my rule. I'm Captain.", "name": "ASHWORTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Then Captain, the ledger says we have eleven days of rations left.", "name": "LAILA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Bryony stops dealing.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Tavita pushes off the pole.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "You said twenty.", "name": "TAVITA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Twenty was the count before the dust storm took crate six.", "name": "LAILA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Crate six was mine.", "name": "ASHWORTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I noticed.", "name": "LAILA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Say what you mean.", "name": "ASHWORTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "I mean you dealt me two bars and kept five.", "name": "LAILA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Ashworth looks at the bars in her hand.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "She does not deny it.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Bry.", "name": "TAVITA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "They're not for me.", "name": "ASHWORTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Then who?", "name": "LAILA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Tavita steps in and takes the crate.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Laila stands.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Ashworth grabs the crate's other handle.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "They all pull, and the crate tips, bars scattering across the sand-dusted floor.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "They freeze.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Nobody bends to gather them.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "They're for Tavita's kid. Back on the Hab. The ration cut starts Monday.", "name": "ASHWORTH", "speaker": 0, "ext": ["CONT'D"], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Tavita lets go.", "para": 6, "sent": 0, "present": [0, 1, 2]}]}