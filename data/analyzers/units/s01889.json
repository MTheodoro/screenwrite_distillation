{"scene_id": "s01889", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01889.fountain", "heading": "INT. SKATE SHOP BACKROOM - NIGHT", "cast": [{"id": 0, "name": "DEV", "names": ["DEV"], "gender": "?", "first": 5, "spoke": 10}, {"id": 1, "name": "MWANGI", "names": ["MWANGI"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "TESSA PRZYBYLSKI", "names": ["TESSA PRZYBYLSKI", "TESSA"], "gender": "f", "first": 6, "spoke": 8}, {"id": 3, "name": "JUN-HO CHOI", "names": ["JUN-HO CHOI", "JUN-HO"], "gender": "?", "first": 7, "spoke": 8}, {"id": 4, "name": "MARCY", "names": ["MARCY"], "gender": "?", "first": 8, "spoke": 11}, {"id": 5, "name": "ROUSSEAU", "names": ["ROUSSEAU"], "gender": "?", "first": 8, "spoke": 0}, {"id": 6, "name": "RADIO ANNOUNCER", "names": ["RADIO ANNOUNCER"], "gender": "?", "first": 43, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. SKATE SHOP BACKROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Stacked decks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A mini fridge.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A busted couch.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A radio on the shelf mutters traffic.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DEVONTE \"DEV\" MWANGI (17, bleached hair, scraped elbows) tapes grip onto a board.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "TESSA PRZYBYLSKI (17, overalls, zine in her back pocket) sits cross-legged on the couch.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "JUN-HO CHOI (18, nervous, backpack on) stands by the door.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "MARCELLINE \"MARCY\" ROUSSEAU (16, thrift-store blazer) hunches beside the fridge, phone in hand.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "Okay, Dev. Jun-ho wants to say something.", "name": "TESSA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Then he can say it.", "name": "DEV", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "I... got in.", "name": "JUN-HO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Got in where?", "name": "TESSA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Seoul. Design school. The letter came today.", "name": "JUN-HO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Dude. That's huge.", "name": "DEV", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "When do you leave?", "name": "MARCY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "August.", "name": "JUN-HO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Jun-ho, that's like two months.", "name": "TESSA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Two and a half.", "name": "JUN-HO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Marcy, tell him it's cool.", "name": "DEV", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "It's cool.", "name": "MARCY", "speaker": 4, "ext": [], "paren": ["flat"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "See? Cool.", "name": "DEV", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "You don't think I'm abandoning you?", "name": "JUN-HO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Jun-ho, you're the only one who can actually draw.", "name": "TESSA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Tessa.", "name": "DEV", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "What? It's true. The rest of us just push wood.", "name": "TESSA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "My phone's buzzing.", "name": "MARCY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Answer it.", "name": "DEV", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "It's my mom. She'll just ask where I am.", "name": "MARCY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "So tell her.", "name": "DEV", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Hi, Maman. At Dev's. No. No, I'm eating. Okay. Okay. Love you.", "name": "MARCY", "speaker": 4, "ext": [], "paren": ["answering, bright"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "She hangs up.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Everyone looks at her.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "What?", "name": "MARCY", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Marcy. You haven't eaten since lunch.", "name": "TESSA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "I'm not hungry.", "name": "MARCY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "You said that at lunch.", "name": "DEV", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "I'll get pizza.", "name": "JUN-HO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Don't.", "name": "MARCY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Marcy.", "name": "JUN-HO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "I said don't!", "name": "MARCY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "The radio crackles.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "A voice leaks through.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "...and that's the weather. Tomorrow clear, with a high of seventy-eight...", "name": "RADIO ANNOUNCER", "speaker": 6, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "dialogue", "text": "We should go skate. The lot's empty.", "name": "DEV", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "It's ten at night.", "name": "TESSA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "dialogue", "text": "So it's empty.", "name": "DEV", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "dialogue", "text": "I'm in.", "name": "JUN-HO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "dialogue", "text": "Fine. But I'm not wearing a helmet.", "name": "MARCY", "speaker": 4, "ext": [], "paren": ["after a long beat"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "dialogue", "text": "Marcy.", "name": "TESSA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "dialogue", "text": "Fine, fine. A helmet.", "name": "MARCY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "action", "text": "Dev grins.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "action", "text": "He tosses the board to Jun-ho.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}]}