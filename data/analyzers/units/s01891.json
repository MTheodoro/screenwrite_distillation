{"scene_id": "s01891", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01891.fountain", "heading": "INT. BOWLING CENTER, STATE FINALS - EVENING", "cast": [{"id": 0, "name": "COACH TERESA BIANCHI-ODEH", "names": ["COACH TERESA BIANCHI-ODEH", "BIANCHI-ODEH"], "gender": "?", "first": 5, "spoke": 4}, {"id": 1, "name": "CALEB STRUTHERS", "names": ["CALEB STRUTHERS", "CALEB"], "gender": "?", "first": 6, "spoke": 3}, {"id": 2, "name": "PILAR NU", "names": ["PILAR NU", "PILAR"], "gender": "?", "first": 6, "spoke": 5}, {"id": 3, "name": "EZ-WADE", "names": ["EZ-WADE"], "gender": "?", "first": 6, "spoke": 0}, {"id": 4, "name": "FELICITY OKONKWO", "names": ["FELICITY OKONKWO", "FELICITY"], "gender": "?", "first": 7, "spoke": 4}, {"id": 5, "name": "OZ", "names": ["OZ"], "gender": "?", "first": 8, "spoke": 3}, {"id": 6, "name": "KETTERING", "names": ["KETTERING"], "gender": "?", "first": 8, "spoke": 0}, {"id": 7, "name": "OVER THE PA", "names": ["OVER THE PA"], "gender": "?", "first": 4, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. BOWLING CENTER, STATE FINALS - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Lanes polished to a shine.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Overhead scoreboards.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A banner reads \"REGIONAL CHAMPIONSHIP.\"", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The pins crash in the distance.", "para": 0, "sent": 3, "present": [7]}, {"u": 5, "kind": "action", "text": "COACH TERESA BIANCHI-ODEH (50s, windbreaker, clipboard) paces behind the team's lane.", "para": 1, "sent": 0, "present": [0, 7]}, {"u": 6, "kind": "action", "text": "At the ball return, seniors CALEB STRUTHERS (18, broad) and PILAR NU\u00d1EZ-WADE (17, wiry) wait their turns.", "para": 1, "sent": 1, "present": [0, 1, 2, 3, 7]}, {"u": 7, "kind": "action", "text": "Manager FELICITY OKONKWO (16, headset, stats binder) feeds numbers into a tablet.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4, 7]}, {"u": 8, "kind": "action", "text": "And at the end of the lane, anchor OSWALD \"OZ\" KETTERING (17, braces, shaking hands) rubs chalk on his fingers.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 9, "kind": "dialogue", "text": "Final frame. Carson Valley leads by seven. Carson Valley, you have the lane.", "name": "OVER THE PA", "speaker": 7, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 10, "kind": "dialogue", "text": "Listen up. Oz, you need a strike. Just a strike. No spare helps us.", "name": "BIANCHI-ODEH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 11, "kind": "dialogue", "text": "I know, Coach.", "name": "OZ", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 12, "kind": "dialogue", "text": "He knows.", "name": "CALEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 13, "kind": "dialogue", "text": "Leave him alone.", "name": "PILAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 14, "kind": "dialogue", "text": "Oz. Breathe.", "name": "PILAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 15, "kind": "dialogue", "text": "Percentage of strikes on the left oil pattern is--", "name": "FELICITY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 16, "kind": "dialogue", "text": "Felicity, not now.", "name": "BIANCHI-ODEH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 17, "kind": "dialogue", "text": "Sorry.", "name": "FELICITY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 18, "kind": "dialogue", "text": "Oz, you got this.", "name": "PILAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 19, "kind": "dialogue", "text": "Yeah, Oz, you got--", "name": "CALEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 20, "kind": "dialogue", "text": "Please stop.", "name": "OZ", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 21, "kind": "action", "text": "They stop.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 22, "kind": "action", "text": "Oz takes the ball.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 23, "kind": "action", "text": "Weighs it.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 24, "kind": "action", "text": "Steps to the line.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 25, "kind": "action", "text": "A quiet falls.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 26, "kind": "action", "text": "He draws back, releases.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 27, "kind": "action", "text": "The ball curves, rolls, rolls, hits.", "para": 2, "sent": 6, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 28, "kind": "action", "text": "Nine pins fall.", "para": 2, "sent": 7, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 29, "kind": "action", "text": "One wobbles, wobbles, wobbles.", "para": 2, "sent": 8, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "dialogue", "text": "Come on.", "name": "CALEB", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "dialogue", "text": "Fall, fall, fall.", "name": "PILAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "dialogue", "text": "Probability of the ten-pin falling is--", "name": "FELICITY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "dialogue", "text": "Felicity.", "name": "PILAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "dialogue", "text": "Shutting up.", "name": "FELICITY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "action", "text": "The ten-pin stands.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "action", "text": "Still.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "action", "text": "Dead still.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "action", "text": "Oz stares.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "action", "text": "His shoulders slump.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "dialogue", "text": "Sorry, Coach.", "name": "OZ", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 41, "kind": "dialogue", "text": "Don't be. Take the spare.", "name": "BIANCHI-ODEH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 42, "kind": "action", "text": "Oz takes the second ball.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 43, "kind": "action", "text": "Walks to the line.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 44, "kind": "action", "text": "The same quiet.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 45, "kind": "action", "text": "He lets it go.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 46, "kind": "action", "text": "It rolls straight down the right gutter's edge and clips the ten-pin from the side.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 47, "kind": "action", "text": "It tumbles.", "para": 4, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 48, "kind": "action", "text": "Falls.", "para": 4, "sent": 6, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 49, "kind": "action", "text": "The scoreboard flashes.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 50, "kind": "action", "text": "The team explodes.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 51, "kind": "action", "text": "Caleb hoists Oz into the air.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 52, "kind": "action", "text": "Pilar howls.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 53, "kind": "action", "text": "Felicity types a number, then screams.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 54, "kind": "dialogue", "text": "Final score. Brookfield Prep, two-eleven. Carson Valley, two-ten. Brookfield takes the title.", "name": "OVER THE PA", "speaker": 7, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 55, "kind": "action", "text": "Everyone freezes.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 56, "kind": "action", "text": "Slowly, one by one, they turn to Bianchi-Odeh, who is calmly capping her pen.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 57, "kind": "dialogue", "text": "Pack up.", "name": "BIANCHI-ODEH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}