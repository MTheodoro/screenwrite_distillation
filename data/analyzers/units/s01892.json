{"scene_id": "s01892", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01892.fountain", "heading": "INT. FREIGHT ELEVATOR, MUSEUM OF CLOCKS - NIGHT", "cast": [{"id": 0, "name": "VERA KOLOSOVA", "names": ["VERA KOLOSOVA", "VERA"], "gender": "f", "first": 4, "spoke": 5}, {"id": 1, "name": "PETRA LINDGREN-HAYES", "names": ["PETRA LINDGREN-HAYES", "PETRA"], "gender": "?", "first": 4, "spoke": 6}, {"id": 2, "name": "BOLT", "names": ["BOLT"], "gender": "?", "first": 6, "spoke": 5}, {"id": 3, "name": "UCHENNA", "names": ["UCHENNA"], "gender": "?", "first": 6, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. FREIGHT ELEVATOR, MUSEUM OF CLOCKS - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cage steel.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Brass fittings.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Descending.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "VERA KOLOSOVA (40s, black coveralls) and PETRA LINDGREN-HAYES (40s, black coveralls) share a tool case.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Between them, in a silk-lined crate, ticks a golden carriage clock.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "BARRY \"BOLT\" UCHENNA (30s, headset, earpiece) crouches with a laptop.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Hold it level.", "name": "VERA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "I am holding it level.", "name": "PETRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "She is not holding it level.", "name": "VERA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Hey. Hey. She's right. Ladies, please.", "name": "BOLT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Which she?", "name": "PETRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Either one.", "name": "BOLT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "A floor counter flickers.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "B2.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "B3.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Guard's rounds at three-fifteen. We have forty seconds.", "name": "VERA", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Thirty-eight now.", "name": "PETRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Thirty-seven.", "name": "BOLT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "The elevator shudders.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Stops.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Lights die.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "A single tick from the clock.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Don't breathe.", "name": "VERA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "^Don't breathe.", "name": "PETRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "I never breathe, ladies. It's a professional habit.", "name": "BOLT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Footsteps overhead.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Slow.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "A flashlight beam slides down the shaft.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "The three freeze.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "The clock ticks.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Louder.", "para": 5, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Louder.", "para": 5, "sent": 6, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Cover it.", "name": "PETRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Vera drapes her jacket over the crate.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "The ticking muffles.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "The beam drifts, hesitates, fades.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Footsteps walk away.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Lights hum back to life.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "The floor counter reads B4.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Forty seconds.", "name": "BOLT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Twenty-two.", "name": "VERA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Fifteen.", "name": "PETRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "The doors open on a loading dock.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Moonlight.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "A van.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}]}