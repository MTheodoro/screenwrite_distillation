{"scene_id": "s01893", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01893.fountain", "heading": "INT. HOUSEBOAT GALLEY, CANAL - SUNDAY NOON", "cast": [{"id": 0, "name": "INES VASCONCELOS", "names": ["INES VASCONCELOS", "INES"], "gender": "?", "first": 5, "spoke": 9}, {"id": 1, "name": "KOFI VASCONCELOS-MENSAH", "names": ["KOFI VASCONCELOS-MENSAH", "KOFI"], "gender": "?", "first": 6, "spoke": 10}, {"id": 2, "name": "BRIGITTE VASCONCELOS", "names": ["BRIGITTE VASCONCELOS", "BRIGITTE"], "gender": "?", "first": 5, "spoke": 7}, {"id": 3, "name": "LUCAS", "names": ["LUCAS"], "gender": "?", "first": 8, "spoke": 6}, {"id": 4, "name": "ZANELE", "names": ["ZANELE"], "gender": "?", "first": 8, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOUSEBOAT GALLEY, CANAL - SUNDAY NOON", "present": []}, {"u": 1, "kind": "action", "text": "Steam on the windows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A pot of stew on a two-ring stove.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The deck rocks gently.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A table meant for four holds five.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "INES VASCONCELOS (70s, apron, flour to the elbows) stirs.", "para": 1, "sent": 0, "present": [0, 2]}, {"u": 6, "kind": "action", "text": "Her son KOFI VASCONCELOS-MENSAH (40s, glasses) carves bread at the counter.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "His sister BRIGITTE VASCONCELOS (40s, silk scarf) sets spoons.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Two kids tumble in from the deck: LUCAS (9, muddy knees) and ZANELE (7, missing a front tooth).", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Everybody sit. Everybody. The stew is hot.", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Nonna, I'm not hungry.", "name": "LUCAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "I am!", "name": "ZANELE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Wash hands first.", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Both of them.", "name": "BRIGITTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "We did it in the canal.", "name": "LUCAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "That is not washing.", "name": "BRIGITTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "It had a duck in it.", "name": "ZANELE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Of course it did.", "name": "KOFI", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "She holds up two spoons.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "He shakes his head.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "She sets one down.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "He takes the other.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Kofi, did you speak to the landlord?", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Mama, not at the table.", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Everything is at the table. That is what it is for.", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "He said it's fine, Mama. The mooring is paid till spring.", "name": "BRIGITTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "I was going to say that.", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "You were going to say it badly.", "name": "BRIGITTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Can I have the end piece?", "name": "LUCAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "No, I want the end piece!", "name": "ZANELE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Both of you can have half.", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Lucas always gets the big half.", "name": "ZANELE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Do not.", "name": "LUCAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Okay. Everyone. Quiet for one second.", "name": "KOFI", "speaker": 1, "ext": [], "paren": ["to the whole room"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "They hush.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "The boat creaks.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Somewhere a gull complains.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "I'd like to say grace.", "name": "KOFI", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Since when do you say grace?", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Since now. Since the mooring is paid and the stew is hot and nobody fell in the canal this week.", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "I fell in the canal.", "name": "ZANELE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Nobody fell in the canal that I saw.", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Okay.", "name": "ZANELE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Say the grace, Kofi.", "name": "BRIGITTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "He lowers his head.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "They all lower theirs, except Zanele, who peeks.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Lucas peeks too.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "They catch each other peeking and giggle.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Thank you for this boat, and this stew, and this bread, and these people.", "name": "KOFI", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Amen.", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Amen.", "name": "BRIGITTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "Amen. Can I eat now?", "name": "LUCAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "Amen! Can I eat now?", "name": "ZANELE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "Eat, eat. Slowly.", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "They tuck in.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "For a while there is only the scrape of spoons and the slosh of water against the hull.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Brigitte tears a piece of bread and hands it to Ines, who tastes the stew, frowns, and reaches for salt.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "Always needs a little more.", "name": "INES", "speaker": 0, "ext": ["CONT'D"], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "Mama, it's perfect.", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "Perfect is a lie we tell cooks.", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "Then we're liars. Pass the salt, Zanele.", "name": "BRIGITTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "It's by Lucas.", "name": "ZANELE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "dialogue", "text": "Here.", "name": "LUCAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "He slides the salt across.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "Ines salts the stew, tastes it again, and nods, and then, with a small private smile, passes the salt back to Zanele.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}]}