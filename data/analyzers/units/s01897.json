{"scene_id": "s01897", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01897.fountain", "heading": "INT. MOSSY TAVERN INSIDE A HOLLOW OAK - EVENING", "cast": [{"id": 0, "name": "PERRY", "names": ["PERRY"], "gender": "?", "first": 5, "spoke": 8}, {"id": 1, "name": "THISTLEDOWN", "names": ["THISTLEDOWN"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "MARGERY NETTLEBY", "names": ["MARGERY NETTLEBY", "MARGERY"], "gender": "?", "first": 6, "spoke": 5}, {"id": 3, "name": "BRYONY OAKENSHAW", "names": ["BRYONY OAKENSHAW", "BRYONY"], "gender": "f", "first": 7, "spoke": 5}, {"id": 4, "name": "GRIM", "names": ["GRIM"], "gender": "?", "first": 8, "spoke": 6}, {"id": 5, "name": "HOLLOWSTONE", "names": ["HOLLOWSTONE"], "gender": "?", "first": 8, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. MOSSY TAVERN INSIDE A HOLLOW OAK - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Roots for rafters.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Candles in acorn caps.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A fire made of glowworms.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The room smells of honey and rain.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LORD PERIWINKLE \"PERRY\" THISTLEDOWN (60s, dignified, a miniature crown of dew) sits at the table, pouring tea.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "His housekeeper, MARGERY NETTLEBY (50s, apron, spectacles), carries a tray of seed-cakes.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "The apprentice witch BRYONY OAKENSHAW (16, scorched sleeves) hunches over a book.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "And the innkeeper, GRIMBOLD \"GRIM\" HOLLOWSTONE (70s, enormous beard), polishes a mug that has been polished since spring.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "Bryony, my dear, put down the book.", "name": "PERRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "I'm almost at the part, Lord Thistledown.", "name": "BRYONY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Call me Perry. Everyone does.", "name": "PERRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Not everyone, my lord.", "name": "MARGERY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Margery.", "name": "PERRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Perry.", "name": "MARGERY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Tea's gone cold again, I'd say.", "name": "GRIM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "It is always cold. You use your own tea.", "name": "PERRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "It's the principle.", "name": "GRIM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Lord Perry, what did the wizard say when he turned the king into a frog?", "name": "BRYONY", "speaker": 3, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "I'm sure I don't know.", "name": "PERRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "\"Nothing. He'd already left.\"", "name": "BRYONY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "That's a terrible joke, dear.", "name": "MARGERY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "It's a terrible book.", "name": "BRYONY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Would you like to hear a better one?", "name": "GRIM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Please, Grim, not the one about the dragon.", "name": "PERRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "It's a good one about the dragon.", "name": "GRIM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "It has no ending.", "name": "MARGERY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "That's the point of it.", "name": "GRIM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "She sets the tray down.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "He leans back.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Bryony closes her book at last.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "The glowworm fire pulses once.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "It is a good evening.", "name": "PERRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "It is.", "name": "MARGERY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "It's always a good evening, if nobody notices.", "name": "GRIM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "I notice.", "name": "BRYONY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Then it is a good evening anyway.", "name": "PERRY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}