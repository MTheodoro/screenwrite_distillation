{"scene_id": "s01898", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01898.fountain", "heading": "INT. BALLOON-ANIMAL CONVENTION, HOTEL BALLROOM - DAY", "cast": [{"id": 0, "name": "CHESTER", "names": ["CHESTER"], "gender": "?", "first": 5, "spoke": 8}, {"id": 1, "name": "BOONSRI", "names": ["BOONSRI"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "FLO", "names": ["FLO"], "gender": "?", "first": 6, "spoke": 6}, {"id": 3, "name": "OYELARAN", "names": ["OYELARAN"], "gender": "?", "first": 6, "spoke": 0}, {"id": 4, "name": "DOROTHY PRUITT-AKINS", "names": ["DOROTHY PRUITT-AKINS", "DOROTHY"], "gender": "?", "first": 7, "spoke": 6}, {"id": 5, "name": "REG", "names": ["REG"], "gender": "m", "first": 20, "spoke": 9}, {"id": 6, "name": "FAIRCHILD-BANGURA", "names": ["FAIRCHILD-BANGURA"], "gender": "?", "first": 20, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. BALLOON-ANIMAL CONVENTION, HOTEL BALLROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent lights.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Folding tables.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Vendors sell latex in every color.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A banner: \"24TH ANNUAL TWIST-A-THON.\"", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CHESTER \"CHUCKLES\" BOONSRI (40s, vest covered in pins) sets up a booth.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Beside him, FLORENCE \"FLO\" OYELARAN (50s, jumpsuit) inflates a pink poodle.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "And at the next table, a nervous newcomer, DOROTHY PRUITT-AKINS (30s, accountant's blouse), clutches a pack of balloons as though they might go off.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "Welcome to the circuit. First convention?", "name": "CHESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Is it that obvious?", "name": "DOROTHY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "You're holding the balloons like a baby.", "name": "FLO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "I didn't know how else.", "name": "DOROTHY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "You squeeze them gently at the middle, like so.", "name": "CHESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "He twists a long yellow balloon into a giraffe in four seconds.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "She stares.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "That's astonishing.", "name": "DOROTHY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "That's Tuesday.", "name": "FLO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Flo.", "name": "CHESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "What? It's true.", "name": "FLO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "A tall figure in a lime-green suit strides up to the booth.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "He is SIR REGINALD \"REG\" FAIRCHILD-BANGURA (60s, silk cravat, a monocle on a chain).", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "action", "text": "He snaps his fingers.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Chuckles! You owe me a sword.", "name": "REG", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "Reg, I told you, the sword is in the shop.", "name": "CHESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "In the shop? Chester, it's a balloon sword.", "name": "REG", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "It popped.", "name": "CHESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "It popped? The Duelist's Blade, my masterpiece, popped?", "name": "REG", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "It was a good popping.", "name": "FLO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "Young lady, you look like someone with an honest face. Has this man ever returned a borrowed balloon?", "name": "REG", "speaker": 5, "ext": [], "paren": ["to Dorothy"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "I only met him ten minutes ago.", "name": "DOROTHY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "Then he has had ten minutes to wrong you. Wait.", "name": "REG", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "She's new. Be nice.", "name": "CHESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "I am always nice.", "name": "REG", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "That's a lie.", "name": "FLO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "That's a compliment.", "name": "REG", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "Dorothy takes a deep breath.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "Picks up a red balloon.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "Inflates it.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "Twists.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "Twists.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "Holds up a shaky, lopsided dog with three legs.", "para": 4, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "dialogue", "text": "Is this... okay?", "name": "DOROTHY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "Chester and Flo glance at each other.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "Reg pulls out his monocle and inspects it for a long beat.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "Madam. It is perfect. A lame dog is the soul of the craft.", "name": "REG", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "dialogue", "text": "Really?", "name": "DOROTHY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "dialogue", "text": "He's lying.", "name": "CHESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "dialogue", "text": "He's lying.", "name": "FLO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "dialogue", "text": "I have never lied in my life.", "name": "REG", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "dialogue", "text": "He's lying.", "name": "CHESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "action", "text": "Dorothy laughs.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "action", "text": "She sets the dog on the table, where it promptly rolls off.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}]}