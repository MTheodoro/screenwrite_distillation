{"scene_id": "s01900", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01900.fountain", "heading": "EXT. FROZEN LAKE, YUKON - DAWN", "cast": [{"id": 0, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "COLLEEN MACRAE", "names": ["COLLEEN MACRAE", "COLLEEN"], "gender": "?", "first": 5, "spoke": 14}, {"id": 2, "name": "NATHALIE", "names": ["NATHALIE"], "gender": "?", "first": 15, "spoke": 1}, {"id": 3, "name": "NAT", "names": ["NAT"], "gender": "?", "first": 17, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FROZEN LAKE, YUKON - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "White to every horizon.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A snowmobile lies on its side, engine ticking as it cools.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Two small figures on the ice.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "STRANGER (30s, orange parka, face wrapped in a scarf) crawls from the wreckage, dragging a pack.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "A woman, COLLEEN MACRAE (50s, ranger's jacket, a bleeding temple) kneels over the broken sled.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Both are bundled to the eyes.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Hey! Are you hurt?", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Don't come closer.", "name": "COLLEEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I'm just trying to help.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "The ice is cracking. Stay low.", "name": "COLLEEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Okay. Okay. I'm down.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She flattens herself, inching forward on elbows.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Colleen does the same from the other side.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "What's your name?", "name": "COLLEEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Nathalie.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Nathalie what?", "name": "COLLEEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Okafor-Lindqvist. Nat.", "name": "NATHALIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Nat. You were on the sled when it went?", "name": "COLLEEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "I was driving.", "name": "NAT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Then it's your fault we're out here.", "name": "COLLEEN", "speaker": 1, "ext": [], "paren": ["a pause"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Yes, ma'am.", "name": "NAT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Don't ma'am me. I'm Colleen.", "name": "COLLEEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Colleen. I can see a cabin. Maybe four hundred yards.", "name": "NAT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "That's the old trapper's lodge. It's empty. No stove.", "name": "COLLEEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Better than ice.", "name": "NAT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Better than nothing.", "name": "COLLEEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "She reaches toward Colleen.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "A hairline crack races between them with a sound like a rifle shot.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "They freeze, hands inches apart.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Don't move.", "name": "COLLEEN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "I'm not.", "name": "NAT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Slide your pack. Slowly. Toward me.", "name": "COLLEEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Nat pushes it.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "It slides across the ice, stops beside her knee.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "She pulls it in and unzips it.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Inside: a coil of rope, a flare gun, a thermos.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "She pulls the rope out and knots a loop.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "I'll throw this. You tie it around your waist. Then I pull.", "name": "COLLEEN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "And if the ice breaks?", "name": "NAT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Then you'll be glad I tied a good knot.", "name": "COLLEEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Colleen throws.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Nat catches.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "She ties it.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "The crack widens.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Ready.", "name": "NAT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Don't look down. Look at me.", "name": "COLLEEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Colleen pulls.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Nat slides, ice groaning beneath.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Water seeps up in black ribbons.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Three feet.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Two.", "para": 6, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "One.", "para": 6, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Colleen's gloved hand closes around Nat's.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "They crawl together toward the shore.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}]}