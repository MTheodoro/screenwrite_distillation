{"scene_id": "s01901", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01901.fountain", "heading": "INT. LAUNDROMAT PAYPHONE ALCOVE - NIGHT", "cast": [{"id": 0, "name": "RAVI", "names": ["RAVI"], "gender": "m", "first": 4, "spoke": 3}, {"id": 1, "name": "SANDHU-OKORO", "names": ["SANDHU-OKORO"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "KIKO TANAKA-MBEKI", "names": ["KIKO TANAKA-MBEKI", "KIKO"], "gender": "?", "first": 5, "spoke": 1}, {"id": 3, "name": "MOTHER", "names": ["MOTHER"], "gender": "?", "first": 6, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAUNDROMAT PAYPHONE ALCOVE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Buzzing light.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "One payphone.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Quarters stacked on the shelf.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "RAVINDRA \"RAVI\" SANDHU-OKORO (16, duffel on shoulder) grips the receiver.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Beside him, his best friend KIKO TANAKA-MBEKI (16, sweatshirt, a bag of chips) leans on the wall.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Ravi? Where are you? It's past midnight.", "name": "MOTHER", "speaker": 3, "ext": ["V.O."], "paren": ["tinny, over the line"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "I'm fine, Mom. I'm with Kiko.", "name": "RAVI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "^Hi, Mrs. Sandhu!", "name": "KIKO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Is that Kiko? Put him on.", "name": "MOTHER", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "He can't. He's, um. Eating.", "name": "RAVI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Ravindra. Come home.", "name": "MOTHER", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Ravi looks at his duffel.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Looks at Kiko.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Kiko shrugs and offers a chip.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "I'm coming, Mom. I'm just walking slow.", "name": "RAVI", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "He hangs up.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Takes a chip.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "They stand in the buzzing light.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}]}