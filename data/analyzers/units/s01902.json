{"scene_id": "s01902", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01902.fountain", "heading": "EXT. SALT FLATS, ABANDONED RADIO STATION - DAWN", "cast": [{"id": 0, "name": "SERGEANT OKSANA BILYK", "names": ["SERGEANT OKSANA BILYK", "BILYK"], "gender": "f", "first": 4, "spoke": 5}, {"id": 1, "name": "LIEUTENANT AUGUSTIN FOURNIER-DIALLO", "names": ["LIEUTENANT AUGUSTIN FOURNIER-DIALLO", "AUGUSTIN"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "PRIVATE SOLOMON ADEYEMI", "names": ["PRIVATE SOLOMON ADEYEMI", "SOLOMON"], "gender": "m", "first": 6, "spoke": 2}, {"id": 3, "name": "CORPORAL RUTH TALBOT-KWAN", "names": ["CORPORAL RUTH TALBOT-KWAN", "RUTH"], "gender": "?", "first": 7, "spoke": 2}, {"id": 4, "name": "PRIVATE LIAM O'DWYER-SINGH", "names": ["PRIVATE LIAM O'DWYER-SINGH", "LIAM"], "gender": "?", "first": 6, "spoke": 3}, {"id": 5, "name": "ELIAS", "names": ["ELIAS"], "gender": "?", "first": 9, "spoke": 6}, {"id": 6, "name": "MANDELBAUM", "names": ["MANDELBAUM"], "gender": "?", "first": 9, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SALT FLATS, ABANDONED RADIO STATION - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Cracked white earth.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A rusted mast.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wind that tastes of metal.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SERGEANT OKSANA BILYK (30s, goggles) crouches by a concrete shack.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "LIEUTENANT AUGUSTIN FOURNIER-DIALLO (30s, bandaged hand) checks a map.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "PRIVATE SOLOMON ADEYEMI (19, rifle) hugs the wall.", "para": 1, "sent": 2, "present": [0, 1, 2, 4]}, {"u": 7, "kind": "action", "text": "CORPORAL RUTH TALBOT-KWAN (40s, medic's pack) kneels by the wounded.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "PRIVATE LIAM O'DWYER-SINGH (20, radio operator) fiddles with a dial.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "And at the edge of the dust, a lone figure in a tattered coat waves a white rag: ELIAS \"THE PRIEST\" MANDELBAUM (60s, gaunt, cassock).", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "dialogue", "text": "Hold fire. He's got a flag.", "name": "BILYK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "Could be a trick.", "name": "AUGUSTIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "He's not armed.", "name": "SOLOMON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "He's barefoot.", "name": "RUTH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "Sergeant, I'm getting something. Weak.", "name": "LIAM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "Later. Solomon, cover left.", "name": "BILYK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "Covering.", "name": "SOLOMON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "action", "text": "The Priest shuffles closer, hands raised, rag fluttering.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "Please. Don't shoot. I'm only a priest.", "name": "ELIAS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "Prove it.", "name": "AUGUSTIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "I have a Bible in my coat.", "name": "ELIAS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "That proves nothing.", "name": "RUTH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "I have bread in my other coat.", "name": "ELIAS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "Bread?", "name": "LIAM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "Stale. But bread.", "name": "ELIAS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "Elias, was it? Where are the others?", "name": "BILYK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "There are no others. Everyone left in the night.", "name": "ELIAS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "Everyone?", "name": "AUGUSTIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "Both armies.", "name": "ELIAS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "They stare at him.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "Silence.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "Liam taps the radio.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "Sergeant. It's an order. Cease-fire, effective oh-six-hundred.", "name": "LIAM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "What time is it now?", "name": "BILYK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "Oh-six-ten.", "name": "AUGUSTIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "Bilyk lowers her rifle.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "Solomon lets his drop.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "Ruth sits down in the dust, laughing quietly.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "Elias hands the bread to the nearest soldier, who takes it without a word.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "Pack up.", "name": "BILYK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}