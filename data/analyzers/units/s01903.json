{"scene_id": "s01903", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01903.fountain", "heading": "INT. SLEEPER SHIP CRYO-BAY, DECK TWELVE - NIGHT CYCLE", "cast": [{"id": 0, "name": "ARCHIVIST NADIA ABERNATHY-OSEI", "names": ["ARCHIVIST NADIA ABERNATHY-OSEI", "NADIA"], "gender": "?", "first": 4, "spoke": 7}, {"id": 1, "name": "FELIX OYAMA-BRENNAN", "names": ["FELIX OYAMA-BRENNAN", "FELIX"], "gender": "?", "first": 5, "spoke": 5}, {"id": 2, "name": "ONBOARD AI", "names": ["ONBOARD AI"], "gender": "?", "first": 14, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. SLEEPER SHIP CRYO-BAY, DECK TWELVE - NIGHT CYCLE", "present": []}, {"u": 1, "kind": "action", "text": "Rows of frosted pods stretch into blue gloom.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Mist curls along the floor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A soft chime counts the hours.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ARCHIVIST NADIA ABERNATHY-OSEI (30s, close-cropped hair, wool cardigan over a ship's jumpsuit) walks the aisle with a tablet.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her assistant, DR. FELIX OYAMA-BRENNAN (40s, thin, tired eyes), trails behind with a thermos.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Everyone's temperature is nominal.", "name": "NADIA", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Do they hear you?", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "No.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Then why report?", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Habit.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She stops at a pod.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "The frost inside has thinned to a clear oval, and behind it a sleeping face is visible.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Hello, Pod Four-Eleven.", "name": "NADIA", "speaker": 0, "ext": ["CONT'D"], "paren": ["murmuring"], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Pod Four-Eleven is scheduled for revival in four hundred and twelve years.", "name": "ONBOARD AI", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Four hundred and twelve. Time flies.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Felix sips from the thermos.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Nadia wipes a smear of frost from the glass.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Under her thumb, the sleeper's eyelid flickers.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Felix.", "name": "NADIA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Hm?", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Four-Eleven is dreaming.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Everyone dreams.", "name": "FELIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Not in cryo.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Anomaly logged. Please remain calm.", "name": "ONBOARD AI", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Felix drops the thermos.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "In the pod, the eyelid opens.", "para": 4, "sent": 1, "present": [0, 1, 2]}]}