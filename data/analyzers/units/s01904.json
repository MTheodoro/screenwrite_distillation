{"scene_id": "s01904", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01904.fountain", "heading": "INT. DRAGON'S LIBRARY, MOUNTAIN KEEP - DUSK", "cast": [{"id": 0, "name": "QUEEN ISOLDE VANTERPOOL", "names": ["QUEEN ISOLDE VANTERPOOL", "ISOLDE"], "gender": "?", "first": 4, "spoke": 9}, {"id": 1, "name": "THADDEUS WINNOWMERE", "names": ["THADDEUS WINNOWMERE"], "gender": "m", "first": 5, "spoke": 0}, {"id": 2, "name": "PRINCESS ASTRID VANTERPOOL", "names": ["PRINCESS ASTRID VANTERPOOL", "ASTRID"], "gender": "?", "first": 4, "spoke": 9}, {"id": 3, "name": "OLD MARROW", "names": ["OLD MARROW"], "gender": "?", "first": 6, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRAGON'S LIBRARY, MOUNTAIN KEEP - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "Shelves climb into darkness.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A fire the size of a cart burns in a hearth carved like a mouth.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Scrolls curl like sleeping snakes.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "QUEEN ISOLDE VANTERPOOL (50s, gray-braided, scholar's robe) sits at a reading desk.", "para": 1, "sent": 0, "present": [0, 2]}, {"u": 5, "kind": "action", "text": "Beside her, her scribe THADDEUS WINNOWMERE (30s, ink-stained fingers, glasses on a cord) copies lines from a vellum sheet.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "Her daughter, PRINCESS ASTRID VANTERPOOL (20, sword at her hip, boots caked in mud), strides in from the stairs, and behind her limps OLD MARROW (70s, one-eyed, a bundle of dried herbs), the keep's gardener.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Mother. I've come from the northern gate.", "name": "ASTRID", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "So I see.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "She does not look up.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Astrid lays a muddy glove on the desk.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Thaddeus shifts his ink pot an inch to the left.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "They say the dragon has not slept in nine years.", "name": "ASTRID", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Nine years, four months, and three days.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "You've been counting.", "name": "ASTRID", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Somebody must.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Marrow sets the herbs on the hearthstone and stirs them with a finger.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "The fire hisses.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Astrid's jaw works.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "I thought you were going to speak with him today.", "name": "ASTRID", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "I did.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "And?", "name": "ASTRID", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "He asked me to read to him.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Read what?", "name": "ASTRID", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "The ledgers.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Astrid blinks.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Thaddeus coughs behind his hand.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Marrow, at the fire, begins to hum.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Mother, he has burned villages.", "name": "ASTRID", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "He has also asked after your sister every day for nine years.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "I don't have a sister.", "name": "ASTRID", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "No. You don't.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": ["finally looking up"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "The hum stops.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Marrow turns his one good eye on Isolde, then on Astrid, then, slowly, toward the fire.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Thaddeus lays down his pen.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "The flames shrink a shade, as though listening.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "What does that mean?", "name": "ASTRID", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "It means sit down, child. And bring the ledger. It's a long story, and the dragon says you ought to hear it from me.", "name": "ISOLDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}