{"scene_id": "s01905", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01905.fountain", "heading": "INT. LAST ELEVATOR, SHUTTERED DEPARTMENT STORE - NIGHT", "cast": [{"id": 0, "name": "MARCEL", "names": ["MARCEL"], "gender": "?", "first": 5, "spoke": 9}, {"id": 1, "name": "IKEDA", "names": ["IKEDA"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "HONORA FITZGERALD-ADEYEMI", "names": ["HONORA FITZGERALD-ADEYEMI", "HONORA"], "gender": "?", "first": 6, "spoke": 7}, {"id": 3, "name": "JASPER KOWALSKI-RHEE", "names": ["JASPER KOWALSKI-RHEE", "JASPER"], "gender": "m", "first": 7, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAST ELEVATOR, SHUTTERED DEPARTMENT STORE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Brass doors.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A flickering floor indicator.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A velvet-lined car smelling of mothballs.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Three people stand elbow to elbow.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MARCELLUS \"MARCEL\" DUPR\u00c9-IKEDA (50s, trench coat, briefcase) stares at the doors.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "HONORA FITZGERALD-ADEYEMI (30s, security uniform, flashlight) holds the stop button.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "And JASPER KOWALSKI-RHEE (20s, a stolen mannequin arm tucked under his jacket) sweats.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "You said you'd have the floor cleared.", "name": "MARCEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "I said I'd clear the floor. I didn't say anything about the elevator.", "name": "HONORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Can someone please explain why this is moving?", "name": "JASPER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "It's not supposed to.", "name": "HONORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "It's been disconnected since Easter.", "name": "MARCEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Then who called it?", "name": "JASPER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Nobody called it.", "name": "HONORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Somebody pressed the button.", "name": "MARCEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Not me.", "name": "JASPER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Not me.", "name": "HONORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Not me.", "name": "MARCEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "The indicator flickers: 3...", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "2...", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "1...", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "B.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "We don't have a basement.", "name": "JASPER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "We do have a basement.", "name": "HONORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "We have a sub-basement.", "name": "MARCEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "What's in it?", "name": "JASPER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "The vault.", "name": "MARCEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "The old vault. They sealed it in 1986.", "name": "HONORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "What's in the vault?", "name": "JASPER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Nothing. Everyone knows that. There's nothing in the vault.", "name": "MARCEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "The doors slide open.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "A cold exhale of air.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Beyond them, lit by a single bulb, sits a velvet armchair, and in it a mannequin in a doorman's coat, one hand missing.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "That's the one I took.", "name": "JASPER", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "The arm or the mannequin?", "name": "HONORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "The arm. I took the arm.", "name": "JASPER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Put it back.", "name": "MARCEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Back where?", "name": "JASPER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "On him. Go on.", "name": "MARCEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Jasper steps out.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "The doors begin to close behind him.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}]}