{"scene_id": "s01906_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01906.fountain", "heading": "INT. ROADHOUSE - CONTINUOUS", "cast": [{"id": 0, "name": "AMOS WREN", "names": ["AMOS WREN", "AMOS"], "gender": "m", "first": 7, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROADHOUSE - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "A room of overturned chairs and cold ashes.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A bar stripped of bottles.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "On the bar, a lantern, and beside the lantern a folded letter propped against a glass.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A boot on the porch.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "The door creaks.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "A long shadow falls across the floor.", "para": 1, "sent": 2, "present": []}, {"u": 7, "kind": "action", "text": "AMOS WREN (50s, weathered duster, hat the color of old tobacco) stops on the threshold.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "He studies the room.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "The chairs.", "para": 2, "sent": 2, "present": [0]}, {"u": 10, "kind": "action", "text": "The ashes.", "para": 2, "sent": 3, "present": [0]}, {"u": 11, "kind": "action", "text": "The letter.", "para": 2, "sent": 4, "present": [0]}, {"u": 12, "kind": "action", "text": "He takes off his hat.", "para": 3, "sent": 0, "present": [0]}, {"u": 13, "kind": "action", "text": "Smooths his hair with one palm.", "para": 3, "sent": 1, "present": [0]}, {"u": 14, "kind": "action", "text": "Holds the hat against his chest, as though in church.", "para": 3, "sent": 2, "present": [0]}, {"u": 15, "kind": "dialogue", "text": "Well, Amos. You came all this way.", "name": "AMOS", "speaker": 0, "ext": [], "paren": ["under his breath"], "dual": false, "present": [0]}, {"u": 16, "kind": "action", "text": "He crosses to the bar.", "para": 4, "sent": 0, "present": [0]}, {"u": 17, "kind": "action", "text": "His spurs ring once, loud, then he stills them with a hand on his thigh.", "para": 4, "sent": 1, "present": [0]}, {"u": 18, "kind": "action", "text": "He lifts the letter.", "para": 4, "sent": 2, "present": [0]}, {"u": 19, "kind": "action", "text": "Turns it over.", "para": 4, "sent": 3, "present": [0]}, {"u": 20, "kind": "action", "text": "Her hand, small and slanted.", "para": 4, "sent": 4, "present": [0]}, {"u": 21, "kind": "action", "text": "His name.", "para": 4, "sent": 5, "present": [0]}, {"u": 22, "kind": "action", "text": "He reads without moving his lips.", "para": 5, "sent": 0, "present": [0]}, {"u": 23, "kind": "action", "text": "Then, quietly, aloud.", "para": 5, "sent": 1, "present": [0]}, {"u": 24, "kind": "dialogue", "text": "\"Amos. If you've come, then I was wrong about you, and I am glad of it. If you have not, then no one is reading this, and I may say anything.\"", "name": "AMOS", "speaker": 0, "ext": ["V.O."], "paren": ["her words, in his voice"], "dual": false, "present": [0]}, {"u": 25, "kind": "action", "text": "He stops.", "para": 6, "sent": 0, "present": [0]}, {"u": 26, "kind": "action", "text": "Lowers the paper an inch.", "para": 6, "sent": 1, "present": [0]}, {"u": 27, "kind": "action", "text": "Looks at the door.", "para": 6, "sent": 2, "present": [0]}, {"u": 28, "kind": "action", "text": "Looks at the letter again.", "para": 6, "sent": 3, "present": [0]}, {"u": 29, "kind": "dialogue", "text": "\"The house is yours. The land was never ours, only lent. Sell the stove. Burn the rest. Do not come looking for the grave; there isn't one. I asked the wind.\"", "name": "AMOS", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 30, "kind": "action", "text": "His thumb moves over the line.", "para": 7, "sent": 0, "present": [0]}, {"u": 31, "kind": "action", "text": "Once.", "para": 7, "sent": 1, "present": [0]}, {"u": 32, "kind": "action", "text": "Twice.", "para": 7, "sent": 2, "present": [0]}, {"u": 33, "kind": "action", "text": "His jaw works.", "para": 7, "sent": 3, "present": [0]}, {"u": 34, "kind": "action", "text": "He sets the hat on the bar, very precisely, brim down.", "para": 7, "sent": 4, "present": [0]}, {"u": 35, "kind": "dialogue", "text": "Asked the wind.", "name": "AMOS", "speaker": 0, "ext": [], "paren": ["to the empty room"], "dual": false, "present": [0]}, {"u": 36, "kind": "action", "text": "He folds the letter along its old creases.", "para": 8, "sent": 0, "present": [0]}, {"u": 37, "kind": "action", "text": "Slides it inside his coat, over his heart, and pats it flat.", "para": 8, "sent": 1, "present": [0]}, {"u": 38, "kind": "action", "text": "Lifts the lantern.", "para": 8, "sent": 2, "present": [0]}, {"u": 39, "kind": "action", "text": "The flame leans, steadies, burns clean.", "para": 8, "sent": 3, "present": [0]}, {"u": 40, "kind": "dialogue", "text": "All right, Lottie.", "name": "AMOS", "speaker": 0, "ext": ["CONT'D"], "paren": ["hoarse"], "dual": false, "present": [0]}, {"u": 41, "kind": "action", "text": "He turns the lantern low.", "para": 9, "sent": 0, "present": [0]}, {"u": 42, "kind": "action", "text": "Walks to the door.", "para": 9, "sent": 1, "present": [0]}, {"u": 43, "kind": "action", "text": "Stops with one hand on the frame, and for a long while looks out at the road he came by.", "para": 9, "sent": 2, "present": [0]}, {"u": 44, "kind": "action", "text": "The sun is a bruise on the horizon.", "para": 9, "sent": 3, "present": [0]}, {"u": 45, "kind": "action", "text": "Wind lifts his coat.", "para": 9, "sent": 4, "present": [0]}, {"u": 46, "kind": "dialogue", "text": "Never could win an argument with you.", "name": "AMOS", "speaker": 0, "ext": ["CONT'D"], "paren": ["a short laugh"], "dual": false, "present": [0]}, {"u": 47, "kind": "action", "text": "He sets the lantern on the sill, where its light will show from the road.", "para": 10, "sent": 0, "present": [0]}, {"u": 48, "kind": "action", "text": "Steps out.", "para": 10, "sent": 1, "present": [0]}, {"u": 49, "kind": "action", "text": "Pulls the door shut behind him, gently, as if not to wake anyone.", "para": 10, "sent": 2, "present": [0]}]}