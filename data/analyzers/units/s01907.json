{"scene_id": "s01907", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01907.fountain", "heading": "INT. WATER TOWER, ROOFTOP OF THE MERIDIAN TRUST BUILDING - NIGHT", "cast": [{"id": 0, "name": "PRIYA SHARMA-LOWE", "names": ["PRIYA SHARMA-LOWE", "PRIYA"], "gender": "f", "first": 5, "spoke": 20}, {"id": 1, "name": "MARCUS", "names": ["MARCUS"], "gender": "?", "first": 31, "spoke": 17}, {"id": 2, "name": "ODUYA-FERNANDES", "names": ["ODUYA-FERNANDES"], "gender": "?", "first": 35, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. WATER TOWER, ROOFTOP OF THE MERIDIAN TRUST BUILDING - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cylinder of rusted steel.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Pipes sweat in the dark.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single work light clamped to a ladder rung.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Forty stories below, city noise rises and flattens to a hum.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "PRIYA SHARMA-LOWE (30s, climbing harness, black thermal, headset around her neck) kneels at the base of a pipe, a drill case open beside her.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She checks a handheld scanner.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Frowns.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "Checks again.", "para": 1, "sent": 3, "present": [0]}, {"u": 9, "kind": "dialogue", "text": "Okay, Priya. Don't panic. It's just a pipe.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0]}, {"u": 10, "kind": "action", "text": "She hefts the drill.", "para": 2, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "Positions it.", "para": 2, "sent": 1, "present": [0]}, {"u": 12, "kind": "action", "text": "Stops.", "para": 2, "sent": 2, "present": [0]}, {"u": 13, "kind": "dialogue", "text": "Everyone on the channel, radio check. One-two. One-two.", "name": "PRIYA", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the room, in a stage whisper"], "dual": false, "present": [0]}, {"u": 14, "kind": "action", "text": "Static from the headset.", "para": 3, "sent": 0, "present": [0]}, {"u": 15, "kind": "action", "text": "Nobody answers.", "para": 3, "sent": 1, "present": [0]}, {"u": 16, "kind": "action", "text": "She grimaces and tucks it back around her neck.", "para": 3, "sent": 2, "present": [0]}, {"u": 17, "kind": "dialogue", "text": "Fine. Solo. Always solo.", "name": "PRIYA", "speaker": 0, "ext": ["CONT'D"], "paren": ["to herself"], "dual": false, "present": [0]}, {"u": 18, "kind": "action", "text": "The drill whines into the pipe.", "para": 4, "sent": 0, "present": [0]}, {"u": 19, "kind": "action", "text": "A thin jet of water hisses sideways.", "para": 4, "sent": 1, "present": [0]}, {"u": 20, "kind": "action", "text": "She clamps it with a gloved hand, swears under her breath, plugs the hole with a rag, and wipes her face on her shoulder.", "para": 4, "sent": 2, "present": [0]}, {"u": 21, "kind": "action", "text": "The scanner pings.", "para": 4, "sent": 3, "present": [0]}, {"u": 22, "kind": "action", "text": "She smiles.", "para": 4, "sent": 4, "present": [0]}, {"u": 23, "kind": "dialogue", "text": "There you are.", "name": "PRIYA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 24, "kind": "action", "text": "A boot on the ladder.", "para": 5, "sent": 0, "present": [0]}, {"u": 25, "kind": "action", "text": "Metal rings.", "para": 5, "sent": 1, "present": [0]}, {"u": 26, "kind": "action", "text": "Priya freezes.", "para": 5, "sent": 2, "present": [0]}, {"u": 27, "kind": "action", "text": "Slowly, she draws a small flashlight from her belt and clicks it off.", "para": 5, "sent": 3, "present": [0]}, {"u": 28, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0]}, {"u": 29, "kind": "action", "text": "The boot rings again, closer.", "para": 6, "sent": 1, "present": [0]}, {"u": 30, "kind": "action", "text": "A voice, low and amused, floats down.", "para": 6, "sent": 2, "present": [0]}, {"u": 31, "kind": "dialogue", "text": "You always did hate the dark, Pree.", "name": "MARCUS", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "She does not answer.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "The hatch above swings wide.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "A pair of boots, then legs, then a grinning man in a charcoal coat descends the ladder, whistling.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "MARCUS \"SMILEY\" ODUYA-FERNANDES (40s, scar through one eyebrow, wire-rimmed glasses) drops the last rung and lands lightly in the puddle.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "He takes in the drill, the pipe, the rag.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Nice work. Slightly wet.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Marcus.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Priya.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "You're supposed to be in Lisbon.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "I was. Then I wasn't.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Who told you?", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Nobody told me. I read the schematics. Same as you.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Same as me. Great.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Pardon?", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Nothing. Talking to the pipe.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Ah. Does the pipe have opinions?", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "It says you're in my light.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "He steps aside, amused.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Crouches.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Examines the plugged hole.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "You drilled the wrong pipe.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "I didn't.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "The vault line runs behind this one. This is water. Look at the flow.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "It reads copper.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "It reads copper because someone planted copper filings in the water. Rival crew. They know we're coming.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "They know you're coming.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "Pree.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "What?", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "Try the next one.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "He points.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "She follows.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "Another pipe, a hand-span to the left, just as rusty.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "She aims the scanner.", "para": 10, "sent": 3, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "It ticks, ticks, ticks, then one clean tone.", "para": 10, "sent": 4, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "Damn it.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "dialogue", "text": "Ladies and gentlemen, the lady was right all along, and the gentleman is a fool.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": ["to the water tower, in a warm, public voice"], "dual": false, "present": [0, 1, 2]}, {"u": 68, "kind": "dialogue", "text": "Who are you talking to?", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 69, "kind": "dialogue", "text": "Posterity.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "She picks up the drill.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 71, "kind": "action", "text": "Hands it to him.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 72, "kind": "action", "text": "He takes it, surprised.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 73, "kind": "dialogue", "text": "You drill. I'll hold the flashlight.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 74, "kind": "dialogue", "text": "I thought you didn't need me.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 75, "kind": "dialogue", "text": "I don't. But the pipe's behind me and I'm tired of being wet.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 76, "kind": "action", "text": "He grins.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 77, "kind": "action", "text": "Kneels.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 78, "kind": "action", "text": "The drill whines.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 79, "kind": "action", "text": "Metal screams.", "para": 12, "sent": 3, "present": [0, 1, 2]}, {"u": 80, "kind": "action", "text": "A crescent of copper shows through the slot, bright as a coin.", "para": 12, "sent": 4, "present": [0, 1, 2]}, {"u": 81, "kind": "dialogue", "text": "There she is.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 82, "kind": "dialogue", "text": "Open it.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 83, "kind": "action", "text": "He pries.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 84, "kind": "action", "text": "The panel swings back.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 85, "kind": "action", "text": "Behind it: a long gray corridor of cables and a steel door stamped MERIDIAN RESERVE.", "para": 13, "sent": 2, "present": [0, 1, 2]}, {"u": 86, "kind": "action", "text": "They look at it together, shoulder to shoulder, breath misting in the dark.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 87, "kind": "action", "text": "Far below, a siren begins, thin and distant.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 88, "kind": "dialogue", "text": "That's ours?", "name": "PRIYA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 89, "kind": "dialogue", "text": "Not yet. Pass the cutters.", "name": "MARCUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 90, "kind": "action", "text": "She passes them.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 91, "kind": "action", "text": "The siren grows louder.", "para": 15, "sent": 1, "present": [0, 1, 2]}]}