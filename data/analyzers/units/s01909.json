{"scene_id": "s01909", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01909.fountain", "heading": "INT. AIR TRAFFIC CONTROL TOWER, REGIONAL AIRPORT - NIGHT", "cast": [{"id": 0, "name": "BEA", "names": ["BEA"], "gender": "?", "first": 5, "spoke": 13}, {"id": 1, "name": "LINDGREN-ADEBAYO", "names": ["LINDGREN-ADEBAYO"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "GABE", "names": ["GABE"], "gender": "?", "first": 6, "spoke": 3}, {"id": 3, "name": "OKONKWO-DELACROIX", "names": ["OKONKWO-DELACROIX"], "gender": "?", "first": 6, "spoke": 0}, {"id": 4, "name": "HAL", "names": ["HAL"], "gender": "f", "first": 7, "spoke": 6}, {"id": 5, "name": "PEMBERTON-NAKAMURA", "names": ["PEMBERTON-NAKAMURA"], "gender": "?", "first": 7, "spoke": 0}, {"id": 6, "name": "PILOT", "names": ["PILOT"], "gender": "?", "first": 14, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. AIR TRAFFIC CONTROL TOWER, REGIONAL AIRPORT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Radar sweeps in green.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single window overlooks a dark runway edged with blue lights.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Coffee cups, sticky notes.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The storm outside rattles the glass.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CHIEF CONTROLLER BEATRICE \"BEA\" LINDGREN-ADEBAYO (50s, cardigan, reading glasses on a chain) sits at the main console, headset on.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Beside her, TRAINEE GABRIEL \"GABE\" OKONKWO-DELACROIX (20s, nervous, tie loosened) watches the radar.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "In the doorway, SUPERVISOR HAROLD \"HAL\" PEMBERTON-NAKAMURA (60s, coat still wet) shakes rain from his hat.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "dialogue", "text": "Status, Bea.", "name": "HAL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "One inbound. Cessna, tail number November-seven-two-one-Papa. Low fuel, low visibility.", "name": "BEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "And you're talking to him?", "name": "HAL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "I've been talking to him for eleven minutes.", "name": "BEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Chief, he's off the glide path.", "name": "GABE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "I see it, Gabe.", "name": "BEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Tower, November-seven-two-one-Papa. I can't see the runway.", "name": "PILOT", "speaker": 6, "ext": ["V.O."], "paren": ["over the radio, calm but thin"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "Seven-two-one-Papa, Tower. Understand. Turn left heading two-seven-zero. I'll talk you in.", "name": "BEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "Left two-seven-zero. Tower, I'm down to ten minutes of fuel.", "name": "PILOT", "speaker": 6, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "Bea. Is there an alternate?", "name": "HAL", "speaker": 4, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "Forty miles. He won't make it.", "name": "BEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "We could light the road. Flares along the perimeter.", "name": "GABE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "Do it.", "name": "HAL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "Yes, sir.", "name": "GABE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "action", "text": "Gabe grabs a radio, bolts out.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "The door slams.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "Bea watches the screen, unblinking.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "Seven-two-one-Papa, Tower. What's your name?", "name": "BEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "Tower?", "name": "PILOT", "speaker": 6, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "Your name, sir.", "name": "BEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "Daniel. Dan Eriksen.", "name": "PILOT", "speaker": 6, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "Dan, I'm Bea. We're going to get you home.", "name": "BEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "Thank you, Bea.", "name": "PILOT", "speaker": 6, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "Come on. Come on.", "name": "HAL", "speaker": 4, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "Dan, you're two miles out. Descend slowly. Five hundred feet.", "name": "BEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "Five hundred. I see something. Fire. Orange lights on the ground.", "name": "PILOT", "speaker": 6, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "Those are flares. Follow them.", "name": "BEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "Following.", "name": "PILOT", "speaker": 6, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "Hal steps up beside her.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "Puts a hand on her shoulder.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "She doesn't turn.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "One mile, Dan. Gear down.", "name": "BEA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "Gear down and locked.", "name": "PILOT", "speaker": 6, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "dialogue", "text": "You're over the fence. Cut power.", "name": "BEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "A long silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "Static.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "The storm.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "Tower, Seven-two-one-Papa. On the ground.", "name": "PILOT", "speaker": 6, "ext": ["V.O."], "paren": ["half-laughing, half-sobbing"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "action", "text": "Bea exhales.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "Hal's hand tightens on her shoulder, then lets go.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "Down the stairs, Gabe's boots pound back up.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "dialogue", "text": "Good work, Chief.", "name": "HAL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "dialogue", "text": "Don't call me Chief. I'm going home to my cat.", "name": "BEA", "speaker": 0, "ext": [], "paren": ["removing her headset"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}