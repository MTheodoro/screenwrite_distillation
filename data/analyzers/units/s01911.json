{"scene_id": "s01911", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01911.fountain", "heading": "EXT. BRIDGE OF BONES, MISTY GORGE - DAWN", "cast": [{"id": 0, "name": "SIR GARRICK WYNDHAM-ADEYEMI", "names": ["SIR GARRICK WYNDHAM-ADEYEMI", "GARRICK"], "gender": "m", "first": 4, "spoke": 3}, {"id": 1, "name": "HEDDA STORMCALLER-BRAND", "names": ["HEDDA STORMCALLER-BRAND", "HEDDA"], "gender": "?", "first": 5, "spoke": 2}, {"id": 2, "name": "TICK", "names": ["TICK"], "gender": "?", "first": 5, "spoke": 2}, {"id": 3, "name": "FENWICK", "names": ["FENWICK"], "gender": "?", "first": 5, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. BRIDGE OF BONES, MISTY GORGE - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A narrow span of lashed ribs and vertebrae across a chasm.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fog boils below.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Ravens circle.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SIR GARRICK WYNDHAM-ADEYEMI (40s, dented plate armor, a notched longsword) steps onto the bridge.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Behind him, HEDDA STORMCALLER-BRAND (30s, furs, a bow across her back) and the boy TOBIN \"TICK\" FENWICK (14, oversized helmet, a lantern) wait at the edge.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "dialogue", "text": "Stay close.", "name": "GARRICK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "I always do.", "name": "HEDDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "It creaks.", "name": "TICK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "It's meant to.", "name": "GARRICK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "They step out, single file.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Ribs groan.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "A raven lands on a post and croaks.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Hedda draws an arrow.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Tick clutches the lantern.", "para": 2, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "From beneath the bridge, a long, wet rattle.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Everything stops.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "The span lurches.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Ribs snap loose and tumble into the fog.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Garrick seizes Tick by the collar while Hedda throws her bow across the gap, hooks a post, and hauls herself and the boy forward by the string.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Tick screams, drops the lantern, and scoops it back up.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Garrick hacks at a lashing that has caught his boot, and the bridge sags behind them.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "They freeze, panting.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "The bridge rocks once, then settles.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Is it dead?", "name": "TICK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "It was already dead.", "name": "HEDDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "It's gone. Move.", "name": "GARRICK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "They run across, boots thundering on bone, and leap the final gap to solid ground.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "All three collapse, laughing and gasping.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}]}