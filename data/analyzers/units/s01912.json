{"scene_id": "s01912", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01912.fountain", "heading": "INT. PET CEMETERY CHAPEL - DAY", "cast": [{"id": 0, "name": "CLEM", "names": ["CLEM"], "gender": "f", "first": 3, "spoke": 6}, {"id": 1, "name": "OKONKWO-PRATT", "names": ["OKONKWO-PRATT"], "gender": "?", "first": 3, "spoke": 0}, {"id": 2, "name": "WINNIE", "names": ["WINNIE"], "gender": "?", "first": 4, "spoke": 8}, {"id": 3, "name": "BARNABY-LEE", "names": ["BARNABY-LEE"], "gender": "?", "first": 4, "spoke": 0}, {"id": 4, "name": "AGGIE", "names": ["AGGIE"], "gender": "f", "first": 5, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. PET CEMETERY CHAPEL - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Folding chairs, silk flowers, a tiny coffin the size of a shoebox on a velvet-draped table.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Organ music from a small speaker.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "REVEREND CLEMENTINE \"CLEM\" OKONKWO-PRATT (60s, vestments, a voice built for sermons) stands behind the lectern.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "In the front row sits WINSTON \"WINNIE\" BARNABY-LEE (50s, ill-fitting black suit), clutching a handkerchief.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 5, "kind": "action", "text": "Beside him sits his sister AGATHA \"AGGIE\" BARNABY-LEE (50s, enormous hat, a casserole dish in her lap).", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 6, "kind": "dialogue", "text": "We are gathered here today to honor the life of Biscuit.", "name": "CLEM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "dialogue", "text": "Biscuit.", "name": "WINNIE", "speaker": 2, "ext": [], "paren": ["sobbing"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "Biscuit.", "name": "AGGIE", "speaker": 4, "ext": [], "paren": ["sobbing"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Biscuit was a hamster of rare character.", "name": "CLEM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "She was!", "name": "WINNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "^He was!", "name": "AGGIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Clem pauses.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Looks at both.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Winnie blinks at Aggie.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "She was a she.", "name": "WINNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "He was a he. I raised him.", "name": "AGGIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "I bought her at the pet store. She had the little pink nose.", "name": "WINNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Winston, that was Biscuit's cousin.", "name": "AGGIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Mr. and Ms. Barnaby-Lee. Please.", "name": "CLEM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "She raises both hands.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "They subside.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "She clears her throat.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Whether Biscuit was male, female, or the subject of a clerical error, we honor the hamster.", "name": "CLEM", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Amen.", "name": "WINNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Amen.", "name": "AGGIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Biscuit loved sunflower seeds and the wheel. She ran it for hours.", "name": "CLEM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "He ran it for days.", "name": "AGGIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "He never!", "name": "WINNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "You just said \"he.\"", "name": "AGGIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Slip of the tongue.", "name": "WINNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Shall we sing?", "name": "CLEM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Organ swells.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Winnie and Aggie sing, badly, in two different keys.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Clem winces but does not stop them.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "At the end, Aggie lifts her casserole dish and sets it on the coffin.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Tuna noodle. Biscuit's favorite.", "name": "AGGIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Hamsters can't eat tuna.", "name": "WINNIE", "speaker": 2, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Well, he can now.", "name": "AGGIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Clem closes her eyes, and, for the first time, smiles.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}]}