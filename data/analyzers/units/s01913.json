{"scene_id": "s01913", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01913.fountain", "heading": "INT. SUBURBAN KITCHEN - LATE AFTERNOON", "cast": [{"id": 0, "name": "HEIDI KOWALCZYK-MBEKI", "names": ["HEIDI KOWALCZYK-MBEKI", "KOWALCZYK-MBEKI", "HEIDI"], "gender": "f", "first": 3, "spoke": 7}, {"id": 1, "name": "PETE", "names": ["PETE"], "gender": "m", "first": 4, "spoke": 5}, {"id": 2, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 21, "spoke": 1}, {"id": 3, "name": "HAMISH OYELOWO-DRUMMOND", "names": ["HAMISH OYELOWO-DRUMMOND", "HAMISH"], "gender": "?", "first": 25, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. SUBURBAN KITCHEN - LATE AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Linoleum, a wall calendar, a fridge plastered in drawings.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A clock ticks over the stove.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "HEIDI KOWALCZYK-MBEKI (40s, apron over work clothes) stirs a pot.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "Her son PETER \"PETE\" KOWALCZYK-MBEKI (10, grass-stained knees) sits at the table, picking at a scab.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "Dinner in ten.", "name": "HEIDI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Mom, I'm hungry.", "name": "PETE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "You're always hungry.", "name": "HEIDI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Because I'm growing.", "name": "PETE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "^Don't use that on me.", "name": "HEIDI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "A heavy knock at the front door.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Both freeze.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Heidi looks at the clock.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Pete slides off his chair.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "I'll get it.", "name": "PETE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Pete, no.", "name": "HEIDI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He is already gone.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Heidi wipes her hands.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "The knocking comes again, patient.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Pete's voice drifts from the hall.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Hi. Who are you?", "name": "PETE", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Hello, young man. Is your mother home?", "name": "STRANGER", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Heidi's face tightens.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "She puts the wooden spoon on the counter and follows.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "IN THE HALL", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "A tall man in a rumpled gray suit, HAMISH OYELOWO-DRUMMOND (50s, soft hat, a manila folder), stands on the doormat, smiling carefully.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Pete peers up at him, curious.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "My name is Hamish. I'm from the county adoption office.", "name": "HAMISH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "We're not adopting.", "name": "HEIDI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "No, ma'am. But you were adopted, weren't you? In 1988.", "name": "HAMISH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Heidi goes pale.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Pete takes her hand.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Who sent you?", "name": "HEIDI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Your sister.", "name": "HAMISH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Mom, I didn't know you had a sister.", "name": "PETE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Neither did I.", "name": "HEIDI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "She steps aside.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Lets him in.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}]}