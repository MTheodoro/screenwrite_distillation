{"scene_id": "s01914", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01914.fountain", "heading": "INT. SKY-FERRY GALLEY, ABOVE THE CLOUDSEA - DUSK", "cast": [{"id": 0, "name": "CAPTAIN ZEPHYRA QUILL", "names": ["CAPTAIN ZEPHYRA QUILL", "ZEPHYRA"], "gender": "f", "first": 5, "spoke": 10}, {"id": 1, "name": "FIRST MATE BRANNOCH TAL", "names": ["FIRST MATE BRANNOCH TAL", "BRANNOCH"], "gender": "?", "first": 6, "spoke": 7}, {"id": 2, "name": "PIP SILVERTONGUE", "names": ["PIP SILVERTONGUE", "PIP"], "gender": "f", "first": 7, "spoke": 7}, {"id": 3, "name": "GUNNAR EMBERFIST", "names": ["GUNNAR EMBERFIST", "GUNNAR"], "gender": "?", "first": 8, "spoke": 6}, {"id": 4, "name": "DAME OSWYTHA MARROWGATE", "names": ["DAME OSWYTHA MARROWGATE", "OSWYTHA"], "gender": "?", "first": 33, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. SKY-FERRY GALLEY, ABOVE THE CLOUDSEA - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "Copper pots.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Hanging lanterns.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A porthole full of pink cloud.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The deck tilts gently, then rights itself.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CAPTAIN ZEPHYRA QUILL (40s, salt-and-pepper braid, brass goggles on her forehead) sits at a long table, a ledger open before her.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across from her, FIRST MATE BRANNOCH TAL (30s, scarred cheek, rope-burned palms) peels an apple with a dagger.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "At the stove, cook PIP SILVERTONGUE (14, flour on her nose) stirs a pot.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "And at the head of the table, GUNNAR EMBERFIST (60s, dwarf, forge-blackened apron) hammers a loose rivet with a wrench.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Tally's short again.", "name": "ZEPHYRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "By how much?", "name": "BRANNOCH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Forty crowns.", "name": "ZEPHYRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Forty crowns buys a lot of rivets.", "name": "GUNNAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Forty crowns buys a lot of pie.", "name": "PIP", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Pip, you ate the last of the pie.", "name": "BRANNOCH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "I did not. Gunnar did.", "name": "PIP", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "I did not!", "name": "GUNNAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Nobody ate anything. Pie doesn't vanish on its own.", "name": "ZEPHYRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "It does on this ship.", "name": "BRANNOCH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Brannoch, hand me that lantern.", "name": "GUNNAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Hand it yourself, Gunnar.", "name": "BRANNOCH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "I'll get it!", "name": "PIP", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Pip scrambles for the lantern.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Gunnar reaches for it too.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "They collide.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "The lantern drops, rolls, and stops against the captain's boot.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "She stoops, retrieves it, and sets it on the table without comment.", "para": 2, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Pip, bring the soup. Gunnar, mind the rivet. Brannoch, put the dagger away before you lose a finger.", "name": "ZEPHYRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Aye, Captain.", "name": "BRANNOCH", "speaker": 1, "ext": [], "paren": ["sheathing it"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Soup's coming!", "name": "PIP", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Rivet's holding!", "name": "GUNNAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "The galley hatch bangs open.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "A gust of cold air sweeps through.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "In the doorway stands DAME OSWYTHA MARROWGATE (70s, imperial blue coat, a cane topped with a silver owl).", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "She surveys the room.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Silence falls.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Captain Quill. A word.", "name": "OSWYTHA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Dame Oswytha. You're a long way from the Admiralty.", "name": "ZEPHYRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "I came by courier. I had a thing to deliver.", "name": "OSWYTHA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "She taps the cane.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "A small brass tube falls from the owl's beak, rolls across the table, and stops at Zephyra's ledger.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "That's the royal seal.", "name": "BRANNOCH", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "I'll kill the pie thief myself.", "name": "GUNNAR", "speaker": 3, "ext": [], "paren": ["lower"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Mother of clouds.", "name": "PIP", "speaker": 2, "ext": [], "paren": ["lowest"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Zephyra breaks the seal.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Unrolls the scroll.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Reads.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Her face does not change, which is worse.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Pardon.", "name": "ZEPHYRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Full. Retroactive. For the forty crowns, and the fifteen before that, and the rest.", "name": "OSWYTHA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Captain?", "name": "BRANNOCH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "We've been pardoned for smuggling.", "name": "ZEPHYRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "Smuggling?", "name": "GUNNAR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "We smuggled?", "name": "PIP", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "Pip, we've always smuggled.", "name": "ZEPHYRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "I thought it was just cargo.", "name": "PIP", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "It was both.", "name": "OSWYTHA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "She turns toward the door.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Stops.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "Looks over her shoulder.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "The Admiralty requests that you stop. The Crown, however, would like to hire you.", "name": "OSWYTHA", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "For what?", "name": "ZEPHYRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "dialogue", "text": "Smuggling. Of a different sort.", "name": "OSWYTHA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "Zephyra laughs, short and surprised.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "Brannoch whistles.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "Gunnar sets down the wrench.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "Pip carries the soup to the table, slowly, eyes wide, and for the first time in her short life says nothing at all.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "dialogue", "text": "Dame Oswytha, join us for dinner.", "name": "ZEPHYRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "dialogue", "text": "I thought you'd never ask.", "name": "OSWYTHA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "Chairs scrape.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "action", "text": "The ship tilts.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "action", "text": "The lanterns swing.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}]}