{"scene_id": "s01915", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01915.fountain", "heading": "INT. FUNERAL PARLOR, SIDE ROOM - DAY", "cast": [{"id": 0, "name": "VIVIENNE ACHTERBERG-NOLAN", "names": ["VIVIENNE ACHTERBERG-NOLAN", "VIVIENNE"], "gender": "?", "first": 4, "spoke": 10}, {"id": 1, "name": "ALISTAIR ACHTERBERG-NOLAN", "names": ["ALISTAIR ACHTERBERG-NOLAN", "ALISTAIR"], "gender": "?", "first": 4, "spoke": 10}, {"id": 2, "name": "ROZ", "names": ["ROZ"], "gender": "f", "first": 6, "spoke": 8}, {"id": 3, "name": "FENTON-ADEKUNLE", "names": ["FENTON-ADEKUNLE"], "gender": "?", "first": 6, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. FUNERAL PARLOR, SIDE ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Mahogany.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A low table of untouched cookies.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Through the half-open door: murmurs, organ music, the shuffle of black shoes.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "VIVIENNE ACHTERBERG-NOLAN (40s, black dress, hair coiled) pours tea with surgical care.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Her brother ALISTAIR ACHTERBERG-NOLAN (40s, suit a size too small) paces.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Their aunt, ROSALIND \"ROZ\" FENTON-ADEKUNLE (70s, cane, pearl choker), sits straight-backed on the sofa.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Everyone's here. Even the cousins from Perth.", "name": "VIVIENNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "That's a miracle.", "name": "ALISTAIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "It's an inheritance.", "name": "ROZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Aunt Roz.", "name": "VIVIENNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I'm only saying what the room is thinking.", "name": "ROZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "The room is thinking about sandwiches.", "name": "ALISTAIR", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Nobody's thinking about sandwiches.", "name": "VIVIENNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "I am.", "name": "ALISTAIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "He takes a cookie.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Bites.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Chews with his back to them.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Vivienne sets the teapot down.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Her hands are steady, too steady.", "para": 2, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Alistair.", "name": "VIVIENNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Mm.", "name": "ALISTAIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "^Did you read the will?", "name": "VIVIENNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "^Did you read the will?", "name": "ROZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "They both stop.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Look at each other.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Roz sips her tea.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Not yet.", "name": "ALISTAIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Alistair.", "name": "VIVIENNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "I haven't had the heart.", "name": "ALISTAIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Then I'll give you the heart of it, dear. There isn't any money.", "name": "ROZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "The organ rises through the wall.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "What?", "name": "VIVIENNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Your father spent it years ago. On the house, on your schooling, on the lawyers. On me.", "name": "ROZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "On you?", "name": "ALISTAIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "I had a hip.", "name": "ROZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "He told us it was fine.", "name": "VIVIENNE", "speaker": 0, "ext": [], "paren": ["very quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "He told everyone it was fine. It was his only vice.", "name": "ROZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Alistair sets down the cookie.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Looks at his sister.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Something passes between them, old and wordless.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Of course. Of course he did.", "name": "ALISTAIR", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Alistair?", "name": "VIVIENNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "I'm going to go and thank everyone for coming.", "name": "ALISTAIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Alone?", "name": "VIVIENNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "No. Come with me.", "name": "ALISTAIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "She nods.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "He offers his arm.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "She takes it.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Take a sandwich!", "name": "ROZ", "speaker": 2, "ext": [], "paren": ["calling after them"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "The door closes.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Roz, alone, sets down her cup, and lets her shoulders drop for the first time.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}]}