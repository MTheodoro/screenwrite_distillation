{"scene_id": "s01916", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01916.fountain", "heading": "INT. SAFE HOUSE, TOP FLOOR OF A CLOSED HOTEL - NIGHT", "cast": [{"id": 0, "name": "DETECTIVE MIRELA VASQUEZ-ODEH", "names": ["DETECTIVE MIRELA VASQUEZ-ODEH", "VASQUEZ-ODEH"], "gender": "?", "first": 5, "spoke": 10}, {"id": 1, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 6, "spoke": 6}, {"id": 2, "name": "DISPATCH", "names": ["DISPATCH"], "gender": "?", "first": 15, "spoke": 3}, {"id": 3, "name": "ANSELM", "names": ["ANSELM"], "gender": "?", "first": 28, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. SAFE HOUSE, TOP FLOOR OF A CLOSED HOTEL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Plaster dust.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A bare bed frame.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Window shutters nailed shut.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "On the floor, a battered radio set squats between two chairs.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DETECTIVE MIRELA VASQUEZ-ODEH (40s, trench coat, a revolver at her hip) sits in one chair, back to the wall.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Opposite her, a man in a gray suit, STRANGER (50s, ink-stained fingers, a gauze patch on his neck), sits with his hands in his lap.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "You've been very quiet.", "name": "VASQUEZ-ODEH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You haven't asked me anything.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I'm asking now. Who are you?", "name": "VASQUEZ-ODEH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "A man who works for the people who want me dead.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "That's not a name.", "name": "VASQUEZ-ODEH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "It's the only name I carry safely.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "The radio crackles.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "A clipped voice breaks through, distorted.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Unit Four, this is Control. Confirm subject in custody.", "name": "DISPATCH", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Vasquez-Odeh picks up the handset, eyes on him.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Control, subject is in custody. Repeat, subject is secure.", "name": "VASQUEZ-ODEH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Copy. Transport in twenty. Stand by.", "name": "DISPATCH", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "She sets the handset down.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "He watches her do it.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "They aren't coming for me. They're coming for you.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "You'd say that.", "name": "VASQUEZ-ODEH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "I'd say it because it's true. Control isn't Control. You've been talking to an empty room for an hour.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "She draws the revolver.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Aims.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "He doesn't flinch.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "What's your name?", "name": "VASQUEZ-ODEH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Anselm Ravindran.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "She lowers the revolver an inch.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "That's the name on the file. The one who was supposed to be dead.", "name": "VASQUEZ-ODEH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "I was. Then I wasn't. Look at the window.", "name": "ANSELM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "She keeps the gun level, but her eyes slide to the shutters.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "A thin line of light moves behind the slats: a flashlight, sweeping.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Transport already?", "name": "VASQUEZ-ODEH", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "That's not transport.", "name": "ANSELM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "The door handle turns.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "They both rise, each knocking over a chair.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "He lunges for the radio.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "She lunges for the door.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Their shoulders collide.", "para": 8, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "The radio tumbles; the handset swings on its cord.", "para": 8, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "...Unit Four, report. Unit Four...", "name": "DISPATCH", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Anselm kills the power.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Silence.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "The doorknob stops turning.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Then, from the hall, a soft, regretful click, as of a pistol being cocked.", "para": 9, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Window.", "name": "VASQUEZ-ODEH", "speaker": 0, "ext": [], "paren": ["barely audible"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Nailed shut.", "name": "ANSELM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Then the ceiling.", "name": "VASQUEZ-ODEH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "She points to a rotted panel.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "He nods.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "They climb.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}]}