{"scene_id": "s01917", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01917.fountain", "heading": "EXT. SHELLED CHURCHYARD, NORTHERN FRONT - NIGHT", "cast": [{"id": 0, "name": "ZEKE", "names": ["ZEKE"], "gender": "f", "first": 5, "spoke": 16}, {"id": 1, "name": "LANDGRAF-OKAFOR", "names": ["LANDGRAF-OKAFOR"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "WILLA", "names": ["WILLA"], "gender": "?", "first": 6, "spoke": 9}, {"id": 3, "name": "PASCOE-DIALLO", "names": ["PASCOE-DIALLO"], "gender": "?", "first": 6, "spoke": 0}, {"id": 4, "name": "CORPORAL TIBOR NAGY-ABERNATHY", "names": ["CORPORAL TIBOR NAGY-ABERNATHY", "TIBOR"], "gender": "m", "first": 7, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SHELLED CHURCHYARD, NORTHERN FRONT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Broken headstones.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A fallen bell tower.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Snow drifts across the graves like ash.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Distant artillery drums on the horizon.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SERGEANT EZEQUIEL \"ZEKE\" LANDGRAF-OKAFOR (40s, helmet, rifle slung) crouches behind a toppled angel.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Beside him, PRIVATE WILHELMINA \"WILLA\" PASCOE-DIALLO (19, freckles, radio on her back) shivers.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "A few feet away, CORPORAL TIBOR NAGY-ABERNATHY (30s, a medic's armband) tends a wounded boy who lies unmoving in the snow.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "Willa, any word from Battalion?", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Static, Sarge.", "name": "WILLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Try again.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "I've tried six times.", "name": "WILLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Then try seven.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "She tunes the dial, lips pressed white.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Tibor leans over the boy, listening to his chest, then sits back on his heels.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Sarge.", "name": "TIBOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "How is he?", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "He's gone.", "name": "TIBOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "How long?", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "A few minutes. I tried.", "name": "TIBOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Zeke nods once.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Peels off a glove.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Lays a bare hand on the boy's forehead, as though checking for fever.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Withdraws it.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Sarge, who was he?", "name": "WILLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "A kid from Prague. Karel.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Did he have anyone?", "name": "WILLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "A mother. I'll write her.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "You wrote the last one.", "name": "TIBOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Somebody has to.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "A shell lands far off.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "The ground trembles.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Snow shivers from the angel's wings.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Sarge, if we're being honest, I don't think Battalion is coming.", "name": "WILLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "You're not wrong.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Then why are we here?", "name": "WILLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Because they told us to hold the churchyard.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "And the churchyard is holding.", "name": "TIBOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Barely.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Willa laughs, short and wet.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Tibor smiles despite himself.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Zeke looks at the broken bell tower, the stained glass scattered across the snow like spilled paint.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "My grandmother used to say: a bell can't be broken. It can only be silenced.", "name": "ZEKE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "She sounds wise.", "name": "TIBOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "She was a terror.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Sarge. The radio. I've got something.", "name": "WILLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "She presses the earpiece to her head.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "A voice, faint, from the other end of the war.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "All units, cease fire. I repeat, ceasefire in effect at oh-six-hundred.", "name": "WILLA", "speaker": 2, "ext": [], "paren": ["listening, barely breathing"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Willa stares at the dial.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Tibor closes his eyes.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Zeke sits down slowly in the snow.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "Well, then.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "Is it over?", "name": "WILLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "For tonight.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Tibor takes the boy's hand and holds it.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Willa, shaking, unslings the radio and sits beside the Sergeant.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "Zeke puts an arm around her.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Dawn begins to gray the east.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "Sarge. May I?", "name": "TIBOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "Go ahead.", "name": "ZEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "Tibor draws a small prayer book from his pocket and begins to read, in Czech, in a voice too soft to carry beyond the angel.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}]}