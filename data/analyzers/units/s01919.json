{"scene_id": "s01919", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01919.fountain", "heading": "INT. COMMUNITY POOL LOCKER ROOM - EARLY MORNING", "cast": [{"id": 0, "name": "LOLA FERREIRA-OKORO", "names": ["LOLA FERREIRA-OKORO", "LOLA"], "gender": "f", "first": 5, "spoke": 8}, {"id": 1, "name": "TARIQ MONTGOMERY-HASSAN", "names": ["TARIQ MONTGOMERY-HASSAN", "TARIQ"], "gender": "m", "first": 6, "spoke": 10}, {"id": 2, "name": "PRIYA DESAI-LUND", "names": ["PRIYA DESAI-LUND", "PRIYA"], "gender": "f", "first": 7, "spoke": 11}], "units": [{"u": 0, "kind": "heading", "text": "INT. COMMUNITY POOL LOCKER ROOM - EARLY MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Wet tile.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Green-tinted mirrors.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A bank of dented lockers.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A radio plays a pop song through a haze of chlorine.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LOLA FERREIRA-OKORO (17, towel on her shoulder, hair in a wet braid) sits on a bench, tying a shoe.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "TARIQ MONTGOMERY-HASSAN (17, swim team jacket) leans against the lockers, scrolling his phone.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "And their friend PRIYA DESAI-LUND (17, goggles pushed up on her head) stands at a mirror, practicing a speech.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Ahem. Fellow students. I stand before you today...", "name": "PRIYA", "speaker": 2, "ext": [], "paren": ["to the mirror"], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "You look like a politician.", "name": "TARIQ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "That's the idea.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "You're running for class president?", "name": "LOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Treasurer.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Treasurer? Who runs for treasurer?", "name": "TARIQ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Someone who wants the budget.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "She wants the prom budget.", "name": "LOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "^She wants the prom budget.", "name": "TARIQ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I want a prom that doesn't have a cardboard castle.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "I loved the castle.", "name": "LOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "It fell on Mr. Dunphy.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "It was a great fall.", "name": "TARIQ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Priya turns from the mirror.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Crosses her arms.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Will you two vote for me or not?", "name": "PRIYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Obviously.", "name": "LOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Define \"vote.\"", "name": "TARIQ", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Tariq.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Fine. Yes. I'll vote for you.", "name": "TARIQ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Say it like you mean it.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "I'll vote for you, Priya Desai-Lund, future Treasurer of the senior class.", "name": "TARIQ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Thank you, Tariq.", "name": "LOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Does anyone else need me to affirm anything?", "name": "TARIQ", "speaker": 1, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Not at the moment.", "name": "LOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Priya claps once, delighted.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "The radio changes songs.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "A locker door bangs somewhere and all three flinch.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Who's there?", "name": "PRIYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "No answer.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Tariq edges to the end of the row, peers around the corner.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Nobody. Just the wind.", "name": "TARIQ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "There's no wind in a locker room.", "name": "LOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Then it's a ghost.", "name": "TARIQ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "It's the janitor.", "name": "PRIYA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "It's the castle.", "name": "LOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "They laugh, shoving each other toward the exit.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "The radio hums.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "The door swings shut.", "para": 5, "sent": 2, "present": [0, 1, 2]}]}