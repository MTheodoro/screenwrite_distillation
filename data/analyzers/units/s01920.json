{"scene_id": "s01920", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01920.fountain", "heading": "INT. ABANDONED GRAIN ELEVATOR - NIGHT", "cast": [{"id": 0, "name": "HOLLIS BRANDT", "names": ["HOLLIS BRANDT", "HOLLIS"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "WREN CALLOWAY", "names": ["WREN CALLOWAY", "WREN"], "gender": "?", "first": 5, "spoke": 2}, {"id": 2, "name": "JEB MOSS", "names": ["JEB MOSS", "JEB"], "gender": "m", "first": 10, "spoke": 2}, {"id": 3, "name": "INES VALDEZ", "names": ["INES VALDEZ", "INES"], "gender": "f", "first": 13, "spoke": 2}, {"id": 4, "name": "CUTTER RAINE", "names": ["CUTTER RAINE", "CUTTER"], "gender": "?", "first": 21, "spoke": 3}, {"id": 5, "name": "DOC AMBROSE FINCH", "names": ["DOC AMBROSE FINCH"], "gender": "?", "first": 33, "spoke": 0}, {"id": 6, "name": "DOC", "names": ["DOC"], "gender": "?", "first": 34, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED GRAIN ELEVATOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dust hangs in lantern light.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wind moans through the slats.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Sacks of rotted feed are stacked into a crude barricade.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "HOLLIS BRANDT, 50s, county sheriff, grey mustache, crouches behind the sacks with a Winchester.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside him, WREN CALLOWAY, 19, deputy, freckled and shaking, thumbs shells into a revolver.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Count 'em again.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Same as before. Three on the ladder side.", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "A shot punches through the slats.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Splinters rain on Hollis's hat.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "At the far wall, JEB MOSS, 40s, a wiry prisoner in irons, grins from a post he's chained to.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Sheriff, my brother don't miss twice.", "name": "JEB", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Then quit talking and give him a reason to miss.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "INES VALDEZ, 30s, a rancher's widow in a duster, kneels by the trap door, shotgun across her knees.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "She does not look up.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "They're cutting the rope below us.", "name": "INES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "What rope?", "name": "WREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "The one holding the stairs, son.", "name": "INES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "The floor lurches.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Everyone grabs something.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Jeb laughs, rattling his chain.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Send out Jeb and nobody dies!", "name": "CUTTER RAINE", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Hollis levels the Winchester at the trap door.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Cutter, I got six men and a hundred rounds.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "You got four and a lamp.", "name": "CUTTER RAINE", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Ines racks the shotgun.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Wren swallows.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Boots clatter on the ladder.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "The trap door flies up.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "CUTTER RAINE, 30s, black duster, scarred jaw, rises into the light with both hands out.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Hold your fire. I'm coming up to talk.", "name": "CUTTER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Talk from there.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Cutter smiles and keeps climbing.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Behind him, a second figure hauls into view: DOC AMBROSE FINCH, 60s, bald, round spectacles, a medical bag in one hand and a stick of dynamite in the other.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Evening, all. Nobody move.", "name": "DOC", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "Hollis swings the barrel onto Doc.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "Ines swings hers onto Cutter.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "Wren points at everything.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "dialogue", "text": "Well, now.", "name": "JEB", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "Silence.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "Wind.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "The dynamite fuse hisses, lit.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}]}