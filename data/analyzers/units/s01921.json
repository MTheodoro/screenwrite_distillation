{"scene_id": "s01921", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01921.fountain", "heading": "INT. FERRY SNACK BAR - NIGHT", "cast": [{"id": 0, "name": "MAEVE LINDQVIST", "names": ["MAEVE LINDQVIST", "MAEVE"], "gender": "m", "first": 4, "spoke": 7}, {"id": 1, "name": "DESMOND OKAFOR", "names": ["DESMOND OKAFOR", "DESMOND"], "gender": "?", "first": 5, "spoke": 7}, {"id": 2, "name": "GUS TREMBLAY", "names": ["GUS TREMBLAY", "GUS"], "gender": "m", "first": 8, "spoke": 2}, {"id": 3, "name": "PRIYA RAMANATHAN", "names": ["PRIYA RAMANATHAN", "PRIYA"], "gender": "?", "first": 12, "spoke": 4}, {"id": 4, "name": "ODALYS FERREIRA", "names": ["ODALYS FERREIRA", "ODALYS"], "gender": "?", "first": 32, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. FERRY SNACK BAR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A rolling sea outside the salt-streaked windows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fluorescent lights buzz.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Plastic chairs are bolted to the floor.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MAEVE LINDQVIST, 30s, rain jacket, clutches a paper cup.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "DESMOND OKAFOR, 30s, rumpled suit, stands across the counter from her, a ring box in his fist.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "I had a speech.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "You always have a speech.", "name": "MAEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "GUS TREMBLAY, 60s, the snack bar attendant, wipes the counter and pretends to be deaf.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Maeve, the ferry leaves the dock in nine minutes. If you're getting off--", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I'm not getting off.", "name": "MAEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Then why'd you text me?", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "PRIYA RAMANATHAN, 20s, Maeve's sister, bursts through the door, soaked, suitcase in tow.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Because she's an idiot, that's why!", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Priya!", "name": "MAEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "I'll just be over here.", "name": "GUS", "speaker": 2, "ext": [], "paren": ["to nobody"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "You told your sister?", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "She told me everything. The ring, the job in Oslo, the--", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Stop talking.", "name": "MAEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "--the fact you cried in a car wash.", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "It was a very sad car wash!", "name": "MAEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Wait, Oslo?", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "The ferry lurches.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Desmond and Maeve grab the counter at the same time.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Their hands land together.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Both freeze.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Priya gasps.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Gus drops his rag.", "para": 4, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Oh my God. Kiss her, you coward.", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Maeve, are you leaving?", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "I was asked to. I said no. I just didn't tell you.", "name": "MAEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Smart girl.", "name": "GUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "ODALYS FERREIRA, 50s, in a captain's cap and a stained apron, shoulders in with a tray of lemon cake.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "She stops.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Who ordered the proposal?", "name": "ODALYS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Desmond drops to one knee.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "The ring box pops open.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "A huge wave slams the hull, and the lemon cake lands on Priya's suitcase.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Marry me or I throw up, I swear to God.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Yes! Yes, get up!", "name": "MAEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Priya shrieks.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Gus applauds.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Odalys snatches the ring box and examines it.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Cheap setting. Good stone.", "name": "ODALYS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Desmond stands.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Maeve grabs his collar.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "They kiss as the ship horn blasts.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}]}