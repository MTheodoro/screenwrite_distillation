{"scene_id": "s01923", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01923.fountain", "heading": "EXT. SALT FLAT STAGE RELAY STATION - DAY", "cast": [{"id": 0, "name": "AMOS TIBBET", "names": ["AMOS TIBBET", "AMOS"], "gender": "?", "first": 5, "spoke": 14}, {"id": 1, "name": "NELL HARGROVE", "names": ["NELL HARGROVE", "NELL"], "gender": "f", "first": 6, "spoke": 15}, {"id": 2, "name": "SOFT", "names": ["SOFT"], "gender": "m", "first": 25, "spoke": 10}, {"id": 3, "name": "BARRAGAN", "names": ["BARRAGAN"], "gender": "?", "first": 25, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SALT FLAT STAGE RELAY STATION - DAY", "present": []}, {"u": 1, "kind": "action", "text": "White nothing in every direction.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A low adobe station with a sagging porch squats in the glare.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A water trough.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A hitching rail with one tired mule.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "AMOS TIBBET, 60s, stationmaster, bent as a hook, sits on the porch mending a harness.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "NELL HARGROVE, 40s, in a dusty traveling coat, stands at the trough holding a battered carpetbag.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Stage is late.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Stage is always late, I'm told.", "name": "NELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Not this late.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She dips a cup in the trough, sniffs it, and drinks anyway.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "How long since you've seen anyone?", "name": "NELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Eleven days. Unless you count the mule.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "I count the mule.", "name": "NELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Amos chuckles, a dry sound like paper tearing.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "He sets the harness aside.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "You headed west?", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "I'm headed away.", "name": "NELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "A dust plume lifts on the horizon.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Amos squints.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Nell shades her eyes.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "That your stage?", "name": "NELL", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "That's a man on a horse.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "They watch.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "The plume grows.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "A rider takes shape: YUSUF \"SOFT\" BARRAGAN, 30s, narrow face, long coat, leading a second horse with an empty saddle.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "He stops at the rail, dismounts slowly, and tips his hat at Amos.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Then at Nell.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Then he walks to the trough, kneels, and splashes his face.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Morning.", "name": "SOFT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Afternoon.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Almost evening.", "name": "NELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "That so.", "name": "SOFT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "He drinks.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "The three of them are silent.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "The mule flicks an ear.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "You're a long way from anywhere, friend.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "So's everyone out here.", "name": "SOFT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Whose is the empty horse?", "name": "NELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Mine, once.", "name": "SOFT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Nell and Amos exchange a glance.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Soft wipes his face on his sleeve and looks at the sky.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Don't worry. I'm not here for either of you.", "name": "SOFT", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Good.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Good.", "name": "NELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Nobody's ever here for anybody.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Everybody's here for something.", "name": "NELL", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Coffee's on the stove.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "I'll take it.", "name": "SOFT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "I'll take it too.", "name": "NELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Amos rises, knees cracking, and shuffles inside.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Nell sits on the edge of the porch.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Soft sits at the other end.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Neither speaks.", "para": 9, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "The sun beats down.", "para": 9, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Cups are chipped!", "name": "AMOS", "speaker": 0, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Fine by me.", "name": "SOFT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "Fine by me.", "name": "NELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "They both stand and walk toward the door.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "They collide in the narrow frame.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "Both stop.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "Both step back.", "para": 10, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "Both gesture at the other to go first.", "para": 10, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "After you.", "name": "NELL", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "After you.", "name": "SOFT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "Amos reappears with three tin cups and a steaming pot.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "He looks from one to the other and sighs.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "Sit. Both of you. Before I lose my patience.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "They sit.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "Amos pours.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "Nobody drinks.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "dialogue", "text": "Thank you.", "name": "SOFT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "Thank you.", "name": "NELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "Quit that.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "The mule brays.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "In the distance, faint as a thread, the sound of a coach horn.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "dialogue", "text": "That's the stage.", "name": "NELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "dialogue", "text": "Finally.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "dialogue", "text": "Then I'll be going.", "name": "SOFT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "dialogue", "text": "Then I'll be going too.", "name": "NELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "action", "text": "They look at each other.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "action", "text": "Neither moves.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "action", "text": "The horn sounds again, closer.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}]}