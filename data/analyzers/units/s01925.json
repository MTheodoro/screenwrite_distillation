{"scene_id": "s01925", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01925.fountain", "heading": "INT. DRIVE-THROUGH PET CREMATORIUM - DAY", "cast": [{"id": 0, "name": "NORBERT FENWICK", "names": ["NORBERT FENWICK", "NORBERT"], "gender": "m", "first": 3, "spoke": 4}, {"id": 1, "name": "INTERCOM VOICE", "names": ["INTERCOM", "INTERCOM VOICE"], "gender": "?", "first": 4, "spoke": 4}, {"id": 2, "name": "CASSIUS OYELARAN", "names": ["CASSIUS OYELARAN", "CASSIUS"], "gender": "?", "first": 12, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRIVE-THROUGH PET CREMATORIUM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A cheerful pastel lobby with a bell on the counter and a drive-up window.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A framed poster reads \"FOREVER FRIENDS.\"", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "NORBERT FENWICK, 50s, in a lanyard, sits peacefully with a mug of tea and a crossword.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "An INTERCOM crackles on the wall.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "Hello? I'd like to drop off my hamster.", "name": "INTERCOM VOICE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Of course. Pull up to the window and we'll take care of everything.", "name": "NORBERT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "He's very special.", "name": "INTERCOM VOICE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "They always are.", "name": "NORBERT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "He's, um, a big hamster.", "name": "INTERCOM VOICE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Sir, we do all sizes.", "name": "NORBERT", "speaker": 0, "ext": [], "paren": ["into intercom"], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "The door bursts open.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "CASSIUS OYELARAN, 40s, a rancher's hat and a wheelbarrow, rolls in a limp, truck-sized capybara draped in a bedsheet.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "I couldn't wait in the line.", "name": "CASSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Norbert sets down his tea.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "He stares at the wheelbarrow.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "He stares at the intercom.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Then who's on the intercom?", "name": "NORBERT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "The intercom crackles.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "That would be his wife.", "name": "INTERCOM VOICE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}]}