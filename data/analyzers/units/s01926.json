{"scene_id": "s01926", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01926.fountain", "heading": "INT. LAUNDROMAT - 2 A.M.", "cast": [{"id": 0, "name": "RUBY ACHTERBERG", "names": ["RUBY ACHTERBERG", "RUBY"], "gender": "?", "first": 5, "spoke": 4}, {"id": 1, "name": "DOMI", "names": ["DOMI"], "gender": "?", "first": 6, "spoke": 6}, {"id": 2, "name": "PELLEGRINO", "names": ["PELLEGRINO"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "KWABENA ASARE", "names": ["KWABENA ASARE", "KWABENA"], "gender": "m", "first": 9, "spoke": 6}, {"id": 4, "name": "SHOSHANA BLUM", "names": ["SHOSHANA BLUM", "SHOSHANA"], "gender": "?", "first": 10, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAUNDROMAT - 2 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "A buzzing sign: \"OPEN 24 HRS.\"", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of dryers tumble in sleepy rhythm.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The floor is sticky.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A TV above the folding table plays infomercials on mute.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "RUBY ACHTERBERG, 17, in an oversized hoodie, sits on a dryer, legs dangling, eating gummy worms.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across from her, DOMINIC \"DOMI\" PELLEGRINO, 17, stands guard over a laundry bag.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Domi, you've been folding that sock for ten minutes.", "name": "RUBY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "It's a delicate operation.", "name": "DOMI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "KWABENA ASARE, 18, a lanky skateboarder with a broken wrist in a cast, slips through the door, board under his good arm.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "SHOSHANA BLUM, 17, in a prom dress and combat boots, follows two steps behind.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Look who's still alive.", "name": "KWABENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Kwabena. You're supposed to be at the hospital.", "name": "DOMI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Hospital's boring. Shoshana drove.", "name": "KWABENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "I did not drive. I steered. Your skateboard did the rest.", "name": "SHOSHANA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "She means she dragged him on it.", "name": "RUBY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Ruby, you're not helping.", "name": "SHOSHANA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Domi drops the sock.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "He walks up to Shoshana, close.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Why are you wearing a prom dress at two a.m.?", "name": "DOMI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Because someone asked me and then left me at the punch bowl.", "name": "SHOSHANA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Ruby slides off the dryer.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Kwabena looks at his shoes.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Kwabena. Tell me you did not.", "name": "RUBY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "I got a call about the cast, okay? I had to go!", "name": "KWABENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "You told me it was an emergency. It was a cast.", "name": "SHOSHANA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "You left her at prom for a cast?", "name": "DOMI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "It hurt, Domi!", "name": "KWABENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Domi shoves Kwabena.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Kwabena stumbles into a dryer and drops the board.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Ruby grabs Domi's arm.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Shoshana kicks the board away.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Enough! All of you!", "name": "RUBY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Ruby, let him hit me. I want to know what it feels like.", "name": "SHOSHANA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "I'm not hitting you!", "name": "DOMI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Then why are you shouting?", "name": "KWABENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "A dryer buzzes and the door pops open.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "A single red sock rolls out and spins to a stop on the tile.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Ruby picks it up.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "She holds it out to Domi.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "He takes it.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "His hand is shaking.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Sorry, Shosh.", "name": "DOMI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Sorry, Kwabena. I did steer.", "name": "SHOSHANA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "You steered fine.", "name": "KWABENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}