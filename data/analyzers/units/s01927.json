{"scene_id": "s01927", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01927.fountain", "heading": "INT. SLEEP SHACK MATTRESS SHOWROOM - DAY", "cast": [{"id": 0, "name": "LEN HASHIMOTO", "names": ["LEN HASHIMOTO", "LEN"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "MILTON VOSS", "names": ["MILTON VOSS", "MILTON"], "gender": "m", "first": 6, "spoke": 7}, {"id": 2, "name": "PHYLLIS", "names": ["PHYLLIS"], "gender": "?", "first": 18, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. SLEEP SHACK MATTRESS SHOWROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A beige warehouse of identical beds under cheap track lights.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A banner reads \"EVERYTHING MUST GO.\"", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Soft elevator music plays from a ceiling speaker.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LEN HASHIMOTO, 40s, salesman, short-sleeved dress shirt and a tie with a stain.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He's laid out across a king-size mattress, eyes closed, arms folded like a pharaoh.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "MILTON VOSS, 60s, the owner, bald, sweater vest, enters from the back office.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He stops at the foot of the bed.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Len.", "name": "MILTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I'm testing the product.", "name": "LEN", "speaker": 0, "ext": [], "paren": ["eyes closed"], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "It's ten in the morning.", "name": "MILTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "It's a firm that doesn't feel firm. That takes research.", "name": "LEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Milton sighs and sits on the next bed.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He bounces once.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "A spring groans.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "The store phone RINGS.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Milton lifts the cordless handset and holds it away from his ear.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "A tiny, cheerful voice chirps from the speaker.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Is this Sleep Shack? I'd like to return the mattress.", "name": "PHYLLIS", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Of course, Phyllis. Which one?", "name": "MILTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "The one you sold me in 1998.", "name": "PHYLLIS", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Milton covers the phone.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Len opens one eye.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "She's calling again?", "name": "LEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "She says it's lumpy.", "name": "MILTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "It's a bed, Milt. It's supposed to be lumpy. It's an emotional lump.", "name": "LEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Milton uncovers the phone.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Phyllis, we have a lifetime guarantee. Bring it in and we'll look at it.", "name": "MILTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "I'm calling from the mattress.", "name": "PHYLLIS", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Len sits up.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Milton stares at the handset.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Where's she calling from?", "name": "LEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "She says the mattress.", "name": "MILTON", "speaker": 1, "ext": [], "paren": ["muted"], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Tell her we'll send a truck.", "name": "LEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "We'll send a truck.", "name": "MILTON", "speaker": 1, "ext": [], "paren": ["into phone"], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Please hurry. It's very soft in here.", "name": "PHYLLIS", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}]}