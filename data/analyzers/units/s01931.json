{"scene_id": "s01931", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01931.fountain", "heading": "INT. AUCTION HOUSE VIEWING ROOM - NIGHT", "cast": [{"id": 0, "name": "NADIA FAIRWEATHER", "names": ["NADIA FAIRWEATHER", "NADIA"], "gender": "f", "first": 4, "spoke": 11}, {"id": 1, "name": "GRAHAM OSTRANDER", "names": ["GRAHAM OSTRANDER", "GRAHAM"], "gender": "m", "first": 5, "spoke": 5}, {"id": 2, "name": "LUCINDA PASCOE", "names": ["LUCINDA PASCOE", "LUCINDA"], "gender": "?", "first": 6, "spoke": 3}, {"id": 3, "name": "EMEKA ROWE", "names": ["EMEKA ROWE", "EMEKA"], "gender": "m", "first": 7, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. AUCTION HOUSE VIEWING ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Velvet ropes.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Glass cases of antique clocks, each ticking out of step.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single chandelier left on.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "NADIA FAIRWEATHER, 40s, in a grey cashmere coat, circles a case holding a mantel clock.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "GRAHAM OSTRANDER, 50s, the auctioneer, stands at the door with a ring of keys.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "LUCINDA PASCOE, 30s, in a catalog-girl blazer, arranges lot cards that are already straight.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "EMEKA ROWE, 50s, a security guard, stands by the fire exit with his arms folded.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Lot forty-one has a new ticket.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "We reprinted them.", "name": "GRAHAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Reprinted.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Graham jingles his keys.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Lucinda straightens a card that doesn't need it.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Emeka looks at the ceiling.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Does anyone remember what the old ticket said?", "name": "NADIA", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Nobody answers.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "A clock chimes the quarter hour.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Another follows, late.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "It said, um, \"attributed to.\"", "name": "LUCINDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "And the new one?", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "\"Signed.\"", "name": "LUCINDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Nadia opens her handbag.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "She takes out a small brass loupe and bends over the case.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "She studies the dial for a long moment.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "When she straightens, her face gives away nothing.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Twelve years.", "name": "NADIA", "speaker": 0, "ext": [], "paren": ["low, to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Nadia, it's late. We can discuss it in the morning.", "name": "GRAHAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "I'd rather discuss it now, with Emeka present.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Emeka unfolds his arms.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Graham's keys stop jingling.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Ma'am.", "name": "EMEKA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Emeka, what time did the courier leave?", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Six forty.", "name": "EMEKA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "And who signed him out?", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Lucinda lets a lot card fall.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "She doesn't pick it up.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "That's enough.", "name": "GRAHAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Is it?", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "She slips the loupe back into the handbag and snaps it shut.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "The sound carries.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "She walks the length of the room, her heels clicking in time with no clock, and stops at the door beside Graham.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "I'll be bidding on forty-one tomorrow. I suggest the ticket stay as it is.", "name": "NADIA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Of course.", "name": "GRAHAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Good night, everyone.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "She goes out.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "The door closes with a soft click.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "For a long while, no one moves.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "She knows.", "name": "LUCINDA", "speaker": 2, "ext": [], "paren": ["barely audible"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Keep your voice down.", "name": "EMEKA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Twelve years. Twelve years.", "name": "GRAHAM", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3]}]}