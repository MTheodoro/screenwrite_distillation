{"scene_id": "s01932", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01932.fountain", "heading": "INT. CANAL LOCK-KEEPER'S COTTAGE - NIGHT", "cast": [{"id": 0, "name": "AGNES THORNBURY", "names": ["AGNES THORNBURY", "AGNES"], "gender": "?", "first": 4, "spoke": 16}, {"id": 1, "name": "MAN", "names": ["MAN"], "gender": "?", "first": 7, "spoke": 0}, {"id": 2, "name": "THE STRANGER", "names": ["THE STRANGER"], "gender": "m", "first": 3, "spoke": 12}, {"id": 3, "name": "JULIAN", "names": ["JULIAN"], "gender": "?", "first": 55, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. CANAL LOCK-KEEPER'S COTTAGE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "1841.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single room: iron stove, rough table, a rain-black window.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The canal sloshes against the lock gates outside.", "para": 0, "sent": 2, "present": [2]}, {"u": 4, "kind": "action", "text": "AGNES THORNBURY, 40s, widow, plain brown dress, sits at the table peeling a potato.", "para": 1, "sent": 0, "present": [0, 2]}, {"u": 5, "kind": "action", "text": "A hard knock at the door.", "para": 1, "sent": 1, "present": [0, 2]}, {"u": 6, "kind": "action", "text": "She sets down the knife, crosses the room, and opens it a crack.", "para": 1, "sent": 2, "present": [0, 2]}, {"u": 7, "kind": "action", "text": "A MAN, 30s, drenched, hatless, bleeding from one temple, stands in the rain.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "He holds a canvas satchel against his chest like a child.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Forgive me. My boat has sunk below your lock.", "name": "THE STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Then you'll want the bank, not my door.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I'll want a fire, if you've one to spare.", "name": "THE STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "She considers him.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She steps back.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "He enters, dripping, and kneels at the stove.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "She locks the door behind him and slides the bolt.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "He notices.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "He says nothing.", "para": 3, "sent": 5, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Your head.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "A gate struck me. It's nothing.", "name": "THE STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "It is something. Sit.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "He sits.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "She takes a rag from a peg, wets it from the kettle, and presses it against his temple.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "He flinches, then goes still.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "His eyes fix on the satchel in his lap.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Hers do the same.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "You're kind.", "name": "THE STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "I'm careful. There's a difference.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Which are you being now?", "name": "THE STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Both.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "He laughs, once, and winces.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "She steps back, folds the rag, and crosses to the shelf.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "From behind a tin of tea she takes a long hunting knife and lays it on the table between them, blade toward him.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "My husband kept that for poachers.", "name": "AGNES", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Then I am glad not to be one.", "name": "THE STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "What's in the satchel?", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Letters.", "name": "THE STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Whose?", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "My brother's. He drowned in this canal in March. I came to see where.", "name": "THE STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "The Haverty boy?", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "You knew him.", "name": "THE STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "I pulled him out. I buried him myself.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "The Stranger rises so fast the chair falls over.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Agnes takes up the knife in one smooth motion.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "They face each other across the table, breathing hard.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Where?", "name": "THE STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Behind the lock, under the willow.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Take me there.", "name": "THE STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "In this weather?", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Now.", "name": "THE STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "She lowers the knife.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Her shoulders drop.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "She takes a lantern from the wall and lights it with a taper from the stove.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "The Stranger picks up the fallen chair, sets it right, and stands waiting, hat in hand though he has no hat.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "What do I call you?", "name": "AGNES", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "Julian Haverty.", "name": "JULIAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Julian. I am Agnes.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "I know. He wrote of you.", "name": "JULIAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "He wrote of me?", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "Every letter. He loved you.", "name": "JULIAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "Agnes sets down the lantern.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "Her hand covers her mouth.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "For the first time she looks at the satchel not with suspicion but with grief.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "He never said.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "He meant to.", "name": "JULIAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "She nods.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "She picks the lantern up again.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "They go out together into the rain.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "The door swings in the wind.", "para": 9, "sent": 3, "present": [0, 1, 2, 3]}]}