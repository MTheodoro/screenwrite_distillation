{"scene_id": "s01933_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01933.fountain", "heading": "INT. ICE-FISHING HUT - CONTINUOUS", "cast": [{"id": 0, "name": "NANA PHILOMENA DUBOIS", "names": ["NANA PHILOMENA DUBOIS", "NANA PHILOMENA"], "gender": "f", "first": 4, "spoke": 3}, {"id": 1, "name": "ARJUN CHAUDHRY", "names": ["ARJUN CHAUDHRY", "ARJUN"], "gender": "m", "first": 5, "spoke": 4}, {"id": 2, "name": "TEDDY LINDGREN", "names": ["TEDDY LINDGREN", "TEDDY"], "gender": "m", "first": 6, "spoke": 3}, {"id": 3, "name": "UNCLE SIONE TAUFA", "names": ["UNCLE SIONE TAUFA", "UNCLE SIONE"], "gender": "m", "first": 7, "spoke": 3}, {"id": 4, "name": "MEI-LING DUBOIS-CHAUDHRY", "names": ["MEI-LING DUBOIS-CHAUDHRY", "MEI-LING"], "gender": "?", "first": 8, "spoke": 3}, {"id": 5, "name": "BEATRIZ", "names": ["BEATRIZ"], "gender": "f", "first": 9, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. ICE-FISHING HUT - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Six people crowd a space meant for two.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A stove glows orange in one corner.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Four holes bored in the plank floor reveal black water below.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "NANA PHILOMENA DUBOIS, 70s, sits in a lawn chair in a quilted parka, a fishing line wrapped around her gloved finger like a ring.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside her, ARJUN CHAUDHRY, 40s, her son-in-law, tends the stove with the grim pride of a man who has built his first fire.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "TEDDY LINDGREN, 9, kneels on an overturned bucket, nose to the water.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "UNCLE SIONE TAUFA, 50s, enormous in a down jacket, wedges himself on a cooler, fiddling with a transistor radio.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "MEI-LING DUBOIS-CHAUDHRY, 35, hands out thermoses.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "And BEATRIZ, 5, lies on her stomach on the plank floor, one mitten dipping toward a hole.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Beatriz, away from the water.", "name": "MEI-LING", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "It's looking at me.", "name": "BEATRIZ", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "That is a fish, child. They look at everyone.", "name": "NANA PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Nana, don't scare her. It could be a very friendly fish.", "name": "UNCLE SIONE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "It's not a fish. It's a muskrat.", "name": "TEDDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "It can't be a muskrat. They don't live under ice.", "name": "ARJUN", "speaker": 1, "ext": [], "paren": ["from the stove"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "This one does.", "name": "TEDDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "A tug on Nana's line.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "She sits bolt upright.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Everyone stills.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "The line twitches again.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Hush, all of you. Hush.", "name": "NANA PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Philomena, I think you've got something.", "name": "ARJUN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Mama, pull!", "name": "MEI-LING", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Pull, Nana, pull!", "name": "UNCLE SIONE", "speaker": 3, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Nana hauls on the line with both hands.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "A silver fish the length of her forearm bursts through the hole, flops across the plank, and lands in Beatriz's lap.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Beatriz shrieks.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Teddy dives for it.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Mei-Ling grabs Beatriz.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Arjun knocks over the bucket.", "para": 3, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Uncle Sione catches the radio before it hits the stove.", "para": 3, "sent": 6, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "It's alive!", "name": "BEATRIZ", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "It's a pike!", "name": "TEDDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "It is dinner.", "name": "NANA PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "The fish flaps.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Teddy pins it with both hands, grinning.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Arjun kneels beside him, awkward, and takes the pliers from his belt.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Hold still. Hold still, little guy.", "name": "ARJUN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Do you know how to do this?", "name": "MEI-LING", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "I watched a video.", "name": "ARJUN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Give me the pliers, brother.", "name": "UNCLE SIONE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Arjun surrenders the pliers.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Uncle Sione works the hook free in one practiced twist, then lifts the fish high in the cramped air for everyone to see.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "They cheer.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "The little hut rings with it.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}]}