{"scene_id": "s01934", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01934.fountain", "heading": "INT. BELL TOWER - CHURCH - DAY", "cast": [{"id": 0, "name": "SERGEANT ILARIO COSTA", "names": ["SERGEANT ILARIO COSTA", "COSTA"], "gender": "m", "first": 5, "spoke": 4}, {"id": 1, "name": "WOUNDED SOLDIER", "names": ["WOUNDED SOLDIER"], "gender": "?", "first": 11, "spoke": 2}, {"id": 2, "name": "TADEUSZ", "names": ["TADEUSZ"], "gender": "?", "first": 22, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. BELL TOWER - CHURCH - DAY", "present": []}, {"u": 1, "kind": "action", "text": "1944.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dust and pigeon droppings.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cracked bronze bell hangs dead overhead.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Through an arched opening, a ruined village smokes.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SERGEANT ILARIO COSTA, 30s, unshaven, rifle across his lap, sits against the wall eating a tin of sardines.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Peaceful.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Birds sing outside.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "A scrape on the stairs.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Costa doesn't look up.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "He eases the safety off.", "para": 2, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "A WOUNDED SOLDIER, 19, ragged, one arm in a bloodstained sling, climbs into view.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He freezes, hands raised.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Don't shoot. Please. I'm lost.", "name": "WOUNDED SOLDIER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Which side?", "name": "COSTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Yours. I think.", "name": "WOUNDED SOLDIER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "You think.", "name": "COSTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He lowers the rifle an inch.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "The soldier sags against the stair rail, relieved.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Costa offers him the sardine tin.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "The soldier takes it, eats with trembling fingers.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Name?", "name": "COSTA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Tadeusz Wolak. Polish Second Corps.", "name": "TADEUSZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Where's your unit, Tadeusz?", "name": "COSTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Below. Looking for you.", "name": "TADEUSZ", "speaker": 2, "ext": [], "paren": ["still chewing"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Costa's face goes flat.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Far down the stairwell, boots.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Many.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "I'm sorry, Sergeant. They said they'd spare my brother.", "name": "TADEUSZ", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}]}