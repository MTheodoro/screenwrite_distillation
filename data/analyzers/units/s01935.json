{"scene_id": "s01935", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01935.fountain", "heading": "EXT. TOLL BRIDGE OVER A MISTY GORGE - DAWN", "cast": [{"id": 0, "name": "WYNDRA", "names": ["WYNDRA"], "gender": "?", "first": 4, "spoke": 1}, {"id": 1, "name": "SIR OSRIC", "names": ["SIR OSRIC", "OSRIC"], "gender": "?", "first": 5, "spoke": 1}, {"id": 2, "name": "THISBE", "names": ["THISBE"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "GRIMBOLD", "names": ["GRIMBOLD"], "gender": "?", "first": 7, "spoke": 2}, {"id": 4, "name": "MARROW", "names": ["MARROW"], "gender": "m", "first": 8, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. TOLL BRIDGE OVER A MISTY GORGE - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Ropes and rotted planks span a chasm.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Mist swallows the far end.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A lantern hangs from a crooked post.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "WYNDRA, a sorceress in grey robes, stands at the center of the bridge.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside her, SIR OSRIC, an old knight in dented armor, leans on his sword.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "THISBE, a young thief with a quick grin, crouches at the rail, picking the lock of a small chest.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "GRIMBOLD, a squat troll in a toll collector's cap, blocks the path ahead.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "MARROW, a wolf the size of a pony, circles behind him.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Three coins each.", "name": "GRIMBOLD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "She reaches into her robe.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "He draws his sword a hand's breadth.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "She smiles and produces a single silver coin, which she tosses in a high arc over the gorge.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "The troll watches it fall.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Marrow lunges.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Thisbe vaults the rail and kicks the wolf in the ribs.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "He yelps.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "The troll swings his club and the old knight blocks it with his shield.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "The planks groan.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Enough! We have no quarrel!", "name": "OSRIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Put down your weapons.", "name": "WYNDRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "She lifts one hand.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "The mist thickens.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "The club slows in midair.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Marrow whimpers and sits.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "The troll lowers his cap over his eyes.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Two coins, then.", "name": "GRIMBOLD", "speaker": 3, "ext": [], "paren": ["grumbling"], "dual": false, "present": [0, 1, 2, 3, 4]}]}