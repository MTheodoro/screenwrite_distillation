{"scene_id": "s01936", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01936.fountain", "heading": "INT. GRAIN SILO - NIGHT", "cast": [{"id": 0, "name": "IMOGEN TSAI", "names": ["IMOGEN TSAI", "IMOGEN"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "KATYA BRANDVOLD", "names": ["KATYA BRANDVOLD", "KATYA"], "gender": "f", "first": 5, "spoke": 5}, {"id": 2, "name": "RUFUS DELACOURT", "names": ["RUFUS DELACOURT", "RUFUS"], "gender": "?", "first": 6, "spoke": 3}, {"id": 3, "name": "SILAS OKOYE", "names": ["SILAS OKOYE", "SILAS"], "gender": "m", "first": 7, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRAIN SILO - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dark.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A circular concrete shaft.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single flashlight beam jitters over rusted ladders.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "IMOGEN TSAI, 20s, clutches the flashlight.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "KATYA BRANDVOLD, 20s, presses against her back.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "RUFUS DELACOURT, 30s, kneels at a hatch.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "SILAS OKOYE, 40s, leans on his knees and wheezes.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Did you hear that?", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Don't say that.", "name": "KATYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "It's the wind.", "name": "RUFUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "There is no wind in a silo.", "name": "SILAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Then what is it?", "name": "KATYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Quiet.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Something drags above them.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "A slow scrape on concrete.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "It's on the ladder.", "name": "RUFUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "It's on our ladder.", "name": "SILAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Imogen, give me the light.", "name": "KATYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "No.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Give me the light, or I swear to God...", "name": "KATYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Katya, stop. If you move, it knows where we are.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "It already knows.", "name": "SILAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Then why hasn't it come down?", "name": "RUFUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Because it's waiting for one of us to scream.", "name": "KATYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "I'm not going to scream.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "The flashlight flickers out.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Somewhere above, a long, patient breath.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}]}