{"scene_id": "s01938", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01938.fountain", "heading": "EXT. LIFE RAFT - OPEN OCEAN - DAY", "cast": [{"id": 0, "name": "ORLA FITZGIBBON", "names": ["ORLA FITZGIBBON", "ORLA"], "gender": "f", "first": 4, "spoke": 6}, {"id": 1, "name": "JASPER TOLENTINO", "names": ["JASPER TOLENTINO", "JASPER"], "gender": "m", "first": 5, "spoke": 5}, {"id": 2, "name": "PETRA HALVORSEN", "names": ["PETRA HALVORSEN", "PETRA"], "gender": "?", "first": 6, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. LIFE RAFT - OPEN OCEAN - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A bright, flat sea.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A canopy of orange rubber snaps in the breeze.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Three people sit around a pile of ration tins.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ORLA FITZGIBBON, 30s, sunburned, trims her fingernails with a pocketknife.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "JASPER TOLENTINO, 20s, lies back with a hat over his face.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "PETRA HALVORSEN, 40s, tends a small fishing line looped over the side.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Jasper, you awake?", "name": "ORLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "No.", "name": "JASPER", "speaker": 1, "ext": [], "paren": ["under the hat"], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Petra says we've got water for nine days.", "name": "ORLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Ten, if Jasper stops sweating.", "name": "PETRA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I'm not sweating. The sun's sweating.", "name": "JASPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "The sea is calm.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "The three of them breathe in the heat.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Petra checks the line.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Orla looks at the horizon and sighs, content.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "You know, this isn't so bad.", "name": "ORLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I was just thinking the same.", "name": "PETRA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Me too, honestly.", "name": "JASPER", "speaker": 1, "ext": [], "paren": ["sitting up"], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "It's almost nice.", "name": "ORLA", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "It's almost nice.", "name": "PETRA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Petra pulls the line.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Something heavy answers.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "She grins and heaves.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Orla grabs her waist.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Jasper scrambles to help.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "A fin breaks the surface.", "para": 3, "sent": 5, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "A big one.", "para": 3, "sent": 6, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Then another.", "para": 3, "sent": 7, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Petra, let go.", "name": "JASPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "It's a fish!", "name": "PETRA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Petra, it's not a fish!", "name": "ORLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The raft tilts.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "A dark shape rolls under them, rubbing against the hull.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Orla's grin dies.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Jasper, get the oar.", "name": "PETRA", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Petra, I'm getting it. Orla, hold the line.", "name": "JASPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "I'm holding. I'm holding!", "name": "ORLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "The shape surfaces beside the raft.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "A shark's flat, indifferent eye regards them.", "para": 5, "sent": 1, "present": [0, 1, 2]}]}