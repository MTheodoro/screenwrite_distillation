{"scene_id": "s01939", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01939.fountain", "heading": "INT. ROLLER RINK - AFTER HOURS", "cast": [{"id": 0, "name": "CLEO MARCHAND", "names": ["CLEO MARCHAND", "CLEO"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "BRAM NAKAMURA-COLE", "names": ["BRAM NAKAMURA-COLE", "BRAM"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "DOT WINTERBOURNE", "names": ["DOT WINTERBOURNE", "DOT"], "gender": "?", "first": 6, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROLLER RINK - AFTER HOURS", "present": []}, {"u": 1, "kind": "action", "text": "Dim.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A mirror ball turns slowly, throwing pale spots across an empty floor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A jukebox hums at low volume.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CLEO MARCHAND, 20s, in a staff polo and skates, mops the rink under a single working light.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "BRAM NAKAMURA-COLE, 30s, the night manager, counts the register at the snack counter.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "DOT WINTERBOURNE, 60s, the cleaner, sweeps popcorn from the carpet by the lockers.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "You hear that?", "name": "CLEO", "speaker": 0, "ext": [], "paren": ["to Bram"], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Hear what?", "name": "BRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Skates. Out on the floor.", "name": "CLEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "That's the mop.", "name": "BRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "The mop doesn't have wheels.", "name": "CLEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Bram looks up.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Dot stops sweeping.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "The mirror ball keeps turning.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Anybody else still in here, we're closed.", "name": "DOT", "speaker": 2, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "No answer.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "The jukebox clicks.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "A song begins that nobody chose, a slow waltz.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Dot, did you play that?", "name": "BRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Not me.", "name": "DOT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Okay. Okay, okay.", "name": "CLEO", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "She backs toward the counter, mop held in front of her like a spear.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Out on the floor, in the circling light, a single set of wheels rolls by with no one on it.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Around the rink.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Once.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Twice.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Nobody panic.", "name": "BRAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "I'm not panicking.", "name": "CLEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Dot drops the broom.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "The skates stop in the middle of the floor.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "They turn, slowly, to face the three of them.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Go. Go!", "name": "DOT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "The three scatter.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Cleo vaults the counter.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Bram drops the cash drawer, coins ringing across the tile.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Dot sprints for the lockers, slams the door, and holds it shut.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "The skates roll toward the counter.", "para": 6, "sent": 4, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "The waltz swells.", "para": 6, "sent": 5, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Please be a prank. Please be a prank.", "name": "CLEO", "speaker": 0, "ext": [], "paren": ["whispering to herself"], "dual": false, "present": [0, 1, 2]}]}