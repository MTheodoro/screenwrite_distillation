{"scene_id": "s01940", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01940.fountain", "heading": "INT. DUCKPIN BOWLING ALLEY - NIGHT", "cast": [{"id": 0, "name": "COACH RAY SALAZAR", "names": ["COACH RAY SALAZAR", "RAY"], "gender": "m", "first": 5, "spoke": 9}, {"id": 1, "name": "IMANI PETTIGREW", "names": ["IMANI PETTIGREW", "IMANI"], "gender": "f", "first": 6, "spoke": 5}, {"id": 2, "name": "DMITRI AKSENOV", "names": ["DMITRI AKSENOV", "DMITRI"], "gender": "?", "first": 7, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. DUCKPIN BOWLING ALLEY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A dim neighborhood lane.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A faded banner reads \"STATE FINALS.\"", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Scoreboards flicker.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A cigarette machine hums beside the shoe counter.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "COACH RAY SALAZAR, 60s, tracksuit, a whistle around his neck, paces behind lane six.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "IMANI PETTIGREW, 17, ponytail, chalk on her hands, holds a small black ball.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "DMITRI AKSENOV, 18, her anchor, sits on the ball return chewing his thumbnail.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Pettigrew. Last frame.", "name": "RAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "I know, Coach.", "name": "IMANI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "She knows.", "name": "DMITRI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I'm talking to her.", "name": "RAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "She's right here, Coach. You can talk to both of us.", "name": "DMITRI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Imani, you need a spare.", "name": "RAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Ray, I need to breathe first.", "name": "IMANI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Breathe fast.", "name": "RAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Don't rush her.", "name": "DMITRI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Dmitri, sit down.", "name": "RAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "I am sitting down.", "name": "DMITRI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Imani steps to the line.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "The pin deck waits.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "She raises the ball to her chin, closes her eyes, and exhales.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Eyes open!", "name": "RAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Coach!", "name": "IMANI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Ray, let her--", "name": "DMITRI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "The ball leaves her hand.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "It rolls straight, slow, and hits the head pin.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Seven pins fall.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Three stand in a crooked row.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "The pinsetter whirs.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Ray's whistle drops from his mouth.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Seven. You left three.", "name": "DMITRI", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "She left three.", "name": "RAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "I have one more ball.", "name": "IMANI", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "You do. And you have me.", "name": "RAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "She turns.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Ray places both hands on her shoulders.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Dmitri slides off the ball return and joins them.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Imani, same shot. Corner pin first.", "name": "DMITRI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Don't think. Roll.", "name": "RAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Both of you stop talking.", "name": "IMANI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "They stop.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "She picks up the ball, steps to the line, and releases.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "The ball curves, kisses the left pin, which tips the middle pin, which topples the right.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Ten down.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "The alley erupts.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Ray throws his whistle in the air.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Dmitri lifts Imani off the floor.", "para": 7, "sent": 2, "present": [0, 1, 2]}]}