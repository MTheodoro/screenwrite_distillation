{"scene_id": "s01941", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01941.fountain", "heading": "INT. SALEM MEETINGHOUSE - EVENING", "cast": [{"id": 0, "name": "GOODWIFE TABITHA CROMPTON", "names": ["GOODWIFE TABITHA CROMPTON", "TABITHA"], "gender": "f", "first": 5, "spoke": 3}, {"id": 1, "name": "EZEKIEL PRUITT", "names": ["EZEKIEL PRUITT", "EZEKIEL"], "gender": "m", "first": 8, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. SALEM MEETINGHOUSE - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "1692.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Bare pine benches.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A pulpit.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A candle gutters beside a Bible.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "GOODWIFE TABITHA CROMPTON, 50s, plain gray dress and white cap, kneels at the front pew with her eyes closed.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A door creaks.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She does not turn.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "EZEKIEL PRUITT, 30s, a young magistrate in a black coat, steps inside and hangs his hat on a peg.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Goodwife Crompton.", "name": "EZEKIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Magistrate Pruitt.", "name": "TABITHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "They said you'd be here.", "name": "EZEKIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Where else would I be?", "name": "TABITHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "At home. With the door barred.", "name": "EZEKIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She opens her eyes.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She looks at him, tired.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "It's over, then.", "name": "TABITHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "The governor has pardoned the rest. Your name was the last he signed.", "name": "EZEKIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She bows her head.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He crosses the floor and sits at the end of the bench, a respectful distance away.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "The candle gutters and steadies.", "para": 4, "sent": 2, "present": [0, 1]}]}