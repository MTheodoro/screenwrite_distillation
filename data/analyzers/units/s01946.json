{"scene_id": "s01946", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01946.fountain", "heading": "EXT. SWAMP FERRY - NIGHT", "cast": [{"id": 0, "name": "MORVAN", "names": ["MORVAN"], "gender": "m", "first": 5, "spoke": 4}, {"id": 1, "name": "HESPER", "names": ["HESPER"], "gender": "f", "first": 6, "spoke": 2}, {"id": 2, "name": "BRIAR", "names": ["BRIAR"], "gender": "f", "first": 7, "spoke": 2}, {"id": 3, "name": "SABLE", "names": ["SABLE"], "gender": "?", "first": 8, "spoke": 1}, {"id": 4, "name": "THE DROWNED KING", "names": ["THE DROWNED KING"], "gender": "?", "first": 18, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SWAMP FERRY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Black water.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dead trees.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A flat barge poled through reeds.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "One lantern.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MORVAN, 70s, ferryman, bent, poles in silence.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "HESPER, 20s, a cloaked wanderer, sits cross-legged at the prow.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "BRIAR, 12, wild-haired, trails a hand in the water.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "SABLE, 30s, a hooded archer, keeps watch at the stern.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "It's cold.", "name": "BRIAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Pull your hand in.", "name": "MORVAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "It's not that cold.", "name": "BRIAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Pull it in.", "name": "MORVAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Briar sulks.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Sable says nothing.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Hesper does not look up.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "A bubble rises beside the barge.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Then another.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Ferryman. You've brought me guests.", "name": "THE DROWNED KING", "speaker": 4, "ext": ["O.S."], "paren": ["from beneath the water, hollow"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Morvan stops poling.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "His knuckles whiten.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "No guests, Majesty. Just cargo.", "name": "MORVAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Cargo has hands. I count eight.", "name": "THE DROWNED KING", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Briar yanks her arm out.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Water streams from it, black and thick.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Sable draws an arrow.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Hesper lifts her gaze.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Poles, Morvan. Faster.", "name": "HESPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Don't.", "name": "SABLE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "You may go. The child stays.", "name": "THE DROWNED KING", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Briar clings to Hesper's cloak.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Sable nocks the arrow.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Morvan breathes through his teeth.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "I never agreed to this.", "name": "MORVAN", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Neither did she.", "name": "HESPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "The barge shudders.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "A pale hand grips the gunwale beside Briar.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Then another.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Sable looses the arrow.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "It sinks without a splash.", "para": 7, "sent": 4, "present": [0, 1, 2, 3, 4]}]}