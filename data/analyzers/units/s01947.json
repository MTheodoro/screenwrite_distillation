{"scene_id": "s01947", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01947.fountain", "heading": "INT. FUNICULAR STATION VAULT - NIGHT", "cast": [{"id": 0, "name": "CAMILLE DUVALL", "names": ["CAMILLE DUVALL", "CAMILLE"], "gender": "f", "first": 4, "spoke": 7}, {"id": 1, "name": "RASHID AL-TAMIMI", "names": ["RASHID AL-TAMIMI", "RASHID"], "gender": "m", "first": 6, "spoke": 6}, {"id": 2, "name": "SVEN EKLUND", "names": ["SVEN EKLUND", "SVEN"], "gender": "m", "first": 7, "spoke": 3}, {"id": 3, "name": "ODESSA RUIZ", "names": ["ODESSA RUIZ", "ODESSA"], "gender": "f", "first": 8, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. FUNICULAR STATION VAULT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A brass-and-marble ticket hall at the foot of an alpine rail line.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Behind a hidden panel, the old bank vault gapes open, its steel door scarred by a thermal lance.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dust motes drift in lantern light.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CAMILLE DUVALL, 40s, tailored black coat, pale and still, sits on an overturned crate with a coil of rope across her knees.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She waits.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "A step ahead of her stands RASHID AL-TAMIMI, 50s, shaven head, a surgeon's calm; he is gently lifting a velvet-wrapped ingot from a cart.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "SVEN EKLUND, 30s, red-bearded and nervous, kneels beside him, counting bars into a leather duffel.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "ODESSA RUIZ, 30s, a lookout with a stopwatch, leans in the archway, tapping her boot.", "para": 1, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Time?", "name": "CAMILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Four minutes to the first car.", "name": "ODESSA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "She nods.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "She does not move from the crate.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Seventeen bars.", "name": "RASHID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Eighteen.", "name": "SVEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Count again.", "name": "RASHID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "He does, lips moving.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "He shakes his head and adds one more bar to the bag.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "The duffel sags.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "He grunts and drags it toward the archway, where she meets him and takes the other strap.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Camille, there were thirty.", "name": "SVEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "There were thirty. Now there are eighteen, because someone got here first.", "name": "CAMILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Who?", "name": "RASHID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Someone with a key.", "name": "CAMILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Odessa's stopwatch ticks.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Sven looks at the floor.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Rashid straightens and turns toward the vault, slowly, as if the empty shelves might speak.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Three minutes.", "name": "ODESSA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "We take what we have and go.", "name": "CAMILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "We also look at who knew the plan.", "name": "RASHID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "He stares at Sven.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Sven goes red.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "The duffel slides from his hand.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "I didn't.", "name": "SVEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Nobody's accusing you.", "name": "CAMILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "I am.", "name": "RASHID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "She stands.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "She folds the rope.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "She sets it in the cart with the same care she gave the rest.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Rashid, it's a trade. We keep eighteen bars, and the thief keeps twelve. We never speak of it again.", "name": "CAMILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "And if the thief speaks?", "name": "RASHID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Then we'll know exactly who it was.", "name": "CAMILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Odessa clicks the stopwatch.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Two minutes.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Time's up.", "name": "ODESSA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}