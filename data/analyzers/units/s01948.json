"present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She steps forward.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "She places her hand over the ledger.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Constance flinches.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "He stands.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Josephine does not.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Constance, did you put your name to this?", "name": "CYRUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I did, sir.", "name": "CONSTANCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "She did, and so did two hundred others.", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "He sags into his chair.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "He pours a glass.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "He drinks.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Tell your people we'll talk in the morning.", "name": "CYRUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "She nods.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "She steps back.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "She takes the girl's arm.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Together they go out into the dark corridor.", "para": 5, "sent": 3, "present": [0, 1, 2]}]}