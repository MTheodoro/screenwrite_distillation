{"scene_id": "s01949", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01949.fountain", "heading": "INT. OPERATING THEATER 4 - NIGHT", "cast": [{"id": 0, "name": "KALANI MAHOE", "names": ["KALANI MAHOE", "MAHOE"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "BEATRIX LUND", "names": ["BEATRIX LUND", "BEATRIX"], "gender": "?", "first": 5, "spoke": 2}, {"id": 2, "name": "TOMASZ WRONA", "names": ["TOMASZ WRONA", "TOMASZ"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "YARA HADDAD", "names": ["YARA HADDAD", "YARA"], "gender": "?", "first": 7, "spoke": 1}, {"id": 4, "name": "ANAESTHETIST", "names": ["ANAESTHETIST"], "gender": "?", "first": 8, "spoke": 1}, {"id": 5, "name": "ROSA", "names": ["ROSA"], "gender": "?", "first": 17, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. OPERATING THEATER 4 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cold white light.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The steady beep of a monitor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A patient lies draped on the table, only a rectangle of skin exposed.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. KALANI MAHOE, 50s, surgeon, bends over the field.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "BEATRIX LUND, 30s, scrub nurse, passes instruments.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "TOMASZ WRONA, 20s, the resident, holds a retractor.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "YARA HADDAD, 40s, circulating nurse, stands by the door.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "At the head of the table, the ANAESTHETIST, 40s, watches the monitors.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Retractor.", "name": "MAHOE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Got it.", "name": "TOMASZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Everyone with me. We are closing in ten minutes.", "name": "MAHOE", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Blood pressure's holding.", "name": "ANAESTHETIST", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Suture.", "name": "BEATRIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Almost there.", "name": "MAHOE", "speaker": 0, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "The anaesthetist glances at the screen, then at the surgeon.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "She taps a dial.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Kalani, her sats just dropped.", "name": "ROSA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "How far?", "name": "MAHOE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Ninety-one.", "name": "ROSA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Is that bad?", "name": "TOMASZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Don't ask.", "name": "YARA", "speaker": 3, "ext": [], "paren": ["from the door"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Rosa, ventilate. Beatrix, hold the sutures.", "name": "MAHOE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Holding.", "name": "BEATRIX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Tomasz, you can breathe now.", "name": "MAHOE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Tomasz lets out a long breath.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "The monitor settles.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}