{"scene_id": "s01950", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01950.fountain", "heading": "INT. FLOODED HOTEL LOBBY - NIGHT", "cast": [{"id": 0, "name": "LIEUTENANT ANNEKE DEVRIES", "names": ["LIEUTENANT ANNEKE DEVRIES", "ANNEKE"], "gender": "?", "first": 5, "spoke": 13}, {"id": 1, "name": "SERGEANT KOFI MENSAH-BOATENG", "names": ["SERGEANT KOFI MENSAH-BOATENG", "KOFI"], "gender": "?", "first": 6, "spoke": 11}], "units": [{"u": 0, "kind": "heading", "text": "INT. FLOODED HOTEL LOBBY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A grand ruin.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Chandeliers hang in black water to the knees.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A reception desk rises like an island.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Gunfire rumbles far off.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LIEUTENANT ANNEKE DEVRIES, 30s, helmet cracked, sits on the desk with a bandaged thigh.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "SERGEANT KOFI MENSAH-BOATENG, 40s, wades in from the stairs, rifle held high.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Upstairs is clear.", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Then sit.", "name": "ANNEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He climbs onto the desk beside her.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She hands him a canteen.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He drinks, wipes his mouth, hands it back.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "How many left in the company?", "name": "ANNEKE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Eleven.", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Yesterday we were forty.", "name": "ANNEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Yesterday was yesterday.", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Tell me they got out.", "name": "ANNEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Some got out.", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Kofi.", "name": "ANNEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "I won't lie to you, Lieutenant.", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "You never do. It's very irritating.", "name": "ANNEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "A beam crashes somewhere above.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Water ripples across the lobby.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "They both flinch, then settle.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "When this is over, what will you do?", "name": "ANNEKE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Go home. Sit in my mother's kitchen. Eat until I cannot stand.", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "That's all?", "name": "ANNEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "That's a great deal.", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "My mother's kitchen burned in the first week.", "name": "ANNEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Then you'll come to mine.", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "She laughs, a short, cracked sound.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "He smiles.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Another distant shell.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "They both fall silent.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Kofi. If I don't make it out--", "name": "ANNEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "You will.", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "If I don't.", "name": "ANNEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Then I tell your sister you were a terrible card player.", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Tell her I was the worst. She'll believe that.", "name": "ANNEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "She will.", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Good.", "name": "ANNEKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "She leans her head on his shoulder.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "He does not move.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "They sit in the dark water and listen to the war go quiet.", "para": 5, "sent": 2, "present": [0, 1]}]}