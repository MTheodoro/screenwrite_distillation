{"scene_id": "s01952", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01952.fountain", "heading": "EXT. RIVERBOAT SAWMILL - DAY", "cast": [{"id": 0, "name": "MARSHAL EVANDER COLE", "names": ["MARSHAL EVANDER COLE", "EVANDER"], "gender": "m", "first": 5, "spoke": 10}, {"id": 1, "name": "TILDA HASKELL", "names": ["TILDA HASKELL", "TILDA"], "gender": "?", "first": 6, "spoke": 2}, {"id": 2, "name": "RAWLINS DUNMORE", "names": ["RAWLINS DUNMORE", "RAWLINS"], "gender": "m", "first": 7, "spoke": 8}, {"id": 3, "name": "JOAQUIN SPARROW", "names": ["JOAQUIN SPARROW", "JOAQUIN"], "gender": "?", "first": 8, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. RIVERBOAT SAWMILL - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A barge-mounted sawmill moored on a brown river.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A huge blade whines through a log.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Sawdust drifts like snow.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Men shout from the lower deck.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MARSHAL EVANDER COLE, 40s, dusty badge, stands at the rail with his thumbs in his belt.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "TILDA HASKELL, 30s, in a leather apron, feeds logs to the blade.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "RAWLINS DUNMORE, 40s, mill foreman, glowers from the catwalk.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Below the saw, JOAQUIN SPARROW, 20s, a wiry deckhand, hauls a rope.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Mr. Dunmore. I'd like a word.", "name": "EVANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "I'm busy.", "name": "RAWLINS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "So's the river.", "name": "EVANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Rawlins comes down the steps, wiping his hands.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Tilda cuts the saw.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "The silence is sudden.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "What's this about, Marshal?", "name": "RAWLINS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "A dead man, found downstream. Pinned under a log from this barge.", "name": "EVANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Accidents happen.", "name": "RAWLINS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "This one had a bullet in him.", "name": "EVANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Tilda sets down her lever.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Joaquin lets go of the rope.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Rawlins keeps his hands where Evander can see them.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "I know nothing about it.", "name": "RAWLINS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Then you won't mind if I look at the log.", "name": "EVANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Be my guest.", "name": "RAWLINS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "He walks to the stack.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Evander follows.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Joaquin darts for the gangplank, but Tilda catches him by the collar and drags him back.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "He twists loose and sprints across the deck.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Evander draws his revolver.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Joaquin!", "name": "EVANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "It wasn't me!", "name": "JOAQUIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "I never said it was.", "name": "EVANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Joaquin stops at the rail.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "His shoulders heave.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Rawlins backs away, boots scraping on the planks.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Joaquin, tell him.", "name": "TILDA", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "He made me, Tilda.", "name": "JOAQUIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Shut your mouth, boy.", "name": "RAWLINS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "He shot Mr. Pell over the lumber contract and made me drag the body to the saw. I didn't want to. I swear I didn't.", "name": "JOAQUIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "That's a lie.", "name": "RAWLINS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Is it?", "name": "EVANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Marshal, I've run this mill twenty years.", "name": "RAWLINS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Then twenty years is plenty.", "name": "EVANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Rawlins lunges for the gun on his hip.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Evander fires first.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Rawlins spins and falls across a pile of sawdust, clutching his shoulder.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Tilda steps over him, kicks the gun away, and stands there breathing.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "He's alive.", "name": "TILDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Good. He can hang proper.", "name": "EVANDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}