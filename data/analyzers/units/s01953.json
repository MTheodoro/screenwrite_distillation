{"scene_id": "s01953", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01953.fountain", "heading": "INT. FENCING HALL - EVENING", "cast": [{"id": 0, "name": "SORAYA DELGADO", "names": ["SORAYA DELGADO", "SORAYA"], "gender": "f", "first": 4, "spoke": 7}, {"id": 1, "name": "BOHDAN MARCHENKO", "names": ["BOHDAN MARCHENKO", "BOHDAN"], "gender": "?", "first": 5, "spoke": 7}, {"id": 2, "name": "HARRIET QUIGLEY", "names": ["HARRIET QUIGLEY", "HARRIET"], "gender": "f", "first": 6, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. FENCING HALL - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "A high-ceilinged gymnasium.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Strip lights glare on white lam\u00e9.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Sabres ring against each other on two raised pistes.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SORAYA DELGADO, 20s, hood up, sits alone on a bench taping her blade guard.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across the room, BOHDAN MARCHENKO, 50s, her coach, argues quietly with a judge.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "HARRIET QUIGLEY, 30s, a rival in a silver jacket, stretches her hamstring on the opposite piste.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Soraya finishes taping.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "She pulls her mask over her head.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "She rises.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "She crosses the floor with an easy stride.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Soraya. A word.", "name": "BOHDAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "After the bout.", "name": "SORAYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Before.", "name": "BOHDAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "She stops.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "He crosses to her.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "He lowers his voice.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Harriet is your sister's friend.", "name": "BOHDAN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "I know.", "name": "SORAYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "She has been asking for you.", "name": "BOHDAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I know that too.", "name": "SORAYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Ready when you are!", "name": "HARRIET", "speaker": 2, "ext": [], "paren": ["calling"], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Soraya raises a hand to show she's heard.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "She takes two steps toward the piste and then stops again.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "She looks at Bohdan.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "What is it?", "name": "SORAYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Your sister called.", "name": "BOHDAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "She goes still.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "He looks at his shoes.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Say it.", "name": "SORAYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "She's in hospital. It's not serious. They think.", "name": "BOHDAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Why didn't you tell me earlier?", "name": "SORAYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Because you've waited four years for this bout.", "name": "BOHDAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "She tears off her mask.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "She throws it at the bench.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "It bounces and slides to Harriet's feet.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Harriet picks it up, turns it over, and carries it back to her.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Go. I'll tell them you withdrew.", "name": "HARRIET", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "I didn't withdraw.", "name": "SORAYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "You did now.", "name": "HARRIET", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Soraya takes the mask.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "She holds it a moment, then nods once.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "She walks out of the hall without looking back.", "para": 7, "sent": 2, "present": [0, 1, 2]}]}