{"scene_id": "s01955_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01955.fountain", "heading": "INT. GONDOLA - CONTINUOUS", "cast": [{"id": 0, "name": "MIREILLE CASTANEDA", "names": ["MIREILLE CASTANEDA", "MIREILLE"], "gender": "f", "first": 4, "spoke": 1}, {"id": 1, "name": "OZZIE BERGSTROM", "names": ["OZZIE BERGSTROM", "OZZIE"], "gender": "m", "first": 5, "spoke": 1}, {"id": 2, "name": "NKECHI OBI", "names": ["NKECHI OBI", "NKECHI"], "gender": "f", "first": 6, "spoke": 4}, {"id": 3, "name": "DARIUSZ PAWLAK", "names": ["DARIUSZ PAWLAK", "DARIUSZ"], "gender": "?", "first": 6, "spoke": 2}, {"id": 4, "name": "XIMENA TORRES", "names": ["XIMENA TORRES", "XIMENA"], "gender": "f", "first": 7, "spoke": 1}, {"id": 5, "name": "NEIL", "names": ["NEIL"], "gender": "m", "first": 8, "spoke": 2}, {"id": 6, "name": "ATWOOD", "names": ["ATWOOD"], "gender": "?", "first": 8, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. GONDOLA - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Six people share a steel cabin built for eight.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Windows fog with breath.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A flask passes hand to hand.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MIREILLE CASTANEDA, 60s, in a white wool coat, sits in the corner with her eyes closed, rubbing a rosary between her thumb and finger.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "OZZIE BERGSTROM, 30s, a lanky snowboarder, leans against the door, thumbing a dead phone.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "NKECHI OBI, 40s, a nurse, tends to DARIUSZ PAWLAK, 70s, whose hand trembles around a thermos.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "XIMENA TORRES, 20s, squeezes onto the bench beside them, scrolling through a map with no signal.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "And CORNELIUS \"NEIL\" ATWOOD, 50s, stands at the window and watches the dark.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 9, "kind": "action", "text": "He turns from the window.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "action", "text": "She glances at him.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "action", "text": "They both look away.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "action", "text": "Ozzie slides to the floor.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "action", "text": "Ximena shifts to make room for his legs, and Nkechi tucks a blanket around Dariusz's knees.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "action", "text": "Mireille sighs.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "How long has it been?", "name": "NEIL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "Forty minutes.", "name": "NKECHI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "It feels like four hours.", "name": "NEIL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "It always does.", "name": "OZZIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "Has anyone tried the emergency cord?", "name": "XIMENA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "It's been pulled twice.", "name": "DARIUSZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "Both times, a recorded voice said help was coming.", "name": "NKECHI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Help is always coming.", "name": "MIREILLE", "speaker": 0, "ext": [], "paren": ["eyes closed"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "The cabin sways.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "action", "text": "Everyone shifts their weight at once, and Ozzie curses.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "action", "text": "They steady.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "Nkechi glances at Dariusz, who has gone pale.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "Drink some water.", "name": "NKECHI", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "I am fine.", "name": "DARIUSZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "I know. Drink.", "name": "NKECHI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "He does.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "action", "text": "She smiles and pats his hand.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "Neil returns to the window.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "Ximena folds up her phone.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "Ozzie tilts his head back against the door.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "The cabin lurches once and then, with a long, heavy groan, begins to move.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}]}