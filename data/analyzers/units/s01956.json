{"scene_id": "s01956", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01956.fountain", "heading": "EXT. SCHOOL ROOFTOP - PIGEON COOP - DAWN", "cast": [{"id": 0, "name": "MARISOL QUINONES", "names": ["MARISOL QUINONES", "MARISOL"], "gender": "?", "first": 4, "spoke": 2}, {"id": 1, "name": "ELI ABRAMOWITZ", "names": ["ELI ABRAMOWITZ", "ELI"], "gender": "m", "first": 5, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SCHOOL ROOFTOP - PIGEON COOP - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Tar paper and chimney pots.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A lean-to coop of chicken wire and scrap plywood, thick with the soft burble of birds.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Behind it, the city blushes pink under a rising sun.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MARISOL QUINONES, 16, in a school sweater with the sleeves pushed up, kneels beside the coop and shakes seed into a tin tray.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "ELI ABRAMOWITZ, 16, thin, round glasses, tries to climb through the roof hatch with a cardboard box held above his head.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "A single pigeon sits in the box, unimpressed.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Marisol. I brought the injured one.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You brought Gerald?", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "His name is Clementine.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "The hatch slams on his foot.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He hops.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "The box tips and the pigeon bursts out in a flurry of feathers.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Marisol lunges and catches it against her chest while Eli topples back down the hatch, and a distant thump rises from the stairwell.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Eli?", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I'm fine.", "name": "ELI", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She cradles the bird.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "It coos.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She smooths its wing with a thumb, and a tiny smile creeps over her face.", "para": 3, "sent": 2, "present": [0, 1]}]}