{"scene_id": "s01957", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01957.fountain", "heading": "INT. CHEESE CAVE - NIGHT", "cast": [{"id": 0, "name": "LUCA FERRANTE", "names": ["LUCA FERRANTE", "LUCA"], "gender": "f", "first": 5, "spoke": 3}, {"id": 1, "name": "TAMAR ELKAYAM", "names": ["TAMAR ELKAYAM", "TAMAR"], "gender": "?", "first": 6, "spoke": 3}, {"id": 2, "name": "BRODIE MACLEAN", "names": ["BRODIE MACLEAN", "BRODIE"], "gender": "?", "first": 7, "spoke": 3}, {"id": 3, "name": "RHIANNON DAVIES", "names": ["RHIANNON DAVIES", "RHIANNON"], "gender": "f", "first": 21, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. CHEESE CAVE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cold.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wet stone.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Racks of aging wheels in rows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single utility bulb.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LUCA FERRANTE, 40s, crowbar in hand.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "TAMAR ELKAYAM, 30s, holds a flashlight.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "BRODIE MACLEAN, 20s, hauls a sack.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Which wheel?", "name": "LUCA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Third rack. The black wax.", "name": "TAMAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "It all looks black.", "name": "BRODIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "The one that smells like feet.", "name": "TAMAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Brodie sniffs.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Gags.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Points.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "That one.", "name": "BRODIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Luca wedges the crowbar under the wheel.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "It pops free.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Inside, a hollow core and a small steel case.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Got it.", "name": "LUCA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "A flashlight swings in from the entrance.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "RHIANNON DAVIES, 30s, in a hairnet and rubber boots, a nightwatch's baton in her fist, steps from the dark.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Evening.", "name": "RHIANNON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "They freeze.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Tamar lowers the light.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Brodie drops the sack.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "That wheel's forty thousand euros.", "name": "RHIANNON", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "We'll pay for it.", "name": "TAMAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Not with cash.", "name": "RHIANNON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "She steps forward.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "She holds out her free hand.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Luca hands her the steel case.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "You knew.", "name": "LUCA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "I run this cave, mate.", "name": "RHIANNON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "She slides the case under her arm.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Tamar, Luca, and Brodie exchange looks.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Nobody moves.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Water drips somewhere.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "So are we fired?", "name": "BRODIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "You were never hired.", "name": "RHIANNON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}