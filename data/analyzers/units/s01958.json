{"scene_id": "s01958", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01958.fountain", "heading": "INT. PLANETARIUM DOME - NIGHT", "cast": [{"id": 0, "name": "OTTAVIA LINDO", "names": ["OTTAVIA LINDO", "OTTAVIA"], "gender": "?", "first": 4, "spoke": 9}, {"id": 1, "name": "RAFF", "names": ["RAFF"], "gender": "?", "first": 5, "spoke": 10}, {"id": 2, "name": "OBUYA", "names": ["OBUYA"], "gender": "?", "first": 5, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. PLANETARIUM DOME - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A hushed hemisphere.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A painted sky of stars wheels overhead.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single projector hums at the center on a pedestal.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "OTTAVIA LINDO, 30s, in a velvet jacket, stands at the control console.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "RAFFERTY \"RAFF\" OBUYA, 30s, sits in the front row of reclining seats with a paper bag of takeout.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Raff, you're not supposed to be in here.", "name": "OTTAVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "I brought dumplings.", "name": "RAFF", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "That's not an excuse.", "name": "OTTAVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "It's a bribe.", "name": "RAFF", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "She sighs and turns the dome to a deep midnight blue.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He lies back in the chair.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "The stars brighten.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Show me the Southern Cross.", "name": "RAFF", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "You can't see it from here.", "name": "OTTAVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Show me anyway.", "name": "RAFF", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "She taps a key.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "A cluster of stars swells in the south.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "He lifts the bag and shakes it.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Five minutes. Then you leave.", "name": "OTTAVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Come sit.", "name": "RAFF", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Raff--", "name": "OTTAVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Ottavia.", "name": "RAFF", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "She stops.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "She crosses the aisle and lowers herself into the seat beside him.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "They lie back together under the painted sky.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "I'm sorry about Sunday.", "name": "OTTAVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "I'm sorry about Sunday.", "name": "RAFF", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "They both laugh.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "The Southern Cross turns slowly overhead.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Ottavia, I got the job in Perth.", "name": "RAFF", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "She stiffens.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "She turns her head toward him.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Of course you did.", "name": "OTTAVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "I haven't said yes.", "name": "RAFF", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Then say no.", "name": "OTTAVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Ask me to.", "name": "RAFF", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "The projector hums.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "She stares at the false stars for a long time.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Then she takes his hand.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Don't go, Raff.", "name": "OTTAVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}