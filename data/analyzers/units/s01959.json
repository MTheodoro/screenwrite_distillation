{"scene_id": "s01959", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01959.fountain", "heading": "INT. AMBULANCE - MOVING - NIGHT", "cast": [{"id": 0, "name": "DELIA NAKAGAWA", "names": ["DELIA NAKAGAWA", "DELIA"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "ODETTE FARADAY", "names": ["ODETTE FARADAY", "ODETTE"], "gender": "f", "first": 5, "spoke": 4}, {"id": 2, "name": "MARCUS", "names": ["MARCUS"], "gender": "?", "first": 11, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. AMBULANCE - MOVING - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Blue light flickers across steel cabinets.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A monitor beeps in a steady rhythm.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The vehicle sways around a corner.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DELIA NAKAGAWA, 30s, a paramedic in a navy jumpsuit, kneels beside the stretcher with a blood pressure cuff.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "ODETTE FARADAY, 70s, lies on it under a gray blanket, a mask over her nose.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "She grips a small cloth purse against her ribs.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Delia checks the monitor.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She frowns.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "She loosens the cuff.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She pats her patient's arm.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Medic Nine, status on your patient?", "name": "MARCUS", "speaker": 2, "ext": ["V.O."], "paren": ["over radio, crackling"], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Seventy-year-old female, chest pain, BP one-ten over seventy, sats at ninety-four.", "name": "DELIA", "speaker": 0, "ext": [], "paren": ["into radio"], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Copy. ETA?", "name": "MARCUS", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Eight minutes.", "name": "DELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Hospital's standing by.", "name": "MARCUS", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "She clips the radio back on her shoulder.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "She squeezes the older woman's hand.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Odette's eyes drift open.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Did I faint?", "name": "ODETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Not quite, Mrs. Faraday. You gave us a scare.", "name": "DELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "She tends to.", "name": "ODETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Who does?", "name": "DELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "My daughter. Always rushing.", "name": "ODETTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Delia glances at the purse.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "She raises an eyebrow, waiting.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Odette tightens her grip on it.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "She turns her face toward the wall, and after a moment she lets her shoulders relax.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "I'm all right, dear.", "name": "ODETTE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "I know you are.", "name": "DELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "She tucks the blanket higher.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The ambulance slows.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "She checks the monitor again and finally lets herself breathe.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Medic Nine, you're clear to enter bay two.", "name": "MARCUS", "speaker": 2, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Copy that.", "name": "DELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}