{"scene_id": "s01961", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01961.fountain", "heading": "INT. COASTAL RADIO BOOTH - NIGHT", "cast": [{"id": 0, "name": "SAOIRSE TALLCHIEF", "names": ["SAOIRSE TALLCHIEF", "SAOIRSE"], "gender": "f", "first": 5, "spoke": 12}, {"id": 1, "name": "DEV", "names": ["DEV"], "gender": "?", "first": 16, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. COASTAL RADIO BOOTH - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped shack of salt-warped panels.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single microphone, a mixing board, a kettle.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Waves slap the pilings below.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A phone rests on the desk.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SAOIRSE TALLCHIEF, 30s, in a fisherman's sweater, sits at the board with her feet on the desk.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A \"LIVE\" lamp glows red.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She leans toward the mic.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "dialogue", "text": "Good evening, Gull Point. It's eleven past midnight, the tide is turning, and this is Saoirse with the Long Wave. Whoever's out there on the water, you're not alone.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": ["into mic"], "dual": false, "present": [0]}, {"u": 9, "kind": "action", "text": "She clicks off the mic.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "She lowers her feet.", "para": 2, "sent": 1, "present": [0]}, {"u": 11, "kind": "action", "text": "She rubs her face.", "para": 2, "sent": 2, "present": [0]}, {"u": 12, "kind": "dialogue", "text": "Stop being so cheerful. Nobody likes it.", "name": "SAOIRSE", "speaker": 0, "ext": ["CONT'D"], "paren": ["to herself"], "dual": false, "present": [0]}, {"u": 13, "kind": "action", "text": "The phone buzzes.", "para": 3, "sent": 0, "present": [0]}, {"u": 14, "kind": "action", "text": "She picks it up.", "para": 3, "sent": 1, "present": [0]}, {"u": 15, "kind": "dialogue", "text": "Long Wave.", "name": "SAOIRSE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 16, "kind": "dialogue", "text": "Hi. Is this the person who told the fishing fleet about my sourdough?", "name": "DEV", "speaker": 1, "ext": ["V.O."], "paren": ["over phone, warm, unhurried"], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "It might be.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "I'm Dev. I'm on the boat that took the bread.", "name": "DEV", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "The Marguerite?", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "The same.", "name": "DEV", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "They said the baker was an old man named Bernard.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Bernard is a rumor.", "name": "DEV", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She laughs.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She sets the kettle on its coil.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Outside, a gull cries.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "What do you want to hear, Dev?", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Something slow. For the crew. We've been out three nights.", "name": "DEV", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Fine, ladies and gentlemen, one slow one for the Marguerite.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": ["to the room, a half-whisper"], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "She flicks a switch.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "A low guitar begins.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "She cradles the phone against her shoulder.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Is it going to be this easy every night?", "name": "SAOIRSE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "If you call back.", "name": "DEV", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "I might.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Good. I'll bring the bread.", "name": "DEV", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "You'll be in the middle of the sea.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Then I'll swim.", "name": "DEV", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "She grins, helpless, and switches the mic back on.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "That was for Dev, and for everyone with salt on their hands.", "name": "SAOIRSE", "speaker": 0, "ext": ["CONT'D"], "paren": ["into mic"], "dual": false, "present": [0, 1]}]}