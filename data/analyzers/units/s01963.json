{"scene_id": "s01963", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01963.fountain", "heading": "INT. GARAGE - DAY", "cast": [{"id": 0, "name": "EUGENIA PRYOR", "names": ["EUGENIA PRYOR", "EUGENIA"], "gender": "?", "first": 5, "spoke": 15}, {"id": 1, "name": "THADDEUS PRYOR", "names": ["THADDEUS PRYOR", "THADDEUS"], "gender": "?", "first": 5, "spoke": 16}], "units": [{"u": 0, "kind": "heading", "text": "INT. GARAGE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Pegboard walls hung with outlines of tools that are no longer there.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A workbench strewn with jars of screws.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Open cardboard boxes, half-filled.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Dust floats in a band of sunlight.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "EUGENIA PRYOR, 50s, in jeans and a button-down, sorts bolts into a coffee can.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Across from her, THADDEUS PRYOR, 50s, stands with a worn leather glove in his hands, turning it over.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "That one's Dad's.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "I know whose it is.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Take it, if you want.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I don't want it.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Then put it in the donate box.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I'm not putting it in the donate box.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Then keep it.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "I said I don't want it.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She stops.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She sets the can down.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "A long pause.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "What do you want, Thad?", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "I want the afternoon to be over.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "It's eleven in the morning.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Then I want it to be tomorrow.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "She nods slowly.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She goes back to the bolts.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Did he ever say anything to you? About the garage?", "name": "THADDEUS", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "He said it was the only room in the house where nobody asked him questions.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "That sounds like him.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "He called it the quiet room.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "He never called it that to me.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "You never asked.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "He never gave me a chance.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Thad.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "I'm just saying. Eight years of weekends, and I'm still learning his hobbies from the pegboard.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "He fixed your bike once.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "He fixed it wrong. I rode it into a wall.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "He came to the hospital.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "For twenty minutes.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "For four hours. You were asleep.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "I didn't know that.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": ["a beat"], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Now you do.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "He sets the glove on the workbench.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "He smooths the leather.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "He leaves his hand on it.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "I'll take the can of bolts.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "They're all different sizes.", "name": "EUGENIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "I know.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "She hands him the can.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "He holds it against his chest, and nods, and does not look at her.", "para": 5, "sent": 1, "present": [0, 1]}]}