{"scene_id": "s01964", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01964.fountain", "heading": "INT. CORPORATE MASCOT COSTUME ROOM - DAY", "cast": [{"id": 0, "name": "DUNCAN ALBRIGHT", "names": ["DUNCAN ALBRIGHT", "DUNCAN"], "gender": "m", "first": 4, "spoke": 11}, {"id": 1, "name": "INTERN", "names": ["INTERN"], "gender": "?", "first": 5, "spoke": 6}, {"id": 2, "name": "MS. VANDERHOOF", "names": ["MS. VANDERHOOF"], "gender": "?", "first": 23, "spoke": 4}, {"id": 3, "name": "KIRAN SETHI", "names": ["KIRAN SETHI", "KIRAN"], "gender": "?", "first": 26, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. CORPORATE MASCOT COSTUME ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A windowless closet crowded with oversized plush heads on shelves.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A giant foam taco, a giant foam toaster, a lion with one eye missing.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A speaker on the wall crackles.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DUNCAN ALBRIGHT, 50s, regional marketing manager, tapped-out and pacing, shoves a mannequin aside.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "In the doorway stands an INTERN, 20s, in an oversized lanyard, holding a clipboard and a lukewarm coffee.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Who are you?", "name": "DUNCAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "I'm the, um, intern.", "name": "INTERN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "I've never seen you before.", "name": "DUNCAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I started Monday.", "name": "INTERN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "It's Thursday.", "name": "DUNCAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I know.", "name": "INTERN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Come in, come in. Close the door.", "name": "DUNCAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "The Intern closes it.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "The room shrinks.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Duncan rummages through the costumes, pulls out a hulking toaster head, and tosses it to the Intern.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Put that on.", "name": "DUNCAN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Why?", "name": "INTERN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Because Brian called in sick, and the parade starts at noon.", "name": "DUNCAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "I'm not trained for this.", "name": "INTERN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "It's a toaster. It pops up.", "name": "DUNCAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "The wall speaker crackles to life.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "A brisk female voice fills the closet.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Duncan. I'm told the toaster is missing.", "name": "MS. VANDERHOOF", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "It's being handled, Ms. Vanderhoof.", "name": "DUNCAN", "speaker": 0, "ext": [], "paren": ["to the speaker"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "By whom?", "name": "MS. VANDERHOOF", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "By... Kiran.", "name": "DUNCAN", "speaker": 0, "ext": [], "paren": ["glancing at the Intern"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Kiran?", "name": "INTERN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "It's what's on your lanyard.", "name": "DUNCAN", "speaker": 0, "ext": [], "paren": ["sotto"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "The Intern checks the tag.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "It does say KIRAN SETHI in tiny type.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Kiran puts the toaster head on.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "A muffled voice emerges.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "This smells like feet.", "name": "KIRAN", "speaker": 3, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Is Kiran ready?", "name": "MS. VANDERHOOF", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Kiran is as ready as Kiran will ever be.", "name": "KIRAN", "speaker": 3, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Excellent. Go pop.", "name": "DUNCAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Kiran waddles out the door and collides with the frame.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "The toaster head falls off and rolls across the floor.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Duncan buries his face in his hands.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "I heard that.", "name": "MS. VANDERHOOF", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}