{"scene_id": "s01965", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01965.fountain", "heading": "INT. CHURCH BASEMENT - GRIEF SUPPORT GROUP - NIGHT", "cast": [{"id": 0, "name": "PASTOR LUCILLE MARCHBANKS", "names": ["PASTOR LUCILLE MARCHBANKS", "LUCILLE"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "DWAYNE TOLLIVER", "names": ["DWAYNE TOLLIVER", "DWAYNE"], "gender": "m", "first": 5, "spoke": 2}, {"id": 2, "name": "ILSE BRANDL", "names": ["ILSE BRANDL", "ILSE"], "gender": "f", "first": 6, "spoke": 3}, {"id": 3, "name": "HAMZA QURESHI", "names": ["HAMZA QURESHI", "HAMZA"], "gender": "?", "first": 7, "spoke": 2}, {"id": 4, "name": "BEAU FONTENOT", "names": ["BEAU FONTENOT", "BEAU"], "gender": "?", "first": 8, "spoke": 3}, {"id": 5, "name": "NEWCOMER", "names": ["NEWCOMER"], "gender": "?", "first": 9, "spoke": 2}, {"id": 6, "name": "FELICIA", "names": ["FELICIA"], "gender": "?", "first": 25, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. CHURCH BASEMENT - GRIEF SUPPORT GROUP - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Folding chairs in a circle.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Styrofoam cups.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A hand-lettered banner reads \"WE REMEMBER.\"", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "PASTOR LUCILLE MARCHBANKS, 60s, presides over a plate of lemon bars.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "DWAYNE TOLLIVER, 40s, in a welder's jacket, grips his cup.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "ILSE BRANDL, 70s, in a lilac cardigan, dabs at her eyes.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "HAMZA QURESHI, 20s, cross-armed, stares at the floor.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "BEAU FONTENOT, 30s, jittery, taps a foot.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "A NEWCOMER, 30s, stands at the door in a rain-soaked coat.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Everyone, we have a guest.", "name": "LUCILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "I'll just sit.", "name": "NEWCOMER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "We don't bite.", "name": "DWAYNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "We do, a little.", "name": "ILSE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "The newcomer takes the empty chair.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Beau offers a lemon bar.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "The newcomer takes it, turns it over, and sets it on the floor.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "We say our names and our losses. Dwayne, will you begin?", "name": "LUCILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Dwayne. My brother, Marcus. Eleven months.", "name": "DWAYNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Ilse. My Walter. Nineteen years.", "name": "ILSE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Hamza. My mother. Last Tuesday.", "name": "HAMZA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Beau. My dog, Biscuit. And my wife, who left, which is kind of the same.", "name": "BEAU", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Beau.", "name": "LUCILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "I know. I know.", "name": "BEAU", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "All eyes turn to the newcomer.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Felicia. My daughter. She would have been six.", "name": "NEWCOMER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "The radiator ticks.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "Ilse reaches across the gap and takes Felicia's hand.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "Hamza finally looks up.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "I'm sorry.", "name": "HAMZA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "Thank you.", "name": "FELICIA", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "action", "text": "Felicia starts to cry.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "Dwayne pulls a handkerchief from his jacket and hands it over.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "The circle closes in a little, chair by chair.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "You're welcome here as long as you need.", "name": "LUCILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "Even if I don't talk?", "name": "FELICIA", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "Especially then.", "name": "BEAU", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "dialogue", "text": "Especially then.", "name": "ILSE", "speaker": 2, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "Lucille smiles.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "She passes the lemon bars around the circle, and one by one, they each take one.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}]}