{"scene_id": "s01966", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01966.fountain", "heading": "INT. DELIVERY ROOM - NIGHT", "cast": [{"id": 0, "name": "JOANNE KETTERING", "names": ["JOANNE KETTERING", "JOANNE"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "AMARA NWOSU", "names": ["AMARA NWOSU", "DR. NWOSU"], "gender": "f", "first": 5, "spoke": 3}, {"id": 2, "name": "BERTRAND", "names": ["BERTRAND"], "gender": "?", "first": 7, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. DELIVERY ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Monitors blink.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A woman breathes hard on the bed.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A speakerphone sits on the tray beside her, a tinny voice leaking out.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "JOANNE KETTERING, 30s, sweat-slicked, grips the bedrail.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "DR. AMARA NWOSU, 40s, sits at the foot of the bed in scrubs, calm.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "She lifts one hand to check a monitor, and Joanne squeezes the other.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "I'm on the ferry, I'm on the ferry, I'll be there in twenty minutes.", "name": "BERTRAND", "speaker": 2, "ext": ["V.O."], "paren": ["over speakerphone"], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "You said ten.", "name": "JOANNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "There was a delay.", "name": "BERTRAND", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "You said ten, Bertrand!", "name": "JOANNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "She's strong. Keep going.", "name": "DR. NWOSU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "I'm going to kill him.", "name": "JOANNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Later. Breathe.", "name": "DR. NWOSU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "She does.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "She screams.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "The monitor spikes.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Dr. Nwosu rises, takes her position, and nods to the nurse.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Now. Push.", "name": "DR. NWOSU", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Jo? Jo, is she okay?", "name": "BERTRAND", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "She's fine! I'm not!", "name": "JOANNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "She pushes.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "A small cry cuts through the room.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Dr. Nwosu lifts a squirming newborn into the light.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Joanne collapses against the pillow, laughing and crying at once.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Is that her? Is that the baby?", "name": "BERTRAND", "speaker": 2, "ext": ["V.O."], "paren": ["over speakerphone, faint"], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Come meet her, you idiot.", "name": "JOANNE", "speaker": 0, "ext": [], "paren": ["to the phone"], "dual": false, "present": [0, 1, 2]}]}