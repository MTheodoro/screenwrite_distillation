{"scene_id": "s01969", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01969.fountain", "heading": "EXT. PARKING GARAGE ROOFTOP - NIGHT", "cast": [{"id": 0, "name": "VERONIKA SALT", "names": ["VERONIKA SALT", "VERONIKA"], "gender": "f", "first": 5, "spoke": 18}, {"id": 1, "name": "CASSIAN BOYLE", "names": ["CASSIAN BOYLE", "CASSIAN"], "gender": "?", "first": 9, "spoke": 15}], "units": [{"u": 0, "kind": "heading", "text": "EXT. PARKING GARAGE ROOFTOP - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Concrete.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Painted lines.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A rusted rail overlooking a city of amber lights.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single black sedan sits under a dead lamp, engine ticking as it cools.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "VERONIKA SALT, 40s, long coat, briefcase handcuffed to her left wrist, stands at the rail.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She watches the stairwell door.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Her breath fogs.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "The door opens.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "CASSIAN BOYLE, 30s, bare head, shoulders tight in a gray suit, steps onto the roof alone.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He carries nothing.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He stops ten paces away.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "You're early.", "name": "VERONIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "You're not.", "name": "CASSIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "I've been here an hour.", "name": "VERONIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I know. I watched you from the street.", "name": "CASSIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She smiles faintly.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She shifts the briefcase.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "The chain between her wrist and the handle rattles.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Then you know I came alone.", "name": "VERONIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "I know you came with a gun in your boot.", "name": "CASSIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "It's cold up here.", "name": "VERONIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "It's always cold up here. That's why you picked it.", "name": "CASSIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She lifts her chin.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "A car passes on the street below, headlights sliding across the wall.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "When the light fades, he has taken one step closer.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Stop there.", "name": "VERONIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "You said I could come close.", "name": "CASSIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "I said you could come.", "name": "VERONIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "She steps backward until the rail presses against her spine.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "He takes another step.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "She slides a hand into her coat.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "He raises both his, palms open.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Veronika. You called me.", "name": "CASSIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "I did.", "name": "VERONIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "You told me you had the files.", "name": "CASSIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "I told you what you needed to hear.", "name": "VERONIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "That's not an answer.", "name": "CASSIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "It's the only one I have.", "name": "VERONIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "He studies her.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "His shoulders ease.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "He lowers his hands.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "You don't have them.", "name": "CASSIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "No.", "name": "VERONIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "You never did.", "name": "CASSIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "I never said I did.", "name": "VERONIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Then why drag me up here?", "name": "CASSIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "Because I wanted to see your face when you found out.", "name": "VERONIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "And?", "name": "CASSIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "It's disappointing.", "name": "VERONIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "He laughs, short and dry.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "She draws a small pistol from her coat and trains it on his chest.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "He stops laughing.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "The garage hums.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "Veronika.", "name": "CASSIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "Cassian.", "name": "VERONIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "Put the gun down.", "name": "CASSIAN", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "Put the gun down, or I'll count to three.", "name": "VERONIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "He glances at the stairwell door.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "She follows his gaze.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "The moment she looks away he lunges, knocking the pistol aside with the flat of his hand and slamming her into the railing.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "The briefcase swings on its chain and strikes his hip.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "They fall in a heap on the concrete, grappling, her free hand clawing at his collar, his forearm across her throat.", "para": 8, "sent": 4, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "Cassian. Look up.", "name": "VERONIKA", "speaker": 0, "ext": ["CONT'D"], "paren": ["gasping"], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "He does.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "Across the roof, three red dots of laser light settle on his chest.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "He freezes.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 67, "kind": "action", "text": "His arm loosens.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "She slips out from under him, picks up the pistol, and stands.", "para": 9, "sent": 4, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "You called them.", "name": "CASSIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "I called everyone.", "name": "VERONIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "She unlocks the briefcase handcuff with a key from her sleeve and drops the case at his feet.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "The lid is open.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "It is empty.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 74, "kind": "dialogue", "text": "That's all there ever was.", "name": "VERONIKA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 75, "kind": "action", "text": "She walks to the stairwell door.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 76, "kind": "action", "text": "At the threshold, she looks back.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 77, "kind": "action", "text": "He stays kneeling on the concrete in the red light, hands open, and says nothing.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 78, "kind": "action", "text": "She goes out.", "para": 11, "sent": 3, "present": [0, 1]}, {"u": 79, "kind": "action", "text": "The door closes.", "para": 11, "sent": 4, "present": [0, 1]}]}