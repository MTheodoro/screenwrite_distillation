{"scene_id": "s01970", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01970.fountain", "heading": "INT. COUNTY SALT DOME - NIGHT", "cast": [{"id": 0, "name": "NGOZI ADEYEMI-BROOKS", "names": ["NGOZI ADEYEMI-BROOKS", "NGOZI"], "gender": "f", "first": 3, "spoke": 12}, {"id": 1, "name": "DEZ", "names": ["DEZ"], "gender": "?", "first": 4, "spoke": 5}, {"id": 2, "name": "PRUITT", "names": ["PRUITT"], "gender": "?", "first": 4, "spoke": 0}, {"id": 3, "name": "BILLIE WARSHAW", "names": ["BILLIE WARSHAW", "BILLIE"], "gender": "?", "first": 4, "spoke": 6}, {"id": 4, "name": "TOMASZ KR", "names": ["TOMASZ KR", "TOMASZ"], "gender": "m", "first": 4, "spoke": 8}, {"id": 5, "name": "ARLO MENDES", "names": ["ARLO MENDES", "ARLO"], "gender": "?", "first": 4, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. COUNTY SALT DOME - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cavern of road salt, pale as a glacier.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single work lamp hums on a tripod.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "NGOZI ADEYEMI-BROOKS (50s, plow-crew foreman, reading glasses on a cord) stands over a clipboard.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "Around her: DEZ \"THE DEACON\" PRUITT (30s, enormous, soft-voiced), BILLIE WARSHAW (20s, rookie, hi-vis too big), TOMASZ KR\u00d3L (60s, mechanic, grease to the elbow) and ARLO MENDES (40s, union steward, thermos in hand).", "para": 1, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 5, "kind": "action", "text": "She taps the clipboard.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 6, "kind": "action", "text": "They go quiet.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 7, "kind": "dialogue", "text": "Listen up, all of you. The county cut the overnight run. Starting Friday.", "name": "NGOZI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "action", "text": "Nobody moves.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "action", "text": "Tomasz sets down his wrench.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Cut how.", "name": "TOMASZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Cut like gone.", "name": "NGOZI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "They can't. It's in the contract.", "name": "ARLO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Arlo, it's in the contract that they can.", "name": "NGOZI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "He looks at the thermos.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Unscrews it.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Doesn't pour.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "So I just got here.", "name": "BILLIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Billie.", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Three weeks. I bought boots.", "name": "BILLIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Billie, hush a second.", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "She does.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "He rests a hand on her shoulder, then thinks better of it and lets it drop.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Thirty-one winters.", "name": "TOMASZ", "speaker": 4, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "I'll file tonight. Grievance, the whole thing. Ngozi, you sign as witness, Dez, you sign, Tomasz you sign, and Billie, you're probationary so you don't sign anything, you just watch.", "name": "ARLO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "That's not fair.", "name": "BILLIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "No. It's not.", "name": "ARLO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Nobody is filing anything tonight.", "name": "NGOZI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Excuse me?", "name": "ARLO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "I took the deal.", "name": "NGOZI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Salt ticks somewhere in the dark as a small slide settles.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "What deal.", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Day shift. Four of us stay. Two go.", "name": "NGOZI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Who decides who goes.", "name": "ARLO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "I do.", "name": "NGOZI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Then say it.", "name": "TOMASZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Tomasz, I'm not going to say it in front of the kids.", "name": "NGOZI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "I'm sixty-three years old. Say it.", "name": "TOMASZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "She takes off her glasses.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "They drop on the cord against her chest.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "You and Billie. Seniority says you, Tomasz, and last-hired says her, and I fought for it every other way and the number didn't move.", "name": "NGOZI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "You put me ahead of him?", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "I put nobody ahead of anybody. A spreadsheet did.", "name": "NGOZI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "A spreadsheet. Fantastic. I'll tell my wife I lost a man to a spreadsheet.", "name": "ARLO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "I can go. It's fine. I can go.", "name": "BILLIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Don't you dare say that's fine.", "name": "TOMASZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "Then what do I say?", "name": "BILLIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "Say you want to burn the place down.", "name": "TOMASZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "I want to burn the place down.", "name": "BILLIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "Good girl. Now say it like you mean it.", "name": "TOMASZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Dez laughs, a short bark, and that breaks it.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "Arlo laughs.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "Even Ngozi's mouth moves.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "Then Tomasz is not laughing.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "He turns away toward the dark of the dome.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "Hey. Old man.", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "Thirty-one winters, and a spreadsheet.", "name": "TOMASZ", "speaker": 4, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "Ngozi puts her glasses back on, picks up the clipboard, and turns it to face them.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "Everyone sign the grievance. Everyone. I'll sign first.", "name": "NGOZI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "You just said.", "name": "ARLO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "dialogue", "text": "I said nobody files tonight. It's four a.m. We file at nine.", "name": "NGOZI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "She signs.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "Passes it to Dez.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}