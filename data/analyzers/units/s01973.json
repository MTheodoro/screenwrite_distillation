{"scene_id": "s01973", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01973.fountain", "heading": "INT. MINIATURE-GOLF CLOCK TOWER, WINDMILL HOLE - NIGHT", "cast": [{"id": 0, "name": "TALL MAN", "names": ["TALL MAN"], "gender": "m", "first": 5, "spoke": 9}, {"id": 1, "name": "WOMAN", "names": ["WOMAN"], "gender": "?", "first": 7, "spoke": 8}, {"id": 2, "name": "DOLORES", "names": ["DOLORES"], "gender": "?", "first": 39, "spoke": 5}, {"id": 3, "name": "WALT", "names": ["WALT"], "gender": "?", "first": 50, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. MINIATURE-GOLF CLOCK TOWER, WINDMILL HOLE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A faded mini-golf course after closing.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Plastic windmill, fiberglass lighthouse, a clock-tower hole with a hollow base.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A service panel stands open at its foot.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A figure in a black hoodie crouches inside the clock tower with a headlamp and a duffel bag.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "A TALL MAN (40s, careful hands, wedding ring on a chain around his neck) works a thin pick into the panel's lock.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "A second figure appears at the fence line.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "A WOMAN (30s, sneakers, a tote bag from a bakery) climbs over, lands badly, and freezes.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "They stare at each other.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "The Tall Man lifts one finger to his lips.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She nods.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Walks over without a sound, sets down the bakery tote, and kneels beside him.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "You're late.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "You're early.", "name": "TALL MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "There's a cop at the corner.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "He's eating.", "name": "TALL MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "How do you know he's eating?", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Because it's a Tuesday and Tuesdays are pierogi.", "name": "TALL MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She considers this.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Looks at the lock.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "At his hands.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "You said four minutes.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "He does not answer.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "The pick clicks.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Stops.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "He pulls it out, wipes it on his sleeve, and starts again, slower.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Okay. Okay. Okay.", "name": "WOMAN", "speaker": 1, "ext": ["CONT'D"], "paren": ["to herself"], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Talk to the lock, not me.", "name": "TALL MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "The lock doesn't care.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Neither do I. Please.", "name": "TALL MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "A siren, distant, passes the block and fades.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Neither of them breathes until it does.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "He lowers his headlamp to a dim red.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "The lock gives with a soft thunk.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "He pulls the panel back.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Inside, a steel box the size of a toaster.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "That's it?", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "That's it.", "name": "TALL MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Thirty years in this city and the most valuable thing in it is under a clock tower with a cartoon face.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Dolores, that's the point.", "name": "TALL MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "The woman, DOLORES, goes still.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "He realizes what he's said.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Neither speaks.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "You said you wouldn't use names.", "name": "DOLORES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "I know.", "name": "TALL MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "So you know mine.", "name": "DOLORES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "He closes his eyes briefly.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Opens them.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Reaches for the steel box and lifts it out with both hands.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "It's heavier than it looks.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Walt.", "name": "TALL MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Walt.", "name": "DOLORES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "My name. Since we're doing it.", "name": "WALT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "She takes the box from him and puts it in the bakery tote under a layer of paper-wrapped rolls.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "A long, satisfied, silent beat.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Then headlights sweep the course.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Walt.", "name": "DOLORES", "speaker": 2, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "I see it.", "name": "WALT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "They crouch lower inside the hollow of the tower, shoulders pressed together.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "The lights pass across the fiberglass lighthouse.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "Stop.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "Linger.", "para": 11, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "A car door opens.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "Pierogi's done early.", "name": "WALT", "speaker": 3, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "Don't joke.", "name": "DOLORES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "I'm not.", "name": "WALT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "She takes his hand.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "He lets her.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}]}