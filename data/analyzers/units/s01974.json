{"scene_id": "s01974", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01974.fountain", "heading": "INT. DRY-DOCK PUMP HOUSE - NIGHT", "cast": [{"id": 0, "name": "KESTREL OYELARAN-FINCH", "names": ["KESTREL OYELARAN-FINCH", "KESTREL"], "gender": "f", "first": 4, "spoke": 12}, {"id": 1, "name": "DRAGAN MIHAJLOVI", "names": ["DRAGAN MIHAJLOVI", "DRAGAN"], "gender": "m", "first": 5, "spoke": 11}, {"id": 2, "name": "INSPECTOR ROSALIND ACHTERBERG", "names": ["INSPECTOR ROSALIND ACHTERBERG", "ROSALIND"], "gender": "f", "first": 22, "spoke": 9}, {"id": 3, "name": "ALVARO", "names": ["ALVARO"], "gender": "?", "first": 41, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRY-DOCK PUMP HOUSE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cathedral of valves and rust-orange pipework.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A drained dry dock yawns beyond a glass wall, the hull of a half-scrapped ferry propped on blocks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Emergency light only.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "KESTREL OYELARAN-FINCH (30s, ex-auditor, wet hair, laptop bag clutched to her chest) backs against a pump housing.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "In the center of the room, DRAGAN MIHAJLOVI\u0106 (50s, heavy coat, port authority lanyard) stands with a pistol held low and loose, like a tool he's tired of.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Put the bag on the floor.", "name": "DRAGAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "No.", "name": "KESTREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "It's not a negotiation.", "name": "DRAGAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "It's the only thing keeping you from sitting in a cell.", "name": "KESTREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He tilts his head.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "A dripping pipe counts seconds.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "The ledgers are digital.", "name": "DRAGAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "So are the backups.", "name": "KESTREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Where?", "name": "DRAGAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Not telling.", "name": "KESTREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He sighs, and for a moment looks almost sad.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Steps forward.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Behind Kestrel, a hatch clangs.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Boots on a steel stair.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She spins.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Dragan doesn't.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "A third figure descends: INSPECTOR ROSALIND ACHTERBERG (40s, plain coat, badge on her belt, one hand already on her holster).", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Port Authority Police. Mr. Mihajlovi\u0107. Lower it.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Rosalind.", "name": "DRAGAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Lower it, Dragan.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "He doesn't.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Doesn't raise it either.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Kestrel looks from one to the other.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "You know each other.", "name": "KESTREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Twenty years.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Then you can talk him out of this.", "name": "KESTREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "I'm not here to talk him out of anything.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Kestrel's face changes.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "She takes a step back, into the pump housing.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "You're not here to arrest him.", "name": "KESTREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "I'm here to see that the bag leaves with me.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Ah. There we are.", "name": "DRAGAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "I called you. You said you'd come.", "name": "KESTREL", "speaker": 0, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "And I did.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "A fourth voice speaks from the dark above the stair, unamplified, polite.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Everyone relax. Please.", "name": "ALVARO", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "All three look up.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "A silhouette stands on the catwalk, a phone held loosely to its ear.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Who is that.", "name": "DRAGAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Someone who'd like to hear the rest of this.", "name": "ALVARO", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "You brought a recorder?", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": ["to Dragan"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "I didn't bring anyone.", "name": "DRAGAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "No, I came on my own. Mrs. Oyelaran-Finch, I believe that's your bag.", "name": "ALVARO", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Kestrel stares at the catwalk.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Then, slowly, at the two armed people in front of her.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "She sets the bag on the floor, pushes it with her foot across the concrete toward Rosalind and Dragan, and steps away from it with her hands visible.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "It's yours. Whoever wants it.", "name": "KESTREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Neither of them moves.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Dragan lowers his pistol an inch.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Rosalind's hand leaves her holster.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "The pipe drips.", "para": 11, "sent": 3, "present": [0, 1, 3]}, {"u": 57, "kind": "dialogue", "text": "That's better.", "name": "ALVARO", "speaker": 3, "ext": ["O.S."], "paren": ["softly"], "dual": false, "present": [0, 1, 3]}, {"u": 58, "kind": "dialogue", "text": "Twenty years.", "name": "DRAGAN", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 3]}, {"u": 59, "kind": "dialogue", "text": "Don't.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "She crouches and picks up the bag.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "Opens it.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "Looks inside.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "Closes it.", "para": 12, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "It's empty.", "name": "ROSALIND", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "What?", "name": "DRAGAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "The laptop's in the dock.", "name": "KESTREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "All of them turn to the glass wall.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "Far below, at the foot of the rusted hull, a tiny blue light glows on the concrete floor of the dry dock, beside a sealed gate that has just begun to let in water.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "dialogue", "text": "You flooded it.", "name": "DRAGAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "dialogue", "text": "I opened a valve. It's what the pump house is for.", "name": "KESTREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "Rosalind sprints for the door.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "action", "text": "Dragan lowers his gun completely and watches the water, and the blue light, and the woman, one after the other.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "Oh, well done.", "name": "ALVARO", "speaker": 3, "ext": ["O.S."], "paren": ["delighted"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "dialogue", "text": "Don't follow me.", "name": "KESTREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "She walks to the stair and climbs past the catwalk without looking at it.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "At the top, the silhouette steps aside to let her through.", "para": 15, "sent": 1, "present": [0, 1, 2, 3]}]}