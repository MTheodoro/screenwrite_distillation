{"scene_id": "s01975", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01975.fountain", "heading": "INT. MUNICIPAL SWIMMING BATH, SLOW LANE - EARLY MORNING", "cast": [{"id": 0, "name": "COACH HESTER LINDQVIST-AMOAH", "names": ["COACH HESTER LINDQVIST-AMOAH", "HESTER"], "gender": "f", "first": 4, "spoke": 6}, {"id": 1, "name": "NINA OKONKWO-REYES", "names": ["NINA OKONKWO-REYES", "NINA"], "gender": "?", "first": 6, "spoke": 3}, {"id": 2, "name": "WILFREDO REYES", "names": ["WILFREDO REYES", "WILFREDO"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "TOURNAMENT OFFICIAL", "names": ["TOURNAMENT OFFICIAL"], "gender": "?", "first": 9, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. MUNICIPAL SWIMMING BATH, SLOW LANE - EARLY MORNING", "present": []}, {"u": 1, "kind": "action", "text": "A Victorian bath hall, tiled the green of old bottles, steam lifting off the water in sheets.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Iron galleries ring the pool.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Behind the clerestory glass, a gray dawn.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "COACH HESTER LINDQVIST-AMOAH (60s, tall, wool cardigan, stopwatch around her neck) stands at the pool's edge with her hands behind her back.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She has watched ten thousand swimmers and no longer pretends to be surprised by any of them.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "In the water, treading, is NINA OKONKWO-REYES (17, goggles pushed to her forehead, lips pale from cold), the best backstroker the club has had in a decade.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Beside her, on the edge, sits her father, WILFREDO REYES (40s, work boots, a thermos, a face that has not slept).", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "A wall-mounted speaker coughs.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Heat four, lane three, you are called to the blocks. Heat four, lane three.", "name": "TOURNAMENT OFFICIAL", "speaker": 3, "ext": ["V.O."], "paren": ["over loudspeaker, distorted"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Nina does not move.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Her father unscrews the thermos.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "That is you, mija.", "name": "WILFREDO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "I know it's me.", "name": "NINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "She pulls her goggles down.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Pushes them up again.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Pulls them down.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Nina. Look at me.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "She does.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "The coach crouches, joints cracking, and speaks in a voice that does not carry beyond the three of them.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "You have trained every morning for six years. Whatever happens in the next minute and a half has nothing to do with that.", "name": "HESTER", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "It has everything to do with that.", "name": "NINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Then you've nothing to fear.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "You're not helping.", "name": "NINA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Hester almost smiles.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "She straightens, takes the stopwatch from around her neck, and presses it into the girl's wet palm.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "The girl looks at it, bewildered.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Hold it. Don't start it.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Final call, lane three.", "name": "TOURNAMENT OFFICIAL", "speaker": 3, "ext": ["V.O."], "paren": ["over loudspeaker"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Nina's hand closes around the stopwatch.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "She hauls herself out of the water in one movement, streaming, steaming, and walks toward the starting blocks with her father's eyes on her back.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "He rises, half-lifts a hand, lets it fall.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Hester touches his elbow.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "She'll be fine.", "name": "HESTER", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "You said that last year.", "name": "WILFREDO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "And last year she was.", "name": "HESTER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "He nods slowly.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "He looks down at the thermos in his hand as if wondering how it got there.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "At the blocks, Nina bends.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Her fingers curl around the edge of the starting platform.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Her knees bend.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Her shoulders fall.", "para": 10, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "The hall goes silent.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Even the steam seems to hold.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Take your marks.", "name": "TOURNAMENT OFFICIAL", "speaker": 3, "ext": ["V.O."], "paren": ["over loudspeaker"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "A beep.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "She is in the air.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}]}