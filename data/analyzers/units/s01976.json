{"scene_id": "s01976", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01976.fountain", "heading": "INT. NIGHT-FLIGHT CARGO DEPOT, GRAND CENTRAL POST OFFICE - NIGHT", "cast": [{"id": 0, "name": "CORINNE ABADI-VEGA", "names": ["CORINNE ABADI-VEGA", "CORINNE"], "gender": "f", "first": 4, "spoke": 15}, {"id": 1, "name": "THEO MARCHETTI-OYELOWO", "names": ["THEO MARCHETTI-OYELOWO", "THEO"], "gender": "?", "first": 8, "spoke": 16}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT-FLIGHT CARGO DEPOT, GRAND CENTRAL POST OFFICE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cavernous sorting hall, the last shift of a century-old mail depot.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Conveyor belts rattle in a long copper-colored light.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Tin parcels, rope-bound crates, wire baskets of letters stacked like wheat.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CORINNE ABADI-VEGA (30s, sleeves rolled, ink on her cuffs) stands at a sorting desk with a clipboard, lit by a green banker's lamp.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She hasn't looked at the clipboard in minutes.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Across the hall, a forklift hums to a stop.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "A man in a gray coat steps down from it and walks toward her, slowly, as if the floor might not hold.", "para": 2, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "THEO MARCHETTI-OYELOWO (30s, rumpled, a cardboard tube under one arm) stops six feet from the desk.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He opens his mouth, shuts it.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "The belt rattles between them.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "You were supposed to be in Lisbon.", "name": "CORINNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "The flight got cancelled.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Planes get cancelled in Lisbon every week. You came here.", "name": "CORINNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "I came here.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She puts the clipboard down and aligns it with the edge of the desk, three times, until it is exactly parallel.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He watches her do it.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "You still do that.", "name": "THEO", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "You still turn up.", "name": "CORINNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Corinne.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "I got your letter.", "name": "CORINNE", "speaker": 0, "ext": [], "paren": ["over him"], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Did you read it?", "name": "THEO", "speaker": 1, "ext": [], "paren": ["over her"], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Both stop.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "A beat.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "The belts clatter.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Go on.", "name": "CORINNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "You first.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Go on, Theo.", "name": "CORINNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Did you read it?", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Twice. I kept the envelope.", "name": "CORINNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "He pulls the cardboard tube from under his arm and holds it out to her without a word.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "She doesn't take it.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "A package slides off a belt and thumps onto a pile.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Neither of them looks.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "It's the house. The one on the river. I drew it.", "name": "THEO", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "You can't draw.", "name": "CORINNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "I can't. I tried anyway.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "She takes the tube.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Pops the cap.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Draws out a roll of tracing paper, spreads it across the desk under the green lamp, and holds the corners down with a stapler and a roll of tape.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "A lopsided house, a lopsided tree, two figures at a lopsided table.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "That's not our table.", "name": "CORINNE", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "It's the one I want.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Our table has three legs and a book under the fourth.", "name": "CORINNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "I'd keep the book.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "A giggle escapes her.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "She covers her mouth, appalled.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "He steps forward.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "She steps back, against the desk, lamp swaying.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "The shadows of both of them swing across the hall.", "para": 8, "sent": 4, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "You left.", "name": "CORINNE", "speaker": 0, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "I know.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "You didn't leave. You evaporated.", "name": "CORINNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "I know.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "And now you've drawn me a house.", "name": "CORINNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "And I'd like to live in it with you. If the offer stands.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "A pause.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "The conveyor stops with a hydraulic sigh and the hall goes silent.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "The two stand very close.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "I hate this about you.", "name": "CORINNE", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "I know.", "name": "THEO", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "Stay.", "name": "CORINNE", "speaker": 0, "ext": [], "paren": ["together"], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "Stay.", "name": "THEO", "speaker": 1, "ext": [], "paren": ["together"], "dual": true, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "They hear each other.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "Both freeze, then both laugh, helplessly, and her forehead drops onto his shoulder.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "His hand finds her back.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "Behind them the belts shudder and start to turn again.", "para": 10, "sent": 3, "present": [0, 1]}]}