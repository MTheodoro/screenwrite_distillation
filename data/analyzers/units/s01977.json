{"scene_id": "s01977", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01977.fountain", "heading": "INT. COIN LAUNDROMAT, BACK BENCH - NIGHT", "cast": [{"id": 0, "name": "JUNE KOWALCZYK-ABARA", "names": ["JUNE KOWALCZYK-ABARA", "JUNE"], "gender": "m", "first": 4, "spoke": 2}, {"id": 1, "name": "ELIAS TORRES-NAKAMURA", "names": ["ELIAS TORRES-NAKAMURA", "ELIAS"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "DELPHINE OYEBANJI", "names": ["DELPHINE OYEBANJI", "MRS. OYEBANJI"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "KOFI", "names": ["KOFI"], "gender": "?", "first": 7, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. COIN LAUNDROMAT, BACK BENCH - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A narrow laundromat.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dryers turn in rows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Four people, one bench.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "JUNE KOWALCZYK-ABARA (20s, hoodie, library book) reads.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Next to her, ELIAS TORRES-NAKAMURA (20s, scrubs, tired) folds a towel into a perfect square.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Across the aisle, MRS. DELPHINE OYEBANJI (70s, headscarf) watches them both.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Beside her, her grandson, KOFI (10, tablet), pretends not to.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Elias drops a sock.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "It lands on June's shoe.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "She lifts the sock between two fingers and holds it out without looking up.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Thanks.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "It's got a hole.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "It's on purpose.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "She smiles at the book.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Neither looks at the other.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Does anybody have change for a five?", "name": "MRS. OYEBANJI", "speaker": 2, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "No, ma'am.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "I'll check.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "She digs in her bag and comes up with four quarters and a button.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Elias stares at the button.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "She hands over the quarters.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Her hand stays where his can reach it.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "His does, briefly.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Grandma, he's holding her hand.", "name": "KOFI", "speaker": 3, "ext": [], "paren": ["to Mrs. Oyebanji, loud"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Mind your game.", "name": "MRS. OYEBANJI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Elias pulls back.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "June turns a page she has not read.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "The dryer buzzes, and all four look at it as if it had spoken.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Mine.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": ["muttered"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "He doesn't get up.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "June stands, opens the dryer, and hands him his warm laundry without a word.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "He takes it as if it were something far more breakable.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}]}