{"scene_id": "s01983", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01983.fountain", "heading": "INT. DOUBLE-DECKER TOUR BUS, EMPTY, PARKED IN DEPOT - DAY", "cast": [{"id": 0, "name": "GUS BELLOWES-ADEYEMI", "names": ["GUS BELLOWES-ADEYEMI", "GUS"], "gender": "m", "first": 5, "spoke": 22}, {"id": 1, "name": "FERDY", "names": ["FERDY"], "gender": "m", "first": 6, "spoke": 20}, {"id": 2, "name": "LAGRANGE", "names": ["LAGRANGE"], "gender": "?", "first": 6, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. DOUBLE-DECKER TOUR BUS, EMPTY, PARKED IN DEPOT - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A red open-top bus, parked indoors under fluorescent lights.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Plastic seats.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A microphone on a coiled cord.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Nobody aboard but two men.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "GUS BELLOWES-ADEYEMI (50s, tour-guide blazer, sweaty) stands at the front with the microphone.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Seated three rows back, arms crossed, is FERDINAND \"FERDY\" LAGRANGE (40s, same blazer, one size smaller), clutching a clipboard.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Ladies and gentlemen, welcome aboard the Grand Heritage Tour!", "name": "GUS", "speaker": 0, "ext": [], "paren": ["into microphone, cheerful"], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "He waves at the empty seats.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Ferdy scribbles on the clipboard.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "You're not smiling with your eyes.", "name": "FERDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I'm smiling with my mouth.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "That's the problem.", "name": "FERDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Gus lowers the mic.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Raises it.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Clears his throat.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "To your left, the Old Customs House, built in eighteen...", "name": "GUS", "speaker": 0, "ext": [], "paren": ["into microphone"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "He glances at his index card.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Turns it over.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Turns it back.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Eighteen what.", "name": "GUS", "speaker": 0, "ext": ["CONT'D"], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Eighteen-forty.", "name": "FERDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Eighteen-forty. To your left, built in eighteen-forty--", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Forty-one.", "name": "FERDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "It says forty here.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "It was wrong. I fixed it.", "name": "FERDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Gus slowly lowers the microphone to his chest.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "You rewrote my card.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "I corrected your card.", "name": "FERDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "It's my route.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "It's my company.", "name": "FERDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Your uncle's company.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "He left it to me.", "name": "FERDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "He left it to you because you were standing there.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Ferdy stands.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "The bus rocks.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Gus takes a step toward the aisle.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "The microphone cord pulls taut between them like a leash.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Ladies and gentlemen, please excuse the driver, who has a problem with authority.", "name": "FERDY", "speaker": 1, "ext": [], "paren": ["to the empty seats"], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Ladies and gentlemen, please disregard the owner, who has never driven this bus once.", "name": "GUS", "speaker": 0, "ext": [], "paren": ["to the empty seats"], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "I have too!", "name": "FERDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "You hit the carousel.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "That carousel was in the road.", "name": "FERDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "It's been there since the nineteen-twenties!", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Ferdy lunges for the microphone.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Gus holds it above his head.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Ferdy jumps, trips on the cord, and lands on the seat with the mic in his lap.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Gus stands over him, panting.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Neither of them says anything.", "para": 7, "sent": 4, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Gus is absolutely furious.", "para": 7, "sent": 5, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Ferdy looks up at him, wounded and stunned.", "para": 7, "sent": 6, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "You're right. I hit the carousel.", "name": "FERDY", "speaker": 1, "ext": [], "paren": ["small"], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Gus's face falls from fury to bewilderment.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "...That's it?", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "That's it.", "name": "FERDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "You're just going to say that?", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "I've wanted to say it for six years.", "name": "FERDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Gus sits down heavily on the seat across the aisle.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "He rubs his face with both hands.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "He was in the middle of the road, Ferdy.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "The carousel?", "name": "FERDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "The pony. The one in the middle.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "Was that why you took the left?", "name": "FERDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "I thought it was a real pony.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "They stare at each other.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "Ferdy's lip twitches.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "Gus's does too.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "Then Ferdy snorts, and Gus wheezes, and the two men fall into helpless, honking laughter, rocking the whole bus.", "para": 10, "sent": 3, "present": [0, 1, 2]}, {"u": 68, "kind": "dialogue", "text": "A real pony.", "name": "FERDY", "speaker": 1, "ext": [], "paren": ["gasping"], "dual": false, "present": [0, 1, 2]}, {"u": 69, "kind": "dialogue", "text": "Don't.", "name": "GUS", "speaker": 0, "ext": [], "paren": ["wiping his eyes"], "dual": false, "present": [0, 1, 2]}, {"u": 70, "kind": "dialogue", "text": "In the middle of the road.", "name": "FERDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 71, "kind": "dialogue", "text": "Stop.", "name": "GUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 72, "kind": "action", "text": "Their laughter dies slowly.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 73, "kind": "action", "text": "Ferdy lifts the microphone, holds it between them like a peace pipe, and offers it to Gus.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 74, "kind": "dialogue", "text": "Ladies and gentlemen. This is Gus. He knows the way.", "name": "FERDY", "speaker": 1, "ext": [], "paren": ["into microphone, to the empty seats"], "dual": false, "present": [0, 1, 2]}, {"u": 75, "kind": "action", "text": "He passes it over.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 76, "kind": "action", "text": "Gus looks at it for a long moment, then stands, steps to the front, and clears his throat.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 77, "kind": "dialogue", "text": "To your left, the Old Customs House. Built in eighteen-forty-one.", "name": "GUS", "speaker": 0, "ext": [], "paren": ["into microphone, gently"], "dual": false, "present": [0, 1, 2]}, {"u": 78, "kind": "dialogue", "text": "Thank you.", "name": "FERDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 79, "kind": "dialogue", "text": "Eighteen-forty.", "name": "GUS", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}]}