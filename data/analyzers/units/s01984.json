{"scene_id": "s01984", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01984.fountain", "heading": "EXT. FERRIS WHEEL, TOP GONDOLA - NIGHT", "cast": [{"id": 0, "name": "PETRA SOLBERG-IWU", "names": ["PETRA SOLBERG-IWU", "PETRA"], "gender": "?", "first": 5, "spoke": 18}, {"id": 1, "name": "CAL", "names": ["CAL"], "gender": "m", "first": 6, "spoke": 19}, {"id": 2, "name": "ARDOUIN", "names": ["ARDOUIN"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "OPERATOR", "names": ["OPERATOR"], "gender": "?", "first": 38, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FERRIS WHEEL, TOP GONDOLA - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A county-fair Ferris wheel, lit gold against a black sky.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "It has stopped.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The top gondola sways.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Far below, a crowd and a stuttering generator.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "PETRA SOLBERG-IWU (30s, vintage dress, nerves) clutches the safety bar.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Beside her, CALLUM \"CAL\" ARDOUIN (30s, bad blazer, worse haircut) leans over the rail and waves at the ground.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Hello down there! We're fine!", "name": "CAL", "speaker": 1, "ext": [], "paren": ["shouting"], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "They can't hear you.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "They'll see me waving.", "name": "CAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "They'll see a man falling.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He pulls back, sits, grips the bar beside her.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "The gondola creaks.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Okay. So. This is not how I planned it.", "name": "CAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "How did you plan it?", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Cotton candy. Slow ride. Kiss at the top.", "name": "CAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "We are at the top.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Yes.", "name": "CAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Cal.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Yes?", "name": "CAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "It's not a good moment.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "It's an excellent moment. We have all the time in the world. We're stuck.", "name": "CAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "She laughs, sharp.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Looks away.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Oh, this is ridiculous.", "name": "PETRA", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "What did you say?", "name": "CAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Nothing.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "You said ridiculous.", "name": "CAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "I said it to myself.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "A gust.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "The gondola lurches.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "She seizes his arm.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "He freezes.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "They both look at her hand.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Petra.", "name": "CAL", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "I'm not letting go.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "I wouldn't ask you to.", "name": "CAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Below, a loudspeaker crackles.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Folks, we're working on it! Stay seated! Do not stand!", "name": "OPERATOR", "speaker": 3, "ext": ["V.O."], "paren": ["distant, bullhorn"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Cal cups his hands and calls down.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Take your time!", "name": "CAL", "speaker": 1, "ext": [], "paren": ["shouting"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "No, hurry up!", "name": "PETRA", "speaker": 0, "ext": [], "paren": ["shouting"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Take your time!", "name": "CAL", "speaker": 1, "ext": [], "paren": ["shouting"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Hurry up!", "name": "PETRA", "speaker": 0, "ext": [], "paren": ["shouting"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "They look at each other.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "And laugh.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "The laughter fades into a silence that feels different.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "I'm going to kiss you now.", "name": "CAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Don't you dare.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Why not?", "name": "CAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Because if you do, and they start the wheel, I'll miss it.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "You'll miss the kiss?", "name": "CAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "I'll miss the view. You'll be in front of it.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "He grins.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Sits back.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Both of them stare out over the gold-lit fair and the dark fields beyond it.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "It's pretty up here.", "name": "CAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "It is.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "The wheel shudders.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "Moves.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "Ah. There it goes.", "name": "CAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "Cal.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "Yes?", "name": "CAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "Now.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "He turns.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "She meets him halfway.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "The gondola begins its slow descent, and the generator coughs, and they ride down in a pool of golden light.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}]}