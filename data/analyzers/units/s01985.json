{"scene_id": "s01985", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01985.fountain", "heading": "INT. GREENHOUSE, BOTANICAL GARDEN - EARLY MORNING", "cast": [{"id": 0, "name": "IZABELA FONTANAROSA", "names": ["IZABELA FONTANAROSA", "IZABELA"], "gender": "f", "first": 4, "spoke": 24}, {"id": 1, "name": "ARSLAN DEMIRTA", "names": ["ARSLAN DEMIRTA", "ARSLAN"], "gender": "?", "first": 5, "spoke": 27}, {"id": 2, "name": "WELLS", "names": ["WELLS"], "gender": "?", "first": 5, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. GREENHOUSE, BOTANICAL GARDEN - EARLY MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Glass and iron.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fog on the panes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Banana palms, orchids dripping with condensation, a stone bench in a clearing of ferns.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "IZABELA FONTANAROSA (40s, garden curator, gardening gloves tucked in her belt, silver in her braid) sits on the bench with a thermos.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "ARSLAN DEMIRTA\u015e-WELLS (40s, visiting botanist, rain-damp coat, field notebook) stands in the doorway, dripping.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Is this the Victorian wing?", "name": "ARSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "It's the only wing.", "name": "IZABELA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Then I'm in the right place.", "name": "ARSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "You're wet.", "name": "IZABELA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I walked from the station.", "name": "ARSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "It's eleven miles.", "name": "IZABELA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "I like to walk.", "name": "ARSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "You like to make a point.", "name": "IZABELA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I like to make a point while walking.", "name": "ARSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "She pours a second cup from the thermos and sets it on the bench beside her.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "He crosses the clearing and sits.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Takes the cup.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Drinks.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Closes his eyes.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "That's not coffee.", "name": "ARSLAN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Chicory. I stopped drinking coffee the year you left.", "name": "IZABELA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "You hated coffee before I left.", "name": "ARSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "I hated how you made it.", "name": "IZABELA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "I made it with love.", "name": "ARSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "You made it with a blowtorch.", "name": "IZABELA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "The stove was broken.", "name": "ARSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "The stove was fine. You liked the blowtorch.", "name": "IZABELA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "It had personality.", "name": "ARSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "So did the smoke alarm.", "name": "IZABELA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "You kept that.", "name": "ARSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "I replace the battery every spring.", "name": "IZABELA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Why?", "name": "ARSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Because you'd have wanted me to.", "name": "IZABELA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "He puts the cup down.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Turns on the bench to face her.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Izabela, I got your letter about the orchid.", "name": "ARSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "The Paphiopedilum.", "name": "IZABELA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "The Paphiopedilum.", "name": "ARSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "It bloomed.", "name": "IZABELA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "After eleven years?", "name": "ARSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Eleven years, two months, nine days.", "name": "IZABELA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "You counted.", "name": "ARSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "I'm a curator. I count things.", "name": "IZABELA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "I'd like to see it.", "name": "ARSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "It's behind you.", "name": "IZABELA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "He turns.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Between two ferns, in a shaft of gray morning light, a slipper orchid hangs, mottled maroon and green.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "He stands.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Walks to it.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Touches nothing.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Oh.", "name": "ARSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Yes.", "name": "IZABELA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "It looks like you.", "name": "ARSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "Don't be absurd.", "name": "IZABELA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "Stubborn, and magnificent, and not at all pleased to see me.", "name": "ARSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "I'm pleased.", "name": "IZABELA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "You're not smiling.", "name": "ARSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "I'm smiling with my gloves on.", "name": "IZABELA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "Take them off.", "name": "ARSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "They're in my belt.", "name": "IZABELA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Then take them out.", "name": "ARSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "She laughs, and it surprises her.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "She stands and joins him at the orchid.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "They look at it together for a long time.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "Eleven years.", "name": "ARSLAN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "Two months, nine days.", "name": "IZABELA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "dialogue", "text": "I'd like to stay for the second bloom.", "name": "ARSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 68, "kind": "dialogue", "text": "That could take another eleven years.", "name": "IZABELA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 69, "kind": "dialogue", "text": "I walked eleven miles.", "name": "ARSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 70, "kind": "dialogue", "text": "You did.", "name": "IZABELA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 71, "kind": "dialogue", "text": "I can wait.", "name": "ARSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}