{"scene_id": "s01986", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01986.fountain", "heading": "INT. BONDED WAREHOUSE, WINE CELLAR LEVEL - NIGHT", "cast": [{"id": 0, "name": "LEONIE BARTHOLOMEW-ACHEBE", "names": ["LEONIE BARTHOLOMEW-ACHEBE", "LEONIE"], "gender": "f", "first": 4, "spoke": 12}, {"id": 1, "name": "NATE", "names": ["NATE"], "gender": "?", "first": 5, "spoke": 14}, {"id": 2, "name": "OBUYA", "names": ["OBUYA"], "gender": "?", "first": 5, "spoke": 0}, {"id": 3, "name": "DOROTHEA PRUITT-LANE", "names": ["DOROTHEA PRUITT-LANE", "DOROTHEA"], "gender": "?", "first": 6, "spoke": 11}, {"id": 4, "name": "MAXIMILIAN VOSS-KAGAN", "names": ["MAXIMILIAN VOSS-KAGAN", "MAXIMILIAN"], "gender": "?", "first": 7, "spoke": 11}], "units": [{"u": 0, "kind": "heading", "text": "INT. BONDED WAREHOUSE, WINE CELLAR LEVEL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Brick vaults, racks of dusty bottles in wooden crates.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single bare bulb.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Stairs lead up into darkness.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LEONIE BARTHOLOMEW-ACHEBE (30s, fraud investigator, leather satchel) kneels at a crate with a flashlight.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "NATHANIEL \"NATE\" OBUYA (40s, warehouse manager, lanyard) hovers behind her.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "DOROTHEA PRUITT-LANE (60s, private owner, silver cane) stands at the foot of the stairs.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "And leaning in the arch of the next vault, a bottle in his hand, is MAXIMILIAN VOSS-KAGAN (50s, collector, silk scarf).", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "These are labeled 1982.", "name": "LEONIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "They are 1982.", "name": "NATE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "The cork says 2014.", "name": "LEONIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Corks are replaced.", "name": "NATE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Not with a laser-etched date.", "name": "LEONIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Nathaniel, what is she talking about?", "name": "DOROTHEA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Mrs. Pruitt-Lane, it's a routine--", "name": "NATE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "It's not routine. Someone's been decanting new wine into old bottles.", "name": "LEONIE", "speaker": 0, "ext": [], "paren": ["over him"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "How very cinematic.", "name": "MAXIMILIAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Max, be quiet.", "name": "DOROTHEA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Dorothea, I'm only observing.", "name": "MAXIMILIAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "You told me they were authentic.", "name": "NATE", "speaker": 1, "ext": [], "paren": ["to Maximilian"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "They are authentic bottles.", "name": "MAXIMILIAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "You sold three hundred of them.", "name": "LEONIE", "speaker": 0, "ext": [], "paren": ["to Maximilian"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "I sold three hundred bottles of excellent wine.", "name": "MAXIMILIAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Of 1982.", "name": "DOROTHEA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Of excellent wine, Dorothea.", "name": "MAXIMILIAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "She's going to the police.", "name": "NATE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Nate, you're making it worse.", "name": "LEONIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Aren't you?", "name": "NATE", "speaker": 1, "ext": [], "paren": ["to Leonie"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Mrs. Pruitt-Lane, your name is on every certificate.", "name": "LEONIE", "speaker": 0, "ext": [], "paren": ["to Dorothea"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "My signature, yes.", "name": "DOROTHEA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Your signature authenticates every fake.", "name": "LEONIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "I authenticated what I was shown.", "name": "DOROTHEA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "She authenticated what she was told.", "name": "MAXIMILIAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "By who?", "name": "NATE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "By you, Nathaniel, you wrote the provenance.", "name": "MAXIMILIAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "You told me what to write!", "name": "NATE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Both of you.", "name": "DOROTHEA", "speaker": 3, "ext": [], "paren": ["sharply"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "A long silence.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "The bulb buzzes.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Somewhere above, a floorboard creaks.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Leonie lifts her flashlight toward the stairs.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Who else is here?", "name": "LEONIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "No one.", "name": "NATE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Just us.", "name": "MAXIMILIAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Don't lie, Max.", "name": "DOROTHEA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "The beam finds nothing, then a shadow moving on the wall.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Nobody move.", "name": "LEONIE", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "That's the cat.", "name": "MAXIMILIAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "We don't have a cat.", "name": "NATE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "We have a cat.", "name": "DOROTHEA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Since when?", "name": "NATE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "Since Tuesday. Nathaniel, you should read the memos.", "name": "DOROTHEA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "A clank from above.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "All four turn toward the stairs.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "Give me your phones. All of you.", "name": "LEONIE", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "Absolutely not.", "name": "MAXIMILIAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Give her yours, Max.", "name": "DOROTHEA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "Mine's dead.", "name": "NATE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "Then you're no use.", "name": "LEONIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "That's harsh.", "name": "NATE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "That's accurate.", "name": "MAXIMILIAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "Max, the phone.", "name": "DOROTHEA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "Maximilian sighs.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "Slides the phone across the stone.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "Leonie pockets it.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "Her flashlight flickers and dies.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "In the darkness, footsteps descend the stairs, heavy, unhurried.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "dialogue", "text": "That's not the cat.", "name": "NATE", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}]}