{"scene_id": "s01987", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01987.fountain", "heading": "INT. FARRYNER'S BAKEHOUSE, PUDDING LANE - NIGHT", "cast": [{"id": 0, "name": "THOMAS FARRYNER", "names": ["THOMAS FARRYNER", "THOMAS"], "gender": "m", "first": 6, "spoke": 9}, {"id": 1, "name": "EDMUND BRANDON", "names": ["EDMUND BRANDON", "EDMUND"], "gender": "m", "first": 7, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. FARRYNER'S BAKEHOUSE, PUDDING LANE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "September, 1666.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A low, smoke-blackened bakehouse.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Ovens glow.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Flour dust hangs in the air like fog.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Barrels, kneading troughs, a ladder to a loft.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "THOMAS FARRYNER (40s, baker, forearms scarred by decades of oven doors) rakes embers with an iron peel.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "A sleepy APPRENTICE named EDMUND BRANDON (14, flour in his hair) kneads a lump of dough on the trough.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Thomas straightens, wipes his brow, and looks at the oven mouth.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "A stray ember jumps out onto the floor.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He stamps it.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Another leaps.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He stamps again, then peels the oven door shut with his foot while Edmund turns, rubs his eyes, reaches for a rag, and misses the barrel behind him.", "para": 2, "sent": 4, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Mind the faggots, boy.", "name": "THOMAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Yes, Master.", "name": "EDMUND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Stacked too near.", "name": "THOMAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "They're always there.", "name": "EDMUND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "They're always there because I've never lit it this hot.", "name": "THOMAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Edmund looks at the oven.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "At his master.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "At the bundle of dry kindling heaped against the wall.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Master, it's very hot.", "name": "EDMUND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "It's the dry summer.", "name": "THOMAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "The thatch is hot too. I can feel it from here.", "name": "EDMUND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Thomas looks up.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "A thread of smoke is drifting out of a gap in the rafters.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "He climbs the ladder two rungs at a time.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Edmund grabs a bucket, dips it in the trough, and splashes the wall.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "It hisses.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Water! More!", "name": "THOMAS", "speaker": 0, "ext": [], "paren": ["from the loft"], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "There isn't more, Master. The trough is dough.", "name": "EDMUND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Then bring the ale!", "name": "THOMAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Edmund drags a barrel, tips it, lunges for the loft with the first pitcher full.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Thomas stamps at something in the straw.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "The barrel rolls across the floor.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Edmund slips on it, lands on his back, the pitcher still raised, not a drop spilled.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Boy!", "name": "THOMAS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Here, Master!", "name": "EDMUND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Thomas descends, lifts the boy by the collar, sets him on his feet, snatches the pitcher, and throws it up through the hatch.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "A hiss.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Orange light flares at the edge of the loft.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Both stare.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Out.", "name": "THOMAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "The bread!", "name": "EDMUND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Out, Edmund!", "name": "THOMAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "He shoves the boy toward the door and follows, and as they spill onto the street a bell begins to ring somewhere down the lane, one bell, then two.", "para": 7, "sent": 0, "present": [0, 1]}]}