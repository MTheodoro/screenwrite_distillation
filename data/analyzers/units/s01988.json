{"scene_id": "s01988", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01988.fountain", "heading": "INT. COURTHOUSE ELEVATOR, FOURTH FLOOR - DAY", "cast": [{"id": 0, "name": "DEPUTY DISTRICT ATTORNEY MARGUERITE OKWUOSA-HALE", "names": ["DEPUTY DISTRICT ATTORNEY MARGUERITE OKWUOSA-HALE", "MARGUERITE"], "gender": "f", "first": 3, "spoke": 17}, {"id": 1, "name": "PUBLIC DEFENDER TABITHA NGUYEN-FELLOWES", "names": ["PUBLIC DEFENDER TABITHA NGUYEN-FELLOWES", "TABITHA"], "gender": "f", "first": 4, "spoke": 16}, {"id": 2, "name": "MAINTENANCE", "names": ["MAINTENANCE"], "gender": "?", "first": 8, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. COURTHOUSE ELEVATOR, FOURTH FLOOR - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A dented steel box with a cracked mirror and a laminated placard: MAX OCCUPANCY 8.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The numbers above the door flicker.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "DEPUTY DISTRICT ATTORNEY MARGUERITE OKWUOSA-HALE (40s, charcoal suit, case files in both arms) stands in one corner.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "In the other corner, PUBLIC DEFENDER TABITHA NGUYEN-FELLOWES (30s, rumpled blazer, coffee) leans against the rail.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "The elevator shudders and stops between floors.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "The lights dim.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "A tiny speaker coughs.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Stuck on four. Hang tight, folks.", "name": "MAINTENANCE", "speaker": 2, "ext": ["V.O."], "paren": ["through the speaker"], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Marguerite sighs.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Tabitha sips her coffee.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Ms. Nguyen-Fellowes.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Ms. Okwuosa-Hale.", "name": "TABITHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "You filed a motion to suppress at six this morning.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I did.", "name": "TABITHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "You're supposed to file by five.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "The email server was down.", "name": "TABITHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "That's not my problem.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "It will be when the judge reads it.", "name": "TABITHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "She'll deny it.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "She'll hear it. She'll rule on the merits.", "name": "TABITHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Tabitha.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Marguerite.", "name": "TABITHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Your client's own phone placed him at the scene. You don't have the merits.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "My client's phone was seized without a warrant.", "name": "TABITHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "With consent.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "From his sister. Who doesn't live there.", "name": "TABITHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Marguerite's arms tighten around her files.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "A fluorescent tube flickers.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "She sets the files on the floor and kicks them into the corner.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "She lives there.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "What?", "name": "TABITHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Nothing.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "She said she moved out in June.", "name": "TABITHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "She said a lot of things.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Marguerite. Is there a lease?", "name": "TABITHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "That is not for me to discuss in a stuck elevator.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Then discuss it in the courtroom.", "name": "TABITHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "I will.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Good.", "name": "TABITHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "The elevator lurches.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Both of them grab the rail.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "The doors grind open onto the fifth floor.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Between them: a bare corridor, and light.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Okay, you're good.", "name": "MAINTENANCE", "speaker": 2, "ext": ["V.O."], "paren": ["through the speaker"], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Marguerite picks up her files.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Tabitha steps out first.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "After you.", "name": "TABITHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "You're holding the door.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Habit.", "name": "TABITHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "I'm asking you to hold it.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Tabitha holds it.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Marguerite steps through, stops, and for the first time looks at her directly.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "There's a lease. It's in the evidence box. Item thirty-one.", "name": "MARGUERITE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "You're telling me?", "name": "TABITHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "I'm telling the court. Shortly. You may as well know first.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "She walks down the corridor.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Tabitha lets the door close behind her and watches her go.", "para": 8, "sent": 1, "present": [0, 1, 2]}]}