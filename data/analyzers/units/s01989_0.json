{"scene_id": "s01989_0", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01989.fountain", "heading": "EXT. FLOODED RICE PADDY, VILLAGE EDGE - DAWN", "cast": [{"id": 0, "name": "CORPORAL VAUGHN DELACROIX-AMARI", "names": ["CORPORAL VAUGHN DELACROIX-AMARI", "VAUGHN"], "gender": "m", "first": 6, "spoke": 15}, {"id": 1, "name": "ZEKE", "names": ["ZEKE"], "gender": "m", "first": 7, "spoke": 14}, {"id": 2, "name": "TANAKA-OLUWOLE", "names": ["TANAKA-OLUWOLE"], "gender": "m", "first": 7, "spoke": 0}, {"id": 3, "name": "SERGEANT", "names": ["SERGEANT"], "gender": "m", "first": 8, "spoke": 14}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FLOODED RICE PADDY, VILLAGE EDGE - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A drowned field under pewter light.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Water to the knee, mud to the shin.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Smoke from burned huts drifts across a line of bamboo.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Distant artillery.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Three figures wade in single file.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "CORPORAL VAUGHN DELACROIX-AMARI (20s, helmet cocked, rifle held high) leads.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Behind him, PRIVATE EZEKIEL \"ZEKE\" TANAKA-OLUWOLE (19, pack too large) drags a wounded man on a poncho litter.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "The wounded man, a SERGEANT (50s, bearded, bandaged at the thigh), has his eyes shut.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Keep it low. Low.", "name": "VAUGHN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I am low.", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "You're not low, you're wet.", "name": "VAUGHN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "They're the same thing out here.", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "The Sergeant groans.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Zeke stops.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Vaughn turns, kneels, takes the Sergeant's wrist.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Lets it go.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Still with us.", "name": "VAUGHN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "How much farther?", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Treeline. Then the road.", "name": "VAUGHN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "You said the road an hour ago.", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "I said the road was past the paddy.", "name": "VAUGHN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "This is the paddy.", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Then we're past the paddy soon.", "name": "VAUGHN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "A burst of automatic fire from the north.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Water spouts around them.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Vaughn dives into the mud.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Zeke throws himself over the Sergeant.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "They lie there, all three, in the flooded field, faces half under.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "A bird takes off.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Vaughn lifts his head.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Zeke?", "name": "VAUGHN", "speaker": 0, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Yeah.", "name": "ZEKE", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "You okay?", "name": "VAUGHN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "I'm a cushion.", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "The Sergeant opens one eye.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Get off me.", "name": "SERGEANT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Sarge!", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "You're on my leg.", "name": "SERGEANT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Sorry! Sorry!", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Where's the road?", "name": "SERGEANT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Treeline.", "name": "VAUGHN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Quit saying treeline. Give me a direction.", "name": "SERGEANT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "East.", "name": "VAUGHN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "That's the Vietcong's east or ours?", "name": "SERGEANT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Ours.", "name": "VAUGHN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Then go that way.", "name": "SERGEANT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "They rise, crouching.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Zeke grabs the poncho.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Vaughn takes the other corner, and the two of them haul.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "The Sergeant bites back a cry.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Another burst of fire.", "para": 6, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "They duck, and the Sergeant clamps a hand over Zeke's mouth.", "para": 6, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Shut up, kid. That's a Pawnee.", "name": "SERGEANT", "speaker": 3, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "A what?", "name": "ZEKE", "speaker": 1, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "A Pawnee. It's one of ours. The twenty-three.", "name": "SERGEANT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "How do you know?", "name": "VAUGHN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "I've been shot by it.", "name": "SERGEANT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "The three of them listen.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "The firing is regular, rhythmic, and it's pointed away from them.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "They're clearing the treeline.", "name": "VAUGHN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "That's good, right?", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "Depends who's in the treeline.", "name": "SERGEANT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "They look at each other.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "The artillery thunders.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "Smoke drifts between them.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "Sarge, should I run?", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "Son, if you run in a paddy you'll sink to your knees.", "name": "SERGEANT", "speaker": 3, "ext": [], "paren": ["wearily"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "dialogue", "text": "We walk.", "name": "VAUGHN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "dialogue", "text": "Together.", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "dialogue", "text": "Together. And if anyone shoots at us, we die slowly, in the proper order.", "name": "SERGEANT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "Which is?", "name": "VAUGHN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "The youngest dies last. So he can see it.", "name": "SERGEANT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "dialogue", "text": "That's not funny.", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "dialogue", "text": "It wasn't a joke.", "name": "SERGEANT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "Silence.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "Zeke grabs his corner of the poncho.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "action", "text": "Vaughn grabs his.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "action", "text": "They haul, wading, as the sun comes up gray behind the smoke.", "para": 9, "sent": 3, "present": [0, 1, 2, 3]}]}