{"scene_id": "s01989_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01989.fountain", "heading": "EXT. TREELINE - CONTINUOUS", "cast": [{"id": 0, "name": "SERGEANT", "names": ["SERGEANT"], "gender": "?", "first": 6, "spoke": 3}, {"id": 1, "name": "VAUGHN", "names": ["VAUGHN"], "gender": "m", "first": 4, "spoke": 2}, {"id": 2, "name": "ZEKE", "names": ["ZEKE"], "gender": "m", "first": 12, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. TREELINE - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Ahead, a figure steps out from the bamboo, rifle raised.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A boy in a ragged shirt, no more than sixteen.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "All three stop.", "para": 1, "sent": 0, "present": []}, {"u": 4, "kind": "action", "text": "Vaughn lifts his rifle.", "para": 1, "sent": 1, "present": [1]}, {"u": 5, "kind": "action", "text": "The Sergeant lifts a hand.", "para": 1, "sent": 2, "present": [1]}, {"u": 6, "kind": "dialogue", "text": "Don't.", "name": "SERGEANT", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "He's armed.", "name": "VAUGHN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "So are we. Look at his face.", "name": "SERGEANT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "The boy's rifle shakes.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "His face is wet.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He says something in his own language, quiet, almost a question.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Zeke lowers his own rifle and holds up one open palm.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Hi.", "name": "ZEKE", "speaker": 2, "ext": [], "paren": ["gently"], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "The boy blinks.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Looks at the Sergeant.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "At the wounded leg.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "He lowers the rifle to his hip and turns, slowly, and points down the road.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Then he walks away into the bamboo.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "What was that?", "name": "VAUGHN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "A road.", "name": "SERGEANT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "They resume the haul.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "The artillery fades.", "para": 4, "sent": 1, "present": [0, 1, 2]}]}