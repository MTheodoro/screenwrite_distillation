{"scene_id": "s01990", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01990.fountain", "heading": "INT. WITNESS PREP ROOM, SUPERIOR COURT - DAY", "cast": [{"id": 0, "name": "ATTORNEY OCTAVIA BELLWEATHER-JIN", "names": ["ATTORNEY OCTAVIA BELLWEATHER-JIN", "OCTAVIA"], "gender": "?", "first": 5, "spoke": 16}, {"id": 1, "name": "SAMUEL IGWE-ROSENBERG", "names": ["SAMUEL IGWE-ROSENBERG", "SAMUEL"], "gender": "?", "first": 5, "spoke": 15}], "units": [{"u": 0, "kind": "heading", "text": "INT. WITNESS PREP ROOM, SUPERIOR COURT - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A windowless room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Steel table.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Two plastic chairs.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A water pitcher sweating on a tray.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ATTORNEY OCTAVIA BELLWEATHER-JIN (40s, severe bun) sits across from her witness, DR. SAMUEL IGWE-ROSENBERG (60s, forensic accountant, tie too tight).", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "She slides a folder across the table.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He doesn't open it.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Dr. Igwe-Rosenberg, tomorrow you take the stand.", "name": "OCTAVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I know.", "name": "SAMUEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Opposing counsel will ask about the ledger.", "name": "OCTAVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I know that too.", "name": "SAMUEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "And you'll say what?", "name": "OCTAVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "That the ledger is incomplete.", "name": "SAMUEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "No. You'll say it contains discrepancies that are consistent with accounting error.", "name": "OCTAVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "They are not consistent with accounting error.", "name": "SAMUEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "You'll say they are.", "name": "OCTAVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Ms. Bellweather-Jin, I have been a forensic accountant for thirty-one years.", "name": "SAMUEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Which is why they'll believe you.", "name": "OCTAVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Because I'll lie?", "name": "SAMUEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Because you'll be precise.", "name": "OCTAVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Precisely incorrect.", "name": "SAMUEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Precisely helpful.", "name": "OCTAVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "He pours water into a paper cup.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Holds it without drinking.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "What happens if I tell the truth?", "name": "SAMUEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Then my client loses.", "name": "OCTAVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "And if he deserves to?", "name": "SAMUEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "It isn't my job to decide that.", "name": "OCTAVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Then whose job is it?", "name": "SAMUEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "A jury's.", "name": "OCTAVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Who will rely on my testimony.", "name": "SAMUEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Who will rely on your credentials.", "name": "OCTAVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "They're the same thing.", "name": "SAMUEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Not in this room.", "name": "OCTAVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "He sets the cup down.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Pushes the folder back across the table unopened.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "I'll testify, Ms. Bellweather-Jin. But I'll say what the ledger says.", "name": "SAMUEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "She looks at him a long time.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Then she opens the folder, takes out a single page, and slides it to him.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Then say this.", "name": "OCTAVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "\"The ledger contains discrepancies. Their cause cannot be determined from the ledger alone.\"", "name": "SAMUEL", "speaker": 1, "ext": [], "paren": ["reading"], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Is that true?", "name": "OCTAVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "It's true.", "name": "SAMUEL", "speaker": 1, "ext": [], "paren": ["a pause"], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Then it's all I'm asking.", "name": "OCTAVIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "He folds the page in half, and in half again, and puts it in his breast pocket.", "para": 5, "sent": 0, "present": [0, 1]}]}