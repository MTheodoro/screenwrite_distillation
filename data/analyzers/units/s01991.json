{"scene_id": "s01991", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01991.fountain", "heading": "INT. OPEN-PLAN OFFICE, BEANBAG ZONE - DAY", "cast": [{"id": 0, "name": "FAMILY", "names": ["FAMILY"], "gender": "?", "first": 3, "spoke": 0}, {"id": 1, "name": "CASSIDY ROWE-ADEYEMI", "names": ["CASSIDY ROWE-ADEYEMI", "CASSIDY"], "gender": "?", "first": 5, "spoke": 7}, {"id": 2, "name": "BARNABY OKONJO-LIND", "names": ["BARNABY OKONJO-LIND", "BARNABY"], "gender": "m", "first": 5, "spoke": 5}, {"id": 3, "name": "DEZ", "names": ["DEZ"], "gender": "m", "first": 6, "spoke": 10}, {"id": 4, "name": "HARTWELL", "names": ["HARTWELL"], "gender": "?", "first": 6, "spoke": 0}, {"id": 5, "name": "VERONIKA SANDOVAL-BRIGHT", "names": ["VERONIKA SANDOVAL-BRIGHT", "VERONIKA"], "gender": "?", "first": 26, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. OPEN-PLAN OFFICE, BEANBAG ZONE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A startup floor painted in primary colors.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Ping-pong table.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A neon sign reads: WE'RE A FAMILY.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "Three beanbag chairs in a triangle around a kombucha tap.", "para": 0, "sent": 3, "present": [0]}, {"u": 5, "kind": "action", "text": "CASSIDY ROWE-ADEYEMI (30s, product manager, hoodie) and BARNABY OKONJO-LIND (30s, engineer, noise-canceling headphones around his neck) sit in beanbags.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "DESMOND \"DEZ\" HARTWELL (40s, Head of Culture, ironic vest) stands, clapping slowly.", "para": 1, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "dialogue", "text": "Team! Quick one! Pulse check!", "name": "DEZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "No.", "name": "CASSIDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Not now.", "name": "BARNABY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Just a quick pulse check on how we're all feeling about the pivot!", "name": "DEZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Cassidy flicks her eyes to Barnaby.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Barnaby lifts his headphones to his ears and drops them back on his neck.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Dez keeps clapping.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Dez, we pivoted in March.", "name": "CASSIDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Right!", "name": "DEZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "We pivoted again in June.", "name": "CASSIDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Right!", "name": "DEZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "We're pivoting back, aren't we.", "name": "BARNABY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "I can't speak to that.", "name": "DEZ", "speaker": 3, "ext": [], "paren": ["too quickly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "You just did.", "name": "BARNABY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Dez stops clapping.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Cassidy grabs the nearest cup of kombucha and drinks it in one pull.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Barnaby wriggles upright in his beanbag, which swallows him again.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Dez lunges to help, steps on a cable, and the ping-pong table's overhead lamp swings.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "They all duck.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "A woman in a tailored suit appears at the edge of the zone, a tablet cradled in one arm: VERONIKA SANDOVAL-BRIGHT (50s, investor, pearl studs, silver hair, no smile).", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Is this a bad time?", "name": "VERONIKA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Veronika! We were just aligning!", "name": "DEZ", "speaker": 3, "ext": [], "paren": ["too bright"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "On what?", "name": "VERONIKA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Vision!", "name": "DEZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Whose?", "name": "VERONIKA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Nobody speaks.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Cassidy and Barnaby look at their shoes.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Dez adjusts his vest.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Oh, boy.", "name": "BARNABY", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "I've reviewed the burn rate. We have six weeks of runway.", "name": "VERONIKA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "That's actually a positive!", "name": "DEZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "It is not a positive.", "name": "VERONIKA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Veronika, if I may.", "name": "CASSIDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "You may.", "name": "VERONIKA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "We've been building the wrong thing since March.", "name": "CASSIDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Dez gasps.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Barnaby stares at her.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Veronika's eyebrows rise a quarter inch.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Explain.", "name": "VERONIKA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "We pivoted to chase a market, but the customers wanted the original product. We never listened.", "name": "CASSIDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "Cass.", "name": "DEZ", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "It's true, Dez.", "name": "CASSIDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "It is true.", "name": "BARNABY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "Then why did no one say so?", "name": "VERONIKA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Dez opens his mouth, closes it, sits down in the third beanbag, and disappears into it up to his chest.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "The neon sign buzzes over his head.", "para": 7, "sent": 1, "present": [0, 1, 2, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "We're a family.", "name": "DEZ", "speaker": 3, "ext": [], "paren": ["small"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "Families go bankrupt, Desmond.", "name": "VERONIKA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "She taps her tablet.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "Then, to her own faint surprise, she lowers herself into the arm of Cassidy's beanbag and sets the tablet on her knee.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "Start from March.", "name": "VERONIKA", "speaker": 5, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}