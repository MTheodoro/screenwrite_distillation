{"scene_id": "s01992_0", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01992.fountain", "heading": "EXT. ICE CAVE MOUTH, GLACIER - DAY", "cast": [{"id": 0, "name": "HANNELORE BR", "names": ["HANNELORE BR", "HANNELORE"], "gender": "f", "first": 4, "spoke": 5}, {"id": 1, "name": "CKNER-ODUYA", "names": ["CKNER-ODUYA"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "GIDEON PEARCE-NAKAGAWA", "names": ["GIDEON PEARCE-NAKAGAWA", "GIDEON"], "gender": "m", "first": 5, "spoke": 3}, {"id": 3, "name": "INGRID SANDQVIST", "names": ["INGRID SANDQVIST"], "gender": "f", "first": 6, "spoke": 0}, {"id": 4, "name": "KWESI MENSAH-DUBOIS", "names": ["KWESI MENSAH-DUBOIS", "KWESI"], "gender": "?", "first": 7, "spoke": 3}, {"id": 5, "name": "TOBY", "names": ["TOBY"], "gender": "m", "first": 8, "spoke": 1}, {"id": 6, "name": "FERRANTE", "names": ["FERRANTE"], "gender": "?", "first": 8, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ICE CAVE MOUTH, GLACIER - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Blue-white walls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A tunnel of ice mouthing into a blizzard.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Five climbers huddle in the entrance, ropes tangled, one stove sputtering.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "HANNELORE BR\u00dcCKNER-ODUYA (40s, expedition leader, frost in her eyebrows).", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "GIDEON PEARCE-NAKAGAWA (30s, medic).", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "INGRID SANDQVIST (20s, photographer, camera under her jacket).", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "KWESI MENSAH-DUBOIS (30s, guide, bad knee).", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "TOBIAS \"TOBY\" FERRANTE (50s, client, wealthy, too many layers).", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 9, "kind": "action", "text": "A shriek of wind.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "action", "text": "The stove gutters.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "Rope up. Now.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "We just sat down.", "name": "TOBY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "We just stopped. It's not the same.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "Kwesi, how's the knee?", "name": "GIDEON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "It's fine.", "name": "KWESI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "It's not fine. I can see you limping.", "name": "GIDEON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "It's frozen, which is better than fine.", "name": "KWESI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "action", "text": "Ingrid takes a picture.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "action", "text": "Toby swats at the lens.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "action", "text": "She jerks the camera away, he grabs for it, the cord snaps around his wrist, and both topple sideways into Gideon, who lands on the stove.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "action", "text": "It goes out.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Oh, that's lovely.", "name": "GIDEON", "speaker": 2, "ext": ["CONT'D"], "paren": ["rolling away"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "Everybody up. Up!", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "Wind.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "action", "text": "A deep groan from the ice above.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "action", "text": "Powdered snow sifts down.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "They freeze, all five, heads tilted back.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "That's not wind.", "name": "KWESI", "speaker": 4, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "No.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "A crack, like a rifle shot.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "Hannelore bellows.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "Out! Everyone out!", "name": "HANNELORE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "They scatter in five directions, ropes whipping behind.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "Toby runs deeper into the cave.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "Ingrid sprints for the blizzard.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "Gideon drags Kwesi by the collar.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "Hannelore stands her ground a second longer than she should, then dives.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "The ice roof comes down in a roar.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "White.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "Silence.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}]}