{"scene_id": "s01992_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01992.fountain", "heading": "EXT. GLACIER SLOPE - CONTINUOUS", "cast": [{"id": 0, "name": "HANNELORE", "names": ["HANNELORE"], "gender": "f", "first": 1, "spoke": 2}, {"id": 1, "name": "HESTER VAN DER BERG-ACHEBE", "names": ["HESTER VAN DER BERG-ACHEBE", "HESTER"], "gender": "f", "first": 7, "spoke": 4}, {"id": 2, "name": "INGRID", "names": ["INGRID"], "gender": "f", "first": 1, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. GLACIER SLOPE - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Four figures crawl out of the powder: Hannelore, Gideon, Kwesi, Ingrid.", "para": 0, "sent": 0, "present": [0, 2]}, {"u": 2, "kind": "action", "text": "They count each other.", "para": 0, "sent": 1, "present": [0, 2]}, {"u": 3, "kind": "action", "text": "Count again.", "para": 0, "sent": 2, "present": [0, 2]}, {"u": 4, "kind": "dialogue", "text": "Where's Toby?", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 2]}, {"u": 5, "kind": "action", "text": "No answer.", "para": 1, "sent": 0, "present": [0, 2]}, {"u": 6, "kind": "action", "text": "The mouth of the cave is a wall of ice.", "para": 1, "sent": 1, "present": [0, 2]}, {"u": 7, "kind": "action", "text": "A figure steps out from behind a boulder, covered in snow, camera in hand, blinking.", "para": 2, "sent": 0, "present": [0, 2]}, {"u": 8, "kind": "action", "text": "It's HESTER VAN DER BERG-ACHEBE (30s, rescue ranger, orange parka, ice axe on her belt).", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "She's been tracking them.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Whose camera is this?", "name": "HESTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Mine.", "name": "INGRID", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "It was lying in the snow. Ten meters from the cave.", "name": "HESTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "I dropped it.", "name": "INGRID", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Then where's the man who was holding the strap?", "name": "HESTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "They all look at the wall of ice.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Hester unclips the axe, steps forward, and begins to chip.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "That's three meters of ice.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Then we'd better be quick.", "name": "HESTER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}