{"scene_id": "s01994", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01994.fountain", "heading": "INT. ABANDONED SUBWAY STATION, PLATFORM - NIGHT", "cast": [{"id": 0, "name": "ARVID SOLHEIM-MBEKI", "names": ["ARVID SOLHEIM-MBEKI", "ARVID"], "gender": "m", "first": 5, "spoke": 21}, {"id": 1, "name": "IRENE DUCASSE-ONYANGO", "names": ["IRENE DUCASSE-ONYANGO", "IRENE"], "gender": "f", "first": 6, "spoke": 11}, {"id": 2, "name": "LORCAN FITZGERALD-PARK", "names": ["LORCAN FITZGERALD-PARK", "LORCAN"], "gender": "?", "first": 7, "spoke": 11}, {"id": 3, "name": "TAMSIN VEL", "names": ["TAMSIN VEL", "TAMSIN"], "gender": "?", "first": 8, "spoke": 6}, {"id": 4, "name": "ZQUEZ-ROY", "names": ["ZQUEZ-ROY"], "gender": "?", "first": 8, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED SUBWAY STATION, PLATFORM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A ghost station, tiles cracked, an old clock stopped at 4:17.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single working fluorescent flickers over a table set with four chairs and a briefcase.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dust motes in the light.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The tunnel mouths gape on either side.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ARVID SOLHEIM-MBEKI (50s, gray overcoat, patient) sits with his hands folded on the briefcase.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Opposite him sits IRENE DUCASSE-ONYANGO (40s, tailored coat, burner phone face-down by her elbow).", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "At the table's end sits LORCAN FITZGERALD-PARK (30s, hoodie, jaw tight).", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "And standing in a tunnel mouth, half in shadow, arms folded, is TAMSIN VEL\u00c1ZQUEZ-ROY (30s, leather jacket, a stillness that makes the others look jumpy).", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Thank you for coming.", "name": "ARVID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "You gave us little choice.", "name": "IRENE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "I gave you a table. A chair. A briefcase.", "name": "ARVID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "A briefcase we haven't opened.", "name": "IRENE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Quite.", "name": "ARVID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Let's just open it.", "name": "LORCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Not yet.", "name": "ARVID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Why not yet?", "name": "LORCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Because once it's open, we are four people who have seen what is inside it. And we cannot be less than that again.", "name": "ARVID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Irene turns her phone face-up.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Checks the screen.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Turns it face-down.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Where is Tamsin sitting?", "name": "IRENE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "She prefers standing.", "name": "ARVID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "She's making me nervous.", "name": "IRENE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Good.", "name": "TAMSIN", "speaker": 3, "ext": [], "paren": ["from the tunnel"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Can we please just--", "name": "LORCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Lorcan. Do you remember the night of the fourteenth?", "name": "ARVID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "No.", "name": "LORCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Think.", "name": "ARVID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "I was at home.", "name": "LORCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Alone?", "name": "ARVID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Yes.", "name": "LORCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Irene, do you remember it?", "name": "ARVID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Vaguely.", "name": "IRENE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Where were you?", "name": "ARVID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "At the gallery.", "name": "IRENE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Until what hour?", "name": "ARVID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Late.", "name": "IRENE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "How late?", "name": "ARVID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "I don't see why this matters.", "name": "IRENE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "It matters because on the night of the fourteenth, a man named Dominic Ashworth was found at the bottom of a staircase. And none of us has ever said a word about it.", "name": "ARVID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "The fluorescent buzzes.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "The stopped clock watches.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "I didn't touch him.", "name": "LORCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "No one said you did.", "name": "ARVID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "I wasn't even there.", "name": "LORCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "No one said you were.", "name": "ARVID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Arvid, what is in the briefcase?", "name": "IRENE", "speaker": 1, "ext": [], "paren": ["too evenly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "A reason to be honest.", "name": "ARVID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Tamsin steps from the tunnel into the light.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "She walks to the table and puts a hand flat on the briefcase lid, next to Arvid's.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "It's his. Dominic's.", "name": "TAMSIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "His what?", "name": "LORCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "His record. Every payment. Every name.", "name": "TAMSIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "Who told you that?", "name": "IRENE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "He did. Before.", "name": "TAMSIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "Irene's hand goes still on the phone.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Lorcan leans forward.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "That's why you called us.", "name": "LORCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "That's why I called you.", "name": "ARVID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "To threaten us.", "name": "IRENE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "dialogue", "text": "To give you a choice. Open it, burn it, or walk away with it unopened and live as people who might someday regret that.", "name": "ARVID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "dialogue", "text": "That's three options.", "name": "LORCAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "dialogue", "text": "It's more than he got.", "name": "ARVID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "Nobody speaks.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "Irene reaches out, slowly, and rests her fingertips on the lock.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "action", "text": "Lorcan stands, chair scraping, and takes two steps back toward the stairs.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "dialogue", "text": "Lorcan.", "name": "TAMSIN", "speaker": 3, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "He stops.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "dialogue", "text": "Sit down.", "name": "TAMSIN", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "action", "text": "He sits.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "action", "text": "Irene presses the latch.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "action", "text": "It clicks.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "action", "text": "The lid lifts one inch.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "action", "text": "A light from inside spills across her face.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 76, "kind": "dialogue", "text": "There you are.", "name": "ARVID", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4]}]}