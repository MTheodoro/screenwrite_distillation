{"scene_id": "s01995", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01995.fountain", "heading": "INT. GLASSBLOWER'S FURNACE HALL, MURANO - NIGHT", "cast": [{"id": 0, "name": "MAESTRO ZUANNE BAROVIER-ADEYEMI", "names": ["MAESTRO ZUANNE BAROVIER-ADEYEMI", "ZUANNE"], "gender": "m", "first": 6, "spoke": 7}, {"id": 1, "name": "SERENELLA BAROVIER", "names": ["SERENELLA BAROVIER", "SERENELLA"], "gender": "f", "first": 6, "spoke": 3}, {"id": 2, "name": "ALVISE CONTARINI-DIAZ", "names": ["ALVISE CONTARINI-DIAZ", "ALVISE"], "gender": "f", "first": 8, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. GLASSBLOWER'S FURNACE HALL, MURANO - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Venice, 1740.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A low arched hall lit by the red mouth of a great furnace.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Racks of blowpipes.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Shelves of unfinished goblets glinting like frozen water.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The air shimmers with heat.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "MAESTRO ZUANNE BAROVIER-ADEYEMI (50s, leather apron, burned forearms) lifts a glowing gather of glass from the furnace on the end of a pipe.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Across the hall, his daughter SERENELLA BAROVIER (20, hair bound in a kerchief, steady hands) stands over a marver with a pair of jacks.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Between them, trembling in the heat, stands a young NOBLEMAN: ALVISE CONTARINI-DIAZ (25, velvet coat, silk stockings, wig askew), who has no business here at this hour.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Zuanne turns the pipe.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Serenella shapes the neck of a half-formed vase.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Alvise steps closer; she shifts her stance between him and her father without looking up.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "You are in my light, Signor.", "name": "ZUANNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "I beg your pardon, Maestro.", "name": "ALVISE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Move.", "name": "ZUANNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "I wish to speak to your daughter.", "name": "ALVISE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "She is working.", "name": "ZUANNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I will wait.", "name": "ALVISE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Serenella lowers her jacks.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Zuanne lowers the pipe.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "They look at each other across the hall, and then, as one, they look at Alvise.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Signor, it is not wise.", "name": "SERENELLA", "speaker": 1, "ext": [], "paren": ["together"], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Signor, it is not wise.", "name": "ZUANNE", "speaker": 0, "ext": [], "paren": ["together"], "dual": true, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Alvise swallows.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Then, with great ceremony, he goes down on one knee in the glassworks sawdust.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "The furnace roars.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Maestro. I ask for your daughter's hand.", "name": "ALVISE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Zuanne's gather falls from the pipe and shatters on the stone in a spray of molten glass.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Serenella drops the jacks.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Alvise throws an arm over his face.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "They all scramble back as the glass pools and cools and goes opaque.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "A long one.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "You proposed in a glassworks.", "name": "ZUANNE", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "It seemed the honest place.", "name": "ALVISE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "You could have asked in the church.", "name": "SERENELLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "I asked in the church. Your father's apprentice said you were here.", "name": "ALVISE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "I am always here.", "name": "SERENELLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "I know. It is why I love you.", "name": "ALVISE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Serenella looks at her father.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Zuanne looks at the floor, at the dark ruin of his gather.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "His mouth works.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Then he picks up a new pipe and walks to the furnace and thrusts it in.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Hold the door.", "name": "ZUANNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Maestro?", "name": "ALVISE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "If you wish to marry my daughter, you will learn to hold the door.", "name": "ZUANNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Alvise scrambles up.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Serenella almost smiles.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "He takes the iron handle of the furnace door, and the heat strikes his face, and he does not let go.", "para": 8, "sent": 2, "present": [0, 1, 2]}]}