{"scene_id": "s01997", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s01997.fountain", "heading": "INT. MOBILE FIELD HOSPITAL TENT, FLOOD ZONE - NIGHT", "cast": [{"id": 0, "name": "AMARACHI NWOSU-BELLINGHAM", "names": ["AMARACHI NWOSU-BELLINGHAM", "AMARACHI"], "gender": "f", "first": 6, "spoke": 8}, {"id": 1, "name": "NURSE FELIPE ARRIAGA-TOMLINSON", "names": ["NURSE FELIPE ARRIAGA-TOMLINSON", "FELIPE"], "gender": "m", "first": 7, "spoke": 4}, {"id": 2, "name": "TESS KOWALEWSKI-AMADI", "names": ["TESS KOWALEWSKI-AMADI", "TESS"], "gender": "f", "first": 8, "spoke": 4}, {"id": 3, "name": "DISPATCH", "names": ["DISPATCH"], "gender": "?", "first": 10, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. MOBILE FIELD HOSPITAL TENT, FLOOD ZONE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Canvas walls snapping in wind.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Generators outside.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Cots in rows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Bags of IV fluid hang from tent poles.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Mud on every surface.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "DR. AMARACHI NWOSU-BELLINGHAM (40s, surgeon, scrubs under a poncho) kneels over a cot where a boy lies unconscious.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "NURSE FELIPE ARRIAGA-TOMLINSON (30s, glasses fogged, stethoscope slipping) squeezes a bag-valve mask.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "A volunteer, TESS KOWALEWSKI-AMADI (20s, Red Cross vest, hands shaking), holds a flashlight.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "A radio on a crate squawks.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Field Two, Dispatch. Evacuation convoy is delayed. Repeat, convoy delayed. Estimate ninety minutes.", "name": "DISPATCH", "speaker": 3, "ext": ["V.O."], "paren": ["over radio, static"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Tess, hold the light steady.", "name": "AMARACHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "I'm trying.", "name": "TESS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Try harder.", "name": "AMARACHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Felipe squeezes the bag.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "The boy's chest rises.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Falls.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Amarachi puts two fingers to the boy's throat, and her face closes.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "She looks at Felipe.", "para": 2, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "He sees it.", "para": 2, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "His squeezing slows, then resumes, faster.", "para": 2, "sent": 6, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Doctor, we have a rhythm.", "name": "FELIPE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "We don't.", "name": "AMARACHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "We have a pulse.", "name": "FELIPE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "We have a monitor reading its own noise.", "name": "AMARACHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Tess lowers the flashlight; Amarachi grabs her wrist and raises it again.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Felipe bends over the boy and begins compressions, counting under his breath.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "The radio squawks.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Tess jumps.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "The light swings across the tent roof, over the rows of cots, over a woman in the corner who has turned to watch.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Field Two, confirm receipt.", "name": "DISPATCH", "speaker": 3, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Should I answer?", "name": "TESS", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Answer.", "name": "AMARACHI", "speaker": 0, "ext": [], "paren": ["without looking"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Tess scrambles to the radio, still holding the flashlight, and keys the mic with her elbow.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Dispatch, Field Two. Copy. Ninety minutes.", "name": "TESS", "speaker": 2, "ext": [], "paren": ["into radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Field Two, how many critical?", "name": "DISPATCH", "speaker": 3, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Tess looks at the boy.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "At Felipe, pumping the small chest.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "At Amarachi, her fingers still on the throat.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "One. Maybe zero.", "name": "TESS", "speaker": 2, "ext": [], "paren": ["into radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Amarachi sits back on her heels.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Felipe stops compressions.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "He wipes his glasses on his sleeve, puts them back, and looks at her.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Time?", "name": "FELIPE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Eleven forty-one.", "name": "AMARACHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "I'll write it down.", "name": "FELIPE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "I'll write it.", "name": "AMARACHI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "She stands, steadies herself on a pole, and crosses to the radio.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Takes the mic from Tess, who gives it up like a hot pan.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Dispatch, Field Two. Patient expired. Eleven forty-one. Send the convoy anyway. We have eleven more.", "name": "AMARACHI", "speaker": 0, "ext": ["CONT'D"], "paren": ["into radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Copy, Field Two. We're sending it.", "name": "DISPATCH", "speaker": 3, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "She sets the mic down very gently on the crate.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Tess hands her a clipboard.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Her hand is steady now.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}]}