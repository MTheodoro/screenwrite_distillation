{"scene_id": "s02000_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02000.fountain", "heading": "INT. CHILD'S BEDROOM - CONTINUOUS", "cast": [{"id": 0, "name": "BOY", "names": ["BOY"], "gender": "m", "first": 2, "spoke": 1}, {"id": 1, "name": "OLD MAN", "names": ["OLD MAN"], "gender": "m", "first": 12, "spoke": 3}, {"id": 2, "name": "WREN", "names": ["WREN"], "gender": "f", "first": 4, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. CHILD'S BEDROOM - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "A narrow room with a toy chest and a narrow bed.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A small BOY (6, pajamas, eyes wide) sits upright in the blankets, clutching a stuffed rabbit.", "para": 0, "sent": 1, "present": [0]}, {"u": 3, "kind": "dialogue", "text": "Mommy, he was in my closet.", "name": "BOY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 4, "kind": "action", "text": "Wren crouches.", "para": 1, "sent": 0, "present": [0, 2]}, {"u": 5, "kind": "action", "text": "The boy buries his face in her robe.", "para": 1, "sent": 1, "present": [0, 2]}, {"u": 6, "kind": "action", "text": "Behind them, in the doorway, the figure appears.", "para": 1, "sent": 2, "present": [0, 2]}, {"u": 7, "kind": "action", "text": "Its shadow falls across both.", "para": 1, "sent": 3, "present": [0, 2]}, {"u": 8, "kind": "action", "text": "The figure steps forward and for the first time the moonlight catches its face.", "para": 2, "sent": 0, "present": [0, 2]}, {"u": 9, "kind": "action", "text": "It's an old man.", "para": 2, "sent": 1, "present": [0, 2]}, {"u": 10, "kind": "action", "text": "Her father.", "para": 2, "sent": 2, "present": [0, 2]}, {"u": 11, "kind": "action", "text": "Wet-eyed, bewildered, in the wrong house.", "para": 2, "sent": 3, "present": [0, 2]}, {"u": 12, "kind": "dialogue", "text": "Wren?", "name": "OLD MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Dad.", "name": "WREN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I couldn't find the stairs.", "name": "OLD MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "She stands, still holding the boy.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Her flashlight clatters to the floor, rolling in a slow circle.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "It's all right.", "name": "WREN", "speaker": 2, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "I thought it was the other house.", "name": "OLD MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I know.", "name": "WREN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "She extends her free hand.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "He takes it.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "The boy peeks out from her robe and, with great solemnity, holds out the stuffed rabbit to his grandfather.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "The clock chimes midnight.", "para": 5, "sent": 0, "present": [0, 1, 2]}]}