{"scene_id": "s02001", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02001.fountain", "heading": "INT. LISTENING POST, CHALK TUNNEL UNDER A COASTAL RIDGE - NIGHT", "cast": [{"id": 0, "name": "CAPTAIN ELSPETH MORRIGAN-ADEWALE", "names": ["CAPTAIN ELSPETH MORRIGAN-ADEWALE", "ELSPETH"], "gender": "f", "first": 5, "spoke": 14}, {"id": 1, "name": "LIEUTENANT BASTIAN OKOYE-LINDGREN", "names": ["LIEUTENANT BASTIAN OKOYE-LINDGREN", "BASTIAN"], "gender": "m", "first": 6, "spoke": 7}, {"id": 2, "name": "GUS", "names": ["GUS"], "gender": "m", "first": 7, "spoke": 7}, {"id": 3, "name": "PELLETIER-ONUOHA", "names": ["PELLETIER-ONUOHA"], "gender": "?", "first": 7, "spoke": 0}, {"id": 4, "name": "COMMANDER", "names": ["COMMANDER"], "gender": "?", "first": 25, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. LISTENING POST, CHALK TUNNEL UNDER A COASTAL RIDGE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A narrow chalk-white tunnel shored with timber.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Hurricane lamps hang from nails.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "At a plank table, a radio set glows green, headphones draped over its dial.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The sea is a dull pulse in the rock.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CAPTAIN ELSPETH MORRIGAN-ADEWALE (40s, wool greatcoat, tin mug between both palms) sits with her back to the wall, eyes on the radio.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Opposite her, a field cot, and on it LIEUTENANT BASTIAN OKOYE-LINDGREN (20s, collar open, a letter half-written on his knee).", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "A third man, SERGEANT AUGUSTIN \"GUS\" PELLETIER-ONUOHA (30s, signal corps, headphones on), is bent over the set with a pencil.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "For an hour nothing has come over the wire.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "The three of them have the look of people who have stopped expecting it to.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Gus, anything?", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Static, ma'am.", "name": "GUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Same static as before?", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Same. Pretty one.", "name": "GUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Pretty static. I'll tell Mother.", "name": "BASTIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Lieutenant, the letter.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Captain?", "name": "BASTIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Don't write that last page until morning.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "He looks at her.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Folds the page once, and tucks it into his breast pocket with ceremony.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Yes, ma'am.", "name": "BASTIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "The radio gives a click.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "A long, dry hiss.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Gus freezes, one finger raised.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Elspeth sets down her mug without making a sound.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Hawk Nest, Hawk Nest, this is Tower. Do you read?", "name": "COMMANDER", "speaker": 4, "ext": ["V.O."], "paren": ["through the headphones, loud enough to leak"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Tower, Hawk Nest. Loud and clear.", "name": "GUS", "speaker": 2, "ext": [], "paren": ["into mic"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Hawk Nest, stand by for orders.", "name": "COMMANDER", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Orders, ma'am.", "name": "GUS", "speaker": 2, "ext": [], "paren": ["to Elspeth"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "I heard.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "She stands, takes the headphones from Gus, and settles them on her ears.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Tower, Hawk Nest. Captain Morrigan-Adewale speaking.", "name": "ELSPETH", "speaker": 0, "ext": ["CONT'D"], "paren": ["into mic"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Captain, the ridge is to be vacated by oh-four-hundred.", "name": "COMMANDER", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Repeat, Tower?", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": ["a beat"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Vacate by oh-four-hundred. Demolition charges on the tunnel mouth. Acknowledge.", "name": "COMMANDER", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Gus looks at Bastian.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Bastian looks at Elspeth.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Tower, we have a signal watch of seven hours remaining.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": ["into mic"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Captain, the watch is cancelled. The enemy has taken the eastern shore.", "name": "COMMANDER", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "But it's calm.", "name": "BASTIAN", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Too calm.", "name": "GUS", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Understood, Tower. Hawk Nest will withdraw.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": ["into mic"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "She pulls the headphones off.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "The tunnel is quiet.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "The sea thumps against the cliff, faint, constant.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Gentlemen. Pack the set. Leave the tin.", "name": "ELSPETH", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "Ma'am, the tin has the codebooks.", "name": "GUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Then burn the codebooks first.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "And the letters?", "name": "BASTIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Take your letters.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Bastian hesitates.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Takes his letter from his pocket.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Holds it out to her.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "Captain, would you post it?", "name": "BASTIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "I'll try.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Thank you.", "name": "BASTIAN", "speaker": 1, "ext": [], "paren": ["together"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "Thank you.", "name": "GUS", "speaker": 2, "ext": [], "paren": ["together"], "dual": true, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Both stop.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "Gus looks at his pencil.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "Bastian looks at his boots.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "Let's go.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "She takes the lamp from its nail, and the three of them step into the dark of the tunnel mouth, where, beyond the ridge, a faint red line is beginning to rise out of the sea.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}]}