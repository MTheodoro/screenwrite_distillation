{"scene_id": "s02002", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02002.fountain", "heading": "INT. PAWNSHOP BACK ROOM, DOWNTOWN - NIGHT", "cast": [{"id": 0, "name": "SOLOMON KAPLAN-ADEBAYO", "names": ["SOLOMON KAPLAN-ADEBAYO", "SOLOMON"], "gender": "m", "first": 4, "spoke": 16}, {"id": 1, "name": "NADIA KAPLAN", "names": ["NADIA KAPLAN", "NADIA"], "gender": "f", "first": 4, "spoke": 12}, {"id": 2, "name": "ELIJAH OSEI-MARCHETTI", "names": ["ELIJAH OSEI-MARCHETTI", "ELIJAH"], "gender": "?", "first": 6, "spoke": 4}, {"id": 3, "name": "UNCLE RUBEN", "names": ["UNCLE RUBEN", "RUBEN"], "gender": "?", "first": 7, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. PAWNSHOP BACK ROOM, DOWNTOWN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped room of glass cases and hanging guitars.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single desk, a green banker's lamp, a safe in the corner.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain beads the barred window.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SOLOMON KAPLAN-ADEBAYO (60s, shirtsleeves, suspenders, spectacles on a chain) sits behind the desk counting bills.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Across from him, perched on a stool, sits his daughter NADIA KAPLAN (30s, trench coat, wet hair), who has come in from the rain and not yet taken her coat off.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "By the door, hat in hands, shifts a young man: ELIJAH OSEI-MARCHETTI (20s, work jacket, wedding ring still new).", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "At the safe, crouched with his back to them all, a fourth figure: UNCLE RUBEN (70s, cardigan, thick glasses), who has been sorting the same papers for ten minutes.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Nadia, you're dripping on the floor.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "I came to talk, Papa.", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Talk. I'm listening.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Not with him in the room.", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Elijah shifts.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Solomon rubs his eyes under the spectacles, sets down the bills, and lifts his chin at the door; Elijah sets his hat on a guitar case, then thinks better and picks it up again; Ruben turns from the safe, slow as a tortoise, and glances from face to face, then goes back to the papers.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Nadia stands, takes a step toward her father, then retreats a step, and finally unbuttons the coat as if it's a decision she's been postponing for years.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "The shop is losing money.", "name": "NADIA", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "The shop has always lost money.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Not like this.", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Who told you?", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "The books.", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "You looked at my books?", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Papa, I've been doing your books for five years.", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Then you know the shop is losing money.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "And you've known it's been losing more.", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Solomon says nothing.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Ruben drops a paper.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Mr. Kaplan, if I may--", "name": "ELIJAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "You may not.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "I'd like to help.", "name": "ELIJAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "You'd like to marry my daughter and inherit a debt.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "I already married her.", "name": "ELIJAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Congratulations. Now pick up that hat.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Elijah picks up the hat from the guitar case.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Nadia sets her coat on the desk, crosses her arms, and speaks very low.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "The loan is due Friday.", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "What loan?", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "The one you didn't tell me about.", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Solomon takes off his spectacles.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Folds them.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Sets them on the bills.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Shlomo. Tell her.", "name": "RUBEN", "speaker": 3, "ext": [], "paren": ["from the safe, gently"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Ruben.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Tell her about the guitar.", "name": "RUBEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "What guitar?", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "The Gibson. In the back. The one you've been guarding.", "name": "RUBEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Nadia's head swivels to the cases.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "A sunburst Gibson, hanging half-hidden behind a banjo.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "What about it?", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "It's not mine.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Whose is it?", "name": "NADIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "It belongs to a man who didn't come back for it.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "How long?", "name": "ELIJAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Thirty-one years.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Silence.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Rain on the window.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Ruben closes the safe with a soft click.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Papa. What's it worth?", "name": "NADIA", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "More than the shop.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3]}]}