{"scene_id": "s02003", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02003.fountain", "heading": "EXT. RAILWAY BRIDGE OVER A DRY RIVER, THE BORDER - DAWN", "cast": [{"id": 0, "name": "SERGEANT KASIMIR OYELARAN-TREMBLAY", "names": ["SERGEANT KASIMIR OYELARAN-TREMBLAY", "KASIMIR"], "gender": "m", "first": 5, "spoke": 23}, {"id": 1, "name": "VARGAS-DUBOIS", "names": ["VARGAS-DUBOIS"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "PRIVATE JABARI NKRUMAH-LEIGH", "names": ["PRIVATE JABARI NKRUMAH-LEIGH", "JABARI"], "gender": "m", "first": 7, "spoke": 6}, {"id": 3, "name": "IN\u00c9S", "names": ["IN\u00c9S"], "gender": "f", "first": 6, "spoke": 14}], "units": [{"u": 0, "kind": "heading", "text": "EXT. RAILWAY BRIDGE OVER A DRY RIVER, THE BORDER - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A steel truss bridge, half-collapsed, spanning a river that has been dry since the drought.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sand and cracked clay below.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Ahead, a checkpoint of sandbags, flags drooping, a rusted jeep.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Three soldiers lie prone on the east approach, covered by a torn tarp.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "SERGEANT KASIMIR OYELARAN-TREMBLAY (40s, desert scarf, sunburned neck) peers through binoculars.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Next to him, CORPORAL IN\u00c9S VARGAS-DUBOIS (20s, a long rifle, a patient eye) sights down her scope.", "para": 1, "sent": 2, "present": [0, 1, 3]}, {"u": 7, "kind": "action", "text": "Behind them, PRIVATE JABARI NKRUMAH-LEIGH (19, radioman, pack heavy with coiled wire) sweats.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Four at the checkpoint. Two on the jeep.", "name": "KASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Three on the jeep.", "name": "IN\u00c9S", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Show me.", "name": "KASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Left side. Under the canopy.", "name": "IN\u00c9S", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Three.", "name": "KASIMIR", "speaker": 0, "ext": [], "paren": ["adjusting"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Is that good or bad, Sergeant?", "name": "JABARI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "It's three.", "name": "KASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "The sun rises over the far bank, turning the dry river the color of a bruise.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "A flag stirs.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Nothing else does.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Jabari, get the wire out.", "name": "KASIMIR", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Sergeant, the wire's for the radio.", "name": "JABARI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "It's for the bridge.", "name": "KASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "I'm sorry?", "name": "JABARI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "We're not talking to anyone, son. We're taking out the bridge.", "name": "KASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "That's not what the briefing said.", "name": "IN\u00c9S", "speaker": 3, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "The briefing's three days old.", "name": "KASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "It said observe.", "name": "IN\u00c9S", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Observe, report. And if the enemy advances in force, deny the crossing.", "name": "KASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "There's no force. There's seven men and a jeep.", "name": "IN\u00c9S", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Seven now.", "name": "KASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "He lowers the binoculars.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "A pale line of dust is rising from the horizon beyond the checkpoint, thin and straight.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "What's that?", "name": "JABARI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Armor.", "name": "KASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "How many?", "name": "IN\u00c9S", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Enough.", "name": "KASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Jabari begins to unspool the wire, hands shaking.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "In\u00e9s shifts her rifle and watches the dust.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Kasimir drags a pack beside him and opens it.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Inside, two bricks of plastic explosive, a blasting cap, a roll of tape.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Is the bridge empty?", "name": "JABARI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "It is.", "name": "KASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Are you sure?", "name": "JABARI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Check the girders.", "name": "KASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Jabari glances at In\u00e9s.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "She nods.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "He slithers out from under the tarp and crawls along the rail toward the first abutment, wire trailing behind him in the sand.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Kasimir watches him go.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "In\u00e9s keeps her eye on the checkpoint.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Sergeant, there are people on the jeep.", "name": "IN\u00c9S", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Soldiers.", "name": "KASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "There's a child.", "name": "IN\u00c9S", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Where?", "name": "KASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "On the back seat. Under the tarp.", "name": "IN\u00c9S", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Kasimir takes the binoculars back up.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Adjusts.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "His jaw tightens.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Damn it.", "name": "KASIMIR", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "Sergeant?", "name": "IN\u00c9S", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "Hold your fire, Corporal.", "name": "KASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "I wasn't going to fire.", "name": "IN\u00c9S", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "Then hold the child.", "name": "KASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "What?", "name": "IN\u00c9S", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "Hold her in your sights. If the armor reaches the checkpoint and she's still there, we don't blow the bridge. We wait.", "name": "KASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "How long?", "name": "IN\u00c9S", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "Until she leaves.", "name": "KASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "Out on the bridge, Jabari has reached the abutment.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "He glances back, and Kasimir raises a flat hand: stop.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "Jabari freezes.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "The wire lies slack across the sand between them.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "The dust cloud grows.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "A low rumble now.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "The flags begin to tremble.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "They're not going to wait for her.", "name": "IN\u00c9S", "speaker": 3, "ext": [], "paren": ["very quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "No.", "name": "KASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "He puts the binoculars down.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "Reaches into the pack.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "Picks up the blasting cap and turns it over, then sets it back in the foam.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "dialogue", "text": "Jabari. Come back.", "name": "KASIMIR", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "action", "text": "Jabari scrambles back along the rail, grabbing the wire as he goes.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "action", "text": "The rumble becomes engines.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "action", "text": "A line of tanks emerges from the dust, small and steady, rolling toward the bridge.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "action", "text": "In\u00e9s lowers her rifle.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "action", "text": "Kasimir gathers the pack.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "action", "text": "The three of them slide back down the embankment and lie flat under the tarp as the first tank rolls onto the span, and the bridge groans, and holds.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}]}