{"scene_id": "s02004", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02004.fountain", "heading": "INT. MILL OWNER'S PARLOR, LANCASHIRE - NIGHT", "cast": [{"id": 0, "name": "EZEKIEL HARGREAVES-OLUWASEUN", "names": ["EZEKIEL HARGREAVES-OLUWASEUN"], "gender": "?", "first": 5, "spoke": 0}, {"id": 1, "name": "ABIGAIL HARGREAVES", "names": ["ABIGAIL HARGREAVES", "HARGREAVES", "ABIGAIL"], "gender": "f", "first": 5, "spoke": 30}, {"id": 2, "name": "YOUNG WEAVER", "names": ["YOUNG WEAVER"], "gender": "?", "first": 7, "spoke": 2}, {"id": 3, "name": "TOM", "names": ["TOM"], "gender": "?", "first": 9, "spoke": 12}], "units": [{"u": 0, "kind": "heading", "text": "INT. MILL OWNER'S PARLOR, LANCASHIRE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "1842.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A rich, close room with a coal fire.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Heavy curtains, a horsehair sofa, a mahogany sideboard.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The clatter of the mill beyond the wall never stops.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MR. EZEKIEL HARGREAVES-OLUWASEUN (50s, black frock coat, gold watch chain) stands at the fire with his back to the room.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "His wife, ABIGAIL HARGREAVES (40s, plum silk, a sewing basket in her lap), sits on the sofa working a needle.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Before them, standing very straight with his cap crushed in both hands, is a young man from the mill floor: a YOUNG WEAVER (20s, thin, clogs, flax-colored hair).", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Your name?", "name": "HARGREAVES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Tom, sir.", "name": "YOUNG WEAVER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Tom what?", "name": "HARGREAVES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Tom Aldous, sir.", "name": "YOUNG WEAVER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "And you are here to complain.", "name": "HARGREAVES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "I'm here to ask, sir.", "name": "TOM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Ask what?", "name": "HARGREAVES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "That the looms be stopped for an hour at noon.", "name": "TOM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Why?", "name": "HARGREAVES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "So we can eat, sir.", "name": "TOM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Abigail's needle pauses.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "She doesn't look up.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "You eat at the bench.", "name": "HARGREAVES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "We can't, sir. The dust.", "name": "TOM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Then you eat in the yard.", "name": "HARGREAVES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "There's no yard, sir. There's the canal.", "name": "TOM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Then you eat on the canal.", "name": "HARGREAVES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "That's not a joke, sir?", "name": "TOM", "speaker": 3, "ext": [], "paren": ["a beat"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Mr. Aldous, I do not joke.", "name": "HARGREAVES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Ezekiel.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Abigail, this is not the moment.", "name": "HARGREAVES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "It is exactly the moment.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "She sets down her needle.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Stands.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "The firelight catches the gold at her throat.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Mr. Aldous, how many hours do you work?", "name": "ABIGAIL", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Fourteen, ma'am.", "name": "TOM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "And how many weavers are there?", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Two hundred and forty, ma'am.", "name": "TOM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "And they all want the same thing?", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "They do.", "name": "TOM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Abigail, sit down.", "name": "HARGREAVES", "speaker": 1, "ext": [], "paren": ["together"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Ezekiel, the man is asking for an hour.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": ["together"], "dual": true, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Their voices cross.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Hargreaves breaks first, turns to the fire, and stares into it.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "An hour a day at two hundred and forty hands is a significant loss.", "name": "HARGREAVES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Is it more than you spent on that clock?", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Abigail.", "name": "HARGREAVES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "The one in the hall. Eighty guineas.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "It keeps accurate time.", "name": "HARGREAVES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "So does the mill whistle.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Tom stares at the carpet.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "The mill clatters through the wall.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "The fire pops.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Mr. Aldous.", "name": "HARGREAVES", "speaker": 1, "ext": [], "paren": ["at last"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Sir.", "name": "TOM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Return to your loom. Tell the others there will be no stoppage.", "name": "HARGREAVES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Sir--", "name": "TOM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "But tomorrow, at noon, bring out your bread and we shall see what the dust does to it.", "name": "HARGREAVES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "Sir?", "name": "TOM", "speaker": 3, "ext": [], "paren": ["stunned"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "Out, Mr. Aldous.", "name": "HARGREAVES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "Tom bows awkwardly and backs out.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "The door closes behind him.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "Abigail lowers herself onto the sofa, picks up the needle, and begins to stitch again with great care.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "Hargreaves turns from the fire and looks at her for a long moment.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "That clock was a mistake.", "name": "HARGREAVES", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "It was a very good clock.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "It was.", "name": "HARGREAVES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}