{"scene_id": "s02005", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02005.fountain", "heading": "EXT. ROCK LEDGE ABOVE A FROZEN RIVER, YUKON - DUSK", "cast": [{"id": 0, "name": "OLE BRANDVOLD-ACHEBE", "names": ["OLE BRANDVOLD-ACHEBE", "OLE"], "gender": "?", "first": 5, "spoke": 19}, {"id": 1, "name": "PEARL TSOSIE-HARLOW", "names": ["PEARL TSOSIE-HARLOW", "PEARL"], "gender": "?", "first": 6, "spoke": 19}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ROCK LEDGE ABOVE A FROZEN RIVER, YUKON - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "A narrow shelf of granite thirty feet over the ice.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Spruce stunted by wind.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Snow in drifts.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A fire of three damp sticks, hardly burning.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "OLE BRANDVOLD-ACHEBE (60s, trapper, a beard crusted white, wolf-fur hood) crouches over the fire with a tin cup.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Next to him, wrapped in a wool blanket, sits PEARL TSOSIE-HARLOW (20s, surveyor, red nose, a compass hung on a cord).", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Between them, a pot of water that refuses to boil.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Is it going to boil?", "name": "PEARL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Eventually.", "name": "OLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "When?", "name": "PEARL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "When it's ready.", "name": "OLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She tucks her blanket tighter.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Ole prods the fire with a stick.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Three days.", "name": "PEARL", "speaker": 1, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "What's that?", "name": "OLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Nothing. Counting.", "name": "PEARL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Counting what?", "name": "OLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Days since we left the cabin.", "name": "PEARL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Four.", "name": "OLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "It was three.", "name": "PEARL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "It was four. You lost one in the whiteout.", "name": "OLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "I don't remember a whiteout.", "name": "PEARL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "You wouldn't. You were asleep.", "name": "OLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She looks at him, then at the river below.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "A pale glow lingers on the western ridge.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "The wind lifts and drops.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Is there food?", "name": "PEARL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "One tin.", "name": "OLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "What's in it?", "name": "PEARL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Beans.", "name": "OLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Good.", "name": "PEARL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Maybe.", "name": "OLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "They'll come looking.", "name": "PEARL", "speaker": 1, "ext": [], "paren": ["to the fire"], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Who?", "name": "OLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "The party. The survey team.", "name": "PEARL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "They don't know where we are.", "name": "OLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "They know the river.", "name": "PEARL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "The river's twelve hundred miles long, girl.", "name": "OLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "They know which bend.", "name": "PEARL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "How?", "name": "OLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "I told them.", "name": "PEARL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Ole lowers the stick.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Looks at her.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "You told them.", "name": "OLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "In the letter. The one you posted.", "name": "PEARL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "I posted it at the last trading station.", "name": "OLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "Then it's a week ahead of us.", "name": "PEARL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "So somebody knows.", "name": "OLE", "speaker": 0, "ext": [], "paren": ["slowly"], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Somebody does.", "name": "PEARL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "He puts a fresh stick in the fire.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "It catches.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "The pot begins, at last, to murmur.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "We'll hold here.", "name": "OLE", "speaker": 0, "ext": [], "paren": ["to the camp, quietly"], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "For how long?", "name": "PEARL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "Till somebody comes.", "name": "OLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "The first bubble breaks.", "para": 6, "sent": 0, "present": [0, 1]}]}