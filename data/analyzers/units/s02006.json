{"scene_id": "s02006", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02006.fountain", "heading": "INT. COMMUNITY BOXING GYM, BASEMENT - NIGHT", "cast": [{"id": 0, "name": "COACH BERNADETTE KOWALSKI-OSEI", "names": ["COACH BERNADETTE KOWALSKI-OSEI", "BERNADETTE"], "gender": "f", "first": 7, "spoke": 13}, {"id": 1, "name": "DEE", "names": ["DEE"], "gender": "?", "first": 8, "spoke": 9}, {"id": 2, "name": "THOMPSON-ABARA", "names": ["THOMPSON-ABARA"], "gender": "?", "first": 8, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. COMMUNITY BOXING GYM, BASEMENT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cinderblock walls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single ring with sagging ropes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Hand-lettered signs: NO EGOS.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "NO EXCUSES.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A speed bag hangs motionless.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "The smell of liniment and old wet leather.", "para": 0, "sent": 5, "present": []}, {"u": 7, "kind": "action", "text": "COACH BERNADETTE KOWALSKI-OSEI (60s, a woman who looks like she's been punched by every decade) leans against the ring post, a towel around her neck.", "para": 1, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Inside the ring, in a cold-sweat silence, stands DESHAWN \"DEE\" THOMPSON-ABARA (20s, wiry, wrapped hands, eyes on the floor) with his shoulders hunched.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Fourth round. Last one.", "name": "BERNADETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I know.", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "You're ahead on cards.", "name": "BERNADETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "I know.", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "You do nothing but stay ahead, you win.", "name": "BERNADETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I know, Coach.", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Then why do you look like you're about to be sick?", "name": "BERNADETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "He doesn't answer.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "He lifts his gloves; she grabs the tape from the rope and tightens one wrist, then the other; he flexes his fingers; she taps his chest twice with the flat of her hand; and he exhales, a long shaky breath that fogs the cold air.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Look at me.", "name": "BERNADETTE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I'm looking.", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "You're looking at my forehead.", "name": "BERNADETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "It's a good forehead.", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Dee.", "name": "BERNADETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "He raises his eyes.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "She holds them.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "When the bell rings, you don't think about the title. You don't think about your father. You think about the jab.", "name": "BERNADETTE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "The jab.", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Just the jab.", "name": "BERNADETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "That's all?", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Jab, step, jab. Pivot. Jab.", "name": "BERNADETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "And if he hits me?", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "He'll hit you.", "name": "BERNADETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "And?", "name": "DEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "And you'll get hit. And you'll jab.", "name": "BERNADETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "A buzzer sounds from somewhere across the hall.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Dee jerks.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Bernadette doesn't blink.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Her hand slides under his chin, tilts his face up, and settles him with a pat like a father's.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Go.", "name": "BERNADETTE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "He ducks through the ropes.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "She swings the stool into the corner, wedges the water bottle between her knees, and the bell clangs.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Dee steps into the center.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Gloves up.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "And for the first time all night, he smiles.", "para": 6, "sent": 2, "present": [0, 1, 2]}]}