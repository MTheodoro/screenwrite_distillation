{"scene_id": "s02007", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02007.fountain", "heading": "INT. OFFICE KITCHENETTE, MID-SIZED LOGISTICS FIRM - DAY", "cast": [{"id": 0, "name": "MARGUERITE OBIORA-HASKELL", "names": ["MARGUERITE OBIORA-HASKELL", "MARGUERITE"], "gender": "?", "first": 5, "spoke": 9}, {"id": 1, "name": "ISAAC BRANDT-MWANGI", "names": ["ISAAC BRANDT-MWANGI", "ISAAC"], "gender": "m", "first": 6, "spoke": 6}, {"id": 2, "name": "LEOPOLD ZIMMERMAN-OKAFOR", "names": ["LEOPOLD ZIMMERMAN-OKAFOR", "LEOPOLD"], "gender": "?", "first": 19, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. OFFICE KITCHENETTE, MID-SIZED LOGISTICS FIRM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A fluorescent-lit kitchenette.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A laminated sign over the microwave: PLEASE COVER YOUR FOOD.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A second sign below it: THIS MEANS YOU.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A coffee machine beeps its low-water warning.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MARGUERITE OBIORA-HASKELL (40s, cardigan, sensible shoes) stares at the coffee machine.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "At the table, ISAAC BRANDT-MWANGI (30s, lanyard, microwave burrito) eats without looking at anything.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "The machine beeps again.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Does anyone know who's supposed to refill this?", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Not me.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I didn't say you.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "You said anyone.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I said anyone.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "I'm part of anyone.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Everyone's anyone.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She lifts the carafe, peers into it, sets it down.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Isaac turns a page of his newspaper.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "The machine beeps.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "The door swings open.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "A man steps in, hands in his pockets: LEOPOLD ZIMMERMAN-OKAFOR (50s, suit, new badge on a new lanyard), the kind of calm that comes from a very large check.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Good morning.", "name": "LEOPOLD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Good morning.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Hey.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "I'm Leopold. I'm the new consultant.", "name": "LEOPOLD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "For what?", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Efficiency.", "name": "LEOPOLD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Marguerite and Isaac exchange the longest look in the history of the break room.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "We're very efficient.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "That's what everyone says.", "name": "LEOPOLD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "He walks to the coffee machine, studies it as a surgeon studies a lung, lifts the carafe, and sighs.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Out of water.", "name": "LEOPOLD", "speaker": 2, "ext": ["CONT'D"], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "We were just discussing that.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Who's responsible?", "name": "LEOPOLD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Nobody.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "That's the problem.", "name": "LEOPOLD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "That's the solution. If nobody's responsible, nobody's blamed.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Fascinating.", "name": "LEOPOLD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "He opens a notebook.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Writes.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Closes it.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "I'll be observing for two weeks. Please carry on as normal.", "name": "LEOPOLD", "speaker": 2, "ext": ["CONT'D"], "paren": ["to the room"], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Normal what?", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Whatever you usually do.", "name": "LEOPOLD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Marguerite looks at Isaac.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Isaac looks at his burrito.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Neither of them moves.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "The machine beeps.", "para": 8, "sent": 3, "present": [0, 1, 2]}]}