{"scene_id": "s02008", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02008.fountain", "heading": "EXT. DUSTY SALOON PORCH, CROSSROADS TOWN - NOON", "cast": [{"id": 0, "name": "SHERIFF AUGUSTUS BRANDYWINE-OKORO", "names": ["SHERIFF AUGUSTUS BRANDYWINE-OKORO", "SHERIFF"], "gender": "?", "first": 6, "spoke": 22}, {"id": 1, "name": "TOBY", "names": ["TOBY"], "gender": "?", "first": 7, "spoke": 15}, {"id": 2, "name": "FAIRWEATHER-LIN", "names": ["FAIRWEATHER-LIN"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "MADELEINE VOSKUIJLEN-ADEOLA", "names": ["MADELEINE VOSKUIJLEN-ADEOLA", "MADELEINE"], "gender": "f", "first": 35, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DUSTY SALOON PORCH, CROSSROADS TOWN - NOON", "present": []}, {"u": 1, "kind": "action", "text": "A single street of plank buildings baking in white sun.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A water trough.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A hitching rail.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Tumbleweed rolls by, unhurried, and fetches up against a barrel.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "On the porch sit two men.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "SHERIFF AUGUSTUS BRANDYWINE-OKORO (50s, graying mustache, tin star) rocks in a chair with a tin cup of coffee.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Beside him, DEPUTY TOBIAS \"TOBY\" FAIRWEATHER-LIN (20s, too-new hat, a rifle across his knees) whittles at a stick.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Quiet today.", "name": "SHERIFF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Always quiet on Wednesdays.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Quiet's a good thing.", "name": "SHERIFF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Yes, sir.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Quiet's also a warning.", "name": "SHERIFF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Yes, sir?", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Quiet means somebody's up to something.", "name": "SHERIFF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Or nobody is.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Son, the nobody's the one to worry about.", "name": "SHERIFF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Toby considers this.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Sets down the stick.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Should I go look?", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Look at what?", "name": "SHERIFF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Anything.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Sit down.", "name": "SHERIFF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "I am sitting.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Sit down harder.", "name": "SHERIFF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "A horse snorts somewhere behind the livery.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "A shutter bangs.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "The two men go still.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Sheriff.", "name": "TOBY", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "I heard it.", "name": "SHERIFF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Was it the wind?", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Might've been.", "name": "SHERIFF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Might not.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Might not.", "name": "SHERIFF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Boots on gravel.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "A new figure rounds the corner of the general store: MADELEINE VOSKUIJLEN-ADEOLA (30s, dust-colored duster, wide-brimmed hat, a carpetbag in one hand, spurs that sing).", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "She stops in the middle of the street and looks at the porch.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Afternoon, gentlemen.", "name": "MADELEINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Ma'am.", "name": "SHERIFF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Ma'am.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "I'm looking for the sheriff.", "name": "MADELEINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "You've found him.", "name": "SHERIFF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "I've a letter for you.", "name": "MADELEINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "From who?", "name": "SHERIFF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "From Judge Hollis in Santa Rita.", "name": "MADELEINE", "speaker": 3, "ext": [], "paren": ["together"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Judge Hollis in Santa Rita?", "name": "TOBY", "speaker": 1, "ext": [], "paren": ["together"], "dual": true, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Toby.", "name": "SHERIFF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Sorry, Sheriff.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Madeleine sets down the carpetbag.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Pulls a folded envelope from her coat.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Holds it up between two fingers.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Neither man moves.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Shall I bring it up, or will you come down?", "name": "MADELEINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Bring it up.", "name": "SHERIFF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "She mounts the steps.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Hands him the letter.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "He reads.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Reads again.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "Folds it.", "para": 6, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "His face goes still.", "para": 6, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "Toby. Go inside.", "name": "SHERIFF", "speaker": 0, "ext": ["CONT'D"], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "Sheriff?", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "Go inside and lock the door.", "name": "SHERIFF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "What's it say?", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "Just do it.", "name": "SHERIFF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "Toby rises, the chair scraping, and goes into the saloon.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "The door closes.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "A bolt drops.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "Madeleine and the Sheriff stand alone on the porch with the wind and the tumbleweed.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "dialogue", "text": "It says there's a man coming.", "name": "SHERIFF", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "dialogue", "text": "There is.", "name": "MADELEINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "dialogue", "text": "It says he's coming for me.", "name": "SHERIFF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "He is.", "name": "MADELEINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "It says you're his sister.", "name": "SHERIFF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "Madeleine tilts her head.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "A long silence.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "The wind lifts the brim of her hat.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "dialogue", "text": "He's not coming for you, Sheriff. I am.", "name": "MADELEINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}