{"scene_id": "s02010", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02010.fountain", "heading": "INT. NIGHT-SHIFT NURSES' STATION, ONCOLOGY WARD - NIGHT", "cast": [{"id": 0, "name": "NURSE BEATRIX OYELOWO-LANDRY", "names": ["NURSE BEATRIX OYELOWO-LANDRY", "BEATRIX"], "gender": "?", "first": 3, "spoke": 4}, {"id": 1, "name": "AUGUSTINE HALLORAN-DIOP", "names": ["AUGUSTINE HALLORAN-DIOP", "HALLORAN-DIOP"], "gender": "?", "first": 4, "spoke": 9}, {"id": 2, "name": "MAN IN A COAT", "names": ["MAN", "MAN IN A COAT"], "gender": "?", "first": 5, "spoke": 3}, {"id": 3, "name": "COAT", "names": ["COAT"], "gender": "?", "first": 5, "spoke": 0}, {"id": 4, "name": "OKPARA'S BROTHER", "names": ["OKPARA'S BROTHER"], "gender": "?", "first": 13, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT-SHIFT NURSES' STATION, ONCOLOGY WARD - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A pool of fluorescent light in a dim corridor.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Charts, a stale vending-machine coffee, a monitor beeping softly.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "NURSE BEATRIX OYELOWO-LANDRY (50s, cardigan over scrubs, glasses on a beaded chain) charts at the desk.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "Beside her, DR. AUGUSTINE HALLORAN-DIOP (30s, rumpled, third double shift) slumps on a stool.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "A MAN IN A COAT (60s, visitor's badge, shopping bag) stands at the counter's edge.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "dialogue", "text": "Doctor, there's a gentleman for you.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Who?", "name": "HALLORAN-DIOP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "He didn't say.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "She looks up at the man.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "He lowers his eyes.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I'm sorry. I know it's late.", "name": "MAN IN A COAT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "It's fine. Can I help you?", "name": "HALLORAN-DIOP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "I'm Mr. Okpara's brother.", "name": "MAN IN A COAT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Room 412.", "name": "HALLORAN-DIOP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Yes.", "name": "MAN IN A COAT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "I'm sorry. Mr. Okpara passed away at two.", "name": "HALLORAN-DIOP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "The man nods.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "He doesn't move.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "I brought him a sweater.", "name": "OKPARA'S BROTHER", "speaker": 4, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "That's thoughtful.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "It was his favorite. Blue, with the elbows gone. I thought it might be cold.", "name": "OKPARA'S BROTHER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Sir, would you like to see him?", "name": "HALLORAN-DIOP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "I think I should.", "name": "OKPARA'S BROTHER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "I'll walk you down.", "name": "BEATRIX", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Thank you.", "name": "OKPARA'S BROTHER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Take as long as you need.", "name": "HALLORAN-DIOP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Doctor.", "name": "OKPARA'S BROTHER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Yes?", "name": "HALLORAN-DIOP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Did he say anything? At the end?", "name": "OKPARA'S BROTHER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Halloran-Diop looks at Beatrix.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "She gives the smallest shake of her head.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "He asked about the weather.", "name": "HALLORAN-DIOP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Of course he did.", "name": "OKPARA'S BROTHER", "speaker": 4, "ext": [], "paren": ["a faint smile"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "He lifts the shopping bag, adjusts its handle, and follows Beatrix down the corridor.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "The monitor beeps.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "It was raining.", "name": "HALLORAN-DIOP", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}]}