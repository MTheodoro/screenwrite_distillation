{"scene_id": "s02011", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02011.fountain", "heading": "EXT. LIFEBOAT, OPEN OCEAN - DAY", "cast": [{"id": 0, "name": "TEODORA ABELARD-NKOSI", "names": ["TEODORA ABELARD-NKOSI", "TEODORA"], "gender": "f", "first": 6, "spoke": 20}, {"id": 1, "name": "RADIO VOICE", "names": ["RADIO VOICE"], "gender": "?", "first": 18, "spoke": 20}], "units": [{"u": 0, "kind": "heading", "text": "EXT. LIFEBOAT, OPEN OCEAN - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A white fiberglass lifeboat riding gentle swells under a vast blue sky.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "No land.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "No ships.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A flare gun, a water jug, a canvas awning rolled back.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The sun hammers the thwarts.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "TEODORA ABELARD-NKOSI (30s, sun-scorched, a torn orange life vest, lips split) sits in the stern with an emergency radio in her lap.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "She stares at it.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "Nothing else moves for a long time.", "para": 1, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "She turns the dial.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "Static.", "para": 2, "sent": 1, "present": [0]}, {"u": 11, "kind": "action", "text": "Turns it back.", "para": 2, "sent": 2, "present": [0]}, {"u": 12, "kind": "action", "text": "Static.", "para": 2, "sent": 3, "present": [0]}, {"u": 13, "kind": "action", "text": "She sets it on the thwart, picks up the water jug, shakes it.", "para": 2, "sent": 4, "present": [0]}, {"u": 14, "kind": "action", "text": "Almost empty.", "para": 2, "sent": 5, "present": [0]}, {"u": 15, "kind": "action", "text": "She sets it down.", "para": 2, "sent": 6, "present": [0]}, {"u": 16, "kind": "action", "text": "The radio gives a click.", "para": 3, "sent": 0, "present": [0]}, {"u": 17, "kind": "dialogue", "text": "Hello?", "name": "TEODORA", "speaker": 0, "ext": [], "paren": ["hoarse"], "dual": false, "present": [0]}, {"u": 18, "kind": "dialogue", "text": "...aboard, if you can hear this...", "name": "RADIO VOICE", "speaker": 1, "ext": ["V.O."], "paren": ["faint, through hiss"], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "I hear you! I can hear you!", "name": "TEODORA", "speaker": 0, "ext": [], "paren": ["grabbing the radio"], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "...say again. This is the Ocean Warden...", "name": "RADIO VOICE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "I'm in a lifeboat! Position unknown!", "name": "TEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Ma'am, stay calm. What is your name?", "name": "RADIO VOICE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Teodora. Teodora Abelard-Nkosi.", "name": "TEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Teodora, I'm Captain Ruiz-Delacroix. How many aboard?", "name": "RADIO VOICE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "One.", "name": "TEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "One person?", "name": "RADIO VOICE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Just me.", "name": "TEODORA", "speaker": 0, "ext": [], "paren": ["a beat"], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Understood. Do you have water?", "name": "RADIO VOICE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "A mouthful.", "name": "TEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Food?", "name": "RADIO VOICE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "None.", "name": "TEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Can you see the sun?", "name": "RADIO VOICE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "It's right above me.", "name": "TEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Good. Teodora, listen carefully. We're picking up your signal. We're three hours out. Stay on the radio.", "name": "RADIO VOICE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Three hours.", "name": "TEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Three hours. Can you hold on?", "name": "RADIO VOICE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "I've held on four days.", "name": "TEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Then three hours is easy.", "name": "RADIO VOICE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "She laughs, a dry broken sound, and presses the radio against her forehead.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Tears cut through the salt on her cheeks.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "It's not easy.", "name": "TEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "No. It isn't.", "name": "RADIO VOICE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Captain, can you just talk to me? Anything.", "name": "TEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "What would you like to hear?", "name": "RADIO VOICE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Anything. The weather. The news.", "name": "TEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Weather's fine. Seas are calm. There's a bit of high cloud to the west.", "name": "RADIO VOICE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "That's nice.", "name": "TEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "The news, honestly, isn't. But I can tell you about my dog.", "name": "RADIO VOICE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Tell me about your dog.", "name": "TEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "His name is Barnacle. He's a collie. He hates the ocean.", "name": "RADIO VOICE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "He hates the ocean?", "name": "TEODORA", "speaker": 0, "ext": [], "paren": ["laughing"], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "He's afraid of the waves. Barks at each one.", "name": "RADIO VOICE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "Does it help?", "name": "TEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "Not at all. But he's very committed.", "name": "RADIO VOICE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "Teodora closes her eyes and lets her head rest against the gunwale.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "The radio hisses and the swell lifts the boat and sets it down.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "Captain?", "name": "TEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "Still here.", "name": "RADIO VOICE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "Keep talking.", "name": "TEODORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "All right. Barnacle also eats socks.", "name": "RADIO VOICE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "She smiles, eyes shut.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "The sun climbs.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "The lifeboat rises on the swell and the radio hums on, a thin voice in the huge blue silence, and far off on the horizon something white begins to grow.", "para": 6, "sent": 2, "present": [0, 1]}]}