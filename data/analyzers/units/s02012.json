{"scene_id": "s02012", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02012.fountain", "heading": "INT. VETERANS HOSPITAL, SLEEP LAB - NIGHT", "cast": [{"id": 0, "name": "SERGEANT MAJOR TIBERIUS NWANKWO-ASHBY", "names": ["SERGEANT MAJOR TIBERIUS NWANKWO-ASHBY", "TIBERIUS"], "gender": "?", "first": 3, "spoke": 4}, {"id": 1, "name": "TECHNICIAN LUCINDA OYELARAN-PARK", "names": ["TECHNICIAN LUCINDA OYELARAN-PARK", "LUCINDA"], "gender": "f", "first": 4, "spoke": 5}, {"id": 2, "name": "WILHELM ACHTERBERG-DIOP", "names": ["WILHELM ACHTERBERG-DIOP", "WILHELM"], "gender": "?", "first": 4, "spoke": 10}, {"id": 3, "name": "CALLUM FITZGERALD-ABARA", "names": ["CALLUM FITZGERALD-ABARA", "CALLUM"], "gender": "m", "first": 4, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. VETERANS HOSPITAL, SLEEP LAB - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A dim private room with a single bed and a bank of wires, electrodes, a camera in the ceiling.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Through a one-way window: a control room with monitors.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "On the bed, wired to the scalp, sleeps SERGEANT MAJOR TIBERIUS NWANKWO-ASHBY (60s, stoic even asleep).", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "At the monitors in the control room sit TECHNICIAN LUCINDA OYELARAN-PARK (30s, clogs, a thermos), DR. WILHELM ACHTERBERG-DIOP (50s, white coat, bow tie), and a student, CALLUM FITZGERALD-ABARA (20s, clipboard).", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 5, "kind": "dialogue", "text": "Theta waves, stable.", "name": "LUCINDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "dialogue", "text": "Heart rate?", "name": "WILHELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Sixty-two.", "name": "LUCINDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Good. Callum, note the time.", "name": "WILHELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Three-oh-four.", "name": "CALLUM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "A speaker on the desk crackles with the patient's breathing, steady.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "He should enter REM within the hour.", "name": "WILHELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Doctor, what are we looking for?", "name": "CALLUM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Muscle atonia.", "name": "WILHELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "I'm sorry?", "name": "CALLUM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "In REM sleep, the body is paralyzed. Our friend in there--", "name": "WILHELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Doesn't comply.", "name": "LUCINDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "He acts out his dreams. Dangerous, for him and anyone near.", "name": "WILHELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "What does he dream about?", "name": "CALLUM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "We don't ask.", "name": "LUCINDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "The monitor's line spikes.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "The speaker emits a low, wet groan.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Down. Get down.", "name": "TIBERIUS", "speaker": 0, "ext": ["V.O."], "paren": ["over speaker, asleep"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Lucinda's pen stops.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Wilhelm leans forward.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Here we go.", "name": "WILHELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Incoming. Down.", "name": "TIBERIUS", "speaker": 0, "ext": ["V.O."], "paren": ["asleep"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "On the bed, the old man's arm swings out and strikes the rail.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "His legs kick the blanket away.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "The wires pull.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Should we go in?", "name": "CALLUM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Not yet.", "name": "WILHELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Marcus. Marcus, stay down.", "name": "TIBERIUS", "speaker": 0, "ext": ["V.O."], "paren": ["asleep, hoarse"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Lucinda lowers her head.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Wilhelm doesn't move.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Callum looks from one to the other and then at his clipboard, where his hand has stopped writing.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "I've got you. I've got you.", "name": "TIBERIUS", "speaker": 0, "ext": ["V.O."], "paren": ["asleep"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "The monitor line smooths.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "The breathing slows.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "The arm falls back across the old man's chest.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "He's back.", "name": "LUCINDA", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Time?", "name": "WILHELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Three-nineteen.", "name": "CALLUM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Record it.", "name": "WILHELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Callum writes, slowly.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Lucinda unscrews her thermos and pours coffee into the lid.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "She holds it out to him without looking.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}]}