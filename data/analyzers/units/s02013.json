{"scene_id": "s02013", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02013.fountain", "heading": "INT. PARKED SEDAN, PARKING GARAGE LEVEL P3 - NIGHT", "cast": [{"id": 0, "name": "MARISOL CASTELLANOS-OKOYE", "names": ["MARISOL CASTELLANOS-OKOYE", "MARISOL"], "gender": "?", "first": 4, "spoke": 9}, {"id": 1, "name": "HANDLER", "names": ["HANDLER"], "gender": "?", "first": 6, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. PARKED SEDAN, PARKING GARAGE LEVEL P3 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Concrete pillars.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Flickering lights.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "One car, engine off, windows fogged.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MARISOL CASTELLANOS-OKOYE (30s, black coat, gloved hands on the wheel) sits upright, eyes on the rearview.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "On the seat beside her, a phone, face-up, on speaker.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "dialogue", "text": "Status.", "name": "HANDLER", "speaker": 1, "ext": ["V.O."], "paren": ["over phone, flat"], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Parked. Third level.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "He's coming down the stairwell. Two minutes.", "name": "HANDLER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Armed?", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Assume yes.", "name": "HANDLER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She nods.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Puts a hand under the seat, finds a pistol, brings it up.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Checks it.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Sets it in her lap.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Marisol.", "name": "HANDLER", "speaker": 1, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Yeah.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "You don't have to do this.", "name": "HANDLER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "I know.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Walk away. Tonight. I'll cover it.", "name": "HANDLER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "No.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She stares at the mirror.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "A shadow moves at the far end of the garage.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She stiffens.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "I see him.", "name": "MARISOL", "speaker": 0, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Hold.", "name": "HANDLER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "He's looking at the car.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Hold.", "name": "HANDLER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "The shadow stops.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Takes a step.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Another.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "A man emerges from behind a pillar, hands in his pockets, face lost in shadow.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "He walks toward the sedan with a deliberate, easy stride.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Oh, no.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "What?", "name": "HANDLER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "It's my brother.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Silence on the line.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "The man reaches the driver's window and taps once on the glass.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "She doesn't move.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "He taps again.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "She lowers the pistol, slides it back beneath the seat, and rolls the window down an inch.", "para": 5, "sent": 4, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Hands shaking, she picks up the phone, and without a word, ends the call.", "para": 6, "sent": 0, "present": [0, 1]}]}