{"scene_id": "s02014", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02014.fountain", "heading": "INT. SAFEHOUSE KITCHEN, SUBURBAN SPLIT-LEVEL - NIGHT", "cast": [{"id": 0, "name": "AGENT PHILOMENA OYELARAN-DUBOIS", "names": ["AGENT PHILOMENA OYELARAN-DUBOIS", "PHILOMENA"], "gender": "?", "first": 4, "spoke": 3}, {"id": 1, "name": "AGENT GREGORY NAKAMURA-ACHEBE", "names": ["AGENT GREGORY NAKAMURA-ACHEBE", "GREGORY"], "gender": "?", "first": 5, "spoke": 1}, {"id": 2, "name": "WITNESS", "names": ["WITNESS"], "gender": "?", "first": 5, "spoke": 0}, {"id": 3, "name": "HELGA BRZEZINSKI-MWANGI", "names": ["HELGA BRZEZINSKI-MWANGI", "HELGA"], "gender": "?", "first": 5, "spoke": 4}, {"id": 4, "name": "OFFICER DIEGO FERREIRA-LINDQVIST", "names": ["OFFICER DIEGO FERREIRA-LINDQVIST", "DIEGO"], "gender": "m", "first": 6, "spoke": 2}, {"id": 5, "name": "OFFICER PATRICE ADELEKE-VANCE", "names": ["OFFICER PATRICE ADELEKE-VANCE", "PATRICE"], "gender": "?", "first": 6, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. SAFEHOUSE KITCHEN, SUBURBAN SPLIT-LEVEL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Drawn blinds.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A table with a half-eaten pizza.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Five people, each in a state of alertness that is nearly comic.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "AGENT PHILOMENA OYELARAN-DUBOIS (40s, short gray hair, a pistol on the table) sits at the head.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside her, AGENT GREGORY NAKAMURA-ACHEBE (30s, rolled sleeves, laptop), and across from them the WITNESS: HELGA BRZEZINSKI-MWANGI (50s, cardigan, a cup of tea going cold).", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "action", "text": "In the doorway, two guards: OFFICER DIEGO FERREIRA-LINDQVIST (20s, earpiece) and OFFICER PATRICE ADELEKE-VANCE (30s, vest).", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 7, "kind": "action", "text": "Philomena pours the witness more tea; Gregory glances at the laptop and mutters something; Diego shifts from foot to foot while Patrice peels back a corner of the blind and peers at the street; Helga takes the cup and stares at the swirl of leaves, and nobody speaks.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "dialogue", "text": "Helga, we need to talk about tomorrow.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": ["together"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "I'm not going to testify.", "name": "HELGA", "speaker": 3, "ext": [], "paren": ["together"], "dual": true, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "They stop.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "Gregory looks at Philomena.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "Philomena sets down the teapot.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "You agreed.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "That was before.", "name": "HELGA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Before what?", "name": "GREGORY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Before the car.", "name": "DIEGO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "What car?", "name": "PATRICE", "speaker": 5, "ext": [], "paren": ["from the window"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "The gray one. It's parked outside.", "name": "HELGA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "There's no gray car.", "name": "PATRICE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "It was there at six.", "name": "HELGA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Patrice, check.", "name": "DIEGO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "I'm checking.", "name": "PATRICE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Everyone be quiet.", "name": "PHILOMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "They are.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "A floorboard creaks in the hall.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Patrice lets the blind fall.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Diego's hand drifts to his holster.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}]}