{"scene_id": "s02015", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02015.fountain", "heading": "INT. COLLECTOR'S LIBRARY, COUNTRY HOUSE - EVENING", "cast": [{"id": 0, "name": "INSPECTOR CLEMENTINE ARDEN-OYELOWO", "names": ["INSPECTOR CLEMENTINE ARDEN-OYELOWO", "CLEMENTINE"], "gender": "f", "first": 4, "spoke": 20}, {"id": 1, "name": "HOUSEKEEPER", "names": ["HOUSEKEEPER"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "PRUDENCE WHITLOCK-ABARA", "names": ["PRUDENCE WHITLOCK-ABARA", "PRUDENCE"], "gender": "?", "first": 6, "spoke": 20}], "units": [{"u": 0, "kind": "heading", "text": "INT. COLLECTOR'S LIBRARY, COUNTRY HOUSE - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "A tall room lined with leather spines, a ladder on a brass rail.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Green-shaded lamps, a cold hearth, tea service untouched on a low table.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain on the long windows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "INSPECTOR CLEMENTINE ARDEN-OYELOWO (40s, brown tweed, a notebook in her breast pocket) stands at a glass cabinet.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "A single shelf in the cabinet is empty, the dust outlining a rectangle where a book once stood.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "At the fireplace, holding a cup of tea she hasn't touched, stands the HOUSEKEEPER, PRUDENCE WHITLOCK-ABARA (50s, gray dress, keys at her belt).", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Her hand does not shake.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Her eyes never leave the Inspector.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "It was here this morning.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "It was.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "You're certain.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "I dusted it myself.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "At what hour?", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Nine.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "And you locked the cabinet.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "I did.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Who else has the key?", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "The master.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Who is abroad.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "In Lisbon.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "The Inspector runs a gloved finger along the empty shelf.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Studies the rectangle.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Turns.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Mrs. Whitlock-Abara. How long have you served this house?", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Twenty-two years.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "And the book?", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "It was here before I came.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "What was it worth?", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "I don't know.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": ["a pause"], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "You don't know.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "It wasn't mine to value.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "She sets the teacup on the mantel with a faint, precise click.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Clementine watches her do it.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "You could have taken it.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "I could have.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "You had the key and the hour.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "I did.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "So why didn't you?", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Because I'd have been caught.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "By whom?", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "By you, Inspector.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "For a moment, the two women regard each other.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "A log settles in the cold hearth, which holds no fire.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "The rain slackens.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "You knew I'd come.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": ["slowly"], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "I've been expecting you since breakfast.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Because the book was gone.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Because it was never there.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Clementine goes still.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "She looks at the dust on the shelf.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "At the rectangle.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Then she crouches and, with her pen, lifts an edge of the shelf paper.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Beneath it, in the wood, a thin slot.", "para": 6, "sent": 4, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Inside the slot, nothing.", "para": 6, "sent": 5, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "She lets the paper fall.", "para": 6, "sent": 6, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "It's a decoy.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "It's been a decoy for thirty years.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "Who knew?", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "Everyone who works here.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "Except the master?", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Except the master.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "Clementine straightens.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "For the first time, she smiles, and Prudence, almost, smiles back.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "Where is it, Mrs. Whitlock-Abara?", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "In the kitchen. Behind the flour tin. I'll make you a fresh pot.", "name": "PRUDENCE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "She lifts the tray and goes out.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "Clementine stays where she is, one hand resting on the glass.", "para": 8, "sent": 1, "present": [0, 1, 2]}]}