{"scene_id": "s02016", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02016.fountain", "heading": "INT. HIGH SCHOOL GYMNASIUM, LOCKER ROOM - NIGHT", "cast": [{"id": 0, "name": "COACH ISADORA PRZYBYLSKI-OKAFOR", "names": ["COACH ISADORA PRZYBYLSKI-OKAFOR", "ISADORA"], "gender": "f", "first": 5, "spoke": 11}, {"id": 1, "name": "TANK", "names": ["TANK"], "gender": "?", "first": 6, "spoke": 6}, {"id": 2, "name": "ELLISON-ADEYEMI", "names": ["ELLISON-ADEYEMI"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "DEVON HOLLOWAY-NAKAMURA", "names": ["DEVON HOLLOWAY-NAKAMURA", "DEVON"], "gender": "?", "first": 6, "spoke": 5}, {"id": 4, "name": "AMIR ZAHEDI-LINDGREN", "names": ["AMIR ZAHEDI-LINDGREN", "AMIR"], "gender": "?", "first": 6, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. HIGH SCHOOL GYMNASIUM, LOCKER ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Rows of dented lockers.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A bench running the length of the room.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A whiteboard with a half-erased play: X's, O's, arrows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The score on the bell-jar scoreboard through the door: 61 - 61, 0:09 left.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "COACH ISADORA PRZYBYLSKI-OKAFOR (40s, whistle, headset around her neck) paces.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "On the bench, in a row of damp jerseys: MARCUS \"TANK\" ELLISON-ADEYEMI (17, point guard), DEVON HOLLOWAY-NAKAMURA (17, forward, bag of ice on his knee), and little AMIR ZAHEDI-LINDGREN (16, bench player, towel on his head).", "para": 1, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "dialogue", "text": "Nine seconds. Down by none.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "Tied.", "name": "TANK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Tied is not winning.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "We know, Coach.", "name": "DEVON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "I'm talking to the bench.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "I'm on the bench.", "name": "AMIR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "I know where you are, Amir.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "She taps the whiteboard.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "The marker squeaks.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Tank, you inbound. Devon, you screen. Amir--", "name": "ISADORA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Wait, Amir's in?", "name": "TANK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Amir's in?", "name": "DEVON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "I'm in?", "name": "AMIR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Hello, all of you. Yes. Amir's in.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Coach, with respect--", "name": "TANK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "He's never played a minute.", "name": "DEVON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Eleven minutes. In the preseason.", "name": "AMIR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "He's the only one who hasn't been guarded on tape.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "That's a bad reason.", "name": "TANK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "It's a good reason, Tank.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "What if he misses?", "name": "DEVON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "What if I miss?", "name": "AMIR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Then we go to overtime.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "That's not an answer.", "name": "TANK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "It's the only one I have.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "She caps the marker.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Silence.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "The buzzer sounds in the gym.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Amir stands first, towel falling.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "He looks at Tank, then at Devon.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Tank rises too.", "para": 3, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Devon pulls the ice off his knee, drops it in the bin, and offers Amir a fist.", "para": 3, "sent": 6, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Amir bumps it.", "para": 3, "sent": 7, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Eyes up. Hands on.", "name": "ISADORA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Hands on.", "name": "TANK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Hands on.", "name": "DEVON", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Hands on.", "name": "AMIR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "They file out.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Isadora stands alone in the empty locker room.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "She lifts the whistle to her lips and doesn't blow.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}]}