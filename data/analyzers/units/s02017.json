{"scene_id": "s02017", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02017.fountain", "heading": "INT. VILLAGE HALL, AMATEUR DRAMATICS REHEARSAL - NIGHT", "cast": [{"id": 0, "name": "DIRECTOR HILDEGARD OYEGUN-LAMBERT", "names": ["DIRECTOR HILDEGARD OYEGUN-LAMBERT", "HILDEGARD"], "gender": "?", "first": 4, "spoke": 9}, {"id": 1, "name": "LEADING LADY DORIS ABERNATHY-OKOYE", "names": ["LEADING LADY DORIS ABERNATHY-OKOYE", "DORIS"], "gender": "?", "first": 4, "spoke": 2}, {"id": 2, "name": "VILLAIN REGINALD TSAI-FAIRBANKS", "names": ["VILLAIN REGINALD TSAI-FAIRBANKS", "REGINALD"], "gender": "?", "first": 4, "spoke": 3}, {"id": 3, "name": "STAGEHAND JUNIPER ACHEBE-MOREAU", "names": ["STAGEHAND JUNIPER ACHEBE-MOREAU", "JUNIPER"], "gender": "?", "first": 4, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. VILLAGE HALL, AMATEUR DRAMATICS REHEARSAL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cold hall with a stacked-chair smell.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Folding table of tea urns.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A makeshift stage of pallets.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Four people stand in a loose semicircle: DIRECTOR HILDEGARD OYEGUN-LAMBERT (60s, scarf, a script held aloft), the LEADING LADY DORIS ABERNATHY-OKOYE (50s, hat and gloves already on), the VILLAIN REGINALD TSAI-FAIRBANKS (40s, cape, mustache of black felt), and the STAGEHAND JUNIPER ACHEBE-MOREAU (teen, headphones round her neck).", "para": 1, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 5, "kind": "dialogue", "text": "From \"Who among you has done this?\"", "name": "HILDEGARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "dialogue", "text": "Who among you has done this?", "name": "DORIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "I have done nothing.", "name": "REGINALD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Then why is the knife in your pocket?", "name": "DORIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Is it the left or the right?", "name": "REGINALD", "speaker": 2, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "The left, Reginald.", "name": "HILDEGARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "The left.", "name": "REGINALD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "He pulls out a rubber dagger.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Dramatic pause.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "It folds in half.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Told you not to buy it at the dollar store.", "name": "JUNIPER", "speaker": 3, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Juniper.", "name": "HILDEGARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Sorry.", "name": "JUNIPER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Everyone, a short break.", "name": "HILDEGARD", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "They disperse.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Doris heads to the tea urn.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Reginald examines the dagger.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Hildegard and Juniper stay center stage.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "That wasn't the dollar store.", "name": "HILDEGARD", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "What?", "name": "JUNIPER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "The knife. It's not from the dollar store.", "name": "HILDEGARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Then where?", "name": "JUNIPER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "It's not the prop knife at all. Reginald brought his own.", "name": "HILDEGARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "So?", "name": "JUNIPER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "This is the prop.", "name": "HILDEGARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "She holds up the folded rubber.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Then, slowly, she turns toward Reginald, who is stirring tea.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "A real blade glints in his pocket as he bends.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Doris sees it.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Juniper sees it.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Hildegard lowers the script.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Reginald. Show me the other one.", "name": "HILDEGARD", "speaker": 0, "ext": ["CONT'D"], "paren": ["very calmly"], "dual": false, "present": [0, 1, 2, 3]}]}