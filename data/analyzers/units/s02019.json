{"scene_id": "s02019", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02019.fountain", "heading": "INT. CLOSED MUSEUM OF CLOCKS, GALLERY - NIGHT", "cast": [{"id": 0, "name": "DETECTIVE RUTH OKONJO-HALVORSEN", "names": ["DETECTIVE RUTH OKONJO-HALVORSEN", "RUTH"], "gender": "f", "first": 5, "spoke": 20}, {"id": 1, "name": "WOMAN", "names": ["WOMAN"], "gender": "?", "first": 11, "spoke": 0}, {"id": 2, "name": "MARGUERITE DELACROIX-ASANTE", "names": ["MARGUERITE DELACROIX-ASANTE", "MARGUERITE"], "gender": "f", "first": 10, "spoke": 21}, {"id": 3, "name": "MAN", "names": ["MAN"], "gender": "f", "first": 63, "spoke": 2}, {"id": 4, "name": "GRAY WORK COAT", "names": ["GRAY WORK COAT"], "gender": "?", "first": 63, "spoke": 0}, {"id": 5, "name": "HENRI", "names": ["HENRI"], "gender": "?", "first": 67, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. CLOSED MUSEUM OF CLOCKS, GALLERY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Hundreds of clocks, all stopped at different hours.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Glass cases.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Brass gears under spotlights.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A wall of cuckoo clocks, beaks open, silent.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DETECTIVE RUTH OKONJO-HALVORSEN (40s, wool coat, flashlight) crouches over a smashed display case.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Glass crunches under her boots.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She picks up a pendulum, turns it over, sets it down.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "Footsteps behind her.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "She doesn't turn.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "dialogue", "text": "You're late, Marguerite.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 2]}, {"u": 11, "kind": "action", "text": "A WOMAN steps out from behind a longcase clock: MARGUERITE DELACROIX-ASANTE (40s, gloves, raincoat, a museum badge on a lanyard).", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "I was told eleven.", "name": "MARGUERITE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "It's eleven-twenty.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "My watch is slow.", "name": "MARGUERITE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Everything in this building is slow.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Marguerite's mouth twitches.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "She walks to the case, careful not to touch the glass.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "What's missing?", "name": "MARGUERITE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "The Harrison.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "The Harrison.", "name": "MARGUERITE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "The chronometer. Seventeen sixty-one.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Ruth, that's worth--", "name": "MARGUERITE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "More than this city. I know.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "How did they get in?", "name": "MARGUERITE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Through the cuckoo wall.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "That's impossible. It's a hundred pounds of timber and a steel frame.", "name": "MARGUERITE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Somebody had the key.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Who?", "name": "MARGUERITE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "You tell me.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Marguerite stiffens.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The nearest clock ticks once, as if the sound were a mistake, and falls silent again.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "You think I did it.", "name": "MARGUERITE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "I think you're the curator.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Ruth.", "name": "MARGUERITE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "I think you carry the only key.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "I lost it Tuesday.", "name": "MARGUERITE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Where?", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "In the carpark.", "name": "MARGUERITE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "You didn't report it.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "I thought I'd find it.", "name": "MARGUERITE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Marguerite, you are the least careless person I have ever met.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Marguerite takes off her gloves one finger at a time.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Lays them on the case.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "I didn't take it.", "name": "MARGUERITE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "I didn't say you did.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "You've been saying it for twenty minutes.", "name": "MARGUERITE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "I've been listening for twenty minutes. There's a difference.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "A new sound: a faint, mechanical whir.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Both women freeze.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "The cuckoo wall, a hundred painted doors, shivers.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "One by one, they pop open.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "That's not on a timer.", "name": "MARGUERITE", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "No.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "A hundred cuckoos emerge on little sprung arms, each with its beak wide, and begin to chime together, wildly out of tune.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "The noise fills the gallery like a swarm.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Ruth draws her sidearm.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Marguerite grabs her arm.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "Don't! You'll hit the glass!", "name": "MARGUERITE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "Then who's doing this?", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "It's the mainspring! Someone's wound it!", "name": "MARGUERITE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Where?", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "Marguerite points.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "Behind the cuckoos, in the shadow, a figure steps out: a MAN IN A GRAY WORK COAT (60s, clock-repairer's loupe pushed up on his forehead, the chronometer in his hand like a baby).", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "dialogue", "text": "It's not stolen.", "name": "MAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "Put it down.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "dialogue", "text": "It's mine.", "name": "MAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "dialogue", "text": "Henri?", "name": "MARGUERITE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "action", "text": "The man looks at her.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "action", "text": "His lip trembles.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "dialogue", "text": "It was my father's. They took it. Fifty years ago.", "name": "HENRI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "action", "text": "Ruth lowers the gun.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "action", "text": "The cuckoos chime on.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "action", "text": "Marguerite crosses the glass-strewn floor, slowly, and stops an arm's length from him.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "dialogue", "text": "Henri. Give it to me.", "name": "MARGUERITE", "speaker": 2, "ext": [], "paren": ["gently"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 75, "kind": "dialogue", "text": "You'll lock it up again.", "name": "HENRI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 76, "kind": "dialogue", "text": "I'll make sure it's in the right case.", "name": "MARGUERITE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 77, "kind": "action", "text": "He studies her face for a long time.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 78, "kind": "action", "text": "Then, as the last cuckoo clicks back into its door and the gallery falls silent, he lays the chronometer in her gloved hands.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}