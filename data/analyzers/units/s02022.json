{"scene_id": "s02022", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02022.fountain", "heading": "INT. DRIFTING SALT-HARVEST BARGE - AIRLOCK - CONTINUOUS", "cast": [{"id": 0, "name": "NADIR SOLOMON", "names": ["NADIR SOLOMON", "NADIR"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "SOLENNE ARQUETTE", "names": ["SOLENNE ARQUETTE", "SOLENNE"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "BAX", "names": ["BAX"], "gender": "?", "first": 6, "spoke": 3}, {"id": 3, "name": "ULLMAN", "names": ["ULLMAN"], "gender": "?", "first": 6, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRIFTING SALT-HARVEST BARGE - AIRLOCK - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Red emergency light.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Frost on the walls.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Pressure alarm pulsing.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "NADIR SOLOMON (40s, pilot) slams the inner hatch.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "SOLENNE ARQUETTE (20s, engineer) jams a wrench into the wheel.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "BAXTER \"BAX\" ULLMAN (50s, quartermaster) hauls a crate against the door.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "It's through the hull--", "name": "NADIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Not through, it's--", "name": "SOLENNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Everybody off the wall!", "name": "BAX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "I need ten seconds--", "name": "SOLENNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "We don't have ten!", "name": "NADIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Then make it five!", "name": "BAX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "The hatch BANGS from outside.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "All three leap back, then lunge at the wheel together.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Hold it!", "name": "SOLENNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Holding!", "name": "NADIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Don't hold it, turn it!", "name": "BAX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Turn it left! Left!", "name": "SOLENNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "The wheel locks.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "The alarm cuts out.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "They slide down the wall, breathing hard.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Whatever that was, it knows we're in here.", "name": "NADIR", "speaker": 0, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3]}]}