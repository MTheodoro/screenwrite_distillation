{"scene_id": "s02024", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02024.fountain", "heading": "INT. HALLORAN FAMILY GREENHOUSE - SATURDAY MORNING", "cast": [{"id": 0, "name": "GRANDMA ROSALIND HALLORAN", "names": ["GRANDMA ROSALIND HALLORAN", "HALLORAN", "DESMOND HALLORAN", "JUNIPER HALLORAN", "DESMOND", "ROSALIND", "JUNIPER"], "gender": "f", "first": 5, "spoke": 32}, {"id": 1, "name": "TOBY", "names": ["TOBY"], "gender": "m", "first": 6, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. HALLORAN FAMILY GREENHOUSE - SATURDAY MORNING", "present": []}, {"u": 1, "kind": "action", "text": "A glass lean-to bolted to the back of a brick house.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Tomato vines, hanging fern baskets, a rusted wheelbarrow.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Condensation drips from every pane.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A radio on a shelf plays low country music.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "GRANDMA ROSALIND HALLORAN (70s, tiny, sunhat, hands like gnarled roots) kneels at a seed tray.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Beside her, TOBIAS \"TOBY\" HALLORAN (9, cowlick, one shoe untied) holds a trowel like a sword.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Near the door, DESMOND HALLORAN (40s, Toby's father, rumpled) drinks coffee from a thermos lid.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Next to him, JUNIPER HALLORAN (15, black nail polish, earbuds in) scrolls her phone.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Toby, easy with that.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I am easy.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "He is a delicate surgeon.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "He is a menace.", "name": "JUNIPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Toby jabs the trowel into the soil.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "It strikes something hard.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "CLINK.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Gran! There's something!", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Stop digging.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "It's metal!", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Stop digging, Tobias.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Her voice is suddenly flat, brittle.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Everyone goes still.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Even the radio seems to hush.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Mum?", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Step back. Everyone.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "She pushes herself up, wincing, takes Toby by the shoulders and moves him aside.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "She brushes dirt away with her thumb.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "A rusted tin lid appears, stamped with faded red roses.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Is that a body?", "name": "JUNIPER", "speaker": 0, "ext": [], "paren": ["pulling out one earbud"], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Juniper!", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "It is not a body.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Is it treasure?", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "It is something I buried the year your grandfather left.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "The room holds its breath.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Desmond sets down the thermos lid.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Mum, you don't have to--", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "I do. It's been forty years. I'm tired of tending around it.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "She kneels again, slower.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Works her fingers under the lid.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "It resists, then gives with a shriek of old metal.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Inside, wrapped in oilcloth, a bundle of letters tied with twine, a man's gold watch, and a child's baby shoe.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "That's tiny.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "That's Dad's.", "name": "JUNIPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Desmond stares at the shoe.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "He crouches slowly, picks it up.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "His thumb rubs the faded stitching.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "You said you lost these.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "I said a lot of things.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "You told me he took everything!", "name": "DESMOND", "speaker": 0, "ext": [], "paren": ["louder"], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "I told you what I could bear to tell you!", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": ["louder"], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "The shout rings off the glass.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "Toby flinches.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "Juniper steps in front of him, protective, then looks mortified and steps back.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "Forty years.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": ["to Rosalind"], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "Forty years.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": ["to Desmond"], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "Silence.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "Condensation drips from a pane onto a fern frond.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "Plink.", "para": 12, "sent": 2, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "Rosalind lifts the watch, wipes the face with her sleeve.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "Holds it to her ear.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "Still ticking.", "name": "ROSALIND", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "It can't be.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "Your father always wound it twice a day. I think I kept doing it, in my head, after.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "Can I hold it?", "name": "TOBY", "speaker": 1, "ext": [], "paren": ["small voice"], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "Rosalind looks at Desmond.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "He nods, slow.", "para": 14, "sent": 1, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "She presses the watch into Toby's palm, folding his fingers around it.", "para": 14, "sent": 2, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "Gently, my darling. It has been waiting a long time.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "Toby lifts it to his ear, eyes huge.", "para": 15, "sent": 0, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "It's like a tiny heart.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "That is actually kind of sweet.", "name": "JUNIPER", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "dialogue", "text": "Don't tell anyone.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 72, "kind": "dialogue", "text": "I'll tell everyone.", "name": "JUNIPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "The corner of Desmond's mouth twitches.", "para": 16, "sent": 0, "present": [0, 1]}, {"u": 74, "kind": "action", "text": "He sits down hard on the overturned wheelbarrow and laughs, short and wet.", "para": 16, "sent": 1, "present": [0, 1]}, {"u": 75, "kind": "action", "text": "Rosalind lets out a breath and laughs too.", "para": 16, "sent": 2, "present": [0, 1]}, {"u": 76, "kind": "action", "text": "Juniper joins, helpless.", "para": 16, "sent": 3, "present": [0, 1]}, {"u": 77, "kind": "action", "text": "Toby looks from face to face, confused and thrilled.", "para": 16, "sent": 4, "present": [0, 1]}, {"u": 78, "kind": "dialogue", "text": "What's funny?", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 79, "kind": "dialogue", "text": "Absolutely nothing.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 80, "kind": "dialogue", "text": "Absolutely nothing.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 81, "kind": "dialogue", "text": "Absolutely nothing.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 82, "kind": "dialogue", "text": "Everything.", "name": "JUNIPER", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1]}, {"u": 83, "kind": "action", "text": "The radio, as if on cue, turns to a slow waltz.", "para": 17, "sent": 0, "present": [0, 1]}, {"u": 84, "kind": "action", "text": "Rosalind sets the tin in the sun, lid open, and goes back to her seed tray.", "para": 17, "sent": 1, "present": [0, 1]}, {"u": 85, "kind": "dialogue", "text": "Now. Who wants to plant some tomatoes?", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}