{"scene_id": "s02026", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02026.fountain", "heading": "INT. CLOSED OBSERVATION TOWER - STAIRWELL LANDING - NIGHT", "cast": [{"id": 0, "name": "AGENT RENATA VOSS", "names": ["AGENT RENATA VOSS", "RENATA"], "gender": "?", "first": 4, "spoke": 2}, {"id": 1, "name": "ELIAS MBEKI", "names": ["ELIAS MBEKI", "ELIAS"], "gender": "?", "first": 15, "spoke": 3}, {"id": 2, "name": "DEPUTY HANNAH OAKES", "names": ["DEPUTY HANNAH OAKES", "HANNAH"], "gender": "f", "first": 19, "spoke": 2}, {"id": 3, "name": "SIREN", "names": ["SIREN"], "gender": "?", "first": 42, "spoke": 0}, {"id": 4, "name": "DOCTOR AMARA LINDQVIST", "names": ["DOCTOR AMARA LINDQVIST", "AMARA"], "gender": "?", "first": 47, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. CLOSED OBSERVATION TOWER - STAIRWELL LANDING - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Concrete.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "One bulb.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain in the vents.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "AGENT RENATA VOSS (40s) crouches over a duffel bag.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Zipper open.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Cash, passports, a phone.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "Her breathing is slow, controlled.", "para": 1, "sent": 3, "present": [0]}, {"u": 8, "kind": "action", "text": "Footsteps below.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Heavy.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "Climbing.", "para": 2, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "She zips the bag.", "para": 3, "sent": 0, "present": [0]}, {"u": 12, "kind": "action", "text": "Stands.", "para": 3, "sent": 1, "present": [0]}, {"u": 13, "kind": "action", "text": "Back to the wall.", "para": 3, "sent": 2, "present": [0]}, {"u": 14, "kind": "action", "text": "A figure rounds the landing.", "para": 4, "sent": 0, "present": [0]}, {"u": 15, "kind": "action", "text": "ELIAS MBEKI (50s), coat soaked, pistol low.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He stops.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Sees her.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Neither moves.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Behind him, DEPUTY HANNAH OAKES (30s), radio on her shoulder, edges up the steps.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Renata.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Elias.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Hands where I can see them!", "name": "HANNAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Hannah, stand down.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Renata's eyes flick to the bag.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "His follow.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Both lunge at once.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Elbows, knees, a snarl.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "The bag skids across the concrete.", "para": 6, "sent": 4, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "She hooks his leg.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "He drives her into the railing.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "It groans.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The pistol clatters down the stairs.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Hannah ducks aside as it passes her boots.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "He gets a forearm across her throat.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "She bites his wrist.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "He yanks free.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Hannah raises her weapon.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Shaky.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Trying to find a clean line.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Stop! Both of you!", "name": "HANNAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "They don't.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Then a SIREN builds outside.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Red and blue strobe through the vent slats.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "They freeze, still tangled.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Breathing hard.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Rain drums on the roof.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "DOCTOR AMARA LINDQVIST (60s, civilian) appears at the top of the stairs, hands raised, trembling, a thermos in one.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Please. I only came up to fix the lamp.", "name": "AMARA", "speaker": 4, "ext": [], "paren": ["breathless"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Nobody answers.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "The siren fades past.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Renata lets go first.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "He follows.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "They step apart.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "It's over.", "name": "ELIAS", "speaker": 1, "ext": [], "paren": ["tired"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "It never is.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "She sits down on the stairs, defeated, and holds out her wrists.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4]}]}