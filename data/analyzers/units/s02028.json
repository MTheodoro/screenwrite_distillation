{"scene_id": "s02028", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02028.fountain", "heading": "INT. FLOWER MARKET COLD ROOM - PREDAWN", "cast": [{"id": 0, "name": "NOOR BAKHSH", "names": ["NOOR BAKHSH", "NOOR"], "gender": "?", "first": 5, "spoke": 6}, {"id": 1, "name": "TIM", "names": ["TIM"], "gender": "m", "first": 6, "spoke": 6}, {"id": 2, "name": "REYES", "names": ["REYES"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "GWENDOLYN FOSS", "names": ["GWENDOLYN FOSS", "GWENDOLYN"], "gender": "?", "first": 7, "spoke": 11}, {"id": 4, "name": "OSKAR LINDEN", "names": ["OSKAR LINDEN", "OSKAR"], "gender": "?", "first": 8, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. FLOWER MARKET COLD ROOM - PREDAWN", "present": []}, {"u": 1, "kind": "action", "text": "A walk-in refrigerator the size of a garage.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Buckets of tulips and ranunculus line the metal shelves.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The breath of four people hangs in the air.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "At the back, a steel door with a keypad.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "NOOR BAKHSH (30s, delivery-driver uniform, clipboard) holds a flashlight.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "TIMOTEO \"TIM\" REYES (40s, in a florist's apron that doesn't fit) props a bucket against the wall.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "GWENDOLYN FOSS (60s, elegant, white gloves) studies the keypad.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Behind them all, OSKAR LINDEN (20s, sweating despite the cold) carries a long cardboard flower box.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Quiet, please. Everyone listen.", "name": "GWENDOLYN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "We're listening.", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "The vault door is on a six-digit code. We have three attempts before it locks for the hour.", "name": "GWENDOLYN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Do we know the code?", "name": "TIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "We know a code.", "name": "GWENDOLYN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Is that the same as knowing it?", "name": "OSKAR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Only if I am right.", "name": "GWENDOLYN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Tim lowers his voice.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "How long until the shift change?", "name": "TIM", "speaker": 1, "ext": [], "paren": ["to Noor"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Eleven minutes.", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Eleven minutes. In a refrigerator. With roses.", "name": "TIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "They're ranunculus.", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Of course they are.", "name": "TIM", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Gwendolyn removes one glove, finger by finger.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Enters six digits.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "The keypad blinks red.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "That's one.", "name": "OSKAR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "I can count, young man.", "name": "GWENDOLYN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "What did you try?", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "The florist's birthday.", "name": "GWENDOLYN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "That's me. I don't have a birthday.", "name": "TIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Nobody believes that.", "name": "GWENDOLYN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "She tries again.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Red.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Two.", "name": "OSKAR", "speaker": 4, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Everyone stay calm. Gwendolyn, one more, and then we walk out as if nothing happened.", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "We are not walking out.", "name": "GWENDOLYN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "She turns, takes the flower box from Oskar, and opens the lid.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Inside, a small brass cylinder on a stand.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Is that what I think it is?", "name": "TIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "It is a very polite drill.", "name": "GWENDOLYN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "That was always the plan?", "name": "OSKAR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "The code was a courtesy.", "name": "GWENDOLYN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "She sets the cylinder against the lock.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "A low whir fills the cold room.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Frost trembles on the petals.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Nine minutes.", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Plenty.", "name": "GWENDOLYN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}