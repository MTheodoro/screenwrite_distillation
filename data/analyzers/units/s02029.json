aren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Guard's early. Hear that?", "name": "HENRIK", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Boots clang above.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Everyone drops.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Priscilla, in. Now.", "name": "JUNO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "I'm in, I'm in!", "name": "PRISCILLA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Henrik, you said clear!", "name": "MATS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "I said clear ten minutes ago!", "name": "HENRIK", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "The boots stop.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "A radio crackles.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Then, laughter, drifting off.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Silence.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Okay. Nobody breathe. Nobody speak.", "name": "JUNO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Juno?", "name": "MATS", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "What?", "name": "JUNO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, 