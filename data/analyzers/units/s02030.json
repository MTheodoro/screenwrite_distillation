{"scene_id": "s02030", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02030.fountain", "heading": "INT. CHEESE AFFINAGE CAVE - NIGHT", "cast": [{"id": 0, "name": "ARNAUD DELACROIX-MBALLA", "names": ["ARNAUD DELACROIX-MBALLA", "ARNAUD"], "gender": "m", "first": 7, "spoke": 7}, {"id": 1, "name": "SABINE QUIRK", "names": ["SABINE QUIRK", "SABINE"], "gender": "f", "first": 10, "spoke": 2}, {"id": 2, "name": "YOSEF ABRAMOWITZ", "names": ["YOSEF ABRAMOWITZ", "YOSEF"], "gender": "?", "first": 13, "spoke": 2}, {"id": 3, "name": "LEILANI KEAWE", "names": ["LEILANI KEAWE", "LEILANI"], "gender": "?", "first": 15, "spoke": 2}, {"id": 4, "name": "TOMAS ESPINOZA-REID", "names": ["TOMAS ESPINOZA-REID", "TOMAS"], "gender": "?", "first": 18, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. CHEESE AFFINAGE CAVE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Damp limestone.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Shelves of waxed wheels stretch back into the dark.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single lantern on a hook.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Cool, quiet, almost holy.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A long oak table at the center.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "Five people sit around it with tasting knives and small plates, like it's a dinner party.", "para": 1, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "At the head, ARNAUD DELACROIX-MBALLA (60s, owner, white apron).", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "He cuts a wedge, offers it round.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "Steady hands.", "para": 2, "sent": 2, "present": [0]}, {"u": 10, "kind": "action", "text": "To his right, SABINE QUIRK (30s, buyer, scarf).", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She takes the wedge.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Doesn't eat it.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Across from her, YOSEF ABRAMOWITZ (50s, inspector).", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "He chews slowly, eyes on the ceiling.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Beside him, LEILANI KEAWE (20s, sommelier).", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "She pours wine.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Pours a little too much into one glass.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "At the foot, TOMAS ESPINOZA-REID (40s, silent partner), jacket on, buttoned.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Eighteen months. Raw milk.", "name": "ARNAUD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "It's lovely.", "name": "SABINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "You haven't tasted it.", "name": "ARNAUD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "She lifts it.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Eats.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Smiles with her mouth only.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Earthy.", "name": "YOSEF", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "A little mushroom. Hazelnut at the finish.", "name": "LEILANI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "It's fine.", "name": "TOMAS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Arnaud nods.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Cuts another wedge.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Sets it before Tomas.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Tomas does not touch it.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "You're not hungry?", "name": "ARNAUD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "I ate.", "name": "TOMAS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Before you came?", "name": "ARNAUD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Before.", "name": "TOMAS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Sabine sets down her knife.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Gently.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Parallel to the plate.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Leilani refills Yosef's glass.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "His hand covers it too late.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "She keeps pouring anyway.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "That's plenty.", "name": "YOSEF", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Is it?", "name": "LEILANI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "She holds his gaze.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "He lowers his hand.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Strange thing, an affinage cave. Everything in here changes. Slowly. If you do nothing, it turns.", "name": "ARNAUD", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "Turns into what?", "name": "SABINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Whatever it was always going to be.", "name": "ARNAUD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Silence.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Water drips somewhere in the dark.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Tomas shifts.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "His jacket pulls open an inch.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "A holster, dull black.", "para": 12, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "He buttons it again.", "para": 12, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Nobody looks at it.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Everybody saw it.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "Arnaud sets down his own knife.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Folds his hands.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "Smiles at the table like a man who has just finished a long meal.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "Now. Shall we discuss the shipment?", "name": "ARNAUD", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}