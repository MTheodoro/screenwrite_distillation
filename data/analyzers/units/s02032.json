{"scene_id": "s02032", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02032.fountain", "heading": "INT. LIGHTHOUSE KEEPER'S QUARTERS - NIGHT", "cast": [{"id": 0, "name": "OLIVER FENWICK", "names": ["OLIVER FENWICK", "OLIVER"], "gender": "m", "first": 5, "spoke": 8}, {"id": 1, "name": "ESTHER FENWICK", "names": ["ESTHER FENWICK", "ESTHER"], "gender": "?", "first": 5, "spoke": 7}, {"id": 2, "name": "TIMOTHY", "names": ["TIMOTHY"], "gender": "?", "first": 7, "spoke": 7}, {"id": 3, "name": "KNOCK", "names": ["KNOCK"], "gender": "?", "first": 22, "spoke": 0}, {"id": 4, "name": "MARGUERITE HOLLOWAY", "names": ["MARGUERITE HOLLOWAY", "MARGUERITE"], "gender": "?", "first": 29, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. LIGHTHOUSE KEEPER'S QUARTERS - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A round room papered in sea charts.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A coal stove, a kettle, a narrow bed.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The window shakes with wind.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Every few seconds the lighthouse beam sweeps across the walls, white, then gone.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "OLIVER FENWICK (50s, keeper, cardigan, pipe) pours tea.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "ESTHER FENWICK (50s, his wife, knitting) sits by the stove.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Between them, their grown son TIMOTHY (20s, home from the mainland, restless) paces to the window and back.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Tea, Tim?", "name": "OLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "No, Dad.", "name": "TIMOTHY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "He's nervous.", "name": "ESTHER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I'm not nervous.", "name": "TIMOTHY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "You're wearing a groove in the floor.", "name": "ESTHER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Sit.", "name": "OLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "There's someone on the rocks.", "name": "TIMOTHY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "There's no one on the rocks.", "name": "OLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "There's no one on the rocks.", "name": "ESTHER", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I saw a light.", "name": "TIMOTHY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Our light.", "name": "OLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "No. Lower.", "name": "TIMOTHY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "The beam sweeps.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Passes.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Then, from the dark below, a KNOCK.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Three slow raps on the door.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Esther's needles stop.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Oliver's pipe stops halfway to his mouth.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Who would be out in this?", "name": "ESTHER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Timothy opens the door.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Wind whips in.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "On the step stands MARGUERITE HOLLOWAY (30s, drenched oilskin, hair plastered, lantern in hand, eyes calm).", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Forgive the hour. My boat has run aground.", "name": "MARGUERITE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Come in, come in! Esther, a towel!", "name": "OLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "There's no boat on that shoal, Oliver. There hasn't been one since--", "name": "ESTHER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Esther.", "name": "OLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Marguerite steps inside, drips onto the mat, offers a small smile.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "A cup of tea would be kind.", "name": "MARGUERITE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Where did you moor?", "name": "TIMOTHY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Where the water let me.", "name": "MARGUERITE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "That's not an answer.", "name": "ESTHER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "She's half frozen!", "name": "OLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Dad--", "name": "TIMOTHY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Tim!", "name": "OLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Child, you are shaking.", "name": "ESTHER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Am I?", "name": "MARGUERITE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "She looks at her hand, holding the lantern.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Perfectly steady.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "The flame inside does not flicker, though the wind is howling through the open door.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "The beam sweeps across the room again.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "The three Fenwicks glance at one another.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Oliver closes the door.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Esther pours a fourth cup, and they all pretend, with great courtesy, that nothing at all is wrong.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}]}