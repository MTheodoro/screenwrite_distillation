{"scene_id": "s02033", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02033.fountain", "heading": "INT. CORNER LAUNDROMAT - NIGHT", "cast": [{"id": 0, "name": "LENKA PAVLOVIC", "names": ["LENKA PAVLOVIC", "LENKA"], "gender": "f", "first": 5, "spoke": 3}, {"id": 1, "name": "MOTHER", "names": ["MOTHER"], "gender": "?", "first": 12, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. CORNER LAUNDROMAT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent hum.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A row of dryers turns slow, tumbling a rainbow of someone else's socks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain streaks the front window.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "At the back, a payphone with a cracked receiver.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LENKA PAVLOVIC (8, braids, pajama top under a parka) stands on a plastic chair, both hands wrapped round the receiver, a bag of laundry at her feet.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A sudden CRASH from the street.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "A truck backfiring.", "para": 2, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "Lenka shrieks and drops the phone.", "para": 2, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "Socks spill from the bag.", "para": 2, "sent": 3, "present": [0]}, {"u": 10, "kind": "action", "text": "She freezes, wide-eyed, then scrambles down and snatches the swinging receiver.", "para": 2, "sent": 4, "present": [0]}, {"u": 11, "kind": "action", "text": "A tiny voice crackles out of it.", "para": 3, "sent": 0, "present": [0]}, {"u": 12, "kind": "dialogue", "text": "Lenka? Lenka, are you there?", "name": "MOTHER", "speaker": 1, "ext": ["V.O."], "paren": ["tinny, far away"], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Mama, there was a monster!", "name": "LENKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "What was that noise?", "name": "MOTHER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Are you hurt? Say something!", "name": "MOTHER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "It was a truck, I think! I wasn't scared, I promise!", "name": "LENKA", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Stay put. I'm on the bus. Ten minutes.", "name": "MOTHER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "I'll stay.", "name": "LENKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She hangs up gently.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Crouches.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Starts to gather the socks, tucking each one into the bag as though it is a small lost animal.", "para": 4, "sent": 2, "present": [0, 1]}]}