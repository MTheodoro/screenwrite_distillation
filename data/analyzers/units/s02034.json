{"scene_id": "s02034", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02034.fountain", "heading": "INT. BOWLING ALLEY - LANE 12 - NIGHT", "cast": [{"id": 0, "name": "MARCEL", "names": ["MARCEL"], "gender": "?", "first": 8, "spoke": 3}, {"id": 1, "name": "DUBOIS", "names": ["DUBOIS"], "gender": "?", "first": 8, "spoke": 0}, {"id": 2, "name": "GERT", "names": ["GERT"], "gender": "?", "first": 9, "spoke": 4}, {"id": 3, "name": "NAKAMURA-HOLT", "names": ["NAKAMURA-HOLT"], "gender": "?", "first": 9, "spoke": 0}, {"id": 4, "name": "DELPHINE ARCHAMBEAU", "names": ["DELPHINE ARCHAMBEAU", "DELPHINE"], "gender": "f", "first": 10, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. BOWLING ALLEY - LANE 12 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Neon pins.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Disco ball dull with grease.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A league night.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Leather shoes squeak on wax.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The tenth frame.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "Final game of the championship.", "para": 1, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "Lane 12 holds three people and a hush.", "para": 1, "sent": 2, "present": []}, {"u": 8, "kind": "action", "text": "MARCEL \"THE HAMMER\" DUBOIS (50s, belly, wristband, ball already in hand) steps to the line.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "His rival, GERTRUDE \"GERT\" NAKAMURA-HOLT (60s, sleeveless, forearms like cables) leans on the ball return, arms crossed, scowling.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Their referee, DELPHINE ARCHAMBEAU (30s, clipboard, whistle around her neck) stands between them, tally sheet trembling in her hands.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Marcel needs a spare for the win.", "name": "DELPHINE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "He needs a miracle.", "name": "GERT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Silence, please.", "name": "MARCEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "He raises the ball to his chin.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Closes his eyes.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Steps.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Swings.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Releases.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "The ball rolls, wobbles, drifts, and curves wide of the head pin.", "para": 3, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Seven pins fall.", "para": 3, "sent": 6, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Three stand: left, right, center.", "para": 3, "sent": 7, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Seven.", "name": "DELPHINE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Called it.", "name": "GERT", "speaker": 2, "ext": [], "paren": ["smirking"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Marcel stands rigid.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "The ball returns.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "He catches it and, without a word, wheels around, lifts it high, and hurls it.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "It crashes into the ball return, bounces, spins across the lane, skids into the gutter, and strikes a standing pin from the side.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "All three tumble.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Pinsetter whirs.", "para": 4, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Gert throws up both arms, Delphine drops her clipboard, Marcel looks at his empty hands as if he is not sure they are his.", "para": 4, "sent": 6, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "A long silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Then Delphine laughs.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Gert laughs.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Marcel, shaking, laughs loudest of all.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "That is not legal. That is absolutely not legal.", "name": "DELPHINE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "It counts.", "name": "GERT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Does it?", "name": "MARCEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "It counts.", "name": "DELPHINE", "speaker": 4, "ext": [], "paren": ["exhaling"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Gert extends a hand.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Marcel takes it.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "They shake, too long, too hard, then both let go and grab their lanes' ball return, smiling stupidly.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Next year, I destroy you.", "name": "GERT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "I look forward to it.", "name": "MARCEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}