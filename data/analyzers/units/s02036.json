{"scene_id": "s02036", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02036.fountain", "heading": "EXT. FROZEN LAKE - WHITEOUT - DAY", "cast": [{"id": 0, "name": "ASHER VANTERPOOL", "names": ["ASHER VANTERPOOL", "ASHER"], "gender": "?", "first": 4, "spoke": 3}, {"id": 1, "name": "RANGER", "names": ["RANGER"], "gender": "?", "first": 7, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FROZEN LAKE - WHITEOUT - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Wind.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Nothing but wind and white.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A lone figure kneels on a sheet of gray ice around a hole cut with a hand auger.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ASHER VANTERPOOL (30s, parka crusted with frost, one glove missing) hauls a line.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He wedges his heels against the ice.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "A walkie-talkie sits by his knee, crackling.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "dialogue", "text": "...lake team...do you...ice thinning...south shore...", "name": "RANGER", "speaker": 1, "ext": ["V.O."], "paren": ["broken, windy"], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Asher grabs the walkie.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Does not answer.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Lets it fall back onto the ice.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "...move...north...now...", "name": "RANGER", "speaker": 1, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "The line goes taut.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Something enormous tugs.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He hauls.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Ice groans.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "A hairline crack races outward from the hole.", "para": 3, "sent": 4, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He keeps pulling.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Come on.", "name": "ASHER", "speaker": 0, "ext": [], "paren": ["under his breath"], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "...Asher...do you copy...", "name": "RANGER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Not yet.", "name": "ASHER", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "The crack widens.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "His boots slide.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "He braces.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Pulls.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "The fish breaks the surface: a gray, glistening length of lake trout, fat as a man's thigh.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "It flops on the ice.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "He stares at it.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Takes his bare hand and presses it to the cold flank, once, gently.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Then he cuts the line, lifts the trout against his chest like something fragile, and stands.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "The ice groans again, deeper.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "He picks up the walkie.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Heading north.", "name": "ASHER", "speaker": 0, "ext": ["CONT'D"], "paren": ["into radio"], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "He walks.", "para": 9, "sent": 0, "present": [0, 1]}]}