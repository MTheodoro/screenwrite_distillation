{"scene_id": "s02037", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02037.fountain", "heading": "INT. KINGSLEY FAMILY MINIVAN - ROAD-TRIP DETOUR - DAY", "cast": [{"id": 0, "name": "GLORIA KINGSLEY", "names": ["GLORIA KINGSLEY", "KINGSLEY", "GLORIA"], "gender": "f", "first": 5, "spoke": 20}, {"id": 1, "name": "ARTHUR KINGSLEY", "names": ["ARTHUR KINGSLEY", "ARTHUR"], "gender": "m", "first": 5, "spoke": 12}, {"id": 2, "name": "PRU", "names": ["PRU"], "gender": "f", "first": 7, "spoke": 16}], "units": [{"u": 0, "kind": "heading", "text": "INT. KINGSLEY FAMILY MINIVAN - ROAD-TRIP DETOUR - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A battered silver minivan crawls along a gravel road through sunflower fields.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cracker crumbs on the seats.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cooler wedged between the front seats.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Windows down.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "At the wheel, GLORIA KINGSLEY (40s, sunglasses on her head, squinting at a paper map).", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Beside her, her husband ARTHUR KINGSLEY (40s, sunburnt nose, a sandwich in one hand).", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "In the back, their daughter PRUDENCE \"PRU\" KINGSLEY (11, library book, headphones around her neck, one foot on the seat in front).", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "The sign said Millbrook was four miles.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "That was six miles ago.", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "It said four, then it said nine, then it said Millbrook closed.", "name": "PRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "It did not say closed.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "It said \"CLOSED FOR SEASON.\" I read it.", "name": "PRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "That's a different sign. That was the minigolf.", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "There's minigolf in the middle of nowhere?", "name": "PRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "There's always minigolf.", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "She puts down the map and shades her eyes.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "A cloud of dust rolls up behind them.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "The minivan coughs.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "The dashboard light flickers.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Don't you dare.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "What is that noise?", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Nothing is making a noise.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "It's the van.", "name": "PRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "It's not the van.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "The engine sputters again and dies.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The van coasts a few yards, rolls to a stop beside a rusted mailbox leaning in the weeds.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Cicadas.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "A sunflower nods in the wind.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "So.", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Don't say it.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "I wasn't going to say it.", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "You were.", "name": "PRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "He was.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "I was going to say \"Great spot for a picnic.\"", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Pru snorts.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Gloria turns the key.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Click.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Click.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Nothing.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "We have water. We have the cooler. We have a map.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "We have a map that said Millbrook was four miles.", "name": "PRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Pru.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "I'm just saying.", "name": "PRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Arthur opens his door and steps out, stretching.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "He kicks a tire with the air of a man who knows it will do nothing.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "I'm going to walk to that farmhouse.", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Take your hat.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "I'm not wearing a hat.", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Take mine.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "He sighs, ducks back in, takes her straw hat from the dashboard, and plops it on his head.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Pru laughs out loud.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "You look like a scarecrow.", "name": "PRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "That's the idea. If anyone sees me, they'll be afraid and give me a lift.", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "Or they'll shoot you.", "name": "PRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "Pru!", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "She has a point.", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "He starts down the gravel road.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Gloria climbs out, shades her eyes, and watches him go.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "Pru slides across the seat, props her chin on the window.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Mom?", "name": "PRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "Yes?", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "This is the best trip we've ever had.", "name": "PRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "We're stranded in a cornfield.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "Sunflowers.", "name": "PRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "Sunflowers.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": ["smiling"], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "A low growl rolls over the horizon.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "Thunder.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "They both look up.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "A line of dark clouds is climbing the sky, fast.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 71, "kind": "dialogue", "text": "Of course.", "name": "GLORIA", "speaker": 0, "ext": ["CONT'D"], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 72, "kind": "dialogue", "text": "Should we get Dad?", "name": "PRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 73, "kind": "dialogue", "text": "He'll find us.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 74, "kind": "dialogue", "text": "Mom, I'm serious.", "name": "PRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 75, "kind": "dialogue", "text": "Arthur!", "name": "GLORIA", "speaker": 0, "ext": [], "paren": ["calling"], "dual": false, "present": [0, 1, 2]}, {"u": 76, "kind": "action", "text": "Far down the road, a small straw-hatted figure turns.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 77, "kind": "action", "text": "Gloria waves her arms.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 78, "kind": "action", "text": "He waves back, cheerful, and keeps walking.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 79, "kind": "dialogue", "text": "He doesn't get it.", "name": "PRU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 80, "kind": "dialogue", "text": "He never does.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 81, "kind": "action", "text": "Wind picks up.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 82, "kind": "action", "text": "Sunflowers bow in a long wave across the field.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 83, "kind": "action", "text": "The first fat raindrop splats on the windshield.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 84, "kind": "action", "text": "Gloria and Pru lock eyes.", "para": 11, "sent": 3, "present": [0, 1, 2]}, {"u": 85, "kind": "dialogue", "text": "Run?", "name": "PRU", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 86, "kind": "dialogue", "text": "Run.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 87, "kind": "action", "text": "They bolt from the minivan, laughing, shrieking, and chase after Arthur through the dust as the sky opens.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 88, "kind": "dialogue", "text": "Oh no.", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": ["turning, seeing them"], "dual": false, "present": [0, 1, 2]}, {"u": 89, "kind": "action", "text": "He starts to run too.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 90, "kind": "action", "text": "The three of them pelt down the road in the downpour, hat flying off, a tiny, soaked, shrieking family under the enormous sky.", "para": 13, "sent": 1, "present": [0, 1, 2]}]}