{"scene_id": "s02038", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02038.fountain", "heading": "INT. GENERATION SHIP \"WILLOW\" - HYDROPONICS BAY - SHIP NIGHT", "cast": [{"id": 0, "name": "AUGUSTINE WRAY", "names": ["AUGUSTINE WRAY", "AUGUSTINE"], "gender": "?", "first": 5, "spoke": 21}, {"id": 1, "name": "TAMSIN ODEH-VARGA", "names": ["TAMSIN ODEH-VARGA", "TAMSIN"], "gender": "f", "first": 6, "spoke": 19}], "units": [{"u": 0, "kind": "heading", "text": "INT. GENERATION SHIP \"WILLOW\" - HYDROPONICS BAY - SHIP NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Terraced troughs of lettuce under violet grow-lamps.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Condensation.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A gentle hum.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Through a long viewport, the stars do not move.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "AUGUSTINE WRAY (70s, caretaker, thin, patient) works along a trough with a pair of tweezers, removing a yellowed leaf.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Behind him, a young woman, TAMSIN ODEH-VARGA (20s, apprentice, coveralls tied around her waist) tends a seedling tray.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Pinch it where it meets the stem. Not above.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "I know.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Then why are you above?", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I'm not above.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He glances at her tray.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She is above.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She moves her fingers down an inch.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He nods and returns to his row.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Every day the same leaf.", "name": "TAMSIN", "speaker": 1, "ext": ["CONT'D"], "paren": ["muttering"], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Every day a different leaf.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "It looks the same.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "That's because you aren't looking.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She sighs.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Wipes her hands on her coveralls.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Looks at the stars.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Two hundred and six years.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "And fourteen days.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "My great-grandmother's great-grandmother boarded this ship.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "And never saw the end of it.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Neither will I.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "No.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Neither will you.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Not at my age, no.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "They work in silence.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "A drip falls from the irrigation line.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Plink.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Tamsin counts the drips on her fingers.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Does anyone else feel strange down here?", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Anyone else would be a crowd.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "I mean the whole ship.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Only the ones who are paying attention.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "She laughs, short.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "He allows himself a small smile and prunes another leaf.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Augustine?", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Yes.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "What do you do when the lettuce is done?", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "We plant more lettuce.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "No. When it is all done. When the ship arrives.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Ah.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "He straightens, one hand on the small of his back.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "He looks at her for a while.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Then somebody takes a seed and puts it in real ground.", "name": "AUGUSTINE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "And the lettuce will think it's dying.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "It will think it's being born.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "Tamsin picks up the tray.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "Carries it to the next trough.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "The violet light moves over her face as she passes under each lamp.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "I hope I'm in the right row, then.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "You are.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "You always say that.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "You always doubt it.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "It's my job to doubt.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "It is mine to be right.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "She sets the seedlings in their slots, firm, careful, pressing each stem upright with a fingertip.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "Augustine watches.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "When she finishes, he picks up the watering can and hands it to her.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "Go on. Slowly.", "name": "AUGUSTINE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "She pours.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "The water hisses on dark soil.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "A faint green smell rises.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "It's quiet tonight.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "It is always quiet.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "Tonight it is different.", "name": "TAMSIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "Then listen.", "name": "AUGUSTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "They stand still, side by side, hands at their sides, and for a long moment there is only the sound of something, very small, growing.", "para": 10, "sent": 0, "present": [0, 1]}]}