{"scene_id": "s02039", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02039.fountain", "heading": "INT. FUNICULAR RAILWAY - MOUNTAIN CAR - NIGHT", "cast": [{"id": 0, "name": "ROSAMUND ACHTERBERG", "names": ["ROSAMUND ACHTERBERG", "ROSAMUND"], "gender": "?", "first": 4, "spoke": 11}, {"id": 1, "name": "NICOLAI VELASQUEZ-BRANDT", "names": ["NICOLAI VELASQUEZ-BRANDT", "NICOLAI"], "gender": "?", "first": 5, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. FUNICULAR RAILWAY - MOUNTAIN CAR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A wooden cabin on rails, climbing a slope so steep the benches are stepped like stairs.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Lantern light.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Black pines slide by the windows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ROSAMUND ACHTERBERG (30s, conductor's cap, a brass ticket punch) stands at the front.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "NICOLAI VELASQUEZ-BRANDT (40s, a long coat, a leather case chained to his wrist) sits at the back.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Tickets, sir.", "name": "ROSAMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "I've paid.", "name": "NICOLAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Then show me.", "name": "ROSAMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He holds up a stub.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She punches it.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Their eyes meet.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She looks at the case.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "That's a lot to carry up a mountain.", "name": "ROSAMUND", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "It's a lot to carry anywhere.", "name": "NICOLAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "The car lurches.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Both grab rails.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "The lantern swings, throwing shadows.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "A second beat, then the car steadies.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Cable's tired. It does that.", "name": "ROSAMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Does it?", "name": "NICOLAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Every night.", "name": "ROSAMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "He releases the rail.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She does not.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She edges closer.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I've been told to watch for a man with a case.", "name": "ROSAMUND", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Told by whom?", "name": "NICOLAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "By a man who says he wants it back.", "name": "ROSAMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "They both lunge.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "The punch clatters across the floor.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "The case skids.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "He kicks it under a bench.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "She seizes his sleeve.", "para": 5, "sent": 4, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "He twists free.", "para": 5, "sent": 5, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "The car pitches and both go sprawling.", "para": 5, "sent": 6, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Rosamund scrambles to the brake lever.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Nicolai grabs her ankle.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "She kicks him off, hauls the lever.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "The car shudders, groans, and stops dead.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Pine needles tick against the glass.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "That was clever.", "name": "NICOLAI", "speaker": 1, "ext": [], "paren": ["panting"], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "I know.", "name": "ROSAMUND", "speaker": 0, "ext": [], "paren": ["panting"], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Now what?", "name": "NICOLAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Now we wait for the man who wants it.", "name": "ROSAMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "You'd rather I hand it over to him?", "name": "NICOLAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "I'd rather live.", "name": "ROSAMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "A pause.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "He slides the case out from under the bench.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "Unlocks the chain.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "Holds it out.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Then you keep it.", "name": "NICOLAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "She doesn't take it.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "A light bobs in the pines below.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "Voices.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "They're early.", "name": "ROSAMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "They were always early.", "name": "NICOLAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "She snatches the case, yanks open the rear door, and shoves him through it into the dark.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "He drops two meters to the slope and rolls.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "She follows, case in her arms, and they run side by side up the mountain through the trees.", "para": 10, "sent": 2, "present": [0, 1]}]}