{"scene_id": "s02040", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02040.fountain", "heading": "INT. WINE-SOAKED FARMHOUSE KITCHEN - 1944 - NIGHT", "cast": [{"id": 0, "name": "SERGEANT EUGENE PAYSON", "names": ["SERGEANT EUGENE PAYSON", "PAYSON"], "gender": "?", "first": 5, "spoke": 13}, {"id": 1, "name": "GI", "names": ["GI"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "MADAME ODILE FAUCHEUX", "names": ["MADAME ODILE FAUCHEUX", "ODILE"], "gender": "?", "first": 5, "spoke": 12}], "units": [{"u": 0, "kind": "heading", "text": "INT. WINE-SOAKED FARMHOUSE KITCHEN - 1944 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cold stove.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A table with two chairs.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A candle in a saucer.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Far off, the rolling thud of a front that is slowly moving away.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SERGEANT EUGENE PAYSON (30s, GI, dirt on his cheek, his helmet on the table) sits across from MADAME ODILE FAUCHEUX (60s, widow, black shawl, a ladle clutched in one hand like a scepter).", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "You've got a nice place, ma'am.", "name": "PAYSON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "It is not nice. It is standing.", "name": "ODILE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Same thing, these days.", "name": "PAYSON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "You are hungry?", "name": "ODILE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Is it that obvious?", "name": "PAYSON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Your stomach has been speaking to me since you entered.", "name": "ODILE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "I'm sorry. I'll tell it to hush.", "name": "PAYSON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "It does not hush. I have a husband of the same nature. He does not hush either.", "name": "ODILE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Where is he?", "name": "PAYSON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "In the orchard.", "name": "ODILE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Working?", "name": "PAYSON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Buried.", "name": "ODILE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "I'm sorry.", "name": "PAYSON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Do not be. He was a very loud man, and now I have the quiet I always wanted.", "name": "ODILE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Lord.", "name": "PAYSON", "speaker": 0, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "You pray?", "name": "ODILE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Not in a long while.", "name": "PAYSON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Then someone should.", "name": "ODILE", "speaker": 2, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "She sets down the ladle.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Ladles stew into a chipped bowl anyway.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Sets it before him.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "He stares at it.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Ma'am, I can't. You've got nothing.", "name": "PAYSON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "I have a pot of something and a young man who has not eaten. This is not nothing.", "name": "ODILE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Ma'am--", "name": "PAYSON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Eat.", "name": "ODILE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "He picks up the spoon.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "The first bite closes his eyes.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "The thud outside drifts farther away.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "That's the best thing I've had in a year.", "name": "PAYSON", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "It is turnips.", "name": "ODILE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "It's the best turnips I've had in a year.", "name": "PAYSON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}