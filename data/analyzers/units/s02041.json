{"scene_id": "s02041", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02041.fountain", "heading": "INT. REPTILE HOUSE AT THE CITY ZOO - AFTER HOURS", "cast": [{"id": 0, "name": "BARNABY OKONKWO-FITCH", "names": ["BARNABY OKONKWO-FITCH", "BARNABY"], "gender": "m", "first": 5, "spoke": 18}, {"id": 1, "name": "PENELOPE ARAKAWA", "names": ["PENELOPE ARAKAWA", "PENELOPE"], "gender": "?", "first": 6, "spoke": 13}], "units": [{"u": 0, "kind": "heading", "text": "INT. REPTILE HOUSE AT THE CITY ZOO - AFTER HOURS", "present": []}, {"u": 1, "kind": "action", "text": "Warm, humid air.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Glass terrariums glowing green and amber.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A heat lamp ticks.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A sign reads: \"PLEASE DO NOT TAP THE GLASS.\"", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "BARNABY OKONKWO-FITCH (40s, zookeeper, khaki shirt, a bucket of dead mice) whistles tunelessly while he refills water dishes.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "His new assistant, PENELOPE ARAKAWA (20s, ponytail, brand-new boots) stands beside him, clutching a clipboard like a shield.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Don't be nervous. They can smell it.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "I'm not nervous.", "name": "PENELOPE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Your hand is white.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "It's the clipboard. It's heavy.", "name": "PENELOPE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "It's cardboard.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She lets go.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "The clipboard slaps to the floor.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She picks it up.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "He pretends not to notice.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Now. This is Gladys.", "name": "BARNABY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He taps a glass.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Inside, a python the thickness of a fire hose lies coiled around a branch, perfectly still.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "She's lovely.", "name": "PENELOPE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "She's a bit shy.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "I can see that.", "name": "PENELOPE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "She likes it quiet. Soft voices. No sudden moves.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Understood.", "name": "PENELOPE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "And she hates hats.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I'm not wearing a hat.", "name": "PENELOPE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Good. Keep it that way.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "He goes to the next case.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "She stays, staring at Gladys, who has not moved.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Penelope tilts her head.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Gladys slowly tilts hers.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Barnaby returns with a mouse in tongs and the bucket under his arm.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "He unlocks the case.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Opens the hatch.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Gladys stirs.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Watch.", "name": "BARNABY", "speaker": 0, "ext": ["CONT'D"], "paren": ["quiet"], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "The snake unspools.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Slow, silent, hypnotic.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "It takes the mouse in a single smooth strike.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Penelope does not flinch.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Barnaby watches her face.", "para": 6, "sent": 4, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "You're good at this.", "name": "BARNABY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "I grew up with a lot of brothers.", "name": "PENELOPE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "That explains it.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "He closes the hatch.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "Dusts his hands.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Then, casually, as if it were nothing:", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "Penelope.", "name": "BARNABY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Yes?", "name": "PENELOPE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Do you know why we feed her at night?", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "So she's calm for the visitors?", "name": "PENELOPE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "No. Because she's gone.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "A beat.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "Penelope looks at the case.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "At the coils.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "At the branch.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "Gladys is exactly where she was.", "para": 8, "sent": 4, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "Perfectly still.", "para": 8, "sent": 5, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "She's right there.", "name": "PENELOPE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "That's a decoy.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "A what?", "name": "PENELOPE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "We made it. Last Tuesday. I was hoping you wouldn't notice.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "Where is she?", "name": "PENELOPE", "speaker": 1, "ext": [], "paren": ["slowly"], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "That's the thing.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "They both look up at the ceiling grate.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "A long, heavy thump echoes through the vent.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "Don't move.", "name": "BARNABY", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "Don't move.", "name": "PENELOPE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "Neither does.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "The vent creaks.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 70, "kind": "action", "text": "Something coils in the dark above them.", "para": 10, "sent": 2, "present": [0, 1]}]}