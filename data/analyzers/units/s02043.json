{"scene_id": "s02043", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02043.fountain", "heading": "INT. ABANDONED AIRPORT CONTROL TOWER - NIGHT", "cast": [{"id": 0, "name": "HARLAN BEAUMONT-DIAZ", "names": ["HARLAN BEAUMONT-DIAZ", "HARLAN"], "gender": "?", "first": 5, "spoke": 4}, {"id": 1, "name": "PILOT", "names": ["PILOT"], "gender": "?", "first": 12, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED AIRPORT CONTROL TOWER - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dusty consoles.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cracked glass on all sides.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single dead radar screen.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Wind whistles through broken panes.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "HARLAN BEAUMONT-DIAZ (30s, flashlight, pry bar) crouches at a radio console, alone.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "He thumbs a dial.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Static.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "dialogue", "text": "Dead. Of course it's dead.", "name": "HARLAN", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0]}, {"u": 9, "kind": "action", "text": "The radio crackles.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "A burst of static.", "para": 2, "sent": 1, "present": [0]}, {"u": 11, "kind": "action", "text": "Then a voice, faint, flat.", "para": 2, "sent": 2, "present": [0]}, {"u": 12, "kind": "dialogue", "text": "Tower, Tower. Do you read? We are inbound. Ten miles. We have lost our lights.", "name": "PILOT", "speaker": 1, "ext": ["V.O."], "paren": ["through static"], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Harlan freezes.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "The flashlight trembles.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "This tower's been closed for thirty years.", "name": "HARLAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Tower, we see the runway. We are coming in. Please light the runway.", "name": "PILOT", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Who is this?", "name": "HARLAN", "speaker": 0, "ext": [], "paren": ["into the mic"], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Tower, please. We cannot see our hands.", "name": "PILOT", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "The radio dies.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Silence.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Then, from the airfield far below, a low drone.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "It grows.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "A pale glow sweeps across the cracked windows, as though something very large is descending.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Harlan backs toward the stairs, trips over the pry bar, and falls.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "The drone swells until the glass shivers in its frames.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Not tonight. Not tonight.", "name": "HARLAN", "speaker": 0, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1]}]}