{"scene_id": "s02044", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02044.fountain", "heading": "EXT. SALT FLAT - DAWN", "cast": [{"id": 0, "name": "CORDELIA ADEBAYO-FROST", "names": ["CORDELIA ADEBAYO-FROST", "CORDELIA"], "gender": "f", "first": 5, "spoke": 11}, {"id": 1, "name": "DEZ", "names": ["DEZ"], "gender": "?", "first": 6, "spoke": 3}, {"id": 2, "name": "MAKINDE", "names": ["MAKINDE"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "STRANGER", "names": ["STRANGER"], "gender": "m", "first": 7, "spoke": 3}, {"id": 4, "name": "TAVITA LEOTA", "names": ["TAVITA LEOTA", "TAVITA"], "gender": "m", "first": 10, "spoke": 7}, {"id": 5, "name": "MATTHIAS", "names": ["MATTHIAS"], "gender": "?", "first": 39, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SALT FLAT - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A blinding plain of cracked white earth under a pink sky.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Heat shimmer does not yet rise.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single abandoned jeep, windshield spiderwebbed, sits sunk to its axles.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Beside it, a tarp stretched on poles makes a shelter no bigger than a closet.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Under the tarp, DR. CORDELIA ADEBAYO-FROST (40s, geologist, sunhat, parched lips) rations water into four tin cups with the fierce concentration of a priest.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Next to her, her field assistant DESMOND \"DEZ\" MAKINDE (20s, bandaged ankle) leans against the jeep's tire, eyes closed.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Further off, a STRANGER sits cross-legged on the salt, facing away, a battered canvas pack beside him.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "He has been there since midnight.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "He has not spoken.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Standing watch at the tarp's edge, TAVITA LEOTA (50s, the driver, wide-shouldered, a rag knotted over his head) scans the horizon through binoculars.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Dez, drink.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Save it.", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Drink.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "He opens his eyes, takes the cup, swallows.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "She watches the cup, not the man.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Nothing moving.", "name": "TAVITA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "There never is, until there is.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "I do not like that one.", "name": "TAVITA", "speaker": 4, "ext": [], "paren": ["lowering the binoculars"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Who?", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "The man.", "name": "TAVITA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "He nods toward the Stranger.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Cordelia looks.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "The Stranger has not moved.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "He sat down and has not asked for anything.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "That is what worries me.", "name": "TAVITA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Maybe he's just tired.", "name": "DEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Tired men ask for water.", "name": "TAVITA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Cordelia rises, takes a fourth cup, crosses the salt.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "The crust crunches.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "She stops a few paces behind the Stranger.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "You are welcome to this.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Thank you, Doctor.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": ["without turning"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "You know who I am.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "I know you came looking for the old brine lake. I came for the same reason.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "He rises, brushes salt from his knees, turns.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Gaunt, sunburnt, mid-fifties, eyes the color of weak tea.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "He takes the cup but doesn't drink.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "And you are?", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Matthias.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Matthias what?", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Matthias is enough.", "name": "MATTHIAS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Doctor! Step back from him.", "name": "TAVITA", "speaker": 4, "ext": [], "paren": ["calling"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Cordelia does not move.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Dez struggles upright.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Matthias glances at Tavita, at Dez, and then at the sky, where a thin line of dust has begun to climb the horizon.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "You should drink that yourselves. A truck is coming.", "name": "MATTHIAS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "Whose truck?", "name": "TAVITA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "Mine.", "name": "MATTHIAS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "A beat.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "Everyone looks at the dust.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "He was waiting for rescue the whole time?", "name": "DEZ", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "No. He was waiting for us.", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "Tavita raises his binoculars, then drops them, and takes a step backward.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "Dez grabs the jeep's hood.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "Cordelia, calm, sets her cup on the salt.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "All four stand frozen under the pink sky as the engine's drone grows.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "Don't be afraid. I only want what you are looking for.", "name": "MATTHIAS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "dialogue", "text": "And if we say no?", "name": "CORDELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "Then you may walk home.", "name": "MATTHIAS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}