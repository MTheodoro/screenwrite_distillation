{"scene_id": "s02048", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02048.fountain", "heading": "INT. CITY HOSPITAL - EMERGENCY ROOM BAY 4 - NIGHT", "cast": [{"id": 0, "name": "FELICITY ABARA-LINDGREN", "names": ["FELICITY ABARA-LINDGREN", "FELICITY"], "gender": "?", "first": 4, "spoke": 8}, {"id": 1, "name": "BROTHER", "names": ["BROTHER"], "gender": "?", "first": 7, "spoke": 3}, {"id": 2, "name": "ANSELMO", "names": ["ANSELMO"], "gender": "?", "first": 11, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. CITY HOSPITAL - EMERGENCY ROOM BAY 4 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Curtains, beeping monitors, a gurney.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A bag of saline drips.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A young man lies on the bed, pale, one arm limp.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. FELICITY ABARA-LINDGREN (40s, scrubs, tired eyes) checks his pulse.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "A tall man in an ill-fitting suit hovers at the curtain: the patient's brother.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "dialogue", "text": "He's stable. For now.", "name": "FELICITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 7, "kind": "dialogue", "text": "Thank God.", "name": "BROTHER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Don't thank anyone yet. Is there any history of heart trouble in your family?", "name": "FELICITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I don't know. We weren't close.", "name": "BROTHER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Your name?", "name": "FELICITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Anselmo.", "name": "BROTHER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Anselmo, I need the truth. What did he take?", "name": "FELICITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Nothing.", "name": "ANSELMO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "His blood says otherwise.", "name": "FELICITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "The monitor beeps faster.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Felicity glances at it, then at the brother, and her tone drops.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "His pressure's falling. Nurse!", "name": "FELICITY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "The brother steps in, grabs her sleeve.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "He took my father's pills. All of them. I watched him.", "name": "ANSELMO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Why didn't you stop him?", "name": "FELICITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Because I wanted to see if he'd really do it.", "name": "ANSELMO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "She stares at him.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Slowly, she pulls her sleeve free.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The monitor settles.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Her voice goes steady.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "He's going to live, Mr. Anselmo. And you are going to sit down and think about what you just said.", "name": "FELICITY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "He sits.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "The curtain swings shut.", "para": 5, "sent": 1, "present": [0, 1, 2]}]}