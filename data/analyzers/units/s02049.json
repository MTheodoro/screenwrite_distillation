{"scene_id": "s02049", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02049.fountain", "heading": "EXT. FLOODED PARKING STRUCTURE - TOP DECK - DAWN", "cast": [{"id": 0, "name": "LOUISA KARAGEORGIOU", "names": ["LOUISA KARAGEORGIOU", "LOUISA"], "gender": "f", "first": 5, "spoke": 13}, {"id": 1, "name": "WILLOW KARAGEORGIOU", "names": ["WILLOW KARAGEORGIOU", "WILLOW"], "gender": "?", "first": 5, "spoke": 7}, {"id": 2, "name": "MAN", "names": ["MAN"], "gender": "?", "first": 16, "spoke": 3}, {"id": 3, "name": "EZRA", "names": ["EZRA"], "gender": "?", "first": 30, "spoke": 7}, {"id": 4, "name": "WOMAN", "names": ["WOMAN"], "gender": "f", "first": 58, "spoke": 1}, {"id": 5, "name": "MARGUERITE", "names": ["MARGUERITE"], "gender": "?", "first": 61, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FLOODED PARKING STRUCTURE - TOP DECK - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Gray water laps at the concrete ramps below.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The top deck is an island: a few abandoned cars, a rusted shopping cart, a blue tarp slung between two sedans.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The sky is the color of dishwater.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Gulls wheel over the drowned city.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Under the tarp, LOUISA KARAGEORGIOU (40s, broad-shouldered, parka tied at the waist) feeds a small fire in a hubcap.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Across from her, her daughter, WILLOW KARAGEORGIOU (15, hood up, a knife on her belt), sharpens a stick with careful strokes.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Careful. You'll lose a finger.", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "I won't.", "name": "WILLOW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "You don't know that.", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I know my fingers.", "name": "WILLOW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "A scrape of metal on the ramp.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "They both freeze.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Louisa raises her hand, flat.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Willow lowers the stick.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "The scrape comes again, closer, then a splash, then a ragged cough.", "para": 2, "sent": 4, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "A MAN crawls up over the ledge, soaked, shaking, one arm hooked over the concrete.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "He is gaunt and gray-bearded, a ring of salt crusted around his lips.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "He drags himself onto the deck and collapses.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Stay behind me.", "name": "LOUISA", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I'm not scared.", "name": "WILLOW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "I didn't say you were.", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Louisa crosses to the man.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Crouches.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Turns him over with the toe of her boot.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "He gasps, blinks up at her.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Water.", "name": "MAN", "speaker": 2, "ext": [], "paren": ["rasping"], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Who are you?", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Please.", "name": "MAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Your name.", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Ezra. Ezra Ng-Halloran. I've been swimming since midnight.", "name": "MAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "From where?", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "The harbor. The ferry sank.", "name": "EZRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "There's no ferry.", "name": "WILLOW", "speaker": 1, "ext": [], "paren": ["from behind her mother"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "There was. Yesterday.", "name": "EZRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Louisa and Willow exchange a look.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Louisa unscrews her canteen and holds it out.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "He drinks like a drowning man.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "She takes it away after three swallows.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "That's enough.", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Thank you.", "name": "EZRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Don't thank me yet. Are you alone?", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Yes.", "name": "EZRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "He's lying.", "name": "WILLOW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "I'm not--", "name": "EZRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "He looked at the stairwell.", "name": "WILLOW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "All three turn their heads toward the stairwell door.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "It is closed.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "The wind rattles its handle.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Willow. Get the tarp rope.", "name": "LOUISA", "speaker": 0, "ext": [], "paren": ["very quiet"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Why?", "name": "WILLOW", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Just get it.", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Willow scrambles for the rope.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Louisa stands, drawing a flare gun from her coat.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Ezra holds up both hands, palms out, eyes wide.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Please, it's not what you think.", "name": "EZRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "What do I think?", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "The stairwell door rattles harder, then bursts open.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "A WOMAN in a dripping yellow slicker staggers out, a gun in her fist.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "The four of them stand in a tight, shuddering ring, no one breathing.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "Ezra! You stupid, stupid man!", "name": "WOMAN", "speaker": 4, "ext": [], "paren": ["shouting"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "Marguerite.", "name": "EZRA", "speaker": 3, "ext": [], "paren": ["weak, relieved"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "She lowers the gun.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "Looks at Louisa.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "At Willow.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "Her shoulders sag.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "dialogue", "text": "We saw smoke.", "name": "MARGUERITE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "dialogue", "text": "So did everyone.", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "dialogue", "text": "We have a boat. We have room.", "name": "MARGUERITE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "action", "text": "Louisa lowers the flare gun, slowly.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "action", "text": "Willow lets out a breath.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "action", "text": "The gulls cry.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "action", "text": "Nobody smiles, but the fire burns a little higher.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}]}