{"scene_id": "s02050", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02050.fountain", "heading": "INT. ORBITAL RECYCLING DEPOT - SORTING FLOOR - SHIFT CHANGE", "cast": [{"id": 0, "name": "KIRA ASANTE-VOLKOV", "names": ["KIRA ASANTE-VOLKOV", "KIRA"], "gender": "?", "first": 4, "spoke": 3}, {"id": 1, "name": "DMITRI OLUWASEUN", "names": ["DMITRI OLUWASEUN", "DMITRI"], "gender": "m", "first": 6, "spoke": 3}, {"id": 2, "name": "INSPECTOR LEOPOLDINE HARGROVE-SATO", "names": ["INSPECTOR LEOPOLDINE HARGROVE-SATO", "LEOPOLDINE"], "gender": "?", "first": 21, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. ORBITAL RECYCLING DEPOT - SORTING FLOOR - SHIFT CHANGE", "present": []}, {"u": 1, "kind": "action", "text": "Conveyor belts shuttle crushed satellites past a gantry.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sparks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The smell of hot solder.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "KIRA ASANTE-VOLKOV (30s, sorter, welding mask pushed up) pulls a gray panel off the belt, turns it over.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "A strip of tape on the back: a name, scratched through.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Across the floor, DMITRI OLUWASEUN (50s, shift lead, clipboard) watches her.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He does not look at the panel.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He looks at her hands.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "This is from Sector Nine.", "name": "KIRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Everything's from Sector Nine.", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "It's still warm.", "name": "KIRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He sets down the clipboard.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Walks over.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Slowly.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "The belt grinds.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Put it back.", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "It has a serial.", "name": "KIRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Put it back on the belt.", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She doesn't.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "A door hisses open at the far end.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "A third figure strides in: INSPECTOR LEOPOLDINE HARGROVE-SATO (40s, gray coat, a slim case).", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "The belts slow, then stop.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Silence.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Good morning. Please step away from the panel.", "name": "LEOPOLDINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Kira lowers it.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Dmitri straightens, pulls his clipboard to his chest.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Which of you is Asante-Volkov?", "name": "LEOPOLDINE", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Neither answers.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "The belt starts again, with a lurch.", "para": 6, "sent": 1, "present": [0, 1, 2]}]}