{"scene_id": "s02051", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02051.fountain", "heading": "INT. NIGHT FERRY - OBSERVATION LOUNGE - NIGHT", "cast": [{"id": 0, "name": "CLEMENTINE ABIODUN-WRIGHT", "names": ["CLEMENTINE ABIODUN-WRIGHT", "CLEMENTINE"], "gender": "f", "first": 5, "spoke": 9}, {"id": 1, "name": "ISAAC VANDERHOEK-MWANGI", "names": ["ISAAC VANDERHOEK-MWANGI", "ISAAC"], "gender": "?", "first": 8, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT FERRY - OBSERVATION LOUNGE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Empty vinyl seats.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A vending machine glowing blue.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Black water slides past the windows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The engine thrums like a cat.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CLEMENTINE ABIODUN-WRIGHT (30s) sits with a paperback open and unread on her knee.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She has a coat draped over her shoulders.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She keeps turning the same page.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "ISAAC VANDERHOEK-MWANGI (30s) comes in from the deck with two paper cups.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He stops at the door.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He lifts one cup in an offer.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She looks up.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She nods.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He crosses the lounge.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Sits one seat away.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Hands her a cup.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She takes it.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Their fingers do not touch.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Thanks.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "It's terrible.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "I figured.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She sips.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Grimaces.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "He grins at his own cup.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Nine years.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Sorry?", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Nothing. Just counting.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "She sets the book on the seat between them.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "He glances at it.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Reads the spine.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "She notices.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "You've read it.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "You gave it to me.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Did I?", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Third floor, Lincoln Street. You said it would change my life.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Did it?", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Not really.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "She laughs.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "A real one, quick and surprised.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "He watches her do it.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "All right, ferry. All right.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": ["to the empty room"], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Who are you talking to?", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "The whole boat. It's been listening all night.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "He looks at the empty seats.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "At the black windows.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "At her.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Then let's give it something to hear.", "name": "ISAAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "She reaches for the book.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Opens it to the page she was stuck on.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "Hands it to him.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Read me this part.", "name": "CLEMENTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "He takes it.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "Begins, quietly.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "She listens, head tilted, cup warm in both hands.", "para": 10, "sent": 2, "present": [0, 1]}]}