{"scene_id": "s02052", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02052.fountain", "heading": "INT. ROOFTOP GREENHOUSE RESTAURANT - NIGHT", "cast": [{"id": 0, "name": "NAOMI ABERFORTH-KANE", "names": ["NAOMI ABERFORTH-KANE", "NAOMI"], "gender": "f", "first": 5, "spoke": 9}, {"id": 1, "name": "TEODOR VASILEV-OSEI", "names": ["TEODOR VASILEV-OSEI", "TEODOR"], "gender": "f", "first": 9, "spoke": 9}, {"id": 2, "name": "WAITER", "names": ["WAITER"], "gender": "?", "first": 28, "spoke": 2}, {"id": 3, "name": "WOMAN", "names": ["WOMAN"], "gender": "?", "first": 46, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROOFTOP GREENHOUSE RESTAURANT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Candles in jam jars.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fairy lights.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single table set for two among rows of tomato plants.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The city glitters beyond the glass.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "NAOMI ABERFORTH-KANE (30s, silk dress, nervous hands) adjusts a fork.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Straightens it.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Looks at the empty chair.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "Footsteps.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "TEODOR VASILEV-OSEI (30s, rumpled suit, a bouquet of grocery-store carnations) skids around the corner of a tomato row.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I'm late.", "name": "TEODOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "You're eleven minutes late.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Eleven. Not twelve.", "name": "TEODOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Eleven and a half.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He holds out the carnations.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She stares at them.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Then, helplessly, smiles.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He sits.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "They look at each other across the candle.", "para": 3, "sent": 4, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "You came.", "name": "NAOMI", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Of course I came.", "name": "TEODOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Last time you didn't.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Last time my mother was in the hospital.", "name": "TEODOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "I know. I'm sorry. I just--", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "No. It's fair.", "name": "TEODOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "She puts her napkin in her lap.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "He picks up the menu without opening it.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "They both laugh at the same moment, then stop.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "A WAITER in a green apron glides up, notepad ready.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "He is very young, very solemn.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Good evening. Is this a celebration?", "name": "WAITER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Maybe.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Possibly.", "name": "TEODOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "I'll bring something special.", "name": "WAITER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "He glides off.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Naomi covers her mouth.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Teodor reaches across and takes her hand.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "She lets him.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "He's going to bring us a cake.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "He's going to bring us a cake.", "name": "TEODOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Then Naomi's face changes.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "She looks over his shoulder, past the tomato plants, at the stairwell door.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Teodor.", "name": "NAOMI", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "What?", "name": "TEODOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Don't turn around.", "name": "NAOMI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "He turns around.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "In the doorway, a WOMAN in a red coat stands very still, a suitcase at her feet.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Marisol.", "name": "TEODOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "The Waiter returns with a tiny cake and a single candle.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "He stops, takes in the scene, and quietly sets the cake in the middle of the table.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Nobody touches it.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}]}