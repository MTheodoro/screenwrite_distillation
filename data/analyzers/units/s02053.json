{"scene_id": "s02053", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02053.fountain", "heading": "EXT. SANDBAGGED FIELD HOSPITAL - TUNISIA DESERT - DAY", "cast": [{"id": 0, "name": "SISTER MARGUERITE OLORUNFEMI-DAVIES", "names": ["SISTER MARGUERITE OLORUNFEMI-DAVIES", "MARGUERITE"], "gender": "?", "first": 7, "spoke": 8}, {"id": 1, "name": "CAPTAIN JOSIAH TREMBLAY-ASANTE", "names": ["CAPTAIN JOSIAH TREMBLAY-ASANTE", "JOSIAH"], "gender": "m", "first": 8, "spoke": 9}, {"id": 2, "name": "PRIVATE HAKON BJORKLUND-RAMIREZ", "names": ["PRIVATE HAKON BJORKLUND-RAMIREZ", "HAKON"], "gender": "m", "first": 9, "spoke": 7}, {"id": 3, "name": "SERGEANT PERPETUA ADEYEMI-STONE", "names": ["SERGEANT PERPETUA ADEYEMI-STONE", "PERPETUA"], "gender": "f", "first": 10, "spoke": 12}, {"id": 4, "name": "COLONEL BARNABAS WHITLOCK-NKEMELU", "names": ["COLONEL BARNABAS WHITLOCK-NKEMELU"], "gender": "?", "first": 11, "spoke": 0}, {"id": 5, "name": "WHITLOCK", "names": ["WHITLOCK"], "gender": "m", "first": 11, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SANDBAGGED FIELD HOSPITAL - TUNISIA DESERT - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A tent village of bleached canvas and red-cross banners.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dust.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Generators.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A string of ambulances nosed up against the sandbags.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Heat shimmers over everything.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "Far to the east, artillery grumbles like distant furniture being moved.", "para": 0, "sent": 5, "present": []}, {"u": 7, "kind": "action", "text": "SISTER MARGUERITE OLORUNFEMI-DAVIES (30s, white apron gone yellow, sleeves rolled) pushes a gurney between tents.", "para": 1, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Walking beside her, CAPTAIN JOSIAH TREMBLAY-ASANTE (40s, surgeon, eyes red from lack of sleep) carries a bag of plasma.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "At the edge of the tent village, PRIVATE HAKON BJORKLUND-RAMIREZ (20s, rifle, a shaving cut on his jaw) stands watch beside a water barrel.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Next to him, SERGEANT PERPETUA ADEYEMI-STONE (30s, sunburnt nose, field cap) scans the horizon with binoculars.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Under a canvas awning, COLONEL BARNABAS WHITLOCK-NKEMELU (60s, gray moustache, a field desk piled with paper) writes with a stub of pencil.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Captain, he's bleeding through again.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "I see it.", "name": "JOSIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Should I--", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Wait.", "name": "JOSIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "They reach a tent flap.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Josiah ducks inside.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Marguerite parks the gurney and steps back, hands on hips, drawing a long breath.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Sergeant, is that thunder?", "name": "HAKON", "speaker": 2, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "It's the guns.", "name": "PERPETUA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "It sounds different.", "name": "HAKON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "It's closer.", "name": "PERPETUA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Closer to who?", "name": "HAKON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "To us, Private.", "name": "PERPETUA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "He glances at the barrel.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "She keeps scanning.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Wind lifts a corner of the tent.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "A flap slaps.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Sergeant Adeyemi-Stone.", "name": "WHITLOCK", "speaker": 5, "ext": [], "paren": ["without looking up"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Sir?", "name": "PERPETUA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "What does it look like?", "name": "WHITLOCK", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Dust, sir. A lot of it. A column, maybe. Fifteen miles.", "name": "PERPETUA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Ours or theirs?", "name": "WHITLOCK", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Can't tell yet.", "name": "PERPETUA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Tell me when you can.", "name": "WHITLOCK", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "She nods.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "He returns to his paper.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "She and Hakon exchange a look.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Sergeant, we have two ambulances unloading. Do I ready beds?", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": ["calling over"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Ready the beds.", "name": "PERPETUA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Ready the beds?", "name": "HAKON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "You heard.", "name": "PERPETUA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Marguerite is already moving.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Josiah reappears from the tent, wiping his hands on a cloth.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "How many?", "name": "JOSIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Two ambulances, six stretchers.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "All walking?", "name": "JOSIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "Two are not.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "They never are.", "name": "JOSIAH", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "Sergeant, the dust is turning.", "name": "HAKON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "Where?", "name": "PERPETUA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "Toward us.", "name": "HAKON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "Whitlock lays down his pencil.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "Rises, slow.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "Shades his eyes.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "Everyone, listen. Pack the instruments. Load what we can carry. We move at dusk.", "name": "WHITLOCK", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "We have fourteen men who cannot move.", "name": "JOSIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "dialogue", "text": "Then they stay with a medic and a white flag.", "name": "WHITLOCK", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "I'll stay.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "No, I will.", "name": "JOSIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "dialogue", "text": "Captain--", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "dialogue", "text": "You will lead the others, Sister. You know the road.", "name": "JOSIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "dialogue", "text": "Sir, we have a truck.", "name": "PERPETUA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "dialogue", "text": "One truck.", "name": "WHITLOCK", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "dialogue", "text": "One truck, yes, sir. And a jeep.", "name": "PERPETUA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "dialogue", "text": "Then we will take them both.", "name": "WHITLOCK", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "dialogue", "text": "And if the dust is ours?", "name": "HAKON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "dialogue", "text": "Then we will have wasted an afternoon.", "name": "WHITLOCK", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "action", "text": "He turns back to his desk, sits, takes up his pencil, and resumes writing.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "action", "text": "His hand is steady.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "action", "text": "Marguerite and Josiah look at each other, then at the bleeding man on the gurney.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "dialogue", "text": "We can still do this one.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "dialogue", "text": "We can.", "name": "JOSIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "action", "text": "They push the gurney together into the tent.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 75, "kind": "action", "text": "Hakon wipes his forehead.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 76, "kind": "action", "text": "Perpetua lowers the binoculars, wipes the lenses on her sleeve, and raises them again.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 77, "kind": "dialogue", "text": "Come on. Show me a flag.", "name": "PERPETUA", "speaker": 3, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 78, "kind": "action", "text": "The dust column swells over the ridge, brown against the white sky, and keeps coming.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}