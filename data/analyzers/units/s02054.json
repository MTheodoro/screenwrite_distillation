{"scene_id": "s02054", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02054.fountain", "heading": "INT. FAMILY DINING ROOM - SUNDAY DINNER", "cast": [{"id": 0, "name": "BEATRICE MONTGOMERY-AKINYEMI", "names": ["BEATRICE MONTGOMERY-AKINYEMI", "MONTGOMERY-AKINYEMI", "BEATRICE"], "gender": "f", "first": 5, "spoke": 14}, {"id": 1, "name": "TEDDY", "names": ["TEDDY"], "gender": "m", "first": 6, "spoke": 13}], "units": [{"u": 0, "kind": "heading", "text": "INT. FAMILY DINING ROOM - SUNDAY DINNER", "present": []}, {"u": 1, "kind": "action", "text": "A long table, a good cloth, a roast chicken half carved.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Two places set.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Six empty chairs.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Steam rises from a gravy boat nobody has touched.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "BEATRICE MONTGOMERY-AKINYEMI (60s, pearls, apron over her Sunday dress) carves with unnecessary force.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across the table, her son THEODORE \"TEDDY\" MONTGOMERY-AKINYEMI (30s, tie loosened, jaw tight) stirs his peas.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Everyone's welcome to begin.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Mama, there's no one else.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Then no one shall be offended.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She serves him a slice.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Sets the platter down.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Sits.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Your father always said grace.", "name": "BEATRICE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "I'm aware.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Someone should.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Fine. Bless this food.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Amen.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "They eat.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Forks clink.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "The clock ticks.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Too dry.", "name": "BEATRICE", "speaker": 0, "ext": ["CONT'D"], "paren": ["to herself"], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "It's fine.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "It is not fine. I overcooked it.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Mama.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I overcooked it because I was thinking about your sister.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Teddy sets down his fork.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Don't.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Eight years, Theodore. Eight years she has not sat in that chair.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "She has her reasons.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "She has a grudge.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "She has a reason!", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "His voice cracks across the table.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Beatrice flinches.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "A pause.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Teddy pushes back his chair.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "You want to know why she doesn't come? Because every Sunday you set six empty places and call it hope.", "name": "TEDDY", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "It is hope.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "It's a stage set!", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "How dare you.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "How dare I?", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "He stands.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "The cloth drags.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Gravy slops.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Sit down.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "No.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Sit down, Theodore.", "name": "BEATRICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "I'm thirty-four years old.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "He walks out.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "The front door slams.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "Beatrice sits alone, staring at the empty chairs.", "para": 7, "sent": 2, "present": [0, 1]}]}