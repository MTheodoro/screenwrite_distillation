{"scene_id": "s02055", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02055.fountain", "heading": "INT. SCHOOL BAND ROOM - AFTER HOURS", "cast": [{"id": 0, "name": "JUBILEE ADEBAYO-MORROW", "names": ["JUBILEE ADEBAYO-MORROW", "JUBILEE"], "gender": "m", "first": 6, "spoke": 22}, {"id": 1, "name": "HOLLY", "names": ["HOLLY"], "gender": "?", "first": 7, "spoke": 28}, {"id": 2, "name": "PRZYBYLSKI", "names": ["PRZYBYLSKI"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "MOM", "names": ["MOM"], "gender": "?", "first": 39, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. SCHOOL BAND ROOM - AFTER HOURS", "present": []}, {"u": 1, "kind": "action", "text": "A cramped practice room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Gray carpet, acoustic foam on the walls, a battered upright piano, music stands knocked askew.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single lamp glows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "On the shelf, a row of dusty trophies.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Rain on the high window.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "JUBILEE ADEBAYO-MORROW (16, braces, oversize cardigan, a trombone case at her feet) perches on the piano bench, picking at a loose thread.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Across the room, HOLDEN \"HOLLY\" PRZYBYLSKI (17, drum sticks tucked behind one ear, band jacket, a skateboard under one arm) leans in the doorway.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "They said you quit.", "name": "HOLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "I didn't quit.", "name": "JUBILEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "They said it at assembly. Mr. Dunphy said it.", "name": "HOLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Mr. Dunphy says a lot of things.", "name": "JUBILEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "He said you were \"taking a break.\"", "name": "HOLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "It's a break.", "name": "JUBILEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "From what?", "name": "HOLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "From being second chair.", "name": "JUBILEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "You're not second chair.", "name": "HOLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I'm second to Ingrid.", "name": "JUBILEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Ingrid has a private tutor.", "name": "HOLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Ingrid has a private everything.", "name": "JUBILEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "So what?", "name": "HOLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "So I can't win.", "name": "JUBILEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Jubilee.", "name": "HOLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "What?", "name": "JUBILEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "It's a trombone, not a war.", "name": "HOLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "You don't understand.", "name": "JUBILEE", "speaker": 0, "ext": [], "paren": ["sharply"], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Then explain.", "name": "HOLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "It's not that I'm not good. It's that I'm good and it doesn't matter.", "name": "JUBILEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "It matters to me.", "name": "HOLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "You're a drummer.", "name": "JUBILEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "I'm a drummer who listens.", "name": "HOLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "To what?", "name": "JUBILEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "To you. Every Tuesday. Through the wall.", "name": "HOLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "That's creepy.", "name": "JUBILEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "It's the practice room next door.", "name": "HOLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "It's still creepy.", "name": "JUBILEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "It's the best thing I hear all week.", "name": "HOLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "A phone rings, muffled, from inside Holly's jacket.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "He fishes it out, glances at the screen.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Hey, Mom. No. I'm still at school. No, I'm fine.", "name": "HOLLY", "speaker": 1, "ext": ["CONT'D"], "paren": ["into phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Holden, it's nine o'clock. Where are you?", "name": "MOM", "speaker": 3, "ext": ["V.O."], "paren": ["tinny"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Band room. Helping a friend.", "name": "HOLLY", "speaker": 1, "ext": [], "paren": ["into phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Which friend?", "name": "MOM", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Jubilee.", "name": "HOLLY", "speaker": 1, "ext": [], "paren": ["into phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "The trombone girl?", "name": "MOM", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Mom.", "name": "HOLLY", "speaker": 1, "ext": [], "paren": ["into phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "I'm only asking.", "name": "MOM", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "I'll be home soon.", "name": "HOLLY", "speaker": 1, "ext": [], "paren": ["into phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "He hangs up.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Pockets the phone.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Jubilee is watching him.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "She knows about me?", "name": "JUBILEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Everyone knows about you.", "name": "HOLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "What do they know?", "name": "JUBILEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "That you're really good. And that you're pretending you're not.", "name": "HOLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "I'm not pretending.", "name": "JUBILEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Okay.", "name": "HOLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "I'm not.", "name": "JUBILEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "Jubilee, play something.", "name": "HOLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "Now?", "name": "JUBILEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "Now.", "name": "HOLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "There's nobody here.", "name": "JUBILEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "I'm here.", "name": "HOLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "A long silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "Rain on the window.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "Jubilee looks at the case, then at him.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "What do you want to hear?", "name": "JUBILEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "Whatever you were going to play before you quit.", "name": "HOLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "She snaps the latches open.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "Lifts the trombone.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "Slides the slide out, slow, like a drawn breath.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "dialogue", "text": "It's not finished.", "name": "JUBILEE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "Neither am I.", "name": "HOLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "action", "text": "She raises the horn.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "He crosses the room, sits on an upturned bucket, and pulls out his sticks.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "He taps the lid of the piano once, softly, counting her in.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}]}