{"scene_id": "s02056", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02056.fountain", "heading": "INT. SYNERGY LOGISTICS - OPEN-PLAN OFFICE - MORNING", "cast": [{"id": 0, "name": "TRENT OKAFOR-BUCHANAN", "names": ["TRENT OKAFOR-BUCHANAN", "TRENT"], "gender": "?", "first": 4, "spoke": 13}, {"id": 1, "name": "DELPHINE ACHEBE-MARCH", "names": ["DELPHINE ACHEBE-MARCH", "DELPHINE"], "gender": "f", "first": 5, "spoke": 11}, {"id": 2, "name": "WALLY", "names": ["WALLY"], "gender": "?", "first": 6, "spoke": 14}, {"id": 3, "name": "PRZYBYLSKI-ODUYA", "names": ["PRZYBYLSKI-ODUYA"], "gender": "?", "first": 6, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. SYNERGY LOGISTICS - OPEN-PLAN OFFICE - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Rows of identical desks under beige light.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A motivational poster: \"TEAMWORK: BECAUSE BLAME IS BETTER SHARED.\"", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A fern in the corner, plastic.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "TRENT OKAFOR-BUCHANAN (40s, regional director, a lanyard, a mug that says WORLD'S OKAYEST BOSS) stands at a whiteboard.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "DELPHINE ACHEBE-MARCH (30s, analyst, cardigan, hair in a clip) sits with a laptop.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "WALTER \"WALLY\" PRZYBYLSKI-ODUYA (50s, procurement, bifocals, a stress ball) lounges back with his feet up.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Okay, so the quarterly numbers.", "name": "TRENT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "They're down.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "They're soft.", "name": "WALLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "They're down but they're soft.", "name": "TRENT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "They're down by thirty-one percent.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Which is soft.", "name": "WALLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Delphine, what does the model say?", "name": "TRENT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "The model says we lost the Henderson account.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Which wasn't ours.", "name": "WALLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "It was ours in March.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "In March everything was ours.", "name": "WALLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Okay. So, whose fault is it?", "name": "TRENT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "It's no one's--", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Procurement was clean.", "name": "WALLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "--no one's fault, Trent, it's the market--", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "It has to be someone's fault.", "name": "TRENT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "It's Delphine's.", "name": "WALLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Excuse me?", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "She flagged it late.", "name": "WALLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "I flagged it in February!", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "After the horse left the barn.", "name": "WALLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "There was no barn!", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Guys! Guys.", "name": "TRENT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "He holds up a marker.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "They go still.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Trent turns to the whiteboard and writes, with great seriousness, the word: LEARNINGS.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Let's circle back.", "name": "TRENT", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "I hate circling back.", "name": "WALLY", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "What was that?", "name": "TRENT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "I love it.", "name": "WALLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Delphine closes her laptop with a loud snap and stands.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "I'm going to get coffee.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "We're in a meeting.", "name": "TRENT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "It's a stand-up. I'm standing.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "She exits.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Wally and Trent stare at the empty chair.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "The fern's plastic leaves tremble in her wake.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "She's gonna blame me for that.", "name": "WALLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Who?", "name": "TRENT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Her. Or him. Or someone.", "name": "WALLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "You think she's going to blame you for her leaving?", "name": "TRENT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "She will. It's her fault, really.", "name": "WALLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Then who's going to take the minutes?", "name": "TRENT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Not me.", "name": "WALLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Not me.", "name": "TRENT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "They look at the whiteboard.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "LEARNINGS.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Underneath, nothing.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}]}