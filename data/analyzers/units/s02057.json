{"scene_id": "s02057", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02057.fountain", "heading": "INT. RAILWAY STATION PLATFORM - NIGHT", "cast": [{"id": 0, "name": "MAN", "names": ["MAN"], "gender": "m", "first": 4, "spoke": 4}, {"id": 1, "name": "WOMAN", "names": ["WOMAN"], "gender": "?", "first": 6, "spoke": 4}, {"id": 2, "name": "CORDELIA", "names": ["CORDELIA"], "gender": "?", "first": 14, "spoke": 2}, {"id": 3, "name": "JULIAN", "names": ["JULIAN"], "gender": "?", "first": 15, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. RAILWAY STATION PLATFORM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A slow rain.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "An empty platform.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A bench, a vending machine, a clock stopped at ten past nine.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A MAN in a rumpled overcoat steps off the last train, looks left, looks right, sets down his suitcase, picks it up again.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He circles the bench once and sits, and a woman in a green scarf, who has been waiting at the far end with her umbrella tucked under her arm, stands, walks the length of the platform, stops six feet away, glances at the stopped clock, and tilts her head at him.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "dialogue", "text": "Excuse me. Are you the man from the telegram?", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "I might be.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "It said to look for a gray overcoat and a suitcase with a broken latch.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "That could be a thousand men.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "At ten past nine on a Tuesday?", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "It's a small town.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She laughs.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He rises, pulling his suitcase after him like a sleeping dog, and they both turn at the same instant as the platform lamps flicker, and she steps closer, and he steps closer, and they stop.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "My name is Cordelia.", "name": "WOMAN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Julian.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Julian.", "name": "CORDELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Cordelia.", "name": "JULIAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "They both say each other's names again at the same time, then fall silent.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "He holds out the suitcase.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "She takes it.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "The latch snaps open.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "A bundle of letters tumbles out.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "You kept them.", "name": "CORDELIA", "speaker": 2, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Every one.", "name": "JULIAN", "speaker": 3, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "She kneels.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "He kneels.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Their hands meet over the pile and rest there.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "The rain thickens.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "A distant whistle.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Neither moves.", "para": 4, "sent": 5, "present": [0, 1, 2, 3]}]}