{"scene_id": "s02058", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02058.fountain", "heading": "INT. COURTHOUSE CORRIDOR - OUTSIDE ROOM 4B - DAY", "cast": [{"id": 0, "name": "MAN", "names": ["MAN"], "gender": "m", "first": 5, "spoke": 5}, {"id": 1, "name": "ATTORNEY GWENDOLEN ADEYEMI-STRAND", "names": ["ATTORNEY GWENDOLEN ADEYEMI-STRAND", "GWENDOLEN"], "gender": "f", "first": 8, "spoke": 10}, {"id": 2, "name": "OFFICER PRIMROSE OKONJO-HALE", "names": ["OFFICER PRIMROSE OKONJO-HALE", "PRIMROSE"], "gender": "?", "first": 16, "spoke": 1}, {"id": 3, "name": "EVERETT", "names": ["EVERETT"], "gender": "?", "first": 26, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. COURTHOUSE CORRIDOR - OUTSIDE ROOM 4B - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A long marble hallway.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Benches.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A water fountain that nobody uses.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A clock ticking too loudly.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A MAN sits alone on the far bench, a folder in his lap, a briefcase at his feet.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Hands folded.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "He looks at nobody.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "ATTORNEY GWENDOLEN ADEYEMI-STRAND (40s, charcoal suit, a stack of exhibits under one arm) approaches, stops two benches away, and sits.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "She does not look at him either.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "After a long moment, he speaks.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Do I know you?", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "You've seen my brief.", "name": "GWENDOLEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Yes.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Then you know me.", "name": "GWENDOLEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "He nods.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "A bailiff, OFFICER PRIMROSE OKONJO-HALE (30s, uniform pressed, a ring of keys), passes with a clipboard.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "She glances at them both, slows, then moves on.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Is it always this quiet?", "name": "MAN", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Before the verdict? Yes.", "name": "GWENDOLEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "After?", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Depends on the verdict.", "name": "GWENDOLEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "He shifts the folder on his knees.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "His thumbs press its edges.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The clock ticks.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Gwendolen sets her exhibits down and straightens them, edges aligned.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "I'm Everett.", "name": "MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Mr. Rutherford-Lowe. I know.", "name": "GWENDOLEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "I didn't think you would.", "name": "EVERETT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "I read the file.", "name": "GWENDOLEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "All of it?", "name": "EVERETT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "All of it.", "name": "GWENDOLEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Then you know what I did.", "name": "EVERETT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "I know what you're accused of.", "name": "GWENDOLEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "He smiles at the floor.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "A small, tired smile.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "The door to 4B opens.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Officer Primrose Okonjo-Hale stands there, holding it.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Counsel. Mr. Rutherford-Lowe. They're ready.", "name": "PRIMROSE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Everett stands.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "So does Gwendolen.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "She collects her exhibits.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "For a moment they stand shoulder to shoulder, facing the door.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Mr. Rutherford-Lowe.", "name": "GWENDOLEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Yes?", "name": "EVERETT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Whatever happens, keep your hands where they are.", "name": "GWENDOLEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "He looks down.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "His hands, folded, are trembling.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "He tightens them.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "They go still.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}]}