{"scene_id": "s02059", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02059.fountain", "heading": "INT. HOUSEBOAT SALON - CANAL AMSTERDAM - NIGHT", "cast": [{"id": 0, "name": "INSPECTOR LEOPOLD VAN DER MEULEN-OSEI", "names": ["INSPECTOR LEOPOLD VAN DER MEULEN-OSEI", "LEOPOLD"], "gender": "m", "first": 7, "spoke": 17}, {"id": 1, "name": "MADAME CATHERINE ABERNATHY-DUPRE", "names": ["MADAME CATHERINE ABERNATHY-DUPRE", "CATHERINE"], "gender": "f", "first": 8, "spoke": 7}, {"id": 2, "name": "TOBY", "names": ["TOBY"], "gender": "?", "first": 9, "spoke": 9}, {"id": 3, "name": "NGUYEN-HARTMANN", "names": ["NGUYEN-HARTMANN"], "gender": "?", "first": 9, "spoke": 0}, {"id": 4, "name": "CLEMENTINE ODUYA-BRANDT", "names": ["CLEMENTINE ODUYA-BRANDT", "CLEMENTINE"], "gender": "f", "first": 10, "spoke": 6}, {"id": 5, "name": "BRUNO ADELEKE-FISCHER", "names": ["BRUNO ADELEKE-FISCHER", "BRUNO"], "gender": "?", "first": 11, "spoke": 8}, {"id": 6, "name": "SISTER IMOGEN FAIRBANKS-TEMBO", "names": ["SISTER IMOGEN FAIRBANKS-TEMBO", "IMOGEN"], "gender": "?", "first": 12, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOUSEBOAT SALON - CANAL AMSTERDAM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A narrow wooden cabin crammed with antique clocks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A potbellied stove.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A low table with a half-eaten cheese board.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain drums on the roof.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Candles.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "Six people, one body in the corner under a tablecloth.", "para": 0, "sent": 5, "present": []}, {"u": 7, "kind": "action", "text": "INSPECTOR LEOPOLD VAN DER MEULEN-OSEI (50s, pipe, a fold of paper in his pocket) paces the length of the room.", "para": 1, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "At the stove, MADAME CATHERINE ABERNATHY-DUPRE (60s, rings, silk robe) warms her hands.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "On the sofa, TOBIAS \"TOBY\" NGUYEN-HARTMANN (30s, in his socks, a glass of whiskey).", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Beside him, CLEMENTINE ODUYA-BRANDT (20s, long braids, a shoebox on her knees).", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "In the armchair, BRUNO ADELEKE-FISCHER (50s, a sleeping cap pushed back).", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "At the window, SISTER IMOGEN FAIRBANKS-TEMBO (40s, habit, rosary).", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "Ladies and gentlemen, I would like silence.", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "You've had silence for an hour.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "You've had it and you've done nothing with it.", "name": "BRUNO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "I have been thinking.", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "We could hear you thinking. You hum.", "name": "CATHERINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "Everyone, please, remain where you are.", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "Why would anyone move?", "name": "CLEMENTINE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "There is a body, child.", "name": "IMOGEN", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "I know there's a body, Sister.", "name": "CLEMENTINE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Can we talk about the body?", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "No.", "name": "BRUNO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "Yes.", "name": "CATHERINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "Madame Abernathy-Dupre, you found him.", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "I did.", "name": "CATHERINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "And you screamed.", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "Of course I screamed.", "name": "CATHERINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "Mr. Ngu-- Mr. Nguyen-Hartmann, you ran in first.", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "I was in the kitchen.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "You were in the hallway.", "name": "BRUNO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "I was walking through the hallway to the kitchen.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "He had his shoes on.", "name": "CLEMENTINE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "So?", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "Now he's in his socks.", "name": "CLEMENTINE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "Silence.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "The stove ticks.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "A clock chimes, then another, a few seconds out of step.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "Mr. Nguyen-Hartmann, where are your shoes?", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "By the door.", "name": "TOBY", "speaker": 2, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "dialogue", "text": "Then why did you take them off?", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "dialogue", "text": "Because they were wet.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "dialogue", "text": "Wet from what?", "name": "IMOGEN", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "dialogue", "text": "The deck. Rain.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "The deck. The deck. Of course.", "name": "CATHERINE", "speaker": 1, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "dialogue", "text": "Sister Imogen, you were at the window.", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "dialogue", "text": "I was praying.", "name": "IMOGEN", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "dialogue", "text": "For how long?", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "dialogue", "text": "Until I heard the scream.", "name": "IMOGEN", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "dialogue", "text": "And what did you see?", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "dialogue", "text": "The canal.", "name": "IMOGEN", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "dialogue", "text": "There's nothing to see on the canal at night.", "name": "BRUNO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "dialogue", "text": "There was a boat.", "name": "IMOGEN", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "dialogue", "text": "What boat?", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "dialogue", "text": "A small one. With one oar.", "name": "IMOGEN", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "action", "text": "The clocks chime again, all together, a ragged, solemn chord.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "action", "text": "Clementine opens her shoebox, lifts out a single wet shoe.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "action", "text": "Everyone stares at it.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 59, "kind": "dialogue", "text": "It was on the deck. I found it.", "name": "CLEMENTINE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 60, "kind": "dialogue", "text": "That's not mine.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 61, "kind": "dialogue", "text": "It's a man's. Size eleven.", "name": "CLEMENTINE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 62, "kind": "dialogue", "text": "That's mine.", "name": "BRUNO", "speaker": 5, "ext": [], "paren": ["sitting up"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 63, "kind": "dialogue", "text": "Mr. Adeleke-Fischer.", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 64, "kind": "dialogue", "text": "It's mine. I lost it last week.", "name": "BRUNO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 65, "kind": "dialogue", "text": "You said you were asleep.", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 66, "kind": "dialogue", "text": "I was asleep.", "name": "BRUNO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 67, "kind": "dialogue", "text": "In one shoe.", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 68, "kind": "dialogue", "text": "It's a very old habit.", "name": "BRUNO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 69, "kind": "action", "text": "Nobody laughs.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 70, "kind": "action", "text": "The rain slows.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 71, "kind": "dialogue", "text": "Everyone, please, stay calm.", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 72, "kind": "dialogue", "text": "I am very calm.", "name": "CATHERINE", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 73, "kind": "action", "text": "She picks up the poker from the stove and holds it loosely, like a conductor's baton.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 74, "kind": "dialogue", "text": "Madame, put that down.", "name": "LEOPOLD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 75, "kind": "dialogue", "text": "Of course.", "name": "CATHERINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 76, "kind": "action", "text": "She doesn't.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}]}