{"scene_id": "s02060", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02060.fountain", "heading": "INT. GRAND HOTEL - PENTHOUSE SUITE - NIGHT", "cast": [{"id": 0, "name": "GENEVIEVE MONTAGUE-OSEI", "names": ["GENEVIEVE MONTAGUE-OSEI", "GENEVIEVE"], "gender": "?", "first": 11, "spoke": 11}, {"id": 1, "name": "MASKED MAN", "names": ["MASKED MAN"], "gender": "?", "first": 18, "spoke": 8}, {"id": 2, "name": "LUCIEN FAIRWEATHER-ODUYA", "names": ["LUCIEN FAIRWEATHER-ODUYA", "LUCIEN"], "gender": "?", "first": 29, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRAND HOTEL - PENTHOUSE SUITE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Gilded mirrors.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A white piano.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cocktail cabinet inlaid with mother-of-pearl.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "French windows open on a balcony, and beyond it a city of lights.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A figure in a tuxedo and a domino mask kneels at a wall safe behind a painting, working a stethoscope against its steel face.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "He is lean, gloved, silent.", "para": 1, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "The doorknob turns.", "para": 2, "sent": 0, "present": []}, {"u": 8, "kind": "action", "text": "He freezes.", "para": 2, "sent": 1, "present": []}, {"u": 9, "kind": "action", "text": "The painting drops back over the safe.", "para": 2, "sent": 2, "present": []}, {"u": 10, "kind": "action", "text": "He slides behind a velvet curtain.", "para": 2, "sent": 3, "present": []}, {"u": 11, "kind": "action", "text": "A woman enters: GENEVIEVE MONTAGUE-OSEI (50s, evening gown, a glass of champagne in one hand).", "para": 3, "sent": 0, "present": [0]}, {"u": 12, "kind": "action", "text": "She flicks on a lamp.", "para": 3, "sent": 1, "present": [0]}, {"u": 13, "kind": "action", "text": "She sets down her glass on the piano.", "para": 3, "sent": 2, "present": [0]}, {"u": 14, "kind": "action", "text": "She crosses to the painting.", "para": 3, "sent": 3, "present": [0]}, {"u": 15, "kind": "action", "text": "Adjusts it by a half inch.", "para": 3, "sent": 4, "present": [0]}, {"u": 16, "kind": "dialogue", "text": "You may come out. I can smell the rubber.", "name": "GENEVIEVE", "speaker": 0, "ext": [], "paren": ["without turning"], "dual": false, "present": [0]}, {"u": 17, "kind": "action", "text": "The curtain stirs.", "para": 4, "sent": 0, "present": [0]}, {"u": 18, "kind": "action", "text": "The MASKED MAN steps out, hands raised, glove squeaking.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Madame.", "name": "MASKED MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Your name.", "name": "GENEVIEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "That would be unwise.", "name": "MASKED MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Then I shall call you Monsieur Curtain.", "name": "GENEVIEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Charming.", "name": "MASKED MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She lifts the champagne, sips, studies him over the rim.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "You are very good. The alarm is quiet.", "name": "GENEVIEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "I had help.", "name": "MASKED MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "The bellhop?", "name": "GENEVIEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "The night manager.", "name": "MASKED MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Ah. Lucien. He has always been lazy.", "name": "GENEVIEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "She walks around him in a slow circle.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "He turns to follow.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "They halt, face to face, close enough to touch.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "What is it you want?", "name": "GENEVIEVE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Nothing that belongs to you.", "name": "MASKED MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Everything in this room belongs to me.", "name": "GENEVIEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Not the diamonds.", "name": "MASKED MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Ah. You know about the diamonds.", "name": "GENEVIEVE", "speaker": 0, "ext": [], "paren": ["smiling"], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "I know they're not real.", "name": "MASKED MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "The smile fades.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "A beat.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Then he lunges for the painting; she smashes her glass against the piano and slashes at him with the stem.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "He ducks, spins, wrenches the painting down.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "She grabs his arm.", "para": 7, "sent": 4, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "They stagger, crash into the cocktail cabinet, and bottles shatter.", "para": 7, "sent": 5, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "He gets the painting.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "She gets the mask.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "It tears away.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Beneath it: the face of a man in his sixties, lined, gentle.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "LUCIEN FAIRWEATHER-ODUYA, the night manager, panting.", "para": 8, "sent": 4, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Lucien.", "name": "GENEVIEVE", "speaker": 0, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Genevieve.", "name": "LUCIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "You said you would never.", "name": "GENEVIEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "You said the diamonds were real.", "name": "LUCIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "They stand, ruined, among the glass.", "para": 9, "sent": 0, "present": [0, 1, 2]}]}