{"scene_id": "s02062", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02062.fountain", "heading": "INT. COUNTY GENERAL - TRAUMA BAY 1 - NIGHT", "cast": [{"id": 0, "name": "HORTENSE ADEYEMI-VANCE", "names": ["HORTENSE ADEYEMI-VANCE", "HORTENSE"], "gender": "f", "first": 5, "spoke": 17}, {"id": 1, "name": "RAMIRO OKONKWO-STRAND", "names": ["RAMIRO OKONKWO-STRAND", "RAMIRO"], "gender": "?", "first": 6, "spoke": 5}, {"id": 2, "name": "JO", "names": ["JO"], "gender": "?", "first": 7, "spoke": 6}, {"id": 3, "name": "ABERNATHY-BRIGGS", "names": ["ABERNATHY-BRIGGS"], "gender": "?", "first": 7, "spoke": 0}, {"id": 4, "name": "TENZIN LHAMO-FISCHER", "names": ["TENZIN LHAMO-FISCHER", "TENZIN"], "gender": "?", "first": 8, "spoke": 6}, {"id": 5, "name": "CHESTER ODUNSI-WHITE", "names": ["CHESTER ODUNSI-WHITE", "CHESTER"], "gender": "m", "first": 9, "spoke": 5}, {"id": 6, "name": "ADMINISTRATOR BEATRIX KOWALCZYK-OSEI", "names": ["ADMINISTRATOR BEATRIX KOWALCZYK-OSEI", "BEATRIX"], "gender": "?", "first": 10, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. COUNTY GENERAL - TRAUMA BAY 1 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A white, glaring room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Instruments laid out on a steel tray.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Overhead lights, harsh as an interrogation.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A bloodied gurney in the center, a patient under a sheet, a monitor beeping like an angry cricket.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. HORTENSE ADEYEMI-VANCE (50s, trauma surgeon, gown spotted, cap tied tight) leans over the patient.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across from her, DR. RAMIRO OKONKWO-STRAND (30s, resident, new, a smear of blood on his glasses).", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Nurse JOSEPHINE \"JO\" ABERNATHY-BRIGGS (40s, steady hands) preps a syringe.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Anesthesiologist DR. TENZIN LHAMO-FISCHER (40s, calm voice, headset) watches the monitor.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "Orderly CHESTER ODUNSI-WHITE (20s, in over his head) holds a suction wand.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "And in the doorway, tall and silent, stands ADMINISTRATOR BEATRIX KOWALCZYK-OSEI (60s, pantsuit, clipboard), observing.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "Pressure?", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "Eighty over forty.", "name": "TENZIN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "Falling.", "name": "RAMIRO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "Fluids are wide open.", "name": "JO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "Ramiro, retract. Chester, suction.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "Which side?", "name": "CHESTER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "His left. Your left.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "Which one's my left?", "name": "CHESTER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "The one with the wand.", "name": "JO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "action", "text": "Ramiro and Chester both reach for the same retractor, collide, and the metal clangs.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "action", "text": "Hortense stops, looks up.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Gentlemen.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "Sorry.", "name": "RAMIRO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "My fault.", "name": "CHESTER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "It is nobody's fault. Ramiro, you hold. Chester, you suction. Jo, give me a number ten.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "Number ten.", "name": "JO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "She slaps the scalpel into Hortense's hand.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "The monitor tone climbs, then drops.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "Pressure's seventy.", "name": "TENZIN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "Come on.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "Is it the spleen?", "name": "RAMIRO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "It's the spleen, and the liver, and something I haven't found.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "Sixty-five.", "name": "TENZIN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "Hortense.", "name": "JO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "I know, I know. Suction!", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "Suctioning!", "name": "CHESTER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "Dr. Adeyemi-Vance.", "name": "BEATRIX", "speaker": 6, "ext": [], "paren": ["from the doorway"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "Everyone looks up.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "Beatrix does not move.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "The family is asking.", "name": "BEATRIX", "speaker": 6, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "dialogue", "text": "Tell them I'm busy.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "dialogue", "text": "They want an update.", "name": "BEATRIX", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "dialogue", "text": "Then tell them the update is that I'm busy.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "dialogue", "text": "Doctor--", "name": "BEATRIX", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "Beatrix, if you stand in that door another ten seconds, I will have you scrub in.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": ["not looking"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "action", "text": "Beatrix considers.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "Straightens her clipboard.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "Withdraws.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "dialogue", "text": "Sixty.", "name": "TENZIN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "dialogue", "text": "He's going.", "name": "RAMIRO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "dialogue", "text": "He's not going.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "dialogue", "text": "Clamp.", "name": "JO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "dialogue", "text": "Clamp.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "action", "text": "She seizes it, sets it, her hand disappearing into the red.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "action", "text": "A hush.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "action", "text": "The monitor holds a long, steady, ragged tone.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "dialogue", "text": "Pressure's coming up.", "name": "TENZIN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "dialogue", "text": "Sixty-five.", "name": "JO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 59, "kind": "dialogue", "text": "Is that good?", "name": "CHESTER", "speaker": 5, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 60, "kind": "dialogue", "text": "That is very good.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 61, "kind": "dialogue", "text": "Seventy.", "name": "TENZIN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 62, "kind": "dialogue", "text": "Seventy-five.", "name": "RAMIRO", "speaker": 1, "ext": [], "paren": ["exhaling"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 63, "kind": "dialogue", "text": "There you are.", "name": "HORTENSE", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 64, "kind": "action", "text": "Ramiro sags against the tray.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 65, "kind": "action", "text": "Chester, relieved, nearly drops the wand.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 66, "kind": "action", "text": "Jo reaches out and steadies it.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 67, "kind": "action", "text": "Hortense straightens, shoulders aching, and tilts her head at the ceiling light.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 68, "kind": "dialogue", "text": "Everyone. Take a breath.", "name": "HORTENSE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 69, "kind": "action", "text": "They do.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 70, "kind": "action", "text": "All of them.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 71, "kind": "action", "text": "Together.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 72, "kind": "action", "text": "Then Hortense bends over the patient again.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 73, "kind": "dialogue", "text": "Now let's finish.", "name": "HORTENSE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}