{"scene_id": "s02063", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02063.fountain", "heading": "EXT. FLOODED RICE PADDY - MEKONG DELTA - DAWN", "cast": [{"id": 0, "name": "SERGEANT CALLUM DRUMMOND-OKORIE", "names": ["SERGEANT CALLUM DRUMMOND-OKORIE", "CALLUM"], "gender": "m", "first": 5, "spoke": 23}, {"id": 1, "name": "CORPORAL TRAN QUOC-HARTWELL", "names": ["CORPORAL TRAN QUOC-HARTWELL", "TRAN"], "gender": "m", "first": 7, "spoke": 19}, {"id": 2, "name": "RADIO", "names": ["RADIO"], "gender": "?", "first": 30, "spoke": 1}, {"id": 3, "name": "BURST", "names": ["BURST"], "gender": "?", "first": 47, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FLOODED RICE PADDY - MEKONG DELTA - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A shallow bowl of silver water as far as the eye can see.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Banana palms, a bamboo causeway, a collapsed dike.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Mist hangs at knee height.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Distant gunfire, like someone beating a rug.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SERGEANT CALLUM DRUMMOND-OKORIE (30s, tall, scarred chin, drenched in muddy water to the thighs) wades in front, rifle held high.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Behind him, a hundred yards of silver, a ragged line of footprints.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "CORPORAL TRAN QUOC-HARTWELL (20s, small, wiry, a radio pack on his back, a bandage on one wrist) follows, treading with exaggerated care.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Tran.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Sergeant.", "name": "TRAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "You hear that?", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Gunfire. North.", "name": "TRAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "No. Behind it.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Water?", "name": "TRAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Engines.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "They freeze.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Mist thickens.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "In the distance, a low, patient throb, barely audible.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Boats.", "name": "TRAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Two. Maybe three.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Ours?", "name": "TRAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Doesn't matter. We're a hundred yards from cover.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "We could go back.", "name": "TRAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "We go back, we meet the guns.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "We go forward--", "name": "TRAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "We meet the boats.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "A beat.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "A bird cries, flapping across the paddy.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "They both duck, crouch, press low to the water.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "The throb comes closer.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Radio.", "name": "CALLUM", "speaker": 0, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Tran unslings the pack, thumbs the switch, holds the handset to his ear.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Static.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Nothing.", "name": "TRAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Try again.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "It's wet.", "name": "TRAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Dry it.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "With what?", "name": "TRAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Your shirt.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Tran pulls up his shirt and wipes the handset.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "He tries again.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "A thin voice crackles through.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "...Dagger Six...Dagger Six...", "name": "RADIO", "speaker": 2, "ext": ["V.O."], "paren": ["distorted"], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "It's HQ!", "name": "TRAN", "speaker": 1, "ext": [], "paren": ["urgent whisper"], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Give it.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "He snatches the handset, cups it, speaks without breath.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Dagger Six, Dagger Six, I have two. Enemy craft inbound. Request fire on grid--", "name": "CALLUM", "speaker": 0, "ext": ["CONT'D"], "paren": ["into radio"], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "A BURST of automatic fire stitches the water.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "They dive.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Spray everywhere.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Tran lands face-first in the paddy, spits, rolls.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Callum kicks off the bank, rifle up, and fires twice into the mist.", "para": 8, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Something screams.", "para": 8, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "A boat engine revs.", "para": 8, "sent": 6, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "They scramble through the shallows, slipping, hauling each other by the straps of their packs.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "A second burst skips across the water behind them.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "They splash into the reeds and drop flat, panting.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "That was close.", "name": "TRAN", "speaker": 1, "ext": [], "paren": ["gasping"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "Too close.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "Are you hit?", "name": "TRAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "No.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "Sergeant, your arm.", "name": "TRAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "Callum looks down.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "A thin red thread runs from his sleeve into the water.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "He turns it, examines it with dull curiosity.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "It's a scratch.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "It's bleeding.", "name": "TRAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "Scratches do.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "Let me wrap it.", "name": "TRAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "dialogue", "text": "Later.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "Tran pulls a strip of cloth from his pack anyway and ties it around Callum's arm.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "Callum lets him.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "action", "text": "The engines go silent.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "action", "text": "Mist swallows the paddy.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "Somewhere, far away, a rooster crows.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "dialogue", "text": "Did they pass?", "name": "TRAN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "dialogue", "text": "They stopped.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": ["listening"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "dialogue", "text": "Why?", "name": "TRAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "dialogue", "text": "Because they're listening for us.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "action", "text": "They hold their breath.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "action", "text": "A single bubble rises from the water beside Tran's head and pops.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "dialogue", "text": "Move on my count. One.", "name": "CALLUM", "speaker": 0, "ext": ["CONT'D"], "paren": ["barely audible"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "dialogue", "text": "Two.", "name": "TRAN", "speaker": 1, "ext": [], "paren": ["barely audible"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "dialogue", "text": "Three.", "name": "CALLUM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 84, "kind": "action", "text": "They rise, together, and run.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}]}