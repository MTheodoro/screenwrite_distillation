{"scene_id": "s02064", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02064.fountain", "heading": "INT. STILLED SUBWAY CAR - TUNNEL - NIGHT", "cast": [{"id": 0, "name": "WOMAN", "names": ["WOMAN"], "gender": "?", "first": 6, "spoke": 0}, {"id": 1, "name": "MIRANDA ADEBOWALE-KRUGER", "names": ["MIRANDA ADEBOWALE-KRUGER", "MIRANDA"], "gender": "f", "first": 6, "spoke": 13}, {"id": 2, "name": "MAN", "names": ["MAN"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "TIBERIUS OKONJO-VASQUEZ", "names": ["TIBERIUS OKONJO-VASQUEZ", "TIBERIUS"], "gender": "m", "first": 7, "spoke": 13}], "units": [{"u": 0, "kind": "heading", "text": "INT. STILLED SUBWAY CAR - TUNNEL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Emergency lighting.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Flickering.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The car is dark, the tunnel darker.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Water drips somewhere.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A faint electric hum.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "A WOMAN in a courier jacket, MIRANDA ADEBOWALE-KRUGER (30s), sits rigid on a bench, an envelope clutched in her lap.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "At the other end, a MAN, TIBERIUS OKONJO-VASQUEZ (40s), stands braced against the pole, a pistol tucked at the small of his back, visible.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Neither speaks.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "The car ticks as the metal cools.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Is the power coming back?", "name": "MIRANDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Eventually.", "name": "TIBERIUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "How long?", "name": "MIRANDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Depends who you ask.", "name": "TIBERIUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "I'm asking you.", "name": "MIRANDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Then ten minutes. Or never.", "name": "TIBERIUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "She nods.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Draws the envelope to her chest.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "He watches her do it.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "That's a lot of care for an envelope.", "name": "TIBERIUS", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "It's my job.", "name": "MIRANDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Whose?", "name": "TIBERIUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Don't answer that.", "name": "MIRANDA", "speaker": 1, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "You're muttering.", "name": "TIBERIUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "I'm thinking.", "name": "MIRANDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Think quieter.", "name": "TIBERIUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "The lights flicker.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Both lift their heads.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "A distant clang echoes down the tunnel, followed by a long, slow shuffle.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Is that a person?", "name": "MIRANDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "It's the tunnel.", "name": "TIBERIUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "It sounded like footsteps.", "name": "MIRANDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Tunnels have footsteps.", "name": "TIBERIUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Hello? Is anyone there?", "name": "MIRANDA", "speaker": 1, "ext": [], "paren": ["to the whole car"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Then, faintly, a metallic scrape.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Don't.", "name": "TIBERIUS", "speaker": 3, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Hello?", "name": "MIRANDA", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "They speak at the same moment.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "A flashlight beam sweeps across the windows.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Tiberius slides off the pole, hand to his back.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Miranda stands, envelope behind her.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "A long beat.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "The beam passes.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "The shuffle recedes.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Tiberius lowers his hand.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Miranda lets her breath out in a slow hiss.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Were you going to shoot someone?", "name": "MIRANDA", "speaker": 1, "ext": ["CONT'D"], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Only if they were going to shoot me.", "name": "TIBERIUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "That's not comforting.", "name": "MIRANDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "It wasn't meant to be.", "name": "TIBERIUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "She sits.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "He leans back against the pole.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "The car hums.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Ten minutes.", "name": "MIRANDA", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Or never.", "name": "TIBERIUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}