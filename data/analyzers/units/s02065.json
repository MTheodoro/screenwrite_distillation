{"scene_id": "s02065", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02065.fountain", "heading": "INT. PINNACLE DYNAMICS - CONFERENCE ROOM 12 - DAY", "cast": [{"id": 0, "name": "CHRISTABEL ODUYA-HARTMANN", "names": ["CHRISTABEL ODUYA-HARTMANN", "CHRISTABEL"], "gender": "?", "first": 6, "spoke": 7}, {"id": 1, "name": "VP", "names": ["VP"], "gender": "?", "first": 6, "spoke": 0}, {"id": 2, "name": "MARCELLUS ABIOLA-BRANDT", "names": ["MARCELLUS ABIOLA-BRANDT", "MARCELLUS"], "gender": "?", "first": 7, "spoke": 5}, {"id": 3, "name": "NADIA FAIRWEATHER-OSEI", "names": ["NADIA FAIRWEATHER-OSEI", "NADIA"], "gender": "?", "first": 8, "spoke": 5}, {"id": 4, "name": "EUSTACE KRUGER-ADEYEMI", "names": ["EUSTACE KRUGER-ADEYEMI", "EUSTACE"], "gender": "m", "first": 9, "spoke": 4}, {"id": 5, "name": "PENELOPE OKAFOR-LINDQVIST", "names": ["PENELOPE OKAFOR-LINDQVIST", "PENELOPE"], "gender": "f", "first": 10, "spoke": 2}, {"id": 6, "name": "HR", "names": ["HR"], "gender": "?", "first": 10, "spoke": 0}, {"id": 7, "name": "BARTHOLOMEW KWAME-ASANTE", "names": ["BARTHOLOMEW KWAME-ASANTE", "BARTHOLOMEW"], "gender": "?", "first": 34, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. PINNACLE DYNAMICS - CONFERENCE ROOM 12 - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A glass-walled room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A long table.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A whiteboard crowded with arrows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A plate of untouched croissants.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A speaker phone blinks.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "CHRISTABEL ODUYA-HARTMANN (40s, VP, black blazer) sits at the head.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "To her right, MARCELLUS ABIOLA-BRANDT (30s, sales, shiny tie).", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Across from him, NADIA FAIRWEATHER-OSEI (20s, product, laptop plastered with stickers).", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Further down, EUSTACE KRUGER-ADEYEMI (50s, finance, calculator).", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "In the corner, PENELOPE OKAFOR-LINDQVIST (30s, HR, a binder).", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "Let's get started.", "name": "CHRISTABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "I'd like to start with a win.", "name": "MARCELLUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "Please.", "name": "CHRISTABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "We closed Halverson.", "name": "MARCELLUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "Halverson's a pilot.", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "It's a win.", "name": "MARCELLUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "It's a pilot. With no budget.", "name": "EUSTACE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "It has momentum.", "name": "MARCELLUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "Momentum does not pay invoices.", "name": "EUSTACE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "Can we please stay respectful?", "name": "PENELOPE", "speaker": 5, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "We are being respectful.", "name": "CHRISTABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Okay.", "name": "PENELOPE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "She writes in her binder.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "Nadia leans over to read it, and Penelope covers the page.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "Nadia, the roadmap.", "name": "CHRISTABEL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "We're on track.", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "For what?", "name": "EUSTACE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "For Q3.", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "Q3 was last quarter.", "name": "EUSTACE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "Q3 next year.", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "We have the number?", "name": "CHRISTABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "We have a number.", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "The conference room door swings open.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "A man in a rumpled suit leans in: BARTHOLOMEW KWAME-ASANTE (60s, CEO, a coffee stain on his tie, a stack of paper held like a loaf of bread).", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "dialogue", "text": "Is this the strategy meeting?", "name": "BARTHOLOMEW", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "dialogue", "text": "It is, Bart.", "name": "CHRISTABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "dialogue", "text": "Wonderful. Is there coffee?", "name": "BARTHOLOMEW", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "dialogue", "text": "There are croissants.", "name": "MARCELLUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "dialogue", "text": "Croissants are not coffee.", "name": "BARTHOLOMEW", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "action", "text": "He steps in.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 41, "kind": "action", "text": "Sits at the foot of the table.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 42, "kind": "action", "text": "Everyone sits taller.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 43, "kind": "dialogue", "text": "So. Go on. Who's winning?", "name": "BARTHOLOMEW", "speaker": 7, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 44, "kind": "action", "text": "A silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 45, "kind": "action", "text": "Eustace taps his calculator.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 46, "kind": "action", "text": "Penelope clutches her binder.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 47, "kind": "action", "text": "Nadia looks at the ceiling.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 48, "kind": "dialogue", "text": "We're all winning, Bart.", "name": "CHRISTABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 49, "kind": "dialogue", "text": "Splendid. Splendid.", "name": "BARTHOLOMEW", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 50, "kind": "action", "text": "He takes a croissant, bites it, chews.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 51, "kind": "action", "text": "Everyone watches.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 52, "kind": "dialogue", "text": "Now. About the layoffs.", "name": "BARTHOLOMEW", "speaker": 7, "ext": ["CONT'D"], "paren": ["through crumbs"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}