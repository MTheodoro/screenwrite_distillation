{"scene_id": "s02066", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02066.fountain", "heading": "INT. SALT-WATER BATH HOUSE - BRIGHTON - 1832 - NIGHT", "cast": [{"id": 0, "name": "HEPZIBAH QUARLES-ODUYA", "names": ["HEPZIBAH QUARLES-ODUYA", "HEPZIBAH"], "gender": "f", "first": 7, "spoke": 7}, {"id": 1, "name": "LORD PERCIVAL ABERCROMBIE-ASANTE", "names": ["LORD PERCIVAL ABERCROMBIE-ASANTE", "LORD PERCIVAL"], "gender": "?", "first": 8, "spoke": 3}, {"id": 2, "name": "SUKI ADEYEMI-FAIRBANKS", "names": ["SUKI ADEYEMI-FAIRBANKS", "SUKI"], "gender": "f", "first": 9, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. SALT-WATER BATH HOUSE - BRIGHTON - 1832 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cavernous Georgian room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A long rectangular plunge pool of dark seawater, steaming faintly.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Round arched windows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A lamp on every column.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Brass taps tarnished green.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "The smell of brine and old stone.", "para": 0, "sent": 5, "present": []}, {"u": 7, "kind": "action", "text": "On a marble bench along the pool's edge, MRS. HEPZIBAH QUARLES-ODUYA (60s, black bombazine, a stick with a silver handle) sits very upright, a hat box on her lap.", "para": 1, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "At the far end, LORD PERCIVAL ABERCROMBIE-ASANTE (30s, dressing gown, wet hair, a flush of fever) leans against a column, arms folded.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Between them, in the water up to her waist, SUKI ADEYEMI-FAIRBANKS (20s, bathing costume of striped flannel, red from the cold, a determined jaw) wades with her chin lifted.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "That is quite enough, Susannah.", "name": "HEPZIBAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "It's Suki.", "name": "SUKI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "It is Susannah on the registry.", "name": "HEPZIBAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "The registry is wrong.", "name": "SUKI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Rather a spirited young woman.", "name": "LORD PERCIVAL", "speaker": 1, "ext": [], "paren": ["from the column"], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Rather an impertinent one.", "name": "HEPZIBAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "I only wanted a swim.", "name": "SUKI", "speaker": 2, "ext": [], "paren": ["to the pool"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "At midnight.", "name": "HEPZIBAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "At midnight no one stares.", "name": "SUKI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I am staring.", "name": "LORD PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Then you are no one.", "name": "SUKI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "He laughs, a short bark.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Hepzibah turns her stick in her hands.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Lord Percival, I trust you will not repeat this.", "name": "HEPZIBAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Madam, I shall repeat it at every dinner for a year.", "name": "LORD PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "I beg you will not.", "name": "HEPZIBAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Let him, Aunt.", "name": "SUKI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "I will not be talked of.", "name": "HEPZIBAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "You already are.", "name": "SUKI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "A long silence.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Lamplight trembles on the black water.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Suki ducks under, rises, shakes her hair.", "para": 5, "sent": 2, "present": [0, 1, 2]}]}