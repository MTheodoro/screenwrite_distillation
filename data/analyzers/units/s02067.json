[0, 1, 2]}, {"u": 8, "kind": "action", "text": "In the banquette, a young couple, BRIDGET OSEI-LINDQVIST (20s, nose ring, laptop) and her boyfriend, KOFI ASANTE-MARCHETTI (20s, athletic, a guitar case).", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "The bartender, DELPHINE \"DEL\" NWOKORO-HAYES (40s, sleeves rolled, tattoos), polishes a glass.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "dialogue", "text": "Last call's in ten.", "name": "DEL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "It's seven-thirty.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "Airport rules. The hotel's full. I'm trying to get everyone fed.", "name": "DEL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "I'll take anything with cheese.", "name": "WALT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "That's the pretzels.", "name": "DEL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "Then I'll take the pretzels.", "name": "WALT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "action", "text": "He grabs the bowl.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "action", "text": "Rosalind reaches for it at the same time.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "action", "text": "They both stop, hands on opposite rims.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "Please.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "Ladies first.", "name": "WALT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "That's very kind.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "action", "text": "She takes a pretzel.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "Chews.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "Grimaces.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "action", "text": "Hands the bowl back.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "action", "text": "Walt laughs.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "Kofi, they just cancelled again.", "name": "BRIDGET", "speaker": 3, "ext": [], "paren": ["from the booth"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "Again?", "name": "KOFI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "Seventh time.", "name": "BRIDGET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "Do they ever fly?", "name": "KOFI", "speaker": 4, "ext": [], "paren": ["to the bar"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "Sometimes.", "name": "DEL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "Which times?", "name": "KOFI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "When I'm not working.", "name": "DEL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "Rosalind chuckles.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "Bridget closes her laptop and slides out of the booth, folding her arms.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "I'm going to scream.", "name": "BRIDGET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "Don't.", "name": "KOFI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "dialogue", "text": "I'm going to scream, Kofi.", "name": "BRIDGET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "You are not going to scream.", "name": "KOFI", "speaker": 4, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "Please don't.", "name": "DEL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "dialogue", "text": "Why not?", "name": "BRIDGET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "dialogue", "text": "Because I'm the only person who knows where the good whiskey is.", "name": "DEL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "Bridget laughs despite herself.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "Kofi, relieved, puts his arm around her.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "To the weather.", "name": "WALT", "speaker": 1, "ext": [], "paren": ["raising his beer"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "dialogue", "text": "To the weather.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "dialogue", "text": "To last call.", "name": "DEL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "They clink.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "action", "text": "Outside, thunder rolls.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "action", "text": "The lights dip.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "action", "text": "The TV flickers to a blue screen.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "action", "text": "Everyone looks up.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "dialogue", "text": "That's a bad sign.", "name": "KOFI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "dialogue", "text": "That's the weather.", "name": "BRIDGET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "dialogue", "text": "That's the cable.", "name": "DEL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "dialogue", "text": "It's all the same thing.", "name": "WALT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "action", "text": "Rosalind finishes her drink and sets it down, gently.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "dialogue", "text": "Does anyone play cards?", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 59, "kind": "dialogue", "text": "I do.", "name": "WALT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 60, "kind": "dialogue", "text": "We do.", "name": "BRIDGET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 61, "kind": "dialogue", "text": "Not well.", "name": "KOFI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 62, "kind": "dialogue", "text": "Better.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 63, "kind": "dialogue", "text": "There's a deck behind the counter.", "name": "DEL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 64, "kind": "action", "text": "She fishes it out.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 65, "kind": "action", "text": "Slides it down the bar.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 66, "kind": "action", "text": "Walt catches it, shuffles with a flourish, and cards fly everywhere.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 67, "kind": "action", "text": "They all burst out laughing.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 68, "kind": "action", "text": "It is the first time anyone has laughed all night.", "para": 8, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 69, "kind": "dialogue", "text": "Poker?", "name": "WALT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 70, "kind": "dialogue", "text": "Rummy.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 71, "kind": "dialogue", "text": "Go Fish.", "name": "BRIDGET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 72, "kind": "dialogue", "text": "Anything.", "name": "KOFI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 73, "kind": "dialogue", "text": "Fine. But I'm dealing.", "name": "DEL", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 74, "kind": "action", "text": "She comes around the counter, and for the first time all night, everyone sits at the same table.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}]}