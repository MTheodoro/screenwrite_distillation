{"scene_id": "s02068", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02068.fountain", "heading": "EXT. HOLLOW OAK GLADE - TWILIGHT", "cast": [{"id": 0, "name": "ODALYS THORNEWOOD-ABEBE", "names": ["ODALYS THORNEWOOD-ABEBE", "ODALYS"], "gender": "f", "first": 7, "spoke": 5}, {"id": 1, "name": "BRAMBLE", "names": ["BRAMBLE"], "gender": "m", "first": 8, "spoke": 4}, {"id": 2, "name": "OKORO-LINDQVIST", "names": ["OKORO-LINDQVIST"], "gender": "?", "first": 8, "spoke": 0}, {"id": 3, "name": "MARISOL FAIRWEATHER-ODUYA", "names": ["MARISOL FAIRWEATHER-ODUYA", "MARISOL"], "gender": "f", "first": 9, "spoke": 3}, {"id": 4, "name": "TALIESIN ABERNATHY-KRAUSE", "names": ["TALIESIN ABERNATHY-KRAUSE", "TALIESIN"], "gender": "m", "first": 10, "spoke": 2}, {"id": 5, "name": "PIP", "names": ["PIP"], "gender": "?", "first": 11, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. HOLLOW OAK GLADE - TWILIGHT", "present": []}, {"u": 1, "kind": "action", "text": "An enormous oak, hollow as a cathedral, glows green in the dusk.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fireflies drift.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A ring of toadstools circles the roots.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A path of silver moss winds in from the dark.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A tiny fire burns at the center.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "Five travelers share it in uneasy quiet.", "para": 1, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "ODALYS THORNEWOOD-ABEBE (30s, ranger, cloak patched at the elbows) tends the flames.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "WILLEM \"BRAMBLE\" OKORO-LINDQVIST (50s, a hedge-wizard, mismatched socks) whittles a stick.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "MARISOL FAIRWEATHER-ODUYA (20s, a runaway princess in a stolen tunic) sits with her knees drawn up.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "TALIESIN ABERNATHY-KRAUSE (40s, bard, lute across his back) leans on the oak.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "And at the edge of the light, PIP (12, a boy thief, a sack at his belt) crouches, watching the dark.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "We rest here till moonrise.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Aye.", "name": "BRAMBLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "How far?", "name": "MARISOL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Three days.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "You said two yesterday.", "name": "MARISOL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "I said two if the bridge held.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Did it?", "name": "MARISOL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "It did not.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "She stirs the fire.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Sparks climb.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Bramble tosses a shaving into the flames.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Taliesin plucks a single string.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "It rings, bright, then fades.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Friends, a song?", "name": "TALIESIN", "speaker": 4, "ext": [], "paren": ["to the glade"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "No.", "name": "BRAMBLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "A short one.", "name": "TALIESIN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Short, then.", "name": "BRAMBLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Taliesin tunes, lifts his chin, and begins to hum.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Pip edges closer.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Marisol rests her chin on her knees.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "The fire pops.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "For a moment the clearing is warm, almost safe.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Then the fireflies go out.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "All at once.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "The glade falls dark.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "The hum dies in Taliesin's throat.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "They've gone.", "name": "PIP", "speaker": 5, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Silence.", "name": "ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Not again.", "name": "BRAMBLE", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "A cold wind winds through the oak's hollow.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "A low voice, many voices, rises from the roots.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Marisol grabs Pip's sleeve.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Odalys draws her knife.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Bramble raises his hands, palms out, mouth working on an unspoken word.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Taliesin swings the lute off his back and holds it like a shield.", "para": 6, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "They scatter in five directions, each diving for the shadows, each convinced the others are right behind them.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "The fire gutters, almost out.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "A single ember glows red, like an eye.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}