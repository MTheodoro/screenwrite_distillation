{"scene_id": "s02072", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02072.fountain", "heading": "INT. SYNERGY ROOM - FORMER FUNERAL HOME - DAY", "cast": [{"id": 0, "name": "BARB KOWALCZYK", "names": ["BARB KOWALCZYK", "BARB"], "gender": "?", "first": 5, "spoke": 37}, {"id": 1, "name": "NEW HIRE", "names": ["NEW HIRE"], "gender": "?", "first": 11, "spoke": 8}, {"id": 2, "name": "TEODORO", "names": ["TEODORO"], "gender": "?", "first": 33, "spoke": 22}, {"id": 3, "name": "SYNERGY", "names": ["SYNERGY"], "gender": "?", "first": 87, "spoke": 0}, {"id": 4, "name": "BOUNDARIES", "names": ["BOUNDARIES"], "gender": "?", "first": 59, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. SYNERGY ROOM - FORMER FUNERAL HOME - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A wood-paneled chapel converted into an open-plan collaboration space.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The pews are gone but their ghost-marks remain on the carpet.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A bean-bag sits where the casket stood.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A motivational vinyl decal reads: BRING YOUR WHOLE SELF.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "BARB KOWALCZYK, 50s, regional operations lead, lanyard heavy with badges, stands at a whiteboard that still has a hymn board frame around it.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She is drawing a funnel.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She has been drawing the same funnel for four meetings.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "A glass door hisses.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "A young man hesitates in the doorway, holding a laptop and a succulent in a coffee mug.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "dialogue", "text": "You're early.", "name": "BARB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 11, "kind": "dialogue", "text": "Is it okay? They said ten.", "name": "NEW HIRE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Nobody's ever early. It's kind of a red flag.", "name": "BARB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He steps in.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He looks at the ceiling, which has an ornate plaster rosette and a smoke detector blinking green.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "He looks at the bean-bag.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Is that where the--", "name": "NEW HIRE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "We don't say that. We say \"the Hub.\"", "name": "BARB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Right. Sorry.", "name": "NEW HIRE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Don't be sorry. Be curious.", "name": "BARB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She pulls a marker cap off with her teeth.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "The funnel gets another arrow.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "He sets his succulent on the windowsill and the windowsill, a wide stone ledge, makes a very quiet clack.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "I'm supposed to shadow someone on onboarding?", "name": "NEW HIRE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "That's me. I'm the someone.", "name": "BARB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Great. I'm really excited.", "name": "NEW HIRE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "You're allowed to be neutral.", "name": "BARB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Okay.", "name": "NEW HIRE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "That was neutral?", "name": "BARB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "It was an attempt.", "name": "NEW HIRE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "She finally looks at him, a long unhurried look from lanyard to shoes.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "He holds the laptop to his chest like a hymnal.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Name.", "name": "BARB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Teodoro. Teo, mostly.", "name": "NEW HIRE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Teodoro. And you came to us from?", "name": "BARB", "speaker": 0, "ext": [], "paren": ["writing it on the board, inside the funnel"], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "A mattress start-up. Direct to consumer.", "name": "TEODORO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Did it fold?", "name": "BARB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Like a mattress.", "name": "TEODORO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "She does not laugh.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "She taps the marker on the word Teodoro twice.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Today you will learn three things. One. Our brand voice. Two. Our values. Three. How to book the Hub.", "name": "BARB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "The Hub is bookable?", "name": "TEODORO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "By the hour. There's a calendar. It's color-coded. Green is generative, red is reflective, and gray is--", "name": "BARB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "She stops.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "She looks at the carpet, where a large gray rectangle has been worn by years of folding chairs.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Gray is a sensitive color.", "name": "BARB", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Okay.", "name": "TEODORO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "You keep saying okay.", "name": "BARB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "I didn't know that I did.", "name": "TEODORO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Eleven times. I counted.", "name": "BARB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "He opens his laptop to have something to do.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "It bongs loudly with a cheerful startup chime.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Barb flinches, a tiny flinch, then covers it by uncapping a second marker.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Turn the volume off. Please. We have a no-chime policy in the Hub.", "name": "BARB", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "Is that a value?", "name": "TEODORO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "It's a boundary.", "name": "BARB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "He mutes it.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "A long beat.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "The smoke detector blinks.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Barb writes BOUNDARIES on the whiteboard and underlines it hard enough that the marker squeaks.", "para": 9, "sent": 3, "present": [0, 1, 2, 4]}, {"u": 60, "kind": "dialogue", "text": "Can I ask something? The person I replaced. What happened to them?", "name": "TEODORO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 61, "kind": "dialogue", "text": "He pivoted.", "name": "BARB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 62, "kind": "dialogue", "text": "Where?", "name": "TEODORO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 63, "kind": "dialogue", "text": "Out.", "name": "BARB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 64, "kind": "dialogue", "text": "They said he got promoted.", "name": "TEODORO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 65, "kind": "dialogue", "text": "Out is up, in a sense.", "name": "BARB", "speaker": 0, "ext": [], "paren": ["a flat smile"], "dual": false, "present": [0, 1, 2, 4]}, {"u": 66, "kind": "action", "text": "Teodoro nods too many times.", "para": 10, "sent": 0, "present": [0, 1, 2, 4]}, {"u": 67, "kind": "action", "text": "Barb watches the nodding.", "para": 10, "sent": 1, "present": [0, 1, 2, 4]}, {"u": 68, "kind": "action", "text": "Something in her jaw is working, a small muscle.", "para": 10, "sent": 2, "present": [0, 1, 2, 4]}, {"u": 69, "kind": "action", "text": "She caps the marker.", "para": 10, "sent": 3, "present": [0, 1, 2, 4]}, {"u": 70, "kind": "action", "text": "Uncaps it.", "para": 10, "sent": 4, "present": [0, 1, 2, 4]}, {"u": 71, "kind": "dialogue", "text": "Do you know how many people work here?", "name": "BARB", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 72, "kind": "dialogue", "text": "Two hundred?", "name": "TEODORO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 73, "kind": "dialogue", "text": "Forty. Two hundred is the number on the slide.", "name": "BARB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 74, "kind": "dialogue", "text": "Why is there a slide?", "name": "TEODORO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 75, "kind": "dialogue", "text": "There is always a slide.", "name": "BARB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 76, "kind": "action", "text": "She picks up a remote and a projector hums to life.", "para": 11, "sent": 0, "present": [0, 1, 2, 4]}, {"u": 77, "kind": "action", "text": "A deck appears on the wall above the old altar.", "para": 11, "sent": 1, "present": [0, 1, 2, 4]}, {"u": 78, "kind": "action", "text": "It says OUR JOURNEY.", "para": 11, "sent": 2, "present": [0, 1, 2, 4]}, {"u": 79, "kind": "action", "text": "Under it, a stock photo of a mountain with a staircase built into it.", "para": 11, "sent": 3, "present": [0, 1, 2, 4]}, {"u": 80, "kind": "dialogue", "text": "That staircase isn't attached to anything.", "name": "TEODORO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 81, "kind": "dialogue", "text": "It is a metaphor.", "name": "BARB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 82, "kind": "dialogue", "text": "It's pointing at a cloud.", "name": "TEODORO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 83, "kind": "dialogue", "text": "Teodoro.", "name": "BARB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 84, "kind": "dialogue", "text": "I'm just saying someone approved that.", "name": "TEODORO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 85, "kind": "action", "text": "Her thumb is white on the remote.", "para": 12, "sent": 0, "present": [0, 1, 2, 4]}, {"u": 86, "kind": "action", "text": "She clicks.", "para": 12, "sent": 1, "present": [0, 1, 2, 4]}, {"u": 87, "kind": "action", "text": "The next slide: a pie chart, one slice labeled SYNERGY, filling ninety percent of the circle.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 88, "kind": "dialogue", "text": "Do you see the large slice?", "name": "BARB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 89, "kind": "dialogue", "text": "Yeah.", "name": "TEODORO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 90, "kind": "dialogue", "text": "That slice is where we live.", "name": "BARB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 91, "kind": "dialogue", "text": "What's the other ten percent?", "name": "TEODORO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 92, "kind": "dialogue", "text": "Compliance. And some tears.", "name": "BARB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 93, "kind": "dialogue", "text": "Some what?", "name": "TEODORO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 94, "kind": "dialogue", "text": "Typo. The slide has a typo.", "name": "BARB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 95, "kind": "action", "text": "She clicks again, harder.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 96, "kind": "action", "text": "The clicker snaps in two.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 97, "kind": "action", "text": "A spring pings across the carpet and rolls into the old gray rectangle.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 98, "kind": "action", "text": "They both watch it go.", "para": 13, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 99, "kind": "dialogue", "text": "Do you want me to--", "name": "TEODORO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 100, "kind": "dialogue", "text": "Do not move.", "name": "BARB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 101, "kind": "action", "text": "He doesn't.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 102, "kind": "action", "text": "She walks to the spring, picks it up between two fingers, and holds it up to the light as though it might confess.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 103, "kind": "dialogue", "text": "Four years. I have booked this room for four years. I have put a succulent on every ledge. I have told forty people that the Hub is a safe space. And every Monday I come in and I draw the funnel, and the funnel is the same, and the funnel does nothing, Teodoro. It does nothing!", "name": "BARB", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 104, "kind": "action", "text": "She hurls the spring at the whiteboard.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 105, "kind": "action", "text": "It ticks off the plastic hymn frame.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 106, "kind": "dialogue", "text": "Barb, are you okay?", "name": "TEODORO", "speaker": 2, "ext": [], "paren": ["carefully"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 107, "kind": "dialogue", "text": "I am ABSOLUTELY neutral.", "name": "BARB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 108, "kind": "action", "text": "She rips the BOUNDARIES page off the wall.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 109, "kind": "action", "text": "There is no page, it is a whiteboard, so she drags her sleeve across the word and smears it into a gray cloud.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 110, "kind": "action", "text": "She turns.", "para": 16, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 111, "kind": "action", "text": "Her chest rises and falls.", "para": 16, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 112, "kind": "action", "text": "Teodoro has stood, laptop clutched, succulent forgotten.", "para": 16, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 113, "kind": "dialogue", "text": "Pull up the calendar.", "name": "BARB", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 114, "kind": "dialogue", "text": "Now?", "name": "TEODORO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 115, "kind": "dialogue", "text": "Book the Hub.", "name": "BARB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 116, "kind": "dialogue", "text": "For when?", "name": "TEODORO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 117, "kind": "dialogue", "text": "Right now. Reflective. Make it red.", "name": "BARB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 118, "kind": "action", "text": "He types.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 119, "kind": "action", "text": "His fingers shake slightly.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 120, "kind": "action", "text": "She sits on the bean-bag where the casket stood, sinking down with a long sigh of polystyrene beads, and puts the marker cap in her mouth again.", "para": 17, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 121, "kind": "dialogue", "text": "Booked. It's red.", "name": "TEODORO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 122, "kind": "dialogue", "text": "Good.", "name": "BARB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 123, "kind": "action", "text": "She closes her eyes.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 124, "kind": "action", "text": "The projector continues to glow over her, the staircase going up into the cloud.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 125, "kind": "dialogue", "text": "Welcome to the team.", "name": "BARB", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}