{"scene_id": "s02075", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02075.fountain", "heading": "INT. SPARKLE-KING CAR WASH - NIGHT SHIFT - NIGHT", "cast": [{"id": 0, "name": "WREN LINDQVIST", "names": ["WREN LINDQVIST", "WREN"], "gender": "f", "first": 5, "spoke": 17}, {"id": 1, "name": "DOTTIE ABERNATHY-REYES", "names": ["DOTTIE ABERNATHY-REYES", "DOTTIE"], "gender": "f", "first": 6, "spoke": 17}, {"id": 2, "name": "HANK", "names": ["HANK"], "gender": "?", "first": 11, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. SPARKLE-KING CAR WASH - NIGHT SHIFT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A drive-through tunnel gone quiet.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wet brushes hang motionless, dripping.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A glass booth by the exit holds a space heater, a radio, and two plastic chairs.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Fluorescent hum.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "WREN LINDQVIST, 17, in a yellow company polo two sizes too big, sits on a chair with her feet up on a bucket.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Beside her, DOTTIE ABERNATHY-REYES, 17, hair in a scarf, works a crossword with a pen chewed flat.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Neither is looking at the other.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "It is 1:40 a.m.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "The radio crackles.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "It is a handheld CB sitting on the console, a relic that the owner insists on.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Sparkle-King, this is Hank, you kids alive in there?", "name": "HANK", "speaker": 2, "ext": ["O.S."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Wren picks it up and thumbs the button without sitting up.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Alive, Hank.", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Good. Don't let anybody through the tunnel after two. The brush motor's acting up.", "name": "HANK", "speaker": 2, "ext": ["O.S."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Nobody's coming through, Hank. It's a Tuesday.", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "That's how it gets you.", "name": "HANK", "speaker": 2, "ext": ["O.S."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "She sets the radio down.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Dottie writes a word in her puzzle and erases it.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Seven letters. \"Feeling of wanting to be elsewhere.\"", "name": "DOTTIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Restless.", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "That's eight.", "name": "DOTTIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Is it?", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Dottie counts on her fingers, lips moving.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Wren watches her do it, then looks away at the tunnel, at the brushes hanging still.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "You didn't apply to the program, did you.", "name": "DOTTIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Which program.", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "The summer one. In Duluth. You said you would.", "name": "DOTTIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "I said I might.", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Dottie nods.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "She flips the paper, finds another clue, doesn't read it.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "She was supposed to be on the Duluth shuttle with Wren.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "She picks at the gummy edge of her pen cap.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "My mom thinks you're a bad influence.", "name": "DOTTIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "I wash cars.", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "She says that's what a bad influence would say.", "name": "DOTTIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "They laugh, the small, unwilling laugh of two people who have heard the same joke for a year.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "The space heater ticks.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Somewhere in the tunnel, a drip lands in a bucket, and then another.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Do you think they'll be mad? If I don't go?", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Who's they?", "name": "DOTTIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Everyone. Your mom. Mine. You.", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "I'd be mad for like a week.", "name": "DOTTIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "That's a long time.", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "It's a week.", "name": "DOTTIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "The radio crackles again.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Girls, I'm gonna need you to hit the emergency stop on the brush motor. I can hear it from the house.", "name": "HANK", "speaker": 2, "ext": ["O.S."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Wren reaches for the radio.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Dottie, without looking, hits the red button on the wall.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "The tunnel's low hum drops away and the silence is enormous.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Thank you. Good work.", "name": "HANK", "speaker": 2, "ext": ["O.S.", "CONT'D"], "paren": ["over radio"], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Good work.", "name": "WREN", "speaker": 0, "ext": [], "paren": ["to Dottie"], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Good work.", "name": "DOTTIE", "speaker": 1, "ext": [], "paren": ["to the crossword"], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Dottie reaches over and takes the pen out of her own mouth and offers it to Wren, who does not need it, and takes it anyway.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "They sit there in the quiet.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Wren writes something in a square.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Dottie watches it appear.", "para": 10, "sent": 3, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "That's not seven letters.", "name": "DOTTIE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "It's what fits.", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Dottie squints at the page.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "She reads it twice.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "She leans her head against Wren's shoulder, briefly, as if testing it, then straightens, as if she hadn't.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "Fine. It fits.", "name": "DOTTIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "Outside the booth window, a single set of headlights swings off the road and slows toward the tunnel mouth.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "Neither of them sees it yet.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "You want a pop?", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "I want a lot of things.", "name": "DOTTIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "dialogue", "text": "They've got orange.", "name": "WREN", "speaker": 0, "ext": [], "paren": ["standing"], "dual": false, "present": [0, 1, 2]}, {"u": 68, "kind": "dialogue", "text": "Orange is fine.", "name": "DOTTIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "Wren walks to the machine in the corner.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "A coin drops.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 71, "kind": "action", "text": "A can clatters down.", "para": 13, "sent": 2, "present": [0, 1, 2]}, {"u": 72, "kind": "action", "text": "She carries it back and cracks it open and hands it over and Dottie drinks, looking at the headlights, and then at her.", "para": 13, "sent": 3, "present": [0, 1, 2]}, {"u": 73, "kind": "action", "text": "The lights stop at the tunnel mouth and idle there.", "para": 13, "sent": 4, "present": [0, 1, 2]}, {"u": 74, "kind": "dialogue", "text": "Hank, we've got a car.", "name": "WREN", "speaker": 0, "ext": [], "paren": ["into the radio, tired"], "dual": false, "present": [0, 1, 2]}, {"u": 75, "kind": "dialogue", "text": "Tell 'em we're closed.", "name": "HANK", "speaker": 2, "ext": ["O.S."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2]}, {"u": 76, "kind": "dialogue", "text": "We're closed.", "name": "WREN", "speaker": 0, "ext": [], "paren": ["to Dottie"], "dual": false, "present": [0, 1, 2]}, {"u": 77, "kind": "action", "text": "Dottie stands.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 78, "kind": "action", "text": "Smooths her scarf.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 79, "kind": "action", "text": "Walks to the booth door.", "para": 14, "sent": 2, "present": [0, 1, 2]}, {"u": 80, "kind": "dialogue", "text": "I'll tell them.", "name": "DOTTIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 81, "kind": "action", "text": "She goes out.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 82, "kind": "action", "text": "Wren watches her through the glass, a small figure walking toward the headlights, one hand lifted, shaking her head.", "para": 15, "sent": 1, "present": [0, 1, 2]}, {"u": 83, "kind": "action", "text": "The car's engine idles, then backs away.", "para": 15, "sent": 2, "present": [0, 1, 2]}, {"u": 84, "kind": "action", "text": "Dottie turns, walks back, and sits down.", "para": 15, "sent": 3, "present": [0, 1, 2]}, {"u": 85, "kind": "dialogue", "text": "They said thanks anyway.", "name": "DOTTIE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 86, "kind": "dialogue", "text": "For what?", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 87, "kind": "dialogue", "text": "I don't know. Being closed.", "name": "DOTTIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 88, "kind": "action", "text": "Wren laughs, properly this time, and puts her feet back up on the bucket.", "para": 16, "sent": 0, "present": [0, 1, 2]}, {"u": 89, "kind": "action", "text": "The heater ticks.", "para": 16, "sent": 1, "present": [0, 1, 2]}, {"u": 90, "kind": "action", "text": "The radio is quiet.", "para": 16, "sent": 2, "present": [0, 1, 2]}, {"u": 91, "kind": "action", "text": "On the paper between them, a word sits in its squares, almost the right length.", "para": 16, "sent": 3, "present": [0, 1, 2]}]}