{"scene_id": "s02077", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02077.fountain", "heading": "INT. SUPPLY CLOSET - FUN COMMITTEE HQ - DAY", "cast": [{"id": 0, "name": "GERALDINE MWANGI", "names": ["GERALDINE MWANGI", "GERALDINE"], "gender": "?", "first": 3, "spoke": 40}, {"id": 1, "name": "OSWALD PRUITT", "names": ["OSWALD PRUITT", "OSWALD"], "gender": "?", "first": 4, "spoke": 39}], "units": [{"u": 0, "kind": "heading", "text": "INT. SUPPLY CLOSET - FUN COMMITTEE HQ - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A windowless closet with a laminated sign: FUN COMMITTEE.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Shelves of streamers, foam trophies, and a half-inflated balloon arch.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "GERALDINE MWANGI, 40s, tightly wound, holds a clipboard.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "OSWALD PRUITT, 50s, soft-spoken facilities manager, holds a roll of tape.", "para": 0, "sent": 3, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "You were late to the committee.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "I was fixing the ice machine.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "The committee is mandatory.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "So is the ice machine.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Is it? Is ice mandatory?", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "In July, ma'am, ice is the only thing that is.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Don't \"ma'am\" me. I'm chair.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I know you're chair. You made the badge.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "It's a lanyard.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "It's a lanyard that says CHAIR.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Because I am the chair.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Of fun.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Yes, Oswald. Of fun.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "I just don't think fun has a chair.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "That is exactly what someone without fun would say.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Maybe so.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Item one. The summer picnic.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Do we have a budget?", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "We have four hundred dollars and a dream.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Four hundred dollars for two hundred people.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Forty people.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Two hundred is on the slide.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Forget the slide. Forty.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Ten dollars a head. That's a hot dog.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "That's a hot dog and joy.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Joy costs extra.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Joy is free. Bun is extra.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Then we have a hot dog without a bun.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Then it's a sausage with a dream.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "I'd like that in writing.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Item two. The dunk tank.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "No.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "You haven't heard it.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "I've heard enough. Dunk tanks are an insurance event.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Legal says it's fine.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Legal is one man named Tyrone, and he said \"probably.\"", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "\"Probably\" is yes in a good tie.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Who volunteers to sit in the tank?", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "The regional director.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Does the regional director know?", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "He will when the invitation goes out.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "So that's a no.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "That's a surprise yes.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "I've worked here nineteen years. Nobody has ever been happy about a surprise.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "You've never run one properly.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "I ran the fire drill.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Nobody was happy about that either.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "It was a fire drill, Geraldine.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "Item three. Morale.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "Morale is not an item.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "Everything is an item.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "Morale is weather. You can't put weather on a clipboard.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "I've put weather on a clipboard. It was Q3.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "How did that go?", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "It rained on the picnic.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "Then what are we doing?", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "We are making it better.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "By what means?", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "By streamers, Oswald. By trophies. By a balloon arch, which you will finish inflating.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "I don't have a pump.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "You have lungs.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "I have a bad one.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "Then you'll inflate it slowly and with feeling.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "Is that in the bylaws?", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "It's in the spirit of the bylaws.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "Geraldine. Why did you take this on?", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "dialogue", "text": "Somebody had to.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 72, "kind": "dialogue", "text": "Nobody had to.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 73, "kind": "dialogue", "text": "Somebody had to want to.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 74, "kind": "dialogue", "text": "And that was you.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 75, "kind": "dialogue", "text": "That was me. Hold the clipboard.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 76, "kind": "dialogue", "text": "I'm holding tape.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 77, "kind": "dialogue", "text": "Hold both.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 78, "kind": "dialogue", "text": "Fine.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 79, "kind": "dialogue", "text": "Now. Item four.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 80, "kind": "dialogue", "text": "How many items are there?", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 81, "kind": "dialogue", "text": "Eleven.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 82, "kind": "dialogue", "text": "It's four o'clock.", "name": "OSWALD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 83, "kind": "dialogue", "text": "Then we'd better start.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}