{"scene_id": "s02079", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02079.fountain", "heading": "INT. FERRY GALLEY KITCHEN - EVENING", "cast": [{"id": 0, "name": "CONSUELO DELGADO", "names": ["CONSUELO DELGADO", "CONSUELO"], "gender": "f", "first": 4, "spoke": 7}, {"id": 1, "name": "MATEO", "names": ["MATEO"], "gender": "?", "first": 5, "spoke": 2}, {"id": 2, "name": "ISOLDE", "names": ["ISOLDE"], "gender": "f", "first": 6, "spoke": 1}, {"id": 3, "name": "RUDY", "names": ["RUDY"], "gender": "?", "first": 8, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. FERRY GALLEY KITCHEN - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "A narrow steel kitchen below decks, swaying gently.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Pots hang from magnetic strips.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A porthole shows gray swells.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CONSUELO DELGADO, 70s, in an apron and a silver bun, rolls dough on a stainless counter.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "At the other end, MATEO, 12, peels potatoes into a bucket with great concentration.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Beside him sits ISOLDE, 16, in a school sweater, her phone propped against a salt shaker, thumbs idle.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "A wall-mounted intercom crackles.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Galley, this is the bridge. Mam\u00e1, you got a minute?", "name": "RUDY", "speaker": 3, "ext": ["V.O."], "paren": ["over intercom"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Consuelo does not stop rolling.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Mateo glances up.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Isolde slides her phone face-down.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "I have dough.", "name": "CONSUELO", "speaker": 0, "ext": [], "paren": ["to the intercom"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "It's about Isolde's thing.", "name": "RUDY", "speaker": 3, "ext": ["V.O."], "paren": ["over intercom"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Isolde is here. Say it to the room.", "name": "CONSUELO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "A pause.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "The ferry rocks.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Mateo drops a peeled potato into the bucket with a quiet plunk.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "It can wait.", "name": "RUDY", "speaker": 3, "ext": ["V.O."], "paren": ["over intercom"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Then it waits.", "name": "CONSUELO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "She flours the pin.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Isolde lifts her eyes to the porthole and keeps them there.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Consuelo slides a peeled potato across the counter without looking, and Isolde takes it and starts quartering it with a small knife.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Abuela, is the bridge mad?", "name": "MATEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "The bridge is steering.", "name": "CONSUELO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "That's not an answer.", "name": "MATEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "It's a ferry. It's the answer.", "name": "CONSUELO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Isolde puts the knife down.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "She picks up the potato quarters, carries them to the pot on the stove, and drops them in one at a time.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Consuelo watches her do it.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Her shoulders loosen by a fraction of a degree.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Salt.", "name": "CONSUELO", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Isolde reaches for the shaker, moving her phone aside.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "She pinches salt over the pot.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Consuelo nods.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "The intercom clicks once and goes quiet, still listening.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Nobody speaks to it.", "para": 7, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Tell him I'll come up after dinner.", "name": "ISOLDE", "speaker": 2, "ext": [], "paren": ["to the pot"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "She'll come up after dinner.", "name": "CONSUELO", "speaker": 0, "ext": [], "paren": ["to the intercom"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "The intercom clicks off.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Mateo hums.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "The dough spreads, thinner and thinner.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}]}