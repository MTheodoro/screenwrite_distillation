{"scene_id": "s02084", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02084.fountain", "heading": "INT. TAXIDERMY AUCTION HOUSE - BACK ROOM - NIGHT", "cast": [{"id": 0, "name": "LUCIAN VARGA", "names": ["LUCIAN VARGA", "LUCIAN"], "gender": "?", "first": 5, "spoke": 7}, {"id": 1, "name": "DOMINIC ACHEBE", "names": ["DOMINIC ACHEBE", "DOMINIC"], "gender": "?", "first": 6, "spoke": 2}, {"id": 2, "name": "ROSALIND BEAUMONT", "names": ["ROSALIND BEAUMONT", "ROSALIND"], "gender": "f", "first": 7, "spoke": 5}, {"id": 3, "name": "TOBIAS FINCH", "names": ["TOBIAS FINCH", "TOBIAS"], "gender": "m", "first": 35, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. TAXIDERMY AUCTION HOUSE - BACK ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Shelves of glass-eyed animals line the walls: a bear, a pheasant, a snarling badger mounted on a plinth.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Tags dangle from their feet.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single green-shaded lamp.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A card table with a briefcase on it.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LUCIAN VARGA, 40s, silk scarf, silver rings, leans on the table.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "DOMINIC ACHEBE, 30s, broad-shouldered in a gray suit, stands in the doorway, arms folded.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Between them sits ROSALIND BEAUMONT, 50s, an auctioneer's apron over her blouse, hands flat on the briefcase.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Open it.", "name": "LUCIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "I told you. The lot is withdrawn.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Open it, Rosalind.", "name": "LUCIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "She does not.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Dominic pushes off the doorframe.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "He walks to the bear, runs a hand down its flank, and puts his thumb through a seam in the hide.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "He pulls it wider.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Stuffing spills out.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "So do three small velvet pouches, which drop to the floor and clink.", "para": 2, "sent": 5, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Rosalind flinches.", "para": 2, "sent": 6, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Lucian smiles like a man who is bored by being right.", "para": 2, "sent": 7, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Found something.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Please don't.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Dominic crouches and picks up a pouch.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "He loosens its drawstring and pours a dozen uncut stones into his palm, cloudy, gray, ugly.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "He looks at Lucian.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Lucian looks at Rosalind.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "She puts her face in her hands.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Where's the rest?", "name": "LUCIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "That's all of it.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "That's not ten million.", "name": "LUCIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "The rest is in the badger.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Dominic stands, crosses to the badger, and grips it by the scruff.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The plinth wobbles.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "He lifts it.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Something rattles inside.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "A door bangs open at the far end of the room.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "TOBIAS FINCH, 20s, a young constable in a damp uniform, steps in with a flashlight in one hand and a radio clipped to his shoulder.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "He freezes.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "The flashlight beam finds Dominic holding the badger, Lucian leaning on the table, Rosalind with her face in her hands.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Evening. Everything all right in here?", "name": "TOBIAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Perfectly, officer.", "name": "LUCIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Door was open.", "name": "TOBIAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "We're appraising.", "name": "LUCIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "At eleven at night?", "name": "TOBIAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Estate sale.", "name": "DOMINIC", "speaker": 1, "ext": [], "paren": ["a beat"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Tobias looks at the bear.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "At the spilled stuffing.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "At the pouches on the floor.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "His flashlight drifts to the badger and then up to Dominic's face.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "He sniffs.", "para": 6, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "That's an interesting badger.", "name": "TOBIAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Nobody breathes.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "The badger rattles again as Dominic's grip shifts.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "My nan had one.", "name": "TOBIAS", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Did she?", "name": "LUCIAN", "speaker": 0, "ext": [], "paren": ["carefully"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Tore it up when I was seven. I wanted to see inside.", "name": "TOBIAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "What did you find?", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Sawdust. And a hundred pounds.", "name": "TOBIAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "A long, strange quiet.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "Lucian laughs, one abrupt breath.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "Dominic sets down the badger very slowly.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "Rosalind lowers her hands.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "Tobias holds up the flashlight and clicks it off.", "para": 8, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "I'll say the door was locked.", "name": "TOBIAS", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "He leaves.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "His footsteps recede down the corridor.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "Lucian walks to the pouches and starts gathering them.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "Dominic watches the empty doorway.", "para": 9, "sent": 3, "present": [0, 1, 2, 3]}]}