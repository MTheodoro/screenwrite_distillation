{"scene_id": "s02091", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02091.fountain", "heading": "INT. ST. CASIMIR CHURCH BASEMENT - BINGO NIGHT", "cast": [{"id": 0, "name": "LORETTA BEAUCHAMP", "names": ["LORETTA BEAUCHAMP", "LORETTA"], "gender": "?", "first": 3, "spoke": 31}, {"id": 1, "name": "ELIJAH STONE", "names": ["ELIJAH STONE", "ELIJAH"], "gender": "?", "first": 3, "spoke": 23}, {"id": 2, "name": "PHILOMENA OKPARA", "names": ["PHILOMENA OKPARA", "PHILOMENA"], "gender": "?", "first": 3, "spoke": 13}, {"id": 3, "name": "DENNIS HALVERSEN", "names": ["DENNIS HALVERSEN", "DENNIS"], "gender": "?", "first": 3, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. ST. CASIMIR CHURCH BASEMENT - BINGO NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Long tables, paper plates, a ball cage in the corner.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Four people at a table near the stage, daubers beside their cards.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "LORETTA BEAUCHAMP, 70s, ELIJAH STONE, 40s, PHILOMENA OKPARA, 60s, and DENNIS HALVERSEN, 50s, sit with their cards between them.", "para": 1, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 4, "kind": "dialogue", "text": "You moved my dauber.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 5, "kind": "dialogue", "text": "I did not.", "name": "ELIJAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "dialogue", "text": "It was by the napkin. Now it's by your elbow.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Because you put it in my lane.", "name": "ELIJAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "There are no lanes.", "name": "PHILOMENA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "There are lanes.", "name": "DENNIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Dennis, it's bingo.", "name": "PHILOMENA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "It's bingo with lanes.", "name": "DENNIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "I won't be shamed over a dauber.", "name": "ELIJAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "No one is shaming. I'm observing.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "You are doing the thing you do.", "name": "PHILOMENA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "What thing?", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "The thing where you pretend you're not angry and you are.", "name": "PHILOMENA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "I am not angry.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Your hand is shaking.", "name": "DENNIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "It's a cold basement.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "It's seventy-two degrees.", "name": "ELIJAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "It's a cold basement in my heart.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Oh, for the love of God.", "name": "PHILOMENA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Loretta, what is this about?", "name": "ELIJAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "It's not about the dauber.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "We know.", "name": "DENNIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "It's about Tuesday.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "What happened Tuesday?", "name": "ELIJAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "You know what happened.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "I truly don't.", "name": "ELIJAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "He truly doesn't.", "name": "PHILOMENA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "You told Father Anselm I'd been spreading rumors.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "I said you'd been mentioning things.", "name": "ELIJAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "\"Mentioning.\"", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "That's a gentler word than \"spreading.\"", "name": "ELIJAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "It's a word with a knife in it.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Loretta. Did you tell people about the roof fund?", "name": "PHILOMENA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "I did not tell people. I told a few people.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "How many is a few?", "name": "DENNIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Eleven.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Eleven.", "name": "ELIJAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "It's a church. Eleven is a small number.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "It's a congregation of forty.", "name": "PHILOMENA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Well. They were the right eleven.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "And what did you say?", "name": "DENNIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "That the roof fund had four thousand dollars less than the books said.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "It had four thousand dollars less than the books said because of the boiler.", "name": "ELIJAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "The boiler was a separate line item.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "It was not.", "name": "ELIJAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "It's right there in the ledger.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Whose ledger?", "name": "ELIJAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Yours.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Elijah. Is it in your ledger?", "name": "PHILOMENA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "There was a clerical error.", "name": "ELIJAH", "speaker": 1, "ext": [], "paren": ["after a long pause"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Ah.", "name": "DENNIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "A clerical error.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Which I was going to correct.", "name": "ELIJAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "When?", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "After the Christmas pageant.", "name": "ELIJAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "That's ten months.", "name": "PHILOMENA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "I've been very busy.", "name": "ELIJAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "You were too busy to correct a clerical error but not too busy to tell Father Anselm I was mentioning.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "Loretta, I'm sorry.", "name": "ELIJAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "Say it again.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "I'm sorry.", "name": "ELIJAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "Once more with feeling.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "I'm sorry, Loretta. I was embarrassed. I panicked. It was a small panic.", "name": "ELIJAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "It was a small panic with a large consequence.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "He's apologized.", "name": "DENNIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "dialogue", "text": "Twice.", "name": "PHILOMENA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "dialogue", "text": "Well.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": ["slowly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "dialogue", "text": "Well.", "name": "ELIJAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "You may have your lane.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "Thank you.", "name": "ELIJAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "dialogue", "text": "Can we please play?", "name": "PHILOMENA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "dialogue", "text": "I'm in. Whoever calls the first number.", "name": "DENNIS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "dialogue", "text": "B-nine.", "name": "ELIJAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "dialogue", "text": "Mine.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "dialogue", "text": "That was fast.", "name": "PHILOMENA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "dialogue", "text": "I've been waiting a long time.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}