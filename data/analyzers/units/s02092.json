{"scene_id": "s02092", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02092.fountain", "heading": "EXT. GASLIT ALLEY - LONDON - NIGHT (1881)", "cast": [{"id": 0, "name": "TOBY ASHWORTH", "names": ["TOBY ASHWORTH", "TOBY"], "gender": "m", "first": 4, "spoke": 1}, {"id": 1, "name": "FINNEGAN", "names": ["FINNEGAN", "MRS. FINNEGAN"], "gender": "f", "first": 5, "spoke": 1}, {"id": 2, "name": "CONSTABLE QUILL", "names": ["CONSTABLE QUILL", "QUILL"], "gender": "?", "first": 6, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. GASLIT ALLEY - LONDON - NIGHT (1881)", "present": []}, {"u": 1, "kind": "action", "text": "Fog swallows the lamps.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wet cobbles.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Somewhere a dog howls.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "TOBY ASHWORTH, 12, a lamplighter's boy, balances on a ladder against a post, poking his long pole at a stubborn flame.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "MRS. FINNEGAN, 60s, a flower seller with a basket, hurries past, head down.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Neither sees the third figure until it steps out of the fog: CONSTABLE QUILL, 30s, in a caped coat, whistle between his teeth.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "You there. Boy.", "name": "QUILL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Toby fumbles.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "The pole slips.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "The lamp blazes and the three of them are suddenly lit, a tableau.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Mrs. Finnegan stops.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Quill stops.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Toby holds the ladder with both hands.", "para": 2, "sent": 5, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Have you seen a woman in a green shawl?", "name": "QUILL", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "No, sir.", "name": "TOBY", "speaker": 0, "ext": [], "paren": ["too quickly"], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Mrs. Finnegan's basket tips.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Violets spill.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "She and Toby both lunge for them, and Quill grabs her arm.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "The ladder tilts.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Toby clings to the post and kicks free.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "The constable's whistle falls from his teeth.", "para": 3, "sent": 5, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "A green shawl peeks out from under the flowers.", "para": 3, "sent": 6, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Run.", "name": "MRS. FINNEGAN", "speaker": 1, "ext": [], "paren": ["a whisper"], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Toby drops from the ladder and bolts.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Mrs. Finnegan hurls her basket at the constable.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Violets fly.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Quill stumbles back.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "All three vanish into the fog in three directions.", "para": 4, "sent": 4, "present": [0, 1, 2]}]}