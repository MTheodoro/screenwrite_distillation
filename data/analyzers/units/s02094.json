{"scene_id": "s02094", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02094.fountain", "heading": "INT. CAPSIZED TRAWLER - AIR POCKET - NIGHT", "cast": [{"id": 0, "name": "IMOGEN TAVARES", "names": ["IMOGEN TAVARES", "IMOGEN"], "gender": "f", "first": 5, "spoke": 7}, {"id": 1, "name": "PILAR PERRAULT", "names": ["PILAR", "PILAR PERRAULT"], "gender": "?", "first": 7, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. CAPSIZED TRAWLER - AIR POCKET - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A black, upside-down cabin, the floor now the ceiling.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Water slaps a foot below.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single glow stick floats in a bucket, lighting the underside of everything green.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A handheld radio is wedged in a bunk frame.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "IMOGEN TAVARES, 40s, hangs from the rail by one arm, soaked, her other hand clamped around the radio.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She breathes in ragged pulls.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "dialogue", "text": "Pilar. Pilar, come in.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "I'm here.", "name": "PILAR", "speaker": 1, "ext": ["O.S."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Where?", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Engine room. The hatch is jammed.", "name": "PILAR", "speaker": 1, "ext": ["O.S."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "How much air?", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Enough for a conversation.", "name": "PILAR", "speaker": 1, "ext": ["O.S."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Don't joke.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "I'm not.", "name": "PILAR", "speaker": 1, "ext": ["O.S."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "A beat.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Water slaps.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Imogen lowers herself down, wading chest-deep toward a bulkhead door, the radio held above her head.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "I'm coming.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "You can't swim that.", "name": "PILAR", "speaker": 1, "ext": ["O.S."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Watch me.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She dives.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "The glow stick bobs.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "A thump.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "A muffled scream.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "The radio clicks.", "para": 3, "sent": 4, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Imogen?", "name": "PILAR", "speaker": 1, "ext": ["O.S."], "paren": ["over radio"], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "The bulkhead door bursts open and PILAR PERRAULT, 30s, surges through in a gush of water, gasping, hair plastered to her face.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Imogen is behind her, one fist knotted in her collar.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "They slam against the wall, tangled, coughing, clutching each other, then shove apart.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "You left the hatch open.", "name": "PILAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "I left you alive.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}