{"scene_id": "s02096", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02096.fountain", "heading": "INT. COLD-STORAGE FILM VAULT - NIGHT", "cast": [{"id": 0, "name": "CELESTINE ADEYEMI-BROOKS", "names": ["CELESTINE ADEYEMI-BROOKS", "CELESTINE"], "gender": "?", "first": 6, "spoke": 17}, {"id": 1, "name": "GRAHAM TOLLIVER", "names": ["GRAHAM TOLLIVER", "GRAHAM"], "gender": "?", "first": 7, "spoke": 17}], "units": [{"u": 0, "kind": "heading", "text": "INT. COLD-STORAGE FILM VAULT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A refrigerated concrete room lined with steel shelves, each stacked with canisters of nitrate film.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Breath fogs.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Frost rimes the door seal.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single overhead panel hums.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "At the far end, a locked steel cabinet marked ARCHIVE REEL 14.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "CELESTINE ADEYEMI-BROOKS, 30s, in a thermal jacket and surgical gloves, kneels at the cabinet with a pick set.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Beside her, GRAHAM TOLLIVER, 50s, in a parka two sizes too big, holds a flashlight and an empty duffel.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Neither has spoken for some time.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "She works the pick.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "A click.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Another.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She pauses, blows on her fingers, and resumes.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He shifts the flashlight to his other hand.", "para": 2, "sent": 4, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Hold it steady.", "name": "CELESTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I am.", "name": "GRAHAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "It's shaking.", "name": "CELESTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "It's cold.", "name": "GRAHAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She says nothing.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "The pick turns.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Something inside the cabinet gives with a soft, definite clunk.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She lifts the latch and swings the door wide.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Inside lie a dozen flat tin canisters, labeled in faded ink.", "para": 3, "sent": 4, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "That's it?", "name": "GRAHAM", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "That's it.", "name": "CELESTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I thought it would be bigger.", "name": "GRAHAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "It's film.", "name": "CELESTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "She lifts the first canister, reads the label, sets it in the duffel.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "He lifts the second.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "They work in silence, passing each tin hand to hand.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Frost crackles underfoot.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "You know what's on these?", "name": "GRAHAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "I know what the buyer told me.", "name": "CELESTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "That's not what I asked.", "name": "GRAHAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Then no.", "name": "CELESTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Nineteen thirty-four. A premiere in Lisbon. Eleven minutes no one has seen since.", "name": "GRAHAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Eleven minutes isn't worth four hundred thousand.", "name": "CELESTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "It is if it's the right eleven minutes.", "name": "GRAHAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "She stops.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Looks at him.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "He doesn't meet her eyes.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "You've seen it.", "name": "CELESTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "No.", "name": "GRAHAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "You know someone who has.", "name": "CELESTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "My father projected it once.", "name": "GRAHAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Where?", "name": "CELESTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "A basement. Nineteen seventy-one. He said it was the best thing he ever saw and the worst thing he ever did.", "name": "GRAHAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "What was on it?", "name": "CELESTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "He never said.", "name": "GRAHAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "She picks up the next canister.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "Her hands are steady.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "His flashlight beam trembles on the label.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "We should go.", "name": "CELESTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "Yes.", "name": "GRAHAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "They fill the duffel to the top.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "She zips it.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "He takes the straps and swings it onto his shoulder.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "They stand facing each other in the frozen light.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "Graham.", "name": "CELESTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "Hm?", "name": "GRAHAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "If we watch it, we can't unwatch it.", "name": "CELESTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "I know.", "name": "GRAHAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "If we don't, we'll wonder.", "name": "CELESTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "I know that too.", "name": "GRAHAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "She nods.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "She takes the flashlight from him, switches it off, and the vault goes dark except for the humming panel.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "Then she switches the flashlight back on.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "Fourteen minutes to the van.", "name": "CELESTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "Is that enough time?", "name": "GRAHAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "Not for the film.", "name": "CELESTINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "action", "text": "She turns toward the door.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "He follows.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "The frost closes around them, and the cabinet behind them hangs open, empty, glinting.", "para": 9, "sent": 2, "present": [0, 1]}]}