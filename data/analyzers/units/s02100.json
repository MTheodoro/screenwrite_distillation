{"scene_id": "s02100", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02100.fountain", "heading": "EXT. TREEHOUSE - BACKYARD - NIGHT", "cast": [{"id": 0, "name": "COLM DOYLE", "names": ["COLM DOYLE", "COLM"], "gender": "m", "first": 3, "spoke": 7}, {"id": 1, "name": "ROSIE", "names": ["ROSIE"], "gender": "?", "first": 3, "spoke": 6}, {"id": 2, "name": "GRANNY MAUDE", "names": ["GRANNY MAUDE", "MAUDE"], "gender": "f", "first": 3, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "EXT. TREEHOUSE - BACKYARD - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Rain drums on a sheet-metal roof.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A lantern swings from a rafter.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The treehouse is just big enough for three, and today it holds all of them: COLM DOYLE, 40s, in a damp raincoat, bent double under the low ceiling; ROSIE, 8, in pajamas and a rain slicker, clutching a stuffed heron; and GRANNY MAUDE, 70s, who somehow climbed the rope ladder and sits on an upturned bucket knitting.", "para": 0, "sent": 2, "present": [0, 1, 2]}, {"u": 4, "kind": "dialogue", "text": "The storm will pass.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "You said that an hour ago.", "name": "ROSIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "It's a very big storm.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Thunder cracks.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Rosie ducks and burrows into Maude's cardigan.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Maude does not look up from her needles.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Rosemary. Sit up. The heron wants air.", "name": "MAUDE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "He's scared.", "name": "ROSIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "He's a heron. He's seen worse.", "name": "MAUDE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Colm checks his phone.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "No signal.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "He pockets it and crouches by the door.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "We should go in.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "No!", "name": "ROSIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "It's flooding the lawn.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "You said we'd sleep out here. You promised.", "name": "ROSIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I promised dry.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Wind hammers the roof.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "A branch bangs the wall.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "The lantern swings, and Maude and Colm both reach for it at once, their hands closing on the same handle.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Rosie giggles.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Colm lets go.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Maude hangs the lantern back on its hook.", "para": 3, "sent": 5, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Colm. Sit.", "name": "MAUDE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "He sits.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "The floor tilts a degree.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "All three lean the same way and stop.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "When your father built this, he said it'd survive anything.", "name": "MAUDE", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "He was building it for me.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "He built it for himself and told you it was for you.", "name": "MAUDE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Colm laughs, a short surprised breath.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Rosie looks between them.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Was it scary then?", "name": "ROSIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Not once he was in it.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Another crack.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "The roof rattles.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "The treehouse sways.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "A loud creak, and the whole structure shudders, and Colm throws an arm across Rosie as Maude plants both feet.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "A long moment.", "para": 6, "sent": 4, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "The wood settles.", "para": 6, "sent": 5, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "The rain eases to a patter.", "para": 6, "sent": 6, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "We're still here.", "name": "ROSIE", "speaker": 1, "ext": [], "paren": ["muffled in his coat"], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Of course we are.", "name": "MAUDE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Colm lets out a breath.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "He kisses the top of Rosie's head.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Maude counts a row of stitches.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "The heron's beak pokes out of Rosie's slicker.", "para": 7, "sent": 3, "present": [0, 1, 2]}]}