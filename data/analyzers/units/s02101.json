{"scene_id": "s02101", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02101.fountain", "heading": "INT. FUNICULAR STATION - HOLDING ROOM - NIGHT", "cast": [{"id": 0, "name": "INSPECTOR MALCOLM TREVENNA", "names": ["INSPECTOR MALCOLM TREVENNA", "TREVENNA"], "gender": "?", "first": 4, "spoke": 18}, {"id": 1, "name": "DESIREE LACROIX-ODUYA", "names": ["DESIREE LACROIX-ODUYA", "DESIREE"], "gender": "?", "first": 5, "spoke": 14}, {"id": 2, "name": "SERGEANT BRANWELL KUTTNER", "names": ["SERGEANT BRANWELL KUTTNER", "KUTTNER"], "gender": "?", "first": 6, "spoke": 5}, {"id": 3, "name": "VIOLETA SANDOVAL-GRAY", "names": ["VIOLETA SANDOVAL-GRAY", "VIOLETA"], "gender": "?", "first": 31, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. FUNICULAR STATION - HOLDING ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A tiled waiting room at the top of a cable railway, converted overnight into a police holding space.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A bench, a radiator, a vending machine with an out-of-order sign.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Cable machinery groans through the wall.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "INSPECTOR MALCOLM TREVENNA, 50s, sits on the bench with a thermos.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across from him, a handcuffed prisoner, DESIREE LACROIX-ODUYA, 30s, sits upright and calm, her coat folded in her lap.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "A uniformed sergeant, SERGEANT BRANWELL KUTTNER, 40s, leans on the doorframe, arms folded.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "You can drop the act now.", "name": "TREVENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Which act is that?", "name": "DESIREE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "The one where you don't know why you're here.", "name": "TREVENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I know exactly why I'm here.", "name": "DESIREE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Then say it.", "name": "TREVENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "You saw a woman leave a building with a bag.", "name": "DESIREE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "A bag containing sixty thousand pounds.", "name": "TREVENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "A bag containing sixty thousand pounds of someone else's money. I carried it. I did not take it.", "name": "DESIREE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Distinction without difference.", "name": "TREVENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Then arrest the bag.", "name": "DESIREE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Inspector, she's baiting you.", "name": "KUTTNER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "I'm aware, Sergeant.", "name": "TREVENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Is the funicular running?", "name": "DESIREE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "It's midnight.", "name": "TREVENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "So there's no way down.", "name": "DESIREE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "There's the road.", "name": "TREVENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Which you closed.", "name": "DESIREE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Which we closed.", "name": "TREVENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "You don't have a car.", "name": "DESIREE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "We have a Sergeant.", "name": "TREVENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Who has a car?", "name": "DESIREE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Who has a bicycle.", "name": "KUTTNER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "I see.", "name": "DESIREE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "A door opens with a gust of cold air.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "VIOLETA SANDOVAL-GRAY, 60s, a silver-haired woman in a camel coat, enters carrying a briefcase.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "She sets it on the bench and unclasps it with a flourish.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Good evening, gentlemen. I'm Ms. Lacroix-Oduya's solicitor. Release her.", "name": "VIOLETA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "On what grounds?", "name": "TREVENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "On the grounds that I have the receipt.", "name": "VIOLETA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "What receipt?", "name": "TREVENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "For the sixty thousand pounds. From a registered charity. Signed this afternoon.", "name": "VIOLETA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "That's a forgery.", "name": "TREVENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "It is notarized.", "name": "VIOLETA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "By whom?", "name": "TREVENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "By me.", "name": "VIOLETA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Oh, Violeta.", "name": "DESIREE", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Hush, dear.", "name": "VIOLETA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "This is absurd.", "name": "TREVENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Inspector, would you rather be absurd or wrong?", "name": "VIOLETA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Sir, she has a point.", "name": "KUTTNER", "speaker": 2, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Sergeant, which side are you on?", "name": "TREVENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "The side with the bicycle.", "name": "KUTTNER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "A long silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Trevenna looks at the receipt, at the briefcase, at the radiator.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "He sighs.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "He unlocks the cuffs.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Take her. Go.", "name": "TREVENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Thank you, Inspector.", "name": "DESIREE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Don't thank me. Take the road.", "name": "TREVENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "We will.", "name": "VIOLETA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "Goodnight, Sergeant.", "name": "DESIREE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "Mind the ice.", "name": "KUTTNER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}