{"scene_id": "s02102", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02102.fountain", "heading": "INT. HOUSEBOAT - GALLEY - NIGHT", "cast": [{"id": 0, "name": "WOMAN", "names": ["WOMAN"], "gender": "?", "first": 5, "spoke": 14}, {"id": 1, "name": "VOICE", "names": ["VOICE"], "gender": "?", "first": 14, "spoke": 8}, {"id": 2, "name": "AUGUSTO", "names": ["AUGUSTO"], "gender": "?", "first": 32, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOUSEBOAT - GALLEY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A narrow houseboat kitchen on a quiet canal.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Copper pans, a ticking clock, a window onto black water and the yellow smear of a distant bridge lamp.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Everything is neat.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A table is set for one: a bowl of soup, a heel of bread, a folded napkin.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A WOMAN, 40s, in a gray cardigan, sits down to eat.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her hair is combed.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Her posture is perfect.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "She tears the bread and dips it.", "para": 1, "sent": 3, "present": [0]}, {"u": 9, "kind": "action", "text": "She eats like someone who has practiced being unhurried.", "para": 1, "sent": 4, "present": [0]}, {"u": 10, "kind": "action", "text": "A phone rings on the wall.", "para": 2, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "A rotary phone, cream colored, with a long coiled cord.", "para": 2, "sent": 1, "present": [0]}, {"u": 12, "kind": "action", "text": "She lets it ring twice, wipes her fingers on the napkin, and answers.", "para": 2, "sent": 2, "present": [0]}, {"u": 13, "kind": "dialogue", "text": "Hello.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 14, "kind": "dialogue", "text": "It's me.", "name": "VOICE", "speaker": 1, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I know.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Are you alone?", "name": "VOICE", "speaker": 1, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "I'm having soup.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "That's not what I asked.", "name": "VOICE", "speaker": 1, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "It's what you get.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "A boat horn sounds far down the canal.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She turns the phone cord around her finger.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "I'm at the lock. Twenty minutes.", "name": "VOICE", "speaker": 1, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "It's a long way to the lock.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "I have the car.", "name": "VOICE", "speaker": 1, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "You have a car. Good for you.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Don't be like this.", "name": "VOICE", "speaker": 1, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Like what?", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Calm.", "name": "VOICE", "speaker": 1, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "It's soup. You can be calm over soup.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "She carries the phone to the table, stretching the cord to its limit, and sits.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "She lifts the spoon.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Augusto. Is that you?", "name": "WOMAN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Who else would it be?", "name": "VOICE", "speaker": 1, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "You never say your name.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "I thought you'd know.", "name": "AUGUSTO", "speaker": 2, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "I do. I just wanted to hear it.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "A pause on the line.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Water laps the hull.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Her free hand slides under the table.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "We see it open a drawer and close around the grip of a revolver, a small black thing, cold and neat.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Her face does not change.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "I'm sorry about Thursday.", "name": "AUGUSTO", "speaker": 2, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "So am I.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "We can fix it.", "name": "AUGUSTO", "speaker": 2, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Of course we can.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "She eats a spoonful of soup, swallows, dabs her lips.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "The revolver stays in her lap, out of sight.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Ten minutes.", "name": "AUGUSTO", "speaker": 2, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "I'll leave the light on.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "She hangs up.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Sits there a long moment, looking at the black window.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Her reflection looks back.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Then she lifts the napkin, folds it into a perfect square, sets the gun in her lap, and waits.", "para": 7, "sent": 3, "present": [0, 1, 2]}]}