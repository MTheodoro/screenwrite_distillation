{"scene_id": "s02103", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02103.fountain", "heading": "INT. FENCING SALLE - FORMER TRAM DEPOT - NIGHT", "cast": [{"id": 0, "name": "KONSTANTIN VESELY", "names": ["KONSTANTIN VESELY", "KONSTANTIN"], "gender": "m", "first": 7, "spoke": 8}, {"id": 1, "name": "YOUNG FENCER", "names": ["YOUNG FENCER"], "gender": "m", "first": 8, "spoke": 1}, {"id": 2, "name": "FENCING MASTER", "names": ["FENCING MASTER"], "gender": "?", "first": 9, "spoke": 0}, {"id": 3, "name": "ODALYS PRIEUR", "names": ["ODALYS PRIEUR", "ODALYS"], "gender": "f", "first": 9, "spoke": 11}, {"id": 4, "name": "JOSEPHAT", "names": ["JOSEPHAT"], "gender": "m", "first": 36, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. FENCING SALLE - FORMER TRAM DEPOT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A long iron hall where trams once slept.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rails still run through the floor, buffed by a century of boots.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Under the arched glass roof, two strips of copper mesh glow in pools of light.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A scoreboard ticks.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Benches line the walls, empty except for the shadows of rafters.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "TWO FENCERS in white face each other across the strip, masked, guards up.", "para": 1, "sent": 0, "present": []}, {"u": 7, "kind": "action", "text": "The taller, KONSTANTIN VESELY, 30s, slow-moving and heavy-shouldered, a champion past his prime, shifts his weight and the floor creaks.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "The other, a YOUNG FENCER, 20s, light as a cat, a rival with nothing to lose, bounces on the balls of his feet.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Between them at the strip's edge, a FENCING MASTER named ODALYS PRIEUR, 50s, in a gray blazer and black armband, raises one hand.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "En garde.", "name": "ODALYS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "They crouch.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Blades touch, a thin chime.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Pr\u00eats?", "name": "ODALYS", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Nobody answers.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "She lowers her hand.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Allez.", "name": "ODALYS", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "The young fencer lunges.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Konstantin parries, a flash of steel, and ripostes.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "The young man's mask jerks.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "A green light flares on the scoreboard.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Odalys raises her hand again.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Touch\u00e9. One to Vesely.", "name": "ODALYS", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "The young fencer steps back, shaking his head.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "He rolls his wrist.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Konstantin does not celebrate.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "He tilts his blade, studying its tip, and when he looks up he sees the younger man's eyes through the mesh, hard and bright.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "They go again.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Steel on steel.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "The younger man attacks high, low, high, and Konstantin yields ground until his heel hits the rail in the floor and he stumbles.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "A hit to the chest.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "A red light.", "para": 6, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "The young fencer tears off his mask, sweat flying, face flushed.", "para": 6, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "That was mine.", "name": "YOUNG FENCER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "It was, Mr. Banda.", "name": "ODALYS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "You dragged your foot.", "name": "KONSTANTIN", "speaker": 0, "ext": [], "paren": ["from behind the mask"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "I did not.", "name": "JOSEPHAT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "You did.", "name": "KONSTANTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Gentlemen.", "name": "ODALYS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "He's lying.", "name": "JOSEPHAT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "I'm tired of lying. I'm saying you dragged your foot.", "name": "KONSTANTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Odalys steps between them.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "She looks from one to the other.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Konstantin removes his mask and the man beneath is sallow, damp, forty-two years old.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "He rubs his eyes with the heel of his glove.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "My knee is shot. I'll admit that.", "name": "KONSTANTIN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Then retire.", "name": "JOSEPHAT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "I will, when I lose.", "name": "KONSTANTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "You're losing.", "name": "JOSEPHAT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Not yet.", "name": "KONSTANTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Take your marks.", "name": "ODALYS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "They don the masks.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Take their places.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Behind them the glass roof ticks with cooling air.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "The scoreboard reads four-all.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "Final touch. En garde.", "name": "ODALYS", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Konstantin sets his feet.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "Josephat drops into a crouch.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "For a moment the hall is so quiet that the clock can be heard turning inside the scoreboard.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "Allez.", "name": "ODALYS", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "They explode.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "Steel sings.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "Josephat feints low, Konstantin ignores it, steps through, and his blade whips across Josephat's forearm in a curl so fast the eye can't follow.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "The green light flares.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "Josephat freezes, mouth open.", "para": 10, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "Konstantin lowers his foil.", "para": 10, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "dialogue", "text": "Touch\u00e9. Vesely wins.", "name": "ODALYS", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "action", "text": "Silence.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "action", "text": "Then Josephat tears his mask off and hurls it across the strip.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "It skids to a stop against a bench.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "action", "text": "He stands with his chest heaving, his hand at his arm.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "dialogue", "text": "No. No.", "name": "JOSEPHAT", "speaker": 4, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "dialogue", "text": "Shake my hand.", "name": "KONSTANTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "dialogue", "text": "Not tonight.", "name": "JOSEPHAT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "dialogue", "text": "Then tomorrow.", "name": "KONSTANTIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "action", "text": "Konstantin pulls off his own mask.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 76, "kind": "action", "text": "His face is gray with exhaustion.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 77, "kind": "action", "text": "He holds out his glove.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 78, "kind": "action", "text": "Josephat looks at it.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 79, "kind": "action", "text": "Then, slowly, deliberately, he takes it, and squeezes hard.", "para": 12, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 80, "kind": "action", "text": "Konstantin winces.", "para": 12, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 81, "kind": "action", "text": "Neither lets go.", "para": 12, "sent": 6, "present": [0, 1, 2, 3, 4]}, {"u": 82, "kind": "dialogue", "text": "That is enough.", "name": "ODALYS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 83, "kind": "action", "text": "They release.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 84, "kind": "action", "text": "Konstantin flexes his hand.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 85, "kind": "action", "text": "Josephat turns and walks down the long iron hall, his boots ringing on the tram rails.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4]}]}