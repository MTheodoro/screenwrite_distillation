{"scene_id": "s02104", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02104.fountain", "heading": "INT. GRAIN SILO - BASE LEVEL - NIGHT", "cast": [{"id": 0, "name": "DEVAKI RAMANATHAN", "names": ["DEVAKI RAMANATHAN", "DEVAKI"], "gender": "?", "first": 5, "spoke": 5}, {"id": 1, "name": "HARISH", "names": ["HARISH"], "gender": "?", "first": 5, "spoke": 5}, {"id": 2, "name": "MAGPIE", "names": ["MAGPIE"], "gender": "?", "first": 5, "spoke": 5}, {"id": 3, "name": "LONGSTREET", "names": ["LONGSTREET"], "gender": "?", "first": 5, "spoke": 0}, {"id": 4, "name": "THADDEUS BELL", "names": ["THADDEUS BELL", "THADDEUS"], "gender": "m", "first": 5, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRAIN SILO - BASE LEVEL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A concrete cylinder, ninety feet of dark above.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dust hangs in the flashlight beams.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A rusted auger runs up the wall like a spine.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Underfoot, a drift of old grain crunches.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "FOUR TEENAGERS stand in a loose ring: DEVAKI RAMANATHAN, 17, in a puffer jacket, a camcorder on her shoulder; her brother HARISH, 15, with a flashlight in each fist; MARGUERITE \"MAGPIE\" LONGSTREET, 16, in a leather jacket with a patch on the sleeve; and THADDEUS BELL, 17, in a school letterman's jacket, shivering.", "para": 1, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 6, "kind": "dialogue", "text": "Okay. We're in. Can we go now?", "name": "HARISH", "speaker": 1, "ext": [], "paren": ["to the group"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "dialogue", "text": "We just got here.", "name": "MAGPIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "There's a rule. You stay until midnight.", "name": "THADDEUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "There's no rule.", "name": "DEVAKI", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "There's always a rule.", "name": "MAGPIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "A noise comes from above: a slow, scraping drag, like something heavy pulled across a floor.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "The four of them tilt their heads back together, flashlights swinging up to catch only dust.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "It's the wind.", "name": "HARISH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "There's no wind.", "name": "THADDEUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Note the time. Eleven forty-one. Strange sounds in the silo.", "name": "DEVAKI", "speaker": 0, "ext": [], "paren": ["quietly, into the camcorder"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "The scraping stops.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "The silence that follows is worse.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Thaddeus laughs, brittle.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Magpie takes a step toward the ladder at the wall, puts a hand on the cold rung, and the whole silo hums with a faint metallic ring.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Don't touch the ladder.", "name": "MAGPIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "I'm not touching it.", "name": "DEVAKI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "I was telling myself.", "name": "MAGPIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Dust sifts down from above.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Harish switches off one flashlight.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Thaddeus scoots closer to Devaki.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "She keeps the camera trained on the dark, steady, her breath fogging.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Magpie stays at the ladder, jaw clenched.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Harish clicks the second flashlight on and off, on and off.", "para": 4, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Stop it.", "name": "HARISH", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "I'm not doing anything.", "name": "DEVAKI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Not you. Him.", "name": "HARISH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "He points the flashlight at Thaddeus.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Thaddeus is looking up, mouth open, face washed white, and he points too.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Above them, high on the curved wall, something shifts.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "A long pale shape.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Folded limbs, a head tilted wrong, hanging in the shadow.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "It does not move again.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "That's a person.", "name": "THADDEUS", "speaker": 4, "ext": [], "paren": ["a whisper"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "That's not a person.", "name": "MAGPIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "It's not moving.", "name": "DEVAKI", "speaker": 0, "ext": [], "paren": ["into the camcorder"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Everyone, back to the door. Slowly.", "name": "HARISH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "They begin to back away, all four, hands out, flashlights trembling, the grain crunching underfoot with each step.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Devaki keeps filming, walking backwards, and trips.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "The camcorder falls.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "The light on it swings wildly across the wall.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "For one half-second it catches the shape.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "It is not hanging.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "It is crouching.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Its head has turned.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Run.", "name": "THADDEUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "They scatter.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}]}