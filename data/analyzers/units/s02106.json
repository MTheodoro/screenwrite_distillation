{"scene_id": "s02106", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02106.fountain", "heading": "EXT. ROADSIDE FRUIT STAND - DAY", "cast": [{"id": 0, "name": "HONESTY BOX", "names": ["HONESTY BOX"], "gender": "?", "first": 3, "spoke": 0}, {"id": 1, "name": "BAG", "names": ["BAG"], "gender": "?", "first": 3, "spoke": 0}, {"id": 2, "name": "GRACIELA HUNT", "names": ["GRACIELA HUNT", "GRACIELA"], "gender": "?", "first": 5, "spoke": 4}, {"id": 3, "name": "BASTIAN", "names": ["BASTIAN"], "gender": "?", "first": 6, "spoke": 2}, {"id": 4, "name": "MAN", "names": ["MAN"], "gender": "?", "first": 8, "spoke": 0}, {"id": 5, "name": "OTIS WREN", "names": ["OTIS WREN", "OTIS"], "gender": "m", "first": 9, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ROADSIDE FRUIT STAND - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A plywood shed on a gravel shoulder.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Crates of peaches.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A hand-painted sign: HONESTY BOX - $3 A BAG.", "para": 0, "sent": 2, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "Heat shimmers off the highway.", "para": 0, "sent": 3, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "GRACIELA HUNT, 50s, in a straw hat, arranges peaches in a pyramid.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "Her nephew BASTIAN, 20s, sits on an upturned crate, eating a peach and watching the road.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "A dusty pickup rolls up and stops.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "A MAN in a cowboy hat steps out.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "This is OTIS WREN, 40s.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "He nods at them, picks up a bag, and counts out three singles.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "He drops them into the tin box.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Thank you kindly.", "name": "OTIS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Peaches are good this year.", "name": "GRACIELA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "They look it.", "name": "OTIS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Bastian stops chewing.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Graciela straightens a peach that did not need straightening.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Otis fishes a fourth dollar from his wallet and lays it beside the tin.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "For the bag.", "name": "OTIS", "speaker": 5, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Bags are free.", "name": "GRACIELA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Then for the view.", "name": "OTIS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "He climbs into the pickup.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "The engine turns.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Graciela watches the tailgate recede until the road shimmers it away.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Then she opens the tin, counts the bills, and counts them again.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "It's all there?", "name": "BASTIAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "It's four dollars.", "name": "GRACIELA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "It's three.", "name": "BASTIAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "It's four.", "name": "GRACIELA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "She slides the extra dollar into her apron.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Bastian bites the peach.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}