{"scene_id": "s02108", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02108.fountain", "heading": "INT. FIELD HOSPITAL - STADIUM CONCOURSE - NIGHT", "cast": [{"id": 0, "name": "ANSELM OYELARAN-PRICE", "names": ["ANSELM OYELARAN-PRICE", "ANSELM"], "gender": "?", "first": 5, "spoke": 14}, {"id": 1, "name": "KIRSTEN VANTERPOOL", "names": ["KIRSTEN VANTERPOOL", "KIRSTEN"], "gender": "?", "first": 6, "spoke": 12}, {"id": 2, "name": "NURSE BEATRIZ HAMMOND-LU", "names": ["NURSE BEATRIZ HAMMOND-LU", "BEATRIZ"], "gender": "?", "first": 7, "spoke": 6}, {"id": 3, "name": "JUDE FAIRCLOUGH", "names": ["JUDE FAIRCLOUGH", "JUDE"], "gender": "?", "first": 8, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. FIELD HOSPITAL - STADIUM CONCOURSE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A concrete concourse beneath the stands, lined with cots.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Overhead, emergency lights flicker.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A banner for a long-ago soccer final hangs askew.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Medics weave between rows.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. ANSELM OYELARAN-PRICE, 50s, in scrubs and a headlamp, bends over a patient.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across from him, DR. KIRSTEN VANTERPOOL, 40s, snaps off a pair of gloves.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "NURSE BEATRIZ HAMMOND-LU, 30s, holds an IV bag aloft like a torch.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "A paramedic, JUDE FAIRCLOUGH, 20s, enters pushing an empty gurney.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "We lost the monitor.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": ["to Kirsten"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Can you bag him?", "name": "KIRSTEN", "speaker": 1, "ext": [], "paren": ["to Beatriz"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Already am.", "name": "BEATRIZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Pressure?", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Falling.", "name": "KIRSTEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "He's gone gray.", "name": "BEATRIZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Start compressions.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "I've got them.", "name": "KIRSTEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "On three.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "One.", "name": "KIRSTEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Two.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Three.", "name": "BEATRIZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "What do you need?", "name": "JUDE", "speaker": 3, "ext": [], "paren": ["arriving"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Epi, one milligram.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Here.", "name": "JUDE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Push it.", "name": "KIRSTEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Pushing.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Rhythm?", "name": "BEATRIZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Nothing.", "name": "KIRSTEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Again.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Clear.", "name": "KIRSTEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Clear!", "name": "JUDE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "A pause.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Then a beep, hesitant, weak.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Then another.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "We've got something.", "name": "BEATRIZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Pulse?", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Thready, but there.", "name": "KIRSTEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Good. Good.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Where does he go?", "name": "JUDE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Intensive section. Row four.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "I'll take him.", "name": "KIRSTEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "No. You'll sit.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "I'm fine.", "name": "KIRSTEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "You haven't sat in nine hours.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Neither have you.", "name": "KIRSTEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Both of you, sit.", "name": "BEATRIZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "We're fine.", "name": "ANSELM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "We're fine.", "name": "KIRSTEN", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Beatriz glares at them.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "They sit.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}]}