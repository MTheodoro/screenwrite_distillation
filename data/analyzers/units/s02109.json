{"scene_id": "s02109", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02109.fountain", "heading": "INT. FERRY GALLEY - DEPOSITION - NIGHT", "cast": [{"id": 0, "name": "ATTORNEY PRUDENCE KALINOWSKI-BAKER", "names": ["ATTORNEY PRUDENCE KALINOWSKI-BAKER", "PRUDENCE"], "gender": "?", "first": 5, "spoke": 7}, {"id": 1, "name": "ATTORNEY THEODORIC MWANGI-FOX", "names": ["ATTORNEY THEODORIC MWANGI-FOX", "THEODORIC"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "WITNESS", "names": ["WITNESS"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "HORATIO BLYTHE", "names": ["HORATIO BLYTHE", "HORATIO"], "gender": "?", "first": 7, "spoke": 6}, {"id": 4, "name": "JUDGE OKAFOR-NIELSEN", "names": ["JUDGE OKAFOR-NIELSEN"], "gender": "?", "first": 10, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. FERRY GALLEY - DEPOSITION - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped steel galley converted into a deposition room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A long table, a court reporter's machine, a pitcher of water.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Porthole windows reveal black sea.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The ferry rocks gently, and the water in the pitcher slops.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ATTORNEY PRUDENCE KALINOWSKI-BAKER, 40s, sharp-featured, in a charcoal suit, sits at the head with a legal pad.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Opposite, ATTORNEY THEODORIC MWANGI-FOX, 50s, rumpled, a pen behind each ear, flips pages.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Between them, the WITNESS, HORATIO BLYTHE, 60s, a ship's purser in a stained uniform, sits with hands clasped.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "A court reporter's machine sits unattended, recording on its own.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "A speakerphone in the center of the table crackles.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Counsel, state your appearances for the record.", "name": "JUDGE OKAFOR-NIELSEN", "speaker": 4, "ext": ["V.O."], "paren": ["over speakerphone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Prudence Kalinowski-Baker for the plaintiff.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Theodoric Mwangi-Fox for the defendant.", "name": "THEODORIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "The witness is sworn?", "name": "JUDGE OKAFOR-NIELSEN", "speaker": 4, "ext": ["V.O."], "paren": ["over speakerphone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "I am, Your Honor.", "name": "HORATIO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Proceed.", "name": "JUDGE OKAFOR-NIELSEN", "speaker": 4, "ext": ["V.O."], "paren": ["over speakerphone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Mr. Blythe, on the night of March ninth, where were you?", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "In the purser's office.", "name": "HORATIO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Alone?", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "No.", "name": "HORATIO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Objection. Vague.", "name": "THEODORIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Who was with you?", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Objection. Compound.", "name": "THEODORIC", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "The speakerphone hisses.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Counsel, one at a time.", "name": "JUDGE OKAFOR-NIELSEN", "speaker": 4, "ext": ["V.O."], "paren": ["over speakerphone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Withdrawn. Mr. Blythe, who was in the office?", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "The first mate. Mr. Voss.", "name": "HORATIO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "And what were you discussing?", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "The manifest.", "name": "HORATIO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Objection. Calls for hearsay.", "name": "THEODORIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Overruled. It's a deposition.", "name": "JUDGE OKAFOR-NIELSEN", "speaker": 4, "ext": ["V.O."], "paren": ["over speakerphone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "The ferry lurches.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "The water in the pitcher sloshes.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Horatio grips the table.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Prudence waits it out, pen poised.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Mr. Blythe, did the manifest list the crates?", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "It did not.", "name": "HORATIO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}