{"scene_id": "s02110", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02110.fountain", "heading": "INT. GENERATION SHIP \"HALCYON REACH\" - HYDROPONICS DECK - SHIP'S MORNING", "cast": [{"id": 0, "name": "ENGINEER BRIGITTE OSEI-HARTMANN", "names": ["ENGINEER BRIGITTE OSEI-HARTMANN", "BRIGITTE"], "gender": "?", "first": 5, "spoke": 24}, {"id": 1, "name": "CAPTAIN LUCIUS ABARA-DELACROIX", "names": ["CAPTAIN LUCIUS ABARA-DELACROIX", "LUCIUS"], "gender": "?", "first": 10, "spoke": 21}], "units": [{"u": 0, "kind": "heading", "text": "INT. GENERATION SHIP \"HALCYON REACH\" - HYDROPONICS DECK - SHIP'S MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Terraced racks of lettuce and bean vines under violet grow lights.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Pipes tick with circulating water.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The air is humid and green.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A worn path through the leaves leads to a bench at the center, where two cups of tea sit untouched.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ENGINEER BRIGITTE OSEI-HARTMANN, 50s, in a patched coverall, walks the path with a tablet, checking the nutrient lines.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She hums a little tune, off-key.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She pauses at a tomato plant, pinches a leaf, and smells it.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "dialogue", "text": "Hello, my beauty.", "name": "BRIGITTE", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0]}, {"u": 9, "kind": "action", "text": "She continues down the row.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "Ahead, on the bench, sits CAPTAIN LUCIUS ABARA-DELACROIX, 60s, in a pressed uniform, hat in his lap, gazing at the vines.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He looks well.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He looks rested.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Captain. You're up early.", "name": "BRIGITTE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "The ship's morning is whenever I say it is.", "name": "LUCIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "That's what the manual says?", "name": "BRIGITTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "That's what the manual means.", "name": "LUCIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She sits beside him and picks up a cup.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He doesn't move to take his own.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "For a moment they watch the water drip from a pipe overhead.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Somewhere a fan turns.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "It's quiet.", "name": "BRIGITTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "It's always quiet.", "name": "LUCIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Not like this.", "name": "BRIGITTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "No?", "name": "LUCIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "There's usually the sound of people.", "name": "BRIGITTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "You don't hear the people?", "name": "LUCIUS", "speaker": 1, "ext": [], "paren": ["mildly"], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "She tilts her head.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "She listens.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Nothing but the fans and the drip.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "She sets her cup down and glances at the tablet.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Captain, my readings show the crew quarters on Deck Four are empty.", "name": "BRIGITTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "They're at breakfast.", "name": "LUCIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "The mess hall is empty too.", "name": "BRIGITTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Then they're on shift.", "name": "LUCIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "The bridge is empty.", "name": "BRIGITTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Is it?", "name": "LUCIUS", "speaker": 1, "ext": [], "paren": ["a long beat"], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "She stands.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "She turns in a slow circle, staring at the racks.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "She raises her voice, projecting into the green.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Hello? Anyone down here? Anyone?", "name": "BRIGITTE", "speaker": 0, "ext": [], "paren": ["to the deck"], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Nothing.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Only the drip.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "She looks at Lucius, who is still smiling that mild, restful smile.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Think. Think, Brigitte.", "name": "BRIGITTE", "speaker": 0, "ext": ["CONT'D"], "paren": ["muttering"], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "She taps the tablet, scrolls, swipes.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Her face drains.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "Captain. The log says we dropped our last colonist forty years ago.", "name": "BRIGITTE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Did it?", "name": "LUCIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "It says we landed.", "name": "BRIGITTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "We did.", "name": "LUCIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Then why are we still moving?", "name": "BRIGITTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Are we?", "name": "LUCIUS", "speaker": 1, "ext": [], "paren": ["gently"], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "She looks up.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "Through the transparent ceiling of the hydroponics dome, the stars are fixed, motionless.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "Not streaking.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "Not drifting.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "Just there, a clean field of cold points.", "para": 8, "sent": 4, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "We stopped.", "name": "BRIGITTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "We stopped, Brigitte. A long time ago.", "name": "LUCIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "And no one told me.", "name": "BRIGITTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "No one was left to.", "name": "LUCIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "She sits down again, hard.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "The tablet slips from her fingers and clatters on the bench.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "She stares at her own hands.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "How long have I been tending these?", "name": "BRIGITTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "Long enough for the tomatoes to forget the dark.", "name": "LUCIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "Am I... am I the only one?", "name": "BRIGITTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "You were the best of us. You kept the garden.", "name": "LUCIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "And you?", "name": "BRIGITTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "I keep the ship.", "name": "LUCIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "She looks at him properly, and for the first time sees the translucence at the edge of his sleeve, the way the grow lights pass faintly through his hat.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 72, "kind": "dialogue", "text": "Oh.", "name": "BRIGITTE", "speaker": 0, "ext": [], "paren": ["a whisper"], "dual": false, "present": [0, 1]}, {"u": 73, "kind": "dialogue", "text": "Yes.", "name": "LUCIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 74, "kind": "dialogue", "text": "You've been dead a while.", "name": "BRIGITTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 75, "kind": "dialogue", "text": "Thirty-one years. I didn't want to frighten you.", "name": "LUCIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 76, "kind": "action", "text": "She laughs.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 77, "kind": "action", "text": "It cracks.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 78, "kind": "action", "text": "She wipes her eyes.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 79, "kind": "dialogue", "text": "You're a terrible captain.", "name": "BRIGITTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 80, "kind": "dialogue", "text": "I'm a very patient one.", "name": "LUCIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 81, "kind": "action", "text": "She picks up her cold tea and drinks.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 82, "kind": "action", "text": "They sit side by side, the engineer and the captain, in the violet light of the last garden.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 83, "kind": "dialogue", "text": "What happens now?", "name": "BRIGITTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 84, "kind": "dialogue", "text": "Now? You finish your tea.", "name": "LUCIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 85, "kind": "dialogue", "text": "And after?", "name": "BRIGITTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 86, "kind": "dialogue", "text": "After, we see.", "name": "LUCIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 87, "kind": "action", "text": "She nods.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 88, "kind": "action", "text": "She takes another sip.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 89, "kind": "action", "text": "The vines rustle, though no air moves.", "para": 13, "sent": 2, "present": [0, 1]}]}