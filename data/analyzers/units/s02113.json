{"scene_id": "s02113", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02113.fountain", "heading": "INT. HILLTOP OBSERVATORY - DOME - NIGHT", "cast": [{"id": 0, "name": "NOELLE FAIRCHILD-ABARA", "names": ["NOELLE FAIRCHILD-ABARA", "NOELLE"], "gender": "f", "first": 6, "spoke": 17}, {"id": 1, "name": "WILFRED OYELOLA-GRAY", "names": ["WILFRED OYELOLA-GRAY", "WILFRED"], "gender": "f", "first": 9, "spoke": 5}, {"id": 2, "name": "PROFESSOR IOLANTHE VASQUEZ-KIM", "names": ["PROFESSOR IOLANTHE VASQUEZ-KIM", "IOLANTHE"], "gender": "f", "first": 10, "spoke": 6}, {"id": 3, "name": "MARCUS", "names": ["MARCUS"], "gender": "?", "first": 21, "spoke": 13}], "units": [{"u": 0, "kind": "heading", "text": "INT. HILLTOP OBSERVATORY - DOME - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A great white dome, its slit open to a scatter of stars.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The telescope rises through the center like the barrel of a cathedral organ.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A spiral stair, a brass gantry, a desk strewn with charts.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A radiator ticks.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Wind sighs through the slit.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "NOELLE FAIRCHILD-ABARA, 30s, in a thick sweater and fingerless gloves, leans against the telescope pier, arms wrapped around herself.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Her wedding ring is gone.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "A pale band marks the finger where it used to be.", "para": 1, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "On the gantry above her, WILFRED OYELOLA-GRAY, 30s, a postdoc, adjusts a mirror, whistling quietly.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Behind them both, at the foot of the stair, sits PROFESSOR IOLANTHE VASQUEZ-KIM, 70s, in a wheelchair with a shawl over her knees, a thermos in her lap, grading papers by flashlight.", "para": 1, "sent": 4, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "He's late.", "name": "NOELLE", "speaker": 0, "ext": [], "paren": ["to the dark"], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "He's always late.", "name": "WILFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "He said eight.", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "He said eight o'clock, one of those eights.", "name": "WILFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Eight o'clock the way he says it is a state of mind.", "name": "IOLANTHE", "speaker": 2, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Noelle laughs, once, then bites it off.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "She pulls her sleeves down over her hands.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "A phone buzzes in her pocket.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "She pulls it out, reads the screen, and her face hardens.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "She walks to the desk, props the phone against a stack of star charts, and presses the speaker.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Noelle? I'm so sorry, I got held up.", "name": "MARCUS", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Where are you?", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "The airport. The flight's delayed.", "name": "MARCUS", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Which airport?", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "What do you mean?", "name": "MARCUS", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Marcus, there are three. Which one?", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "A pause on the line.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Wilfred stops whistling.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Iolanthe lowers her flashlight.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Marcus draws a breath and exhales it.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "I'm not at the airport.", "name": "MARCUS", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "No.", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "I'm at the house.", "name": "MARCUS", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Which house?", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Hers.", "name": "MARCUS", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "The silence in the dome is enormous.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Wilfred climbs down from the gantry rung by rung.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Noelle does not move.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "She stares at the phone as if she expected it to say something else.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "The radiator ticks.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "The wind sighs through the slit in the roof, and a single star drifts into the frame of the telescope eyepiece unobserved.", "para": 4, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "You asked me to come here tonight.", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "I know.", "name": "MARCUS", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "You said you wanted to show me something.", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "I did. I do. I was going to.", "name": "MARCUS", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "You were going to propose a toast to the comet.", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Noelle...", "name": "MARCUS", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "No. Say it plainly.", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "I can't do it anymore. I'm sorry. I should have told you before you drove all the way up.", "name": "MARCUS", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Twelve years.", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "I know.", "name": "MARCUS", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "And you couldn't tell me to my face.", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "I thought it would be kinder.", "name": "MARCUS", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "It would have been kinder to tell me in the car, in the kitchen, in the dark. Anywhere but a place where we once watched the sky open up.", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "I know. I'm sorry.", "name": "MARCUS", "speaker": 3, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "She says nothing.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "She stares at the phone.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "After a moment she reaches out and presses the button that ends the call.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "The screen goes dark.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "The dome is very still.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "Wilfred picks up a blanket from the gantry rail and drapes it over her shoulders.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "Iolanthe wheels herself forward, one slow push at a time, until her chair bumps the leg of the desk.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "She unscrews the thermos and pours something steaming into the cap.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "Drink.", "name": "IOLANTHE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "What is it?", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "Coffee and something worse.", "name": "IOLANTHE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "Noelle takes the cap and drinks.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "She coughs.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "Iolanthe nods, satisfied.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "dialogue", "text": "My husband left me for a bassoonist in 1979.", "name": "IOLANTHE", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "dialogue", "text": "What did you do?", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "I discovered two asteroids and named one after his mother.", "name": "IOLANTHE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "Professor.", "name": "WILFRED", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "dialogue", "text": "It's a very ugly asteroid.", "name": "IOLANTHE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "Noelle laughs, helplessly, with tears in her eyes.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "Wilfred steps to the console and flips a switch.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "The great dome begins to turn.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "action", "text": "The slit sweeps past the horizon and across the Milky Way, and the telescope swings after it with a deep, patient rumble.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "dialogue", "text": "Come see.", "name": "WILFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "dialogue", "text": "See what?", "name": "NOELLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "dialogue", "text": "Something that isn't going anywhere.", "name": "WILFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "action", "text": "She wipes her face.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "action", "text": "She climbs the stair, one step at a time, the blanket trailing behind her, and puts her eye to the lens.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 84, "kind": "action", "text": "A long breath.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 85, "kind": "action", "text": "The stars fill her sight.", "para": 9, "sent": 3, "present": [0, 1, 2, 3]}]}