{"scene_id": "s02115", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02115.fountain", "heading": "INT. TUNA AUCTION HALL - PREDAWN", "cast": [{"id": 0, "name": "STRANGER", "names": ["STRANGER"], "gender": "m", "first": 5, "spoke": 4}, {"id": 1, "name": "TAKUMI SHINODA-REYES", "names": ["TAKUMI SHINODA-REYES", "TAKUMI"], "gender": "m", "first": 7, "spoke": 4}, {"id": 2, "name": "OSEI QUAYSON-LEE", "names": ["OSEI QUAYSON-LEE", "OSEI"], "gender": "m", "first": 9, "spoke": 5}, {"id": 3, "name": "ANDERS", "names": ["ANDERS"], "gender": "m", "first": 18, "spoke": 6}, {"id": 4, "name": "MIREILLE BOUCHARD-WU", "names": ["MIREILLE BOUCHARD-WU", "MIREILLE"], "gender": "?", "first": 23, "spoke": 4}, {"id": 5, "name": "KENJI FLORES-ADE", "names": ["KENJI FLORES-ADE", "KENJI"], "gender": "?", "first": 47, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. TUNA AUCTION HALL - PREDAWN", "present": []}, {"u": 1, "kind": "action", "text": "A cavernous refrigerated hall of wet concrete, fluorescent tubes, and rows of giant frozen tuna laid on pallets like torpedoes.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Men in rubber boots drag hooks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Breath smokes.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Prices are shouted in clipped dialect.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A STRANGER, 30s, in a rented parka and expensive shoes, picks his way down an aisle between the fish.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "He keeps glancing at a paper in his hand.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Behind a stack of crates, an old broker named TAKUMI SHINODA-REYES, 60s, watches him with a cigarette dangling from his lip.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Looking for something, friend?", "name": "TAKUMI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "A man named Osei.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "There are forty Oseis here.", "name": "TAKUMI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "This one owes my employer.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "They all do.", "name": "TAKUMI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Takumi lights the cigarette, then points the burning tip toward a corner.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "There, hunched over a pallet, a heavyset man in an orange apron prods a tuna with a gaff.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "OSEI QUAYSON-LEE, 40s, doesn't look up.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Mr. Quayson-Lee.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": ["to Osei"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Who's asking?", "name": "OSEI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "My name is Anders.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "That's a name, not an answer.", "name": "OSEI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "I work for Mr. Pruitt.", "name": "ANDERS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "At the name, Osei's gaff stops.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Takumi drops his cigarette.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "A woman in a fish-market smock, MIREILLE BOUCHARD-WU, 40s, appears from behind the pallet with a clipboard and a calculator.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "She stops, looks at Anders, then at Osei.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Osei. Who is this?", "name": "MIREILLE", "speaker": 4, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "A friend of Pruitt's.", "name": "OSEI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "I'd say colleague.", "name": "ANDERS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Pruitt's dead.", "name": "MIREILLE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "He was. Until Thursday.", "name": "ANDERS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "A cold silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Another auctioneer starts a call in the distance, a sing-song of numbers.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "The fluorescent tubes buzz.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Osei sets down the gaff.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "His hand drifts toward his apron pocket, and Anders sees it.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Don't.", "name": "ANDERS", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "It's a sandwich.", "name": "OSEI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "It's a sandwich.", "name": "MIREILLE", "speaker": 4, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Osei draws out a foil-wrapped sandwich and holds it up like a flag.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "The tension breaks.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Takumi laughs, a harsh cough of a laugh.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Anders lowers the hand he had raised to his own coat.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Fine. Mr. Pruitt wants his money by Friday.", "name": "ANDERS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Pruitt can have his money Friday, if the tuna sells.", "name": "OSEI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "The tuna will sell.", "name": "ANDERS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Then Friday.", "name": "MIREILLE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "An engine roars behind them.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "A forklift lurches around a stack of crates with a skinny kid at the wheel, KENJI FLORES-ADE, 20s, headphones on, eyes on his phone.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "He sees the group and slams the brakes.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "The forklift slews, and a pallet of frozen tuna tilts off its forks toward Anders.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "Look out!", "name": "KENJI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Anders dives.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "The pallet crashes down inches from his shoes, and a hundred-pound fish skids across the concrete and fetches up against Takumi's boot.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "Auction's open.", "name": "TAKUMI", "speaker": 1, "ext": [], "paren": ["deadpan"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "Anders lies on the wet floor, staring at the ceiling.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "Osei offers him half the sandwich.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}