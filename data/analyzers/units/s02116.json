{"scene_id": "s02116", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02116.fountain", "heading": "INT. CAROUSEL FACTORY - PAINTING FLOOR - NIGHT", "cast": [{"id": 0, "name": "OTTILIE HARGROVE-DIAZ", "names": ["OTTILIE HARGROVE-DIAZ", "OTTILIE"], "gender": "?", "first": 6, "spoke": 7}, {"id": 1, "name": "ELDRIDGE PASCAL", "names": ["ELDRIDGE PASCAL", "ELDRIDGE"], "gender": "?", "first": 7, "spoke": 5}, {"id": 2, "name": "CORDELIA MAKINDE-FOX", "names": ["CORDELIA MAKINDE-FOX", "CORDELIA"], "gender": "f", "first": 8, "spoke": 5}, {"id": 3, "name": "CHILD", "names": ["CHILD"], "gender": "?", "first": 38, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. CAROUSEL FACTORY - PAINTING FLOOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cavernous workshop where wooden horses hang from ceiling hooks in rows, half-painted, their eyes blank.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Paint cans line the walls.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dust sheets cover a half-built carousel platform at the center.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "One work lamp burns.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Rain taps the skylights.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "OTTILIE HARGROVE-DIAZ, 30s, a restorer in an apron with a headlamp, kneels beside a wooden pony, brushing gold leaf onto its mane.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Her assistant ELDRIDGE PASCAL, 20s, in headphones, sands a carved saddle at a bench across the floor.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "At the far end, by the loading door, stands CORDELIA MAKINDE-FOX, 60s, the factory's owner, in a fur collar, holding a cardboard box.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "A music-box tune starts up, thin and tinkling.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Ottilie stops brushing.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Eldridge slides one headphone off.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Did you hear that?", "name": "ELDRIDGE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "It's the box.", "name": "OTTILIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "The box is on the shelf.", "name": "ELDRIDGE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "They look.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Across the floor, in the dark, the sound continues, a slow waltz in a minor key.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Cordelia clutches her collar and tucks the cardboard box against her chest.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Ottilie. Turn that off.", "name": "CORDELIA", "speaker": 2, "ext": [], "paren": ["calling"], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "It's not mine.", "name": "OTTILIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Everything here is mine.", "name": "CORDELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "The tune slows.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "A note drops out.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Then another.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Then the carousel platform in the center of the floor shudders, and the dust sheet slides off to reveal the half-built horses on their poles.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Without anyone touching them, they begin to rise and fall.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "That's not plugged in.", "name": "ELDRIDGE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Eldridge, back away from the wall.", "name": "OTTILIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Ottilie rises.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "She sets the brush on the pony's back, and as her hand leaves it the wooden head turns toward her an inch, grain creaking.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Eldridge yelps and drops the saddle.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Cordelia steps back until her shoulders hit the loading door and cannot find the latch in the dark.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Ottilie walks toward the carousel, slowly, hands out, one boot in front of the other.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Hello?", "name": "OTTILIE", "speaker": 0, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "The music stops.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "The horses stop mid-motion, frozen at different heights.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "The silence presses down.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Then a child's voice drifts down from the rafters, tiny and singsong.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Round and round and round we go.", "name": "CHILD", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Nobody moves.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Cordelia lets out a long, shaking breath.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "That's what she used to say.", "name": "CORDELIA", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Who?", "name": "OTTILIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "My daughter. The summer she...", "name": "CORDELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "She cannot finish.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Eldridge crosses the floor in a crouch to stand at Ottilie's elbow.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Do we leave?", "name": "ELDRIDGE", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "I don't think it wants us to leave.", "name": "OTTILIE", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Won't you ride?", "name": "CHILD", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "A beat.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Then the lamp dies.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "In the dark, a single horse starts to turn on its pole, and the whole platform begins to spin, slowly, then faster, then faster still, and the air fills with the shriek of old gears and the rising notes of a waltz.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Make it stop!", "name": "CORDELIA", "speaker": 2, "ext": [], "paren": ["screaming"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Ottilie lunges for the master switch on the wall, finds it by touch, and slams it down.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "The carousel groans.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "The music winds down in a long, falling chord.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "The horses sag on their poles.", "para": 10, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Silence.", "para": 10, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "Then a flicker, a click, and the work lamp surges back on.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "The platform is empty.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "The horses hang still.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "At the center, where the dust sheet lay, sits a small wooden horse nobody had seen before, freshly painted, white and gold, and one of its eyes is open.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "Ottilie.", "name": "ELDRIDGE", "speaker": 1, "ext": [], "paren": ["a whimper"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "I see it.", "name": "OTTILIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "You're it.", "name": "CHILD", "speaker": 3, "ext": ["O.S."], "paren": ["giggling"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "The lamp bursts.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "Dark.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "A long scream.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}]}