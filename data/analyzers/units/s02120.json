{"scene_id": "s02120", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02120.fountain", "heading": "INT. DROWNED BELL TOWER - BENEATH BLACKMERE LAKE - NIGHT", "cast": [{"id": 0, "name": "ORIN VESK", "names": ["ORIN VESK", "ORIN"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "KESTREL AMBROSE", "names": ["KESTREL AMBROSE", "KESTREL"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "TUPPENNY", "names": ["TUPPENNY"], "gender": "?", "first": 5, "spoke": 1}, {"id": 3, "name": "LAKE-WIFE", "names": ["LAKE-WIFE"], "gender": "?", "first": 9, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. DROWNED BELL TOWER - BENEATH BLACKMERE LAKE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Air pocket in the belfry.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Green light.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Water slapping the stairs.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ORIN VESK, 60, salt-white beard, saws at the bell rope with a fishing knife.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "KESTREL AMBROSE, 20s, bandaged hands, hauls a sack of silver up the last dry step, TUPPENNY, 9, barefoot and bone-pale, hugs the bronze clapper and hums, and the stair they stood on a breath ago slides under the black water.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Leave the silver, Orin.", "name": "KESTREL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Leave it and she follows us up.", "name": "ORIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "She follows us anyway.", "name": "TUPPENNY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Give me back my bell, little thief.", "name": "LAKE-WIFE", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Sweetest voice I ever heard for a drowning.", "name": "KESTREL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Don't answer her.", "name": "ORIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "I wasn't going to.", "name": "KESTREL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "You were.", "name": "ORIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Cut the rope!", "name": "ORIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Ring the bell!", "name": "KESTREL", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "The bell booms once.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "The water shudders, flattens, goes glass.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Orin drops the knife.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Kestrel lets go of the sack.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Tuppenny stops humming.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}]}