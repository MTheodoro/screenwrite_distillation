{"scene_id": "s02121", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02121.fountain", "heading": "EXT. COUNTY FAIR - FERRIS WHEEL, TOP GONDOLA - DUSK", "cast": [{"id": 0, "name": "DELPHINE OKAFOR", "names": ["DELPHINE OKAFOR", "DELPHINE"], "gender": "?", "first": 5, "spoke": 5}, {"id": 1, "name": "ZURI", "names": ["ZURI"], "gender": "?", "first": 6, "spoke": 4}, {"id": 2, "name": "BIBI", "names": ["BIBI"], "gender": "?", "first": 6, "spoke": 4}, {"id": 3, "name": "PAPA EMEKA", "names": ["PAPA EMEKA"], "gender": "?", "first": 7, "spoke": 4}, {"id": 4, "name": "HANK", "names": ["HANK"], "gender": "?", "first": 18, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. COUNTY FAIR - FERRIS WHEEL, TOP GONDOLA - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "The wheel has stopped.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Forty feet up.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The gondola rocks.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Far below, a corn dog stand glows.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DELPHINE OKAFOR, 40s, nurse's scrubs under a cardigan, grips the safety bar.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across from her sit her daughters, ZURI, 14, braces and a cracked phone, and BIBI, 6, tiger face paint half smeared.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Beside Delphine sits her father, PAPA EMEKA, 70s, Sunday hat, calm as stone.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Mom, we've been stuck for twenty minutes.", "name": "ZURI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "I know, Zuri. Stay in your seat.", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Zuri's phone is shaking.", "name": "BIBI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "My hand is shaking, Bibi. The phone is fine.", "name": "ZURI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Bibi, come sit by Papa. Look at the lights, not the ground.", "name": "PAPA EMEKA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "I want to look at the ground.", "name": "BIBI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Bibi. Seat.", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "The gondola sways.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Zuri grabs Bibi's wrist.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "She pulls her close and she squeezes back hard.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Folks, generator tripped. Sit tight, we're rebooting.", "name": "HANK", "speaker": 4, "ext": ["O.S."], "paren": ["over the loudspeaker"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Rebooting? Papa, he said rebooting.", "name": "ZURI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Zuri, I once rode a lorry across the Niger with no brakes. We will be fine.", "name": "PAPA EMEKA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Did Papa really do that, Mom?", "name": "BIBI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Ask him when we are on the ground, baby.", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Delphine, take my hat. Your hands need something to hold.", "name": "PAPA EMEKA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Delphine takes the hat.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Turns it in her fingers.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Thank you, Papa.", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "The wheel lurches.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Everyone freezes.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "It holds.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Bibi, don't look down.", "name": "ZURI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "I'm looking at you, Zuri.", "name": "BIBI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Almost there, Okafors!", "name": "HANK", "speaker": 4, "ext": ["O.S."], "paren": ["over the loudspeaker"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "He knows our name.", "name": "DELPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Small town. Everybody knows everybody.", "name": "PAPA EMEKA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}