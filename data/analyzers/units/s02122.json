{"scene_id": "s02122", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02122.fountain", "heading": "INT. BELL FOUNDRY - OCCUPIED TOWN - NIGHT", "cast": [{"id": 0, "name": "SERGEANT WOJCIECH NOWAK", "names": ["SERGEANT WOJCIECH NOWAK", "NOWAK"], "gender": "?", "first": 6, "spoke": 6}, {"id": 1, "name": "CORPORAL ESTELLE ROUSSEAU", "names": ["CORPORAL ESTELLE ROUSSEAU", "ROUSSEAU"], "gender": "f", "first": 9, "spoke": 3}, {"id": 2, "name": "PRIVATE ANDERS HAUGEN", "names": ["PRIVATE ANDERS HAUGEN", "HAUGEN"], "gender": "?", "first": 12, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. BELL FOUNDRY - OCCUPIED TOWN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cathedral of soot.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cold casting pits.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Molds like sleeping giants.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Moonlight through broken skylights.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Silence.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "SERGEANT WOJCIECH NOWAK, 40, boots wrapped in sacking, crouches by the great furnace door.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Rifle low.", "para": 2, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "Grey in his stubble.", "para": 2, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "CORPORAL ESTELLE ROUSSEAU, 25, radio operator, frost on her eyelashes.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Headset on.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Pistol in her fist.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "PRIVATE ANDERS HAUGEN, 19, freckled, too tall for the crouch.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "He keeps swallowing.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Wind.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "A loose chain taps a bell.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Tick.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Tick.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Count them again.", "name": "NOWAK", "speaker": 0, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Same as before. Six trucks. Engines off.", "name": "ROUSSEAU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Why would they park here?", "name": "HAUGEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Because they think we're dead.", "name": "NOWAK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Nowak lifts two fingers.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Haugen creeps to the window.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Rousseau tunes the dial.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Static.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "A boot crunches glass outside.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Close.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "All three stop breathing.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Sergeant.", "name": "HAUGEN", "speaker": 2, "ext": [], "paren": ["barely audible"], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "I hear it.", "name": "NOWAK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "A flashlight beam sweeps the molds.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "It stops on Haugen's shadow.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Don't. Move.", "name": "ROUSSEAU", "speaker": 1, "ext": [], "paren": ["mouthing"], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "The beam holds.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Holds.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Moves on.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Haugen exhales.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Too loud.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "The chain stops tapping.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Outside, doors slam.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Engines cough alive.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "They know.", "name": "NOWAK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Radio's dead. No one is coming.", "name": "ROUSSEAU", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Then we make noise before they do.", "name": "NOWAK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "He pulls a satchel charge from his pack.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Looks at the great bell hanging above the furnace.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Sergeant, the bell. Everyone will hear.", "name": "HAUGEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "That's the idea.", "name": "NOWAK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "He slings the charge over the bell's crown.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Lights the fuse.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Rousseau and Haugen are already running.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "The foundry doors burst inward.", "para": 16, "sent": 0, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Flashlights stab.", "para": 16, "sent": 1, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "The charge goes off.", "para": 17, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "The bell shrieks.", "para": 17, "sent": 1, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Fire floods the dark.", "para": 17, "sent": 2, "present": [0, 1, 2]}]}