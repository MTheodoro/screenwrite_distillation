{"scene_id": "s02123", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02123.fountain", "heading": "INT. MERIDIAN LOGISTICS - WELLNESS NAP POD ROOM - DAY", "cast": [{"id": 0, "name": "GWEN", "names": ["GWEN"], "gender": "?", "first": 4, "spoke": 8}, {"id": 1, "name": "PRATT", "names": ["PRATT"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "TOBIAS LINDQVIST", "names": ["TOBIAS LINDQVIST", "TOBIAS"], "gender": "?", "first": 5, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. MERIDIAN LOGISTICS - WELLNESS NAP POD ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Six egg-shaped pods.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Ambient whale music.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A laminated sign reads \"SYNERGY RECHARGE: 15 MIN MAX.\"", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "GWENDOLYN \"GWEN\" PRATT, 40s, lanyard, tired eyes, sits on a pod with a laptop.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "TOBIAS LINDQVIST, 30s, quarter-zip, enters carrying a kombucha.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Gwen. Didn't know anyone used these.", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "I'm not napping. I'm hiding.", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Same. Can I hide here too?", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Pod four is warmer.", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "He sits in pod four.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Sips his kombucha.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Is the all-hands still at three?", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "It moved to four. Then back to three. Then it became a \"pre-sync.\"", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "What do we pre-sync?", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "The post-sync.", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Right.", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Beat.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "The whale music swells.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Gwennie, did you read the memo about the memo?", "name": "TOBIAS", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I summarized it. Toby, it said please stop using the word \"deliverable.\"", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "I'll circle back on that.", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "That's the word we're not supposed to say.", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Which one?", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "All of them.", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "He nods.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Lies back in the pod.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Closes his eyes.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Wake me at three.", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "It's three.", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Wake me at four.", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}