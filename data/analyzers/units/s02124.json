{"scene_id": "s02124", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02124.fountain", "heading": "INT. HOLLOWAY & SONS FUNERAL HOME - BACK ROOM - DAY", "cast": [{"id": 0, "name": "PRIYA SHENOY", "names": ["PRIYA SHENOY", "SHENOY", "DEV SHENOY", "PRIYA", "DEV"], "gender": "f", "first": 4, "spoke": 14}, {"id": 1, "name": "POLLY", "names": ["POLLY"], "gender": "?", "first": 5, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOLLOWAY & SONS FUNERAL HOME - BACK ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Beige carpet.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A box of tissues on every surface.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A brass urn on a folding table between three siblings.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "PRIYA SHENOY, 40, sensible blazer, stirs coffee.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "LEOPOLD \"POLLY\" SHENOY, 35, rumpled suit, reads the ceiling.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "DEV SHENOY, 28, sunglasses indoors, bounces a knee.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Dad would've wanted the lake.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Dad hated the lake.", "name": "POLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Dad hated everything with wet feet.", "name": "DEV", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "So we scatter at the lake anyway.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Polly nods.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Dev nods.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Priya sips.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Nobody looks at the urn.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Who's holding it in the car?", "name": "POLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Not me.", "name": "DEV", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Not me.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Fine. Me.", "name": "POLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He picks up the urn.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Weighs it in both hands.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Frowns slightly.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Sets it down again.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Picks it up again.", "para": 3, "sent": 4, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Polly.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "It's fine.", "name": "POLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "What's fine?", "name": "DEV", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "It's fine. Probably fine.", "name": "POLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Open it.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Don't open it.", "name": "DEV", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "I'm opening it.", "name": "POLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Polly, we are not opening our dead father in a funeral home.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Dev, shut the door.", "name": "POLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "It's shut.", "name": "DEV", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Polly twists the lid.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "A pale powder puffs.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "He sniffs.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Dips a finger.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Tastes.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "All three freeze.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Priya sets her coffee down very carefully.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Buttermilk.", "name": "POLLY", "speaker": 1, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "What?", "name": "DEV", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Pancake mix.", "name": "POLLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Dad's pancake mix is at the lake house.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Then where's Dad?", "name": "DEV", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "They look at a second brass urn on the shelf behind them.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Same size.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Same dent.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "The three scatter toward the shelf, bumping shoulders, nobody speaking.", "para": 7, "sent": 0, "present": [0, 1]}]}