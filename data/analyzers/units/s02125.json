{"scene_id": "s02125", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02125.fountain", "heading": "EXT. PLATTE RIVER FERRY - FLOOD STAGE - DAWN", "cast": [{"id": 0, "name": "SHERIFF AMOS DRUMMOND", "names": ["SHERIFF AMOS DRUMMOND", "DRUMMOND"], "gender": "m", "first": 5, "spoke": 9}, {"id": 1, "name": "CALEB DUNMORE", "names": ["CALEB DUNMORE", "DUNMORE"], "gender": "m", "first": 6, "spoke": 7}, {"id": 2, "name": "SILAS PRUITT", "names": ["SILAS PRUITT", "PRUITT"], "gender": "?", "first": 7, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "EXT. PLATTE RIVER FERRY - FLOOD STAGE - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A flat barge on a rope.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Brown water, fast and wide.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Mist hangs on the cottonwoods.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The rope sings under the strain.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SHERIFF AMOS DRUMMOND, 50s, iron-grey moustache, badge dull with rust, stands at the rail with a shotgun.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "CALEB DUNMORE, 30s, wrists chained, hat gone, a cut over one eye, sits on a crate.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "SILAS PRUITT, 70, one milky eye, ferryman, leans on the long pole and hums.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "The barge lurches.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Drummond steadies.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Dunmore grins.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Rope's fraying, Sheriff.", "name": "DUNMORE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Shut your mouth.", "name": "DRUMMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "He's right.", "name": "PRUITT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Whose side are you on, Silas?", "name": "DRUMMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "The side that stays dry.", "name": "PRUITT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Drummond swings the shotgun toward Pruitt.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Pruitt does not blink.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Cut the rope and I cut you.", "name": "DRUMMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Then who poles?", "name": "PRUITT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Let me pole. I grew up on this river.", "name": "DUNMORE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "You grew up in a jail.", "name": "DRUMMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "After the river.", "name": "DUNMORE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Drummond steps close.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Dunmore stares up at him.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Talk.", "name": "DRUMMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "My brother's buried in Kearney. Left me a map. Gold under the old ferry landing, before the flood took it. I tell you, you let me go.", "name": "DUNMORE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "No.", "name": "DRUMMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Half. You and me. Silas gets the barge.", "name": "DUNMORE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "I got a barge.", "name": "PRUITT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "A better one.", "name": "DUNMORE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "You're lying.", "name": "DRUMMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Maybe. But what's a lie when the rope's about to snap?", "name": "DUNMORE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Sheriff.", "name": "PRUITT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Not now, Silas.", "name": "DRUMMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Sheriff, look downriver.", "name": "PRUITT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "A tree trunk the size of a church bell tower tumbles out of the mist, root-wad first, straight for the barge.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Pole! Pole!", "name": "DRUMMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Pruitt jams the pole.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Dunmore lunges for the key on Drummond's belt.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Drummond clubs him with the shotgun stock.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Dunmore drops.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "The trunk clips the barge.", "para": 6, "sent": 4, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Planks scream.", "para": 6, "sent": 5, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Drummond is on his knees.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Dunmore is on his back.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Pruitt hangs from the pole, laughing, wild.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "That's the river!", "name": "PRUITT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "The rope snaps.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "The barge spins free into the brown.", "para": 8, "sent": 1, "present": [0, 1, 2]}]}