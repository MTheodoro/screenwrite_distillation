{"scene_id": "s02126", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02126.fountain", "heading": "INT. STRIKE ZONE LANES - OFFICE - NIGHT", "cast": [{"id": 0, "name": "INSPECTOR NELL AKINTOLA", "names": ["INSPECTOR NELL AKINTOLA", "NELL"], "gender": "f", "first": 9, "spoke": 12}], "units": [{"u": 0, "kind": "heading", "text": "INT. STRIKE ZONE LANES - OFFICE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A defunct bowling alley.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dead pinsetters hulk in the dark beyond the glass.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A steel desk.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A cassette recorder on the blotter.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A rotary phone, unplugged.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "Nothing moves.", "para": 1, "sent": 0, "present": []}, {"u": 7, "kind": "action", "text": "A key turns.", "para": 2, "sent": 0, "present": []}, {"u": 8, "kind": "action", "text": "The door sticks, then gives.", "para": 2, "sent": 1, "present": []}, {"u": 9, "kind": "action", "text": "INSPECTOR NELL AKINTOLA, 50s, raincoat, flat shoes, a paper evidence bag under her arm, steps in and shakes water from her hair.", "para": 2, "sent": 2, "present": [0]}, {"u": 10, "kind": "action", "text": "She sets the bag on the desk.", "para": 3, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "Presses PLAY on the recorder.", "para": 3, "sent": 1, "present": [0]}, {"u": 12, "kind": "dialogue", "text": "Tuesday. Strike Zone. Owner says he never left the shift.", "name": "NELL", "speaker": 0, "ext": ["V.O."], "paren": ["tape, tinny"], "dual": false, "present": [0]}, {"u": 13, "kind": "dialogue", "text": "He did.", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 14, "kind": "dialogue", "text": "Receipts say otherwise. Parking stub at the Harbour Hotel, ten fifteen.", "name": "NELL", "speaker": 0, "ext": ["V.O."], "paren": ["tape"], "dual": false, "present": [0]}, {"u": 15, "kind": "dialogue", "text": "Ten fourteen, actually.", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 16, "kind": "dialogue", "text": "Lane eleven. The foul line. Something under the tape.", "name": "NELL", "speaker": 0, "ext": ["V.O."], "paren": ["tape"], "dual": false, "present": [0]}, {"u": 17, "kind": "dialogue", "text": "Three keys on a ring. Tagged. Not his.", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 18, "kind": "dialogue", "text": "Ask about the night man.", "name": "NELL", "speaker": 0, "ext": ["V.O."], "paren": ["tape"], "dual": false, "present": [0]}, {"u": 19, "kind": "dialogue", "text": "Night man doesn't exist.", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 20, "kind": "dialogue", "text": "So who signed the sheet?", "name": "NELL", "speaker": 0, "ext": ["V.O."], "paren": ["tape"], "dual": false, "present": [0]}, {"u": 21, "kind": "dialogue", "text": "That's what I'm asking, Nell.", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 22, "kind": "action", "text": "She stops the tape.", "para": 4, "sent": 0, "present": [0]}, {"u": 23, "kind": "action", "text": "Rewinds a few seconds.", "para": 4, "sent": 1, "present": [0]}, {"u": 24, "kind": "action", "text": "Presses PLAY.", "para": 4, "sent": 2, "present": [0]}, {"u": 25, "kind": "dialogue", "text": "Ask about the night man.", "name": "NELL", "speaker": 0, "ext": ["V.O."], "paren": ["tape"], "dual": false, "present": [0]}, {"u": 26, "kind": "action", "text": "She nods.", "para": 5, "sent": 0, "present": [0]}, {"u": 27, "kind": "action", "text": "Takes out a pen.", "para": 5, "sent": 1, "present": [0]}, {"u": 28, "kind": "action", "text": "Writes on her palm.", "para": 5, "sent": 2, "present": [0]}, {"u": 29, "kind": "action", "text": "Switches off the recorder.", "para": 5, "sent": 3, "present": [0]}, {"u": 30, "kind": "dialogue", "text": "Night man.", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 31, "kind": "action", "text": "She turns off the light and leaves.", "para": 6, "sent": 0, "present": [0]}, {"u": 32, "kind": "action", "text": "The door clicks shut.", "para": 6, "sent": 1, "present": [0]}]}