{"scene_id": "s02128", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02128.fountain", "heading": "INT. CLOCKMAKER'S SHOP - CANAL STREET - AFTERNOON", "cast": [{"id": 0, "name": "MIREILLE DUVAL", "names": ["MIREILLE DUVAL", "MIREILLE"], "gender": "?", "first": 5, "spoke": 8}, {"id": 1, "name": "ABERNATHY SOLOMON", "names": ["ABERNATHY SOLOMON", "SOLOMON"], "gender": "m", "first": 8, "spoke": 10}, {"id": 2, "name": "KASPAR DUVAL", "names": ["KASPAR DUVAL", "KASPAR"], "gender": "m", "first": 5, "spoke": 5}, {"id": 3, "name": "TEDDY", "names": ["TEDDY"], "gender": "?", "first": 10, "spoke": 6}, {"id": 4, "name": "ILIC", "names": ["ILIC"], "gender": "?", "first": 10, "spoke": 0}, {"id": 5, "name": "CONSTABLE ROSSITER", "names": ["CONSTABLE ROSSITER", "ROSSITER"], "gender": "m", "first": 11, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. CLOCKMAKER'S SHOP - CANAL STREET - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "A narrow shop wedged between a bakery and a bridge.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Every wall ticks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Hundreds of clocks, none of them agreeing.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Light through the bow window falls in long yellow bars across the workbench, where a velvet cloth lies flat and empty.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MIREILLE DUVAL, 60s, black wool, gloves still on, sits very straight in the only good chair.", "para": 1, "sent": 0, "present": [0, 2]}, {"u": 6, "kind": "action", "text": "She does not look at the clocks.", "para": 1, "sent": 1, "present": [0, 2]}, {"u": 7, "kind": "action", "text": "She looks at the cloth.", "para": 1, "sent": 2, "present": [0, 2]}, {"u": 8, "kind": "action", "text": "MR. ABERNATHY SOLOMON, 70, solicitor, bow tie and a folder of papers, clears his throat and gets no answer from the room.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "KASPAR DUVAL, 30s, her nephew, leans in the doorway to the back, arms folded, a gold watch on his wrist that is a little too new.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "TEODORA \"TEDDY\" ILIC, 19, apprentice, ink on her thumbs, stands by the workbench and keeps wiping the same spot with a rag.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "CONSTABLE ROSSITER, 40s, damp from the canal towpath, stands inside the door and holds his helmet in both hands like a collection plate.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "If everyone is seated.", "name": "SOLOMON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "No one is seated.", "name": "KASPAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "If everyone is present, then.", "name": "SOLOMON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "A cuckoo clock, somewhere, strikes the wrong hour.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Nobody reacts.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "The cuckoo goes in.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Mr. Duval left the shop and its contents to his wife.", "name": "SOLOMON", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Yes.", "name": "MIREILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "With the exception of one item.", "name": "SOLOMON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Teddy's rag stops.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Kaspar's jaw moves, as if chewing something small.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "The Brandt.", "name": "MIREILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "The Brandt regulator. Walnut case. 1791. Described in the will as \"bequeathed to the one who has kept it running.\"", "name": "SOLOMON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "That's me.", "name": "KASPAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "It isn't.", "name": "TEDDY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Excuse me?", "name": "KASPAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "It stopped on Friday.", "name": "TEDDY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Silence.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "A hundred clocks tick on.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Stopped how, miss?", "name": "ROSSITER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Someone opened the case. Took out the weights.", "name": "TEDDY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Kaspar. Your hands.", "name": "MIREILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "What about them?", "name": "KASPAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "They are very clean for a man who works at a bank.", "name": "MIREILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Kaspar looks at his hands.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "He turns them over.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "He pushes them into his pockets.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "I must remind everyone that the bequest is conditional.", "name": "SOLOMON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Conditional on what?", "name": "ROSSITER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "On the clock being found in working order.", "name": "SOLOMON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Then it is nobody's.", "name": "MIREILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "Madam, that would be the simplest reading.", "name": "SOLOMON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Mireille stands.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Smooths her coat.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "She crosses to the workbench and lifts the edge of the velvet cloth with one gloved finger.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "Underneath is a small brass key.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "She studies it.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "Slides it into her handbag.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "That's the winding key.", "name": "TEDDY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "Yes. It was hanging round his neck when they found him.", "name": "MIREILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "Madam, that is evidence.", "name": "ROSSITER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "Then you may have it, Constable. After tea.", "name": "MIREILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "She walks to the door.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "Rossiter steps aside without being asked.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "Aunt Mireille.", "name": "KASPAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "Wind your own watch, Kaspar.", "name": "MIREILLE", "speaker": 0, "ext": [], "paren": ["not turning"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "She leaves.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "The bell above the door rings once.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "action", "text": "Kaspar looks down at the gold watch.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "It has stopped.", "para": 13, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "Teddy puts the rag down.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "Takes her coat from the hook.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "dialogue", "text": "I'll bring the weights back tomorrow.", "name": "TEDDY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "dialogue", "text": "You have them?", "name": "SOLOMON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "dialogue", "text": "I did not say that.", "name": "TEDDY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "action", "text": "She leaves too.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "action", "text": "The bell rings.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "action", "text": "Rossiter puts on his helmet.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "dialogue", "text": "Mr. Solomon, I think I shall need to read that will myself.", "name": "ROSSITER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "dialogue", "text": "It is rather long.", "name": "SOLOMON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "dialogue", "text": "I have time.", "name": "ROSSITER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "action", "text": "Solomon opens his folder.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "action", "text": "Kaspar watches the cloth.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}