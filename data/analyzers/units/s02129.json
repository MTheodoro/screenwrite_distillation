{"scene_id": "s02129", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02129.fountain", "heading": "INT. COUNTY COURTHOUSE - COURTROOM 4 - NIGHT", "cast": [{"id": 0, "name": "LUCIA FERRANTE", "names": ["LUCIA FERRANTE", "FERRANTE"], "gender": "?", "first": 5, "spoke": 9}, {"id": 1, "name": "BENEDICT HAYES", "names": ["BENEDICT HAYES", "HAYES"], "gender": "m", "first": 6, "spoke": 7}, {"id": 2, "name": "JONAH KEPLER", "names": ["JONAH KEPLER", "JONAH"], "gender": "?", "first": 7, "spoke": 5}, {"id": 3, "name": "INTERCOM", "names": ["INTERCOM"], "gender": "?", "first": 13, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. COUNTY COURTHOUSE - COURTROOM 4 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Power's out.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Emergency lights buzz amber.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The gallery is empty.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Four people, one table.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LUCIA FERRANTE, 40s, defense counsel, sleeves rolled.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "BENEDICT HAYES, 50s, prosecutor, tie loosened.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "JONAH KEPLER, 22, defendant, hoodie, handcuffed to the chair.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Rain on the windows.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Anyone have a flashlight?", "name": "HAYES", "speaker": 1, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Phone. Dying.", "name": "FERRANTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I could've told you the wiring in this place is garbage.", "name": "JONAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Jonah. Quiet.", "name": "FERRANTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Courtroom Four, this is Security. Generator's down. Stay seated. Repeat. Stay seated.", "name": "INTERCOM", "speaker": 3, "ext": ["O.S."], "paren": ["crackling"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Copy.", "name": "HAYES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Of course it dies on closing argument.", "name": "FERRANTE", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Hayes stands.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Paces.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Stops at the exhibit table.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Ms. Ferrante, the knife.", "name": "HAYES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "What about it?", "name": "FERRANTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "It's gone.", "name": "HAYES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Ferrante's head snaps up.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Jonah's chair scrapes.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Gone how?", "name": "FERRANTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Evidence bag's open. Tag's still there.", "name": "HAYES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "I didn't touch anything.", "name": "JONAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Jonah, shut up.", "name": "FERRANTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Chain of custody. Dear God.", "name": "HAYES", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Hayes lunges for the bag.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Ferrante gets there first.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "They both freeze.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Under the tag, taped to the plastic, is a note.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "She reads it.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "\"Found in my locker. Sorry. -- Deputy Marsh.\"", "name": "FERRANTE", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Hayes takes the note.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Reads it.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Sits down hard.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "So, what, I'm free?", "name": "JONAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "No.", "name": "HAYES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Not yet.", "name": "FERRANTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "But that's good, right?", "name": "JONAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Jonah.", "name": "FERRANTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Okay. Quiet.", "name": "JONAH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "The lights stutter back on.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "The room is bright and ordinary.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Hayes sets the note on the table between them, and leaves his hand flat on top of it.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Power's restored. Carry on.", "name": "INTERCOM", "speaker": 3, "ext": ["O.S."], "paren": ["crackling"], "dual": false, "present": [0, 2, 3]}, {"u": 48, "kind": "action", "text": "Nobody moves.", "para": 7, "sent": 0, "present": [0, 2, 3]}]}