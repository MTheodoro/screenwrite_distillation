{"scene_id": "s02130", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02130.fountain", "heading": "INT. VAULT 9 - SALT CAVERN SERVER ARCHIVE - CONTINUOUS", "cast": [{"id": 0, "name": "VESNA ROOK", "names": ["VESNA ROOK", "VESNA"], "gender": "?", "first": 5, "spoke": 19}, {"id": 1, "name": "HALF-TIDE", "names": ["HALF-TIDE"], "gender": "?", "first": 6, "spoke": 16}], "units": [{"u": 0, "kind": "heading", "text": "INT. VAULT 9 - SALT CAVERN SERVER ARCHIVE - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Cathedral-high cavern carved from rock salt.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of black racks glitter with frost.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Blue status lights blink in lines to the horizon.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The air hums.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "VESNA ROOK, 40s, thermal suit, headlamp, kneels at an open rack and pulls cable.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "At her hip, a squat maintenance bot, HALF-TIDE, trundles on treads, tools folded under its chassis.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Rack forty-one. Temperature nominal.", "name": "HALF-TIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Nominal is a lie. Frost on the casing.", "name": "VESNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Frost is within tolerance.", "name": "HALF-TIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Tolerance doesn't breathe.", "name": "VESNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She wipes the casing with a glove.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Beneath the frost, a fingerprint.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Someone's been here.", "name": "VESNA", "speaker": 0, "ext": ["CONT'D"], "paren": ["to herself"], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Visitor logs show no entries for nine years.", "name": "HALF-TIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Logs lie, too.", "name": "VESNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She pulls a handheld scanner, sweeps the aisle.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "A line of red dots blinks where the frost is thinnest.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Control, Vault Nine. I have footprints in the dust. Fresh.", "name": "VESNA", "speaker": 0, "ext": ["CONT'D"], "paren": ["into her collar mic, to the surface"], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Control does not respond.", "name": "HALF-TIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Control hasn't responded in four hours.", "name": "VESNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Correct.", "name": "HALF-TIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "You don't find that strange?", "name": "VESNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "I find it consistent.", "name": "HALF-TIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Vesna stands.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "The cavern ticks as salt cools.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Follow the prints.", "name": "VESNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Recommend against.", "name": "HALF-TIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Recommend noted.", "name": "VESNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "They walk.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "The headlamp throws her shadow forty feet up the wall.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Rack after rack.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "At the end of the aisle, a steel door stands open, warm light spilling out.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "That door is not on the schematic.", "name": "HALF-TIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "I noticed.", "name": "VESNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "She stops at the threshold.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Inside: a cot, a stove, a wall of handwritten pages, a coffee mug still steaming.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Somebody lives here.", "name": "VESNA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Nobody lives here.", "name": "HALF-TIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Then who made the coffee?", "name": "VESNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Half-Tide extends a sensor stalk toward the mug.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Temperature seventy-one degrees Celsius.", "name": "HALF-TIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Recent.", "name": "VESNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Very recent.", "name": "HALF-TIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "They look at each other.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "Machine.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Woman.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "The same breath held.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Vesna.", "name": "HALF-TIDE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Don't say it.", "name": "VESNA", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Exit route is behind us.", "name": "HALF-TIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "I know.", "name": "VESNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "She steps in anyway.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "Picks up one handwritten page.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "Reads it.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "Her face does not change.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "What does it say?", "name": "HALF-TIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "My name.", "name": "VESNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "She lets the page fall.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "Every light in the vault goes out at once.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "Half-Tide.", "name": "VESNA", "speaker": 0, "ext": ["CONT'D"], "paren": ["in the dark"], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "I am here.", "name": "HALF-TIDE", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "Stay close.", "name": "VESNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "Always.", "name": "HALF-TIDE", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "A single blue light blinks on at the far end of the cavern.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "Then another.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "Then every rack, in order, coming toward them.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "All right. I'm listening.", "name": "VESNA", "speaker": 0, "ext": [], "paren": ["to the dark, firm"], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "The lights stop a few feet away.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "The hum drops to a held note.", "para": 12, "sent": 1, "present": [0, 1]}]}