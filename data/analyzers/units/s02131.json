{"scene_id": "s02131", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02131.fountain", "heading": "INT. FROSTLINE ARENA - ICE RESURFACER GARAGE - NIGHT", "cast": [{"id": 0, "name": "COACH BRONAGH QUILL", "names": ["COACH BRONAGH QUILL"], "gender": "?", "first": 5, "spoke": 0}, {"id": 1, "name": "SLICK ADEYEMI", "names": ["SLICK ADEYEMI", "SLICK"], "gender": "m", "first": 6, "spoke": 4}, {"id": 2, "name": "NEW GUY", "names": ["NEW GUY"], "gender": "?", "first": 7, "spoke": 4}, {"id": 3, "name": "ANNOUNCER", "names": ["ANNOUNCER"], "gender": "?", "first": 8, "spoke": 2}, {"id": 4, "name": "COACH", "names": ["COACH"], "gender": "?", "first": 9, "spoke": 8}, {"id": 5, "name": "FINN", "names": ["FINN"], "gender": "?", "first": 22, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. FROSTLINE ARENA - ICE RESURFACER GARAGE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A concrete garage under the stands.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Steam from the melt pit.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The ice resurfacer idles, humming.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A radio on a shelf crackles with the third period.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "COACH BRONAGH QUILL, 50s, windbreaker, unlit cigar.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "SLICK ADEYEMI, 60, resurfacer driver, thermos, headphones around his neck.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "NEW GUY, 19, goalie pads half on, sits on an upturned bucket and stares at the floor.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "And the Wolves trail by one with six minutes left.", "name": "ANNOUNCER", "speaker": 3, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Starter's got a broken wrist. You're in.", "name": "COACH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "I know.", "name": "NEW GUY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Say something.", "name": "COACH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "I don't feel anything.", "name": "NEW GUY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "That's the cold.", "name": "SLICK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "That's nerves.", "name": "COACH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Slick, wipe the blue line when the horn goes.", "name": "COACH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Slick wipes whatever Slick pleases.", "name": "SLICK", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Slick offers the thermos.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "The kid takes it, sips, gags.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "What is that?", "name": "NEW GUY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Coffee and my wife's brandy.", "name": "SLICK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "What's your name, kid? Really. Not \"New Guy.\"", "name": "COACH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Finn. Finn Oduya.", "name": "NEW GUY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Finn. You ever play in front of eight thousand?", "name": "COACH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Four. At a funeral.", "name": "FINN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "That's a tougher crowd.", "name": "SLICK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "And the horn sounds. Two minutes break.", "name": "ANNOUNCER", "speaker": 3, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "The garage door rumbles.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Cold light spills in.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Go.", "name": "COACH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Finn stands.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Buckles the last strap.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Slick fires up the resurfacer.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Coach sets the cigar in Finn's glove, like a sacrament.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "I'll bring it back.", "name": "FINN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "You'll bring a win back.", "name": "COACH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Finn skates out into the light.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}