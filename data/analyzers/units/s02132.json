{"scene_id": "s02132", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02132.fountain", "heading": "INT. HARBOR FERRY TERMINAL - WAITING ROOM - DAY", "cast": [{"id": 0, "name": "RUTH KOWALCZYK", "names": ["RUTH KOWALCZYK", "RUTH"], "gender": "?", "first": 5, "spoke": 14}, {"id": 1, "name": "ARJUN BOSE", "names": ["ARJUN BOSE", "ARJUN"], "gender": "m", "first": 6, "spoke": 13}, {"id": 2, "name": "LINNEA STRAND", "names": ["LINNEA STRAND", "LINNEA"], "gender": "?", "first": 7, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. HARBOR FERRY TERMINAL - WAITING ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Plastic chairs bolted in rows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A vending machine hums.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Through the window, the ferry rocks at the dock.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "At a folding table in the corner, a deposition.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "RUTH KOWALCZYK, 50s, attorney, reading glasses on a chain.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "ARJUN BOSE, 40s, deponent, anxious, tie too tight.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "LINNEA STRAND, 30s, court reporter, fingers poised over the stenotype.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Let the record show we are in the Harbor terminal because the courthouse flooded.", "name": "RUTH", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Noted.", "name": "LINNEA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Mr. Bose, state your name.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Arjun Bose.", "name": "ARJUN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "And your occupation?", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Dock inspector.", "name": "ARJUN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Were you on duty on the fourteenth of March?", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "I was.", "name": "ARJUN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Did you sign the crane certificate that morning?", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I... may have.", "name": "ARJUN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "May have?", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Did.", "name": "ARJUN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "The vending machine clunks.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "A bag of chips falls.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Even the snacks have a better memory than my witness.", "name": "RUTH", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "I'm sorry?", "name": "ARJUN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Nothing. Next question. Mr. Bose, did you inspect the crane before signing?", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "I inspected a crane.", "name": "ARJUN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Was it the crane in question?", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "It was a crane.", "name": "ARJUN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Counsel, I need a clear answer for the record.", "name": "LINNEA", "speaker": 2, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Mr. Bose, it's either yes or no.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "No.", "name": "ARJUN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "No, you did not inspect the correct crane?", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "No, I did not.", "name": "ARJUN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Could you both speak one at a time?", "name": "LINNEA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Mr. Bose, who told you to sign?", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "My supervisor.", "name": "ARJUN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "My supervisor said it was routine.", "name": "ARJUN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Your supervisor is a Mr. Dillard.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Yes.", "name": "ARJUN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Let the record show the witness has just changed his testimony.", "name": "RUTH", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "The ferry horn sounds.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "All three look up.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Linnea types.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Arjun loosens his tie.", "para": 3, "sent": 3, "present": [0, 1, 2]}]}