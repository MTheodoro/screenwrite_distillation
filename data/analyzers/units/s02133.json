{"scene_id": "s02133", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02133.fountain", "heading": "INT. SAN BERNARDO ABBEY - WINE CELLAR - NIGHT", "cast": [{"id": 0, "name": "SERGEANT CORNELIUS HOLLOWAY", "names": ["SERGEANT CORNELIUS HOLLOWAY", "HOLLOWAY"], "gender": "m", "first": 5, "spoke": 10}, {"id": 1, "name": "PRIVATE BAPTISTE FONTAINE", "names": ["PRIVATE BAPTISTE FONTAINE", "FONTAINE"], "gender": "m", "first": 6, "spoke": 5}, {"id": 2, "name": "CORPORAL YUKI TAKADA", "names": ["CORPORAL YUKI TAKADA", "TAKADA"], "gender": "m", "first": 7, "spoke": 6}, {"id": 3, "name": "BROTHER ANSELMO", "names": ["BROTHER ANSELMO", "ANSELMO"], "gender": "?", "first": 8, "spoke": 6}, {"id": 4, "name": "OBERLEUTNANT KRAUSS", "names": ["OBERLEUTNANT KRAUSS", "KRAUSS"], "gender": "?", "first": 54, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. SAN BERNARDO ABBEY - WINE CELLAR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Barrel-vaulted stone.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of dusty casks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single oil lamp.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Somewhere above, the dull thud of artillery, steady as a clock.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SERGEANT CORNELIUS HOLLOWAY, 35, helmet off, Tommy gun across his knees, sits on a cask.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "PRIVATE BAPTISTE FONTAINE, 20, French-Canadian, shivering, wraps a bandage round his own forearm.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "CORPORAL YUKI TAKADA, 25, Nisei interpreter, sits on the stairs with an Italian phrasebook.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "BROTHER ANSELMO, 70, Benedictine, stout, wine-stained robe, pours three tin cups from a cask.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "His hands are steady.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Brother, how long have you been in this cellar?", "name": "HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Since the bombs came. Eleven days.", "name": "ANSELMO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Undici giorni.", "name": "TAKADA", "speaker": 2, "ext": [], "paren": ["translating"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Eleven. Yes. Thank you, my son.", "name": "ANSELMO", "speaker": 3, "ext": [], "paren": ["in English"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Fontaine takes a cup.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Holloway takes a cup.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "He sniffs and drinks.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Sergeant, he's good.", "name": "FONTAINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "The wine?", "name": "HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "The wine. And the Brother.", "name": "FONTAINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Sergeant, the church above us is clear. No enemy.", "name": "TAKADA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Good.", "name": "HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "The artillery thuds.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Dust sifts from the vault.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "You are hungry. I have bread.", "name": "ANSELMO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "We're fine.", "name": "HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "I insist.", "name": "ANSELMO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "He disappears behind a rack of casks.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Holloway looks at Takada.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Takada shakes his head.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Fontaine leans toward Holloway.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Sergeant, he said \"eleven days.\" But the shelling started on the ninth.", "name": "FONTAINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Say that again.", "name": "HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Day nine. The shelling.", "name": "FONTAINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Holloway stands.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Slowly.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "His hand finds the Tommy gun.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Corporal. Ask him who the bread is for.", "name": "HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Padre, per chi \u00e8 il pane?", "name": "TAKADA", "speaker": 2, "ext": [], "paren": ["calling"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "No answer.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Takada stands too.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Fontaine raises his rifle.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "The lamp flickers.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "He's not answering.", "name": "TAKADA", "speaker": 2, "ext": ["CONT'D"], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Holloway edges past the first cask.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Fontaine follows him, boots silent on the flagstones.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "The second rack.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "The third.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "A narrow door, ajar, set in the stone.", "para": 8, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Brother Anselmo. Come out.", "name": "HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "The door swings open.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Anselmo stands in the opening, a loaf of bread in each hand.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Behind him, a pale OFFICER in a grey-green greatcoat sits on a pallet, leg splinted, a Luger in his fist, pointed at Holloway.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "OBERLEUTNANT KRAUSS, 30, blond, sweat-slick, eyes steady.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "Gentlemen. Please do not make the Brother choose.", "name": "KRAUSS", "speaker": 4, "ext": [], "paren": ["accented"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Fontaine's rifle swings to Krauss.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "Takada's pistol clears the holster.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Holloway's Tommy gun rises.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "Everyone holds.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "No more dying in my cellar.", "name": "ANSELMO", "speaker": 3, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "Nobody moves.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "The artillery thuds.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "A barrel creaks.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "Anselmo lowers the bread to the stone floor, one loaf and then the other, and raises both open hands between the guns.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "Brother, step aside.", "name": "HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "dialogue", "text": "No.", "name": "ANSELMO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "dialogue", "text": "He's a stubborn man.", "name": "KRAUSS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "dialogue", "text": "Sergeant, I can't see a shot.", "name": "FONTAINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "dialogue", "text": "Then don't take it.", "name": "HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "dialogue", "text": "Wie lange hier?", "name": "TAKADA", "speaker": 2, "ext": [], "paren": ["to Krauss, in German"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "dialogue", "text": "Eleven days.", "name": "KRAUSS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "action", "text": "Takada closes his eyes for a long moment.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "dialogue", "text": "Sergeant. He was telling the truth.", "name": "TAKADA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "dialogue", "text": "He was telling us something.", "name": "HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "action", "text": "He lowers the Tommy gun an inch.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 76, "kind": "action", "text": "Fontaine does not.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 77, "kind": "action", "text": "Krauss does not.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 78, "kind": "action", "text": "The oil lamp gutters.", "para": 14, "sent": 3, "present": [0, 1, 2, 3, 4]}]}