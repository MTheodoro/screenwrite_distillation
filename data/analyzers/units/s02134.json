{"scene_id": "s02134", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02134.fountain", "heading": "EXT. MUSHROOM RING - OLD FOREST - DUSK", "cast": [{"id": 0, "name": "BRAMBLE HOLLINGS", "names": ["BRAMBLE HOLLINGS", "BRAMBLE"], "gender": "f", "first": 3, "spoke": 3}, {"id": 1, "name": "RUSKIN", "names": ["RUSKIN"], "gender": "?", "first": 6, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. MUSHROOM RING - OLD FOREST - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "A circle of pale toadstools in black moss.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fireflies the color of tea.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "BRAMBLE HOLLINGS, 30s, stands at the edge in a patched coat, a lantern at her feet.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "She does not step in.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "action", "text": "Across the ring a thin man in a rust-colored coat leans on a birch.", "para": 1, "sent": 2, "present": [0]}, {"u": 6, "kind": "action", "text": "RUSKIN, ageless, sharp-faced.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He watches her.", "para": 1, "sent": 4, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You said you'd be gone by now.", "name": "BRAMBLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I said I'd try.", "name": "RUSKIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She picks up the lantern.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Puts it down again.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He tilts his head, the way a fox does.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "My mother left a debt.", "name": "BRAMBLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "She left a bargain.", "name": "RUSKIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She takes a step.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "The toadstools sway.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He flinches, then masks it.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Say it plainly. What do you want?", "name": "BRAMBLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "The lantern.", "name": "RUSKIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She looks at it.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Her thumb finds the handle.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "For a moment she doesn't breathe.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Then she kicks it across the ring.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "The glass cracks.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "The flame jumps and dies.", "para": 4, "sent": 5, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "He stares at the dark lantern.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "His shoulders drop.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "He bows, a little too low.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "That's all.", "name": "RUSKIN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "She turns away and does not look back.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Behind her, a fox barks once, softly, and the fireflies go out.", "para": 6, "sent": 1, "present": [0, 1]}]}