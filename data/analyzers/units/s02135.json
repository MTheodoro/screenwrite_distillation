{"scene_id": "s02135", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02135.fountain", "heading": "INT. HALLORAN PLANETARIUM - DOME - NIGHT", "cast": [{"id": 0, "name": "PROFESSOR ARISTIDE BOUCHARD", "names": ["PROFESSOR ARISTIDE BOUCHARD", "BOUCHARD"], "gender": "?", "first": 6, "spoke": 7}, {"id": 1, "name": "JUNE ASANTE", "names": ["JUNE ASANTE", "JUNE"], "gender": "f", "first": 7, "spoke": 3}, {"id": 2, "name": "ROBBO DUNN", "names": ["ROBBO DUNN", "ROBBO"], "gender": "m", "first": 8, "spoke": 3}, {"id": 3, "name": "DETECTIVE MAXWELL CROFT", "names": ["DETECTIVE MAXWELL CROFT", "CROFT"], "gender": "?", "first": 9, "spoke": 9}, {"id": 4, "name": "WOMAN IN VIOLET", "names": ["WOMAN VIOLET", "WOMAN IN VIOLET"], "gender": "?", "first": 10, "spoke": 3}, {"id": 5, "name": "CORDELIA VANE", "names": ["CORDELIA VANE", "CORDELIA"], "gender": "?", "first": 44, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. HALLORAN PLANETARIUM - DOME - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "The dome overhead is black and bare, the projector asleep in the center of the room like a great iron insect.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of tilted seats.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single work lamp on a stand.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Five people, arranged by accident into a rough circle.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "No one has taken a seat.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "PROFESSOR ARISTIDE BOUCHARD, 70, tweed, bow tie, pale from a long illness, cradles a tin of lens cloths.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "JUNE ASANTE, 20s, his research assistant, a clipboard against her chest.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "ROBBO DUNN, 50s, caretaker, boiler suit, holds a ring of keys the size of a fist.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "DETECTIVE MAXWELL CROFT, 40s, trench coat, notebook, unhurried.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "And in the center aisle, a WOMAN IN VIOLET, 50s, gloves, veil pushed back, who has not moved since the lights went down.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Professor, you reported the break-in at nine.", "name": "CROFT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "At nine twenty.", "name": "BOUCHARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "And the thing that was stolen.", "name": "CROFT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "A glass plate. A photograph of the sky. Nothing the world would miss.", "name": "BOUCHARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Robbo looks at his keys.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "June adjusts her clipboard.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "The Woman in Violet watches the empty dome.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Then why did the alarm trip on all four doors at once?", "name": "CROFT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Old wiring.", "name": "ROBBO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Is that so.", "name": "CROFT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Old wiring. Aye.", "name": "ROBBO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "June clears her throat.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Everyone looks.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "She looks away.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Miss Asante?", "name": "CROFT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "The plate was from 1919. It showed the eclipse that proved Einstein.", "name": "JUNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "June.", "name": "BOUCHARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "It's worth something, Professor.", "name": "JUNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Not to us.", "name": "BOUCHARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "To someone.", "name": "CROFT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "The Woman in Violet takes one step toward the projector.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Robbo takes one step back.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "You've left the lamp on.", "name": "WOMAN IN VIOLET", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Aye, ma'am.", "name": "ROBBO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "It spoils the dark.", "name": "WOMAN IN VIOLET", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Robbo reaches for the switch.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Hesitates.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Leave it.", "name": "CROFT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "The Woman in Violet turns.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Slowly.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Regards the detective with the same calm she brought to the dome.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "And you are?", "name": "CROFT", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "A friend of the late Mr. Halloran.", "name": "WOMAN IN VIOLET", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Cordelia.", "name": "BOUCHARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "The name falls into the room like a coin.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "June looks at the professor.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "Robbo looks at the floor.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "CORDELIA VANE, as the Woman in Violet is now, smiles faintly.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "Aristide. You look well.", "name": "CORDELIA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "I look dying.", "name": "BOUCHARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "Yes. That too.", "name": "CORDELIA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "She opens her handbag.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "Takes out a flat object wrapped in black silk.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "Sets it gently on the arm of a seat.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "Nobody speaks.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "Is that what I think it is?", "name": "CROFT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "It is what it always was.", "name": "CORDELIA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "She walks past all of them, out through the dark doorway of the dome.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "Her heels tick on the marble.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "action", "text": "Fade.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "The professor does not look at the plate.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "He looks at his hands.", "para": 12, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "dialogue", "text": "Professor?", "name": "JUNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "dialogue", "text": "Turn the lamp off, Robbo.", "name": "BOUCHARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "Robbo does.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "action", "text": "The dome goes black.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "action", "text": "Somewhere overhead, a switch clicks, and a thousand false stars bloom.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}