{"scene_id": "s02136", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02136.fountain", "heading": "INT. BELL TELEPHONE EXCHANGE - SWITCHBOARD ROOM - NIGHT", "cast": [{"id": 0, "name": "ETHEL PARKER", "names": ["ETHEL PARKER", "ETHEL"], "gender": "?", "first": 6, "spoke": 4}, {"id": 1, "name": "MAUDE ABERNATHY-LOWE", "names": ["MAUDE ABERNATHY-LOWE", "MAUDE"], "gender": "?", "first": 7, "spoke": 5}, {"id": 2, "name": "HATTIE JOHNSON", "names": ["HATTIE JOHNSON", "HATTIE"], "gender": "f", "first": 8, "spoke": 7}, {"id": 3, "name": "MISS CALLOWAY", "names": ["MISS CALLOWAY"], "gender": "f", "first": 9, "spoke": 3}, {"id": 4, "name": "CALLER", "names": ["CALLER"], "gender": "?", "first": 25, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. BELL TELEPHONE EXCHANGE - SWITCHBOARD ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "1924.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Three rows of operators in headsets, a wall of brass jacks and cords.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "After the crisis, the room is loud with quiet.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain on the window.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Someone is crying softly.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "ETHEL PARKER, 22, redhead, sits at position four.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "MAUDE ABERNATHY-LOWE, 30s, steady hands, position five.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "HATTIE JOHNSON, 19, new, position six, red-eyed, rubbing her wrist.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Behind them, MISS CALLOWAY, 50s, supervisor, high collar, paces the line with a clipboard.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Hattie, you did right.", "name": "ETHEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I put through the wrong call, Ethel.", "name": "HATTIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "You put through a call at the right time, Hattie. The wrong number got the right warning.", "name": "MAUDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Ladies, voices.", "name": "MISS CALLOWAY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Yes, Miss Calloway.", "name": "ETHEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "A light blinks on Hattie's board.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Everyone looks.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Hattie. Plug in.", "name": "MAUDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "I can't.", "name": "HATTIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "You can.", "name": "MAUDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Maude, I can't.", "name": "HATTIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Miss Johnson. Take the call.", "name": "MISS CALLOWAY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Hattie plugs in.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Her hand trembles.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Number, please.", "name": "HATTIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Hello? Is this the exchange? This is Mrs. Whitmore on Elm Street. The river is up to our porch.", "name": "CALLER", "speaker": 4, "ext": ["O.S."], "paren": ["over the line"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "We know, ma'am.", "name": "HATTIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "The man said to call and tell you the sirens did not sound.", "name": "CALLER", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "They're ringing now, ma'am.", "name": "ETHEL", "speaker": 0, "ext": [], "paren": ["leaning in"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Tell her to take the children upstairs.", "name": "MAUDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Mrs. Whitmore, take the children upstairs.", "name": "HATTIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Yes. Yes, we will. Thank you, dear.", "name": "CALLER", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "The line goes dead.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Hattie holds her cord a moment.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "That was well done.", "name": "MISS CALLOWAY", "speaker": 3, "ext": [], "paren": ["softly, to Hattie"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Thank you, Miss Calloway.", "name": "HATTIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Maude, do you think they'll be all right?", "name": "ETHEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Most of them.", "name": "MAUDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Another light blinks.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Another.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Hattie, Ethel, and Maude plug in together, calm, practiced.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Miss Calloway watches, then lowers her clipboard and, for the first time all night, sits.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}]}