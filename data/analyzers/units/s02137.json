{"scene_id": "s02137", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02137.fountain", "heading": "INT. STARLITE DRIVE-IN - PROJECTION BOOTH - NIGHT", "cast": [{"id": 0, "name": "LENNY SZABO", "names": ["LENNY SZABO", "LENNY"], "gender": "m", "first": 7, "spoke": 12}, {"id": 1, "name": "DOLORES CRUZ", "names": ["DOLORES CRUZ", "DOLORES"], "gender": "f", "first": 8, "spoke": 5}, {"id": 2, "name": "BIG RAFA", "names": ["BIG RAFA", "RAFA"], "gender": "m", "first": 9, "spoke": 4}, {"id": 3, "name": "ORTEGA", "names": ["ORTEGA"], "gender": "?", "first": 9, "spoke": 0}, {"id": 4, "name": "TIM FAIRWEATHER", "names": ["TIM FAIRWEATHER", "TIM"], "gender": "m", "first": 10, "spoke": 17}, {"id": 5, "name": "OLD KOSTAS", "names": ["OLD KOSTAS", "KOSTAS"], "gender": "m", "first": 11, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. STARLITE DRIVE-IN - PROJECTION BOOTH - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped concrete room above the snack bar.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Two ancient projectors, cold.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Film cans stacked like pizza boxes.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A card table lit by a bare bulb.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Through the little window: an empty lot of speaker posts, rusting under a half moon.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "Five men and women, one deck of cards.", "para": 1, "sent": 0, "present": []}, {"u": 7, "kind": "action", "text": "LENNY SZABO, 50s, hawk-nosed, camel-hair coat, deals.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "DOLORES CRUZ, 40s, silver hoops, poker face, sits with her back to the wall.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "RAFAEL \"BIG RAFA\" ORTEGA, 30s, enormous, patient, sits by the door.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "TIM FAIRWEATHER, 20s, sweaty, borrowed suit, a stack of chips he does not own.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "OLD KOSTAS, 70, knit cap, silent, sipping a paper cup of ouzo.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "The pot in the middle is mostly cash.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "A little too much.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Tim. Your bet.", "name": "LENNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Give me a second.", "name": "TIM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "You've had a second.", "name": "DOLORES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "I'm thinking.", "name": "TIM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "He is sweating.", "name": "KOSTAS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "It's hot in here.", "name": "TIM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "It's forty degrees.", "name": "RAFA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Hot for me.", "name": "TIM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Tim, bet or fold.", "name": "LENNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Raise. Five hundred.", "name": "TIM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "With whose money?", "name": "DOLORES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Mine.", "name": "TIM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Your money was in your uncle's safe, which is now a hole in a wall.", "name": "LENNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "I don't know what you mean.", "name": "TIM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Tim.", "name": "RAFA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "I don't know.", "name": "TIM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Dolores. Count the chips.", "name": "KOSTAS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Dolores stacks his chips with long fingers.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Counts under her breath.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Looks up.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Two thousand, one hundred.", "name": "DOLORES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Exactly what was in the safe.", "name": "LENNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "The projector fans tick as they cool.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Rafa shifts his weight against the door.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Tim looks at the window.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Okay, listen.", "name": "TIM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Sit.", "name": "LENNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "It was a loan. I was going to put it back.", "name": "TIM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "With what?", "name": "DOLORES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "With this pot.", "name": "TIM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "He was going to win it back from the man he stole it from.", "name": "KOSTAS", "speaker": 5, "ext": [], "paren": ["laughing, dry"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Mr. Szabo, I'm sorry. Honestly.", "name": "TIM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "Sorry is a word. Does it have a face?", "name": "LENNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "No.", "name": "TIM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "Then it can't pay.", "name": "LENNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "Rafa clicks the lock on the door.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Dolores slides her hand into her bag.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "Kostas lifts his cup, drinks, and sets it down very carefully.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "Wait. Wait. I can fix it.", "name": "TIM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "Sit down, Tim.", "name": "RAFA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "No, no, no.", "name": "TIM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "He lunges for the window.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "Rafa's arm catches him by the collar.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "The card table goes over.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "Chips and cash scatter across the concrete.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "Rafa!", "name": "DOLORES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "dialogue", "text": "Let him go.", "name": "LENNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "dialogue", "text": "Boss?", "name": "RAFA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "dialogue", "text": "Let him go. He has nowhere to run.", "name": "LENNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "Rafa lets go.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "Tim crumples against the film cans.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "action", "text": "Lenny crouches beside him, collects a hundred-dollar bill from the floor, folds it neatly.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "dialogue", "text": "Tim. What's in the cans?", "name": "LENNY", "speaker": 0, "ext": ["CONT'D"], "paren": ["gently"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "dialogue", "text": "Movies.", "name": "TIM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "dialogue", "text": "Real movies?", "name": "LENNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "dialogue", "text": "Some.", "name": "TIM", "speaker": 4, "ext": [], "paren": ["small"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "action", "text": "Lenny opens a can.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "action", "text": "Inside, instead of film: bricks of cash, banded.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "action", "text": "Dolores whistles.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "action", "text": "Kostas lights a cigarette.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 75, "kind": "dialogue", "text": "Oh, Tim.", "name": "LENNY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 76, "kind": "action", "text": "The booth door shudders under a kick from outside.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 77, "kind": "action", "text": "Rafa draws.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 78, "kind": "action", "text": "Dolores kills the bulb.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 79, "kind": "action", "text": "Darkness.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 80, "kind": "action", "text": "Gunfire stitches the room from end to end.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}