{"scene_id": "s02138", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02138.fountain", "heading": "EXT. BARNSTORMING FIELD - CORNFIELD DIAMOND - DAY", "cast": [{"id": 0, "name": "SKIPPER GUS LARUE", "names": ["SKIPPER GUS LARUE", "SKIPPER"], "gender": "m", "first": 6, "spoke": 12}, {"id": 1, "name": "DIZZY PETROV", "names": ["DIZZY PETROV", "DIZZY"], "gender": "m", "first": 7, "spoke": 7}, {"id": 2, "name": "TOBIN", "names": ["TOBIN"], "gender": "m", "first": 8, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. BARNSTORMING FIELD - CORNFIELD DIAMOND - DAY", "present": []}, {"u": 1, "kind": "action", "text": "1931.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A baseball diamond mown into a Nebraska cornfield.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A wooden dugout built from a hay wagon.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Dust.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A crowd of two hundred cheers from the stalks.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "SKIPPER GUS LARUE, 60, cap crushed, tobacco in his cheek, leans on the wagon rail.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "DIZZY PETROV, 25, big-armed pitcher, sits on a bale, an ice pack on his elbow.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Little TOBIN, 11, the batboy, hugs a stack of bats three times too large.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Gentlemen, we are up by one, and I do not wish to hear anything more about the elbow.", "name": "SKIPPER", "speaker": 0, "ext": [], "paren": ["to the whole dugout"], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Skipper, it's gone.", "name": "DIZZY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Which elbow?", "name": "SKIPPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Mine.", "name": "DIZZY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Dizzy, you pitched a no-hitter in the fourth.", "name": "SKIPPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I pitched a no-hitter with a ghost elbow.", "name": "DIZZY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Is a ghost elbow bad?", "name": "TOBIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Tobin, hush.", "name": "SKIPPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "It's cold, Tobin. And it hurts.", "name": "DIZZY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "The crowd roars.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "A ball cracks off a bat.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Everyone in the dugout turns to see it sail over the corn.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Foul. Please, Lord, foul.", "name": "SKIPPER", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "It's fair! It's fair!", "name": "TOBIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Tobin, it's a long fly.", "name": "DIZZY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Hush, the two of you. Dizzy, get your glove.", "name": "SKIPPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Skipper, I can't.", "name": "DIZZY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Then who?", "name": "SKIPPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Me!", "name": "TOBIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Tobin, you're eleven.", "name": "SKIPPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "I can throw!", "name": "TOBIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Tobin, put down the bats.", "name": "SKIPPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Tobin drops the bats with a clatter.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Dizzy picks up the glove, groaning.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "The Skipper waves him toward the field.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Go. Throw like it's the last one you've got.", "name": "SKIPPER", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "It might be.", "name": "DIZZY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Then throw it like you mean it.", "name": "SKIPPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Dizzy trudges out.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "The crowd stands.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Tobin climbs the wagon and watches him go, hands in his hair.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "He'll do it, right, Skipper?", "name": "TOBIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "He'll do something.", "name": "SKIPPER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}