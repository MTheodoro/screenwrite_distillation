{"scene_id": "s02139", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02139.fountain", "heading": "INT. STARVE CREEK SALT WORKS - STAGE STOP - NIGHT", "cast": [{"id": 0, "name": "PERPETUA OAKES", "names": ["PERPETUA OAKES", "PERPETUA"], "gender": "f", "first": 6, "spoke": 5}, {"id": 1, "name": "JUBAL CREED", "names": ["JUBAL CREED", "JUBAL"], "gender": "m", "first": 6, "spoke": 11}, {"id": 2, "name": "DEPUTY HENRY TASKER", "names": ["DEPUTY HENRY TASKER", "TASKER"], "gender": "m", "first": 7, "spoke": 10}, {"id": 3, "name": "BELLE", "names": ["BELLE"], "gender": "?", "first": 27, "spoke": 12}, {"id": 4, "name": "VANCE", "names": ["VANCE"], "gender": "?", "first": 27, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. STARVE CREEK SALT WORKS - STAGE STOP - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A low adobe room crusted with white.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Salt in the walls, salt on the table, salt on the beams like frost.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cookstove ticks.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single lamp swings from a nail.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Outside, wind drags the dust against the shutters.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "PERPETUA OAKES, 50s, innkeeper, broad hands, apron grey with age, ladles stew into a tin bowl and sets it, without ceremony, in front of JUBAL CREED, 40s, a drifter in a sun-bleached duster, who has not taken his hat off or his eyes from the door.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "At the end of the table sits DEPUTY HENRY TASKER, 22, a badge pinned to a shirt too clean for this country.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "He pushes beans around a plate and tries not to look at the stranger's holster.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Eat, Mr. Creed. The stew will not improve with watching.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Ma'am, I am watching the door, not the stew.", "name": "JUBAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Expecting someone?", "name": "TASKER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Always.", "name": "JUBAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "There's no one out there. Nearest town's forty miles.", "name": "TASKER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Forty miles is a Tuesday.", "name": "JUBAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Perpetua snorts, wipes her hands on her apron, pours coffee.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Tasker clears his throat.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Mr. Creed, I have to ask your business at Starve Creek.", "name": "TASKER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Sleeping.", "name": "JUBAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "In a salt works.", "name": "TASKER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "It's quiet.", "name": "JUBAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "It's quiet because the last man who made noise is buried behind the privy.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Mrs. Oakes!", "name": "TASKER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Well, he is.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The door bangs open.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Wind and dust sweep through the room.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The lamp lurches on its nail.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "In the doorway stands ISABELLE \"BELLE\" VANCE, 30s, a black leather coat dripping dust, a rifle in the crook of one arm and a folded paper in her free hand.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "She shuts the door with her boot.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Perpetua stiffens.", "para": 3, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Tasker's chair scrapes back.", "para": 3, "sent": 6, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Jubal doesn't move at all, but his hand has found the edge of the table.", "para": 3, "sent": 7, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Evening, all.", "name": "BELLE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "We're full.", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "You're four. I counted the horses.", "name": "BELLE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Ma'am, this is a private table.", "name": "TASKER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Then I'll stand.", "name": "BELLE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "She unfolds the paper and lays it on the salt-crusted wood, face up, under the lamp.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "A wanted poster.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "A sketched face, hat low, jaw square.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Jubal Creed. Five hundred dollars. Mexican border, Santa Rita, the payroll coach.", "name": "BELLE", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "You've mistaken me for a better-looking man.", "name": "JUBAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Mr. Creed, I tracked you through three counties. I don't need your face.", "name": "BELLE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Ma'am, I'm the law here.", "name": "TASKER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Deputy, you're twenty-two. Sit.", "name": "BELLE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Tasker sits.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Perpetua sets the ladle down very slowly.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Belle regards Jubal across the table.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Miss Vance, I'll make you an offer.", "name": "JUBAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "I don't take offers.", "name": "BELLE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "You'll take this one. There was no payroll coach. There was a man in the coach who needed to disappear, and I helped him. For three hundred dollars. He's in Sonora, teaching school.", "name": "JUBAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "Whose man?", "name": "BELLE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "A judge's.", "name": "JUBAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "Which judge?", "name": "BELLE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "The one who signed this poster.", "name": "JUBAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "The wind drops.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "The stove ticks.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Belle looks at the poster as if for the first time.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "She turns it over.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "Reads the back.", "para": 6, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "There's a seal.", "name": "BELLE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "dialogue", "text": "There always is.", "name": "JUBAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "dialogue", "text": "That's the county seal.", "name": "TASKER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "dialogue", "text": "Henry, whose side are you on?", "name": "PERPETUA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "I don't know, Mrs. Oakes.", "name": "TASKER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "dialogue", "text": "Deputy. Whose signature is on this?", "name": "BELLE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "dialogue", "text": "Judge Garrity's.", "name": "TASKER", "speaker": 2, "ext": [], "paren": ["small"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "action", "text": "Belle folds the paper.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "Looks at Tasker, then Jubal, then the door.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "dialogue", "text": "Mrs. Oakes, I believe I'll take that stew after all.", "name": "BELLE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "action", "text": "Perpetua ladles.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "action", "text": "Belle sits.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "action", "text": "Rifle on her knees.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "action", "text": "The four of them eat in a silence full of arithmetic.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}]}