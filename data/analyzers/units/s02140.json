{"scene_id": "s02140", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02140.fountain", "heading": "INT. ROLLERAMA SKATE CENTER - MAIN FLOOR - NIGHT", "cast": [{"id": 0, "name": "DANI MORALES", "names": ["DANI MORALES", "DANI"], "gender": "f", "first": 7, "spoke": 21}, {"id": 1, "name": "INTERCOM", "names": ["INTERCOM"], "gender": "?", "first": 9, "spoke": 3}, {"id": 2, "name": "KALLIS", "names": ["KALLIS"], "gender": "?", "first": 10, "spoke": 19}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROLLERAMA SKATE CENTER - MAIN FLOOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "1986.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "After closing.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The disco ball turns slowly, scattering coins of light on an empty maple floor.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Speakers hiss.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Carpeted benches.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "Hundreds of rental skates racked on the wall like a choir.", "para": 0, "sent": 5, "present": []}, {"u": 7, "kind": "action", "text": "DANI MORALES, 16, Walkman, jean jacket with a band patch, sits on the rail lacing a pair of beat-up quads.", "para": 1, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "She breathes carefully, like someone who has rehearsed this.", "para": 1, "sent": 1, "present": [0]}, {"u": 9, "kind": "dialogue", "text": "Dani? Is that you out there?", "name": "INTERCOM", "speaker": 1, "ext": ["O.S."], "paren": ["crackling"], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "It's me, Mr. Kallis.", "name": "DANI", "speaker": 0, "ext": [], "paren": ["startled"], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I told you the rink closes at eleven.", "name": "INTERCOM", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "I know. I'm just... finishing.", "name": "DANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Finishing what?", "name": "INTERCOM", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "My last lap.", "name": "DANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "A long pause on the intercom.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "A click.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "A heavy door opens somewhere.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Footsteps cross the carpet.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "MR. KALLIS, 60s, the owner, cardigan, keys on a retractor, thick glasses, stands at the edge of the floor.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "He holds a mop like a staff and a Styrofoam cup of cold coffee.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Your last lap.", "name": "KALLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Yes, sir.", "name": "DANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Your mother called.", "name": "KALLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Of course she did.", "name": "DANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "She thought you might be here.", "name": "KALLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "I'm always here.", "name": "DANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Yes. That's what worries her.", "name": "KALLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Dani stands on her skates, wobbles, finds the balance.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "She pushes off the rail, glides ten feet, and stops.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Mr. Kallis, can I ask you something?", "name": "DANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "It's your last lap. Ask.", "name": "KALLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Do you think it matters? That I'm leaving?", "name": "DANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Leaving the rink?", "name": "KALLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Leaving town.", "name": "DANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Kallis leans the mop on the rail.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Takes off his glasses.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Cleans them on his cardigan.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Dani, I opened this rink in 1971. Forty kids skated here that first night. Do you know how many of them still live in this town?", "name": "KALLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "How many?", "name": "DANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Two. One of them is the mailman.", "name": "KALLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "That's sad.", "name": "DANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "No. It's what a rink is. A place you leave from.", "name": "KALLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Dani considers that.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "She rolls closer to him, slow and uncertain.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "My dad skated here.", "name": "DANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "He did. He was terrible.", "name": "KALLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "He told me he was great.", "name": "DANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "He told everyone he was great. That was the whole trouble.", "name": "KALLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Dani laughs, a short sharp surprise.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Then her face crumples.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "She wipes her nose on her sleeve.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "I don't want to go.", "name": "DANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Yes you do.", "name": "KALLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "How do you know?", "name": "DANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "Because you came to say goodbye to the floor, not to me.", "name": "KALLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Dani glances at the floor.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "At the lights spinning across the maple.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "It's a really good floor.", "name": "DANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "I refinish it every June.", "name": "KALLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "I know. I helped you.", "name": "DANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "So you did.", "name": "KALLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "He crosses to the sound booth, flips a switch.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "A slow song starts.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "Something with synthesizers and a long, aching bridge.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "Dani looks up.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "Mr. Kallis. Is this the couples skate?", "name": "DANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "dialogue", "text": "It's your last lap. I don't make the rules.", "name": "KALLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "Dani lets out a small, wet laugh and starts to skate.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "Slowly at first, then with a long glide that carries her all the way around the rink.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "Kallis, by the booth, turns off the overhead lights.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 71, "kind": "action", "text": "Only the disco ball remains.", "para": 10, "sent": 3, "present": [0, 1, 2]}, {"u": 72, "kind": "dialogue", "text": "Mr. Kallis, am I good?", "name": "DANI", "speaker": 0, "ext": [], "paren": ["calling, passing"], "dual": false, "present": [0, 1, 2]}, {"u": 73, "kind": "dialogue", "text": "You are terrible.", "name": "KALLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 74, "kind": "dialogue", "text": "Just like my dad.", "name": "DANI", "speaker": 0, "ext": [], "paren": ["still skating, grinning"], "dual": false, "present": [0, 1, 2]}, {"u": 75, "kind": "dialogue", "text": "Better.", "name": "KALLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 76, "kind": "action", "text": "She comes around again.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 77, "kind": "action", "text": "This time he steps onto the floor in his loafers, arms out, as if to catch her.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 78, "kind": "action", "text": "She skates past, close enough to touch.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 79, "kind": "action", "text": "Their fingertips brush.", "para": 11, "sent": 3, "present": [0, 1, 2]}, {"u": 80, "kind": "action", "text": "The song swells.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 81, "kind": "action", "text": "The ball spins.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 82, "kind": "action", "text": "The old man stays at center floor as the girl circles him, once, twice, a third time, and then drifts toward the exit, where the door is propped open on the cold bright night.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 83, "kind": "dialogue", "text": "Bye, Mr. Kallis.", "name": "DANI", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 84, "kind": "dialogue", "text": "Bye, Dani.", "name": "KALLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 85, "kind": "action", "text": "She doesn't look back.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 86, "kind": "action", "text": "The song fades.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 87, "kind": "action", "text": "The disco ball keeps turning.", "para": 13, "sent": 2, "present": [0, 1, 2]}]}