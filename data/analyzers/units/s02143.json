{"scene_id": "s02143", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02143.fountain", "heading": "INT. GOAT YOGA BARN - MORNING", "cast": [{"id": 0, "name": "NAMASTE", "names": ["NAMASTE"], "gender": "?", "first": 2, "spoke": 0}, {"id": 1, "name": "HORTENSE PLUMB", "names": ["HORTENSE PLUMB", "HORTENSE"], "gender": "f", "first": 4, "spoke": 6}, {"id": 2, "name": "CLEMENT", "names": ["CLEMENT"], "gender": "?", "first": 6, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. GOAT YOGA BARN - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "A sun-struck barn with rubber mats on the floor and bleating goats everywhere.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Hand-lettered sign: \"NAMASTE, KIDS.\"", "para": 0, "sent": 1, "present": [0]}, {"u": 3, "kind": "action", "text": "A speakerphone propped on a hay bale.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "HORTENSE PLUMB, 70, purple leggings, silver braid, folded into a perfect downward dog, a goat standing serenely on her lower back.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "She has the stillness of a tax auditor and the patience of a glacier.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Mother, are you doing yoga with farm animals again?", "name": "CLEMENT", "speaker": 2, "ext": ["V.O."], "paren": ["speakerphone, tinny"], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "It is goat yoga, Clement. The goat is the instructor.", "name": "HORTENSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "The goat is standing on you.", "name": "CLEMENT", "speaker": 2, "ext": ["V.O."], "paren": ["speakerphone"], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Correct.", "name": "HORTENSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Mother, we have discussed this.", "name": "CLEMENT", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Clement, we have discussed nothing. You talk and I wait.", "name": "HORTENSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "I'm worried about the knees.", "name": "CLEMENT", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "The knees are at peace.", "name": "HORTENSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "The goat shifts.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Hortense does not.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Mother, I'm coming over.", "name": "CLEMENT", "speaker": 2, "ext": ["V.O."], "paren": ["speakerphone"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Clement, no.", "name": "HORTENSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Mother, yes.", "name": "CLEMENT", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "The goat hops off her back.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Hortense unfolds one vertebra at a time, stands, turns to the phone with magnificent calm, and, as she answers, the goat chews the hem of her leggings.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Then bring a carrot.", "name": "HORTENSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}