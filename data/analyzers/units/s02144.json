{"scene_id": "s02144", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02144.fountain", "heading": "EXT. COUNTRY ROAD - STOPPED SCHOOL BUS - NIGHT", "cast": [{"id": 0, "name": "CORMAC", "names": ["CORMAC"], "gender": "?", "first": 4, "spoke": 2}, {"id": 1, "name": "TEO", "names": ["TEO"], "gender": "?", "first": 5, "spoke": 2}, {"id": 2, "name": "ISLA", "names": ["ISLA"], "gender": "?", "first": 6, "spoke": 1}, {"id": 3, "name": "NKECHI", "names": ["NKECHI"], "gender": "f", "first": 7, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. COUNTRY ROAD - STOPPED SCHOOL BUS - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Thick white fog.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The bus idles, hazards ticking orange.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Four teenagers inside, no driver.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CORMAC, 16, stands in the aisle with a flashlight.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "TEO, 17, crouches behind a seat with a cracked phone.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "ISLA, 16, grips the emergency window latch.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "NKECHI, 15, sits rigid at the front, hands in her lap.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "He sweeps the beam down the aisle.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Nothing but empty seats.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "She stares at the dashboard, which glows green.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "He thumbs his phone and curses.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "She presses the window glass with her palm.", "para": 2, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "He catches her eye.", "para": 2, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "She shakes her head.", "para": 2, "sent": 6, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Where did Mr. Delroy go?", "name": "CORMAC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "He said he'd check the engine.", "name": "TEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "That was an hour ago.", "name": "ISLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Stop talking.", "name": "NKECHI", "speaker": 3, "ext": [], "paren": ["not turning"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "What?", "name": "TEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Something is on the roof.", "name": "NKECHI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "They all look up.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "A slow drag of fingers across metal, from the back of the bus to the front.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "He raises the flashlight.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "She pulls the latch.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "He stops her wrist.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "The drag stops above the door.", "para": 3, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Nobody breathe.", "name": "CORMAC", "speaker": 0, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "The door lever, with no one near it, turns by itself.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "The folding door hisses open.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Fog pours in like milk.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Footsteps climb one step.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Then two.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Then a voice, warm and wet and familiar, speaks from the dark between the seats.", "para": 4, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Everybody have their seatbelts on?", "name": "NKECHI", "speaker": 3, "ext": [], "paren": ["in a flat, wrong voice, Mr. Delroy's"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Nobody has.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "They all scream.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}]}