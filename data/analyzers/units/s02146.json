{"scene_id": "s02146", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02146.fountain", "heading": "EXT. FLOODED RIVER - DEBRIS RAFT - DAY", "cast": [{"id": 0, "name": "CAPTAIN RENATA SOUZA", "names": ["CAPTAIN RENATA SOUZA", "RENATA"], "gender": "m", "first": 3, "spoke": 1}, {"id": 1, "name": "ABEL OKUMU", "names": ["ABEL OKUMU", "ABEL"], "gender": "?", "first": 4, "spoke": 1}, {"id": 2, "name": "TRUDY HALVORSEN", "names": ["TRUDY HALVORSEN", "TRUDY"], "gender": "f", "first": 5, "spoke": 1}, {"id": 3, "name": "LENA", "names": ["LENA"], "gender": "?", "first": 6, "spoke": 1}, {"id": 4, "name": "RADIO", "names": ["RADIO"], "gender": "?", "first": 7, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FLOODED RIVER - DEBRIS RAFT - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A raft of roof planks and oil drums turns in brown current.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A drowned town drifts by: a steeple, a bus stop, a pink bicycle.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "CAPTAIN RENATA SOUZA, 40s, scarred forearms, braces a pole.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "ABEL OKUMU, 17, bails water with a bucket.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "TRUDY HALVORSEN, 60s, holds a small radio in a freezer bag.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "A little girl, LENA, 6, hugs a plastic dinosaur and doesn't speak.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "...repeat, any survivors on the river, hold position, we're coming...", "name": "RADIO", "speaker": 4, "ext": ["V.O."], "paren": ["static"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "They're coming!", "name": "TRUDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Don't wave the radio, Trudy, keep it dry.", "name": "RENATA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "A tree rolls out of the current and strikes the raft.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Everyone stumbles.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Abel drops the bucket.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Trudy loses her grip on the radio bag.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Lena falls and the dinosaur skates into the river.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Rex!", "name": "LENA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Abel dives for it.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Renata grabs his collar.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "The dinosaur bobs once, twice, and Abel reaches out his whole length, grabs it, and slaps it back into Lena's arms.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Got him.", "name": "ABEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Lena says nothing.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "She just holds him tight.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "...we can see you...", "name": "RADIO", "speaker": 4, "ext": ["V.O."], "paren": ["static"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "A helicopter thunders over the trees.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "All four of them look up.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Nobody speaks.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}]}