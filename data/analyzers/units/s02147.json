{"scene_id": "s02147", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02147.fountain", "heading": "EXT. HIGHWAY 9 UNDERPASS - DAY", "cast": [{"id": 0, "name": "BARTEK LISOWSKI", "names": ["BARTEK LISOWSKI", "BARTEK"], "gender": "m", "first": 4, "spoke": 9}, {"id": 1, "name": "JULES", "names": ["JULES"], "gender": "f", "first": 5, "spoke": 10}, {"id": 2, "name": "PENELOPE", "names": ["PENELOPE"], "gender": "?", "first": 9, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. HIGHWAY 9 UNDERPASS - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A white delivery van reading \"SWEET NOTHINGS BAKERY\" sits wedged under a concrete overpass, its roof crushed against the girders.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Traffic backs up for a mile.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Horns.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "BARTEK LISOWSKI, 50s, driver, round and sweating, stands on the bumper inspecting the roof with the dignity of a surgeon.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "His assistant JULES, 22, nose ring, apron over a hoodie, holds a phone to her ear and a clipboard to her chest.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "The back doors are open.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Inside, a seven-tier wedding cake, miraculously upright, trembles with every honk.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Pen, we're fine. We're almost there.", "name": "JULES", "speaker": 1, "ext": [], "paren": ["into the phone"], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "The ceremony is in twenty minutes.", "name": "PENELOPE", "speaker": 2, "ext": ["V.O."], "paren": ["phone"], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Yes. Yes. I know.", "name": "JULES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Twelve feet two. The sign said twelve feet six.", "name": "BARTEK", "speaker": 0, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Bartek, the sign was for the other bridge.", "name": "JULES", "speaker": 1, "ext": [], "paren": ["covering the phone"], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "There is only one bridge.", "name": "BARTEK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "There are two. We took the wrong one.", "name": "JULES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Jules, what was that?", "name": "PENELOPE", "speaker": 2, "ext": ["V.O."], "paren": ["phone"], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Nothing! A bird!", "name": "JULES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Please! Please! A little patience!", "name": "BARTEK", "speaker": 0, "ext": [], "paren": ["to the traffic"], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "A horn answers him.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Then another.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "He mops his forehead.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Let the air out of the tires.", "name": "BARTEK", "speaker": 0, "ext": ["CONT'D"], "paren": ["to Jules"], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "The tires?", "name": "JULES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "It lowers the van. An inch. Maybe two.", "name": "BARTEK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Jules, I can hear honking. Where are you?", "name": "PENELOPE", "speaker": 2, "ext": ["V.O."], "paren": ["phone"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "It's a parade.", "name": "JULES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "On a Saturday morning?", "name": "PENELOPE", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "It's a very Saturday parade.", "name": "JULES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Bartek kneels.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Unscrews a valve.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Hiss.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The van sinks half an inch, then stops.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The cake sways.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Jules gasps.", "para": 3, "sent": 5, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Bartek holds up one palm like a conductor.", "para": 3, "sent": 6, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Steady. Steady.", "name": "BARTEK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "The cake settles.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "A man in the next car leans on his horn.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "I will end him.", "name": "BARTEK", "speaker": 0, "ext": ["CONT'D"], "paren": ["whisper"], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Bartek!", "name": "JULES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Pardon. A joke.", "name": "BARTEK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Jules. Are you at the church, or are you not at the church?", "name": "PENELOPE", "speaker": 2, "ext": ["V.O."], "paren": ["phone, sharp"], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Pen, we will be at the church. I swear.", "name": "JULES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Bartek unscrews the second valve.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "The van sinks another inch.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "The roof shrieks off the girder.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "The van rolls free.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "The cake lurches.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Jules shrieks.", "para": 5, "sent": 5, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Bartek, arms wide, stands in the road in front of the van as if he could catch the cake with his body.", "para": 5, "sent": 6, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "It stays.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "All three seconds of silence are enormous.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "You may go now.", "name": "BARTEK", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the traffic, hoarse"], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Horns erupt, joyfully.", "para": 7, "sent": 0, "present": [0, 1, 2]}]}