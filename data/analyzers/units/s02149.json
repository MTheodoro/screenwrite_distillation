{"scene_id": "s02149", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02149.fountain", "heading": "INT. ORIENT NIGHT TRAIN - DINING CAR - NIGHT", "cast": [{"id": 0, "name": "CLARA WINTERBOURNE", "names": ["CLARA WINTERBOURNE", "CLARA"], "gender": "?", "first": 6, "spoke": 17}, {"id": 1, "name": "ANTON VASS", "names": ["ANTON VASS", "ANTON"], "gender": "m", "first": 7, "spoke": 17}, {"id": 2, "name": "PEPE", "names": ["PEPE"], "gender": "?", "first": 8, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. ORIENT NIGHT TRAIN - DINING CAR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "1938.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "White tablecloths.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Silver coffee pots.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Lamplight swaying with the rails.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Beyond the windows, black hills and distant farm lights.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "CLARA WINTERBOURNE, 28, emerald gown, gloves, sips tea at a corner table.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Across from her, ANTON VASS, 32, dinner jacket, a pianist's long fingers and a sad smile.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "PEPE, 50s, waiter, white jacket, hovers with a pot.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "You're quiet tonight.", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "The train does that to me.", "name": "CLARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "It's the rhythm. It makes you think of everything you've left.", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Or everything you're going to.", "name": "CLARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "You sound like a woman with a plan.", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I sound like a woman with a ticket.", "name": "CLARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "To where?", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Vienna.", "name": "CLARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Ah. Concert season.", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Not for the concerts.", "name": "CLARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Then what?", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "A wedding.", "name": "CLARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Anton laughs lightly.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "It stops.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Whose?", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Mine.", "name": "CLARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Congratulations. To whom?", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "A man named Julian Vass.", "name": "CLARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Anton goes very still.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Pepe backs away from the table with the coffee pot, silent as a cat.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Julian Vass is my brother.", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "I know.", "name": "CLARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "You've never mentioned him.", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "You've never asked what I was running toward.", "name": "CLARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "And tonight, on this train, on this particular train, you decided to sit at my table.", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "I decided to see what kind of man hasn't spoken to his brother in six years.", "name": "CLARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "And what kind is that?", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "The kind who plays at midnight so no one hears him.", "name": "CLARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Anton lifts his teacup.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Sets it down without drinking.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Do you love him?", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "I haven't met him.", "name": "CLARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Then why?", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "He writes beautifully. And he talks about you.", "name": "CLARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "What does he say?", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "That you were the better pianist.", "name": "CLARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Anton closes his eyes.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "The train sways.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Pepe, from across the room, drops a spoon.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Clara.", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Yes.", "name": "CLARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Would you like to hear what I play at midnight?", "name": "ANTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Very much.", "name": "CLARA", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}]}