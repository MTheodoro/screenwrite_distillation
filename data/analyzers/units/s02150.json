{"scene_id": "s02150", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02150.fountain", "heading": "INT. PELLETIER FAMILY CABIN - NURSERY - NIGHT", "cast": [{"id": 0, "name": "ROXANNE PELLETIER", "names": ["ROXANNE PELLETIER", "ROXANNE"], "gender": "?", "first": 5, "spoke": 5}, {"id": 1, "name": "GAVIN PELLETIER", "names": ["GAVIN PELLETIER", "GAVIN"], "gender": "m", "first": 5, "spoke": 3}, {"id": 2, "name": "MIMI", "names": ["MIMI"], "gender": "m", "first": 8, "spoke": 2}, {"id": 3, "name": "MONITOR VOICE", "names": ["MONITOR VOICE"], "gender": "?", "first": 23, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. PELLETIER FAMILY CABIN - NURSERY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A tiny room under the eaves.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A white crib.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A baby monitor on the dresser, its green light pulsing.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Snow tapping the window.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ROXANNE PELLETIER, 30s, stands over the crib in a bathrobe.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "She holds the rail.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "GAVIN PELLETIER, 30s, hovers in the doorway, flashlight in hand.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Their daughter MIMI, 4, clutches a stuffed rabbit and peers out from behind his leg.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "She looks into the crib.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "It is empty.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He looks at her.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "She looks at him.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Mimi tugs his pajama sleeve.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Rox. Where's the baby?", "name": "GAVIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "I don't know.", "name": "ROXANNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Mommy, who's in the crib?", "name": "MIMI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Nobody, baby.", "name": "ROXANNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "The lady.", "name": "MIMI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Roxanne turns.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Mimi points at the crib.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "The mattress has a dent in it, the size of a small body.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "The monitor crackles.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Hush now. Hush now. She's sleeping.", "name": "MONITOR VOICE", "speaker": 3, "ext": ["V.O."], "paren": ["from the monitor, slow, lullaby cadence"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Gavin raises the flashlight.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "The beam shakes.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "He moves in front of Mimi.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "She grabs Roxanne's hand.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Who is this?", "name": "ROXANNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Hush, hush. Don't wake her.", "name": "MONITOR VOICE", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Where is she?", "name": "GAVIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Under the bed. Under the bed. Under the bed.", "name": "MONITOR VOICE", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Gavin stops.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "He looks at Roxanne.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Roxanne looks down.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "A pale hand slides out across the floor, small and curled, holding the rabbit's ear.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Mimi screams.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "The rabbit in her arms is gone.", "para": 5, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Gavin drops to his knees.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Pulls back the bedskirt.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Nothing.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Under the bed is a flat, white, empty dark.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "She grabs him by the collar and pulls him away from it.", "para": 6, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Gavin, don't.", "name": "ROXANNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "It's our baby.", "name": "GAVIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "It's not.", "name": "ROXANNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "The monitor goes quiet.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "The green light stops pulsing.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Then, from the hallway, quite near, a tiny, perfectly ordinary cry.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}]}