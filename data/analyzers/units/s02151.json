{"scene_id": "s02151", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02151.fountain", "heading": "INT. ABANDONED CAROUSEL - FAIRGROUND - NIGHT", "cast": [{"id": 0, "name": "AGENT TAMSIN REEVES", "names": ["AGENT TAMSIN REEVES", "TAMSIN"], "gender": "f", "first": 7, "spoke": 7}, {"id": 1, "name": "ODALYS KANE", "names": ["ODALYS KANE"], "gender": "?", "first": 10, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED CAROUSEL - FAIRGROUND - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A circus-striped dome, peeling.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Painted horses frozen mid-gallop, manes cracked.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Mirrors fogged.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Moonlight in knife blades through torn canvas.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Pigeons.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "Cold.", "para": 0, "sent": 5, "present": []}, {"u": 7, "kind": "action", "text": "AGENT TAMSIN REEVES, 30s, tactical vest, hair tied back, stands at the center pole with a pistol low and a phone in her other hand.", "para": 1, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Her breath smokes.", "para": 1, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "Her eyes never stop moving.", "para": 1, "sent": 2, "present": [0]}, {"u": 10, "kind": "dialogue", "text": "Take one more step toward the horses.", "name": "ODALYS KANE", "speaker": 1, "ext": ["V.O."], "paren": ["phone, calm"], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I'm at the pole.", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Take it anyway.", "name": "ODALYS KANE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She steps.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "The floor creaks like a ship.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Where are you?", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Where I always am. Behind you.", "name": "ODALYS KANE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Tamsin spins.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Nothing but mirrors.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Her own face, multiplied.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "I don't see you.", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "No. You see you.", "name": "ODALYS KANE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "The carousel groans.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Slowly, the platform begins to turn.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Painted horses rise and fall.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Calliope notes wheeze out of dead pipes.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Odalys, let her go.", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": ["into the phone"], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "She isn't mine to let go. She's yours.", "name": "ODALYS KANE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Tamsin freezes.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Between two horses ahead, a small girl in a yellow raincoat, hands bound, watches her.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "A white dress under the coat.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "She's very still.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Mara.", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Count the horses, Agent.", "name": "ODALYS KANE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "What?", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Count them.", "name": "ODALYS KANE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Tamsin counts under her breath.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Twelve, thirteen, fourteen.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "She stops.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "There are fifteen horses on the platform.", "name": "TAMSIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "And one of them is breathing.", "name": "ODALYS KANE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Tamsin lifts the pistol.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Turns slowly toward the horse nearest the girl, the white one, its painted eyes wide.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "It shudders.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "It inhales.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "The platform spins faster.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "The music climbs.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "She raises the pistol to her shoulder, finger tightening.", "para": 8, "sent": 2, "present": [0, 1]}]}