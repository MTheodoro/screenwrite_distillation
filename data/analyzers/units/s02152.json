{"scene_id": "s02152", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02152.fountain", "heading": "INT. ST. ANSELM HOSPITAL - LEAD-LINED X-RAY VAULT - NIGHT", "cast": [{"id": 0, "name": "BILLIE FROST", "names": ["BILLIE FROST", "BILLIE"], "gender": "f", "first": 5, "spoke": 1}, {"id": 1, "name": "OSWIN PARR", "names": ["OSWIN PARR", "OSWIN"], "gender": "?", "first": 6, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. ST. ANSELM HOSPITAL - LEAD-LINED X-RAY VAULT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Concrete.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A heavy door.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A humming machine.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "One red lamp.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "BILLIE FROST, 20s, nurse, lead apron, holds a clipboard against her chest.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "OSWIN PARR, 80s, patient on the table, in a gown, hands folded.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He hasn't blinked in a minute.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Billie checks the film.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Oswin watches her check.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Almost done, Mr. Parr.", "name": "BILLIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He nods.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "The machine hums.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She steps behind the glass.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Presses the button.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "A flash.", "para": 3, "sent": 4, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "On the monitor: his ribcage, his spine.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "And behind the ribs, something curled.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Dark.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Furred.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Billie freezes.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Oswin turns his head toward the glass.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "He smiles with all his teeth.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "The lamp flickers.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She backs toward the door.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "He sits up.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "They both lunge for the handle.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Her hand lands first.", "para": 6, "sent": 4, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "The door will not turn.", "para": 6, "sent": 5, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Oswin slides off the table.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Calm.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Unhurried.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "She throws her shoulder against the steel.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "He puts a hand on her arm, gently.", "para": 7, "sent": 4, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Don't be frightened, dear.", "name": "OSWIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "She stops.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "His thumb strokes her wrist.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "The red lamp goes out.", "para": 8, "sent": 2, "present": [0, 1]}]}