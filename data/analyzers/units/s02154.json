{"scene_id": "s02154", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02154.fountain", "heading": "INT. SUDS & BUBBLES LAUNDROMAT - 3 A.M.", "cast": [{"id": 0, "name": "MARISOL VEGA", "names": ["MARISOL VEGA", "MARISOL"], "gender": "f", "first": 6, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. SUDS & BUBBLES LAUNDROMAT - 3 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent hum.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Twelve dryers, one running.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A bulletin board of faded flyers.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain on the window.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A broken vending machine glows.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "MARISOL VEGA, 40s, scrubs, tired eyes, sits on a plastic chair with a phone in one hand, a crumpled envelope in the other.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "A laundry basket at her feet.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "She stares at the tumbling dryer as though it owes her money.", "para": 1, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "She sets the phone on her knee.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "Taps the screen.", "para": 2, "sent": 1, "present": [0]}, {"u": 11, "kind": "action", "text": "A voice memo plays.", "para": 2, "sent": 2, "present": [0]}, {"u": 12, "kind": "dialogue", "text": "Hi, Mami. It's me. I know it's late.", "name": "MARISOL", "speaker": 0, "ext": ["V.O."], "paren": ["recording, shaky"], "dual": false, "present": [0]}, {"u": 13, "kind": "action", "text": "Marisol closes her eyes.", "para": 3, "sent": 0, "present": [0]}, {"u": 14, "kind": "dialogue", "text": "I got the results today. I wanted to tell you in person but I couldn't. I'm sorry.", "name": "MARISOL", "speaker": 0, "ext": ["V.O."], "paren": ["recording"], "dual": false, "present": [0]}, {"u": 15, "kind": "action", "text": "She stops the playback.", "para": 4, "sent": 0, "present": [0]}, {"u": 16, "kind": "action", "text": "Opens her eyes.", "para": 4, "sent": 1, "present": [0]}, {"u": 17, "kind": "action", "text": "Looks at the envelope in her hand.", "para": 4, "sent": 2, "present": [0]}, {"u": 18, "kind": "action", "text": "Turns it over.", "para": 4, "sent": 3, "present": [0]}, {"u": 19, "kind": "action", "text": "Turns it back.", "para": 4, "sent": 4, "present": [0]}, {"u": 20, "kind": "action", "text": "She does not open it.", "para": 4, "sent": 5, "present": [0]}, {"u": 21, "kind": "dialogue", "text": "Open it.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0]}, {"u": 22, "kind": "action", "text": "She doesn't.", "para": 5, "sent": 0, "present": [0]}, {"u": 23, "kind": "action", "text": "The dryer buzzes.", "para": 6, "sent": 0, "present": [0]}, {"u": 24, "kind": "action", "text": "She stands.", "para": 6, "sent": 1, "present": [0]}, {"u": 25, "kind": "action", "text": "Opens the door.", "para": 6, "sent": 2, "present": [0]}, {"u": 26, "kind": "action", "text": "Pulls out a bundle of warm towels.", "para": 6, "sent": 3, "present": [0]}, {"u": 27, "kind": "action", "text": "Buries her face in them.", "para": 6, "sent": 4, "present": [0]}, {"u": 28, "kind": "action", "text": "Breathes.", "para": 6, "sent": 5, "present": [0]}, {"u": 29, "kind": "action", "text": "Behind her, the vending machine flickers.", "para": 7, "sent": 0, "present": [0]}, {"u": 30, "kind": "action", "text": "She folds a towel.", "para": 7, "sent": 1, "present": [0]}, {"u": 31, "kind": "action", "text": "Another.", "para": 7, "sent": 2, "present": [0]}, {"u": 32, "kind": "action", "text": "Her hands move fast, as if folding were a prayer she knows by heart.", "para": 7, "sent": 3, "present": [0]}, {"u": 33, "kind": "dialogue", "text": "Okay.", "name": "MARISOL", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the empty room"], "dual": false, "present": [0]}, {"u": 34, "kind": "action", "text": "She puts the envelope on top of the stack.", "para": 8, "sent": 0, "present": [0]}, {"u": 35, "kind": "action", "text": "Presses the stack flat with both hands.", "para": 8, "sent": 1, "present": [0]}, {"u": 36, "kind": "action", "text": "Stands there, shoulders high, not breathing, until the dryer clicks off.", "para": 8, "sent": 2, "present": [0]}, {"u": 37, "kind": "action", "text": "She picks up the phone.", "para": 9, "sent": 0, "present": [0]}, {"u": 38, "kind": "action", "text": "Taps the screen.", "para": 9, "sent": 1, "present": [0]}, {"u": 39, "kind": "action", "text": "Holds it to her ear.", "para": 9, "sent": 2, "present": [0]}, {"u": 40, "kind": "dialogue", "text": "I love you, Mami.", "name": "MARISOL", "speaker": 0, "ext": ["V.O."], "paren": ["recording, shaky"], "dual": false, "present": [0]}, {"u": 41, "kind": "action", "text": "Marisol presses a button.", "para": 10, "sent": 0, "present": [0]}, {"u": 42, "kind": "action", "text": "The recording starts over.", "para": 10, "sent": 1, "present": [0]}]}