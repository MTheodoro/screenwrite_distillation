{"scene_id": "s02155", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02155.fountain", "heading": "EXT. RAINBOW BRIDGE - TOLLBOOTH - DAY", "cast": [{"id": 0, "name": "ELDRIC FENN", "names": ["ELDRIC FENN", "ELDRIC"], "gender": "f", "first": 4, "spoke": 13}, {"id": 1, "name": "NUALA BRAE", "names": ["NUALA BRAE", "NUALA"], "gender": "f", "first": 18, "spoke": 12}], "units": [{"u": 0, "kind": "heading", "text": "EXT. RAINBOW BRIDGE - TOLLBOOTH - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A shimmering arc of color across a cloud-sea.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "At its midpoint, a little wooden booth with a thatched roof and a bell on a string.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A hand-painted sign: \"TOLL: ONE TRUE STORY.\"", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ELDRIC FENN, 70, tollkeeper, patchwork coat, spectacles pushed up on his forehead, whittles a stick.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He hums, content.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Gulls wheel.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "A mild wind.", "para": 1, "sent": 3, "present": [0]}, {"u": 8, "kind": "action", "text": "He pauses.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Listens.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "Hums again.", "para": 2, "sent": 2, "present": [0]}, {"u": 11, "kind": "dialogue", "text": "Quiet day.", "name": "ELDRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 12, "kind": "action", "text": "He whittles on.", "para": 3, "sent": 0, "present": [0]}, {"u": 13, "kind": "action", "text": "Somewhere below, a faint bell tolls.", "para": 3, "sent": 1, "present": [0]}, {"u": 14, "kind": "action", "text": "He blows shavings off the stick.", "para": 3, "sent": 2, "present": [0]}, {"u": 15, "kind": "dialogue", "text": "Quiet week, really.", "name": "ELDRIC", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 16, "kind": "action", "text": "Footsteps on the bridge.", "para": 4, "sent": 0, "present": [0]}, {"u": 17, "kind": "action", "text": "A figure rises over the curve of the arch.", "para": 4, "sent": 1, "present": [0]}, {"u": 18, "kind": "action", "text": "NUALA BRAE, 30s, wanderer, patched cloak, walking staff, a satchel across her back.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She stops at the booth and sets down her staff.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Good morning.", "name": "NUALA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Morning, traveler. Toll's one true story.", "name": "ELDRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Any story?", "name": "NUALA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "True ones only. I can tell.", "name": "ELDRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "How?", "name": "NUALA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "The bell. It rings when you lie.", "name": "ELDRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Ah.", "name": "NUALA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "She thinks.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "The wind lifts the edge of her cloak.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "When I was nine, I fell into a well and stayed there three days. I told the village a fox pulled me out. It was a fox.", "name": "NUALA", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Eldric holds the bell string.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Nothing rings.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Hm.", "name": "ELDRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Is that enough?", "name": "NUALA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "It's a decent story.", "name": "ELDRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "But?", "name": "NUALA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "The fox was a lie, wasn't it?", "name": "ELDRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Nuala says nothing.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "The bell does not ring.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "No. The fox was true. It's the nine that was a lie. You were twelve.", "name": "ELDRIC", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Fifteen.", "name": "NUALA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "The bell rings, softly, one clear note.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "There it is.", "name": "ELDRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "I'll pay in cheese instead.", "name": "NUALA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "That'll do.", "name": "ELDRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "She hands over a wedge wrapped in cloth.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "He lifts the gate.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "She takes her staff and crosses.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Halfway past him she stops.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Do you get many visitors?", "name": "NUALA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Fewer every year.", "name": "ELDRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Why?", "name": "NUALA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "They've run out of true stories.", "name": "ELDRIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "Perhaps they've run out of nerve.", "name": "NUALA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "She walks on.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "Eldric watches her go until she is a small bright thing on the far end of the bridge.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "Then he picks up his stick and starts whittling again.", "para": 10, "sent": 2, "present": [0, 1]}]}