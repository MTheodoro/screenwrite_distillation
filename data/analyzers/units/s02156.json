{"scene_id": "s02156", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02156.fountain", "heading": "INT. IRON LUNG BOXING GYM - RING - NIGHT", "cast": [{"id": 0, "name": "BIRDIE SOLOMON", "names": ["BIRDIE SOLOMON", "BIRDIE"], "gender": "m", "first": 5, "spoke": 1}, {"id": 1, "name": "KAI DRAKE", "names": ["KAI DRAKE", "KAI"], "gender": "m", "first": 6, "spoke": 2}, {"id": 2, "name": "MASKED FIGHTER", "names": ["MASKED FIGHTER"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "MC ROLAND PRYCE", "names": ["MC ROLAND PRYCE", "MC"], "gender": "?", "first": 8, "spoke": 1}, {"id": 4, "name": "LUCIAN DRAKE", "names": ["LUCIAN DRAKE", "LUCIAN"], "gender": "m", "first": 6, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. IRON LUNG BOXING GYM - RING - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Ropes sagged to the ankle.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A bell with a cracked rim.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A crowd of forty on folding chairs.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The overhead bulb sways.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "BIRDIE SOLOMON, 60s, trainer, towel on his neck, kneels in the corner.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Opposite, KAI DRAKE, 25, champion, in a gold robe, jabs at air.", "para": 1, "sent": 1, "present": [0, 1, 4]}, {"u": 7, "kind": "action", "text": "In the other corner, a MASKED FIGHTER, 30s, lean, silver wrestling mask, shakes out his arms.", "para": 1, "sent": 2, "present": [0, 1, 2, 4]}, {"u": 8, "kind": "action", "text": "MC ROLAND PRYCE, 50s, in a ruffled shirt, taps a microphone.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Ladies and gentlemen, in the red corner, a mystery!", "name": "MC", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "The crowd murmurs.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Bell.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "The Masked Fighter and Kai circle.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Jab, jab, a feint, a hook.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Kai tags him on the chin.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "The Masked Fighter staggers.", "para": 3, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Birdie winces.", "para": 3, "sent": 6, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Elbows up, son!", "name": "BIRDIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Kai swings again.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "The Masked Fighter ducks.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Their gloves tangle.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "They clinch.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Both freeze, panting.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Kai grabs the silver mask and rips it off.", "para": 4, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Beneath is a face the whole room knows.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "LUCIAN DRAKE, 30s, Kai's older brother, missing seven years.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Lucian?", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Little brother.", "name": "LUCIAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "You're dead.", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Not tonight.", "name": "LUCIAN", "speaker": 4, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Birdie drops his towel.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "The MC drops the microphone.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "The crowd goes silent.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Lucian raises his gloves.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Kai, after a long moment, lowers his.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "They stand there, two men with the same jaw, in a ring too small for either.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}]}