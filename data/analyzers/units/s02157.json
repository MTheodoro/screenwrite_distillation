{"scene_id": "s02157", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02157.fountain", "heading": "EXT. ROOFTOP CRICKET PITCH - MUMBAI - DAWN", "cast": [{"id": 0, "name": "FARRUKH SHAIKH", "names": ["FARRUKH SHAIKH", "FARRUKH"], "gender": "?", "first": 7, "spoke": 7}, {"id": 1, "name": "CASPIAN MOURA", "names": ["CASPIAN MOURA", "CASPIAN"], "gender": "m", "first": 8, "spoke": 4}, {"id": 2, "name": "NEW COACH", "names": ["NEW COACH"], "gender": "?", "first": 9, "spoke": 3}, {"id": 3, "name": "IBARRA", "names": ["IBARRA"], "gender": "?", "first": 31, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ROOFTOP CRICKET PITCH - MUMBAI - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A concrete rooftop between apartment towers.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wire fencing.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Laundry flapping.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Chai steam.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A mat taped to the cement.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "Wickets spray-painted on a water tank.", "para": 0, "sent": 5, "present": []}, {"u": 7, "kind": "action", "text": "FARRUKH SHAIKH, 28, captain, clutches a battered bat.", "para": 1, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "CASPIAN MOURA, 17, rookie bowler, scuffs a tennis ball on his shirt.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "A tall woman in a sari, NEW COACH, 40s, stands at the edge of the mat with a clipboard and no expression.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Rookie. Let's see it.", "name": "FARRUKH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Now?", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Now.", "name": "FARRUKH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Caspian jogs in, delivers.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "The ball smacks the mat, rises off a crack, and clips the water tank with a bang.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Farrukh doesn't flinch.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Again.", "name": "FARRUKH", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Caspian bowls.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Farrukh swings, misses.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "The ball slams the tank again.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Your grip is open.", "name": "NEW COACH", "speaker": 2, "ext": [], "paren": ["flat"], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Sorry, Ma'am?", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Close your hand. Where I can't see daylight between your fingers.", "name": "NEW COACH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Caspian closes his fingers around the ball.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Bowls.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Farrukh swings.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Connects.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "The ball sails off the roof, over the wire, into the morning haze.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Who's she?", "name": "FARRUKH", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "She says she's our coach.", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Whose coach?", "name": "FARRUKH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Ibarra. Rosa Ibarra.", "name": "NEW COACH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Ibarra? As in the Ibarra? From the 2011 final?", "name": "FARRUKH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "I do not discuss 2011.", "name": "IBARRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "You played in 2011?", "name": "CASPIAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Another.", "name": "IBARRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "She sets the clipboard on the water tank.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Takes the ball from Caspian.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Rolls it across the mat to Farrukh.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Captain. Show me what you do with the next one.", "name": "IBARRA", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Farrukh looks at the ball.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "At Caspian.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "At the horizon where the first one landed.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "That's the last ball we have.", "name": "FARRUKH", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Then play it well.", "name": "IBARRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}