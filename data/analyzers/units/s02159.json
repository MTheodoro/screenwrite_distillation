{"scene_id": "s02159", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02159.fountain", "heading": "INT. NORTHSTAR WEATHER STATION - COMMON ROOM - NIGHT", "cast": [{"id": 0, "name": "GUNNAR BERG", "names": ["GUNNAR BERG", "GUNNAR"], "gender": "?", "first": 5, "spoke": 11}, {"id": 1, "name": "PALOMA REYES", "names": ["PALOMA REYES", "PALOMA"], "gender": "?", "first": 6, "spoke": 8}, {"id": 2, "name": "REGGIE OYELOWO", "names": ["REGGIE OYELOWO", "REGGIE"], "gender": "m", "first": 7, "spoke": 6}, {"id": 3, "name": "BASE", "names": ["BASE"], "gender": "?", "first": 24, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. NORTHSTAR WEATHER STATION - COMMON ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Steel walls, wool blankets, a single heater ticking.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Frost on the window.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Instruments blink on a long table.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Wind howls round the corners of the building.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "GUNNAR BERG, 50s, beard, captain's cap, sits at the radio.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "PALOMA REYES, 30s, climatologist, parka zipped to the chin, turns pages in a logbook.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "REGGIE OYELOWO, 25, mechanic, sits on the floor and wraps his hands in a tea towel.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Right. Rations. We have six days of food.", "name": "GUNNAR", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Gunnar, it's seven.", "name": "PALOMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Six, if Reggie eats.", "name": "GUNNAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Reggie is standing right here.", "name": "REGGIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Reggie is sitting right there.", "name": "GUNNAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Reggie, how are your hands?", "name": "PALOMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Cold.", "name": "REGGIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Frostbite?", "name": "PALOMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Just cold. I think.", "name": "REGGIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Let me see.", "name": "PALOMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Leave it, Paloma.", "name": "REGGIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Reggie.", "name": "PALOMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "He unwraps the towel and shows her.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Pink, swollen, but sound.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "She nods.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Okay. Okay. Not yet.", "name": "PALOMA", "speaker": 1, "ext": ["CONT'D"], "paren": ["to herself"], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Base, Northstar. Do you read?", "name": "GUNNAR", "speaker": 0, "ext": [], "paren": ["into the radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "...Northstar... storm... hold position...", "name": "BASE", "speaker": 3, "ext": ["V.O."], "paren": ["radio, static"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "We're holding. How long?", "name": "GUNNAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "...seventy-two hours...", "name": "BASE", "speaker": 3, "ext": ["V.O."], "paren": ["radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Seventy-two. Understood.", "name": "GUNNAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "He switches off the set.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Silence.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Even the wind seems to listen.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Three days.", "name": "GUNNAR", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Is that bad?", "name": "REGGIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "It's three days.", "name": "GUNNAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Gunnar, you said six days of food.", "name": "PALOMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Then it's three days of waiting and three days of margin.", "name": "GUNNAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "That's thin.", "name": "PALOMA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "It's what we have.", "name": "GUNNAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Reggie hugs his knees.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Does anybody want to play cards?", "name": "REGGIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Paloma looks at Gunnar.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Gunnar looks at Reggie.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "He takes off his cap.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Deal.", "name": "GUNNAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}