{"scene_id": "s02160", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02160.fountain", "heading": "INT. TREASURE OF THE LOST PHARAOH - ESCAPE ROOM - DAY", "cast": [{"id": 0, "name": "BECCA ANDERSEN", "names": ["BECCA ANDERSEN", "BECCA"], "gender": "f", "first": 6, "spoke": 9}, {"id": 1, "name": "TARIQ HASAN", "names": ["TARIQ HASAN", "TARIQ"], "gender": "m", "first": 7, "spoke": 8}, {"id": 2, "name": "GRANDMA LOLA", "names": ["GRANDMA LOLA", "LOLA"], "gender": "f", "first": 8, "spoke": 5}, {"id": 3, "name": "UNCLE FESTUS", "names": ["UNCLE FESTUS", "FESTUS"], "gender": "m", "first": 9, "spoke": 5}, {"id": 4, "name": "MORTIMER", "names": ["MORTIMER"], "gender": "?", "first": 10, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. TREASURE OF THE LOST PHARAOH - ESCAPE ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A fake tomb, all plaster and foam.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Hieroglyphs in glow paint.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A sarcophagus with a fake mummy.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A digital countdown above the door: 02:14.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Five people stuffed into a space for four.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "BECCA ANDERSEN, 30s, bachelorette sash, runs her fingers over a hieroglyph wall.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "TARIQ HASAN, 30s, polo shirt, crouches over a stone tablet.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "GRANDMA LOLA, 80, bedazzled tracksuit, sits on the sarcophagus lid eating a granola bar.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "UNCLE FESTUS, 60s, safari hat, clutches a flashlight like a sword.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "MORTIMER (V.O.), the game master, speaks from a speaker above the door.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Two minutes remain.", "name": "MORTIMER", "speaker": 4, "ext": ["V.O."], "paren": ["speaker"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Tariq, what does the tablet say?", "name": "BECCA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "It says \"pull the lever.\"", "name": "TARIQ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "What lever?", "name": "BECCA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "This lever!", "name": "FESTUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "He yanks a wall lever.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "A foam block drops from the ceiling and bonks him on the head.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "He staggers.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Tariq catches him.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "They both topple over the coffin lid.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Lola doesn't move.", "para": 3, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Festus, you broke the clue.", "name": "LOLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "I did not break it. It broke me.", "name": "FESTUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Festus, he's right. That wasn't the lever.", "name": "TARIQ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Which he?", "name": "BECCA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Festus.", "name": "TARIQ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Which Festus?", "name": "BECCA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Becca, there's only one Festus.", "name": "TARIQ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Then say \"Festus is right.\"", "name": "BECCA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Festus is right.", "name": "TARIQ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Thank you.", "name": "FESTUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "One minute remains.", "name": "MORTIMER", "speaker": 4, "ext": ["V.O."], "paren": ["speaker"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Becca spins.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Tariq scrambles.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Festus staggers to his feet.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "They all bump into each other and scatter in different directions, hands patting walls.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "There's a hole!", "name": "BECCA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Where?", "name": "TARIQ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Right here!", "name": "BECCA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "That's my ear.", "name": "FESTUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "That's the hole.", "name": "LOLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "She points calmly with a granola bar to a plastic scarab in the sarcophagus's eye socket.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Becca freezes.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Tariq stops.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Festus stops.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "All three look at Lola.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "How did you...", "name": "BECCA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "I read the manual.", "name": "LOLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "There is a manual?", "name": "TARIQ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Next to the sarcophagus.", "name": "LOLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "They look.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "A laminated card, taped to the lid: \"Press the scarab.\"", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "Oh.", "name": "FESTUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "Oh.", "name": "BECCA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "Oh.", "name": "TARIQ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Becca presses the scarab.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "A click.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "The countdown stops at 00:07.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "A door pops open.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "Bright light.", "para": 7, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "A tiny trumpet fanfare plays.", "para": 7, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "dialogue", "text": "Congratulations. You have escaped.", "name": "MORTIMER", "speaker": 4, "ext": ["V.O."], "paren": ["speaker, flat"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "The four of them blink in the light.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "Lola finishes her granola bar.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "I want to do the Pirate one next.", "name": "LOLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}