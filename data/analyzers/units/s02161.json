{"scene_id": "s02161", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02161.fountain", "heading": "INT. ALL-NIGHT PHARMACY - COUNTER - 2 A.M.", "cast": [{"id": 0, "name": "ELIAS VOLKOV", "names": ["ELIAS VOLKOV", "ELIAS"], "gender": "m", "first": 6, "spoke": 20}, {"id": 1, "name": "GRETA HOLT", "names": ["GRETA HOLT", "GRETA"], "gender": "f", "first": 7, "spoke": 16}], "units": [{"u": 0, "kind": "heading", "text": "INT. ALL-NIGHT PHARMACY - COUNTER - 2 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "Flickering fluorescents.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of cough syrup.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A sleepy rotating display of sunglasses.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain streaks the front window.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A bell above the door.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "ELIAS VOLKOV, 50s, pharmacist, white coat, half-moon glasses, finishes counting pills into a vial.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "GRETA HOLT, 30s, a damp coat, a leather satchel, walks in, shakes off her umbrella, and sets a prescription slip on the counter.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Evening.", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Morning, technically.", "name": "GRETA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Technically.", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He reads the slip.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Pauses.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Looks at her over the glasses.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "This is for ten milligrams.", "name": "ELIAS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Yes.", "name": "GRETA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Of a rather strong sedative.", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "My doctor says I sleep poorly.", "name": "GRETA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Who is your doctor?", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Dr. Peary.", "name": "GRETA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Dr. Peary retired in March.", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Did he?", "name": "GRETA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "He sent me a card.", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Lovely. Is the medication ready?", "name": "GRETA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Give me a moment.", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "He disappears into the back.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "The bell above the door tinkles gently in the draft.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Greta takes out a phone and sets it on the counter, screen down.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "She flips it over.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Flips it back.", "para": 3, "sent": 4, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Behind the shelves, drawers open and close.", "para": 3, "sent": 5, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "How long have you had trouble sleeping?", "name": "ELIAS", "speaker": 0, "ext": ["O.S."], "paren": ["calling"], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Years.", "name": "GRETA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Years.", "name": "ELIAS", "speaker": 0, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Yes.", "name": "GRETA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Elias reappears with a paper bag.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "He sets it on the counter between them.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Neither touches it.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Ms. Holt. May I be frank?", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Please.", "name": "GRETA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "You do not look like a woman who sleeps poorly.", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "What do I look like?", "name": "GRETA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "A woman who has not slept at all.", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Greta says nothing.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "A car swishes by outside.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "The man who was in here last night. The one with the cough.", "name": "ELIAS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "I don't know him.", "name": "GRETA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "He said the same of you.", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Greta's hand moves to the satchel.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "Elias's hand moves under the counter.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "Both freeze.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "Neither breathes.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "Rain drums on the glass.", "para": 6, "sent": 4, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "Mr. Volkov.", "name": "GRETA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "Ms. Holt.", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "I'd like my medication.", "name": "GRETA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "And I'd like to see what's in the satchel.", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "She unlatches it slowly.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "Elias slides his hand a little further.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "She tips the satchel toward him.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "Inside: bundles of cash.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "He gazes at them.", "para": 7, "sent": 4, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "At her.", "para": 7, "sent": 5, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "That is a great deal of money for a sedative.", "name": "ELIAS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "It's for the man with the cough.", "name": "GRETA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "He's dead, Ms. Holt.", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "I know.", "name": "GRETA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "action", "text": "She pulls the satchel shut.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "Elias pulls a small revolver from under the counter.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "Sets it down on the pills.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "Then who is the money for?", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "dialogue", "text": "You.", "name": "GRETA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}