{"scene_id": "s02163", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02163.fountain", "heading": "INT. BOMBED CONVENT HOSPITAL - CELLAR - NIGHT", "cast": [{"id": 0, "name": "NURSE ODETTE BRANDT", "names": ["NURSE ODETTE BRANDT", "ODETTE"], "gender": "f", "first": 7, "spoke": 23}, {"id": 1, "name": "CAPTAIN ZELDA MOSS", "names": ["CAPTAIN ZELDA MOSS", "ZELDA"], "gender": "f", "first": 8, "spoke": 22}], "units": [{"u": 0, "kind": "heading", "text": "INT. BOMBED CONVENT HOSPITAL - CELLAR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "1944.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A low stone cellar.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Candle stubs.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A cot, a bucket, a stack of crates marked with red crosses.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Plaster dust rains gently with each distant explosion.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "A water pipe drips in the dark.", "para": 0, "sent": 5, "present": []}, {"u": 7, "kind": "action", "text": "NURSE ODETTE BRANDT, 30s, apron torn at the hem, bandages wrapped around her wrists like bracelets, kneels on the flagstones sorting what little remains of the pharmacy.", "para": 1, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Across from her, wedged against a barrel, sits CAPTAIN ZELDA MOSS, 30s, in an officer's tunic stiff with dried mud, one boot off, one leg propped and bound with a splint made from a broom handle.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Nobody has spoken for a long time.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I have four morphine ampoules left.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Save them.", "name": "ZELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "For whom?", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "For the ones who can still be saved.", "name": "ZELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "She asked for water an hour ago. And she hasn't said anything since.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Who?", "name": "ZELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "The girl on the third cot.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "I'm not talking about her.", "name": "ZELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "I know.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Then why bring her up?", "name": "ZELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Because she is the only one who is still here to be saved.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Zelda's mouth twitches.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "She looks at the splinted leg.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Is it broken?", "name": "ZELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "The bone is cracked. Not through.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "So I can walk.", "name": "ZELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "She can walk.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "I said \"I.\"", "name": "ZELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Sorry. I meant you.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "A shell lands close.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Dust falls from the vault in a long, soft sheet.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "The candles gutter.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Odette covers the crates with her body.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Zelda puts her hand over her eyes.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "The shudder passes.", "para": 4, "sent": 5, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "That was ours.", "name": "ZELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "How can you tell?", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "The whistle goes down at the end.", "name": "ZELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "What does that mean?", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "It means somebody on our side thinks we are already dead.", "name": "ZELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Then they will walk the line tomorrow.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "If there is a tomorrow.", "name": "ZELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "There will be.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "You say that to every patient.", "name": "ZELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "I say it to myself.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "Zelda laughs.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "A short, bitter sound.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "She lets her head fall back against the barrel.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Do you have a family?", "name": "ZELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "A sister, in Lyon.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "I had a brother in Leeds.", "name": "ZELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Had?", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Have. I think.", "name": "ZELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "The pipe drips.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "Odette picks up a vial.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "Reads the label.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "Puts it down.", "para": 6, "sent": 4, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "I'm going to give you one.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "No.", "name": "ZELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "Captain.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "I said no, Nurse.", "name": "ZELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "She said no. Is that right?", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "She means me.", "name": "ZELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "Then I'll obey her.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "Zelda snorts.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "Odette stays where she is.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 67, "kind": "action", "text": "A long beat.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "Above them, boots on the broken floor.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "Voices.", "para": 7, "sent": 4, "present": [0, 1]}, {"u": 70, "kind": "action", "text": "A rifle butt knocks the cellar door.", "para": 7, "sent": 5, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "Both women look up.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "Zelda reaches for a pistol on the crate.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "Odette puts her hand over Zelda's.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 74, "kind": "dialogue", "text": "Wait.", "name": "ODETTE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 75, "kind": "dialogue", "text": "Wait for what?", "name": "ZELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 76, "kind": "dialogue", "text": "For a word.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 77, "kind": "action", "text": "The door bursts.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 78, "kind": "action", "text": "A man's voice in English, loud and cracking.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 79, "kind": "dialogue", "text": "That's one of ours.", "name": "ZELDA", "speaker": 1, "ext": [], "paren": ["a whisper"], "dual": false, "present": [0, 1]}, {"u": 80, "kind": "dialogue", "text": "Then say it.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 81, "kind": "action", "text": "Zelda draws breath, gathers herself, and shouts up the stairs in a hoarse, cracked voice.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 82, "kind": "dialogue", "text": "Down here! We are down here!", "name": "ZELDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 83, "kind": "action", "text": "The boots thunder toward them.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 84, "kind": "action", "text": "Odette picks up the ampoule and, very slowly, tucks it back in the crate.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 85, "kind": "action", "text": "Then she begins to cry, softly, without sound.", "para": 11, "sent": 2, "present": [0, 1]}]}