{"scene_id": "s02164", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02164.fountain", "heading": "INT. GOLDEN MIC KARAOKE - PRIVATE BOOTH - NIGHT", "cast": [{"id": 0, "name": "NOLA FINCH", "names": ["NOLA FINCH", "NOLA"], "gender": "?", "first": 5, "spoke": 6}, {"id": 1, "name": "ARTHUR BELL", "names": ["ARTHUR BELL", "ARTHUR"], "gender": "?", "first": 6, "spoke": 4}, {"id": 2, "name": "SIMONE RAYE", "names": ["SIMONE RAYE", "SIMONE"], "gender": "?", "first": 7, "spoke": 2}, {"id": 3, "name": "HUGO MARTEL", "names": ["HUGO MARTEL", "HUGO"], "gender": "?", "first": 8, "spoke": 5}, {"id": 4, "name": "KIRA BELL", "names": ["KIRA BELL", "KIRA"], "gender": "?", "first": 6, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. GOLDEN MIC KARAOKE - PRIVATE BOOTH - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Velvet seats.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Disco lights.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A screen scrolling lyrics.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Five people crowd a booth built for four.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "NOLA FINCH, 30s, sequins.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "ARTHUR BELL, 30s, a sensible sweater.", "para": 1, "sent": 1, "present": [0, 1, 4]}, {"u": 7, "kind": "action", "text": "SIMONE RAYE, 30s, bridesmaid in a silver dress.", "para": 1, "sent": 2, "present": [0, 1, 2, 4]}, {"u": 8, "kind": "action", "text": "HUGO MARTEL, 40s, shirt open at the collar.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "KIRA BELL, 20s, Arthur's sister, gripping the mic.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "...and I will always love you...", "name": "KIRA", "speaker": 4, "ext": [], "paren": ["into the mic, off-key"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "She finishes.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "They clap.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Nola leans toward Arthur.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "He leans toward her.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "She tucks her hair behind her ear.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "He looks away.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "She looks at Simone.", "para": 2, "sent": 6, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Simone smiles and looks at Hugo.", "para": 2, "sent": 7, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "He raises his glass.", "para": 2, "sent": 8, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Arthur, that was a lovely toast earlier.", "name": "NOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Thank you.", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "You said you've never been happier than tonight.", "name": "NOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "I meant it.", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Me too.", "name": "NOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Aw.", "name": "SIMONE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Cheers.", "name": "HUGO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Nola. Arthur. Would you two go up and sing the last one?", "name": "KIRA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Oh, we couldn't.", "name": "NOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "We really couldn't.", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "You have to. It's tradition.", "name": "KIRA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Nola, there is something I need to say first.", "name": "HUGO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Hugo?", "name": "NOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Arthur is not the man you think he is.", "name": "HUGO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Hugo.", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Seven years ago he proposed to me.", "name": "HUGO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "What?", "name": "NOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "He did?", "name": "SIMONE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "In this same booth.", "name": "HUGO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Nobody breathes.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "The lyrics keep scrolling.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}]}