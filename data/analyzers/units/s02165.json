{"scene_id": "s02165", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02165.fountain", "heading": "INT. LAMPLIGHTER'S TOWER - SPIRAL STAIR - DUSK", "cast": [{"id": 0, "name": "EZEKIEL FROST", "names": ["EZEKIEL FROST", "EZEKIEL"], "gender": "m", "first": 6, "spoke": 8}, {"id": 1, "name": "ABIGAIL", "names": ["ABIGAIL"], "gender": "m", "first": 7, "spoke": 8}, {"id": 2, "name": "TOBY", "names": ["TOBY"], "gender": "m", "first": 8, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAMPLIGHTER'S TOWER - SPIRAL STAIR - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "1887.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A narrow brick tower with an iron ladder.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Gas pipes along the walls.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A hand-cranked lantern winch.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Below, London goes blue.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "EZEKIEL FROST, 50s, lamplighter, oilskin coat, strong arms, climbs a few steps and stops.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "His wife ABIGAIL, 40s, in a shawl, shoves a basket of oil flasks up behind him.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Their son TOBY, 12, slips past both, scrambling up the ladder with a wick-trimmer in his teeth.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Toby, come back down.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I'm nearly there, Papa.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Ezekiel, the boy has a head for it.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "The boy has a head for falling.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Let him light the first.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "He is twelve.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "You were nine.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "And I fell.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "And you got back up.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Toby clambers onto the top landing.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Ezekiel and Abigail both climb after him, jostling on the narrow stair.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "At the top, the three of them stand shoulder to shoulder before a great brass lantern, unlit, its glass cold.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "How does it go?", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Wick up. Valve open. Spark.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Where's the spark?", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "In the flint. Strike it.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Toby takes the flint.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Lifts it.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Ezekiel catches his wrist.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Gently.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "I know.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Gently, son.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Gently, Toby.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "He strikes.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "A spark leaps.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "The wick catches.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "A blue-white flower unfolds behind the glass, then yellow, then a steady gold.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Light pours across the rooftops of the district.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "All three step back.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Ezekiel's hand drops onto Toby's shoulder.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Abigail's hand drops onto Ezekiel's.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Papa. Look.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "I see it.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Across the city, in the dusk, other lamps are blooming one by one in answer.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Toby stares as if he made them all.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "You did that.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "I lit one.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "That's how it starts.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Ezekiel wipes his eyes with the back of his hand and pretends it was the smoke.", "para": 7, "sent": 0, "present": [0, 1, 2]}]}