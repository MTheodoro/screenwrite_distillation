1, 2, 3]}, {"u": 9, "kind": "action", "text": "EMEKA OKONJO, 40s, the middle brother, leans on the wall with his arms crossed.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "ADAEZE OKONJO, 30s, the youngest, holds a Styrofoam cup of coffee she isn't drinking.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "TUNDE, 30s, her husband, studies his phone.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "And GRANDMOTHER ADA's old friend MRS. ETIM, 70s, in her church hat, folds a paper napkin into smaller and smaller squares.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "Nobody speaks.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "Chidi checks his watch.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Ngozi checks hers.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Emeka looks at the door.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Adaeze looks at Tunde.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Tunde looks at his phone.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Mrs. Etim looks at the fish.", "para": 4, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "The fish looks at nothing.", "para": 4, "sent": 6, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "It has been an hour.", "name": "CHIDI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "It has been fifty-two minutes.", "name": "NGOZI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Fifty-two is an hour.", "name": "CHIDI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Fifty-two is fifty-two.", "name": "NGOZI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Please.", "name": "EMEKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Adaeze offers the coffee to no one in particular.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Tunde takes it.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Sips.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Makes a face.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Hands it back.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "It's cold.", "name": "TUNDE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "I know.", "name": "ADAEZE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Mrs. Etim unfolds the napkin, smooths it flat on her knee, folds it again.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "She asked for jollof last Sunday.", "name": "MRS. ETIM", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "She asked for jollof every Sunday.", "name": "NGOZI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "This one she ate.", "name": "MRS. ETIM", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "She ate it.", "name": "EMEKA", "speaker": 2, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "All of it.", "name": "ADAEZE", "speaker": 3, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "The weather map changes colors.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Nobody looks at the TV.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "The door opens and a NURSE's hand rests on the frame, then the door closes again.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Everyone stands at once.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Chidi, then Ngozi, then Emeka, then Adaeze and Tunde, then Mrs. Etim leaning on her cane.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "They stand in a half-circle facing the door.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "It does not open again.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "No one sits.", "para": 8, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "We wait.", "name": "CHIDI", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}