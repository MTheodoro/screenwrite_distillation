{"scene_id": "s02167", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02167.fountain", "heading": "INT. ORBITAL ELEVATOR CAR - ASCENDING - NIGHT", "cast": [{"id": 0, "name": "CAPTAIN LEILA NOURI", "names": ["CAPTAIN LEILA NOURI", "LEILA"], "gender": "?", "first": 5, "spoke": 4}, {"id": 1, "name": "ENGINEER BODHI RAMASWAMY", "names": ["ENGINEER BODHI RAMASWAMY", "BODHI"], "gender": "m", "first": 6, "spoke": 5}, {"id": 2, "name": "WANJIRU KARIUKI", "names": ["WANJIRU KARIUKI", "DR. KARIUKI"], "gender": "f", "first": 7, "spoke": 2}, {"id": 3, "name": "SECURITY OFFICER DMITRI VOLKOV-STERN", "names": ["SECURITY OFFICER DMITRI VOLKOV-STERN", "DMITRI"], "gender": "m", "first": 8, "spoke": 3}, {"id": 4, "name": "CHILD", "names": ["CHILD"], "gender": "?", "first": 9, "spoke": 0}, {"id": 5, "name": "SILENT MONK", "names": ["SILENT MONK"], "gender": "?", "first": 10, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. ORBITAL ELEVATOR CAR - ASCENDING - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A glass cylinder rising through the dark.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The Earth is a shrinking blue plate below.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Warning lights pulse amber.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The car shudders.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Six passengers: CAPTAIN LEILA NOURI, pilot suit, grips the rail.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "ENGINEER BODHI RAMASWAMY, welding goggles on his forehead, kneels at an open panel.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "DR. WANJIRU KARIUKI, in a lab coat, hugs a sealed sample case.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "SECURITY OFFICER DMITRI VOLKOV-STERN, riot vest, gun holstered, scans the others.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "A CHILD, 8, in a pink vest.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "And a SILENT MONK, bald, saffron robes, eyes closed.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Bodhi, talk to me.", "name": "LEILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Cable's fraying. We have twenty minutes.", "name": "BODHI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Twenty minutes to what?", "name": "DR. KARIUKI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "To snap.", "name": "BODHI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Then we go down?", "name": "DMITRI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "No. Too fast.", "name": "LEILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "We can't go up either.", "name": "BODHI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Why not?", "name": "DR. KARIUKI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Because up is thirty-five thousand kilometers, Doctor.", "name": "BODHI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "The car jolts.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "The child cries out.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "The monk's eyes open.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "He rises, steps to the child, and puts a hand on her shoulder.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Dmitri draws his weapon, thinks better of it, holsters it.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Dr. Kariuki sets down the sample case and unzips her lab coat.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Leila slams a fist on the panel; the lights go out; the car drops half a meter; Bodhi swears and jams his wrench into the gap.", "para": 2, "sent": 6, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Bodhi!", "name": "LEILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "I know!", "name": "BODHI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Captain, I can climb the cable.", "name": "DMITRI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Dmitri, nobody climbs a cable.", "name": "LEILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Then what?", "name": "DMITRI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "The monk raises one finger.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Everyone stops.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "He points up.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Above them, in the black, a second car is descending, lights blazing.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}]}