{"scene_id": "s02168", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02168.fountain", "heading": "INT. LEVINE & SON PAWN - DAY", "cast": [{"id": 0, "name": "ABRAHAM LEVINE", "names": ["ABRAHAM LEVINE", "ABRAHAM"], "gender": "?", "first": 4, "spoke": 14}, {"id": 1, "name": "JOSHUA", "names": ["JOSHUA"], "gender": "?", "first": 5, "spoke": 9}, {"id": 2, "name": "WOMAN", "names": ["WOMAN"], "gender": "?", "first": 7, "spoke": 5}, {"id": 3, "name": "ROSALIE", "names": ["ROSALIE"], "gender": "f", "first": 37, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. LEVINE & SON PAWN - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A narrow shop crammed with guitars, wristwatches, stuffed marlin, a rack of wedding rings behind glass.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A bell over the door.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dusty sun through barred windows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ABRAHAM LEVINE, 70, pawnbroker, green visor, rolled sleeves, polishes a trumpet.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "His son JOSHUA, 40s, in a suit that doesn't fit, tallies receipts at the end of the counter.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "The bell rings.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "A WOMAN, 30s, enters.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Raincoat, wet hair, a small velvet pouch gripped in both hands.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "She stands just inside the door as though the floor might give way.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Good afternoon.", "name": "ABRAHAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Is it?", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "For some of us.", "name": "ABRAHAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She crosses to the counter.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Sets the pouch down.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Pulls the drawstring.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "A gold locket slides out.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Joshua stops tallying.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Dad.", "name": "JOSHUA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I see it.", "name": "ABRAHAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "It was my mother's.", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "It's beautiful.", "name": "ABRAHAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "It's worth four hundred, easy.", "name": "JOSHUA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Eight.", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Four.", "name": "JOSHUA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "It has a picture inside.", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "May I?", "name": "ABRAHAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "She nods.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Abraham opens it with a thumbnail.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Stares.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Closes it.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Joshua. Look at this.", "name": "ABRAHAM", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "What?", "name": "JOSHUA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Just look.", "name": "ABRAHAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Joshua takes the locket, opens it.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "His face changes.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Dad. That's...", "name": "JOSHUA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Rosalie Pinsky.", "name": "ABRAHAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "I'm Rosalie.", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "No. The locket belonged to...", "name": "ABRAHAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "My mother. Hannah Pinsky. She pawned it here in 1991.", "name": "ROSALIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "She did. And she never came back.", "name": "ABRAHAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "She died.", "name": "ROSALIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "We're sorry.", "name": "JOSHUA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Don't be. I'm here to buy it back.", "name": "ROSALIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "It's yours.", "name": "ABRAHAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Dad, it's inventory.", "name": "JOSHUA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Joshua, a locket this old isn't inventory. It's a promise.", "name": "ABRAHAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "We have a business.", "name": "JOSHUA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "We have a mother.", "name": "ABRAHAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Joshua looks at the locket.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "At Rosalie.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "At his father.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "He closes the drawer.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Take it.", "name": "JOSHUA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "I'll pay for it.", "name": "ROSALIE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "You already did.", "name": "ABRAHAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Rosalie closes her fingers around the locket.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "The bell above the door rings softly as a draft touches it.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}]}