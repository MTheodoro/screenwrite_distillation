{"scene_id": "s02169", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02169.fountain", "heading": "INT. FIELD HOSPITAL - SHIPPING CONTAINER OPERATING ROOM - NIGHT", "cast": [{"id": 0, "name": "HANNELORE BRIGG", "names": ["HANNELORE BRIGG", "HANNELORE"], "gender": "?", "first": 7, "spoke": 13}, {"id": 1, "name": "CASIMIR ODUYA", "names": ["CASIMIR ODUYA", "CASIMIR"], "gender": "m", "first": 8, "spoke": 11}], "units": [{"u": 0, "kind": "heading", "text": "INT. FIELD HOSPITAL - SHIPPING CONTAINER OPERATING ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Steel walls, painted white.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Two surgical lamps on a generator hum.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A battered table.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A rack of salvaged instruments.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A tarpaulin flaps outside.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "Gunfire, far off.", "para": 0, "sent": 5, "present": []}, {"u": 7, "kind": "action", "text": "DR. HANNELORE BRIGG, 50s, mask, gown, hair under a cap, works over a patient's abdomen, hands deep, eyes steady.", "para": 1, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "CASIMIR ODUYA, 30s, nurse, sweat on his forehead, holds a retractor and a flashlight in one hand and a suction line in the other.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Suction.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Suction.", "name": "CASIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Clamp.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Clamp.", "name": "CASIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He passes it.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She takes it without looking.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Light left.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He tilts the flashlight.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "The beam finds the wound.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Good.", "name": "HANNELORE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "The generator coughs.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "The lamps dim and recover.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "They both freeze, eyes on the bulbs.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "The hum steadies.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "They exhale at the same time.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Fuel is low.", "name": "CASIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "How long?", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Twenty minutes.", "name": "CASIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Enough.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Doctor, I have a pulse of one-twenty.", "name": "CASIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "I know.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Pressure's dropping.", "name": "CASIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "I know, Casimir.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "She reaches, clamps, cauterizes.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Smoke.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "He wipes her forehead with the back of his glove.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "She doesn't flinch.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Suture.", "name": "HANNELORE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Suture.", "name": "CASIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "She sews.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "His thumb steadies the tissue.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Her needle dips, rises, dips.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "A tide of small, precise movements.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Pulse ninety.", "name": "CASIMIR", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Better.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Pressure rising.", "name": "CASIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Good.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "She ties the last knot.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Cuts it.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Sets down the scissors.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "They stand a moment, both looking at the sleeping chest rise and fall.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Doctor.", "name": "CASIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Mm.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Next.", "name": "CASIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "Next.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "They pull off gloves, together, and drop them in the bucket.", "para": 8, "sent": 0, "present": [0, 1]}]}