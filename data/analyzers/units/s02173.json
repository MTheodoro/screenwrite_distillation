{"scene_id": "s02173", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02173.fountain", "heading": "EXT. MOUNTAIN MONASTERY COURTYARD - ITALY - DAWN", "cast": [{"id": 0, "name": "SERGEANT WALTER PIKE", "names": ["SERGEANT WALTER PIKE", "PIKE"], "gender": "?", "first": 5, "spoke": 14}, {"id": 1, "name": "ZEKE", "names": ["ZEKE"], "gender": "?", "first": 6, "spoke": 7}, {"id": 2, "name": "ROSS", "names": ["ROSS"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "PRIVATE ANTONIO DELUCA", "names": ["PRIVATE ANTONIO DELUCA", "DELUCA"], "gender": "?", "first": 7, "spoke": 4}, {"id": 4, "name": "FATHER BENEDIKT", "names": ["FATHER BENEDIKT"], "gender": "?", "first": 8, "spoke": 3}, {"id": 5, "name": "CAPTAIN HELEN MARSH", "names": ["CAPTAIN HELEN MARSH", "MARSH"], "gender": "?", "first": 9, "spoke": 9}, {"id": 6, "name": "BELL", "names": ["BELL"], "gender": "?", "first": 58, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. MOUNTAIN MONASTERY COURTYARD - ITALY - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Autumn, 1944.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Mist clings to the cloister stones.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A well in the centre.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A bell with no rope.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SERGEANT WALTER PIKE (30s, weathered, steady) sits on the well's rim, cleaning a rifle with a rag.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "CORPORAL EZEKIEL \"ZEKE\" ROSS (20s, lanky, bandaged hand) stares at the hills.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "PRIVATE ANTONIO DELUCA (19, round-faced, local boy) peels a potato into a helmet.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "FATHER BENEDIKT (70s, white beard, patched habit) sweeps the stones.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "CAPTAIN HELEN MARSH (30s, army nurse, sleeves rolled) writes in a notebook on an upturned crate.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Padre, there's no need for that.", "name": "PIKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "There is always need. The leaves do not respect armies.", "name": "FATHER BENEDIKT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "Pike smiles faintly and goes on cleaning.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "Zeke drifts over to the well.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "Deluca keeps peeling.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Quiet one this morning.", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "The quiet's a favour. Take it.", "name": "PIKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "You think they're coming back?", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "I think the lieutenant said wait. So we wait.", "name": "PIKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Walter, tell Ross to stop pacing. It tires the patients.", "name": "MARSH", "speaker": 5, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "You heard the captain.", "name": "PIKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "I'm not pacing. I'm walking.", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Then walk where I can't see you.", "name": "MARSH", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Zeke grins, holds up his bandaged hand in surrender, and sits beside Pike.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Sergeant, my mother makes this with garlic. Will the Padre have garlic?", "name": "DELUCA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "The Padre has one head of garlic. It is for Sundays.", "name": "FATHER BENEDIKT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "It is Sunday.", "name": "DELUCA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Is it?", "name": "FATHER BENEDIKT", "speaker": 4, "ext": [], "paren": ["a beat"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Pike checks his watch.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Shakes it.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Winds it.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Might be.", "name": "PIKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Father Benedikt sets down the broom and walks toward the kitchen.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Deluca follows with the helmet.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Don't give him all of it, Tony.", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "I will give him what he asks.", "name": "DELUCA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "He thinks we're on holiday.", "name": "ZEKE", "speaker": 1, "ext": [], "paren": ["low, to Pike"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Let him.", "name": "PIKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Walter. Come here a moment.", "name": "MARSH", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Pike sets the rifle on the rim and crosses to her.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "She hands him the notebook.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Count them.", "name": "MARSH", "speaker": 5, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Eleven. Seven walking.", "name": "PIKE", "speaker": 0, "ext": [], "paren": ["reading"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "Four can't. I need a truck by tomorrow.", "name": "MARSH", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "There's no truck.", "name": "PIKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Then a mule. A cart. A door and four men.", "name": "MARSH", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "I'll ask the Padre. He knows every shed on this hill.", "name": "PIKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "Ask him gently.", "name": "MARSH", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "I'm always gentle.", "name": "PIKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "You are always tired. It sounds the same.", "name": "MARSH", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "Pike nearly laughs.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "He hands back the notebook.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "Behind them Zeke has picked up the rifle and is turning it over.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "Ross.", "name": "PIKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "Just looking.", "name": "ZEKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "Looking costs nothing. Put it down.", "name": "PIKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "Zeke sets it down.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "Pike and Zeke look at each other, then at the hills, then at nothing.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "A BELL rings once from somewhere far below.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 59, "kind": "action", "text": "They all stop.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 60, "kind": "action", "text": "Marsh, Pike, Zeke.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 61, "kind": "action", "text": "Even Deluca, in the kitchen doorway.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 62, "kind": "dialogue", "text": "That's the village.", "name": "ZEKE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 63, "kind": "dialogue", "text": "That's a goat with a bell.", "name": "PIKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 64, "kind": "dialogue", "text": "It is not a goat. It is Signora Fiore. She rings it when the bread is ready.", "name": "DELUCA", "speaker": 3, "ext": [], "paren": ["from the doorway"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 65, "kind": "action", "text": "Beat.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 66, "kind": "action", "text": "Pike exhales.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 67, "kind": "dialogue", "text": "Bread's ready.", "name": "PIKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 68, "kind": "dialogue", "text": "Then let us eat before somebody changes their mind.", "name": "MARSH", "speaker": 5, "ext": [], "paren": ["to everyone"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 69, "kind": "action", "text": "They file toward the kitchen.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 70, "kind": "action", "text": "Pike last.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 71, "kind": "action", "text": "He picks up the broom, finishes the corner Father Benedikt left, and follows.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}]}