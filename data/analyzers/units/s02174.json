{"scene_id": "s02174", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02174.fountain", "heading": "INT. DEFUNCT PLANETARIUM - NIGHT", "cast": [{"id": 0, "name": "RUTH ALMEIDA", "names": ["RUTH ALMEIDA", "RUTH"], "gender": "f", "first": 4, "spoke": 17}, {"id": 1, "name": "STRANGER", "names": ["STRANGER"], "gender": "m", "first": 12, "spoke": 9}, {"id": 2, "name": "DOOR", "names": ["DOOR"], "gender": "?", "first": 26, "spoke": 0}, {"id": 3, "name": "DANIEL OKAFOR", "names": ["DANIEL", "DANIEL OKAFOR"], "gender": "m", "first": 30, "spoke": 7}, {"id": 4, "name": "MARCUS", "names": ["MARCUS"], "gender": "m", "first": 51, "spoke": 5}, {"id": 5, "name": "TESSA QUINN", "names": ["TESSA QUINN", "TESSA"], "gender": "?", "first": 66, "spoke": 5}, {"id": 6, "name": "SERGEANT BRANDT", "names": ["SERGEANT BRANDT"], "gender": "?", "first": 102, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. DEFUNCT PLANETARIUM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Domed ceiling, cracked and starless.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of reclined seats like a ribcage.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A projector the size of a car squats in the centre, wrapped in cables.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "RUTH ALMEIDA (30s, black parka, cropped hair, a face that gives nothing) stands on the dais with a duffel.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her eyes go to every exit.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Four doors.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "Two chained.", "para": 1, "sent": 3, "present": [0]}, {"u": 8, "kind": "action", "text": "A man in the dark.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Tall.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "Brown overcoat.", "para": 2, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "Holds a phone out in front of him like a torch.", "para": 2, "sent": 3, "present": [0]}, {"u": 12, "kind": "action", "text": "This is the STRANGER (50s).", "para": 2, "sent": 4, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "You're early.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "You're late.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I'm exactly on time. I've been here since noon.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Then you know the doors.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "I know the doors.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He crosses the aisle.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "His shoes tick on dead tile.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Ruth sets the duffel on the projector base and unzips it two inches.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Cash.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Rubber-banded.", "para": 3, "sent": 4, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "A glint of a second thing underneath.", "para": 3, "sent": 5, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "That's not what we agreed.", "name": "STRANGER", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "It's what I brought.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "A DOOR slams somewhere above.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Both look up.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Footsteps on the catwalk.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Then a high, bright voice from the dark.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Ruth? Ruth, it's me!", "name": "DANIEL", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "You brought someone.", "name": "RUTH", "speaker": 0, "ext": [], "paren": ["to the Stranger, flat"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "I didn't.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Someone followed you.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Don't shoot. I'm coming down.", "name": "DANIEL", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "DANIEL OKAFOR (20s, soaked jacket, hands high, a courier's badge on a lanyard) clatters down the aisle steps, eyes wide, breath ragged.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "He stops five feet from the dais.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "He's looking at the Stranger.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "You told me he'd be alone.", "name": "DANIEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "He is.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "He has a gun.", "name": "DANIEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Everyone here has a gun, son.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Ruth steps between them with her hand inside her parka, her gaze on the Stranger, her shoulder angled toward Daniel.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "The Stranger lowers the phone, lets its light sweep the floor, and lets his own hand rest at his belt.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Daniel edges backward until his heel catches a seat arm, and the seat clunks, and all three of them flinch at the sound.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "The projector hums as if listening.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Who are you?", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "You don't need that.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Names are what I need.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Then call me what you like.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "I'll call you what the file called you.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Marcus Hale. Retired.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": ["a pause"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "Nobody's retired.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "Fair.", "name": "MARCUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "He says it like a man putting down a coin.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "On the catwalk, another DOOR.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "A flashlight beam sweeps the dome.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "Rows of seats leap out of the dark one by one.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Daniel drops behind the nearest row.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "Ruth doesn't move.", "para": 8, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "Marcus smiles very slightly.", "para": 8, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "That one is mine.", "name": "MARCUS", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "dialogue", "text": "You said you came alone.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "dialogue", "text": "I said I was alone. It's not the same.", "name": "MARCUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "The beam finds Ruth's face.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "Holds.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "Behind the light a figure steps out: TESSA QUINN (40s, long coat, flashlight in one hand, a pistol held low in the other), her expression as neutral as a closed door.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "dialogue", "text": "Evening, Ruth.", "name": "TESSA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "dialogue", "text": "Detective.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "dialogue", "text": "It's Tessa tonight.", "name": "TESSA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "dialogue", "text": "It's never Tessa.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "action", "text": "Tessa descends two steps.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "action", "text": "Marcus slides sideways along the dais, hand away from his belt now.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "action", "text": "Daniel peeks over the seat back like a child watching a fight.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "dialogue", "text": "Ruth, I didn't call her.", "name": "DANIEL", "speaker": 3, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 75, "kind": "dialogue", "text": "I know.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 76, "kind": "dialogue", "text": "Daniel didn't call me. Marcus did.", "name": "TESSA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 77, "kind": "dialogue", "text": "What?", "name": "DANIEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 78, "kind": "action", "text": "Ruth looks at Marcus.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 79, "kind": "action", "text": "Marcus looks at the ceiling, at the cracked painted stars, as if the answer might be written there.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 80, "kind": "dialogue", "text": "I've got a pension, Ruth.", "name": "MARCUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 81, "kind": "dialogue", "text": "You said retired.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 82, "kind": "dialogue", "text": "I said a lot of things.", "name": "MARCUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 83, "kind": "action", "text": "The projector hums louder.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 84, "kind": "action", "text": "A dull bulb in its belly blinks on, throws a wavering white ellipse onto the dome, and suddenly the whole ceiling is a pale moon with four small shadows moving under it.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 85, "kind": "dialogue", "text": "Everybody put your hands where I can see them.", "name": "TESSA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 86, "kind": "action", "text": "Nobody does.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 87, "kind": "action", "text": "Ruth's hand comes out of her parka.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 88, "kind": "action", "text": "Empty.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 89, "kind": "action", "text": "She lifts the duffel and holds it out over the edge of the dais as if offering it to a guest.", "para": 13, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 90, "kind": "dialogue", "text": "Take it, Detective.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 91, "kind": "dialogue", "text": "Put it down.", "name": "TESSA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 92, "kind": "dialogue", "text": "You wanted the bag. Here's the bag.", "name": "RUTH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 93, "kind": "action", "text": "She lets it go.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 94, "kind": "action", "text": "It hits the floor.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 95, "kind": "action", "text": "The zip splits.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 96, "kind": "action", "text": "Bundles spill, and with them a flat black device the size of a deck of cards, its red light blinking.", "para": 14, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 97, "kind": "action", "text": "Tessa looks at it.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 98, "kind": "action", "text": "Marcus looks at it.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 99, "kind": "action", "text": "Daniel looks at all of them.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 100, "kind": "dialogue", "text": "What is that?", "name": "DANIEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 101, "kind": "action", "text": "A voice crackles from the catwalk, thin and metallic.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 102, "kind": "dialogue", "text": "Quinn, bomb squad says do not touch it!", "name": "SERGEANT BRANDT", "speaker": 6, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 103, "kind": "action", "text": "Nobody answers.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 104, "kind": "action", "text": "The red light blinks faster.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}]}