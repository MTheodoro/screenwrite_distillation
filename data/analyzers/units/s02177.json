{"scene_id": "s02177", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02177.fountain", "heading": "INT. DRAINED MUNICIPAL SWIMMING POOL - NIGHT", "cast": [{"id": 0, "name": "JUNE", "names": ["JUNE"], "gender": "f", "first": 4, "spoke": 8}, {"id": 1, "name": "LEO", "names": ["LEO"], "gender": "f", "first": 5, "spoke": 10}, {"id": 2, "name": "ABERNATHY", "names": ["ABERNATHY", "MRS. ABERNATHY"], "gender": "f", "first": 6, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRAINED MUNICIPAL SWIMMING POOL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A 1950s public pool, empty.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cracked blue tile, leaf litter, a ladder going down into nothing.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "One work light on a tripod throws long shadows across the deep end.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "JUNE (30s, night janitor, headphones around her neck) drags a mop bucket along the pool deck.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her coworker LEO (20s, hoodie, vape) trails behind her with a broom.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "MRS. ABERNATHY (70s, caretaker, key ring at her hip) watches from the office door.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Deep end first. Then the showers.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Why are we doing the deep end? Nobody's swimming.", "name": "LEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Because I said so. Humour an old woman.", "name": "MRS. ABERNATHY", "speaker": 2, "ext": [], "paren": ["to both"], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "She retreats into the office.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "The door clicks shut.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Leo shrugs, takes a drag, and follows June to the ladder.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "They climb down.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Their footsteps echo.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Leo sweeps.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "June mops.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "For a while that's all there is: the scrape, the slosh.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Did you hear that?", "name": "LEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Hear what?", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Nothing. Probably nothing.", "name": "LEO", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "She goes back to the mop.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "He leans his broom against the wall and stares at the drain at the bottom of the deep end, a round black grate the size of a manhole.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "A low gurgle.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Slow.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Wet.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "June stops mopping.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "She turns toward the drain.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Her breath fogs.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Leo?", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "It's the pipes.", "name": "LEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "The pool is empty.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Then it's the pipes behind the pool.", "name": "LEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "She sets down the mop and edges a step closer to the grate.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Leo catches her sleeve.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "She shakes him off.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "She crouches.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Tilts her head.", "para": 7, "sent": 4, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "A whisper rises from the drain, wordless, soft, almost like a child humming.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Okay. Okay okay okay.", "name": "LEO", "speaker": 1, "ext": ["CONT'D"], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Go and get Mrs. Abernathy.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "You come with me.", "name": "LEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Just go!", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "He doesn't move.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "The humming stops.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "The silence is worse.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "June backs away from the grate, step by step, and bumps into Leo.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "They both flinch.", "para": 9, "sent": 4, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Then the grate RATTLES.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Dark water seeps up through the slats and spreads across the dry tile.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Small wet handprints appear on the floor, one after another, walking toward them.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "June screams.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Leo bolts for the ladder, slips on wet tile, scrambles up on all fours.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "June runs after him.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Behind them the prints keep coming, wet and slow.", "para": 11, "sent": 3, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "They burst out onto the deck and stumble into the office.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Mrs. Abernathy sits calmly at her desk, hands folded.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "There's something in the drain!", "name": "LEO", "speaker": 1, "ext": [], "paren": ["gasping"], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "Is there?", "name": "MRS. ABERNATHY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "Call the police! Call someone!", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "Sit down, dear. You're out of breath.", "name": "MRS. ABERNATHY", "speaker": 2, "ext": [], "paren": ["not unkind"], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "She pours water from a pitcher into two paper cups and holds them out.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "June takes hers.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "Leo doesn't.", "para": 13, "sent": 2, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "You knew.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "Everyone knows. It's why we only clean the deep end at night.", "name": "MRS. ABERNATHY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "Then why did you send us down?", "name": "LEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "dialogue", "text": "Because it's hungry when it's lonely. And it likes company.", "name": "MRS. ABERNATHY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "She nods toward the window.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "In the pool below, in the glare of the work light, the wet prints end at the edge of the drain, side by side, as if someone sat there kicking their legs.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "June, trembling, raises a hand toward the glass.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 71, "kind": "action", "text": "She doesn't seem to know she's doing it.", "para": 15, "sent": 1, "present": [0, 1, 2]}, {"u": 72, "kind": "dialogue", "text": "I'm quitting. I'm quitting tomorrow.", "name": "LEO", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 73, "kind": "dialogue", "text": "Of course you are, dear.", "name": "MRS. ABERNATHY", "speaker": 2, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}, {"u": 74, "kind": "action", "text": "The prints fade from the tile.", "para": 16, "sent": 0, "present": [0, 1, 2]}, {"u": 75, "kind": "action", "text": "The work light buzzes.", "para": 16, "sent": 1, "present": [0, 1, 2]}, {"u": 76, "kind": "action", "text": "Then goes out.", "para": 16, "sent": 2, "present": [0, 1, 2]}, {"u": 77, "kind": "action", "text": "Dark.", "para": 17, "sent": 0, "present": [0, 1, 2]}, {"u": 78, "kind": "action", "text": "A long, even silence.", "para": 17, "sent": 1, "present": [0, 1, 2]}, {"u": 79, "kind": "action", "text": "Then, from the drain, very faintly, laughter.", "para": 17, "sent": 2, "present": [0, 1, 2]}, {"u": 80, "kind": "dialogue", "text": "Well. That's the deep end done.", "name": "MRS. ABERNATHY", "speaker": 2, "ext": ["CONT'D"], "paren": ["to all of them"], "dual": false, "present": [0, 1, 2]}]}