{"scene_id": "s02178", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02178.fountain", "heading": "INT. TELEGRAPH OFFICE - DUST CREEK - DAY", "cast": [{"id": 0, "name": "CALEB MARROW", "names": ["CALEB MARROW", "CALEB"], "gender": "m", "first": 4, "spoke": 12}, {"id": 1, "name": "OPAL TREVINO", "names": ["OPAL TREVINO", "OPAL"], "gender": "f", "first": 5, "spoke": 7}, {"id": 2, "name": "WILLIS PRUITT", "names": ["WILLIS PRUITT", "PRUITT"], "gender": "m", "first": 6, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. TELEGRAPH OFFICE - DUST CREEK - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A cramped frontier room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wanted posters, a potbellied stove gone cold, a telegraph key on a scarred desk.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dust in the slanting light.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CALEB MARROW (40s, sheriff, tin star dented, sun-creased eyes) stands at the window with his rifle.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "At the desk, OPAL TREVINO (20s, telegraph operator, ink on her cuffs) taps the key.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "In the corner, tied to a chair, sits WILLIS PRUITT (30s, outlaw, grin, split lip).", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "You can wire all the way to Denver, Sheriff. They won't send help.", "name": "PRUITT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Opal, keep tapping.", "name": "CALEB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "I am. Nobody answers.", "name": "OPAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Told you.", "name": "PRUITT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "You told me nothing, Willis. You talked.", "name": "CALEB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Boots crunch on gravel outside.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Many.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Pruitt turns his head toward the window and raises his voice.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Alive and patient, boys!", "name": "PRUITT", "speaker": 2, "ext": [], "paren": ["calling out"], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Quiet.", "name": "CALEB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Caleb racks the lever on his rifle.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Opal's hand flutters at her throat and she turns back to the key.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "It's not going through. Wire's cut.", "name": "OPAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Then we do it slow.", "name": "CALEB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "You could just let me go. Save the trouble.", "name": "PRUITT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Trouble's already here.", "name": "CALEB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Opal looks up.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Caleb meets her eye.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "A beat of understanding.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Opal. Back door. Take the mule.", "name": "CALEB", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "I'm not leaving you.", "name": "OPAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Ride to Fort Hale. Tell the major.", "name": "CALEB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "That's forty miles.", "name": "PRUITT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Thirty-eight.", "name": "OPAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "It's a poor plan, darlin'.", "name": "PRUITT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "You mind your mouth.", "name": "OPAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "You mind your mouth.", "name": "CALEB", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Even Pruitt grins.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "We say it together now?", "name": "OPAL", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Seems we do.", "name": "CALEB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Opal pulls her shawl tight, tucks a pencil behind her ear, and slips through the back door.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Hinges squeak.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "A mule snorts in the yard.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Don't you die before I'm back, Caleb Marrow!", "name": "OPAL", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Hoofbeats fade.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "She'll be dead by supper.", "name": "PRUITT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Not that one.", "name": "CALEB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "He settles the rifle on the sill.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Outside, the boots stop.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Willis, you still talking?", "name": "CALEB", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Only when it helps.", "name": "PRUITT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Then tell your friends to come in one at a time.", "name": "CALEB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}