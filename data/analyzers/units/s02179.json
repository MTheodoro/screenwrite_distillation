{"scene_id": "s02179", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02179.fountain", "heading": "INT. MUSEUM CLOCKROOM - NIGHT", "cast": [{"id": 0, "name": "NADIA FARRUKH", "names": ["NADIA FARRUKH", "NADIA"], "gender": "f", "first": 4, "spoke": 10}, {"id": 1, "name": "THEO BAPTISTE", "names": ["THEO BAPTISTE", "THEO"], "gender": "?", "first": 5, "spoke": 5}, {"id": 2, "name": "KENJI IWATA", "names": ["KENJI IWATA", "KENJI"], "gender": "?", "first": 6, "spoke": 8}, {"id": 3, "name": "DOT MCALLISTER", "names": ["DOT MCALLISTER", "DOT"], "gender": "f", "first": 7, "spoke": 6}, {"id": 4, "name": "THUNK", "names": ["THUNK"], "gender": "?", "first": 24, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. MUSEUM CLOCKROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Brass gears the size of cartwheels turn behind glass.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A vault door gleams in the corner, unlit.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The crew has been here three hours.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "NADIA FARRUKH (30s, mastermind) sits cross-legged on a bench, a tablet balanced on her knee.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "THEO BAPTISTE (40s, safe man, headphones) listens to the vault.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "KENJI IWATA (20s, climber) hangs upside down from a beam, sandwich in hand.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "DOT MCALLISTER (60s, forger) knits on a stool, needles clicking.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Four more clicks.", "name": "THEO", "speaker": 1, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Take your time.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "You said that an hour ago.", "name": "KENJI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "An hour ago you were still on the roof.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Nobody's bored if they're knitting.", "name": "DOT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "I'm not knitting.", "name": "KENJI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "That's your problem.", "name": "DOT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Theo holds up one finger.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "The room stills.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "A gear grinds.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Another.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Nadia glances at her tablet; a timer reads 02:14.", "para": 2, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Guard changes in two minutes.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Two minutes is nothing.", "name": "KENJI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Two minutes is the whole job.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Shh!", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "A THUNK from inside the vault.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Theo smiles, exhales, and takes off the headphones.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "He reaches for the handle.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Kenji swings down from the beam, drops the sandwich, grabs Nadia's shoulder.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Dot sets her needles down.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Nadia stands, tablet clutched to her chest, as Theo turns the handle and the door hisses open on a velvet-lined case holding a small silver clockwork bird.", "para": 3, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "That's it?", "name": "KENJI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "That's it.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "It's smaller than I thought.", "name": "DOT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "They always are.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Can we go?", "name": "KENJI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Not yet. Dot, the swap.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "I'm doing it.", "name": "DOT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Hurry up, hurry up.", "name": "KENJI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "You're rushing me, boy.", "name": "DOT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "He's not rushing you, he's scared.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "I'm not scared!", "name": "KENJI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Everyone breathe.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Dot lifts the bird with tissue and sets a duplicate in its place.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Her hands, so slow on the needles, are fast now.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Kenji stuffs the real bird into a padded satchel.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Theo pushes the vault shut.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "The timer on Nadia's tablet reads 00:31.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "Go. Go.", "name": "NADIA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Which door?", "name": "KENJI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Roof!", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Roof is blocked!", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "Then stairs!", "name": "DOT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Boots hit the corridor.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "A roving flashlight beam swings across the clockroom glass.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "Kenji drops flat.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Theo pulls Dot behind a gear housing.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Nadia kills the tablet and the room is black.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "The beam lingers on the dropped sandwich.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Footsteps pause outside.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "Nobody breathes.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "Nadia's voice, very quiet, from nowhere.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "Now.", "name": "NADIA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "The beam moves on.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "Kenji springs for the service stairs.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "Theo and Dot bolt after him.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "Nadia follows, the bird bouncing in the satchel.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "The gears keep turning.", "para": 8, "sent": 4, "present": [0, 1, 2, 3, 4]}]}