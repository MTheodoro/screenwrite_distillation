{"scene_id": "s02180", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02180.fountain", "heading": "INT. NIGHT FERRY - CAR DECK - NIGHT", "cast": [{"id": 0, "name": "PETRA SOKOLOV", "names": ["PETRA SOKOLOV", "PETRA"], "gender": "f", "first": 5, "spoke": 18}, {"id": 1, "name": "COURIER", "names": ["COURIER"], "gender": "m", "first": 6, "spoke": 9}, {"id": 2, "name": "DEE", "names": ["DEE"], "gender": "m", "first": 7, "spoke": 10}, {"id": 3, "name": "KARIMI", "names": ["KARIMI"], "gender": "?", "first": 7, "spoke": 0}, {"id": 4, "name": "SILAS", "names": ["SILAS"], "gender": "?", "first": 35, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT FERRY - CAR DECK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Rows of idling vans and trucks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rain drumming on the steel hull.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A panel truck marked \"ST. EMERIC FLORIST\" sits near the stern.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Its back doors are open.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "PETRA SOKOLOV (40s, crew boss, fisherman's sweater) sits on the bumper counting a cashier's envelope.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A man in a delivery uniform leans on the truck beside her: THE COURIER (30s, calm, wet hair).", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "DESHAWN \"DEE\" KARIMI (20s, hacker, laptop on a milk crate) crouches beside them.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "We got half.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "That's all there was.", "name": "COURIER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "You told us twice that.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Because I was told twice that.", "name": "COURIER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "The vault logs show a full transfer.", "name": "DEE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "The vault logs show what the vault wanted you to see.", "name": "COURIER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Who told you that?", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "A man named Hendricks.", "name": "COURIER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Hendricks is dead.", "name": "DEE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Then he lied last.", "name": "COURIER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "We didn't kill Hendricks.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Nobody said we did.", "name": "DEE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Somebody did.", "name": "COURIER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Dee, close the laptop.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "I'm trying to trace the other half.", "name": "DEE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Close it.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Dee shuts it slowly.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "The ferry horn sounds, low and long.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "So let me say this plainly. You knew the take was half before we boarded.", "name": "PETRA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "I suspected.", "name": "COURIER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "You suspected, and you let us board.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "You'd have boarded anyway.", "name": "COURIER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "We would have.", "name": "DEE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Don't help him.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "I'm just being honest.", "name": "DEE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Be honest quieter.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "What do we call you, anyway?", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Silas.", "name": "COURIER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "I'll give you what I have. Fifty thousand. In the glove box.", "name": "SILAS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "That's a tip.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "It's what's left.", "name": "SILAS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Petra, take it. We get off at Lindqvist Pier in ten minutes.", "name": "DEE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "We're not taking it.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Why not?", "name": "DEE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Because I'm done being the one who takes less.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Then you take nothing.", "name": "SILAS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Then I take nothing. But you walk off first.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "I walk off alone.", "name": "SILAS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "You walk off alone.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "The ferry horn again.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Rain on steel.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "The Courier nods, pulls his collar up, and steps out into the dark of the car deck.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Dee stares after him.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Petra stuffs the envelope into her sweater.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "Was that smart?", "name": "DEE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "No.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "Okay.", "name": "DEE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "It was right.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}