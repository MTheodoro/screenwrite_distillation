{"scene_id": "s02181", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02181.fountain", "heading": "INT. CORAL-FARM SUBMERSIBLE - MAINTENANCE BAY - NIGHT", "cast": [{"id": 0, "name": "ILSA VANTERPOOL", "names": ["ILSA VANTERPOOL", "ILSA"], "gender": "f", "first": 4, "spoke": 10}, {"id": 1, "name": "KESTREL", "names": ["KESTREL"], "gender": "m", "first": 12, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. CORAL-FARM SUBMERSIBLE - MAINTENANCE BAY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped steel room lit by blue emergency strips.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Pipes sweat.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Through a thick porthole, a school of luminous fish drifts past.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ILSA VANTERPOOL (40s, chief technician, grease on her forearms) kneels at an open floor panel, welding a coolant line.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "A radio hisses at her hip.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "She works with the patience of someone who has done this a thousand times.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "Behind her, the hatch wheel TURNS.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Slowly.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "Ilsa freezes, torch still lit.", "para": 2, "sent": 2, "present": [0]}, {"u": 10, "kind": "action", "text": "The hatch swings open.", "para": 3, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "A figure ducks through, dripping.", "para": 3, "sent": 1, "present": [0]}, {"u": 12, "kind": "action", "text": "This is KESTREL (30s, drifter, ragged survival suit, a shock baton at his belt).", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He closes the hatch behind him and looks at her.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "You're not on the manifest.", "name": "ILSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Neither is half this boat.", "name": "KESTREL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "How did you get through the lock?", "name": "ILSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Same way you'd leave. Carefully.", "name": "KESTREL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Ilsa shuts off the torch.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Sets it down.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Stands, slowly, wiping her hands on her thighs.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "He watches the movement.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "She watches his baton.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Captain doesn't allow guests.", "name": "ILSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Captain's asleep.", "name": "KESTREL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Captain doesn't sleep.", "name": "ILSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Then he's dead. Take your pick.", "name": "KESTREL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "She lunges for the radio.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "He crosses the bay in two steps and grabs her wrist.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "They struggle, knocking a toolbox off the wall, spanners clattering.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "She drives an elbow into his ribs.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "He grunts, twists, slams her against the pipe.", "para": 5, "sent": 4, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Both of them freeze, breathing hard, faces inches apart.", "para": 5, "sent": 5, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Let go.", "name": "ILSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Only if you stay quiet.", "name": "KESTREL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "I won't.", "name": "ILSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Then I won't let go.", "name": "KESTREL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "The pipe behind her starts to HISS.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "A thin jet of steam.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Both of them stare at it.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Then at each other.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "The coolant line she was welding is failing.", "para": 6, "sent": 4, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "That's the main feed.", "name": "ILSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Fix it.", "name": "KESTREL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Let me go and I will.", "name": "ILSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "He hesitates.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "The steam thickens.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "The fish outside scatter.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "He lets go.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "She drops to her knees and grabs the torch, and he crouches beside her, holding the pipe steady with his bare gloves, wincing at the heat.", "para": 7, "sent": 4, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Hold it. Tighter.", "name": "ILSA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "It's burning.", "name": "KESTREL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Then burn.", "name": "ILSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "The torch flares.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "The weld glows.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "The hiss dies.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "They look at each other, soaked, shaking, and neither moves away.", "para": 8, "sent": 3, "present": [0, 1]}]}