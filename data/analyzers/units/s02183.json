{"scene_id": "s02183", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02183.fountain", "heading": "INT. NEONATAL ICU - NURSES' STATION - 3 A.M.", "cast": [{"id": 0, "name": "ELOISE FAURE", "names": ["ELOISE FAURE", "FAURE"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "NURSE DESMOND ACHEBE", "names": ["NURSE DESMOND ACHEBE", "ACHEBE"], "gender": "m", "first": 5, "spoke": 2}, {"id": 2, "name": "NURSE LUPE TALAKAI", "names": ["NURSE LUPE TALAKAI", "TALAKAI"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "ANIKA VERMA", "names": ["ANIKA VERMA", "VERMA"], "gender": "?", "first": 7, "spoke": 1}, {"id": 4, "name": "RESPIRATORY THERAPIST BO LINDGREN", "names": ["RESPIRATORY THERAPIST BO LINDGREN", "LINDGREN"], "gender": "?", "first": 8, "spoke": 1}, {"id": 5, "name": "CHAPLAIN MIRIAM GOLD", "names": ["CHAPLAIN MIRIAM GOLD", "GOLD"], "gender": "?", "first": 9, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. NEONATAL ICU - NURSES' STATION - 3 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "Soft monitors.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A mug of cold tea.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Six people around a whiteboard.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. ELOISE FAURE (50s, attending) caps a marker.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "NURSE DESMOND ACHEBE (30s) sips his coffee.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "NURSE LUPE TALAKAI (40s) scrolls a chart.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "DR. ANIKA VERMA (30s, resident) hugs a clipboard.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "RESPIRATORY THERAPIST BO LINDGREN (20s) leans on the counter.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "CHAPLAIN MIRIAM GOLD (60s) sits quietly in the corner.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Okay. Bed six stabilised, bed nine's weaning, bed eleven is the one I'm watching.", "name": "FAURE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Eleven's sats have been drifting.", "name": "ACHEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Ninety-one, ninety, ninety-one.", "name": "TALAKAI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "That's within range.", "name": "VERMA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "It's within range for a healthy infant. Not for this one.", "name": "FAURE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "I can bump the flow.", "name": "LINDGREN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Do it. Slowly.", "name": "FAURE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "The parents asked if they could come in.", "name": "GOLD", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "At four. If nothing changes.", "name": "FAURE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "They're afraid it will.", "name": "GOLD", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "So am I.", "name": "FAURE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "A pause.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "The monitors keep their quiet rhythm.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Everything looks calm.", "name": "ACHEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "That's what scares me.", "name": "TALAKAI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Behind them, a single alarm begins to sound.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Soft, then not.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Bed eleven.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}