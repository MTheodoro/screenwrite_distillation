{"scene_id": "s02185", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02185.fountain", "heading": "INT. FENCING SALLE - BASEMENT OF AN OLD OPERA HOUSE - NIGHT", "cast": [{"id": 0, "name": "ASTRID NORDQUIST", "names": ["ASTRID NORDQUIST", "ASTRID"], "gender": "?", "first": 3, "spoke": 4}, {"id": 1, "name": "OLIVER BANGURA", "names": ["OLIVER BANGURA", "OLIVER"], "gender": "?", "first": 14, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. FENCING SALLE - BASEMENT OF AN OLD OPERA HOUSE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Chandelier dust, mirrored walls, a piste of grey tape on parquet.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "One bare bulb.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "ASTRID NORDQUIST (30s, veteran, scarred forearm) fences a padded dummy with grim precision.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "Lunge, recover, lunge.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "action", "text": "Her reflection lunges with her.", "para": 1, "sent": 2, "present": [0]}, {"u": 6, "kind": "action", "text": "Sweat darkens her whites.", "para": 1, "sent": 3, "present": [0]}, {"u": 7, "kind": "action", "text": "A cracked wall clock reads midnight.", "para": 1, "sent": 4, "present": [0]}, {"u": 8, "kind": "action", "text": "She stops.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Lowers the blade.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "Studies her wrist, which trembles, and presses it flat against her thigh until it quiets.", "para": 2, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "On the stair, a door opens.", "para": 3, "sent": 0, "present": [0]}, {"u": 12, "kind": "action", "text": "Footsteps.", "para": 3, "sent": 1, "present": [0]}, {"u": 13, "kind": "action", "text": "A young man in a hooded coat descends, glove bag over one shoulder.", "para": 3, "sent": 2, "present": [0]}, {"u": 14, "kind": "action", "text": "This is OLIVER BANGURA (20s, upstart, shoulders too square).", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "He stops at the foot of the stairs.", "para": 3, "sent": 4, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "They said you'd be here.", "name": "OLIVER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "They said wrong.", "name": "ASTRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "You're holding a sword.", "name": "OLIVER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She flicks the blade at the spare rack.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "He unzips his bag, pulls out a mask, and takes a foil.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "They salute.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "The blades touch.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She wins the first touch cleanly.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "He loses the second to a feint he should have read.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "The third is his: a low riposte she cannot answer.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "She laughs once, short, and shakes out her wrist.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Who taught you that?", "name": "ASTRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "You did.", "name": "OLIVER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "I taught you nothing.", "name": "ASTRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "You taught me by losing to me.", "name": "OLIVER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "She stares at him.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Then she takes off her mask, throws it across the room, and the mirrors shiver.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "He doesn't flinch.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "She steps in close.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Again.", "name": "ASTRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}