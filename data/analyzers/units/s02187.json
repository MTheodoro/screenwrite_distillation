{"scene_id": "s02187", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02187.fountain", "heading": "INT. COUNTRY MANOR - SMALL LIBRARY - EVENING", "cast": [{"id": 0, "name": "LORD EDMUND HALLORAN", "names": ["LORD EDMUND HALLORAN", "LORD EDMUND"], "gender": "?", "first": 6, "spoke": 9}, {"id": 1, "name": "LADY CATHERINE", "names": ["LADY CATHERINE"], "gender": "?", "first": 7, "spoke": 4}, {"id": 2, "name": "CAPTAIN JULIAN ASHBY", "names": ["CAPTAIN JULIAN ASHBY", "ASHBY"], "gender": "m", "first": 28, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. COUNTRY MANOR - SMALL LIBRARY - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "1815.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Candlelight.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Walnut shelves.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A fire in a marble grate.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A chessboard stands mid-game on a table between two armchairs.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "LORD EDMUND HALLORAN (50s, immaculate, gout-stiffened) sits with a glass of port, one leg propped on a stool.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Opposite him, his daughter LADY CATHERINE (20s, plain gown, unreadable) studies the board.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Neither has spoken in some time.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "She moves a bishop.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He looks at it.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He moves a pawn.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She smiles, almost, and shakes her head.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "You have taken a long time to learn this game.", "name": "LORD EDMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "I had a patient teacher.", "name": "LADY CATHERINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I was not patient.", "name": "LORD EDMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "No. But you were thorough.", "name": "LADY CATHERINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He sips.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She reaches for a knight and holds it, not placing it.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Your mother would not have approved of the match.", "name": "LORD EDMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Mother would not have approved of me playing at all.", "name": "LADY CATHERINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "True.", "name": "LORD EDMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "She sets the knight down.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "He studies it for a long time.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "The fire pops.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "A clock ticks somewhere in the dark.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "The door opens quietly.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "A tall young man in a mud-spattered riding coat steps in, hat in his hand.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "This is CAPTAIN JULIAN ASHBY (20s, officer, tired eyes, a faint limp).", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "He waits at the threshold.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Captain.", "name": "LORD EDMUND", "speaker": 0, "ext": ["CONT'D"], "paren": ["without turning"], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "My lord. Lady Catherine.", "name": "ASHBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "She does not look up.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Her hand tightens on a pawn until her knuckles pale.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "You were expected a week ago.", "name": "LORD EDMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "The roads were washed out, my lord. And there was a delay.", "name": "ASHBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "A delay.", "name": "LORD EDMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "At Waterloo.", "name": "ASHBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "The old man sets down his glass.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "It clinks on the board, and a rook topples.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Catherine catches it before it rolls off the table.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Sit.", "name": "LORD EDMUND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Ashby crosses the room, wincing, and lowers himself onto a stool.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Catherine places the rook back on its square.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Her hand is perfectly steady.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Her eyes are not.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Check, I think.", "name": "LADY CATHERINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "So it is.", "name": "LORD EDMUND", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}]}