{"scene_id": "s02188", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02188.fountain", "heading": "INT. HOSPITAL LAUNDRY ROOM - 4 A.M.", "cast": [{"id": 0, "name": "NURSE AGNES BRIGHTWATER", "names": ["NURSE AGNES BRIGHTWATER", "AGNES"], "gender": "f", "first": 4, "spoke": 6}, {"id": 1, "name": "SAMIR HADDAD", "names": ["SAMIR HADDAD", "SAMIR"], "gender": "m", "first": 5, "spoke": 4}, {"id": 2, "name": "ORDERLY CHEN WEI", "names": ["ORDERLY CHEN WEI", "CHEN WEI"], "gender": "f", "first": 6, "spoke": 2}, {"id": 3, "name": "VISITOR", "names": ["VISITOR"], "gender": "f", "first": 9, "spoke": 3}, {"id": 4, "name": "DOLORES", "names": ["DOLORES"], "gender": "?", "first": 20, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOSPITAL LAUNDRY ROOM - 4 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "Steam.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rolling carts of folded scrubs.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A row of industrial dryers thumping like slow hearts.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "NURSE AGNES BRIGHTWATER (40s, braids pinned under a cap) leans on a cart, eyes closed, fanning herself with a chart.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "DR. SAMIR HADDAD (30s, resident, rumpled) sits on the floor with his back to a dryer, a granola bar in each hand.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "ORDERLY CHEN WEI (50s, thick glasses) folds towels with machine speed.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "A figure stands in the doorway, uncertain.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "A slight woman in a visitor's lanyard, clutching a plastic bag of knitting.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "This is the VISITOR (60s).", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Excuse me. I'm looking for the cafeteria.", "name": "VISITOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Wrong floor, hon.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "They sent me down.", "name": "VISITOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "They send everyone down. It's the only warm room.", "name": "SAMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "The Visitor steps in.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Agnes gestures to a stool.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "The Visitor sits, rummages in her bag, pulls out a half-finished scarf, and begins knitting.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Chen Wei folds a towel, glances at her, folds another.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Samir unwraps a granola bar and chews.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Agnes closes her eyes again.", "para": 3, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "I'm Dolores, by the way.", "name": "VISITOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Agnes.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Samir.", "name": "SAMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Chen.", "name": "CHEN WEI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Pleased to meet you all. I'm visiting my husband. Third floor. He had a stroke.", "name": "DOLORES", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "I'm sorry.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Oh, he's stubborn. He'll be fine. He'll be furious about the hospital food.", "name": "DOLORES", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Everyone is.", "name": "SAMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Do you have a husband, Agnes?", "name": "DOLORES", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Eighteen years.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "That's a long time.", "name": "DOLORES", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "It's about right.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Chen Wei sets down a stack of towels, sits on a cart, and watches Dolores's needles click.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "The dryers thump.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Samir takes a second bite.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Would any of you like a scarf? I make them for the ward.", "name": "DOLORES", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "I'll take one.", "name": "SAMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Green.", "name": "CHEN WEI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Green it is.", "name": "DOLORES", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "I'll take whichever one he doesn't.", "name": "AGNES", "speaker": 0, "ext": [], "paren": ["eyes still closed"], "dual": false, "present": [0, 1, 2, 3, 4]}]}