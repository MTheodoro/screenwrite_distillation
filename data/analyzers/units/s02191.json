{"scene_id": "s02191", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02191.fountain", "heading": "INT. NIGHT-MARKET NOODLE STALL - TAIPEI - NIGHT", "cast": [{"id": 0, "name": "MEI-LING CHANG", "names": ["MEI-LING CHANG", "MEI-LING"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "UNCLE BAO", "names": ["UNCLE BAO"], "gender": "?", "first": 5, "spoke": 1}, {"id": 2, "name": "WOMAN IN A RAINCOAT", "names": ["WOMAN", "WOMAN IN A RAINCOAT"], "gender": "?", "first": 6, "spoke": 6}, {"id": 3, "name": "RAINCOAT", "names": ["RAINCOAT"], "gender": "?", "first": 6, "spoke": 0}, {"id": 4, "name": "JAMES OKAFOR-LEE", "names": ["JAMES OKAFOR-LEE", "JAMES"], "gender": "m", "first": 6, "spoke": 6}, {"id": 5, "name": "DELIVERY RIDER", "names": ["DELIVERY RIDER"], "gender": "?", "first": 6, "spoke": 2}, {"id": 6, "name": "ANNELIESE", "names": ["ANNELIESE"], "gender": "?", "first": 29, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT-MARKET NOODLE STALL - TAIPEI - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Steam, neon, rain on the awning.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Plastic stools.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A hot wok roars behind a counter.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MEI-LING CHANG (30s, vendor, hair under a net) tosses noodles.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her uncle UNCLE BAO (60s, apron, radio) works the till and hums.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Three customers share a table: a tall WOMAN IN A RAINCOAT (30s, tourist, damp map) alone on one stool, JAMES OKAFOR-LEE (30s, locally raised, camera bag) beside her, and a half-asleep DELIVERY RIDER (20s, helmet on the table).", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 7, "kind": "action", "text": "Nobody speaks.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "action", "text": "Then:", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "Excuse me. Is this the line for the beef?", "name": "WOMAN IN A RAINCOAT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "There is no line. Sit.", "name": "MEI-LING", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "I am sitting.", "name": "WOMAN IN A RAINCOAT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Two beef, please. And whatever she's having.", "name": "JAMES", "speaker": 4, "ext": [], "paren": ["to Mei-Ling"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "I didn't ask you to order for me.", "name": "WOMAN IN A RAINCOAT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "No. I just thought. Sorry.", "name": "JAMES", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Beef! Beef! Bring beef!", "name": "UNCLE BAO", "speaker": 1, "ext": [], "paren": ["over the radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "I heard you.", "name": "MEI-LING", "speaker": 0, "ext": [], "paren": ["to Uncle Bao"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Mei-Ling slides two bowls across the counter.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "The Woman in a Raincoat takes one, smells it, closes her eyes.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "James takes the other and burns his tongue.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Idiot.", "name": "JAMES", "speaker": 4, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "You okay?", "name": "WOMAN IN A RAINCOAT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "It's hot.", "name": "JAMES", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "It's soup.", "name": "WOMAN IN A RAINCOAT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Is the rain stopping?", "name": "DELIVERY RIDER", "speaker": 5, "ext": [], "paren": ["waking"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "No.", "name": "MEI-LING", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Then I'll have another.", "name": "DELIVERY RIDER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Uncle Bao laughs.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "The Woman in a Raincoat looks at James, holds out a hand.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "I'm Anneliese.", "name": "WOMAN IN A RAINCOAT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "Anneliese Brandt. From Hamburg.", "name": "ANNELIESE", "speaker": 6, "ext": [], "paren": ["correcting herself"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "James. From here.", "name": "JAMES", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "Everyone says that about here.", "name": "ANNELIESE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "It's true.", "name": "JAMES", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "She laughs.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "Mei-Ling catches Uncle Bao's eye.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "He winks, turns the radio up, and some old love song fills the stall.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "This is the best noodle I have ever had.", "name": "ANNELIESE", "speaker": 6, "ext": [], "paren": ["to everyone"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "dialogue", "text": "Ever?", "name": "MEI-LING", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "Ever.", "name": "ANNELIESE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "Mei-Ling doesn't smile.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "She slides a second plate of pickled greens across, free, and goes back to her wok.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}]}