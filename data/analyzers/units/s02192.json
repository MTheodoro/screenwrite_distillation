{"scene_id": "s02192", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02192.fountain", "heading": "EXT. ABANDONED DRIVE-IN THEATER - SALT FLATS - DUSK", "cast": [{"id": 0, "name": "MARGO", "names": ["MARGO"], "gender": "f", "first": 5, "spoke": 10}, {"id": 1, "name": "DUFRESNE", "names": ["DUFRESNE"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "SAUL ABERCROMBIE", "names": ["SAUL ABERCROMBIE", "SAUL"], "gender": "m", "first": 6, "spoke": 6}, {"id": 3, "name": "JO", "names": ["JO"], "gender": "f", "first": 7, "spoke": 8}, {"id": 4, "name": "TUIASOSOPO", "names": ["TUIASOSOPO"], "gender": "?", "first": 7, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ABANDONED DRIVE-IN THEATER - SALT FLATS - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "A towering concrete screen, bleached by sun, tilts above rows of dead speaker posts.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wind carries white grit across the lot.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "In the centre, a battered boxing ring has been assembled from scaffolding and tarp, ropes tied with fishing line.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Three people stand in it.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "MARGUERITE \"MARGO\" DUFRESNE (50s, ex-champion, the shoulders of a woman who once could lift a house) wraps tape around her knuckles.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Her trainer, SAUL ABERCROMBIE (70s, hearing aid, lawn chair, stopwatch around his neck), sits ringside.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "And her young challenger, JOSEFA \"JO\" TUIASOSOPO (20s, rangy, bruised eyebrow, borrowed gloves) shadowboxes in the corner, quick and angry.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "The sun lowers behind the screen.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "Shadows stretch.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Last round.", "name": "SAUL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "It's the third.", "name": "MARGO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "You said twelve.", "name": "SAUL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "I said three if the girl kept up.", "name": "MARGO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Jo spits into a bucket.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "I'm keeping up.", "name": "JO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "So far.", "name": "MARGO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Saul clicks the stopwatch.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Margo steps forward.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Jo meets her at the centre.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "The bell is a hubcap hit with a wrench.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "They circle.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Margo is slow, deliberate.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Jo throws a jab.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Margo slips it, taps her ribs.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Jo grunts, throws a hook, misses.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Margo pivots and lands a short right.", "para": 6, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Jo drops to one knee, shakes her head, rises.", "para": 6, "sent": 6, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Seven seconds.", "name": "SAUL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "I know.", "name": "JO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "You're dropping your left.", "name": "MARGO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "I'm not.", "name": "JO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "You are.", "name": "MARGO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Jo drives forward in a flurry.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Margo takes two shots on the gloves, one on the shoulder, catches the third and clinches.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "They stagger across the ring, locked, panting.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Wind whips grit across the tarp.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Saul stands, hand on his hearing aid.", "para": 7, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Break! Break!", "name": "SAUL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "They break.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Margo wipes sweat.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Jo's eye is swelling.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Why are you doing this?", "name": "JO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Because someone should.", "name": "MARGO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "You could have stopped ten years ago.", "name": "JO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "I did stop ten years ago.", "name": "MARGO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Then why come back for me?", "name": "JO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Margo does not answer.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "She lifts her gloves.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Jo, after a hesitation, does the same.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "They touch gloves and step apart.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "The sun slips behind the screen.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "For a moment the concrete glows orange, a vast empty rectangle.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Then the light drops, and the lot goes blue.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "That's the bell.", "name": "SAUL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "Sun's still up.", "name": "MARGO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Sun's down. I looked.", "name": "SAUL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "He drops the stopwatch around his neck, eases back into the lawn chair, and takes his hearing aid out.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "In the ring, Margo and Jo stand with arms at their sides.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "Round four?", "name": "JO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "Tomorrow. Come at dawn.", "name": "MARGO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "I'll be here.", "name": "JO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "dialogue", "text": "I know you will.", "name": "MARGO", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "Jo ducks through the ropes and jogs across the lot, her silhouette small against the screen.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "Margo watches her go.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "She unwinds the tape slowly from one hand.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "Saul says nothing.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "action", "text": "He lights a cigarette and offers her one.", "para": 12, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "action", "text": "She takes it.", "para": 12, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "They sit, side by side, in the cooling dark.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}]}