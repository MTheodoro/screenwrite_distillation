{"scene_id": "s02193", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02193.fountain", "heading": "EXT. SPLIT CEDAR RAFT - FLOODED VALLEY - DAY", "cast": [{"id": 0, "name": "LEN", "names": ["LEN"], "gender": "?", "first": 4, "spoke": 10}, {"id": 1, "name": "HARGROVE", "names": ["HARGROVE"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "DEZ", "names": ["DEZ"], "gender": "m", "first": 5, "spoke": 9}, {"id": 3, "name": "ABARA", "names": ["ABARA"], "gender": "?", "first": 5, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SPLIT CEDAR RAFT - FLOODED VALLEY - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A river has swallowed a valley.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rooftops poke from the brown water like islands.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A raft of lashed cedar logs turns in a slow eddy.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LEONARD \"LEN\" HARGROVE (60s, retired schoolteacher, ripped coat) lies on his back.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "DESMOND \"DEZ\" ABARA (30s, lean, shirtless, bleeding from the scalp) kneels and paddles with a broken oar.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "dialogue", "text": "Dez. You paddle like a man drowning.", "name": "LEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "I am drowning, Len.", "name": "DEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "No. You're sitting down. There's a difference.", "name": "LEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "He pushes himself upright, winces, and takes the oar.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Dez lets him.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "He watches the roofs drift by.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "That one's the Bellamy place. I taught their boy.", "name": "LEN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "He was in your class?", "name": "DEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Sixth grade. He ate glue.", "name": "LEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Dez laughs.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "It turns into coughing.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "He spits red.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Len puts the oar down.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "I'm fine.", "name": "DEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "You're not fine. You're bleeding.", "name": "LEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "I got hit by a log. He knocked me out earlier. I'll live.", "name": "DEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Don't say that. You'll jinx it.", "name": "LEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "He tears a strip off his coat and presses it to Dez's scalp.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Dez flinches, then lets him.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "For a moment, neither speaks.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "A shape in the water: an upturned boat, half-sunk, drifting toward them.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Len points.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Dez grabs the oar and paddles hard.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "He reaches the hull, grabs it, and hauls it against the raft.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "He peers underneath.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Nothing.", "para": 5, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Then a hand slaps weakly on the wood.", "para": 5, "sent": 6, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Somebody's under there!", "name": "DEZ", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Don't open it. It'll sink.", "name": "LEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Len, help me!", "name": "DEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Len hesitates.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Then he drops to his knees and heaves with him.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "The boat tilts.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "A woman's face, blue-lipped, gasps in the air pocket beneath.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Dez reaches in and hauls her out.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "He lays her on the raft.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "She coughs water.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "He rolls her onto her side, and she retches.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Len stares at her, then at Dez, then at the boat, which drifts away and slowly disappears.", "para": 7, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "She's alive.", "name": "LEN", "speaker": 0, "ext": ["CONT'D"], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Yeah.", "name": "DEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "He was right under us.", "name": "LEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "She.", "name": "DEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Sorry?", "name": "LEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "It's a she.", "name": "DEZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Len laughs, a thin, cracked sound.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "The woman on the raft opens her eyes.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}]}