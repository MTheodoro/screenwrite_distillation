{"scene_id": "s02194", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02194.fountain", "heading": "INT. OFFICE - BREAK ROOM - MORNING", "cast": [{"id": 0, "name": "GERALDINE PRUITT-BELL", "names": ["GERALDINE PRUITT-BELL", "GERALDINE"], "gender": "f", "first": 3, "spoke": 6}, {"id": 1, "name": "MILTON", "names": ["MILTON"], "gender": "f", "first": 5, "spoke": 3}, {"id": 2, "name": "HARPER", "names": ["HARPER"], "gender": "?", "first": 6, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. OFFICE - BREAK ROOM - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent hum.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A vending machine, a motivational poster of a rowing team, a sad ficus in a fake-wood planter.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "GERALDINE PRUITT-BELL (50s, regional director, pearls) sits at the head of the table, an agenda in front of her.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "She sips from a mug that reads WORLD'S OKAYEST BOSS.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "action", "text": "MILTON (30s, junior analyst, lanyard) enters with a pastry on a napkin and does not know where to look.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "HARPER (20s, intern, notebook) sits very still and writes down everything.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "She taps her pen on the agenda.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "He sets the pastry on the table.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "She slides it back an inch.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "He slides it forward an inch.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "She sighs.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Milton, we are here to discuss synergy.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "I thought we were here for the cake.", "name": "MILTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "There is no cake.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "There is a pastry.", "name": "MILTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "That is not cake.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Harper writes this down.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Milton glances at her notebook.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "She tilts it away.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Should I put \"pastry\" in the minutes?", "name": "HARPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Put \"synergy.\"", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Okay.", "name": "HARPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "She writes.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "He eats the pastry.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Geraldine closes her eyes and breathes in through her nose, counts to five, and opens them.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "We will now circle back.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "To what?", "name": "MILTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "To the thing we were circling.", "name": "GERALDINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "He nods wisely.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Harper nods too.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Nobody has any idea what they are circling.", "para": 5, "sent": 2, "present": [0, 1, 2]}]}