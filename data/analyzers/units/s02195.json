{"scene_id": "s02195", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02195.fountain", "heading": "INT. GRAND HOTEL - SERVICE CORRIDOR - NIGHT", "cast": [{"id": 0, "name": "ROSALIE VANCE", "names": ["ROSALIE VANCE", "ROSALIE"], "gender": "?", "first": 4, "spoke": 12}, {"id": 1, "name": "STAFF ONLY", "names": ["STAFF ONLY"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "DEVLIN OKONJO", "names": ["DEVLIN OKONJO", "DEVLIN"], "gender": "m", "first": 9, "spoke": 4}, {"id": 3, "name": "USB", "names": ["USB"], "gender": "?", "first": 14, "spoke": 0}, {"id": 4, "name": "MANAGER", "names": ["MANAGER"], "gender": "?", "first": 27, "spoke": 4}, {"id": 5, "name": "HECTOR PRIETO", "names": ["HECTOR PRIETO", "HECTOR"], "gender": "?", "first": 31, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRAND HOTEL - SERVICE CORRIDOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cream wallpaper, a trolley of silver domes, a flickering exit sign.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The corridor smells of lilies and floor wax.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A woman in a maid's uniform, thick glasses, pushes a linen cart.", "para": 1, "sent": 0, "present": []}, {"u": 4, "kind": "action", "text": "This is ROSALIE VANCE (40s, the inside woman).", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "action", "text": "She stops at a door marked STAFF ONLY, glances both ways, and slips a keycard from her sleeve.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "She taps in.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Opens.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Behind her, a man in a bellboy cap steps out of an alcove.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "This is DEVLIN OKONJO (30s, wiry, quick hands).", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "He tips the cap, nods once, and slides in beside her.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Inside, a wall of monitors.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "A security desk, empty.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "A paper cup of tea steams on the counter.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "She pulls a USB stick from her bra.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "He plugs it into the terminal.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "The screens stutter, loop, and settle into a calm still of the lobby.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Eleven minutes.", "name": "ROSALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "I need ten.", "name": "DEVLIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "You said eight.", "name": "ROSALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "He said eight. I said ten.", "name": "DEVLIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "A phone on the desk rings.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Both freeze.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "They stare at it.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "It rings again.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "She reaches out, hesitates, picks up.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Security.", "name": "ROSALIE", "speaker": 0, "ext": [], "paren": ["into phone, bright"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Rosalie? Why are you in the monitor room?", "name": "MANAGER", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Cleaning, sir.", "name": "ROSALIE", "speaker": 0, "ext": [], "paren": ["a beat"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "At this hour?", "name": "MANAGER", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Sir, the carpet. There was a spill. I am almost finished.", "name": "ROSALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Where's Hector?", "name": "MANAGER", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Hector went to the restroom, sir.", "name": "ROSALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Tell him to call me.", "name": "MANAGER", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Of course.", "name": "ROSALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "She hangs up.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Devlin mimes wiping his brow.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "She smacks his arm.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "He stifles a laugh.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "On the screen, the vault door in the basement glows with a green LED.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Devlin leans in and types.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "That's the lock.", "name": "DEVLIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Don't touch it yet.", "name": "ROSALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "Why not?", "name": "DEVLIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Because someone's coming.", "name": "ROSALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Footsteps in the corridor, brisk and heavy.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "They scramble.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "She shoves the cart against the door.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "He ducks under the desk.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "She grabs a rag and kneels, scrubbing the carpet, as the handle turns and a heavy shape fills the doorway: HECTOR PRIETO (50s, security guard, toothpick in his mouth).", "para": 8, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "Rosalie? What are you doing in here?", "name": "HECTOR", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "Cleaning, Hector.", "name": "ROSALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "At this hour?", "name": "HECTOR", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "There was a spill.", "name": "ROSALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "He looks at the monitors.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "The lobby, frozen.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "He looks at her.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "At the cart.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "At the desk.", "para": 9, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "Where's the tea?", "name": "HECTOR", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "What tea?", "name": "ROSALIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "He points at the counter.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "The cup is gone.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "Under the desk, a gloved hand slowly lowers it to the floor.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "Hector turns slowly.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "Rosalie stands.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "action", "text": "They stare at each other, two people who know exactly what they know, and neither says it.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}