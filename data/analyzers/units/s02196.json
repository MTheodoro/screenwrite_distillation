{"scene_id": "s02196", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02196.fountain", "heading": "INT. VICTORIAN CONSERVATORY - MORNING", "cast": [{"id": 0, "name": "INSPECTOR HALVERSON", "names": ["INSPECTOR HALVERSON", "HALVERSON"], "gender": "m", "first": 5, "spoke": 8}, {"id": 1, "name": "SERGEANT OKAFOR", "names": ["SERGEANT OKAFOR", "OKAFOR"], "gender": "?", "first": 6, "spoke": 2}, {"id": 2, "name": "MISS CORDELIA FITCH", "names": ["MISS CORDELIA FITCH", "MISS FITCH"], "gender": "?", "first": 7, "spoke": 5}, {"id": 3, "name": "ASHWORTH BOTANIST", "names": ["ASHWORTH BOTANIST", "MR. ASHWORTH"], "gender": "?", "first": 7, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. VICTORIAN CONSERVATORY - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Glass and iron.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Ferns, orchids, a dripping fountain.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A body in a gardener's apron lies under a toppled palm in a spreading pool of water.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Fresh footprints cross the tile.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "INSPECTOR HALVERSON (50s, rumpled tweed) crouches by the corpse.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Beside him, SERGEANT OKAFOR (30s, notebook, damp umbrella) stands guard.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "In wicker chairs near the door sit MISS CORDELIA FITCH (60s, the owner, pearls and a cane) and MR. ASHWORTH THE BOTANIST (50s, glasses, ink-stained cuffs).", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Who found him?", "name": "HALVERSON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "I did. I came for my tea.", "name": "MISS FITCH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "She screamed. I came running.", "name": "MR. ASHWORTH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Did either of you touch him?", "name": "HALVERSON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Certainly not.", "name": "MISS FITCH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "I only checked the pulse.", "name": "MR. ASHWORTH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Where were you at six?", "name": "HALVERSON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "In bed.", "name": "MISS FITCH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "In the library.", "name": "MR. ASHWORTH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "She lied. The housemaid said she was awake at five.", "name": "OKAFOR", "speaker": 1, "ext": [], "paren": ["to Halverson, low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Interesting.", "name": "HALVERSON", "speaker": 0, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "He rises.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Walks the tiled path slowly.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Stops at the fountain.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Peers into the water.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "He picks something out with two fingers: a silver button.", "para": 2, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Whose is this?", "name": "HALVERSON", "speaker": 0, "ext": ["CONT'D"], "paren": ["holding it up"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Not mine.", "name": "MISS FITCH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Not mine.", "name": "MR. ASHWORTH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "The fountain gurgles.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Okafor, flipping pages, mutters a name.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Halverson glances at him.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Say that again, Sergeant.", "name": "HALVERSON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "The victim's coat had one button missing.", "name": "OKAFOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "He had it sewn.", "name": "MISS FITCH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "He had it sewn last Tuesday.", "name": "MR. ASHWORTH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Then this one is not his.", "name": "HALVERSON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "He looks at both of them in turn.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Miss Fitch's hand tightens on the cane.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Mr. Ashworth's mouth opens, then shuts.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Nobody leaves the glasshouse.", "name": "HALVERSON", "speaker": 0, "ext": ["CONT'D"], "paren": ["to everyone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Overhead, a pane of glass rattles in the wind.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}]}