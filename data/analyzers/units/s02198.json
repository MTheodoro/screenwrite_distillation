{"scene_id": "s02198", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02198.fountain", "heading": "INT. COLD-STORAGE WAREHOUSE - LOADING DOCK - NIGHT", "cast": [{"id": 0, "name": "INFORMANT", "names": ["INFORMANT"], "gender": "m", "first": 6, "spoke": 1}, {"id": 1, "name": "DETECTIVE LENA VASQUEZ", "names": ["DETECTIVE LENA VASQUEZ", "VASQUEZ"], "gender": "f", "first": 7, "spoke": 5}, {"id": 2, "name": "OFFICER THEO BRANDT", "names": ["OFFICER THEO BRANDT", "THEO"], "gender": "?", "first": 8, "spoke": 1}, {"id": 3, "name": "BLAKE MORROW", "names": ["BLAKE MORROW", "BLAKE"], "gender": "?", "first": 9, "spoke": 4}, {"id": 4, "name": "SILAS GRADY", "names": ["SILAS GRADY", "SILAS"], "gender": "m", "first": 9, "spoke": 1}, {"id": 5, "name": "ASHLEY", "names": ["ASHLEY"], "gender": "f", "first": 10, "spoke": 1}, {"id": 6, "name": "DOOR", "names": ["DOOR"], "gender": "?", "first": 27, "spoke": 0}, {"id": 7, "name": "MARISOL QUINN", "names": ["MARISOL QUINN", "MARISOL"], "gender": "f", "first": 29, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. COLD-STORAGE WAREHOUSE - LOADING DOCK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Frost on the steel.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Pallets of frozen fish.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A forklift idles.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Six figures stand in the glare of a single sodium light.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A man in a hooded jacket, hands raised.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "This is the INFORMANT (30s, nervous, runny nose).", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Opposite him, DETECTIVE LENA VASQUEZ (40s, badge on her belt, calm) holds a pistol low.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Behind her, OFFICER THEO BRANDT (20s, vest too big) holds a flashlight.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Across the dock, two men in black coats: BLAKE MORROW (50s, smiling) and his silent partner SILAS GRADY (40s, scar through one eyebrow).", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "And hunched on a pallet, wrapped in a foil blanket, sits a girl of about ten, ASHLEY (10, silent, huge eyes).", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Hands where I can see them.", "name": "VASQUEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "I told you she'd be here.", "name": "INFORMANT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "You told us a lot of things.", "name": "BLAKE MORROW", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Honey, come over here.", "name": "VASQUEZ", "speaker": 1, "ext": [], "paren": ["to the girl"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Ashley does not move.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Silas Grady takes a half-step.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Vasquez swings the pistol toward him.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Theo's flashlight beam jerks.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Detective?", "name": "THEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Hold the line, Theo.", "name": "VASQUEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Detective Vasquez. We can settle this.", "name": "BLAKE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Not with her in the room.", "name": "VASQUEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Then let's make the room smaller.", "name": "BLAKE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "He nods to Silas.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Silas steps behind the pallet, one hand sliding under his coat.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Ashley pulls her knees to her chest.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "A DOOR slams at the far end of the dock.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "A woman in a long raincoat runs in, out of breath, wet hair clinging to her face.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "This is MARISOL QUINN (30s, the girl's mother, hysterical).", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "dialogue", "text": "Ashley!", "name": "MARISOL", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "action", "text": "The girl looks up.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "action", "text": "For the first time, she speaks.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "dialogue", "text": "Mama?", "name": "ASHLEY", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "action", "text": "Everyone freezes.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "action", "text": "Blake turns, a smile spreading.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "action", "text": "Vasquez turns, her face tightening.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "action", "text": "The Informant slowly lowers his hands.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "action", "text": "Silas draws his gun.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "action", "text": "Vasquez raises hers.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "action", "text": "The flashlight beam jerks to Silas.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 41, "kind": "dialogue", "text": "Easy. Everybody easy.", "name": "BLAKE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 42, "kind": "dialogue", "text": "Silas, put it down.", "name": "VASQUEZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 43, "kind": "dialogue", "text": "No.", "name": "SILAS", "speaker": 4, "ext": [], "paren": ["first words, flat"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 44, "kind": "action", "text": "Marisol lunges for her daughter.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 45, "kind": "action", "text": "Silas turns, gun swinging.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 46, "kind": "action", "text": "A shot rings out.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 47, "kind": "action", "text": "The forklift alarm shrieks.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 48, "kind": "action", "text": "And in the echo, we hold on Ashley's face, calm now, unfrightened, looking at all of them as if she had been waiting.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}