{"scene_id": "s02199", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02199.fountain", "heading": "EXT. CANYON CROSSING - HIGH NOON", "cast": [{"id": 0, "name": "STRANGER", "names": ["STRANGER"], "gender": "f", "first": 7, "spoke": 8}, {"id": 1, "name": "BARNABAS", "names": ["BARNABAS"], "gender": "?", "first": 8, "spoke": 1}, {"id": 2, "name": "SHERIFF HOLLIS", "names": ["SHERIFF HOLLIS", "HOLLIS"], "gender": "?", "first": 9, "spoke": 8}, {"id": 3, "name": "DEPUTY CRANE", "names": ["DEPUTY CRANE", "CRANE"], "gender": "m", "first": 9, "spoke": 1}, {"id": 4, "name": "MAYOR PETTIBONE", "names": ["MAYOR PETTIBONE", "PETTIBONE"], "gender": "?", "first": 9, "spoke": 1}, {"id": 5, "name": "ADA", "names": ["ADA"], "gender": "?", "first": 37, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. CANYON CROSSING - HIGH NOON", "present": []}, {"u": 1, "kind": "action", "text": "Red rock walls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A wooden bridge over a dry creek bed, planks bleached silver, rope rails frayed.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Heat shimmers.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Crows wheel overhead.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Six people on horseback and on foot gather at the near end of the bridge.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "A woman in a duster, tall, hat low, hands resting on the saddle horn.", "para": 2, "sent": 0, "present": []}, {"u": 7, "kind": "action", "text": "This is the STRANGER (30s, dust on her lashes, two revolvers).", "para": 2, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "Beside her, a boy leads a mule: BARNABAS (teen, freckled, tin cup tied to his belt).", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "At the far end of the bridge, three men block the way: SHERIFF HOLLIS (50s, mustache, shotgun), DEPUTY CRANE (20s, nervous, gun too big) and a stout man in a vest, MAYOR PETTIBONE (60s, watch chain, sweating).", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Wind.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "A creaking plank.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Nobody moves.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Toll's two dollars.", "name": "HOLLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Since when?", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Since this morning.", "name": "HOLLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "It's for the bridge fund.", "name": "CRANE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "The bridge looks fine to me.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "It's an investment.", "name": "PETTIBONE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "The Stranger swings off her horse.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Her boots thud on the plank.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "She walks a few steps, stops, and looks down at the creek bed forty feet below.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "It's a long way to fall.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Nobody's falling.", "name": "HOLLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Then why the toll?", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Because this is my bridge.", "name": "HOLLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Ma'am, we could go around.", "name": "BARNABAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "There is no around, Barnabas.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "She says his name softly.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Hollis notices, glances at the boy, looks back at her, and for the first time his mustache twitches.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "You know the boy?", "name": "HOLLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "I do.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Who's he to you?", "name": "HOLLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Nephew.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Crane's grip tightens on his revolver.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Pettibone steps back.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "The Stranger takes two more steps and now she is in the middle of the bridge, a long shadow stretched behind her.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "My name's Ada Morrow. My brother built this bridge.", "name": "STRANGER", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Morrow built it?", "name": "HOLLIS", "speaker": 2, "ext": [], "paren": ["slowly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "He did. With his hands. Before you hung him.", "name": "ADA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "A crow lands on the rope rail.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Hollis's finger finds the trigger.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "So I'll cross. And you'll stand aside. Or the bridge comes down with all of us.", "name": "ADA", "speaker": 5, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "She pulls a stick of dynamite from her duster.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Cold, calm, a match already between her fingers.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Crane gasps.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "Pettibone sits down on the planks.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "Barnaby lets go of the mule.", "para": 8, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "You wouldn't.", "name": "HOLLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "It's my brother's bridge.", "name": "ADA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}