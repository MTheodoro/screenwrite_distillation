{"scene_id": "s02200", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02200.fountain", "heading": "INT. COUNTY COURTHOUSE - WITNESS STAND - DAY", "cast": [{"id": 0, "name": "JUDGE ODETTE MARCHAND", "names": ["JUDGE ODETTE MARCHAND", "JUDGE MARCHAND"], "gender": "f", "first": 4, "spoke": 3}, {"id": 1, "name": "ATTORNEY RUPERT KLINE", "names": ["ATTORNEY RUPERT KLINE", "KLINE"], "gender": "?", "first": 5, "spoke": 21}, {"id": 2, "name": "NURSE GWENDOLYN ASARE", "names": ["NURSE GWENDOLYN ASARE", "ASARE"], "gender": "f", "first": 6, "spoke": 18}], "units": [{"u": 0, "kind": "heading", "text": "INT. COUNTY COURTHOUSE - WITNESS STAND - DAY", "present": []}, {"u": 1, "kind": "action", "text": "An old courtroom of dark oak and brass, high windows letting in a smear of grey light.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The gallery is half full.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A clock above the door ticks louder than anyone would like.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "JUDGE ODETTE MARCHAND (60s, white hair in a tight bun, reading glasses on a chain) sits behind the bench, hands steepled.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "At the prosecution table, ATTORNEY RUPERT KLINE (40s, sharp suit, a habit of straightening his cuffs) rises with a folder.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "And on the witness stand, with her hands flat on her knees, sits NURSE GWENDOLYN ASARE (50s, grey cardigan, wedding band worn thin).", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "She stares straight ahead.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "He crosses slowly toward her.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Ms. Asare, thank you for being here.", "name": "KLINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I was subpoenaed.", "name": "ASARE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "So you were.", "name": "KLINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "He smiles a little.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She doesn't.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "The judge removes her glasses, polishes them on her sleeve, and puts them back.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "You were on shift the night of March the ninth.", "name": "KLINE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Yes.", "name": "ASARE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Alone on the ward?", "name": "KLINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "With two aides. One went home sick at midnight.", "name": "ASARE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "And the patient in bed four, Mr. Fennimore. He was your responsibility.", "name": "KLINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "He was.", "name": "ASARE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "You administered his medication at three a.m.", "name": "KLINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "At ten past three.", "name": "ASARE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Kline pauses.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "He had not expected correction.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "He glances at the judge.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "She gives him nothing.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Ten past three. Thank you for the precision.", "name": "KLINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "I always chart the time.", "name": "ASARE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "He walks back to his table, lifts a single sheet from the folder, and holds it between two fingers like something dead.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "This is the medication record. It lists the dose as fifty milligrams.", "name": "KLINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "It does.", "name": "ASARE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "The pharmacy log says five.", "name": "KLINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "It says five.", "name": "ASARE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "So which is right?", "name": "KLINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "She is silent.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "The clock ticks.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Judge Marchand leans forward very slightly.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "In the gallery, someone coughs.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Ms. Asare?", "name": "KLINE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Both.", "name": "ASARE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Both?", "name": "KLINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "The pharmacy sent five. I gave fifty.", "name": "ASARE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "A murmur sweeps the room.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Kline sets the sheet down.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "He is no longer smiling.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Why?", "name": "KLINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Because Dr. Whitfield wrote fifty.", "name": "ASARE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "And the pharmacy?", "name": "KLINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Made a mistake.", "name": "ASARE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "And you followed the doctor's order over the pharmacy's.", "name": "KLINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "I always do.", "name": "ASARE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Even when the numbers disagree?", "name": "KLINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Mr. Kline, I have been a nurse for thirty-one years. When a doctor writes an order, I do not second-guess it.", "name": "ASARE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "Even when it kills a man?", "name": "KLINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "She flinches.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Her hand rises, a fraction, then falls back to her knee.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "Mr. Kline.", "name": "JUDGE MARCHAND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "Withdrawn, Your Honour.", "name": "KLINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "Ms. Asare, would you like a recess?", "name": "JUDGE MARCHAND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "No, Your Honour.", "name": "ASARE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "She draws a long breath.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "Then she raises her eyes, finds the back of the courtroom, and speaks to someone nobody else can see.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "I knew when I gave it. I felt the weight of the syringe. I knew.", "name": "ASARE", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "The room has gone entirely quiet.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "Judge Marchand removes her glasses again and does not polish them this time.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "Then why did you do it?", "name": "KLINE", "speaker": 1, "ext": [], "paren": ["gently"], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "dialogue", "text": "Because if I questioned him, I would have been wrong. And if I was right, he would have been wrong. And no one wins that.", "name": "ASARE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "She stops.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "Her whole body seems to loosen.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "The tension of weeks drops out of her shoulders like a coat.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 71, "kind": "dialogue", "text": "Thank you.", "name": "KLINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 72, "kind": "dialogue", "text": "Is that all?", "name": "ASARE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 73, "kind": "dialogue", "text": "That is all.", "name": "KLINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 74, "kind": "action", "text": "He nods to the judge and sits.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 75, "kind": "action", "text": "Asare stays where she is for a moment, hands in her lap, and then slowly rises.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 76, "kind": "action", "text": "Her legs are unsteady.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 77, "kind": "action", "text": "She walks down from the stand, past the table, past the gallery, to the back door.", "para": 12, "sent": 3, "present": [0, 1, 2]}, {"u": 78, "kind": "action", "text": "She pushes it open herself.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 79, "kind": "action", "text": "Light spills in.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 80, "kind": "action", "text": "She goes out into it.", "para": 13, "sent": 2, "present": [0, 1, 2]}, {"u": 81, "kind": "action", "text": "Judge Marchand watches the empty doorway.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 82, "kind": "action", "text": "She picks up her gavel, then sets it down without striking.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 83, "kind": "dialogue", "text": "We will adjourn until two.", "name": "JUDGE MARCHAND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}