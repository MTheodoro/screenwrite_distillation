{"scene_id": "s02202", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02202.fountain", "heading": "INT. ORBITAL ELEVATOR CAR - MID-ASCENT - NIGHT", "cast": [{"id": 0, "name": "MARGUERITE OSEI", "names": ["MARGUERITE OSEI", "OSEI"], "gender": "?", "first": 6, "spoke": 7}, {"id": 1, "name": "TOMAS VELASCO", "names": ["TOMAS VELASCO", "TOMAS"], "gender": "?", "first": 7, "spoke": 5}, {"id": 2, "name": "HANA IWASAKI", "names": ["HANA IWASAKI", "HANA"], "gender": "?", "first": 8, "spoke": 3}, {"id": 3, "name": "NAVIN BHATT", "names": ["NAVIN BHATT", "NAVIN"], "gender": "?", "first": 9, "spoke": 4}, {"id": 4, "name": "COLLIN FAIRWEATHER", "names": ["COLLIN FAIRWEATHER", "COLLIN"], "gender": "?", "first": 10, "spoke": 3}, {"id": 5, "name": "ROZ", "names": ["ROZ"], "gender": "?", "first": 11, "spoke": 5}, {"id": 6, "name": "TEAGUE", "names": ["TEAGUE"], "gender": "?", "first": 11, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. ORBITAL ELEVATOR CAR - MID-ASCENT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A glass-walled cylinder rising through darkness.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Below, the curve of a blue-black Earth.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The car hums.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A status panel reads 22,000 KM AND CLIMBING.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Six passengers share the car.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "MARGUERITE OSEI (50s, mission commander, grey crop) grips the handrail.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "TOMAS VELASCO (30s, pilot, flight suit) leans on the wall.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "DR. HANA IWASAKI (40s, biologist) holds a sealed specimen case.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "NAVIN BHATT (20s, engineer, thick gloves) kneels at an access panel.", "para": 1, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "COLLIN FAIRWEATHER (60s, corporate observer, tie loosened) sits on the floor.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "And ROSALIND \"ROZ\" TEAGUE (30s, medic) checks a handheld.", "para": 1, "sent": 6, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "action", "text": "The car shudders.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "action", "text": "All six stop talking.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "What was that?", "name": "OSEI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "Tether tension.", "name": "NAVIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "That's not tension, that's a stutter.", "name": "TOMAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "Is the case secure?", "name": "HANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "It's secure. Is Collin secure?", "name": "ROZ", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "I'm fine.", "name": "COLLIN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "You're sweating.", "name": "ROZ", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "It's warm.", "name": "COLLIN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "It's minus ten.", "name": "OSEI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "The panel flickers.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "The ascent counter drops a number, then climbs again.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "action", "text": "Navin's head jerks up from the access panel.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "We slipped.", "name": "NAVIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "We what?", "name": "OSEI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "Forty metres. We dropped forty metres.", "name": "NAVIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "Commander, I'm reading a cable fault on the line.", "name": "TOMAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "How bad?", "name": "HANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "Bad enough to ask.", "name": "TOMAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "dialogue", "text": "Navin, can you reach the manual brake?", "name": "OSEI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "If someone holds the lamp.", "name": "NAVIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "I'll hold it.", "name": "COLLIN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "You will not. Hana.", "name": "ROZ", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "Me?", "name": "HANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "You've got the steadiest hands.", "name": "ROZ", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "Hana sets the case on the seat and picks up the lamp.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "Her hand does shake.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "She sees it and steadies it with the other.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "Navin pulls a lever.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "The brake groans.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "The car jolts and holds.", "para": 4, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "dialogue", "text": "We're locked.", "name": "TOMAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "Everyone breathe.", "name": "OSEI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "action", "text": "They do.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "For a moment, only the sound of six people inhaling.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "Then the panel chimes: FAULT ISOLATED.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "action", "text": "HOLD POSITION.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "dialogue", "text": "Tomas, confirm.", "name": "OSEI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "dialogue", "text": "Confirmed. We're not going anywhere.", "name": "TOMAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "action", "text": "Osei lets go of the rail.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "action", "text": "Her fingers have gone white.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "action", "text": "She looks around the car at each of them in turn: Tomas calm, Hana trembling, Navin sweating, Collin ashen, Roz watching Collin.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "dialogue", "text": "He knows something.", "name": "ROZ", "speaker": 5, "ext": [], "paren": ["low, to Osei"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "dialogue", "text": "I know he does.", "name": "OSEI", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "action", "text": "Collin looks away.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}]}