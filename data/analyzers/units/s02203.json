{"scene_id": "s02203", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02203.fountain", "heading": "INT. SHUTTERED OBSERVATORY - DOME ROOM - NIGHT", "cast": [{"id": 0, "name": "ELSPETH COURTENAY", "names": ["ELSPETH COURTENAY", "ELSPETH"], "gender": "?", "first": 6, "spoke": 33}, {"id": 1, "name": "LACHLAN MURRAY", "names": ["LACHLAN MURRAY", "LACHLAN"], "gender": "?", "first": 7, "spoke": 9}, {"id": 2, "name": "OKSANA PETRENKO", "names": ["OKSANA PETRENKO", "OKSANA"], "gender": "?", "first": 8, "spoke": 9}, {"id": 3, "name": "HAMZA YILMAZ", "names": ["HAMZA YILMAZ", "HAMZA"], "gender": "m", "first": 9, "spoke": 11}, {"id": 4, "name": "CECILIA ROSSI", "names": ["CECILIA ROSSI", "CECILIA"], "gender": "f", "first": 10, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. SHUTTERED OBSERVATORY - DOME ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A giant telescope under a retractable roof.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The slit is open; a sliver of starry sky shows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wooden floors creak underfoot.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single reading lamp glows.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Five people sit in a rough circle of folding chairs, bags at their feet.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "ELSPETH COURTENAY (50s, ex-intelligence, tweed jacket) holds a silver thermos.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "LACHLAN MURRAY (30s, analyst, rumpled shirt) taps a laptop.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "OKSANA PETRENKO (40s, courier, fingerless gloves) stares at the floor.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "HAMZA YILMAZ (50s, broker, wool coat) picks at his cuticles.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "And CECILIA ROSSI (20s, junior, very new) sits on the edge of her chair like someone about to be called on.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Nobody is talking.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Then:", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Let's be clear about why we're here.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Because someone leaked.", "name": "LACHLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Because someone is about to.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "You can't know that.", "name": "HAMZA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "I know what I can prove and I know what I can feel.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Feelings. Wonderful.", "name": "OKSANA", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Oksana, if you have a comment, make it to the room.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "I said, feelings are not evidence.", "name": "OKSANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "No. But they're how I've stayed alive.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Excuse me, may I ask something?", "name": "CECILIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "You may.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Why are we meeting in an observatory?", "name": "CECILIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Nobody listens in an observatory.", "name": "LACHLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Nobody comes to an observatory.", "name": "HAMZA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Nobody knows where it is.", "name": "OKSANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "All three.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "But the roof is open.", "name": "CECILIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "It always is.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "That's actually a point.", "name": "LACHLAN", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Lachlan, your laptop. Is it on the network?", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Offline.", "name": "LACHLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Prove it.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Mm. Sure.", "name": "LACHLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "He turns the screen outward.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Airplane mode, no Wi-Fi bars, no Bluetooth.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "She nods.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Hamza. Phone.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "In the car.", "name": "HAMZA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Oksana.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Faraday bag.", "name": "OKSANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Cecilia.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "I, um. I left mine at home.", "name": "CECILIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Good girl.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Now. To business.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "I have a question first.", "name": "HAMZA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "I have a question first.", "name": "LACHLAN", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Make it quick.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "If the leak is among us, how do we find it?", "name": "HAMZA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "We don't find it. We feed it.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "Feed it what?", "name": "LACHLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "Something false.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "And watch where it surfaces.", "name": "OKSANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "Exactly.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "But what if we're wrong?", "name": "CECILIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "Then the false information surfaces nowhere and we have wasted a night.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "And if we're right?", "name": "HAMZA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "Then someone in this room will be very unhappy by dawn.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "A long pause.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "The telescope creaks overhead as the dome shifts a few degrees in the wind.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "A thin blade of starlight slides across Cecilia's face.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "She flinches.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "dialogue", "text": "Who writes the false information?", "name": "LACHLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "I do.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "dialogue", "text": "And who delivers it?", "name": "OKSANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "dialogue", "text": "You do. Tomorrow. To three different contacts.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "dialogue", "text": "One for each of us?", "name": "OKSANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "dialogue", "text": "Exactly one for each of you.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "dialogue", "text": "And me?", "name": "HAMZA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "dialogue", "text": "You'll get a different story. A better one.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "dialogue", "text": "Why better?", "name": "HAMZA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "dialogue", "text": "Because you are more careful than the others.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "dialogue", "text": "I don't know whether to be flattered.", "name": "HAMZA", "speaker": 3, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "dialogue", "text": "Don't be.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 76, "kind": "dialogue", "text": "Elspeth, how long until dawn?", "name": "LACHLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 77, "kind": "dialogue", "text": "Seven hours.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 78, "kind": "dialogue", "text": "Can we leave before dawn?", "name": "CECILIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 79, "kind": "dialogue", "text": "No.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 80, "kind": "dialogue", "text": "Not even to use the restroom?", "name": "CECILIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 81, "kind": "dialogue", "text": "You may use the restroom. Take Oksana.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 82, "kind": "dialogue", "text": "Why me?", "name": "OKSANA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 83, "kind": "dialogue", "text": "Because you're the only one who won't talk to her.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 84, "kind": "dialogue", "text": "Tremendous.", "name": "OKSANA", "speaker": 2, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 85, "kind": "action", "text": "She stands.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 86, "kind": "action", "text": "Cecilia stands.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 87, "kind": "action", "text": "The two cross the dome room, their footsteps echoing, and exit through a door at the far end.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 88, "kind": "action", "text": "The three remaining watch them go.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 89, "kind": "action", "text": "The lamp flickers.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 90, "kind": "dialogue", "text": "She doesn't suspect, does she?", "name": "HAMZA", "speaker": 3, "ext": [], "paren": ["very low"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 91, "kind": "dialogue", "text": "Cecilia?", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 92, "kind": "dialogue", "text": "Oksana.", "name": "HAMZA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 93, "kind": "dialogue", "text": "Oksana suspects everyone. That is why I trust her.", "name": "ELSPETH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 94, "kind": "action", "text": "Overhead, a single shooting star crosses the open slit of sky.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 95, "kind": "action", "text": "Nobody sees it but Lachlan, who watches until it is gone.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}]}