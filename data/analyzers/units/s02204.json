{"scene_id": "s02204", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02204.fountain", "heading": "INT. AMBULANCE BAY - RURAL HOSPITAL - NIGHT", "cast": [{"id": 0, "name": "AMARA NWOSU", "names": ["AMARA NWOSU", "AMARA"], "gender": "?", "first": 5, "spoke": 11}, {"id": 1, "name": "BEN", "names": ["BEN"], "gender": "m", "first": 6, "spoke": 8}, {"id": 2, "name": "HOLLOWAY", "names": ["HOLLOWAY"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "PARAMEDIC FIONA GALLAGHER", "names": ["PARAMEDIC FIONA GALLAGHER", "FIONA"], "gender": "f", "first": 7, "spoke": 5}, {"id": 4, "name": "MARCEL DUPRE", "names": ["MARCEL DUPRE", "MARCEL"], "gender": "?", "first": 13, "spoke": 1}, {"id": 5, "name": "DISPATCH", "names": ["DISPATCH"], "gender": "?", "first": 15, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. AMBULANCE BAY - RURAL HOSPITAL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Sodium lights, wet pavement.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The bay doors yawn open to a rainy road.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Gurneys and oxygen tanks line the wall.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A radio on a shelf murmurs static.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. AMARA NWOSU (40s, ER attending, damp scrubs) paces.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "NURSE BENEDICT \"BEN\" HOLLOWAY (30s, steady hands) checks a crash cart.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "PARAMEDIC FIONA GALLAGHER (30s, reflective jacket) stands by the doors, watching the road.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Ben spots lights on the wet road.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "He nods at Fiona.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "They're here.", "name": "BEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "An ambulance backs in, rear doors swinging.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "A gurney comes out fast.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "On it lies MARCEL DUPRE (50s, farmer, soaked flannel), pale and sweating.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "A radio on Fiona's shoulder crackles.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Unit Four, status on your patient? Over.", "name": "DISPATCH", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Unit Four. Arrived. Transferring now.", "name": "FIONA", "speaker": 3, "ext": [], "paren": ["into radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Copy, Four.", "name": "DISPATCH", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Fiona, what do you have?", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Fifty-one-year-old male, chest pain, diaphoretic. BP eighty over fifty. Nitro given. No relief.", "name": "FIONA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Ben, get a twelve-lead.", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "On it, Doctor.", "name": "BEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "He attaches the leads in four fast movements.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "The monitor shows a ragged line.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "He's in V-fib.", "name": "BEN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Charge to two hundred.", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Charging.", "name": "BEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Everybody clear.", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Everybody clear.", "name": "FIONA", "speaker": 3, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "The shock lifts Marcel's back off the gurney.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "The monitor squeals.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Flat.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Again.", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Charging. Three hundred.", "name": "BEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Clear!", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Another shock.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Marcel convulses.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "The monitor shows nothing.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Then a blip.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Another.", "para": 7, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "The line settles into a ragged rhythm.", "para": 7, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "We have a pulse.", "name": "BEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Ben, breathe.", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "I am breathing.", "name": "BEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Then stop saying it out loud.", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Fiona, hands on her knees, lets out a short laugh.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Ben wipes his forehead.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "The radio crackles again.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "Unit Four, we have another call, motor vehicle collision, route nine. Can you respond? Over.", "name": "DISPATCH", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "Fiona looks at Amara.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "Amara looks at Fiona.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Neither says anything.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "Rain drums on the bay roof.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "Dispatch, Unit Four. Responding.", "name": "FIONA", "speaker": 3, "ext": [], "paren": ["into radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "Fiona, you've been up thirty hours.", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "Thirty-one. Who's counting?", "name": "FIONA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "Ben is. Aren't you, Ben?", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "Thirty-two, actually.", "name": "BEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "Fiona grins, tired.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "She grabs her kit and jogs for the ambulance.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "action", "text": "The doors slam.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "The siren wails.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "The headlights swing across the bay and are gone.", "para": 10, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "Amara turns to the gurney.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "Marcel's eyes flutter open.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "He grips her sleeve.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "dialogue", "text": "I'm sorry for the trouble.", "name": "MARCEL", "speaker": 4, "ext": [], "paren": ["faint"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "dialogue", "text": "No trouble, Mr. Dupre.", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "action", "text": "She nods to Ben.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "action", "text": "Together they wheel him inside.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}