{"scene_id": "s02205", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02205.fountain", "heading": "INT. WEDDING CAKE BAKERY - BACK KITCHEN - DAY", "cast": [{"id": 0, "name": "CORKY", "names": ["CORKY"], "gender": "m", "first": 5, "spoke": 15}, {"id": 1, "name": "BANKS", "names": ["BANKS"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "PRIYANKA SHAH-WILLIAMS", "names": ["PRIYANKA SHAH-WILLIAMS", "PRIYANKA"], "gender": "f", "first": 6, "spoke": 11}, {"id": 3, "name": "DEMI", "names": ["DEMI"], "gender": "m", "first": 7, "spoke": 7}, {"id": 4, "name": "OKORO", "names": ["OKORO"], "gender": "?", "first": 7, "spoke": 0}, {"id": 5, "name": "VALENTINA CRESPO", "names": ["VALENTINA CRESPO", "MRS. CRESPO"], "gender": "f", "first": 8, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. WEDDING CAKE BAKERY - BACK KITCHEN - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Flour in the air.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sheet pans, piping bags, a six-tier cake in the middle of the floor leaning ever so slightly to the left.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A clock says 2:14.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The wedding is at 3:00.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CORNELIUS \"CORKY\" BANKS (50s, head baker, flour-dusted apron) holds his head in his hands.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "His sous-chef PRIYANKA SHAH-WILLIAMS (30s, hairnet, eyes of steel) circles the cake with a ruler.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Their apprentice DESMOND \"DEMI\" OKORO (teen, oversized chef whites) holds a piping bag like a weapon.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "And the bride's mother, MRS. VALENTINA CRESPO (60s, hat the size of a hubcap), stands in the doorway with her arms crossed.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "It's fine. It's totally fine.", "name": "CORKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "It's leaning, Corky.", "name": "PRIYANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Everything leans. The Tower of Pisa leans.", "name": "CORKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "The Tower of Pisa isn't going to be eaten by two hundred guests.", "name": "PRIYANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Is something wrong with my daughter's cake?", "name": "MRS. CRESPO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "No, Mrs. Crespo.", "name": "CORKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Yes.", "name": "PRIYANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Stop helping.", "name": "CORKY", "speaker": 0, "ext": [], "paren": ["to Priyanka"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Chef, I can fix it.", "name": "DEMI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "No, Demi.", "name": "CORKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "With dowels.", "name": "DEMI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "He's actually right.", "name": "PRIYANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Demi has never used a dowel in his life.", "name": "CORKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "I've used toothpicks.", "name": "DEMI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Toothpicks are not dowels.", "name": "CORKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Mrs. Crespo marches in.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "She stops at the cake, takes off her hat, puts it on the counter, and rolls her sleeves.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Show me where the dowels are.", "name": "MRS. CRESPO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Mrs. Crespo, please.", "name": "CORKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Cornelius. I raised four children and buried two husbands. I can handle a dowel.", "name": "MRS. CRESPO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Priyanka hands her a bundle.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Corky sits down on a flour sack and puts his head back in his hands.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Demi steps in, holds the cake steady with both palms, and braces his feet.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Is this how they do it in movies?", "name": "DEMI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "No.", "name": "PRIYANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "What do they do?", "name": "DEMI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "They hire a better apprentice.", "name": "PRIYANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "He grins.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "She grins back, almost.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Mrs. Crespo drives the first dowel through the top three tiers with a surgeon's precision.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "The cake groans.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Settles.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Straightens.", "para": 4, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "All four of them hold their breath.", "para": 4, "sent": 6, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "There.", "name": "MRS. CRESPO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Is it straight?", "name": "CORKY", "speaker": 0, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "It's straight.", "name": "PRIYANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Tell me honestly.", "name": "CORKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "It's very straight, Chef.", "name": "DEMI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "Corky lifts his head.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "The cake stands tall and perfect.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "He lowers his hands, stunned.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "Mrs. Crespo, I owe you my career.", "name": "CORKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "You owe me a slice.", "name": "MRS. CRESPO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "That's actually the bride's slice.", "name": "PRIYANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "Then you owe me two.", "name": "MRS. CRESPO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "The clock ticks to 2:20.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "Priyanka claps once, sharply.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "Frosting touch-ups. Demi, the roses. Corky, the transport van.", "name": "PRIYANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "dialogue", "text": "The van is in the shop.", "name": "CORKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "You told me it was fixed.", "name": "PRIYANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "I told you it was fixed in my heart.", "name": "CORKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "Mrs. Crespo lifts her hat from the counter, puts it back on her head, and picks up her car keys.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "dialogue", "text": "I have a station wagon.", "name": "MRS. CRESPO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "dialogue", "text": "Mrs. Crespo, it's a six-tier cake.", "name": "CORKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "dialogue", "text": "Cornelius, I have a very large station wagon.", "name": "MRS. CRESPO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "action", "text": "He looks at her.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "action", "text": "At the cake.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "action", "text": "At Priyanka, who shrugs, and at Demi, who is already carrying a tray of roses toward the back door.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "dialogue", "text": "Fine. We're doing this.", "name": "CORKY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "dialogue", "text": "We're doing this.", "name": "PRIYANKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "dialogue", "text": "We're doing this!", "name": "DEMI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "dialogue", "text": "Somebody open the door.", "name": "MRS. CRESPO", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}