{"scene_id": "s02206", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02206.fountain", "heading": "EXT. ABANDONED SKATE PARK - SUNSET", "cast": [{"id": 0, "name": "WILLA PRZYBYLSKI", "names": ["WILLA PRZYBYLSKI", "WILLA"], "gender": "f", "first": 5, "spoke": 5}, {"id": 1, "name": "MATEO ARROYO-BELL", "names": ["MATEO ARROYO-BELL", "MATEO"], "gender": "m", "first": 6, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. ABANDONED SKATE PARK - SUNSET", "present": []}, {"u": 1, "kind": "action", "text": "Cracked concrete bowls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Graffiti.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single streetlamp flickers on.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The sky is the colour of a bruise going yellow.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "WILLA PRZYBYLSKI (16, buzzcut, borrowed jacket) sits on the lip of a bowl, a board across her knees.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Below, MATEO ARROYO-BELL (17, tall, band-aids on his elbows) rolls a loose wheel with one finger.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "You're leaving tomorrow.", "name": "WILLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Bus is at seven.", "name": "MATEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Don't say goodbye.", "name": "WILLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I wasn't going to.", "name": "MATEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Good.", "name": "WILLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He kicks up the board and drops into the bowl.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Rolls up the far wall and hangs, weightless, for one second.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Comes down.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She watches, lips pressed.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Ride with me.", "name": "MATEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "I'm not wearing pads.", "name": "WILLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Nobody's watching.", "name": "MATEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She stands and drops in.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Wobbles.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Recovers.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "They carve opposite walls, passing in the middle, never colliding.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Don't forget me.", "name": "WILLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Don't forget me.", "name": "MATEO", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "They stop at the bottom, boards ticking, and neither speaks.", "para": 4, "sent": 0, "present": [0, 1]}]}