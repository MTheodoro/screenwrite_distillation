{"scene_id": "s02207", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02207.fountain", "heading": "INT. DEEP-SPACE HABITAT - COMMON ROOM - NIGHT CYCLE", "cast": [{"id": 0, "name": "MAYA THORNQUIST", "names": ["MAYA THORNQUIST", "MAYA"], "gender": "?", "first": 5, "spoke": 13}, {"id": 1, "name": "AMBROSE BEAUMONT", "names": ["AMBROSE BEAUMONT", "AMBROSE"], "gender": "m", "first": 6, "spoke": 3}, {"id": 2, "name": "TARIQ SALEH", "names": ["TARIQ SALEH", "TARIQ"], "gender": "m", "first": 7, "spoke": 8}, {"id": 3, "name": "LINNEA SORENSEN", "names": ["LINNEA SORENSEN", "LINNEA"], "gender": "f", "first": 8, "spoke": 3}, {"id": 4, "name": "KOFI MENSAH", "names": ["KOFI MENSAH", "KOFI"], "gender": "?", "first": 9, "spoke": 2}, {"id": 5, "name": "GRIGORI PETROV", "names": ["GRIGORI PETROV", "GRIGORI"], "gender": "?", "first": 10, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. DEEP-SPACE HABITAT - COMMON ROOM - NIGHT CYCLE", "present": []}, {"u": 1, "kind": "action", "text": "Dim amber lighting.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A long table bolted to the floor, six mugs, a hydroponic wall of drooping lettuce.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A viewport shows a black field of stars.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Outside, nothing.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MAYA THORNQUIST (40s, station chief, ponytail) pours coffee substitute.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "DR. AMBROSE BEAUMONT (60s, botanist, cardigan) pokes at a lettuce leaf.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "TARIQ SALEH (30s, engineer, wrench in his belt) stares at his tablet.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "LINNEA SORENSEN (20s, comms officer) eats a protein bar.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "KOFI MENSAH (30s, medic, stethoscope) sketches in a notebook.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "And GRIGORI PETROV (50s, security, arms folded) leans on the wall.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Morning, everyone.", "name": "MAYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "It's night cycle.", "name": "LINNEA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Morning for me.", "name": "MAYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "Light chuckles.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Tariq doesn't look up from his tablet.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Kofi turns a page.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Grigori's jaw works.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Maya, the coolant readings are off again.", "name": "TARIQ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "How off?", "name": "MAYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Point three. Same as yesterday.", "name": "TARIQ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Same as yesterday is fine.", "name": "MAYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Same as yesterday is a trend.", "name": "TARIQ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Tariq thinks we're going to explode.", "name": "MAYA", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "We might.", "name": "AMBROSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Ambrose, don't.", "name": "LINNEA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "It's a statistical possibility.", "name": "AMBROSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Everything is.", "name": "KOFI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Grigori pushes off the wall and crosses to the table.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "He sits.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "He doesn't speak.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Grigori, you're quiet.", "name": "MAYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Am I?", "name": "GRIGORI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "You're always quiet.", "name": "MAYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Then I'm normal.", "name": "GRIGORI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Linnea snorts.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Ambrose smiles, pleased.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Tariq finally sets down his tablet.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Maya. I need to say something.", "name": "TARIQ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Go ahead.", "name": "MAYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "I think someone's been tampering with the cooling loop.", "name": "TARIQ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "The room stills.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Kofi's pencil stops.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Ambrose lowers his leaf.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Someone.", "name": "MAYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Someone on board.", "name": "TARIQ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "That's a serious accusation.", "name": "GRIGORI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "It's a serious loop.", "name": "TARIQ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "Does anyone know anything about this?", "name": "MAYA", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "Nobody answers.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "The lights pulse, dim, brighten.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Linnea's bar crumbles in her fist.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "Grigori's chair creaks.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "Of course.", "name": "MAYA", "speaker": 0, "ext": ["CONT'D"], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "Maya?", "name": "KOFI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "Nothing.", "name": "MAYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "A low tone rings through the hull.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "Not an alarm.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "Deeper.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "The amber lights flicker to red.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "That's the pressure alert.", "name": "LINNEA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "dialogue", "text": "That's not the pressure alert. That's the coolant.", "name": "TARIQ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "dialogue", "text": "Is it the end?", "name": "AMBROSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "dialogue", "text": "It's not the end.", "name": "MAYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "dialogue", "text": "It might be.", "name": "GRIGORI", "speaker": 5, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "Everyone turns to look at him.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "action", "text": "His hand has found something in his pocket.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}