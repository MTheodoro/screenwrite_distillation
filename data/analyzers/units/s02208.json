{"scene_id": "s02208", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02208.fountain", "heading": "INT. OFFICE PARKING LOT - LATE AFTERNOON", "cast": [{"id": 0, "name": "AUDREY KOLLMAN", "names": ["AUDREY KOLLMAN", "AUDREY"], "gender": "f", "first": 5, "spoke": 9}, {"id": 1, "name": "NATHANIEL PARK", "names": ["NATHANIEL PARK", "NATHANIEL"], "gender": "f", "first": 6, "spoke": 6}, {"id": 2, "name": "BO", "names": ["BO"], "gender": "m", "first": 7, "spoke": 4}, {"id": 3, "name": "LAFAYETTE", "names": ["LAFAYETTE"], "gender": "?", "first": 7, "spoke": 0}, {"id": 4, "name": "PRUDENCE TRAN", "names": ["PRUDENCE TRAN", "PRUDENCE"], "gender": "f", "first": 8, "spoke": 4}, {"id": 5, "name": "HR", "names": ["HR"], "gender": "?", "first": 8, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. OFFICE PARKING LOT - LATE AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Rows of cars.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A cloud of exhaust.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "An orange sunset hits the glass tower above.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A corporate banner reads SYNERGY AWAITS.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "AUDREY KOLLMAN (50s, VP of Operations, severe bun) sits in her sedan with the window down, a cardboard box in the passenger seat.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Next to the car, her former assistant NATHANIEL PARK (20s, lanyard, nervous) holds a sad potted fern.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "In the next row, security guard BEAUREGARD \"BO\" LAFAYETTE (60s, reflective vest) leans on his golf cart.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "And PRUDENCE TRAN (40s, HR, cardigan) walks up, clipboard in hand.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "Audrey. I'm sorry.", "name": "PRUDENCE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Don't be sorry. Be efficient.", "name": "AUDREY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "I brought your fern.", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Thank you, Nathaniel.", "name": "AUDREY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Ma'am, is there anything I can carry?", "name": "BO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "No. Thank you, Beauregard.", "name": "AUDREY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "It's Bo.", "name": "BO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Bo. Of course.", "name": "AUDREY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "Nathaniel sets the fern on the roof of her car.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Prudence flips a page on her clipboard.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "There are a few forms.", "name": "PRUDENCE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "There are always forms.", "name": "AUDREY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "I can fill them out for you.", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Nathaniel, no.", "name": "PRUDENCE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Sorry.", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "It's a shame.", "name": "BO", "speaker": 2, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "It's company policy.", "name": "PRUDENCE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "I know. It's still a shame.", "name": "BO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Audrey starts the engine.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "It idles.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "She doesn't put the car in gear.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "The four of them stand in the long amber light, none of them moving.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Well. This has been a long twelve years.", "name": "AUDREY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "It was an honour.", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Was it?", "name": "AUDREY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "It was a lot of things.", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "She laughs, a quick, surprised sound.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Prudence smiles.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Bo tips his cap.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Audrey puts the car in gear, takes the fern from the roof, and sets it on the passenger seat on top of the box.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Water it on Thursdays.", "name": "AUDREY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "It's yours.", "name": "NATHANIEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "It was always yours.", "name": "AUDREY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "She drives away.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "They watch her go, three small figures in the light.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}