{"scene_id": "s02211", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02211.fountain", "heading": "EXT. DESERT CANYON FLOOR - DAY", "cast": [{"id": 0, "name": "RIGO", "names": ["RIGO"], "gender": "?", "first": 5, "spoke": 9}, {"id": 1, "name": "SALAZAR", "names": ["SALAZAR"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "WOMAN", "names": ["WOMAN"], "gender": "?", "first": 6, "spoke": 7}, {"id": 3, "name": "BLUE BLAZER", "names": ["BLUE BLAZER"], "gender": "?", "first": 6, "spoke": 0}, {"id": 4, "name": "HEAVYSET MAN", "names": ["HEAVYSET MAN"], "gender": "m", "first": 7, "spoke": 4}, {"id": 5, "name": "GIRL", "names": ["GIRL"], "gender": "f", "first": 8, "spoke": 1}, {"id": 6, "name": "TESS", "names": ["TESS"], "gender": "?", "first": 36, "spoke": 2}, {"id": 7, "name": "IMANI", "names": ["IMANI"], "gender": "?", "first": 44, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DESERT CANYON FLOOR - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Orange rock, white sky.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A dry wash cuts the canyon floor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A crashed single-engine plane lies nose-down in the sand, one wing bent.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Four survivors sit in the narrow shade of the other wing.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "RIGOBERTO \"RIGO\" SALAZAR (40s, pilot, blood-crusted shirt) tears a seat cushion for padding.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "A WOMAN IN A BLUE BLAZER (30s, torn sleeve) rations water into a tin cap.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "A HEAVYSET MAN (50s, glasses cracked) stares at the horizon.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "A teenage GIRL (15, headphones around her neck) draws in the dust with a stick.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "action", "text": "The woman hands the cap to the man.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "He sips and passes it to the girl.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "She drinks, hesitates, and offers it to Rigo, who shakes his head.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Keep it.", "name": "RIGO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "You haven't had any.", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "I'm fine.", "name": "RIGO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "You're bleeding.", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "It's old blood.", "name": "RIGO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "She takes the cap back.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "He looks at the others and clears his throat.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "We stay with the plane. They look for planes.", "name": "RIGO", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Who's they?", "name": "HEAVYSET MAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Search and rescue.", "name": "RIGO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "They know we're down?", "name": "HEAVYSET MAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "They will.", "name": "RIGO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "The girl scratches a circle in the sand.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "The woman watches it.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "The man in glasses looks at the girl, and then at the sky, and then at his hands.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "He's lying.", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Who?", "name": "HEAVYSET MAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "The pilot.", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "I'm Rigo.", "name": "RIGO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "You're lying, Rigo.", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "I'm telling the truth as I know it.", "name": "RIGO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "The Heavyset Man lowers his head.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "A single dust devil rises from the wash, spins across the canyon floor, and dies against the wreck.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Nobody moves.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "My name's Tess.", "name": "GIRL", "speaker": 5, "ext": [], "paren": ["very quiet"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "Everyone looks at her.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "dialogue", "text": "In case it matters.", "name": "TESS", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "It matters, Tess.", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "It's just. Nobody asked.", "name": "TESS", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "The Heavyset Man lifts his head.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "dialogue", "text": "I'm Gideon.", "name": "HEAVYSET MAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "The Woman in the Blue Blazer closes her eyes.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "dialogue", "text": "Imani.", "name": "WOMAN", "speaker": 2, "ext": [], "paren": ["after a moment"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 45, "kind": "action", "text": "The four of them sit in the narrow shade, strangers with names.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 46, "kind": "dialogue", "text": "Rigo. How far to the road?", "name": "IMANI", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 47, "kind": "dialogue", "text": "Far enough.", "name": "RIGO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}