{"scene_id": "s02212", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02212.fountain", "heading": "INT. FERRY TERMINAL - IMPROVISED TRIAGE BAY - NIGHT", "cast": [{"id": 0, "name": "YUSUF ADEYEMI", "names": ["YUSUF ADEYEMI", "YUSUF"], "gender": "?", "first": 5, "spoke": 19}, {"id": 1, "name": "NURSE PILAR GUZMAN", "names": ["NURSE PILAR GUZMAN", "PILAR"], "gender": "m", "first": 6, "spoke": 20}, {"id": 2, "name": "CORMAC DOYLE", "names": ["CORMAC DOYLE", "CORMAC"], "gender": "m", "first": 7, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. FERRY TERMINAL - IMPROVISED TRIAGE BAY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A waiting hall turned field hospital.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Plastic chairs shoved to the walls, a departures board stuck on CANCELLED.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Camp cots in rows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Generator hum, the slap of waves against the pier beyond the glass.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. YUSUF ADEYEMI (50s, trauma surgeon, bloody gloves) bends over a cot.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Opposite him, NURSE PILAR GUZMAN (30s, ponytail, steady as granite) holds a surgical lamp.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Between them lies CORMAC DOYLE (40s, ferry deckhand, soaked, grey-lipped), his shirt cut open, a deep gash across his abdomen packed with gauze.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Pressure?", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Ninety over sixty. Holding.", "name": "PILAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "It won't hold.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "It's holding now.", "name": "PILAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Now is not a plan.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "He peels back the gauze.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "A seep of dark blood.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Cormac groans, eyes rolling.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Pilar steadies the lamp.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I need a clamp, a suction, and someone who isn't afraid of blood.", "name": "YUSUF", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the room"], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Nobody answers.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "The hall is empty but for the three of them and rows of vacant cots.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Pilar looks at him.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "There's no one else, Doctor.", "name": "PILAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Then you.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "I'm holding the lamp.", "name": "PILAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Put the lamp on the cot.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "She sets it down.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The beam angles up across their faces.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Yusuf takes a clamp from the tray and pushes it into the wound.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Pilar takes the suction, slides it in beside his hand.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Both lean in.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Both are still.", "para": 4, "sent": 5, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "A heartbeat passes.", "para": 4, "sent": 6, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Another.", "para": 4, "sent": 7, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Mam?", "name": "CORMAC", "speaker": 2, "ext": [], "paren": ["weak, muttered"], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "He's talking.", "name": "PILAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "That's good. That's very good.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Is it?", "name": "PILAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "It better be.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Cormac's eyes open, unfocused, searching the ceiling.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Is the boat sinking?", "name": "CORMAC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "No. The boat's fine.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "I can hear the water.", "name": "CORMAC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "That's the pier. Lie still.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "My mam's waiting at the dock.", "name": "CORMAC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Cormac. Look at me.", "name": "PILAR", "speaker": 1, "ext": [], "paren": ["gently"], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "He turns his head.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "His gaze finds her.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "You're in good hands.", "name": "PILAR", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Are you the doctor?", "name": "CORMAC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "I'm the one who keeps him honest.", "name": "PILAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Cormac smiles, a weak twitch.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Yusuf glances at Pilar over the clamp, and something almost like humour crosses his face.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "The generator coughs.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "The lights flicker once, twice, and then go out.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Total dark.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Waves slam the pier.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Somewhere in the black, a monitor begins to alarm.", "para": 8, "sent": 4, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "Pilar. The lamp.", "name": "YUSUF", "speaker": 0, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "I have it.", "name": "PILAR", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "The battery lamp flares up, small and harsh.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "Cormac's face is white.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "His chest is not moving.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "No, no, no.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "He drops the clamp and begins compressions, hard and fast, his whole body pumping.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "Pilar takes over the lamp and the bag, squeezing air into Cormac's lungs.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "They work in a silent rhythm, shoulder to shoulder.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "Come on, Cormac.", "name": "PILAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "dialogue", "text": "Come on.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 68, "kind": "dialogue", "text": "Come on.", "name": "PILAR", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 69, "kind": "dialogue", "text": "How long?", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 70, "kind": "dialogue", "text": "Two minutes.", "name": "PILAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 71, "kind": "dialogue", "text": "Keep going.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 72, "kind": "dialogue", "text": "I am.", "name": "PILAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 73, "kind": "action", "text": "Sweat drips from Yusuf's chin onto Cormac's chest.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 74, "kind": "action", "text": "His arms tremble.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 75, "kind": "action", "text": "Pilar glances at him.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 76, "kind": "dialogue", "text": "Switch with me.", "name": "PILAR", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 77, "kind": "dialogue", "text": "No.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 78, "kind": "dialogue", "text": "You're done.", "name": "PILAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 79, "kind": "dialogue", "text": "I'm not.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 80, "kind": "dialogue", "text": "Yusuf.", "name": "PILAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 81, "kind": "action", "text": "He stops.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 82, "kind": "action", "text": "His hands hover.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 83, "kind": "action", "text": "She bends over Cormac and listens.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 84, "kind": "action", "text": "A long beat.", "para": 12, "sent": 3, "present": [0, 1, 2]}, {"u": 85, "kind": "action", "text": "Then she lifts her head and her face changes.", "para": 12, "sent": 4, "present": [0, 1, 2]}, {"u": 86, "kind": "dialogue", "text": "There.", "name": "PILAR", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 87, "kind": "action", "text": "Faint on the monitor, a single beep.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 88, "kind": "action", "text": "Another.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 89, "kind": "action", "text": "A rhythm.", "para": 13, "sent": 2, "present": [0, 1, 2]}, {"u": 90, "kind": "dialogue", "text": "Thank God.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 91, "kind": "dialogue", "text": "Don't thank him yet. Keep that clamp in.", "name": "PILAR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 92, "kind": "action", "text": "He picks it up.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 93, "kind": "action", "text": "His hand shakes.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 94, "kind": "action", "text": "She steadies it with her own.", "para": 14, "sent": 2, "present": [0, 1, 2]}, {"u": 95, "kind": "action", "text": "Both of them stay like that, hands clasped around cold steel, while the water slaps outside.", "para": 14, "sent": 3, "present": [0, 1, 2]}, {"u": 96, "kind": "dialogue", "text": "Mam?", "name": "CORMAC", "speaker": 2, "ext": [], "paren": ["barely audible"], "dual": false, "present": [0, 1, 2]}, {"u": 97, "kind": "dialogue", "text": "She's coming.", "name": "YUSUF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 98, "kind": "dialogue", "text": "Hold on, Cormac.", "name": "PILAR", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}]}