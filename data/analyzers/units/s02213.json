{"scene_id": "s02213", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02213.fountain", "heading": "INT. DEPARTMENT STORE - SERVICE ELEVATOR - NIGHT", "cast": [{"id": 0, "name": "TEDDY", "names": ["TEDDY"], "gender": "f", "first": 4, "spoke": 14}, {"id": 1, "name": "ROYCE", "names": ["ROYCE"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "BASTIEN NOVAK", "names": ["BASTIEN NOVAK", "BASTIEN"], "gender": "m", "first": 5, "spoke": 17}, {"id": 3, "name": "MOTH", "names": ["MOTH"], "gender": "?", "first": 6, "spoke": 11}], "units": [{"u": 0, "kind": "heading", "text": "INT. DEPARTMENT STORE - SERVICE ELEVATOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cargo lift, steel-lined, scarred by trolleys.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "One bare bulb.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The floor indicator is stuck between 3 and 4.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "THEODORA \"TEDDY\" ROYCE (50s, night cleaner, bucket at her feet) sits on an overturned crate, holding a rosary.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Opposite her, BASTIEN NOVAK (20s, security guard, uniform askew) leans against the wall, torch dead in his hand.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "In the corner, a girl in a nightgown, MOTH (9, bare feet, huge eyes), hugs a stuffed rabbit.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "How long have we been in here?", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Forty minutes.", "name": "BASTIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "It feels like four hours.", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "It feels like forty minutes, Teddy.", "name": "BASTIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "You counted?", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "I looked at my watch.", "name": "BASTIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Your watch stopped.", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "It didn't stop.", "name": "BASTIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Show me.", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "He turns his wrist.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "The second hand is frozen at 11:47.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "He stares at it.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Looks up.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Then his face gives away nothing at all.", "para": 2, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "It's the battery.", "name": "BASTIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "It's the elevator.", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Elevators don't stop watches.", "name": "BASTIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "This one does.", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Teddy, I'm cold.", "name": "MOTH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "I know, sweetheart.", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Can we go home?", "name": "MOTH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Where's home, kid?", "name": "BASTIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Down.", "name": "MOTH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Down where?", "name": "BASTIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Down below the basement.", "name": "MOTH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Teddy lowers her rosary.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Bastien's mouth opens, then closes.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "There's no below the basement.", "name": "BASTIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "There is.", "name": "MOTH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Moth, stop.", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "You said I could tell.", "name": "MOTH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "I said you could tell me. Not him.", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Tell me what?", "name": "BASTIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "That's where they keep the ones who stay.", "name": "MOTH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Stay where?", "name": "BASTIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Stay in the store.", "name": "MOTH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "This is a department store, kid.", "name": "BASTIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "After closing.", "name": "MOTH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Teddy puts a hand on Bastien's arm.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "He shakes it off.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Teddy. Who is she?", "name": "BASTIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "She's. A friend.", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Whose friend?", "name": "BASTIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "She was here before the store was.", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Before the store?", "name": "BASTIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "This was a farm. Her family's. Her father sold it. Her mother wouldn't leave.", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "That was a hundred years ago.", "name": "BASTIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "One hundred and eleven.", "name": "TEDDY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "I'm nine.", "name": "MOTH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "You're nine.", "name": "BASTIEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "Always nine.", "name": "MOTH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "The bulb dims.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "Bastien backs into the corner, torch up like a club.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "Teddy doesn't move.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "Moth looks at him, tilts her head, and takes a step.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "The bulb pops.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "Dark.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "In the black, the elevator groans and begins to descend.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "The only sound is the rabbit being squeezed, a thin squeak, and a girl's voice humming a lullaby that is somehow older than anything in the building.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "Bastien's torch clicks on, flickers, shows the lift empty but for the bucket and the crate.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "Teddy's rosary lies on the floor.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "A small wet footprint beside it, bare and tiny.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "Another, leading to the doors.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "The lift stops.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "action", "text": "The doors open on a long dark corridor, floor tiled in black and white, and at the end of it, a little girl waving.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}]}