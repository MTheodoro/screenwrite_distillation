{"scene_id": "s02214", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02214.fountain", "heading": "INT. LOCKED PENTHOUSE OFFICE - NIGHT", "cast": [{"id": 0, "name": "KENNETH ADLER-MOSS", "names": ["KENNETH ADLER-MOSS", "ADLER-MOSS"], "gender": "?", "first": 5, "spoke": 10}, {"id": 1, "name": "NADINE CRUZ", "names": ["NADINE CRUZ", "NADINE"], "gender": "f", "first": 10, "spoke": 11}, {"id": 2, "name": "VOICE", "names": ["VOICE"], "gender": "?", "first": 13, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. LOCKED PENTHOUSE OFFICE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Glass walls over a rain-slick city.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A desk the size of a pool table.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A bank of five monitors, three dark.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "On the carpet, a spilled glass of scotch and a pair of reading glasses, one lens cracked.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "KENNETH ADLER-MOSS (60s, tycoon, silk shirt open at the throat) sits behind the desk with a phone gripped in both hands.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Sweat beads at his hairline.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "A pistol lies on the blotter, six inches from his right hand.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "He has not touched it.", "para": 1, "sent": 3, "present": [0]}, {"u": 9, "kind": "action", "text": "Across the desk, in the visitor's chair, a woman.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "NADINE CRUZ (30s, black coat, patient eyes) rests her chin on folded hands.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She hasn't spoken in minutes.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "A speakerphone on the desk crackles.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Mr. Adler-Moss? Mr. Adler-Moss, it's the front desk. We have police in the lobby.", "name": "VOICE", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Tell them. Tell them to come up.", "name": "ADLER-MOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Sir, the elevator is out. They'll take the stairs.", "name": "VOICE", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "How many floors?", "name": "ADLER-MOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Forty-one, sir.", "name": "VOICE", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Forty-one. Christ.", "name": "ADLER-MOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Nadine unfolds her hands.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Adler-Moss flinches.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "She reaches into her coat, slowly, and pulls out a folded sheet of paper.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "She slides it across the desk.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "He doesn't take it.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Read it.", "name": "NADINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "What is it?", "name": "ADLER-MOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Your signature.", "name": "NADINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "I don't sign things I haven't read.", "name": "ADLER-MOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "You signed this one.", "name": "NADINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "He picks it up with two fingers.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Reads.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "His colour drains.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "He reads it again.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "This is forged.", "name": "ADLER-MOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "It's notarised.", "name": "NADINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "By whom?", "name": "ADLER-MOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "By a man who's very sorry.", "name": "NADINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "The speakerphone crackles.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "The lobby voice is shaking now.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Sir? Sir, are you there?", "name": "VOICE", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "He's here.", "name": "NADINE", "speaker": 1, "ext": [], "paren": ["to the phone, calm"], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Who is that?", "name": "VOICE", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "The reason you won't need the police.", "name": "NADINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "She lifts her hand, finger hovering over the disconnect key.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Adler-Moss lunges for the pistol.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Nadine slams the button.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Static.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "The line goes dead.", "para": 7, "sent": 4, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "The pistol is in his hand, shaking.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "She doesn't move.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "I'll shoot.", "name": "ADLER-MOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "You won't.", "name": "NADINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "I will.", "name": "ADLER-MOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "You can't. It isn't loaded.", "name": "NADINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "He stares at the gun.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Checks the chamber.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Empty.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Checks the magazine.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Empty.", "para": 9, "sent": 4, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "I took them out at seven.", "name": "NADINE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "You were here at seven?", "name": "ADLER-MOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "I've been here since lunch.", "name": "NADINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "Below them, very faintly, boots on concrete.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "A distant door slamming.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "Voices.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "Coming up.", "para": 10, "sent": 3, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "Nadine stands, buttons her coat, and for the first time smiles.", "para": 11, "sent": 0, "present": [0, 1, 2]}]}