{"scene_id": "s02215", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02215.fountain", "heading": "INT. UNDERGROUND SQUASH COURT - NIGHT", "cast": [{"id": 0, "name": "CITY SQUASH LEAGUE FINALS", "names": ["CITY SQUASH LEAGUE FINALS"], "gender": "?", "first": 3, "spoke": 0}, {"id": 1, "name": "COACH WINIFRED BAPTISTE", "names": ["COACH WINIFRED BAPTISTE", "COACH BAPTISTE"], "gender": "f", "first": 4, "spoke": 13}, {"id": 2, "name": "TOMMIE", "names": ["TOMMIE"], "gender": "?", "first": 5, "spoke": 8}, {"id": 3, "name": "VAUGHN", "names": ["VAUGHN"], "gender": "?", "first": 5, "spoke": 0}, {"id": 4, "name": "LENORE ASHCROFT", "names": ["LENORE ASHCROFT", "LENORE"], "gender": "f", "first": 23, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. UNDERGROUND SQUASH COURT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A glass-backed court under a bare basement vault.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Brick pillars, pipes, one hanging fluorescent.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A banner on the back wall: CITY SQUASH LEAGUE FINALS - TIED 2-2.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "COACH WINIFRED BAPTISTE (50s, weathered, towel around her neck) kneels at the sidewall, tying a young player's shoe.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "TOMASINA \"TOMMIE\" VAUGHN (20s, wiry, headband) bounces a ball against the front wall, thwack, thwack, thwack.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "dialogue", "text": "Fifteen minutes. Hydrate.", "name": "COACH BAPTISTE", "speaker": 1, "ext": [], "paren": ["to the court"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Coach, I'm fine.", "name": "TOMMIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "I wasn't talking to you.", "name": "COACH BAPTISTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Then who?", "name": "TOMMIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "The universe.", "name": "COACH BAPTISTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Tommie laughs.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "The ball rebounds.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "She catches it one-handed.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Tommie. Listen.", "name": "COACH BAPTISTE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "I'm listening.", "name": "TOMMIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "She hits down the wall on every second serve. You know it.", "name": "COACH BAPTISTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "I know it.", "name": "TOMMIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Cut it off at the T.", "name": "COACH BAPTISTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "At the T.", "name": "TOMMIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "And don't go chasing winners. Wait for her to give you one.", "name": "COACH BAPTISTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "The glass door at the back of the court swings open.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "A tall woman in a navy tracksuit enters, bag over one shoulder, the quiet confidence of someone who has never lost in this building.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "This is LENORE ASHCROFT (40s, former national champion, silver in her hair).", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Winnie.", "name": "LENORE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Lenore.", "name": "COACH BAPTISTE", "speaker": 1, "ext": [], "paren": ["without turning"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Heard you had a final.", "name": "LENORE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Heard you were retired.", "name": "COACH BAPTISTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "I am. I'm here to watch.", "name": "LENORE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Sit anywhere. Not in my line of sight.", "name": "COACH BAPTISTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Lenore smiles and takes a seat in the gallery, high up in the dark.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Tommie looks from one to the other.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "The ball stops.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Who's that?", "name": "TOMMIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "My old partner.", "name": "COACH BAPTISTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "She looks like she's judging me.", "name": "TOMMIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "She is.", "name": "COACH BAPTISTE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Great. Great.", "name": "TOMMIE", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Fifteen minutes. Hydrate.", "name": "COACH BAPTISTE", "speaker": 1, "ext": [], "paren": ["to the court"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Hit the wall, Tommie. Not the ball.", "name": "LENORE", "speaker": 4, "ext": [], "paren": ["calling from the gallery"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Tommie looks up.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "A long pause.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Then she turns to the front wall and lets the ball go.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}]}