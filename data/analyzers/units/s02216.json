{"scene_id": "s02216", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02216.fountain", "heading": "EXT. SALT-LICK CORRAL - DAWN", "cast": [{"id": 0, "name": "OLD BASIL TREADWELL", "names": ["OLD BASIL TREADWELL", "BASIL"], "gender": "m", "first": 7, "spoke": 20}, {"id": 1, "name": "JUNIPER TREADWELL", "names": ["JUNIPER TREADWELL", "JUNIPER"], "gender": "?", "first": 7, "spoke": 18}, {"id": 2, "name": "SEVERIN KOZLOWSKI", "names": ["SEVERIN KOZLOWSKI", "SEVERIN"], "gender": "m", "first": 9, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SALT-LICK CORRAL - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A split-rail corral at the edge of the badlands.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single bare cottonwood.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Pink light climbing a ridge.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Frost on the rails.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "In the middle, a rangy bay horse tosses its head, tethered to a post.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "Three people.", "para": 1, "sent": 0, "present": []}, {"u": 7, "kind": "action", "text": "OLD BASIL TREADWELL (70s, rancher, leather vest, white whiskers) stands at the rail, rolling a cigarette.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "His grown daughter JUNIPER TREADWELL (30s, braid under a battered hat, rifle on her back) crouches at the horse's hoof, pretending to inspect it.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "And a hired hand, SEVERIN KOZLOWSKI (30s, quiet, one blue eye and one brown) leans on the post, coiling a lariat.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Nobody speaks.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Basil licks the paper.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Juniper runs a thumb over the horse's fetlock.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Got a stone in there?", "name": "BASIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Not yet.", "name": "JUNIPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Then why're you looking?", "name": "BASIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Habit.", "name": "JUNIPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Severin lets the rope fall.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "The horse stamps.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Frost smokes off the ground.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Your mother loved this animal.", "name": "BASIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "I remember.", "name": "JUNIPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "She'd have fed it sugar every morning.", "name": "BASIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "I remember that too.", "name": "JUNIPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Severin shifts his weight.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Basil does not look at him.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Juniper does.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Severin, fetch my saddle.", "name": "BASIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "It's in the barn, sir.", "name": "SEVERIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "I know where it is.", "name": "BASIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Severin doesn't move.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The horse tugs at the tether.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Pa.", "name": "JUNIPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Don't Pa me.", "name": "BASIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "He doesn't have to go.", "name": "JUNIPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "He's a hired hand.", "name": "BASIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "He's staying.", "name": "JUNIPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Basil finally looks at Severin.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "A long moment.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "The old man's eyes are wet but it could be the cold.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Fine.", "name": "BASIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "He finishes rolling the cigarette.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Strikes a match on the rail.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "The flame trembles in the dawn light.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "He lights it.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Smoke curls up past the cottonwood.", "para": 8, "sent": 4, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "You never answered me.", "name": "JUNIPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "About what?", "name": "BASIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "About the letter.", "name": "JUNIPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "What letter?", "name": "BASIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "The one you wrote and didn't send.", "name": "JUNIPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Basil takes a long drag.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Severin takes a step toward the horse.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Juniper rises.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "Burn it.", "name": "BASIL", "speaker": 0, "ext": [], "paren": ["very quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "I read it.", "name": "JUNIPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "Then you know.", "name": "BASIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "I know you sold the north pasture.", "name": "JUNIPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Silence.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "The horse breathes steam.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "Severin takes the lariat and slings it over his shoulder.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "Basil hurls the cigarette to the dirt and grinds it under his heel.", "para": 10, "sent": 3, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "To him.", "name": "BASIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "He doesn't point.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "He doesn't need to.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "Severin looks at the ground.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "Juniper looks at Severin.", "para": 11, "sent": 3, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "Then at her father.", "para": 11, "sent": 4, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "A thin wind rattles the frost off the cottonwood leaves.", "para": 11, "sent": 5, "present": [0, 1, 2]}, {"u": 69, "kind": "dialogue", "text": "You sold it to the hired man.", "name": "JUNIPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 70, "kind": "dialogue", "text": "It was fair.", "name": "BASIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 71, "kind": "dialogue", "text": "It was my mother's land.", "name": "JUNIPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 72, "kind": "dialogue", "text": "It was my land.", "name": "BASIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 73, "kind": "dialogue", "text": "She gave it to you.", "name": "JUNIPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 74, "kind": "dialogue", "text": "And I gave it to him. Because he asked.", "name": "BASIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 75, "kind": "action", "text": "Severin lifts his head.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 76, "kind": "action", "text": "Juniper lunges.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 77, "kind": "action", "text": "He sidesteps; she slams into the post, hand on his shirt, knuckles white.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 78, "kind": "action", "text": "The horse shies, ropes snapping taut.", "para": 12, "sent": 3, "present": [0, 1, 2]}, {"u": 79, "kind": "action", "text": "Basil steps between them, one arm up, the old man suddenly very strong.", "para": 12, "sent": 4, "present": [0, 1, 2]}, {"u": 80, "kind": "dialogue", "text": "Enough!", "name": "BASIL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 81, "kind": "action", "text": "They freeze: Juniper with her fist in Severin's shirt, Severin with both hands raised, Basil with his arm between.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 82, "kind": "action", "text": "The horse screams and settles.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 83, "kind": "action", "text": "Nobody breathes.", "para": 13, "sent": 2, "present": [0, 1, 2]}, {"u": 84, "kind": "dialogue", "text": "You didn't tell me.", "name": "JUNIPER", "speaker": 1, "ext": [], "paren": ["low, to Severin"], "dual": false, "present": [0, 1, 2]}, {"u": 85, "kind": "dialogue", "text": "He asked me not to.", "name": "SEVERIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 86, "kind": "dialogue", "text": "Why?", "name": "JUNIPER", "speaker": 1, "ext": [], "paren": ["to her father"], "dual": false, "present": [0, 1, 2]}, {"u": 87, "kind": "dialogue", "text": "Because you'd have fought. Like you're fighting now.", "name": "BASIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 88, "kind": "action", "text": "She lets go of the shirt slowly, one finger at a time.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 89, "kind": "action", "text": "Steps back.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 90, "kind": "action", "text": "Wipes her mouth.", "para": 14, "sent": 2, "present": [0, 1, 2]}, {"u": 91, "kind": "action", "text": "Looks at the pink light cresting the ridge.", "para": 14, "sent": 3, "present": [0, 1, 2]}, {"u": 92, "kind": "dialogue", "text": "Four generations.", "name": "JUNIPER", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 93, "kind": "dialogue", "text": "Five, if you stay.", "name": "BASIL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 94, "kind": "action", "text": "She doesn't answer.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 95, "kind": "action", "text": "She unslings the rifle, props it against the post, and goes to the horse.", "para": 15, "sent": 1, "present": [0, 1, 2]}, {"u": 96, "kind": "action", "text": "She puts her cheek against its neck.", "para": 15, "sent": 2, "present": [0, 1, 2]}, {"u": 97, "kind": "action", "text": "Basil and Severin stand there, apart, while the sun lifts over the ridge and floods the frozen yard.", "para": 15, "sent": 3, "present": [0, 1, 2]}]}