{"scene_id": "s02217", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02217.fountain", "heading": "INT. VETERINARY HOSPITAL - SURGERY SUITE - 2 A.M.", "cast": [{"id": 0, "name": "ISADORA KEMP", "names": ["ISADORA KEMP", "ISADORA"], "gender": "?", "first": 4, "spoke": 13}, {"id": 1, "name": "TECH PRESTON LI", "names": ["TECH PRESTON LI", "PRESTON"], "gender": "m", "first": 5, "spoke": 6}, {"id": 2, "name": "ARTHUR BELL", "names": ["ARTHUR BELL", "MR. BELL"], "gender": "m", "first": 6, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. VETERINARY HOSPITAL - SURGERY SUITE - 2 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "Stainless steel, a hush of oxygen.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "On the table, a golden retriever under anaesthesia, chest rising slow.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A heart monitor chirps in a calm rhythm.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. ISADORA KEMP (40s, surgeon, mask down) scrubs at the sink.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "TECH PRESTON LI (20s, scrubs with cartoon dogs) prepares instruments.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "OWNER MR. ARTHUR BELL (70s, cardigan, trembling) watches from the window of the observation room, his palm flat against the glass.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Preston, ready?", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Ready.", "name": "PRESTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Blade.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "He hands it over.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "She works without ceremony, a quick incision.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "The retriever's belly opens clean.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She examines the field, brow furrowing.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "How's it look?", "name": "PRESTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Better than the X-ray.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Good.", "name": "PRESTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Much better.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "She reaches in.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Withdraws a twisted length of blue cloth, glistening.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Holds it to the light.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Everyone, we found it.", "name": "ISADORA", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the room"], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "The intercom crackles.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Mr. Bell's voice, thin and anxious, from the observation room.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Is that.", "name": "MR. BELL", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "A sock, Mr. Bell.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "It's blue.", "name": "MR. BELL", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "It is.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "It's Margaret's.", "name": "MR. BELL", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Margaret's sock?", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "She left them. When she died. I couldn't throw them away.", "name": "MR. BELL", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Isadora stops.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Preston looks at her.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "She lowers the sock into the tray, quietly, as if it were glass.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Mr. Bell, we'll clean it.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Please.", "name": "MR. BELL", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Preston, put it in a bag.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Yes, Doctor.", "name": "PRESTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "A clean bag.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "A very clean bag.", "name": "PRESTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "The monitor chirps.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "The retriever sighs in her sleep.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Who eats a sock.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": ["to herself, almost"], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "A dog in grief.", "name": "PRESTON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "I think so, yes.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "She resumes.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "The incision closes under her hands, stitch after stitch.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Preston wipes his eyes with the back of his glove.", "para": 7, "sent": 2, "present": [0, 1, 2]}]}