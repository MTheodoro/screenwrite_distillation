{"scene_id": "s02218", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02218.fountain", "heading": "INT. COUNTY JAIL - ATTORNEY VISITING ROOM - AFTERNOON", "cast": [{"id": 0, "name": "CORA WINSLOW-ABBOTT", "names": ["CORA WINSLOW-ABBOTT", "CORA"], "gender": "f", "first": 4, "spoke": 20}, {"id": 1, "name": "LILY", "names": ["LILY"], "gender": "f", "first": 5, "spoke": 19}, {"id": 2, "name": "MARSTON", "names": ["MARSTON"], "gender": "?", "first": 5, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. COUNTY JAIL - ATTORNEY VISITING ROOM - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "A grey cinderblock cell, steel table bolted to the floor, two plastic chairs.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A one-way window in the far wall.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A fluorescent light buzzes.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CORA WINSLOW-ABBOTT (30s, defence attorney, rolled sleeves, legal pad) sits with a pen clicking.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across from her, in an orange jumpsuit, sits LILLIAN \"LILY\" MARSTON (30s, accountant, cuffed hands, composed face).", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "Neither has blinked in a while.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Lily. Start at the beginning.", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "I'd rather start in the middle.", "name": "LILY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "That's not how it works.", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "It's how I work.", "name": "LILY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Cora sets her pen down.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Folds her hands.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Where were you at nine on the night of the fourteenth?", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "At the office.", "name": "LILY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Alone?", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "With Brenda. She was in the next room.", "name": "LILY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Brenda says she wasn't.", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Brenda says a lot of things.", "name": "LILY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "For the record, the client is being difficult.", "name": "CORA", "speaker": 0, "ext": [], "paren": ["to the window"], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I'm not difficult. I'm precise.", "name": "LILY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "You were precise when you moved four million dollars.", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "I was precise when I moved it back.", "name": "LILY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Back?", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "She took it first.", "name": "LILY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Who did?", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Brenda.", "name": "LILY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "She says you did.", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "She lies.", "name": "LILY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "They both do.", "name": "CORA", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "What was that?", "name": "LILY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Nothing. Notes to myself.", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "She scrawls on the legal pad.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Lily watches the pen.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "You think I'm guilty.", "name": "LILY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "I think you're interesting.", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "That's not an answer.", "name": "LILY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "It's the only honest one I have.", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Fine.", "name": "LILY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "She leans back.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "The chain between her wrists clinks against the table.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Cora meets her eyes.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Here's what I know. She says you stole it. You say she stole it. One of you is right.", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "One of us is.", "name": "LILY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Or neither.", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Then who?", "name": "LILY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "That's what I intend to find out.", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "She stands, gathers the pad.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Lily looks at her hands.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Cora.", "name": "LILY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Yes?", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "She took the accounts at eight-fifteen. I have the logs.", "name": "LILY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Where?", "name": "CORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "In my head.", "name": "LILY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Cora stops with her hand on the door.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "Of course.", "name": "CORA", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2]}]}