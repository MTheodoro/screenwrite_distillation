{"scene_id": "s02219", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02219.fountain", "heading": "INT. LAUNDROMAT - DAWN", "cast": [{"id": 0, "name": "MARTHA OYELARAN-COLE", "names": ["MARTHA OYELARAN-COLE", "MARTHA"], "gender": "?", "first": 5, "spoke": 7}, {"id": 1, "name": "KAYLA", "names": ["KAYLA"], "gender": "f", "first": 6, "spoke": 1}, {"id": 2, "name": "ARTURO VEGA", "names": ["ARTURO VEGA", "ARTURO"], "gender": "?", "first": 7, "spoke": 3}, {"id": 3, "name": "DESIREE BLANCHARD", "names": ["DESIREE BLANCHARD", "DESIREE"], "gender": "?", "first": 8, "spoke": 2}, {"id": 4, "name": "OKONKWO-PRICE", "names": ["OKONKWO-PRICE", "MR. OKONKWO-PRICE"], "gender": "?", "first": 9, "spoke": 1}, {"id": 5, "name": "SOLANGE DELACROIX", "names": ["SOLANGE DELACROIX", "SOLANGE"], "gender": "?", "first": 25, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAUNDROMAT - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Humming machines, a bank of dryers.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A flickering neon sign reads OPEN 24 HRS.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain-streaked windows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A vending machine glows in the corner.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MARTHA OYELARAN-COLE (60s, thick glasses, cardigan) folds sheets with practised precision.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "At the next table, her granddaughter KAYLA (16, headphones, school hoodie) sorts socks without looking up.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Beside them, ARTURO VEGA (40s, delivery driver, wet jacket) feeds quarters into a washer.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "DESIREE BLANCHARD (30s, nurse in scrubs) dozes in a plastic chair.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "And the attendant, MR. OKONKWO-PRICE (70s, bowtie, name tag), mops by the door.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Quiet.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Only machines.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "You'll want the warm cycle for those.", "name": "MARTHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "They're socks, Gran.", "name": "KAYLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Warm.", "name": "MARTHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Kayla pulls out an earbud and drops a bundle into the machine.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Arturo glances at her, then at Martha.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "I'm sorry, is this machine free?", "name": "ARTURO", "speaker": 2, "ext": [], "paren": ["to Martha"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "That one's broken.", "name": "MARTHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "It took my quarters.", "name": "ARTURO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "It does that.", "name": "MARTHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "I'll refund you, sir.", "name": "MR. OKONKWO-PRICE", "speaker": 4, "ext": [], "paren": ["from the door"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Thank you.", "name": "ARTURO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "The bell above the door jingles.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "A woman in a black dress and mud-streaked heels enters, a garbage bag of clothing in her arms, mascara tracks on her cheeks.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "This is SOLANGE DELACROIX (30s, composed but wrecked).", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Everyone looks at her and then pretends they didn't.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Is there a free machine?", "name": "SOLANGE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Number six.", "name": "MARTHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Thank you.", "name": "SOLANGE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "She crosses to number six.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Loads the bag.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Pours detergent from a bottle she takes out of her purse.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Starts it with a shaking hand.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Stands there, watching it fill.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Desiree stirs.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Her eyes open on the dress, on the heels.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Rough night?", "name": "DESIREE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Rough morning.", "name": "SOLANGE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "I'm sorry.", "name": "DESIREE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Don't be.", "name": "SOLANGE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Kayla puts the earbuds in her pocket.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Martha folds a pillowcase, then another.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "She places one on top of Solange's bag, quietly.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "For your head.", "name": "MARTHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Solange stares at it.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Then at Martha.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "She sits on the bench beside her, folds her hands, and for the first time looks up, directly at the old woman.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "Thank you.", "name": "SOLANGE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "Everyone ends up in a laundromat eventually.", "name": "MARTHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "The machines hum.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Somewhere a dryer buzzes, and no one moves to open it.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}