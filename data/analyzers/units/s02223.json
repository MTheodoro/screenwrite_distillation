{"scene_id": "s02223", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02223.fountain", "heading": "EXT. FLOODED RICE PADDY DYKE - DAWN", "cast": [{"id": 0, "name": "CORPORAL HARUTO MIZUNO", "names": ["CORPORAL HARUTO MIZUNO", "MIZUNO"], "gender": "?", "first": 3, "spoke": 7}, {"id": 1, "name": "PRIVATE EMEKA OBI", "names": ["PRIVATE EMEKA OBI", "OBI"], "gender": "m", "first": 4, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FLOODED RICE PADDY DYKE - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Mist hangs over the water.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A broken dyke, a line of mud, a burned-out ox cart half sunk.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "CORPORAL HARUTO MIZUNO, twenties, helmet strap loose, sits on the cart's axle cleaning a rifle bolt with a rag.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "Beside him, PRIVATE EMEKA OBI, nineteen, thin, holds a tin cup of tea with both hands.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "It's quiet.", "name": "OBI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "It's been quiet since yesterday.", "name": "MIZUNO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Is that good?", "name": "OBI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "It's quiet.", "name": "MIZUNO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Obi sips.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Grimaces.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "This tastes like smoke.", "name": "OBI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Everything tastes like smoke.", "name": "MIZUNO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Mizuno reassembles the bolt, slides it home, works the action once.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "My mother says the fog is the spirits of the rice.", "name": "OBI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "My mother says it's the river breathing.", "name": "MIZUNO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "They would get along.", "name": "OBI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "They would argue.", "name": "MIZUNO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Yes. About the rice.", "name": "OBI", "speaker": 1, "ext": [], "paren": ["smiling"], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Distant, a cock crows.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Both men look up toward the sound.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "That's a good sign.", "name": "MIZUNO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Or the farm still has someone in it.", "name": "OBI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "They answer the same moment, quiet.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "We should check.", "name": "MIZUNO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "We should check.", "name": "OBI", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "They stand.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Mizuno shoulders the rifle.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Obi pours the last of the tea into the water and follows him along the dyke into the mist.", "para": 6, "sent": 2, "present": [0, 1]}]}