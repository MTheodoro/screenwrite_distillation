{"scene_id": "s02225", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02225.fountain", "heading": "INT. FUNICULAR CAR MIDWAY UP A MOUNTAIN - NIGHT", "cast": [{"id": 0, "name": "REUBEN FAIRCHILD", "names": ["REUBEN FAIRCHILD", "REUBEN"], "gender": "m", "first": 4, "spoke": 11}, {"id": 1, "name": "KASIMIR VOSS", "names": ["KASIMIR VOSS", "KASIMIR"], "gender": "m", "first": 5, "spoke": 11}, {"id": 2, "name": "ODALYS", "names": ["ODALYS"], "gender": "?", "first": 12, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. FUNICULAR CAR MIDWAY UP A MOUNTAIN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A wooden cable car, stopped dead on a steep track.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wind rattles the windows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Below, a hotel's lights glitter in the valley.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "REUBEN FAIRCHILD, forties, gray tuxedo, kneels by a floor panel with a pry bar.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "KASIMIR VOSS, thirties, black tuxedo, holds a flashlight and watches the track behind them.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Each wears a small earpiece.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Cable's steady. We have maybe six minutes.", "name": "KASIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Four, if she's right.", "name": "REUBEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He pries the panel.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "It lifts.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Beneath it, a steel lockbox bolted to the frame.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Gentlemen, the hotel's night manager just left his office. He's walking to the lift station.", "name": "ODALYS", "speaker": 2, "ext": ["V.O."], "paren": ["in their earpieces, calm"], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "How long to get here?", "name": "KASIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Walking? Ten minutes. If he notices the car's stopped, he'll run.", "name": "ODALYS", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Then let's not make him notice.", "name": "REUBEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Reuben takes a thin case from his jacket and opens it.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Lockpicks, a stethoscope.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "He hangs the stethoscope around his neck and presses the diaphragm to the box.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "You said it was a four-digit lock.", "name": "KASIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "It's a six-digit lock.", "name": "REUBEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "You said four.", "name": "KASIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "I said four minutes.", "name": "REUBEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Kasimir lets that go.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "He turns the flashlight off.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Darkness, then the pale blue of mountain night.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "I'm watching the manager. He's stopped. He's looking up at the track.", "name": "ODALYS", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Stopped?", "name": "KASIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Stopped. Pulling out a phone.", "name": "ODALYS", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Reuben's hands freeze on the dial.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Kasimir leans toward the window, one hand on his gun.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Odalys. Is he calling the lift station?", "name": "REUBEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Hold on.", "name": "ODALYS", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "A long silence.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Wind.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "The car creaks.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Reuben's breath fogs the glass.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "He's seen the car. He knows.", "name": "KASIMIR", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "He doesn't know.", "name": "REUBEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "He has a phone in his hand.", "name": "KASIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "He has a phone. That's all he has.", "name": "REUBEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Reuben turns the dial again.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "A click.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Another.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "He's dialing. Oh, he's dialing the front desk, not the lift. The front desk.", "name": "ODALYS", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "That's a different thing?", "name": "KASIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "It's a sleepy clerk with a cold. That's a very different thing.", "name": "ODALYS", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Click.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Click.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Reuben's face.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "The lock drops.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "He lifts the lid.", "para": 8, "sent": 4, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Inside, a velvet pouch.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "He opens it.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "A stone the size of a plum catches the blue light.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "That is the ugliest diamond I have ever seen.", "name": "KASIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "It's a spinel. Worth three diamonds.", "name": "REUBEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "Boys, the manager's put the phone away. He's shrugging. He's walking back to the hotel.", "name": "ODALYS", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Kasimir lets out a laugh he's been holding.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Reuben closes the lid, slides the pouch inside his coat, drops the panel back into place.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "And that's it?", "name": "KASIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "That's it.", "name": "REUBEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "The car lurches.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "Starts to move again, upward, humming.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "Somebody just turned the power back on. You've got ninety seconds to the top station.", "name": "ODALYS", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "Ninety seconds to look like we belong at a gala.", "name": "KASIMIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "Reuben straightens his bow tie.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "Kasimir slicks his hair.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "The car glides on up the mountain toward the lights.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 69, "kind": "dialogue", "text": "Nobody ever looks at the men in the funicular.", "name": "REUBEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 70, "kind": "dialogue", "text": "I'm looking at you.", "name": "ODALYS", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 71, "kind": "dialogue", "text": "Nobody but you.", "name": "REUBEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}