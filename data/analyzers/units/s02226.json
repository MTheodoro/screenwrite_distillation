{"scene_id": "s02226", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02226.fountain", "heading": "EXT. SALT FLAT - DAY", "cast": [{"id": 0, "name": "NGAIO", "names": ["NGAIO"], "gender": "?", "first": 5, "spoke": 15}, {"id": 1, "name": "TOMASZ", "names": ["TOMASZ"], "gender": "m", "first": 6, "spoke": 11}, {"id": 2, "name": "LUPE", "names": ["LUPE"], "gender": "f", "first": 7, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SALT FLAT - DAY", "present": []}, {"u": 1, "kind": "action", "text": "White to the horizon.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Heat shimmers.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The wreck of a Land Cruiser sits on its roof, tires blown, one door off.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Under a tarp rigged from the open hatch sit three survivors.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "NGAIO, fifties, a Maori geologist, cracked lips, a wide-brimmed hat held on with a scarf.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "TOMASZ, thirties, the driver, sunburned face, an arm in a makeshift sling.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "LUPE, nineteen, a student, barefoot, her boots set neatly beside her.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Ngaio unscrews a canteen.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "A mouthful of water for each of them.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "No more.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "One sip. Hold it. Count to ten.", "name": "NGAIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Give me two sips. I'm bigger than the girl.", "name": "TOMASZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "I'm right here, Tomasz.", "name": "LUPE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I know you're here.", "name": "TOMASZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "You get the same as the rest of us. That's the rule.", "name": "NGAIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Whose rule?", "name": "TOMASZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Mine. I've got the canteen.", "name": "NGAIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Tomasz grunts.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Takes his sip.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Holds it.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "His eyes close.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Do you think they know we're missing?", "name": "LUPE", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "The lodge expects us at six tonight.", "name": "NGAIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "They'll look tomorrow.", "name": "TOMASZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "That's too late, isn't it?", "name": "LUPE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Not if we're careful with the water.", "name": "NGAIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "And the heat.", "name": "TOMASZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "And the heat. We walk at dusk. East, toward the ridge. The salt is hard there, you won't sink.", "name": "NGAIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "How far?", "name": "LUPE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Twenty kilometers.", "name": "TOMASZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Twenty-two.", "name": "NGAIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Twenty-two.", "name": "TOMASZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Okay. Okay.", "name": "LUPE", "speaker": 2, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "A wind rises, spinning a small white devil of salt.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "It passes.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "The tarp snaps.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "There. See that? Wind means weather turning. By dark, it'll cool.", "name": "NGAIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "You say that like you've done this.", "name": "TOMASZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Thirty years of fieldwork. I've been lost on flats before.", "name": "NGAIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Were you scared?", "name": "LUPE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Every time.", "name": "NGAIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Lupe laughs, a small cracked sound.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Tomasz almost smiles.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Then what's the trick?", "name": "TOMASZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "You stop looking at the horizon. It lies. You look at your feet and the next step.", "name": "NGAIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "That's a lousy trick.", "name": "TOMASZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "It's the only one.", "name": "NGAIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Can I try the canteen again?", "name": "LUPE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "No.", "name": "NGAIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Tomasz?", "name": "LUPE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "She said no, Lupe.", "name": "TOMASZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "I'm just asking!", "name": "LUPE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Both of you. Sit. Rest. We have eight hours.", "name": "NGAIO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "They settle.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Lupe lays her head on her knees.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Tomasz studies his sling.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Ngaio watches the white horizon, unmoving.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "Eight hours. Then we walk.", "name": "NGAIO", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}]}