{"scene_id": "s02227", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02227.fountain", "heading": "INT. CANDLELIT SALON - 1790S PARIS - NIGHT", "cast": [{"id": 0, "name": "JOSEPHINE LAURENT", "names": ["JOSEPHINE LAURENT", "JOSEPHINE"], "gender": "?", "first": 4, "spoke": 11}, {"id": 1, "name": "CALLOWAY", "names": ["CALLOWAY"], "gender": "?", "first": 5, "spoke": 12}], "units": [{"u": 0, "kind": "heading", "text": "INT. CANDLELIT SALON - 1790S PARIS - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A narrow room of mirrors.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "One candelabrum.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Shutters closed against the street.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "JOSEPHINE LAURENT, thirties, dressed in mourning black, stands at a writing desk.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "MR. CALLOWAY, fifties, an English banker in a travel coat, waits by the door, hat in hand.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "He clears his throat.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "She doesn't turn.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Madame.", "name": "CALLOWAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "She finishes sealing a letter.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Presses the wax.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Sets the signet down.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "You are late.", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "The barricades, Madame.", "name": "CALLOWAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "You are English. You could have walked through them.", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "He permits himself a small smile.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She turns at last, studies him.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "You have it?", "name": "CALLOWAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She slides open a drawer.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Takes out a leather folio.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Holds it against her chest.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "First, my passage.", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "He pulls a folded paper from his coat.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She takes it, reads.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Her shoulders loosen a fraction.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Then she tightens again.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "This is for one.", "name": "JOSEPHINE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "It is.", "name": "CALLOWAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "I have a daughter.", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "He says nothing.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "His jaw works.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "She lifts the folio, as if to put it back in the drawer.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Madame.", "name": "CALLOWAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "You said two.", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "I said I would try.", "name": "CALLOWAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "She closes the drawer on the folio.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Turns her back.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "He crosses the room in three strides, grips her elbow, then thinks better of it and lets go.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Forgive me.", "name": "CALLOWAY", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Get out.", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": ["without turning"], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "He doesn't move.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Shouts rise in the street.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "A bell.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Candles gutter.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "She flinches.", "para": 9, "sent": 4, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "He steps toward her and, this time, stops short, hat crushed in his hands.", "para": 9, "sent": 5, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "I will find a second passage.", "name": "CALLOWAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "When?", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "Three days.", "name": "CALLOWAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "We do not have three days.", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "He takes out his pocketbook.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "Counts notes onto the desk.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "A lot of them.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "She watches them stack.", "para": 10, "sent": 3, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "For the second ticket. Buy it from whoever you must.", "name": "CALLOWAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "She looks at the money.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "At him.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "Slowly, she opens the drawer again and hands him the folio.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "He tucks it inside his coat.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "She pockets the notes.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "For a moment neither moves.", "para": 12, "sent": 2, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "Thank you.", "name": "CALLOWAY", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "Do not thank me. Be quick.", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "He bows, stiff.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "Goes to the door.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "Hesitates with a hand on the latch.", "para": 13, "sent": 2, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "She will be safe.", "name": "CALLOWAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "She will be if you are honest.", "name": "JOSEPHINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "He nods once and slips out.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "She blows out the candles, one by one, until only the glow of the street shows through the shutters.", "para": 14, "sent": 1, "present": [0, 1]}]}