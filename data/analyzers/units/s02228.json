{"scene_id": "s02228", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02228.fountain", "heading": "INT. FLOODED PARISH CRYPT - NIGHT", "cast": [{"id": 0, "name": "DESSA OYELARAN", "names": ["DESSA OYELARAN", "DESSA"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "BARN", "names": ["BARN"], "gender": "f", "first": 5, "spoke": 4}, {"id": 2, "name": "HOLLIS", "names": ["HOLLIS"], "gender": "?", "first": 5, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. FLOODED PARISH CRYPT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Knee-deep black water.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Stone coffins break the surface like islands.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A lantern bobs on a plank.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DESSA OYELARAN, thirties, soaked, clutches a crowbar.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside her, BARNABY \"BARN\" HOLLIS, forties, a church sexton, grips the lantern with a shaking hand.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Dessa, don't move.", "name": "BARN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "I'm not moving.", "name": "DESSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Something touched my leg.", "name": "BARN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "That's the plank.", "name": "DESSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "The plank is under my other leg.", "name": "BARN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "The water ripples.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Both freeze.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "A pale hand rises from the nearest coffin lid, fingers spread, and lowers again.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Barn, run.", "name": "DESSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "They bolt.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "The lantern swings.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "The water erupts behind them.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "A tall, pale shape surges after, its mouth open.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Dessa swings the crowbar and catches it across the jaw.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Barn grabs her sleeve, drags her up the steps.", "para": 3, "sent": 5, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "They tumble through the iron door together and slam it.", "para": 3, "sent": 6, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Water laps behind the door.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Dessa. That was the vicar.", "name": "BARN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Yes, Barn. I know.", "name": "DESSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}