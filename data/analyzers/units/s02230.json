{"scene_id": "s02230", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02230.fountain", "heading": "INT. WINE CELLAR BENEATH A CASINO - NIGHT", "cast": [{"id": 0, "name": "TEO", "names": ["TEO"], "gender": "?", "first": 4, "spoke": 2}, {"id": 1, "name": "FERRIS", "names": ["FERRIS"], "gender": "?", "first": 5, "spoke": 3}, {"id": 2, "name": "LEV", "names": ["LEV"], "gender": "m", "first": 6, "spoke": 2}, {"id": 3, "name": "NADIA", "names": ["NADIA"], "gender": "?", "first": 7, "spoke": 3}, {"id": 4, "name": "WOMAN IN GREEN", "names": ["WOMAN GREEN", "WOMAN IN GREEN"], "gender": "f", "first": 8, "spoke": 5}, {"id": 5, "name": "IMANI", "names": ["IMANI"], "gender": "?", "first": 29, "spoke": 6}, {"id": 6, "name": "KESSLER", "names": ["KESSLER"], "gender": "?", "first": 46, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. WINE CELLAR BENEATH A CASINO - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Brick arches.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Oak racks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A security camera in a corner, its red light dead.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "TEO crouches at a steel vault door with a thermal lance.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "FERRIS stands lookout at the stairs.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "LEV unrolls a canvas bag.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "NADIA reads a tablet.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "A WOMAN IN GREEN, thirties, silk dress, heels in her hand, comes down the stairs.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "She is not part of the crew.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Everyone sees it.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "He draws a pistol.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "She raises her free hand.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Don't. I'm the one who killed the camera.", "name": "WOMAN IN GREEN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Nadia shrugs at Teo.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "He keeps working.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Who sent you?", "name": "FERRIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Nobody. I work upstairs.", "name": "WOMAN IN GREEN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Upstairs as in--", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Cage cashier. Eleven years.", "name": "WOMAN IN GREEN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "He stops unrolling the bag and studies her.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Why help us?", "name": "LEV", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Because the owner is walking down these stairs in four minutes.", "name": "WOMAN IN GREEN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Ferris's jaw tightens.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "He lowers the pistol.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Name.", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Does it matter?", "name": "WOMAN IN GREEN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "It does to me.", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "She sets her shoes on a barrel.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Imani.", "name": "IMANI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Nadia nods once.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Teo's lance sputters and dies.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "He sits back.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Door's open.", "name": "TEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "The vault swings out.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Inside, stacked bills.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Lev starts loading.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Ferris backs toward the stairs, listening.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "You have three minutes.", "name": "IMANI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Faster.", "name": "FERRIS", "speaker": 1, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Lev doubles his pace.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "She drops the tablet and helps.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Teo takes the door.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Footsteps above.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "A cough.", "para": 10, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "A chair scrapes.", "para": 10, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Imani? Is that you down there?", "name": "KESSLER", "speaker": 6, "ext": ["O.S."], "paren": ["from the stairwell, old and wheezing"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "She freezes.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "So does everyone.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "dialogue", "text": "Yes, Mr. Kessler. Counting the reserve.", "name": "IMANI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "dialogue", "text": "At this hour?", "name": "KESSLER", "speaker": 6, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "dialogue", "text": "Audit.", "name": "IMANI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "action", "text": "Ferris raises the pistol toward the stairs.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "action", "text": "She puts a hand on his wrist.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "dialogue", "text": "No guns. He's old. He'll have a heart attack and then we all hang.", "name": "IMANI", "speaker": 5, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "dialogue", "text": "What do you suggest?", "name": "FERRIS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "dialogue", "text": "I'll talk to him.", "name": "IMANI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "action", "text": "She picks up her shoes, straightens her dress, and climbs.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "action", "text": "Behind her, the crew holds still.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 59, "kind": "action", "text": "He listens as she greets the old man in a voice honey-smooth.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 60, "kind": "action", "text": "Lev zips the bag.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 61, "kind": "action", "text": "They trade a look.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 62, "kind": "action", "text": "Ferris does not lower the gun.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 63, "kind": "dialogue", "text": "She'd better be good.", "name": "LEV", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 64, "kind": "dialogue", "text": "She's very good.", "name": "TEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 65, "kind": "action", "text": "Above, a door closes.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 66, "kind": "action", "text": "Muffled laughter, an old man's.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 67, "kind": "action", "text": "Then nothing.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 68, "kind": "action", "text": "Ferris exhales and waves the others toward the service tunnel.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 69, "kind": "action", "text": "They go, the bag swinging, as footsteps fade overhead.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}]}