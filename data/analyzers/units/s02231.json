{"scene_id": "s02231", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02231.fountain", "heading": "INT. HALVORSEN-BRAND INC. - OPEN-PLAN OFFICE, \"SYNERGY POD\" - DAY", "cast": [{"id": 0, "name": "WE ARE FAMILY", "names": ["WE ARE FAMILY"], "gender": "?", "first": 3, "spoke": 0}, {"id": 1, "name": "HALVORSEN", "names": ["HALVORSEN", "MR. HALVORSEN"], "gender": "?", "first": 4, "spoke": 10}, {"id": 2, "name": "BRENDA", "names": ["BRENDA"], "gender": "m", "first": 5, "spoke": 5}, {"id": 3, "name": "CHIP", "names": ["CHIP"], "gender": "?", "first": 6, "spoke": 5}, {"id": 4, "name": "DUTCH", "names": ["DUTCH"], "gender": "?", "first": 6, "spoke": 5}, {"id": 5, "name": "GWEN", "names": ["GWEN"], "gender": "?", "first": 7, "spoke": 3}, {"id": 6, "name": "NEW HIRE", "names": ["NEW HIRE"], "gender": "f", "first": 8, "spoke": 1}, {"id": 7, "name": "PRIYA", "names": ["PRIYA"], "gender": "?", "first": 15, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. HALVORSEN-BRAND INC. - OPEN-PLAN OFFICE, \"SYNERGY POD\" - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Rows of beige desks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A foosball table nobody uses.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A banner reads \"WE ARE FAMILY (TERMS APPLY).\"", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "MR. HALVORSEN, fifties, in a vest and a tie with tiny fish, stands at a whiteboard.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "BRENDA, forties, his office manager, stands beside him with a laser pointer.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "CHIP, thirties, loud, and DUTCH, forties, soft-spoken, share a desk.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "action", "text": "GWEN, twenties, scribbles in a notebook.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "action", "text": "A NEW HIRE, twenties, a laptop bag on one shoulder, hovers by the door with a lanyard around her neck.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 9, "kind": "dialogue", "text": "Team! Team! Please welcome our latest synergist.", "name": "MR. HALVORSEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "action", "text": "Scattered applause.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "action", "text": "Chip whoops.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "Welcome to the family!", "name": "CHIP", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "Terms apply.", "name": "BRENDA", "speaker": 2, "ext": [], "paren": ["under her breath"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "And you are?", "name": "MR. HALVORSEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "Priya.", "name": "NEW HIRE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 16, "kind": "dialogue", "text": "Priya! A name like a poem. Where do you want to sit?", "name": "MR. HALVORSEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 17, "kind": "dialogue", "text": "Wherever there's an outlet.", "name": "PRIYA", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 18, "kind": "dialogue", "text": "The outlets are communal, Priya.", "name": "CHIP", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 19, "kind": "dialogue", "text": "We're sharing three between thirty.", "name": "DUTCH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 20, "kind": "dialogue", "text": "How do you charge anything?", "name": "PRIYA", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 21, "kind": "dialogue", "text": "We rotate. It builds trust.", "name": "DUTCH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 22, "kind": "dialogue", "text": "It builds bruises. Steve's still limping from Tuesday.", "name": "GWEN", "speaker": 5, "ext": [], "paren": ["without looking up"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 23, "kind": "dialogue", "text": "Gwen, we agreed on positivity.", "name": "MR. HALVORSEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 24, "kind": "dialogue", "text": "I'm positive he's limping.", "name": "GWEN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 25, "kind": "dialogue", "text": "Mr. Halvorsen, the onboarding packet?", "name": "BRENDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 26, "kind": "dialogue", "text": "Right. Priya, you'll receive a binder, a mug, and a mission statement.", "name": "MR. HALVORSEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 27, "kind": "dialogue", "text": "I'd rather have a desk.", "name": "PRIYA", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 28, "kind": "dialogue", "text": "The desk is earned.", "name": "MR. HALVORSEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 29, "kind": "dialogue", "text": "How?", "name": "PRIYA", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "dialogue", "text": "Three quarters of exceeding metrics.", "name": "CHIP", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "dialogue", "text": "What are the metrics?", "name": "PRIYA", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "dialogue", "text": "Nobody knows.", "name": "DUTCH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "dialogue", "text": "Dutch.", "name": "BRENDA", "speaker": 2, "ext": [], "paren": ["sharp"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "dialogue", "text": "Sorry. They're confidential.", "name": "DUTCH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "dialogue", "text": "To whom?", "name": "PRIYA", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "dialogue", "text": "To me, mostly.", "name": "MR. HALVORSEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "action", "text": "Priya looks around.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "action", "text": "The team looks at the floor.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "action", "text": "The foosball table creaks as no one touches it.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "dialogue", "text": "So I show up for two years, to a job I can't define, for a desk I can't have.", "name": "PRIYA", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 41, "kind": "dialogue", "text": "It's a journey.", "name": "MR. HALVORSEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 42, "kind": "dialogue", "text": "A beautiful journey.", "name": "CHIP", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 43, "kind": "dialogue", "text": "She doesn't have to say yes, Chip.", "name": "BRENDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 44, "kind": "dialogue", "text": "She does. They all do.", "name": "GWEN", "speaker": 5, "ext": [], "paren": ["still writing"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 45, "kind": "action", "text": "Priya laughs, short, appalled.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 46, "kind": "action", "text": "She slides the laptop bag off her shoulder and sets it on the foosball table.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 47, "kind": "dialogue", "text": "Fine. I'll stand.", "name": "PRIYA", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 48, "kind": "dialogue", "text": "Wonderful!", "name": "MR. HALVORSEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 49, "kind": "dialogue", "text": "You can use my outlet, Priya. Mondays.", "name": "DUTCH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 50, "kind": "dialogue", "text": "Thank you, Dutch.", "name": "PRIYA", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 51, "kind": "dialogue", "text": "Look at that! Already a family.", "name": "CHIP", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 52, "kind": "dialogue", "text": "Terms apply, Chip.", "name": "BRENDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 53, "kind": "action", "text": "Mr. Halvorsen beams at the whiteboard, where somebody has drawn a lopsided tree.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 54, "kind": "dialogue", "text": "Now, who wants to hear about our Q3 vision?", "name": "MR. HALVORSEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 55, "kind": "action", "text": "Nobody does.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 56, "kind": "action", "text": "Everyone nods anyway.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}