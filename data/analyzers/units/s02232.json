{"scene_id": "s02232", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02232.fountain", "heading": "INT. ROLLER RINK, ABANDONED - AFTERNOON", "cast": [{"id": 0, "name": "DESMOND", "names": ["DESMOND"], "gender": "m", "first": 5, "spoke": 9}, {"id": 1, "name": "MIRELA", "names": ["MIRELA"], "gender": "f", "first": 6, "spoke": 8}, {"id": 2, "name": "UNCLE FERENC", "names": ["UNCLE FERENC"], "gender": "m", "first": 7, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROLLER RINK, ABANDONED - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "A cavernous room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wood floor warped into waves.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Mirror ball cracked and dull.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Light slants through boarded windows.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DESMOND, sixteen, lanky, wearing his late father's denim jacket two sizes too big, sits on a bench lacing up scuffed skates.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "MIRELA, seventeen, shaved head, a silver ring in her eyebrow, leans against the rail holding a boombox.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "UNCLE FERENC, sixties, wiry, a flat cap, a cigarette unlit between his lips, stands at the far end by the dead organ.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Dust motes drift.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "You said you could skate.", "name": "MIRELA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I said I used to.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He stands.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Wobbles.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She watches, arms crossed.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Used to when?", "name": "MIRELA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Six. With my dad.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "She doesn't answer.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "He pushes off.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "His legs go sideways.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "He catches the rail, laughs, ashamed.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Knees, boy! Bend your knees!", "name": "UNCLE FERENC", "speaker": 2, "ext": [], "paren": ["calling out"], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "I'm bending them!", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "You're bending your back!", "name": "UNCLE FERENC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Mirela sets the boombox down.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Presses play.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "A scratchy waltz fills the rink.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Desmond stops mid-wobble.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "What is this?", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Ferenc's. He ran this rink in the eighties.", "name": "MIRELA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Nineteen eighty-one to ninety-four. Best waltz night in Budapest-on-the-Hudson.", "name": "UNCLE FERENC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "That's not a place.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "It was a state of mind.", "name": "UNCLE FERENC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Ferenc takes off his cap.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Straightens.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "For a second, he looks twenty years younger.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "He steps onto the floor in his street shoes and glides, light, impossible, a hand tucked behind his back.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Desmond stares.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Mirela's mouth twitches toward a smile.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Told you.", "name": "MIRELA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Your uncle can dance.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "He can do a lot of things.", "name": "MIRELA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Watch my feet, boy. Not my face.", "name": "UNCLE FERENC", "speaker": 2, "ext": [], "paren": ["passing them"], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Desmond watches.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Tries.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Pushes, glides, a foot slips, but he doesn't fall.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "He grins.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Mirela whoops, the first honest sound she's made.", "para": 8, "sent": 4, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Again!", "name": "MIRELA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "He pushes off a second time.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Better.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Ferenc spins back around, arms out, steadying him without touching.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "That's it. Don't think. Your father didn't think.", "name": "UNCLE FERENC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "You knew my dad?", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Every Friday for six years. Worst skater I ever saw.", "name": "UNCLE FERENC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "He'd have said the same about me.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": ["small smile"], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "He'd have lied. He loved watching you.", "name": "UNCLE FERENC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Desmond looks down.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Mirela cranks the volume.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "The waltz swells in the empty hall.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "Okay, Des. Stop crying and skate.", "name": "MIRELA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "I'm not crying.", "name": "DESMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "You're a little bit crying.", "name": "MIRELA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "He wipes his face with a sleeve.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "Pushes forward.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "Ferenc takes his left, Mirela comes onto the floor and takes his right.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "The three of them make a slow, crooked circle under the dead mirror ball.", "para": 11, "sent": 3, "present": [0, 1, 2]}]}