{"scene_id": "s02233", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02233.fountain", "heading": "EXT. SCHOOL BUS STOP - BACK OF A DRIVE-IN THEATER - NIGHT", "cast": [{"id": 0, "name": "ZUZU", "names": ["ZUZU"], "gender": "?", "first": 3, "spoke": 2}, {"id": 1, "name": "HOBART", "names": ["HOBART"], "gender": "?", "first": 4, "spoke": 1}, {"id": 2, "name": "LINDIWE", "names": ["LINDIWE"], "gender": "?", "first": 5, "spoke": 2}, {"id": 3, "name": "PABLO", "names": ["PABLO"], "gender": "m", "first": 6, "spoke": 2}, {"id": 4, "name": "MARGUERITE", "names": ["MARGUERITE"], "gender": "?", "first": 7, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SCHOOL BUS STOP - BACK OF A DRIVE-IN THEATER - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cracked screen looms behind them.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Moths circle a lone streetlight.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "ZUZU, fifteen, grips a stolen bottle of cider.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "HOBART, fifteen, holds a flashlight.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "LINDIWE, sixteen, perches on a car hood.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "PABLO, fourteen, hugs his knees.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "MARGUERITE, sixteen, in a prom dress, shivers.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "Hobart, put the light out.", "name": "ZUZU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Marguerite's cold.", "name": "HOBART", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "I'm fine. Lindiwe, give me your jacket.", "name": "MARGUERITE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Pablo, share yours.", "name": "LINDIWE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "It's a hoodie. It's too small.", "name": "PABLO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Everybody shut up. Headlights.", "name": "ZUZU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "A car passes on the road.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Slows.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Speeds up.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "They breathe.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Was it my dad?", "name": "PABLO", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "No, Pablo. Your dad drives a Buick.", "name": "LINDIWE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Marguerite starts laughing.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Then Zuzu.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Then all of them, helplessly, until Hobart drops the flashlight and it rolls under the car.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}]}