{"scene_id": "s02236", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02236.fountain", "heading": "INT. OBSERVATORY DOME - NIGHT", "cast": [{"id": 0, "name": "INSPECTOR MORTIMER GALE", "names": ["INSPECTOR MORTIMER GALE", "GALE"], "gender": "m", "first": 4, "spoke": 18}, {"id": 1, "name": "AURELIO BANERJEE", "names": ["AURELIO BANERJEE", "BANERJEE"], "gender": "m", "first": 5, "spoke": 17}, {"id": 2, "name": "CONSTABLE PIKE", "names": ["CONSTABLE PIKE", "PIKE"], "gender": "m", "first": 31, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. OBSERVATORY DOME - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A great brass telescope points at a slit of stars.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A circular stair winds to a gallery.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "On the floor, chalk outlines a body that has been moved.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "INSPECTOR MORTIMER GALE, fifties, a heavy coat, a notebook, circles the chalk slowly.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "DR. AURELIO BANERJEE, forties, the observatory's director, in shirtsleeves, stands by the telescope with his hands clasped.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "The night assistant, Mr. Pell. Found here at six.", "name": "GALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "I arrived at six-fifteen.", "name": "BANERJEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Did he work alone?", "name": "GALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Mostly. He liked the quiet.", "name": "BANERJEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "He also liked your office. The lock was forced.", "name": "GALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Banerjee doesn't flinch.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "He had a habit of borrowing my star charts.", "name": "BANERJEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Borrowing. He took them home?", "name": "GALE", "speaker": 0, "ext": [], "paren": ["writing"], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "He took them to his sister's.", "name": "BANERJEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "In another city.", "name": "GALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "He was a collector.", "name": "BANERJEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Gale stops circling.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He taps the notebook.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Dr. Banerjee, a man doesn't lock himself in a dome with a telescope and fall down a staircase.", "name": "GALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "He was clumsy.", "name": "BANERJEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "He was a retired gymnast.", "name": "GALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "A beat.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Banerjee turns to the telescope.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Adjusts a brass dial that doesn't need adjusting.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Then he was careless.", "name": "BANERJEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Or pushed.", "name": "GALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "By whom? There is no one here but me.", "name": "BANERJEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "The dome door at the bottom of the stair swings open.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Footsteps.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "A flashlight sweeps the floor.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "CONSTABLE PIKE, twenties, rain on his helmet, hurries up.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "He holds a sealed envelope.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Inspector. This came from the lab.", "name": "PIKE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Gale takes it.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Opens it.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Reads.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Banerjee watches him read.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Fingerprints on the brass rail. Two sets.", "name": "GALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Naturally. Mine, and Pell's.", "name": "BANERJEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "One is Pell's.", "name": "GALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "And the other?", "name": "BANERJEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Gale looks up, his face unreadable.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "It's not yours.", "name": "GALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Banerjee blinks.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "He grips the telescope.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "That's impossible.", "name": "BANERJEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Inspector, there's more. The second set matches a man missing from Lisbon.", "name": "PIKE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Who else has a key to this dome?", "name": "GALE", "speaker": 0, "ext": [], "paren": ["to Banerjee"], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Only the board. And Pell.", "name": "BANERJEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Then he let someone in.", "name": "GALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Why would he do that at midnight?", "name": "BANERJEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "That's what I'd like to know.", "name": "GALE", "speaker": 0, "ext": [], "paren": ["sharp"], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Banerjee crosses to the stair.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Pike steps aside.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Banerjee slows at the first step, looks at the chalk, looks back at Gale.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "He was afraid of someone.", "name": "BANERJEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "You knew?", "name": "GALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "Last week, he asked me for a new lock.", "name": "BANERJEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "And you refused.", "name": "GALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "The budget--", "name": "BANERJEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "The budget! A man is dead, Doctor! A man you let sit alone in the dark with a stranger's key!", "name": "GALE", "speaker": 0, "ext": [], "paren": ["exploding"], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "The telescope creaks.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "Pike backs a step.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "Banerjee, white, grips the rail.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "I did not know.", "name": "BANERJEE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "Next time, Doctor, ask.", "name": "GALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "He closes the notebook with a snap.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "Pike holds the door.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "Gale walks out, his boots echoing on the iron stair.", "para": 12, "sent": 2, "present": [0, 1, 2]}]}