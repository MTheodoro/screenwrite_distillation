{"scene_id": "s02237", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02237.fountain", "heading": "INT. SAFE HOUSE KITCHEN - NIGHT", "cast": [{"id": 0, "name": "ODETTE MARSH", "names": ["ODETTE MARSH", "ODETTE"], "gender": "f", "first": 5, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. SAFE HOUSE KITCHEN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A narrow room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Blinds drawn.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A table, a laptop, a half-eaten sandwich going stale.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The refrigerator hums loud.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ODETTE MARSH, forties, grey at the temples, wears a hooded sweatshirt over a good blouse.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A cut on her cheek, dried.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She checks the window slats, then the door deadbolt, then the window slats again.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "She sits.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Types.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "Stops.", "para": 2, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "On the laptop, a voice memo icon.", "para": 3, "sent": 0, "present": [0]}, {"u": 12, "kind": "action", "text": "She clicks it.", "para": 3, "sent": 1, "present": [0]}, {"u": 13, "kind": "dialogue", "text": "If you're hearing this, I didn't make it to Lisbon. The files are in the drive under my mother's maiden name.", "name": "ODETTE", "speaker": 0, "ext": ["V.O."], "paren": ["her own voice, recorded, steady"], "dual": false, "present": [0]}, {"u": 14, "kind": "action", "text": "Odette winces at the sound of herself.", "para": 4, "sent": 0, "present": [0]}, {"u": 15, "kind": "action", "text": "Scrubs her face with both hands.", "para": 4, "sent": 1, "present": [0]}, {"u": 16, "kind": "dialogue", "text": "Don't trust anyone from the ministry. Not even Paulo.", "name": "ODETTE", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 17, "kind": "action", "text": "She mutes it.", "para": 5, "sent": 0, "present": [0]}, {"u": 18, "kind": "action", "text": "Stares at the screen.", "para": 5, "sent": 1, "present": [0]}, {"u": 19, "kind": "dialogue", "text": "Paulo.", "name": "ODETTE", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0]}, {"u": 20, "kind": "action", "text": "A car passes outside.", "para": 6, "sent": 0, "present": [0]}, {"u": 21, "kind": "action", "text": "She goes still.", "para": 6, "sent": 1, "present": [0]}, {"u": 22, "kind": "action", "text": "Headlights sweep the blinds, slats of light across her face.", "para": 6, "sent": 2, "present": [0]}, {"u": 23, "kind": "action", "text": "The car continues.", "para": 6, "sent": 3, "present": [0]}, {"u": 24, "kind": "action", "text": "She exhales.", "para": 6, "sent": 4, "present": [0]}, {"u": 25, "kind": "dialogue", "text": "Okay. Okay.", "name": "ODETTE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 26, "kind": "action", "text": "She unmutes the memo.", "para": 7, "sent": 0, "present": [0]}, {"u": 27, "kind": "dialogue", "text": "There is a second drive. Under the sink. Behind the pipe.", "name": "ODETTE", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0]}, {"u": 28, "kind": "action", "text": "She looks at the sink.", "para": 8, "sent": 0, "present": [0]}, {"u": 29, "kind": "action", "text": "At the cabinet below it.", "para": 8, "sent": 1, "present": [0]}, {"u": 30, "kind": "action", "text": "Rises.", "para": 8, "sent": 2, "present": [0]}, {"u": 31, "kind": "action", "text": "Opens it.", "para": 8, "sent": 3, "present": [0]}, {"u": 32, "kind": "action", "text": "Reaches behind the pipe.", "para": 8, "sent": 4, "present": [0]}, {"u": 33, "kind": "action", "text": "Her hand closes on something.", "para": 9, "sent": 0, "present": [0]}, {"u": 34, "kind": "action", "text": "She pulls out a small black drive wrapped in plastic.", "para": 9, "sent": 1, "present": [0]}, {"u": 35, "kind": "action", "text": "Outside, a second car door closes.", "para": 10, "sent": 0, "present": [0]}, {"u": 36, "kind": "action", "text": "Not passing.", "para": 10, "sent": 1, "present": [0]}, {"u": 37, "kind": "action", "text": "Parked.", "para": 10, "sent": 2, "present": [0]}, {"u": 38, "kind": "action", "text": "She doesn't move.", "para": 11, "sent": 0, "present": [0]}, {"u": 39, "kind": "action", "text": "The refrigerator cuts off.", "para": 11, "sent": 1, "present": [0]}, {"u": 40, "kind": "action", "text": "The room is silent.", "para": 11, "sent": 2, "present": [0]}, {"u": 41, "kind": "action", "text": "Footsteps on gravel.", "para": 12, "sent": 0, "present": [0]}, {"u": 42, "kind": "action", "text": "Slow.", "para": 12, "sent": 1, "present": [0]}, {"u": 43, "kind": "action", "text": "Two sets.", "para": 12, "sent": 2, "present": [0]}, {"u": 44, "kind": "dialogue", "text": "If you hear footsteps, don't run. Don't turn on any light.", "name": "ODETTE", "speaker": 0, "ext": ["V.O."], "paren": ["from the laptop, urgent"], "dual": false, "present": [0]}, {"u": 45, "kind": "action", "text": "Odette kills the laptop screen.", "para": 13, "sent": 0, "present": [0]}, {"u": 46, "kind": "action", "text": "Darkness.", "para": 13, "sent": 1, "present": [0]}, {"u": 47, "kind": "action", "text": "She backs against the wall, drive clutched against her chest.", "para": 13, "sent": 2, "present": [0]}, {"u": 48, "kind": "action", "text": "The doorknob turns.", "para": 14, "sent": 0, "present": [0]}, {"u": 49, "kind": "action", "text": "Locked.", "para": 14, "sent": 1, "present": [0]}, {"u": 50, "kind": "action", "text": "A pause.", "para": 14, "sent": 2, "present": [0]}, {"u": 51, "kind": "action", "text": "The knob turns again.", "para": 14, "sent": 3, "present": [0]}, {"u": 52, "kind": "action", "text": "She holds her breath.", "para": 15, "sent": 0, "present": [0]}]}