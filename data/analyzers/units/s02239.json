{"scene_id": "s02239", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02239.fountain", "heading": "INT. MIRROR VAULT OF THE DROWNED KING - NIGHT", "cast": [{"id": 0, "name": "SORREL", "names": ["SORREL"], "gender": "?", "first": 5, "spoke": 15}, {"id": 1, "name": "BRIGID", "names": ["BRIGID"], "gender": "f", "first": 19, "spoke": 12}], "units": [{"u": 0, "kind": "heading", "text": "INT. MIRROR VAULT OF THE DROWNED KING - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cavern of black glass.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Ten thousand mirrors cover walls, floor, ceiling.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Torchlight multiplies into a bonfire of stars.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Every reflection moves a half-second late.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SORREL, thirties, a thief in a hooded cloak, creeps along a narrow ledge of obsidian.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She clutches a leather satchel.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She stops.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "Her reflection stops, then.", "para": 1, "sent": 3, "present": [0]}, {"u": 9, "kind": "dialogue", "text": "Don't look. Don't look.", "name": "SORREL", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0]}, {"u": 10, "kind": "action", "text": "She looks.", "para": 2, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "The reflections grin.", "para": 2, "sent": 1, "present": [0]}, {"u": 12, "kind": "dialogue", "text": "I'm only here for the crown! You can keep the rest!", "name": "SORREL", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the vault"], "dual": false, "present": [0]}, {"u": 13, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0]}, {"u": 14, "kind": "action", "text": "A single mirror cracks, a thin white line.", "para": 3, "sent": 1, "present": [0]}, {"u": 15, "kind": "dialogue", "text": "Brilliant. Wake the whole place.", "name": "SORREL", "speaker": 0, "ext": ["CONT'D"], "paren": ["to herself"], "dual": false, "present": [0]}, {"u": 16, "kind": "action", "text": "She steps off the ledge onto a dais.", "para": 4, "sent": 0, "present": [0]}, {"u": 17, "kind": "action", "text": "A crown of black pearl rests on a pillow of bone.", "para": 4, "sent": 1, "present": [0]}, {"u": 18, "kind": "action", "text": "She reaches for it.", "para": 4, "sent": 2, "present": [0]}, {"u": 19, "kind": "dialogue", "text": "Don't.", "name": "BRIGID", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Sorrel spins.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "A figure steps out of a mirror, not around it, out of it, as a swimmer climbs from a pool.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "BRIGID, forties, tall, in a silver surcoat, a long sword in one hand.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Her face is the same as Sorrel's, older, scarred across the brow.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Who are you?", "name": "SORREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "You. After you take it.", "name": "BRIGID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "They stare at each other.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Torches gutter.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Is she real?", "name": "SORREL", "speaker": 0, "ext": [], "paren": ["to the vault"], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Don't bother. The vault doesn't answer.", "name": "BRIGID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "That's the first honest thing I've heard in a week.", "name": "SORREL", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Brigid raises the sword.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Sorrel pulls a short knife.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "They circle the dais, each step mirrored a thousand times.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Put the knife down.", "name": "BRIGID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Put the sword down.", "name": "SORREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "I won't.", "name": "BRIGID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Then neither will I.", "name": "SORREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "They lunge together.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Steel rings.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Sorrel ducks, rolls under Brigid's blade.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Brigid whirls and kicks the knife from her grip.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "It skitters across the glass.", "para": 9, "sent": 4, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Both lunge for it.", "para": 9, "sent": 5, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "Both reach it.", "para": 9, "sent": 6, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "Both freeze, hands on the hilt.", "para": 9, "sent": 7, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Let go.", "name": "BRIGID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "You let go.", "name": "SORREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "I wore this knife the night I took the crown. It cost me a sister.", "name": "BRIGID", "speaker": 1, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "I don't have a sister.", "name": "SORREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "You will.", "name": "BRIGID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "Sorrel's grip loosens.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "Brigid's too.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "The knife lies between them.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "Someone tell me what's happening!", "name": "SORREL", "speaker": 0, "ext": [], "paren": ["to the whole vault"], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "The mirrors all go dark, one after another, like candles.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "Only two torches remain.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "In their light the women stand on the dais, panting.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "It's the king's last trick. It shows you what you'll become.", "name": "BRIGID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "Wonderful. A warning with a sword.", "name": "SORREL", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "Leave the crown. Walk out.", "name": "BRIGID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "And you?", "name": "SORREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "I'll vanish. Like I always do.", "name": "BRIGID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "Sorrel looks at the crown.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "At Brigid.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "At the dark glass.", "para": 12, "sent": 2, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "Fine.", "name": "SORREL", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "action", "text": "She steps back from the dais.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "Slings her satchel over her shoulder.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "Brigid lowers the sword.", "para": 13, "sent": 2, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "Thank you.", "name": "BRIGID", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "dialogue", "text": "Don't thank me. I want a better offer next time.", "name": "SORREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "Brigid smiles, sad, and steps backward into a mirror.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "It swallows her.", "para": 14, "sent": 1, "present": [0, 1]}, {"u": 74, "kind": "action", "text": "The crown stays on its bone pillow.", "para": 14, "sent": 2, "present": [0, 1]}, {"u": 75, "kind": "action", "text": "Sorrel exits along the ledge.", "para": 15, "sent": 0, "present": [0, 1]}, {"u": 76, "kind": "action", "text": "At the cavern's mouth she stops, glances back once.", "para": 15, "sent": 1, "present": [1]}, {"u": 77, "kind": "action", "text": "Her reflection nods.", "para": 15, "sent": 2, "present": [1]}]}