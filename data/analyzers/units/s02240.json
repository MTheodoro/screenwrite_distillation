{"scene_id": "s02240", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02240.fountain", "heading": "INT. FAMILY KITCHEN - FLOOR ABOVE A LAUNDROMAT - EVENING", "cast": [{"id": 0, "name": "INES", "names": ["INES"], "gender": "f", "first": 5, "spoke": 4}, {"id": 1, "name": "BOYD", "names": ["BOYD"], "gender": "m", "first": 6, "spoke": 2}, {"id": 2, "name": "LITTLE TUAN", "names": ["LITTLE TUAN", "TUAN"], "gender": "?", "first": 7, "spoke": 3}, {"id": 3, "name": "SERAPHINA", "names": ["SERAPHINA"], "gender": "?", "first": 8, "spoke": 5}, {"id": 4, "name": "GIDEON", "names": ["GIDEON"], "gender": "?", "first": 22, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. FAMILY KITCHEN - FLOOR ABOVE A LAUNDROMAT - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "A small table.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A pot of boiled dumplings.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cracked ceiling fan.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain on the window.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "INES, forties, stands at the stove.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her son BOYD, twelve, slumps at the table with his phone.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "LITTLE TUAN, six, kneels on a chair, drawing a dog.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Why does Aunt Seraphina always call during dinner?", "name": "BOYD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Because she knows I'll answer.", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "The phone on the counter rings.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Ines wipes her hands, answers, sets it on speaker.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Ines? Is that you? Are the children eating?", "name": "SERAPHINA", "speaker": 3, "ext": ["V.O."], "paren": ["tinny"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "We're all here, Seraphina.", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Good. Boyd, are you wearing the scarf I knitted?", "name": "SERAPHINA", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "It's June, Aunt Sera.", "name": "BOYD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Scarves are for every month.", "name": "SERAPHINA", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Aunt Sera, I drew a dog.", "name": "TUAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Does the dog have a scarf?", "name": "SERAPHINA", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "He does now.", "name": "TUAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "He scribbles one in red crayon.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "The front door downstairs bangs.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "GIDEON, fifties, wet to the skin, an umbrella turned inside out, trudges into the kitchen.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Ines stiffens.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Boyd lowers his phone.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Sorry I'm late. The bus broke down.", "name": "GIDEON", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "You said you'd be home Friday.", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "It's Friday.", "name": "GIDEON", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "It's Sunday, Gideon.", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "A silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Seraphina's voice trickles from the phone.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Gideon? Is that Gideon? Put him on!", "name": "SERAPHINA", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Nobody moves.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Tuan holds up the dog.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Papa, look.", "name": "TUAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}