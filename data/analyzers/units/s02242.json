{"scene_id": "s02242", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02242.fountain", "heading": "INT. DERELICT TERRAFORMING STATION - AIRLOCK CORRIDOR - NIGHT CYCLE", "cast": [{"id": 0, "name": "CAPTAIN ORRIN VASK", "names": ["CAPTAIN ORRIN VASK", "ORRIN"], "gender": "?", "first": 4, "spoke": 11}, {"id": 1, "name": "HALCYON", "names": ["HALCYON"], "gender": "?", "first": 7, "spoke": 7}, {"id": 2, "name": "UNKNOWN CREW MEMBER", "names": ["UNKNOWN CREW MEMBER"], "gender": "?", "first": 16, "spoke": 2}, {"id": 3, "name": "PAVLINA", "names": ["PAVLINA"], "gender": "?", "first": 21, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. DERELICT TERRAFORMING STATION - AIRLOCK CORRIDOR - NIGHT CYCLE", "present": []}, {"u": 1, "kind": "action", "text": "Pale emergency lights.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Condensation beads on the walls.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A bulkhead door at one end stamped SECTOR 9 in peeling yellow.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CAPTAIN ORRIN VASK, forties, steady, in a rust-colored flight suit, leads.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Behind him, a hooded figure in an environment suit, face hidden behind a dark visor, walks with a slight limp.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "A speaker in the ceiling crackles.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "dialogue", "text": "Captain Vask. Atmospheric integrity at sixty percent. Two crew members aboard.", "name": "HALCYON", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Two?", "name": "ORRIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Yourself, and one unregistered.", "name": "HALCYON", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Who are you?", "name": "ORRIN", "speaker": 0, "ext": [], "paren": ["turning"], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "The figure stops.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Reaches up.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Unlocks the helmet.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Lifts it away.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "A woman, thirties, ash-blond, pale.", "para": 3, "sent": 4, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "My name doesn't matter. You needed an engineer.", "name": "UNKNOWN CREW MEMBER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I needed Chief Dahl.", "name": "ORRIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Dahl is in cryo, three decks down. She sent me.", "name": "UNKNOWN CREW MEMBER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Verification pending.", "name": "HALCYON", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Halcyon, scan her.", "name": "ORRIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Scan complete. Pavlina Rusk. Engineer, second class. Dismissed from the colony in the year eighty-one.", "name": "HALCYON", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Dismissed for telling the truth.", "name": "PAVLINA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "About what?", "name": "ORRIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "About the reactor. It was never safe.", "name": "PAVLINA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "They stand in the humming corridor.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "The lights flicker.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Then why come back?", "name": "ORRIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Because it's going to blow in four hours, and I'm the only one who knows how to stop it.", "name": "PAVLINA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Calculating. Probability of that claim being true: seventy-three percent.", "name": "HALCYON", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Rounded up, that's enough.", "name": "PAVLINA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Can we trust her?", "name": "ORRIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Trust is not a computable quantity, Captain.", "name": "HALCYON", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Thanks for nothing.", "name": "ORRIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Pavlina almost smiles.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "She walks to the bulkhead, thumbs the keypad.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "It beeps red.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Override code?", "name": "PAVLINA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Nine-two-seven.", "name": "ORRIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Nine-two-seven.", "name": "PAVLINA", "speaker": 3, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "You knew it already.", "name": "ORRIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Everyone in Sector 9 knew it. That's why it's a bad code.", "name": "PAVLINA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "The door slides open.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Beyond: a vast chamber with a pulsing blue core.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Heat on their faces.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Four hours, thirty-eight minutes.", "name": "HALCYON", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Four hours is plenty.", "name": "ORRIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "For a good engineer.", "name": "PAVLINA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "She steps through.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Orrin follows.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}]}