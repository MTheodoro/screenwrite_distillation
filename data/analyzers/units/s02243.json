{"scene_id": "s02243", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02243.fountain", "heading": "INT. ROOFTOP AVIARY, HOTEL - DAWN", "cast": [{"id": 0, "name": "DETECTIVE RAVI SANDHU", "names": ["DETECTIVE RAVI SANDHU", "SANDHU"], "gender": "?", "first": 5, "spoke": 4}, {"id": 1, "name": "LORNA FITCH", "names": ["LORNA FITCH", "LORNA"], "gender": "?", "first": 6, "spoke": 1}, {"id": 2, "name": "ASHWORTH", "names": ["ASHWORTH"], "gender": "m", "first": 7, "spoke": 1}, {"id": 3, "name": "BETTINA", "names": ["BETTINA"], "gender": "?", "first": 8, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROOFTOP AVIARY, HOTEL - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Wire cages.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cooing.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A dead parrot on the floor in a puddle of seed.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Gray light.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DETECTIVE RAVI SANDHU, forties, rumpled trench, kneels by the body.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "LORNA FITCH, fifties, the hotel's head of security, stands with a clipboard.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "MR. ASHWORTH, sixties, the owner, wrings his hands in the corner.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "BETTINA, twenty, a chambermaid, clutches a mop.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Who found it?", "name": "SANDHU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "I did, sir. At five.", "name": "BETTINA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Door locked?", "name": "SANDHU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Always. Keys: me, Mr. Ashworth, the bird handler.", "name": "LORNA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "He's on holiday.", "name": "ASHWORTH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Convenient.", "name": "SANDHU", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Sandhu turns the parrot over.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "A tiny tag around its leg reads Percival.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "He freezes.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Everyone out.", "name": "SANDHU", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "They scatter, Bettina first, Ashworth tripping on his own cane, Lorna last, throwing a look back as the door swings shut.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}]}