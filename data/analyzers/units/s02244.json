{"scene_id": "s02244", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02244.fountain", "heading": "INT. COUNTY HOSPITAL - TRAUMA BAY 2 - NIGHT", "cast": [{"id": 0, "name": "XIMENA FERREIRA", "names": ["XIMENA FERREIRA", "XIMENA"], "gender": "f", "first": 4, "spoke": 12}, {"id": 1, "name": "NURSE GLORIA", "names": ["NURSE GLORIA", "GLORIA"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "ORDERLY", "names": ["ORDERLY"], "gender": "m", "first": 6, "spoke": 3}, {"id": 3, "name": "TOBIAS", "names": ["TOBIAS"], "gender": "?", "first": 22, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. COUNTY HOSPITAL - TRAUMA BAY 2 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "White light, steel trays, the smell of antiseptic over blood.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A monitor chirps.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A man lies on the table under a sheet, chest open, a ventilator breathing for him.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. XIMENA FERREIRA, forties, scrubs soaked at the collar, hands buried in the incision, her gray eyes fixed on a point nobody else can see.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across the table, NURSE GLORIA, fifties, steady, passes instruments with the unhurried economy of someone who has done it ten thousand times.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "An ORDERLY, twenties, tall, pressed against the wall near the door, holds a clipboard he has no reason to hold.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Suction.", "name": "XIMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Gloria obliges.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "The sound is wet and fast.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Pressure?", "name": "XIMENA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Eighty over forty. Dropping.", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Come on. Come on.", "name": "XIMENA", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She reaches deeper.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "The monitor skips.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "The ORDERLY shifts, the clipboard rustles.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Ximena doesn't look up.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Whoever is breathing back there, stop.", "name": "XIMENA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Sorry, Doctor.", "name": "ORDERLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Who are you?", "name": "XIMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Transport. They said you needed hands.", "name": "ORDERLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "I need hands that know what to do.", "name": "XIMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "I'm a med student. Third year. Tobias.", "name": "ORDERLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Gloria doesn't turn.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Ximena exhales through her nose.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Tobias, scrub in. Now. Basin by the door.", "name": "XIMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Yes, Doctor.", "name": "TOBIAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "He moves.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Scrubs, hands shaking.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "The water runs.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Everybody, quiet. She's going in for the clamp.", "name": "GLORIA", "speaker": 1, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Ximena closes her fingers around something.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Got it.", "name": "XIMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "The monitor chirps once, then twice, then a steadier rhythm.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Pressure's coming up. Ninety.", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Hundred, Gloria. Say it with me.", "name": "XIMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Hundred.", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Tobias, gloved now, edges to the table.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Ximena nods at the retractor.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Hold that. Don't let go no matter what I say.", "name": "XIMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "What if I faint?", "name": "TOBIAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Then faint standing up.", "name": "XIMENA", "speaker": 0, "ext": [], "paren": ["without humor"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "The monitor holds a quiet, even tone.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Tobias grips the retractor, white-knuckled, and does not let go.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Hold, hold, hold.", "name": "XIMENA", "speaker": 0, "ext": ["CONT'D"], "paren": ["muttering, almost a prayer"], "dual": false, "present": [0, 1, 2, 3]}]}