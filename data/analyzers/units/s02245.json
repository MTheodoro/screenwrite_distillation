{"scene_id": "s02245", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02245.fountain", "heading": "INT. FAMILY DINING ROOM - SUNDAY", "cast": [{"id": 0, "name": "GRANDPA WILF", "names": ["GRANDPA WILF", "WILF"], "gender": "?", "first": 5, "spoke": 5}, {"id": 1, "name": "KATARZYNA", "names": ["KATARZYNA"], "gender": "?", "first": 6, "spoke": 4}, {"id": 2, "name": "SIONE", "names": ["SIONE"], "gender": "?", "first": 7, "spoke": 3}, {"id": 3, "name": "PEACHES", "names": ["PEACHES"], "gender": "?", "first": 8, "spoke": 3}, {"id": 4, "name": "BO", "names": ["BO"], "gender": "?", "first": 8, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. FAMILY DINING ROOM - SUNDAY", "present": []}, {"u": 1, "kind": "action", "text": "A long table.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Plates of roast.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cuckoo clock.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Gravy steams.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "GRANDPA WILF, eighty, at the head.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "KATARZYNA, forties, carves.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "SIONE, forties, pours wine.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "The twins, PEACHES and BO, seven, kick each other under the table.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Bo took my potato!", "name": "PEACHES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "You took mine first!", "name": "BO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Both of you, hands where I can see them.", "name": "SIONE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Eat, everybody. It's getting cold.", "name": "KATARZYNA", "speaker": 1, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Everything's cold in this house.", "name": "WILF", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "I heard that, Wilf.", "name": "KATARZYNA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Good.", "name": "WILF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Peaches, give Bo the potato.", "name": "SIONE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "No!", "name": "PEACHES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Mom!", "name": "BO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Stop. Both of you.", "name": "KATARZYNA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "They stop.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Silence.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "The clock cuckoos twice.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Well. Anybody going to tell the children?", "name": "WILF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "KATARZYNA and SIONE look at each other.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Wilf.", "name": "SIONE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "It's Sunday. They should know.", "name": "WILF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Know what?", "name": "BO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Grandpa's moving in next month.", "name": "KATARZYNA", "speaker": 1, "ext": [], "paren": ["gently"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Forever?", "name": "PEACHES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Till they carry me out.", "name": "WILF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Peaches considers this with great gravity, then slides her potato across the table to Bo.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}]}