{"scene_id": "s02247", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02247.fountain", "heading": "INT. FARMHOUSE KITCHEN - NIGHT", "cast": [{"id": 0, "name": "OTTILIE", "names": ["OTTILIE"], "gender": "?", "first": 3, "spoke": 13}, {"id": 1, "name": "RASMUS", "names": ["RASMUS"], "gender": "m", "first": 4, "spoke": 15}], "units": [{"u": 0, "kind": "heading", "text": "INT. FARMHOUSE KITCHEN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A wood stove, a kerosene lamp, a table scarred by decades of use.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Snow ticks at the window.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "OTTILIE, sixty, in a wool cardigan, stirs a pot.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "Her son RASMUS, thirty-five, a duffel bag still on his shoulder, stands in the doorway with snow on his boots.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "Mama.", "name": "RASMUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "You didn't write.", "name": "OTTILIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "I wrote, Mama. Three times.", "name": "RASMUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Not one letter came.", "name": "OTTILIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Then the post is broken.", "name": "RASMUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She keeps stirring.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He steps in, sets the bag down.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Wash your hands. There's soup.", "name": "OTTILIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "I'm not hungry.", "name": "RASMUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "You're thin.", "name": "OTTILIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I'm the same as I was.", "name": "RASMUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "You were never this thin, Rasmus.", "name": "OTTILIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He sits.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She ladles soup into a bowl, sets it before him, and sits across the table.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Neither touches a spoon.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "I sold the boat.", "name": "RASMUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "I know.", "name": "OTTILIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Who told you?", "name": "RASMUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Hennie at the church. Her husband bought the nets.", "name": "OTTILIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Mama, I had to.", "name": "RASMUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Your father built that boat.", "name": "OTTILIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "And it was sinking us, Mama. Debts. Three years of debts.", "name": "RASMUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "You could have asked.", "name": "OTTILIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Asked who? You? With what?", "name": "RASMUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "With a little respect, Rasmus!", "name": "OTTILIE", "speaker": 0, "ext": [], "paren": ["rising"], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "I'm trying, Mama!", "name": "RASMUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "You sold your father's boat and you come home thin and you don't write!", "name": "OTTILIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "I wrote!", "name": "RASMUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "She strikes the table with the flat of her hand.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "The lamp jumps.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Silence, heavy and total.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "I wrote, Mama. I wrote every week. I think someone has been keeping them from you.", "name": "RASMUS", "speaker": 1, "ext": ["CONT'D"], "paren": ["quietly"], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Who?", "name": "OTTILIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Who collects the post?", "name": "RASMUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Ottilie goes pale.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "She turns to the dresser and opens a drawer.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "In it, a bundle of envelopes tied with twine.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "She holds them a long moment.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Then she places them on the table between them.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "I could not read them. My eyes. I was ashamed.", "name": "OTTILIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Oh, Mama.", "name": "RASMUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "He reaches across and covers her hand with his.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "The soup steams between them, ignored.", "para": 7, "sent": 1, "present": [0, 1]}]}