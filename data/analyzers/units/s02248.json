{"scene_id": "s02248", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02248.fountain", "heading": "INT. COURTHOUSE CONFERENCE ROOM - DAY", "cast": [{"id": 0, "name": "PHOEBE LINDQVIST", "names": ["PHOEBE LINDQVIST", "PHOEBE"], "gender": "?", "first": 4, "spoke": 11}, {"id": 1, "name": "KARIM HADDAD", "names": ["KARIM HADDAD", "KARIM"], "gender": "m", "first": 6, "spoke": 9}, {"id": 2, "name": "WALT OSTROWSKI", "names": ["WALT OSTROWSKI", "WALT"], "gender": "?", "first": 8, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. COURTHOUSE CONFERENCE ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A windowless room, laminate table, fluorescent hum.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A pitcher of water sweats beside two paper cups.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "On the wall, a faded print of a ship in a storm.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "PHOEBE LINDQVIST, thirties, a public defender with a blunt haircut and a rumpled blazer, arranges folders in neat rows.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Her eyes are tired but sharp.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Across from her sits KARIM HADDAD, twenty-eight, in a county-issue orange jumpsuit, wrists cuffed to a ring in the table.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He's thin, bearded, with a scar through his left eyebrow and hands that don't stop moving.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Standing by the door, WALT OSTROWSKI, fifties, a bailiff with a broad belly and a kind, tired face, watches the clock.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "The offer expires at noon.", "name": "PHOEBE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "What is it?", "name": "KARIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Eight years. You serve five.", "name": "PHOEBE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "For what I didn't do.", "name": "KARIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "For what they can prove you did.", "name": "PHOEBE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I was at my mother's.", "name": "KARIM", "speaker": 1, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Who can say that besides you?", "name": "PHOEBE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "She can.", "name": "KARIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "She's in a coma, Karim.", "name": "PHOEBE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Karim looks at his hands.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Phoebe waits.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Mr. Haddad, she's right about the clock.", "name": "WALT", "speaker": 2, "ext": [], "paren": ["gently, from the door"], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "I know, Walt.", "name": "KARIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Take the deal. You'll be out for your mother's birthday.", "name": "WALT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "She won't have one if she's--", "name": "KARIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "He doesn't finish.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Phoebe slides a legal pad toward him.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Write down everything you remember about the night of the ninth. Every detail.", "name": "PHOEBE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "I've told it ten times.", "name": "KARIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Tell it to the paper.", "name": "PHOEBE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "He takes the pen.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Writes.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Stops.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Writes.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Phoebe watches the lines grow, her face unreadable.", "para": 6, "sent": 4, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Walt checks the clock again.", "para": 6, "sent": 5, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Karim pushes the pad back.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Phoebe reads.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Her brow lifts at one line.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "The neighbor's dog.", "name": "PHOEBE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "It barked at eleven. I remember because I was changing her IV.", "name": "KARIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "That's not in the police report.", "name": "PHOEBE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Nobody asked about the dog.", "name": "KARIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Walt, I need the judge.", "name": "PHOEBE", "speaker": 0, "ext": [], "paren": ["rising"], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "She's at lunch.", "name": "WALT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Then I need a sandwich and the judge.", "name": "PHOEBE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Walt laughs, short, and heads for the door.", "para": 8, "sent": 0, "present": [0, 1, 2]}]}