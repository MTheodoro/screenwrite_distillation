{"scene_id": "s02249", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02249.fountain", "heading": "INT. NEWSROOM - OVERNIGHT - EMPTY", "cast": [{"id": 0, "name": "LUCINDA VALE", "names": ["LUCINDA VALE", "LUCINDA"], "gender": "f", "first": 6, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. NEWSROOM - OVERNIGHT - EMPTY", "present": []}, {"u": 1, "kind": "action", "text": "Desks in rows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dead monitors.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cleaning cart abandoned mid-aisle.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "An answering machine blinks on a corner desk, red.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A stairwell door opens.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "LUCINDA VALE, forties, a long raincoat, a messenger bag, a flash drive between her fingers, slips in.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "She locks the door behind her.", "para": 2, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "Crosses the room on tiptoe.", "para": 2, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "She stops at the corner desk.", "para": 3, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "Presses the machine's button.", "para": 3, "sent": 1, "present": [0]}, {"u": 11, "kind": "dialogue", "text": "Message one. Lucy, it's you. If you're hearing this, you're back at the paper. Don't go home. They'll be at the apartment.", "name": "LUCINDA", "speaker": 0, "ext": ["V.O."], "paren": ["her recorded voice, tired"], "dual": false, "present": [0]}, {"u": 12, "kind": "action", "text": "Lucinda sits.", "para": 4, "sent": 0, "present": [0]}, {"u": 13, "kind": "action", "text": "Her hand covers her mouth.", "para": 4, "sent": 1, "present": [0]}, {"u": 14, "kind": "dialogue", "text": "The story's real. Every document. But they know about the drive.", "name": "LUCINDA", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 15, "kind": "action", "text": "She looks at the flash drive in her palm.", "para": 5, "sent": 0, "present": [0]}, {"u": 16, "kind": "dialogue", "text": "Of course they do.", "name": "LUCINDA", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0]}, {"u": 17, "kind": "dialogue", "text": "Message two. Send it from the old terminal. The one with no network log.", "name": "LUCINDA", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0]}, {"u": 18, "kind": "dialogue", "text": "Clever girl.", "name": "LUCINDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 19, "kind": "action", "text": "The machine clicks off.", "para": 6, "sent": 0, "present": [0]}, {"u": 20, "kind": "action", "text": "She rises.", "para": 7, "sent": 0, "present": [0]}, {"u": 21, "kind": "action", "text": "Crosses to a dusty terminal beneath a stack of old directories, blows off the dust, turns it on.", "para": 7, "sent": 1, "present": [0]}, {"u": 22, "kind": "action", "text": "It groans awake.", "para": 7, "sent": 2, "present": [0]}, {"u": 23, "kind": "action", "text": "She plugs in the drive.", "para": 8, "sent": 0, "present": [0]}, {"u": 24, "kind": "action", "text": "A folder opens.", "para": 8, "sent": 1, "present": [0]}, {"u": 25, "kind": "action", "text": "Hundreds of files.", "para": 8, "sent": 2, "present": [0]}, {"u": 26, "kind": "action", "text": "She scrolls fast, eyes flicking.", "para": 8, "sent": 3, "present": [0]}, {"u": 27, "kind": "dialogue", "text": "There you are.", "name": "LUCINDA", "speaker": 0, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0]}, {"u": 28, "kind": "action", "text": "She selects a document and attaches it to an email.", "para": 9, "sent": 0, "present": [0]}, {"u": 29, "kind": "action", "text": "Her cursor hovers over SEND.", "para": 9, "sent": 1, "present": [0]}, {"u": 30, "kind": "action", "text": "Somewhere in the building, an elevator dings.", "para": 9, "sent": 2, "present": [0]}, {"u": 31, "kind": "action", "text": "She flinches, then steadies herself, and clicks.", "para": 9, "sent": 3, "present": [0]}, {"u": 32, "kind": "action", "text": "A progress bar crawls.", "para": 10, "sent": 0, "present": [0]}, {"u": 33, "kind": "dialogue", "text": "Come on. Come on.", "name": "LUCINDA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 34, "kind": "action", "text": "The bar hits ninety.", "para": 11, "sent": 0, "present": [0]}, {"u": 35, "kind": "action", "text": "Ninety-five.", "para": 11, "sent": 1, "present": [0]}, {"u": 36, "kind": "action", "text": "She pulls the drive free as it completes.", "para": 11, "sent": 2, "present": [0]}, {"u": 37, "kind": "action", "text": "The terminal chimes, softly: SENT.", "para": 11, "sent": 3, "present": [0]}, {"u": 38, "kind": "action", "text": "Lucinda shuts her eyes, then pockets the drive, buttons her raincoat, and leaves the way she came.", "para": 12, "sent": 0, "present": [0]}]}