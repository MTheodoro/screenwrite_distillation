{"scene_id": "s02250", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02250.fountain", "heading": "INT. LAUNDROMAT - NIGHT", "cast": [{"id": 0, "name": "MORRIS", "names": ["MORRIS"], "gender": "?", "first": 4, "spoke": 7}, {"id": 1, "name": "DELPHINE", "names": ["DELPHINE"], "gender": "f", "first": 4, "spoke": 6}, {"id": 2, "name": "IKE", "names": ["IKE"], "gender": "?", "first": 4, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAUNDROMAT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Rows of humming dryers.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A flickering sign reads OPEN 24 HRS.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A change machine with a hand-lettered OUT OF ORDER taped across its face.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MORRIS, sixty, folds a stack of faded towels on a table with the slow thoroughness of a man with nowhere else to be, while DELPHINE, thirty, a nurse in scrubs, yanks a wet tangle of sheets from a washer and stuffs them into a dryer, and IKE, eighteen, headphones around his neck, sits cross-legged on a countertop watching his sneakers tumble inside the next machine over, thump, thump, thump, and every few seconds Morris glances at Delphine and Delphine glances at Ike and Ike glances at nothing.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "Busy night.", "name": "MORRIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "I just got off a double.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Rough?", "name": "MORRIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Quiet. Which is rough.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Morris smooths a towel.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Delphine feeds quarters into the dryer, one at a time, counting under her breath.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Do you guys know if the machine eats dollar bills?", "name": "IKE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "It eats everything.", "name": "MORRIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "It ate five bucks last week.", "name": "IKE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "It has eaten my whole paycheck.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Ike laughs, a short surprised bark.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Morris chuckles.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Delphine lets herself grin.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "They sit with the warm roar of the dryers between them.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I come here because my apartment's quiet.", "name": "MORRIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Mine too.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Mine's loud.", "name": "IKE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Then you're the lucky one.", "name": "MORRIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Doesn't feel lucky.", "name": "IKE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Delphine slides the last quarter in.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "The dryer starts.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "She leans against it, closes her eyes.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Wake me when it's done.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "I'll fold your sheets.", "name": "MORRIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "You don't have to.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "I'm already here.", "name": "MORRIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}