{"scene_id": "s02251", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02251.fountain", "heading": "INT. COLONY SHIP \"MARGINALIA\" - BRIDGE - SHIP'S NIGHT", "cast": [{"id": 0, "name": "CAPTAIN YUSRA", "names": ["CAPTAIN YUSRA", "YUSRA"], "gender": "?", "first": 4, "spoke": 11}, {"id": 1, "name": "ENGINEER BOLT", "names": ["ENGINEER BOLT", "BOLT"], "gender": "f", "first": 5, "spoke": 6}, {"id": 2, "name": "SAKURA", "names": ["SAKURA"], "gender": "?", "first": 6, "spoke": 5}, {"id": 3, "name": "PILOT MATEO", "names": ["PILOT MATEO", "MATEO"], "gender": "?", "first": 7, "spoke": 6}, {"id": 4, "name": "CADET NILS", "names": ["CADET NILS", "NILS"], "gender": "?", "first": 8, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. COLONY SHIP \"MARGINALIA\" - BRIDGE - SHIP'S NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A dim, circular room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Banks of screens.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "One wall is a viewport onto a vast gas giant, its bands glowing amber.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CAPTAIN YUSRA, fifties, a gray crop, in a worn command jacket, stands at the center console.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "ENGINEER BOLT, forties, grease up to her elbows, leans over a panel of exposed wiring.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "DR. SAKURA, thirties, the ship's physician, sits cross-legged on the deck with a medkit.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "PILOT MATEO, thirties, in the helm chair, scowls at a blinking display.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "CADET NILS, nineteen, at the comms station, still wearing a training badge.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "Alarm klaxons, soft and rhythmic.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Report. All stations.", "name": "YUSRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Fuel line's leaking. I can patch it, Captain, but not for long.", "name": "BOLT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "We're drifting toward the giant's gravity well. Eight hours.", "name": "MATEO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Captain, I'm getting a signal. It's not ours.", "name": "NILS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Nils, put it through.", "name": "YUSRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "It's encrypted.", "name": "NILS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Then decrypt it.", "name": "BOLT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "I'm a cadet!", "name": "NILS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Nils, breathe.", "name": "SAKURA", "speaker": 2, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Yusra, if we burn the reserve we can slingshot. Maybe.", "name": "MATEO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Maybe is not a plan.", "name": "YUSRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Maybe is all I've got.", "name": "BOLT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Captain, the passengers are asking for updates.", "name": "SAKURA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Tell them we have a minor delay.", "name": "YUSRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "They won't believe that.", "name": "SAKURA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Then tell them a major one, with confidence.", "name": "YUSRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "The signal is a voice. A woman's voice. She's saying coordinates.", "name": "NILS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Where?", "name": "MATEO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Sector twelve. Near the ring debris.", "name": "NILS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "There's a station in sector twelve. Old. Abandoned.", "name": "BOLT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Is it abandoned?", "name": "YUSRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "It's broadcasting.", "name": "NILS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Captain, it could be a trap.", "name": "MATEO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Everything's a trap. Plot a course.", "name": "YUSRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Yes, ma'am.", "name": "MATEO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "That'll cost eighty percent of the reserve.", "name": "BOLT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Then we'd better get there the first time.", "name": "YUSRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "The ship shudders.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Lights flicker.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "The viewport shows the gas giant swelling, a wall of amber fire.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "I'll tell the passengers the truth.", "name": "SAKURA", "speaker": 2, "ext": [], "paren": ["rising"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Doctor.", "name": "YUSRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Captain.", "name": "SAKURA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Tell them gently.", "name": "YUSRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Sakura nods and leaves.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "The bridge hums on.", "para": 4, "sent": 1, "present": [0, 1, 3, 4]}, {"u": 46, "kind": "action", "text": "Mateo's hands move across the controls, steady now.", "para": 4, "sent": 2, "present": [0, 1, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "Course plotted.", "name": "MATEO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Fuel line is holding. For now.", "name": "BOLT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Captain, the message changed. It's in plain text now.", "name": "NILS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Read it.", "name": "YUSRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "\"Marginalia, welcome. We've been waiting.\"", "name": "NILS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3, 4]}, {"u": 52, "kind": "action", "text": "The bridge falls silent.", "para": 5, "sent": 0, "present": [0, 1, 3, 4]}]}