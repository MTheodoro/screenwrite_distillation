{"scene_id": "s02253", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02253.fountain", "heading": "EXT. CATTLE PEN AT DUSK - SUNDAY", "cast": [{"id": 0, "name": "HANK YAZZIE", "names": ["HANK YAZZIE", "HANK"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "MILLIE", "names": ["MILLIE"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "LAZARUS", "names": ["LAZARUS"], "gender": "?", "first": 6, "spoke": 7}, {"id": 3, "name": "PETE", "names": ["PETE"], "gender": "?", "first": 7, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "EXT. CATTLE PEN AT DUSK - SUNDAY", "present": []}, {"u": 1, "kind": "action", "text": "Dust.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Lowing steers.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A split-rail fence, a bucket, a lantern on a post.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "HANK YAZZIE, forties, leans on the fence.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "MILLIE, thirties, a cook in a flour-dusted apron, ladles beans from a pot.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "LAZARUS, sixty, a one-eyed drover, sits on an upturned bucket whittling.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "PETE, nineteen, new on the crew, brushes a horse.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Supper's up.", "name": "MILLIE", "speaker": 1, "ext": [], "paren": ["to everyone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Smells good.", "name": "HANK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Smells like boots.", "name": "LAZARUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Then don't eat it, Laz.", "name": "MILLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "I'll eat it.", "name": "LAZARUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Mrs. Millie, can I have seconds?", "name": "PETE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "You haven't had firsts.", "name": "MILLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "I'm planning ahead.", "name": "PETE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Pete, how's the bay mare?", "name": "HANK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Limping, Mr. Yazzie.", "name": "PETE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Which leg?", "name": "HANK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Left front.", "name": "PETE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "It's the right.", "name": "LAZARUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "It's the left.", "name": "PETE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Boy can't tell his left from his own elbow.", "name": "LAZARUS", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Lazarus.", "name": "MILLIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "I'm just saying.", "name": "LAZARUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Look at the hoof, Pete. Look, not guess.", "name": "HANK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Yes, sir.", "name": "PETE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "He crouches.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Lifts the mare's foot.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Squints.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Stone.", "name": "PETE", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Pick it out.", "name": "HANK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Right front. Told you.", "name": "LAZARUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Left.", "name": "PETE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Right!", "name": "LAZARUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Everyone eat.", "name": "HANK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "They quiet.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Millie passes bowls.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "The steers settle.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Lazarus slowly resumes whittling.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}]}