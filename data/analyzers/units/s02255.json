{"scene_id": "s02255", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02255.fountain", "heading": "INT. FERRY CAR DECK - NIGHT", "cast": [{"id": 0, "name": "AGENT TORVALD", "names": ["AGENT TORVALD", "TORVALD"], "gender": "?", "first": 5, "spoke": 9}, {"id": 1, "name": "MERCEDES", "names": ["MERCEDES"], "gender": "?", "first": 6, "spoke": 5}, {"id": 2, "name": "JIN", "names": ["JIN"], "gender": "?", "first": 6, "spoke": 4}, {"id": 3, "name": "HADIZA", "names": ["HADIZA"], "gender": "?", "first": 6, "spoke": 3}, {"id": 4, "name": "COLM", "names": ["COLM"], "gender": "m", "first": 7, "spoke": 5}, {"id": 5, "name": "BEATRIX", "names": ["BEATRIX"], "gender": "f", "first": 8, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. FERRY CAR DECK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A vast steel cavern, trucks and cars chained to the floor.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Engines idle.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A low, constant drone.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Overhead lamps in cages cast slatted shadows.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "AGENT TORVALD, fifties, trench coat, stands beside a white delivery van.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "MERCEDES, forties, a ferry officer in a navy jacket, leads two others toward him: JIN, thirties, a mechanic in grease-black overalls, and HADIZA, twenties, a deckhand with a heavy flashlight.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "Behind them COLM, sixty, the ship's cook, drags a trolley of crates.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "BEATRIX, thirties, a passenger in a cashmere coat, trails at a distance, hugging a briefcase.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "Open it.", "name": "TORVALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Agent Torvald, we have a protocol.", "name": "MERCEDES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "I'm the protocol tonight.", "name": "TORVALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "He's got a warrant, Mercedes.", "name": "JIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "He has a piece of paper.", "name": "MERCEDES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "It's got a stamp.", "name": "HADIZA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Stamps are cheap.", "name": "COLM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Mr. Colm, step back.", "name": "TORVALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "I'm only pushing a trolley, mister.", "name": "COLM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Then push it elsewhere.", "name": "TORVALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Colm shrugs and parks the trolley against a pillar.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Beatrix inches nearer.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Excuse me. Is there a problem?", "name": "BEATRIX", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Ma'am, this doesn't concern you.", "name": "TORVALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "I'm in cabin twelve. It's concerning me.", "name": "BEATRIX", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Please return to your cabin, ma'am.", "name": "MERCEDES", "speaker": 1, "ext": [], "paren": ["to Beatrix"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "I'd like to see what's in that van.", "name": "BEATRIX", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Don't we all.", "name": "JIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Torvald yanks a latch.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "The van's rear doors swing open.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Rows of wooden crates, stenciled in a foreign alphabet.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "He lifts a lid.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Straw.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Beneath it, bundles of cash wrapped in plastic.", "para": 3, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "That's... a lot.", "name": "HADIZA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "That's a very lot.", "name": "JIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Agent Torvald, whose is this?", "name": "MERCEDES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Mine, if I'm lucky. Evidence, if I'm not.", "name": "TORVALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "It's mine.", "name": "BEATRIX", "speaker": 5, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "They all turn.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Beatrix sets down her briefcase, opens it, takes out a tiny pistol.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "No heroes, please. I'm tired.", "name": "BEATRIX", "speaker": 5, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Ma'am, put it down.", "name": "TORVALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "I paid for this ride, Agent. Nobody's taking my cargo.", "name": "BEATRIX", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Miss, I've been cooking on this boat for thirty years. I've never seen anything so stupid.", "name": "COLM", "speaker": 4, "ext": [], "paren": ["sighing"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "You haven't seen much, then.", "name": "BEATRIX", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Mercedes, do something.", "name": "JIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "I'm the first officer, not a gunslinger.", "name": "MERCEDES", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "I'll hit her with the flashlight.", "name": "HADIZA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "No, Hadiza.", "name": "TORVALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "Hadiza lowers the flashlight.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Beatrix levels the pistol at Torvald.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "Step away from the van.", "name": "BEATRIX", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "Torvald raises both hands.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "Steps back.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "Colm slowly takes a pan from the trolley, hand behind his back.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "Miss Beatrix, would you like a coffee?", "name": "COLM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "What?", "name": "BEATRIX", "speaker": 5, "ext": [], "paren": ["blinking"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "Colm swings the pan.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "It clangs on her wrist.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "action", "text": "The pistol clatters across the deck.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "Jin dives on it.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "Mercedes sits on Beatrix before she can reach it.", "para": 8, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "Torvald exhales for the first time in a minute.", "para": 8, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "dialogue", "text": "Thank you.", "name": "TORVALD", "speaker": 0, "ext": [], "paren": ["to Colm"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "dialogue", "text": "Mind the straw. It's flammable.", "name": "COLM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}