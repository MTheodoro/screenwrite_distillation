{"scene_id": "s02256", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02256.fountain", "heading": "INT. LIGHTHOUSE KEEPER'S QUARTERS - NIGHT", "cast": [{"id": 0, "name": "ALDER", "names": ["ALDER"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "POSY", "names": ["POSY"], "gender": "?", "first": 5, "spoke": 3}, {"id": 2, "name": "GARRICK", "names": ["GARRICK"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "TILDA", "names": ["TILDA"], "gender": "?", "first": 7, "spoke": 1}, {"id": 4, "name": "RUDO", "names": ["RUDO"], "gender": "?", "first": 7, "spoke": 1}, {"id": 5, "name": "PENHALLOW", "names": ["PENHALLOW", "MR. PENHALLOW"], "gender": "?", "first": 27, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. LIGHTHOUSE KEEPER'S QUARTERS - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A circular room with a cast-iron stove, six cots, shuttered windows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A storm throws rain against the glass.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Candle stubs gutter on the sill.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ALDER, forties, a coast guard captain, stands near the stove.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "POSY, twenty, a young lighthouse apprentice, huddles on a cot.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "GARRICK, fifties, a retired seaman, sits cleaning a rifle.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "TILDA, thirties, a nurse, bandages a cut on RUDO's arm.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "RUDO, thirties, a fisherman, grimaces.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "Something thumps on the roof.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Nobody panic.", "name": "ALDER", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "It's the wind.", "name": "POSY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "That wasn't the wind.", "name": "GARRICK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Hold still, Rudo.", "name": "TILDA", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "I'm holding still.", "name": "RUDO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Another thump.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Dust sifts from the ceiling.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Come on, come on.", "name": "ALDER", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Captain, what is it?", "name": "POSY", "speaker": 1, "ext": [], "paren": ["to Alder"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "I don't know.", "name": "ALDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "The stove door rattles.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "The windows shudder.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Then silence.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "A knock at the door.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Three slow knocks.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "They all look at Alder.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "He steps forward, hand on his holster, and slides back the bolt.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "On the threshold stands MR. PENHALLOW, sixties, drenched, in a sou'wester too small for his frame.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "He smiles with all his teeth.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Good evening. I'm so sorry to disturb you. My boat has been lost.", "name": "MR. PENHALLOW", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Come in out of the rain.", "name": "ALDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "You are kind.", "name": "MR. PENHALLOW", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "He steps in.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "The candle flames bend toward him.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Garrick lifts the rifle.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Captain.", "name": "GARRICK", "speaker": 2, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "I see it.", "name": "ALDER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "His feet.", "name": "POSY", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "No one looks down.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Nobody dares to.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "The puddle spreading from Penhallow's boots is dark, thick, and not rainwater.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}