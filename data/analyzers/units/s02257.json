{"scene_id": "s02257", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02257.fountain", "heading": "INT. ROADSIDE INN - NIGHT", "cast": [{"id": 0, "name": "ELIAS", "names": ["ELIAS"], "gender": "m", "first": 4, "spoke": 17}, {"id": 1, "name": "CORAZON", "names": ["CORAZON"], "gender": "f", "first": 5, "spoke": 13}, {"id": 2, "name": "TUCK", "names": ["TUCK"], "gender": "?", "first": 6, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROADSIDE INN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped room, a table, a candle.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Three chairs.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A bottle of rye between them.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ELIAS, fifties, a bounty hunter, mud on his boots.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "CORAZON, thirties, the innkeeper, sleeves rolled up.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "TUCK, twenty, a boy with a bandaged hand.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "You know who I'm after.", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "I know a lot of people.", "name": "CORAZON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "A man with a red scarf and a limp.", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Plenty of limps in this valley.", "name": "CORAZON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Not plenty with a scarf.", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "He was here Tuesday.", "name": "TUCK", "speaker": 2, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Tuck.", "name": "CORAZON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "He was, Mama. He paid for the room with a gold coin.", "name": "TUCK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "A gold coin. Where's the coin now?", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "In the church box.", "name": "CORAZON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Then I'll want to see the church box.", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "It's Sunday. The padre is asleep.", "name": "CORAZON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Then wake him.", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Mister, he said he was going to Albuquerque.", "name": "TUCK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Did he say why?", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "To see a doctor.", "name": "TUCK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "For the limp.", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "For his heart. He said it was broken.", "name": "TUCK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Elias pours a drink.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Doesn't touch it.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "He killed a family in Santa Rosa. Three children.", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "God forgive him.", "name": "CORAZON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "I don't want God to. That's my job.", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Mama, tell him.", "name": "TUCK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Tell him what?", "name": "CORAZON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "About the letter.", "name": "TUCK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Corazon closes her eyes.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Elias leans forward.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "What letter?", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "He left a letter. Addressed to a priest in Albuquerque. I didn't mail it.", "name": "CORAZON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Why not?", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Because I read it.", "name": "CORAZON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "She cried all night.", "name": "TUCK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Ma'am. What did it say?", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "That he wanted to be found.", "name": "CORAZON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "A long silence.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "The candle gutters.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Elias sets his glass down.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Give me the letter.", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "It's mine now.", "name": "CORAZON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Ma'am.", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Let him find his own way to the rope. Take the letter, you'll be the one who took him there.", "name": "CORAZON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Elias studies her.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Then Tuck.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Then the bottle.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Keep the letter. Mail it tomorrow.", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "And you?", "name": "CORAZON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "I'll ride to Albuquerque ahead of it.", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}