{"scene_id": "s02258", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02258.fountain", "heading": "INT. HIGH SCHOOL GYM - LOCKER ROOM - NIGHT", "cast": [{"id": 0, "name": "WHITLOCK", "names": ["WHITLOCK", "COACH WHITLOCK"], "gender": "m", "first": 4, "spoke": 10}, {"id": 1, "name": "DRE", "names": ["DRE"], "gender": "?", "first": 5, "spoke": 2}, {"id": 2, "name": "KENZIE", "names": ["KENZIE"], "gender": "f", "first": 6, "spoke": 2}, {"id": 3, "name": "SAL", "names": ["SAL"], "gender": "m", "first": 7, "spoke": 2}, {"id": 4, "name": "MOOKIE", "names": ["MOOKIE"], "gender": "m", "first": 8, "spoke": 2}, {"id": 5, "name": "ILYA", "names": ["ILYA"], "gender": "m", "first": 9, "spoke": 3}, {"id": 6, "name": "ALL", "names": ["ALL"], "gender": "?", "first": 41, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. HIGH SCHOOL GYM - LOCKER ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cinderblock walls painted maroon.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Benches bolted to the floor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A whiteboard with X's and O's smeared into gray.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "COACH BARNABY \"BARN\" WHITLOCK, fifties, a whistle around his neck and a clipboard under his arm, paces.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "DRE, seventeen, the point guard.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "KENZIE, sixteen, a power forward, ties her sneakers.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "SAL, eighteen, a center, towel over his head.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "MOOKIE, fifteen, the smallest, bounces a ball.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "ILYA, seventeen, a transfer, stares at his hands.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Listen up. Fourth quarter, eight points down. This is the league final. Eight points, four minutes.", "name": "COACH WHITLOCK", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "We can do eight.", "name": "DRE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "We've done more.", "name": "KENZIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "We have not.", "name": "SAL", "speaker": 3, "ext": [], "paren": ["muffled under the towel"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Sal, towel off your head.", "name": "COACH WHITLOCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Yes, Coach.", "name": "SAL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Mookie, put the ball down.", "name": "COACH WHITLOCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Sorry, Coach.", "name": "MOOKIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "He doesn't put it down.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Whitlock glares.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Mookie tucks it under his arm.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Dre, you bring it up fast. Kenzie, set the screen. Sal, roll to the rim. Ilya.", "name": "COACH WHITLOCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Yes, Coach?", "name": "ILYA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "You're the corner shooter.", "name": "COACH WHITLOCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "I missed my last four.", "name": "ILYA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "You'll hit the next one.", "name": "COACH WHITLOCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "I don't know.", "name": "ILYA", "speaker": 5, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "You will. Don't think.", "name": "KENZIE", "speaker": 2, "ext": [], "paren": ["to Ilya"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "That's right. Don't think. Shoot.", "name": "COACH WHITLOCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "A pounding at the door.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "A buzzer blares in the gym beyond.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "That's two minutes! Up!", "name": "COACH WHITLOCK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "The team rises as one.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Dre slaps Sal's shoulder.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Kenzie punches Ilya's arm, gently.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Mookie scrambles onto a bench and, for a moment, stands taller than anyone.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "We got this!", "name": "MOOKIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Get off the bench, Mookie.", "name": "COACH WHITLOCK", "speaker": 0, "ext": [], "paren": ["drily"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Mookie hops down.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "They form a circle, hands in the middle.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "One, two, three.", "name": "DRE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Go!", "name": "ALL", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "They file out.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "Whitlock watches them go, then glances at the whiteboard and wipes it clean with his sleeve.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "dialogue", "text": "Eight points. Four minutes. Please.", "name": "COACH WHITLOCK", "speaker": 0, "ext": ["CONT'D"], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}