{"scene_id": "s02259", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02259.fountain", "heading": "INT. MORTUARY BASEMENT - NIGHT", "cast": [{"id": 0, "name": "EDIE", "names": ["EDIE"], "gender": "?", "first": 5, "spoke": 2}, {"id": 1, "name": "WINNIFRED", "names": ["WINNIFRED"], "gender": "?", "first": 5, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. MORTUARY BASEMENT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "White tile.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A drain in the floor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Steel drawers set into the wall, each with a numbered tag.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single bulb hums over a stainless table.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "EDIE, thirties, a night attendant in a gray smock, stands with a clipboard at the foot of the table, and WINNIFRED, seventies, the visiting widow in a black veil and sensible shoes, hovers beside drawer fourteen with her hand on the handle, and neither of them speaks until the bulb flickers and every drawer in the wall slides open an inch at once and Edie drops the clipboard and Winnifred, without moving, begins to hum.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Ma'am, step away from the wall.", "name": "EDIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "I'm not touching anything.", "name": "WINNIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "The drawers are opening.", "name": "EDIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "They always do for me.", "name": "WINNIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}