{"scene_id": "s02260", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02260.fountain", "heading": "EXT. TRACK, MUNICIPAL STADIUM - PRE-DAWN", "cast": [{"id": 0, "name": "KALINDA", "names": ["KALINDA"], "gender": "f", "first": 5, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "EXT. TRACK, MUNICIPAL STADIUM - PRE-DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Empty bleachers.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Floodlights at half power.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Frost on the infield.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Lane lines glow white.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "KALINDA, thirty-two, a distance runner in a thin jacket and tights, stretches against the starting block, one earbud in, her phone strapped to her upper arm.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A bruise-colored sky pushes against the east wall.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She checks her watch.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Taps her phone.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "dialogue", "text": "Day one-oh-seven. Hamstring's tight. Don't be a hero.", "name": "KALINDA", "speaker": 0, "ext": ["V.O."], "paren": ["her own recorded voice, wry"], "dual": false, "present": [0]}, {"u": 10, "kind": "action", "text": "Kalinda grimaces, a small laugh.", "para": 3, "sent": 0, "present": [0]}, {"u": 11, "kind": "dialogue", "text": "Noted.", "name": "KALINDA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 12, "kind": "action", "text": "She jogs a slow lap.", "para": 4, "sent": 0, "present": [0]}, {"u": 13, "kind": "action", "text": "Her breath puffs in the cold.", "para": 4, "sent": 1, "present": [0]}, {"u": 14, "kind": "action", "text": "At the far curve, she stops, retightens a lace.", "para": 4, "sent": 2, "present": [0]}, {"u": 15, "kind": "dialogue", "text": "Day ninety. Hit the wall at three miles. Cried a little. Kept going.", "name": "KALINDA", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0]}, {"u": 16, "kind": "action", "text": "She straightens.", "para": 5, "sent": 0, "present": [0]}, {"u": 17, "kind": "action", "text": "Shakes out her arms.", "para": 5, "sent": 1, "present": [0]}, {"u": 18, "kind": "action", "text": "Breaks into a steady pace, long strides, breath in quarter time.", "para": 5, "sent": 2, "present": [0]}, {"u": 19, "kind": "dialogue", "text": "Day sixty. Told Mom I might retire. She said retire from what? I said running. She said, you never started.", "name": "KALINDA", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0]}, {"u": 20, "kind": "action", "text": "Kalinda snorts.", "para": 6, "sent": 0, "present": [0]}, {"u": 21, "kind": "action", "text": "Rounds the curve.", "para": 6, "sent": 1, "present": [0]}, {"u": 22, "kind": "dialogue", "text": "Day one. Four hundred meters. Walked half. Felt like an idiot.", "name": "KALINDA", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0]}, {"u": 23, "kind": "action", "text": "She lengthens her stride.", "para": 7, "sent": 0, "present": [0]}, {"u": 24, "kind": "action", "text": "The sky pinks.", "para": 7, "sent": 1, "present": [0]}, {"u": 25, "kind": "dialogue", "text": "Whoever you are today, run like you did on day one. Like you had nothing to prove.", "name": "KALINDA", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0]}, {"u": 26, "kind": "action", "text": "She nods once to the empty stands.", "para": 8, "sent": 0, "present": [0]}, {"u": 27, "kind": "action", "text": "Runs on, and the floodlights, one by one, click off as dawn takes over.", "para": 8, "sent": 1, "present": [0]}]}