{"scene_id": "s02261", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02261.fountain", "heading": "INT. GRANDMOTHER'S ATTIC - EVENING", "cast": [{"id": 0, "name": "GRANDMA ODILE", "names": ["GRANDMA ODILE"], "gender": "f", "first": 4, "spoke": 5}, {"id": 1, "name": "DAD MWANGI", "names": ["DAD MWANGI"], "gender": "m", "first": 5, "spoke": 1}, {"id": 2, "name": "BOY", "names": ["BOY"], "gender": "?", "first": 6, "spoke": 3}, {"id": 3, "name": "THEO", "names": ["THEO"], "gender": "?", "first": 15, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRANDMOTHER'S ATTIC - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Slanted beams.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Trunks, a dressmaker's dummy, a rocking horse with one eye.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single round window.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "GRANDMA ODILE, seventies, in a flowered housecoat, sits on a trunk with a shoebox on her knees.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "DAD MWANGI, forties, crouches by a stack of framed photos, wiping dust.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "A BOY, eight, in a too-big pajama top, climbs the attic ladder and peeks over the edge.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Are you guys up here?", "name": "BOY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Come, sweet pea.", "name": "GRANDMA ODILE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "He climbs the rest of the way.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Pads across the floor.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "What's in the box?", "name": "BOY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Letters.", "name": "GRANDMA ODILE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "From who?", "name": "BOY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "From your grandfather. Before he was your grandfather.", "name": "GRANDMA ODILE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Theo, you should be in bed.", "name": "DAD MWANGI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Grandma's telling a story.", "name": "THEO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Let him stay.", "name": "GRANDMA ODILE", "speaker": 0, "ext": [], "paren": ["to Mwangi"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Mwangi sighs.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Sits.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Grandma, are the letters sad?", "name": "THEO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Some are. Some are silly. This one is about a goat.", "name": "GRANDMA ODILE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "A goat!", "name": "THEO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "She unfolds the page.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Mwangi smiles despite himself.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}]}