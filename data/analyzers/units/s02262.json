{"scene_id": "s02262", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02262.fountain", "heading": "INT. HOSPITAL ROOM 412 - EARLY MORNING", "cast": [{"id": 0, "name": "HYE-WON PARK", "names": ["HYE-WON PARK", "HYE-WON"], "gender": "?", "first": 5, "spoke": 9}, {"id": 1, "name": "LINDGREN", "names": ["LINDGREN"], "gender": "m", "first": 6, "spoke": 11}, {"id": 2, "name": "NURSE ABIOLA", "names": ["NURSE ABIOLA", "ABIOLA"], "gender": "f", "first": 7, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOSPITAL ROOM 412 - EARLY MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Blinds half-open.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A low monitor beeps.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A tray with an untouched breakfast.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A vase of wilting carnations on the sill.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. HYE-WON PARK, forties, a gray cardigan over her scrubs, enters with a chart.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "MR. LINDGREN, seventy, lies propped in bed in a thin hospital gown, white stubble, an IV in his hand.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "NURSE ABIOLA, thirties, adjusting a pillow, glances up.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Good morning, Mr. Lindgren.", "name": "HYE-WON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Is it?", "name": "LINDGREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I hope so.", "name": "HYE-WON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "She sets the chart down.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Pulls a stool to the bedside.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Abiola steps back, letting her take the space.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "How did you sleep?", "name": "HYE-WON", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Fine.", "name": "LINDGREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "He was up twice.", "name": "ABIOLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I was not.", "name": "LINDGREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "You asked me for the radio.", "name": "ABIOLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "That's not sleeping badly. That's listening.", "name": "LINDGREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Hye-won almost smiles.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "She reaches for his wrist, checks his pulse.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Your tests came back.", "name": "HYE-WON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "And?", "name": "LINDGREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "I'd like to go through them with you.", "name": "HYE-WON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Just say it.", "name": "LINDGREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Hye-won exchanges a glance with Abiola.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Abiola looks at the floor.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "It's in the pancreas. It has spread to the liver.", "name": "HYE-WON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "He turns his head to the window.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "His jaw works.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The monitor keeps its steady beep.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "How long?", "name": "LINDGREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Months. Perhaps less.", "name": "HYE-WON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "He nods.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Reaches for the glass of water on the tray.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "His hand shakes.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Abiola moves to help but he waves her off.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "He drinks.", "para": 6, "sent": 4, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Sets the glass down with great care.", "para": 6, "sent": 5, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "My wife used to say I'd outlive the doctors.", "name": "LINDGREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "She might have been right.", "name": "HYE-WON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "She was usually right. It was annoying.", "name": "LINDGREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Abiola laughs, a short sound, then covers her mouth.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Hye-won puts a hand on his arm.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "We'll keep you comfortable.", "name": "HYE-WON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "I know.", "name": "LINDGREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "He picks at the corner of the blanket.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Abiola straightens the carnations, plucks off a brown petal.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Can I have the radio?", "name": "LINDGREN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Of course.", "name": "ABIOLA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "She fetches it from the drawer, plugs it in, and finds a station.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "A soft piano.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "He closes his eyes.", "para": 9, "sent": 2, "present": [0, 1, 2]}]}