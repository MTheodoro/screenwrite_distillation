nt": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Every head disappears behind the partitions.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}]}