{"scene_id": "s02264", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02264.fountain", "heading": "INT. COUNTRY HOUSE DINING ROOM - 1840S - EVENING", "cast": [{"id": 0, "name": "AGNES", "names": ["AGNES"], "gender": "f", "first": 5, "spoke": 14}, {"id": 1, "name": "FOTHERGILL", "names": ["FOTHERGILL"], "gender": "m", "first": 6, "spoke": 10}, {"id": 2, "name": "EDMUND", "names": ["EDMUND"], "gender": "m", "first": 7, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. COUNTRY HOUSE DINING ROOM - 1840S - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "A long mahogany table laid for three.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Silver, crystal, candles.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A fire crackles.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A portrait of a stern ancestor presides over the sideboard.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "AGNES, forties, in dove-gray silk, sits at the head.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "MR. FOTHERGILL, fifties, a visiting solicitor, to her right, with a napkin tucked in his collar.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "EDMUND, twenty, her son, sits opposite him, turning a wine glass by its stem.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "She lifts the soup tureen herself.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Ladles three portions.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Her hand is quite steady.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "This is excellent.", "name": "FOTHERGILL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Cook will be pleased.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "He samples it.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "She watches him.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Edmund watches the glass.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Mrs. Whitcombe, I regret I have news.", "name": "FOTHERGILL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Mr. Fothergill, you always have news. Eat first.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "He eats.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "A pause.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "The fire pops.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Mother, I think perhaps we should hear it.", "name": "EDMUND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "After soup.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "But if it concerns--", "name": "EDMUND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "After soup, Edmund.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "He subsides.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Sets down his glass.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "The candle flames shiver as a servant's footsteps pass in the hall and fade.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "The estate. The creditors have called in the note.", "name": "FOTHERGILL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Agnes sets down her spoon.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Aligns it with the edge of her bowl.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "How much?", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Four thousand pounds.", "name": "FOTHERGILL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "We don't have four thousand.", "name": "EDMUND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "I know.", "name": "FOTHERGILL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Then we'll sell the east pasture.", "name": "EDMUND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "The east pasture was your father's.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Father is dead.", "name": "EDMUND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "She looks at him.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "He drops his eyes.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Fothergill coughs into his napkin.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "There is another way.", "name": "FOTHERGILL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "There always is.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "A marriage. A gentleman in Bath, a widower of good family, has inquired--", "name": "FOTHERGILL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Pass the bread.", "name": "AGNES", "speaker": 0, "ext": [], "paren": ["to Edmund"], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Mother.", "name": "EDMUND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "The bread, Edmund.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "He passes it.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "She tears off a piece, takes her time buttering it.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Fothergill waits, napkin twisted in his fist.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "It would settle the debt.", "name": "FOTHERGILL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "And whom does the gentleman wish to marry?", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Fothergill looks, slowly, at Edmund.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Edmund stares back, color draining from his face.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Agnes, not looking at either of them, takes a bite of bread.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "I see. More soup, Mr. Fothergill?", "name": "AGNES", "speaker": 0, "ext": ["CONT'D"], "paren": ["mildly"], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "He holds out his bowl.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "She fills it.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "He takes it with a trembling hand and does not meet her eyes.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Edmund rises.", "para": 10, "sent": 3, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "Excuse me.", "name": "EDMUND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Sit down.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "He doesn't.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "He walks to the fire and stands with his back to the table, his shoulders very straight.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "The offer remains open until Friday.", "name": "FOTHERGILL", "speaker": 1, "ext": [], "paren": ["clearing his throat"], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "Then we shall eat our dinner, and sleep, and tomorrow I shall write to Bath.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "Madam?", "name": "FOTHERGILL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "dialogue", "text": "Whatever I write, Mr. Fothergill, is my own business.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "She resumes her soup.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "At the fire, Edmund lifts a hand and wipes his eyes, quickly, with the back of his wrist.", "para": 12, "sent": 1, "present": [0, 1, 2]}]}