{"scene_id": "s02265", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02265.fountain", "heading": "INT. HOCKEY RINK - PLAYERS' BENCH - NIGHT", "cast": [{"id": 0, "name": "TARIQ", "names": ["TARIQ"], "gender": "m", "first": 4, "spoke": 2}, {"id": 1, "name": "DEV", "names": ["DEV"], "gender": "m", "first": 5, "spoke": 2}, {"id": 2, "name": "COACH EDDIE", "names": ["COACH EDDIE", "EDDIE"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "HAL", "names": ["HAL"], "gender": "?", "first": 7, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOCKEY RINK - PLAYERS' BENCH - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cold breath.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Steel blades on ice.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The crowd's roar leaks from the stands.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "TARIQ, twenty-two, a winger, grips his stick, eyes on the ice.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "DEV, twenty-four, a center, shifts beside him, tapping his skate.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "COACH EDDIE, sixty, leans over the boards.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "HAL, fifties, the referee, skates up to the bench.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Tariq, you're up.", "name": "EDDIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Coach, he's been on all night.", "name": "TARIQ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Then he's tired. Go.", "name": "EDDIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Dev elbows Tariq.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Cut left. He always goes right.", "name": "DEV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "You sure?", "name": "TARIQ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "He told me once.", "name": "DEV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Two minutes, gentlemen.", "name": "HAL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Tariq vaults the boards.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Dev follows.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Eddie claps once, hard, and the puck drops.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}]}