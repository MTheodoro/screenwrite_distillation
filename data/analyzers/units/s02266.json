{"scene_id": "s02266", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02266.fountain", "heading": "INT. COURTHOUSE STAIRWELL - DAY", "cast": [{"id": 0, "name": "CONSTANCE ADEYEMI", "names": ["CONSTANCE ADEYEMI", "CONSTANCE"], "gender": "f", "first": 3, "spoke": 11}, {"id": 1, "name": "RONAN BLAKE", "names": ["RONAN BLAKE", "RONAN"], "gender": "f", "first": 4, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. COURTHOUSE STAIRWELL - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Concrete steps, a steel railing, a window of wired glass.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Muffled footsteps echo from other floors.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "CONSTANCE ADEYEMI, forties, a defense lawyer in a navy suit, hair pulled back so tight it pulls her eyes, leans against the railing with a coffee she hasn't touched.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "RONAN BLAKE, thirties, her client, in a borrowed tie two inches too short, holds a rolled-up folder like a club.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "You said it would be quick.", "name": "RONAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "It is quick.", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "It's been four hours.", "name": "RONAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Four hours is quick for murder.", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Manslaughter.", "name": "RONAN", "speaker": 1, "ext": [], "paren": ["small laugh"], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Don't say the word out loud.", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He nods.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Goes quiet.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Down the stairwell a door bangs; both of them turn their heads, wait, then relax.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "The jury is back at three.", "name": "CONSTANCE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "How do I look?", "name": "RONAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She studies him: the tie, the folder, the way his shoulders curl inward.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She reaches out and unrolls the folder, flattens it, hands it back.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Carry it like a book. Not like a weapon.", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He does.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Straightens his tie.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "It doesn't help.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Will they believe me?", "name": "RONAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "They'll believe what you show them.", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "I'm not good at showing.", "name": "RONAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I know.", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "She sets her cup on the rail.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Takes out a handkerchief and pushes it into his hand.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "When they read the verdict, look at the jury. Not at me. Not at the floor.", "name": "CONSTANCE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Why?", "name": "RONAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Because they remember who looked.", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "He folds the handkerchief into a neat square and slips it into his breast pocket, where it sits crooked and white.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "You've done this before.", "name": "RONAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Yes.", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "How many times?", "name": "RONAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Enough.", "name": "CONSTANCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "She picks up the cup again, and this time she drinks.", "para": 7, "sent": 0, "present": [0, 1]}]}