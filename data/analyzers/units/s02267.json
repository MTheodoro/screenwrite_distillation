{"scene_id": "s02267", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02267.fountain", "heading": "EXT. FOXHOLE ABOVE A SUNKEN ROAD - DAWN", "cast": [{"id": 0, "name": "LIEUTENANT PIOTR WOZNIAK", "names": ["LIEUTENANT PIOTR WOZNIAK", "WOZNIAK"], "gender": "m", "first": 4, "spoke": 9}, {"id": 1, "name": "CAPTAIN HAVERFORD", "names": ["CAPTAIN HAVERFORD"], "gender": "?", "first": 11, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FOXHOLE ABOVE A SUNKEN ROAD - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Frost on the parapet.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The cold earth smells of wet iron.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A field telephone sits on an ammunition crate, wires snaking away into the dark.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LIEUTENANT PIOTR WOZNIAK, thirties, hollow-cheeked, sits against the dirt wall with his knees drawn up and a tin of cold stew in his lap.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He hasn't eaten any.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "His helmet is pushed back and his eyes are on the gray horizon.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "The field telephone rings.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Once, sharp, then silence, then again.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "He picks up the receiver slowly, as though it might burn him.", "para": 3, "sent": 0, "present": [0]}, {"u": 10, "kind": "dialogue", "text": "Wozniak.", "name": "WOZNIAK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 11, "kind": "dialogue", "text": "Piotr. It's Haverford. I've got your orders.", "name": "CAPTAIN HAVERFORD", "speaker": 1, "ext": ["V.O."], "paren": ["over the phone, crackling"], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Go ahead, sir.", "name": "WOZNIAK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Hold the road until noon. Then fall back to the ridge.", "name": "CAPTAIN HAVERFORD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "We have twelve men, sir.", "name": "WOZNIAK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I know what you have.", "name": "CAPTAIN HAVERFORD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Wozniak is silent.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "A distant mortar thuds.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Soil trickles from the parapet.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Twelve men, and ammunition for an hour.", "name": "WOZNIAK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Piotr. I'm sorry.", "name": "CAPTAIN HAVERFORD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Sir, I'm not complaining.", "name": "WOZNIAK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "No. You never do.", "name": "CAPTAIN HAVERFORD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "He looks at the stew.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Sets it aside.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Is there word from the north?", "name": "WOZNIAK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Nothing. The line's been dead since midnight. You're my only link on this side.", "name": "CAPTAIN HAVERFORD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Then I'll hold, sir.", "name": "WOZNIAK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "A pause.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "The line hisses.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Do you have a family, Lieutenant?", "name": "CAPTAIN HAVERFORD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "A sister. In Gdansk.", "name": "WOZNIAK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Write to her. Today.", "name": "CAPTAIN HAVERFORD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Yes, sir.", "name": "WOZNIAK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Good man.", "name": "CAPTAIN HAVERFORD", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "The line goes dead.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Wozniak holds the receiver a long moment, then sets it gently back on its cradle.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "He stands, brushes the frost from his sleeves, and looks across the sunken road at the first thin light.", "para": 8, "sent": 0, "present": [0, 1]}]}