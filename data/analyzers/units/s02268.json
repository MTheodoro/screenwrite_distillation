{"scene_id": "s02268", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02268.fountain", "heading": "INT. FAMILY LIVING ROOM - CHRISTMAS EVE", "cast": [{"id": 0, "name": "PAPA LUKAS", "names": ["PAPA LUKAS"], "gender": "?", "first": 4, "spoke": 3}, {"id": 1, "name": "UNCLE SANDOR", "names": ["UNCLE SANDOR"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "COUSIN BEA", "names": ["COUSIN BEA", "BEA"], "gender": "?", "first": 6, "spoke": 1}, {"id": 3, "name": "COUSIN TEDDY", "names": ["COUSIN TEDDY", "TEDDY"], "gender": "?", "first": 6, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. FAMILY LIVING ROOM - CHRISTMAS EVE", "present": []}, {"u": 1, "kind": "action", "text": "A small tree, tilted.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wrapping paper in drifts.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A space heater ticks.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "PAPA LUKAS, sixties, in a Santa hat, stands with a plate of cookies.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "UNCLE SANDOR, fifties, wedged in an armchair, nurses a beer.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "COUSIN BEA, twelve, cross-legged on the floor, sorts presents.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "COUSIN TEDDY, nine, hides behind the couch with a water gun.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Everybody, cookies.", "name": "PAPA LUKAS", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "He's making them again, Lukas. Stop him.", "name": "UNCLE SANDOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Who is \"he\"?", "name": "PAPA LUKAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Teddy! Behind the couch!", "name": "UNCLE SANDOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "I'm not!", "name": "TEDDY", "speaker": 3, "ext": [], "paren": ["popping up"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "He fires.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "A jet of water hits Sandor in the face.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Sandor roars, lunges, tangles in the lamp cord, topples the lamp.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Bea and Lukas dive for it together; both catch it at the same moment and freeze.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Papa, we're the best team.", "name": "BEA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "We're a disaster.", "name": "PAPA LUKAS", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "He sets the lamp upright.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Sandor, dripping, glares at Teddy.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "You're in trouble, nephew.", "name": "UNCLE SANDOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "It's Christmas!", "name": "TEDDY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Then Santa's bringing you coal.", "name": "UNCLE SANDOR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Teddy bursts into laughter.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Bea joins.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Papa Lukas holds out the plate, and Sandor, dripping, takes a cookie.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}]}