{"scene_id": "s02269", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02269.fountain", "heading": "EXT. RUINED CATHEDRAL SQUARE - DUSK", "cast": [{"id": 0, "name": "LIEUTENANT CORDELIA BRANDT", "names": ["LIEUTENANT CORDELIA BRANDT", "BRANDT"], "gender": "f", "first": 4, "spoke": 10}, {"id": 1, "name": "SERGEANT OSEI", "names": ["SERGEANT OSEI", "OSEI"], "gender": "m", "first": 5, "spoke": 11}, {"id": 2, "name": "PRIVATE MIKHAIL", "names": ["PRIVATE MIKHAIL", "MIKHAIL"], "gender": "m", "first": 5, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. RUINED CATHEDRAL SQUARE - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "The nave's roof is gone.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The columns stand like charred teeth against a violet sky.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rubble lies in drifts, and in the middle of it, fallen from its niche, an enormous stone angel lies on her back with her wings broken, her face turned to the clouds.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LIEUTENANT CORDELIA BRANDT, thirties, hatless, her fair hair gone dark with dust, sits on the angel's chest with a map across her knees and a cigarette burned down to the filter.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "SERGEANT OSEI, forties, tall, broad, a rifle slung across his back, crouches to refill a canteen from a cracked fountain, and PRIVATE MIKHAIL, nineteen, thin as a rake, leans against a pillar with his eyes closed and his arms wrapped around a bundle of blankets and every so often his lips move, as though in prayer or in sleep.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "For a long time, none of them speaks.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "The wind lifts ash off the stones.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Lieutenant, it's almost dark.", "name": "OSEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "I know.", "name": "BRANDT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Do we stay?", "name": "OSEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "For tonight.", "name": "BRANDT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "She folds the map.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Puts it in her jacket.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Her fingers linger on the edge of the angel's stone wing, and then she takes them away.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "It's a good place.", "name": "OSEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "It's a church.", "name": "BRANDT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "It's a roof with no roof.", "name": "OSEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "She huffs a breath that might be a laugh.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Mikhail opens his eyes.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Sorry. I wasn't sleeping.", "name": "MIKHAIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "You were sleeping standing up.", "name": "OSEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "I was resting my eyes.", "name": "MIKHAIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Resting. Mm.", "name": "OSEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Mikhail slides down the pillar to sit.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "He unwraps the blankets, handing one to Osei without being asked.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Osei nods thanks and shakes it out.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "They spread it on the stones beside the angel's head.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Where's the radio?", "name": "BRANDT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Dead. I tried again an hour ago.", "name": "MIKHAIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Batteries?", "name": "BRANDT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Gone.", "name": "MIKHAIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Then we're on our own.", "name": "BRANDT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "We have been.", "name": "OSEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "She looks at him.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "He keeps his eyes on the canteen.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Sergeant, if I told you we'd be home by Christmas, would you believe me?", "name": "BRANDT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "No, Lieutenant.", "name": "OSEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Good.", "name": "BRANDT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "She smiles, small and tired.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Mikhail, half-asleep, mumbles something and curls against the blanket.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "What did he say?", "name": "OSEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "His mother's name, I think.", "name": "BRANDT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Osei lays his own blanket over the boy's shoulders.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "He sits, back against the angel's stone hip, the canteen between his knees.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Brandt slides down to sit beside him.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "For a time they watch the sky darken, the first star appearing between two broken columns.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "My grandmother said every church has an angel left standing.", "name": "OSEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Yours fell.", "name": "BRANDT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Then she's resting.", "name": "OSEI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Brandt rests her head against the cold stone of the wing.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Her cigarette, long out, drops from her fingers.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Nobody picks it up.", "para": 10, "sent": 2, "present": [0, 1, 2]}]}