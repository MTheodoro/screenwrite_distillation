{"scene_id": "s02272", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02272.fountain", "heading": "INT. RING STATION GREENHOUSE - NIGHT CYCLE", "cast": [{"id": 0, "name": "COMMANDER IRENKA VOSS", "names": ["COMMANDER IRENKA VOSS", "VOSS"], "gender": "?", "first": 4, "spoke": 2}, {"id": 1, "name": "ENGINEER DESMOND ACHEAMPONG", "names": ["ENGINEER DESMOND ACHEAMPONG", "DESMOND"], "gender": "m", "first": 5, "spoke": 2}, {"id": 2, "name": "BOTANIST LIN MEIHUA", "names": ["BOTANIST LIN MEIHUA", "LIN"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "PILOT RAFAEL ORTEGA", "names": ["PILOT RAFAEL ORTEGA"], "gender": "?", "first": 7, "spoke": 0}, {"id": 4, "name": "RAFI", "names": ["RAFI"], "gender": "?", "first": 7, "spoke": 1}, {"id": 5, "name": "NOOR AL-FARSI", "names": ["NOOR AL-FARSI", "NOOR"], "gender": "f", "first": 8, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. RING STATION GREENHOUSE - NIGHT CYCLE", "present": []}, {"u": 1, "kind": "action", "text": "Rows of tomato vines under purple grow-lights.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A curved window shows the dark and a slow turning arc of stars.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A red warning strip pulses along the ceiling.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "COMMANDER IRENKA VOSS, fifties, grey crop, stands at the control panel.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "ENGINEER DESMOND ACHEAMPONG, thirties, grease on his sleeves, crouches by a coolant pipe.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "BOTANIST LIN MEIHUA, twenties, cradles a seedling tray.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "PILOT RAFAEL ORTEGA, called RAFI, leans in the doorway.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "Tech NOOR AL-FARSI, nineteen, sits cross-legged on a bench with a tablet.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "Status.", "name": "VOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Coolant line's cracked. It's venting into the soil bed.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "That's our whole crop.", "name": "LIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "The pipe bursts.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "A white jet of freezing mist fills the aisle.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "Desmond and Lin dive in opposite directions and slam into the shelving.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "Voss and Rafi drop to the floor.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "action", "text": "Noor yanks her knees up to her chest.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Cut the pump!", "name": "RAFI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "I can't, the panel's locked!", "name": "NOOR", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Rafi and Desmond rush the pipe together, shoulders down, and clamp it between them with a jacket.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "The mist thins to a hiss.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Voss and Lin crawl to the valve and haul it shut with both hands.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "The red strip stops pulsing.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Is anyone hurt?", "name": "VOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Just frozen.", "name": "LIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Desmond holds up a soaked tomato.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "He bites it.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Everyone stares at him.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Still good.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Noor laughs first.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Then all of them.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}