{"scene_id": "s02274", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02274.fountain", "heading": "INT. STAGE STATION KITCHEN, DRY CREEK - LATE MORNING", "cast": [{"id": 0, "name": "ODELL PRUITT", "names": ["ODELL PRUITT", "ODELL"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "MAUDE TEAGUE", "names": ["MAUDE TEAGUE", "MAUDE"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "ZEBEDIAH HOLLOWAY", "names": ["ZEBEDIAH HOLLOWAY"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "ZEB", "names": ["ZEB"], "gender": "?", "first": 6, "spoke": 4}, {"id": 4, "name": "BARNABY", "names": ["BARNABY"], "gender": "?", "first": 14, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. STAGE STATION KITCHEN, DRY CREEK - LATE MORNING", "present": []}, {"u": 1, "kind": "action", "text": "A one-room adobe with a cuckoo clock that has run seven minutes slow since the Grant administration.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Flies drift in the heat.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cast-iron stove ticks as it cools.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ODELL PRUITT, fifties, stationmaster, wipes a tin cup with a rag that is dirtier than the cup.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "At the table MAUDE TEAGUE, thirties, a seed-and-feed saleswoman in a dust-grey travelling dress, peels a boiled egg.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "ZEBEDIAH HOLLOWAY, called ZEB, eighty, hat on indoors, whittles a stick down to nothing.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Coach is late.", "name": "ODELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Coach is always late.", "name": "MAUDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Wheel, probably.", "name": "ZEB", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Or the Piute crossing.", "name": "MAUDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "It's never the Piute crossing.", "name": "ODELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Might be the Piute crossing.", "name": "ZEB", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "A horn sounds, faint and flat, out on the road.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Hey the station! Hey, Odell!", "name": "BARNABY", "speaker": 4, "ext": ["O.S."], "paren": ["far off"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "There. Wheel.", "name": "ODELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Axle! Lost the axle at Mesquite Wash!", "name": "BARNABY", "speaker": 4, "ext": ["O.S."], "paren": ["nearer"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "I told you it was a wheel.", "name": "MAUDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Axle's near enough.", "name": "ZEB", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Odell sets down the cup and takes the egg shell Maude offers without thinking.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "She sets the egg on the table.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Zeb finishes whittling and examines the empty air where the stick was.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Another night, then.", "name": "ODELL", "speaker": 0, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Is there stew?", "name": "MAUDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Is there stew?", "name": "BARNABY", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "There's stew.", "name": "ODELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "There's always stew.", "name": "ZEB", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "The cuckoo clock coughs, produces one grey wooden bird, and retires without a sound.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}]}