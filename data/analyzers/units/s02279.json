{"scene_id": "s02279", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02279.fountain", "heading": "INT. FUNICULAR CAR, MIDWAY UP - NIGHT", "cast": [{"id": 0, "name": "BRIEFCASE MAN", "names": ["BRIEFCASE MAN"], "gender": "?", "first": 5, "spoke": 5}, {"id": 1, "name": "WOMAN IN RED", "names": ["WOMAN RED", "WOMAN IN RED"], "gender": "?", "first": 6, "spoke": 2}, {"id": 2, "name": "TEENAGER", "names": ["TEENAGER"], "gender": "?", "first": 7, "spoke": 1}, {"id": 3, "name": "PRIEST", "names": ["PRIEST"], "gender": "m", "first": 8, "spoke": 1}, {"id": 4, "name": "MECHANIC", "names": ["MECHANIC"], "gender": "f", "first": 9, "spoke": 2}, {"id": 5, "name": "CONDUCTOR", "names": ["CONDUCTOR"], "gender": "?", "first": 10, "spoke": 3}, {"id": 6, "name": "PREWITT", "names": ["PREWITT"], "gender": "?", "first": 36, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. FUNICULAR CAR, MIDWAY UP - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A glass cabin on a steel cable, hanging over a sleeping city.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Lights below like spilled salt.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The cable hums.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Six people.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "A BRIEFCASE MAN, fifties, tie loosened.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "A WOMAN IN RED, thirties, perched on the bench.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "A TEENAGER, hood up, earbuds in.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "A PRIEST, seventies.", "para": 1, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "A MECHANIC, big hands.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "A CONDUCTOR, grey cap, bored.", "para": 1, "sent": 6, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "The car shudders.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "Stops.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "Lights flicker.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Folks, a brief delay. Remain seated.", "name": "CONDUCTOR", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "How brief?", "name": "BRIEFCASE MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "A few minutes.", "name": "CONDUCTOR", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Then why is he sweating?", "name": "WOMAN IN RED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "All eyes turn to the briefcase man.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "He grips the case to his chest.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "I'm not.", "name": "BRIEFCASE MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "He is.", "name": "TEENAGER", "speaker": 2, "ext": [], "paren": ["pulling out an earbud"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "My son, are you unwell?", "name": "PRIEST", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "I'm fine!", "name": "BRIEFCASE MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "That case is ticking.", "name": "MECHANIC", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "The ticking is audible now, quick and mean.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "It's a watch. A prototype.", "name": "BRIEFCASE MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Open it.", "name": "WOMAN IN RED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Sir, I'll have to ask you to open it.", "name": "CONDUCTOR", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "He does not.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "The Woman in Red lunges.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "The Mechanic grabs her arm.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "The Teenager is shouting.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "The Priest has his hand on the briefcase man's shoulder, murmuring.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Hold him!", "name": "MECHANIC", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "My name is Aldous Prewitt, I'm a courier, I was told it was documents!", "name": "BRIEFCASE MAN", "speaker": 0, "ext": [], "paren": ["breaking"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "I swear it, I swear it on my mother!", "name": "PREWITT", "speaker": 6, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "The case clicks.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "The lid lifts.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "Inside, an old brass alarm clock rings, sits on a stack of unmarked bills, and a note reads: GOT YOU ALL TO TALK.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "The funicular lurches.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "Lights return.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "The car climbs on.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}]}