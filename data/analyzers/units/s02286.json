{"scene_id": "s02286", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02286.fountain", "heading": "INT. LAUNDROMAT, 24-HOUR - 3 A.M.", "cast": [{"id": 0, "name": "TALL MAN", "names": ["TALL MAN"], "gender": "m", "first": 5, "spoke": 7}, {"id": 1, "name": "VERONICA CASTELLANOS", "names": ["VERONICA CASTELLANOS", "VERONICA"], "gender": "f", "first": 7, "spoke": 3}, {"id": 2, "name": "NIKOLAI BRODSKY", "names": ["NIKOLAI BRODSKY", "NIKOLAI"], "gender": "?", "first": 8, "spoke": 5}, {"id": 3, "name": "DOLORES", "names": ["DOLORES"], "gender": "f", "first": 9, "spoke": 3}, {"id": 4, "name": "MARCUS", "names": ["MARCUS"], "gender": "m", "first": 34, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAUNDROMAT, 24-HOUR - 3 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent hum.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of dryers tumbling.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A vending machine glows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The windows are black.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A TALL MAN in a work jacket sits on a folding table, a duffel bag at his feet.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "He stares at the dryers.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Across the room, VERONICA CASTELLANOS, thirty, scrubs, sits with a laundry basket in her lap, scrolling her phone.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "At the folding table's far end, a younger man, NIKOLAI BRODSKY, hoodie up, folds towels very slowly.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "And behind the counter, DOLORES, sixty, the attendant, reads a paperback.", "para": 1, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Excuse me. Is this machine broken?", "name": "TALL MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "It says out of order.", "name": "VERONICA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "It took my quarters.", "name": "TALL MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "There's a number on the sign.", "name": "DOLORES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Is the number answered?", "name": "TALL MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Not at three.", "name": "DOLORES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "The man stands.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "He is very large.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "He crosses to the dryer and lays a palm against its door.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Nikolai's eyes rise from the towels.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "I'd leave it alone.", "name": "NIKOLAI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Who asked you?", "name": "TALL MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Nobody. Just saying.", "name": "NIKOLAI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "What's in the dryer, kid?", "name": "TALL MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Nothing.", "name": "NIKOLAI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Then why are you worried?", "name": "TALL MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Veronica sets down her phone.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Dolores sets down her book.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Sir, you should sit down.", "name": "VERONICA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Sit down yourself.", "name": "TALL MAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "He yanks the door.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "A canvas satchel tumbles out, hits the floor, and spills bundled cash.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Nikolai lunges.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "The tall man shoves him back into the folding table, and towels burst across the floor.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Police. Everybody stay where you are.", "name": "MARCUS", "speaker": 4, "ext": [], "paren": ["holding up a badge"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Veronica and Nikolai freeze.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Dolores slowly raises her hands.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Marcus kneels over the satchel, his badge dangling from his chain.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Who owns this?", "name": "MARCUS", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "He does.", "name": "DOLORES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "She's lying.", "name": "NIKOLAI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "He hid it this afternoon. I saw him.", "name": "VERONICA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "She was in on it!", "name": "NIKOLAI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Marcus stands.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "He looks at the three of them, a long beat.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "He takes out his cuffs.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}]}