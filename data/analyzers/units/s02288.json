{"scene_id": "s02288", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02288.fountain", "heading": "INT. ABANDONED SCHOOLROOM, YORKSHIRE - DUSK (1851)", "cast": [{"id": 0, "name": "MISS EDITH WHITLOCK", "names": ["MISS EDITH WHITLOCK", "EDITH"], "gender": "f", "first": 5, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED SCHOOLROOM, YORKSHIRE - DUSK (1851)", "present": []}, {"u": 1, "kind": "action", "text": "A single desk.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A cracked slate.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Snow drifts through a broken window and settles on a pile of primers.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The door creaks.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "MISS EDITH WHITLOCK, thirty, in a wool coat and bonnet, a trunk dragging behind her, steps in and stops.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "She sets down the trunk.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "She crosses to the desk.", "para": 2, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "She wipes frost from it with her glove and takes a folded letter from her sleeve.", "para": 2, "sent": 2, "present": [0]}, {"u": 9, "kind": "dialogue", "text": "\"Dear Miss Whitlock. We regret the schoolhouse at Thornby Moor has been closed these four years.\"", "name": "EDITH", "speaker": 0, "ext": ["V.O."], "paren": ["reading, her own voice"], "dual": false, "present": [0]}, {"u": 10, "kind": "action", "text": "She turns to the slate.", "para": 3, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "A single word is chalked there in a child's hand: STAY.", "para": 3, "sent": 1, "present": [0]}, {"u": 12, "kind": "dialogue", "text": "\"The parish cannot afford a mistress. We trust you will find other employment.\"", "name": "EDITH", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 13, "kind": "action", "text": "She sets the letter down.", "para": 4, "sent": 0, "present": [0]}, {"u": 14, "kind": "action", "text": "She takes off her bonnet.", "para": 4, "sent": 1, "present": [0]}, {"u": 15, "kind": "action", "text": "She picks up a stub of chalk, and under STAY she writes, very slowly, MONDAY.", "para": 4, "sent": 2, "present": [0]}]}