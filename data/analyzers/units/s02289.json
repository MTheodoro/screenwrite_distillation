{"scene_id": "s02289", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02289.fountain", "heading": "INT. PALLIATIVE WARD, ROOM 7 - NIGHT", "cast": [{"id": 0, "name": "OLD SOLOMON KAPLAN", "names": ["OLD SOLOMON KAPLAN", "SOLOMON"], "gender": "m", "first": 4, "spoke": 17}, {"id": 1, "name": "NURSE", "names": ["NURSE"], "gender": "?", "first": 5, "spoke": 9}, {"id": 2, "name": "DANIELLE", "names": ["DANIELLE"], "gender": "?", "first": 30, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. PALLIATIVE WARD, ROOM 7 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dim lamp.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Machine hum.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A window fogged with breath.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "OLD SOLOMON KAPLAN, eighty-three, in the bed, blanket to his chin.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "A NURSE, forties, in lilac scrubs, checks a drip.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "dialogue", "text": "Can't sleep?", "name": "NURSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "I sleep fine.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Then why are your eyes open?", "name": "NURSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Habit.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She adjusts the pillow.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He watches.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "You new?", "name": "SOLOMON", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Six months.", "name": "NURSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "You'll learn.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Learn what?", "name": "NURSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Not to look at the clock.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She smiles.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She smooths the blanket.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She stays.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "My wife used to hum.", "name": "SOLOMON", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "What did she hum?", "name": "NURSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Whatever was on.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Radio?", "name": "NURSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Kettle.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "A pause.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Would you like tea?", "name": "NURSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "There's no tea at three.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "There's tea if I say there is.", "name": "NURSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "What's your name?", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Danielle.", "name": "NURSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Danielle. That's a good name for a nurse.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Mr. Kaplan, drink some water.", "name": "DANIELLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Solomon.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Solomon.", "name": "DANIELLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "He drinks.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "She holds the cup.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "His hand shakes on hers.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "My son isn't coming, is he?", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "The roads are bad.", "name": "DANIELLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "That's a kind lie.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "It's the one I have.", "name": "DANIELLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Keep it.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "She sits on the edge of the bed.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "She doesn't say anything.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "He closes his eyes.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "The machine hums on.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Hum something.", "name": "SOLOMON", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "I can't carry a tune.", "name": "DANIELLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Neither could she.", "name": "SOLOMON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Danielle hums.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "It is not a tune.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "It is a kettle.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "His hand slackens on hers, and she keeps humming.", "para": 7, "sent": 3, "present": [0, 1, 2]}]}