{"scene_id": "s02294", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02294.fountain", "heading": "INT. TRUCK STOP DINER, ARM-WRESTLING TABLE - NIGHT", "cast": [{"id": 0, "name": "BIG WENDELL TUCKER", "names": ["BIG WENDELL TUCKER", "WENDELL"], "gender": "m", "first": 5, "spoke": 1}, {"id": 1, "name": "ADA PRZYBYLSKI", "names": ["ADA PRZYBYLSKI", "ADA"], "gender": "f", "first": 6, "spoke": 2}, {"id": 2, "name": "REFEREE", "names": ["REFEREE"], "gender": "?", "first": 7, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. TRUCK STOP DINER, ARM-WRESTLING TABLE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Steel table.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Two stools.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A crowd of truckers three-deep.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Neon beer signs buzz.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "BIG WENDELL TUCKER, forty, three hundred pounds, hands like shovels, grips the pegs.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across from him sits ADA PRZYBYLSKI, twenty-three, a barista in a hairnet, five-foot-two, sleeves rolled.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Ready.", "name": "REFEREE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Wendell grins.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Ada doesn't.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Their hands lock.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Go.", "name": "REFEREE", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Wendell surges.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Ada's arm folds back to forty-five degrees and the crowd roars.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Her face goes red, her knuckles white, and she exhales through clenched teeth.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Wendell relaxes into the win.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Not yet.", "name": "ADA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "She drives.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "The forearm rises, inch by inch, a hinge opening against a rusty spring, and Wendell's grin falters.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "The crowd quiets.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "His wrist cracks.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "She slams it back to vertical, then past, pressing it toward the steel, and he shouts, but she holds.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "He wrenches free, regrips, and with a bellow of rage reverses the angle, the table rocking.", "para": 4, "sent": 5, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Ada's stool skids, her hairnet slips, a strand of hair falls into her mouth, and she bites it.", "para": 4, "sent": 6, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "You can't!", "name": "WENDELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "I can.", "name": "ADA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The back of his hand touches steel.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "The room erupts.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Wendell stares at his fist as though it belonged to a stranger.", "para": 5, "sent": 2, "present": [0, 1, 2]}]}