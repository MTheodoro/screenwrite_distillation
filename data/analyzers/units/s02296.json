{"scene_id": "s02296", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02296.fountain", "heading": "INT. LIGHTHOUSE KEEPER'S ROOM - NIGHT", "cast": [{"id": 0, "name": "INSPECTOR MALCOLM REYNOLDS", "names": ["INSPECTOR MALCOLM REYNOLDS", "REYNOLDS"], "gender": "?", "first": 5, "spoke": 1}, {"id": 1, "name": "DICTAPHONE", "names": ["DICTAPHONE"], "gender": "?", "first": 7, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. LIGHTHOUSE KEEPER'S ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A round stone room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "An iron stove glows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A kettle ticks.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Outside, a gale tears at the shutters.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "INSPECTOR MALCOLM REYNOLDS, fifties, in an oilskin coat, sits at a rough table.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "He winds the spool of a portable dictaphone and presses PLAY.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "dialogue", "text": "Entry one. The keeper is dead.", "name": "DICTAPHONE", "speaker": 1, "ext": ["V.O."], "paren": ["his own voice, calm"], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He pours tea.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He is not troubled.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Entry two. The boat was sabotaged, the radio smashed, and the logbook burned.", "name": "DICTAPHONE", "speaker": 1, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He sips.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He turns a page of the logbook, very much unburned.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Entry three. No one else is on the island.", "name": "DICTAPHONE", "speaker": 1, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "The shutters bang.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "He stops the machine.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He looks up at the winding iron stairs, listening.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "A single drop falls from the ceiling and hits the table.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Slowly, he rewinds the spool.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Entry four.", "name": "REYNOLDS", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1]}]}