{"scene_id": "s02297", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02297.fountain", "heading": "EXT. SALT FLATS, ABANDONED SURVEY CAMP - DAWN", "cast": [{"id": 0, "name": "TOBIAS GRAYSON", "names": ["TOBIAS GRAYSON", "TOBIAS"], "gender": "m", "first": 5, "spoke": 2}, {"id": 1, "name": "LENORE BASQUIAT", "names": ["LENORE BASQUIAT", "LENORE"], "gender": "?", "first": 6, "spoke": 4}, {"id": 2, "name": "SLATER BROTHERS", "names": ["SLATER BROTHERS"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "JUDE", "names": ["JUDE"], "gender": "m", "first": 7, "spoke": 2}, {"id": 4, "name": "ABEL", "names": ["ABEL"], "gender": "?", "first": 7, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SALT FLATS, ABANDONED SURVEY CAMP - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "White to every horizon.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A crooked tent.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A dead mule on its side.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Heat already shimmers.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "TOBIAS GRAYSON, forties, leathered, sits against the tent pole, a bullet in his gut, his hat over his eyes.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "LENORE BASQUIAT, thirty, in a duster, kneels with a canteen.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Two outlaws, the SLATER BROTHERS, JUDE and ABEL, stand over them, rifles lowered.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "He's done.", "name": "JUDE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "He's breathing.", "name": "LENORE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Not for long.", "name": "ABEL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Leave her out of it.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": ["thin"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "She dug your claim.", "name": "JUDE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "It was never his claim.", "name": "LENORE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Then whose?", "name": "ABEL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Mine.", "name": "LENORE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Silence.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Jude lifts his rifle again, slowly.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Abel holds out a hand.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Let her talk.", "name": "ABEL", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Lenore. Don't.", "name": "TOBIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "It's under the mule.", "name": "LENORE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "The brothers look at the dead animal.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Tobias's hand slips from his gut.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "The canteen falls and the water drains into the salt.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}]}