{"scene_id": "s02298", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02298.fountain", "heading": "INT. ER TRAUMA BAY 2 - NIGHT", "cast": [{"id": 0, "name": "TRAUMA SURGEON", "names": ["TRAUMA SURGEON"], "gender": "?", "first": 4, "spoke": 1}, {"id": 1, "name": "NURSE ABIOLA ADEYEMI", "names": ["NURSE ABIOLA ADEYEMI", "ABIOLA"], "gender": "?", "first": 5, "spoke": 3}, {"id": 2, "name": "RESIDENT DAVIT HOVSEPIAN", "names": ["RESIDENT DAVIT HOVSEPIAN", "DAVIT"], "gender": "?", "first": 6, "spoke": 3}, {"id": 3, "name": "SUNITA RAO", "names": ["SUNITA RAO", "DR. RAO"], "gender": "?", "first": 7, "spoke": 2}, {"id": 4, "name": "SECURITY GUARD LEROY", "names": ["SECURITY GUARD LEROY", "LEROY"], "gender": "?", "first": 8, "spoke": 1}, {"id": 5, "name": "ELLINGTON", "names": ["ELLINGTON", "MRS. ELLINGTON"], "gender": "m", "first": 9, "spoke": 1}, {"id": 6, "name": "MENDEZ", "names": ["MENDEZ"], "gender": "?", "first": 15, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. ER TRAUMA BAY 2 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent glare.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Monitors scream.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Blood on the floor tile.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A TRAUMA SURGEON, forties, gloved to the elbow, bends over a gurney.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "NURSE ABIOLA ADEYEMI, thirties, squeezes a bag-valve mask.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "RESIDENT DAVIT HOVSEPIAN, twenty-six, pumps the patient's chest.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Anaesthetist DR. SUNITA RAO, fifties, calls out numbers.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "SECURITY GUARD LEROY, thirty, stands at the door.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "A bystander's mother, MRS. ELLINGTON, sobs behind him.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "Pressure's sixty over thirty!", "name": "DR. RAO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Compressions continuing!", "name": "DAVIT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Airway clear!", "name": "ABIOLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Clamp. I need a clamp.", "name": "TRAUMA SURGEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Which clamp?", "name": "DAVIT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "The big one, Doctor Mendez!", "name": "ABIOLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "Thank you, Abiola.", "name": "MENDEZ", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "action", "text": "Mendez takes the clamp.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "action", "text": "His hands move fast.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "action", "text": "Davit sweats through his scrubs, Abiola bags, Rao reads the monitor.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "action", "text": "Leroy blocks the door.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "action", "text": "Mrs. Ellington cries out and he lowers his head.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Sixty-five over forty!", "name": "DR. RAO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "Stay with me.", "name": "MENDEZ", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "Ma'am, you can't come in.", "name": "LEROY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "He's my boy!", "name": "MRS. ELLINGTON", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "Pulse!", "name": "DAVIT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "I've got a pulse!", "name": "ABIOLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "The monitor settles into a steady beep.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "Mendez straightens.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "Everyone breathes.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}]}