13, "kind": "action", "text": "His hand is steady.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Hers is not.", "para": 2, "sent": 4, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She puts it in her pocket.", "para": 2, "sent": 5, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "If they ask about the knife.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "I never saw a knife.", "name": "DARRELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Good.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Above them a door opens and closes.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She picks up her briefcase and goes up one step.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "He doesn't move.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "You believe me?", "name": "DARRELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "I believe the record.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She goes up another step.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "He follows.", "para": 4, "sent": 1, "present": [0, 1]}]}