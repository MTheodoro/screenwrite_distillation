{"scene_id": "s02301", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02301.fountain", "heading": "EXT. TREEHOUSE IN A DEAD ELM - NIGHT", "cast": [{"id": 0, "name": "ANNELIESE KROLL", "names": ["ANNELIESE KROLL", "ANNELIESE"], "gender": "?", "first": 5, "spoke": 3}, {"id": 1, "name": "BO TRAN", "names": ["BO TRAN", "BO"], "gender": "?", "first": 6, "spoke": 5}, {"id": 2, "name": "KWAME BOATENG", "names": ["KWAME BOATENG", "KWAME"], "gender": "m", "first": 7, "spoke": 4}, {"id": 3, "name": "SOLEDAD IBARRA", "names": ["SOLEDAD IBARRA", "SOLEDAD"], "gender": "f", "first": 8, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. TREEHOUSE IN A DEAD ELM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A plywood box wedged in the crotch of a bare elm.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A string of Christmas lights, half burned out.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Four sleeping bags laid in a square.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Frost on the railings.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ANNELIESE KROLL, sixteen, sits cross-legged with a thermos.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "BO TRAN, sixteen, tunes a ukulele nobody asked for.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "KWAME BOATENG, seventeen, stretches on his back and stares up at a hole in the roof.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "SOLEDAD IBARRA, sixteen, perches at the edge with her feet in the air, rolling an unlit cigarette between her fingers.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Okay, okay, this one's for the graduating class.", "name": "BO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "We haven't graduated.", "name": "KWAME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "It's for the future.", "name": "BO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "You can't even play it.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "I can play three chords.", "name": "BO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Four if you count the one you broke.", "name": "SOLEDAD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Bo strums.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "It is awful.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Kwame laughs into his sleeve.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Anneliese passes the thermos to Soledad, and Soledad drinks and passes it on to Kwame, and it goes round without anyone speaking.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "The lights flicker.", "para": 2, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "The ukulele fades.", "para": 2, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "It's nice up here.", "name": "BO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Yeah.", "name": "KWAME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Yeah.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Soledad says nothing.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "She rolls the cigarette once more, then sets it on the plank beside her and folds her hands.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Hey. Can I say something?", "name": "SOLEDAD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Always.", "name": "KWAME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "I'm leaving in the morning.", "name": "SOLEDAD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Bo stops strumming.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Anneliese puts down the thermos.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Kwame sits up.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "The three of them turn to her at once, and the ukulele rolls off the platform and clatters through the branches.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "What do you mean, leaving?", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "My dad got the job. In Tucson.", "name": "SOLEDAD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Tucson?", "name": "BO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "When?", "name": "KWAME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Seven a.m.", "name": "SOLEDAD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Nobody speaks.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Frost ticks on the rail.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Kwame reaches across the square of sleeping bags and takes her sleeve between two fingers, and holds on.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Anneliese climbs over Bo and puts her head on Soledad's shoulder.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Bo just sits there, looking down at the dark where the ukulele went.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}]}