{"scene_id": "s02304", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02304.fountain", "heading": "INT. BAKERY WALK-IN COOLER - BEFORE DAWN", "cast": [{"id": 0, "name": "CASIMIR LEWANDOWSKI", "names": ["CASIMIR LEWANDOWSKI", "CASIMIR"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "ROXANE DELACROIX-HUNT", "names": ["ROXANE DELACROIX-HUNT", "ROXANE"], "gender": "?", "first": 6, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. BAKERY WALK-IN COOLER - BEFORE DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Steel shelves of dough trays.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Breath fogs.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A bare bulb swings slightly from its cord.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CASIMIR LEWANDOWSKI, sixty, the head baker, in a white coat, stands at the back wall.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "His hands shake.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Across from him ROXANE DELACROIX-HUNT, forty, in a black wool coat and leather gloves, holds a ledger.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He looks at the door.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She looks at him.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "She sets the ledger on a tray of dough, and the dough sighs under it.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "You said Tuesday.", "name": "CASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "It is Tuesday.", "name": "ROXANE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "It's four in the morning.", "name": "CASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Then it's early Tuesday.", "name": "ROXANE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She opens the ledger.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "He shuts his eyes.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She turns a page and runs a gloved finger down a column.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Forty years, I never cooked the books.", "name": "CASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "You cooked them for thirty-nine.", "name": "ROXANE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He opens his eyes.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "He reaches into his coat and she watches him do it, patient as a cat.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "He draws out a small brass key.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "It's in the flour bin.", "name": "CASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "All of it?", "name": "ROXANE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "All of it.", "name": "CASIMIR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "She takes the key.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "She does not move toward the door.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Instead she closes the ledger and sets it back in his hands.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Keep this. It's the only copy.", "name": "ROXANE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "He stares.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "She straightens her gloves.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "She walks out, and the heavy door swings shut behind her, and the bulb sways, and he stands among the dough with the book clutched to his chest like a hymnal.", "para": 6, "sent": 2, "present": [0, 1]}]}