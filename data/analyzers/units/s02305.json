{"scene_id": "s02305", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02305.fountain", "heading": "INT. DRAGON'S HOARD, MOUNTAIN CAVERN - TWILIGHT", "cast": [{"id": 0, "name": "SER ALARIC THORNWELL", "names": ["SER ALARIC THORNWELL", "ALARIC"], "gender": "m", "first": 5, "spoke": 12}, {"id": 1, "name": "BRAN", "names": ["BRAN"], "gender": "?", "first": 6, "spoke": 6}, {"id": 2, "name": "ASHDOWN", "names": ["ASHDOWN"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "VESPERINE", "names": ["VESPERINE"], "gender": "f", "first": 8, "spoke": 14}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRAGON'S HOARD, MOUNTAIN CAVERN - TWILIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cavern as wide as a cathedral.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Gold rises in slow dunes to the ceiling, spilling goblets, helms, a toppled throne.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Far above, a fissure lets in a shaft of rose light.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Warm air smells of sulphur and old coins.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SER ALARIC THORNWELL, forty, battered mail under a cloak of faded blue, kneels on a gold dune with a lantern.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Beside him, young BRANDOLF \"BRAN\" ASHDOWN, eighteen, his squire, hauls a sack, panting.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Both are filthy with soot.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "And on a shelf of rock above them, curled around a brazier of coals, lies an elderly dragon, VESPERINE, scales gone the colour of dusk.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "The dragon opens one yellow eye.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "You are very late.", "name": "VESPERINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Alaric lowers the lantern.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Bran drops the sack.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Forgive us, Vesperine. The pass was snowed in.", "name": "ALARIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "The pass has been snowed in for three hundred years. I would not have thought it a surprise.", "name": "VESPERINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Ser Alaric, she's talking.", "name": "BRAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Yes, Bran.", "name": "ALARIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Dragons talk?", "name": "BRAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Dragons do everything. We merely prefer not to.", "name": "VESPERINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Bran stares at her.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "He stares at Alaric.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Alaric folds his arms.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "We came for the sword.", "name": "ALARIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Everyone comes for the sword.", "name": "VESPERINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "My lord is dying. The kingdom needs it.", "name": "ALARIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Your lord is a fool.", "name": "VESPERINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Perhaps. But he is mine.", "name": "ALARIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "The dragon rolls her head toward Bran.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "And you, little one. What do you come for?", "name": "VESPERINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Me? I came to carry the sack.", "name": "BRAN", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Honest, at least.", "name": "VESPERINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "She shifts.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "The gold slides.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "A tarnished hilt appears among the coins.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Alaric starts toward it.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Vesperine's tail curls across his path, not violently, just a gate closing.", "para": 6, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "You'll not let us take it?", "name": "ALARIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "I did not say that.", "name": "VESPERINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Then what?", "name": "ALARIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "You carry a sack, a lantern, and the weight of a dying lord. Put them down. Sit.", "name": "VESPERINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Alaric looks at Bran.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Bran shrugs.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "They sit on the gold, knees drawn up like boys.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Vesperine settles her chin on her claws.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Tell me about the king.", "name": "VESPERINE", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "He was a good man once.", "name": "ALARIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "And now?", "name": "VESPERINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Now he is a tired one.", "name": "ALARIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Tired men make poor kings. But they make excellent grandfathers.", "name": "VESPERINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "She's smiling.", "name": "BRAN", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Dragons do not smile.", "name": "ALARIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "You see? You know nothing about us.", "name": "VESPERINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "She lifts her tail.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "The sword gleams.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Take it. And tell your king the mountain remembers him kindly.", "name": "VESPERINE", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Alaric rises.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "He crosses the dunes, lifts the hilt with both hands, and bows over it.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Bran trots after him, dragging the sack.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "At the cavern mouth Bran glances back.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "The dragon's eye is closing.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "The shaft of rose light fades to grey.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "She let us go.", "name": "BRAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "She did.", "name": "ALARIC", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "Why?", "name": "BRAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "I think she was lonely, Bran.", "name": "ALARIC", "speaker": 0, "ext": [], "paren": ["after a moment"], "dual": false, "present": [0, 1, 2, 3]}]}