{"scene_id": "s02306", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02306.fountain", "heading": "EXT. WINDMILL FARM, EVENING", "cast": [{"id": 0, "name": "EUGENE HAUSER", "names": ["EUGENE HAUSER", "EUGENE"], "gender": "m", "first": 5, "spoke": 5}, {"id": 1, "name": "CORA", "names": ["CORA"], "gender": "f", "first": 6, "spoke": 4}, {"id": 2, "name": "PATRICK", "names": ["PATRICK"], "gender": "m", "first": 7, "spoke": 2}, {"id": 3, "name": "WIDOW IMOGENE SPARROW", "names": ["WIDOW IMOGENE SPARROW", "IMOGENE"], "gender": "f", "first": 8, "spoke": 2}, {"id": 4, "name": "ISAIAH MOBLEY", "names": ["ISAIAH MOBLEY", "ISAIAH"], "gender": "?", "first": 9, "spoke": 1}, {"id": 5, "name": "TELEGRAPH CLERK", "names": ["TELEGRAPH CLERK"], "gender": "?", "first": 20, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. WINDMILL FARM, EVENING", "present": []}, {"u": 1, "kind": "action", "text": "A single wooden windmill creaks above a dry stock tank.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Beyond it, a wire fence and a field of stubble.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wind lifts the dust in slow brown ropes.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "On the porch of a low house five people sit in mismatched chairs.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "EUGENE HAUSER, seventy, bent, holds a tin cup between his knees.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "His daughter-in-law CORA, forty, sits with her sleeves rolled and a bowl of shelled peas in her lap.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Her son PATRICK, fifteen, whittles a clothespin.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "A neighbour, WIDOW IMOGENE SPARROW, sixty-five, fans herself with a hat.", "para": 1, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "And a hired man, ISAIAH MOBLEY, thirty, leans on the rail with his boots crossed.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "He watches the road.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Nobody else does.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "The windmill creaks.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Wind's up.", "name": "CORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Been up all day.", "name": "EUGENE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "It'll turn.", "name": "IMOGENE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "It always turns.", "name": "PATRICK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Not always.", "name": "ISAIAH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "They fall quiet.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "A far-off hammering echoes from somewhere beyond the hill.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Telegram! Telegram for Hauser!", "name": "TELEGRAPH CLERK", "speaker": 5, "ext": ["O.S."], "paren": ["shouting from the road"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Cora lifts her head.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Eugene sets down the cup.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Imogene's fan stops.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Patrick looks at the knife in his hand, then at his mother.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Isaiah straightens from the rail, but says nothing, and crosses the yard to the gate.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "He takes the envelope.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "He turns it over once.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "He carries it back and hands it to Eugene, who holds it without opening it.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Read it, Cora.", "name": "EUGENE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "It isn't mine.", "name": "CORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Read it anyway.", "name": "EUGENE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "She wipes her hands on her skirt, takes the envelope, tears it open.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Her eyes travel down the page and then back up, slowly.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "The peas stay in her lap.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "They want us to sign for the water rights.", "name": "CORA", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "That all?", "name": "EUGENE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "That's all.", "name": "CORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Thank God.", "name": "IMOGENE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Is that good?", "name": "PATRICK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "It's something.", "name": "EUGENE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "He takes up the cup again.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "The wind drops.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "The windmill turns once, slowly, as though remembering how.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}