{"scene_id": "s02307", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02307.fountain", "heading": "INT. CAROUSEL PAVILION, SEASIDE AMUSEMENT PARK - NIGHT", "cast": [{"id": 0, "name": "SIM", "names": ["SIM"], "gender": "?", "first": 4, "spoke": 3}, {"id": 1, "name": "ARCHAMBAULT", "names": ["ARCHAMBAULT"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "BEATRIX VON LOEWEN", "names": ["BEATRIX VON LOEWEN", "BEATRIX"], "gender": "?", "first": 5, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. CAROUSEL PAVILION, SEASIDE AMUSEMENT PARK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dust sheets.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Painted horses frozen mid-gallop, brass poles gleaming.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A mirrored hub reflects a dozen flashlight beams.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SIMEON \"SIM\" ARCHAMBAULT, forties, wiry, kneels at the base of a lacquered unicorn with a pry bar.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "BEATRIX VON LOEWEN, thirties, mask pushed up, scans the pavilion with a handheld scanner.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Come on, come on, come on.", "name": "SIM", "speaker": 0, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Everyone's gone. Camera loops for six minutes.", "name": "BEATRIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Then hold the light.", "name": "SIM", "speaker": 0, "ext": [], "paren": ["to her"], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "She obeys.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "He levers the unicorn's belly open.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "A hollow glints with gold coins, ancient, stamped with a stag, stacked like poker chips.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Sim lifts one and bites it, and Beatrix lets out a long breath.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Anyone want to say it?", "name": "BEATRIX", "speaker": 2, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "It's real.", "name": "SIM", "speaker": 0, "ext": [], "paren": ["grinning"], "dual": false, "present": [0, 1, 2]}]}