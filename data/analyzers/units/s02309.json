{"scene_id": "s02309", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02309.fountain", "heading": "INT. DEEP-SPACE HAULER, CARGO BAY 3 - SHIP'S NIGHT", "cast": [{"id": 0, "name": "CAPTAIN LUCIAN ASANTE-BROOKS", "names": ["CAPTAIN LUCIAN ASANTE-BROOKS", "LUCIAN"], "gender": "?", "first": 5, "spoke": 3}, {"id": 1, "name": "FIRST MATE YUKI TANABE-REYES", "names": ["FIRST MATE YUKI TANABE-REYES", "YUKI"], "gender": "f", "first": 6, "spoke": 2}, {"id": 2, "name": "CARGO MASTER BORIS ZIELINSKI", "names": ["CARGO MASTER BORIS ZIELINSKI", "BORIS"], "gender": "m", "first": 7, "spoke": 2}, {"id": 3, "name": "MEDIC ANJALI VERMA", "names": ["MEDIC ANJALI VERMA", "ANJALI"], "gender": "?", "first": 8, "spoke": 1}, {"id": 4, "name": "STOWAWAY", "names": ["STOWAWAY"], "gender": "m", "first": 9, "spoke": 2}, {"id": 5, "name": "PILOT", "names": ["PILOT"], "gender": "?", "first": 10, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. DEEP-SPACE HAULER, CARGO BAY 3 - SHIP'S NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Stacked containers.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Amber work lights.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A thin layer of frost on the deck plates.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The air recyclers wheeze.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CAPTAIN LUCIAN ASANTE-BROOKS, fifties, stands at a manifest console.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "FIRST MATE YUKI TANABE-REYES, thirties, runs a scanner along a container seam.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "CARGO MASTER BORIS ZIELINSKI, forties, big and tired, drags a crowbar.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "MEDIC ANJALI VERMA, thirties, hugs a trauma kit.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "A STOWAWAY, fifteen, sits cross-legged on a crate, arms wrapped round his knees.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "And the ship's AI, a disembodied voice named PILOT, hums through the wall speakers.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Boris, open it.", "name": "LUCIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "It's sealed from the inside.", "name": "BORIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "That's impossible.", "name": "YUKI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Then who sealed it?", "name": "ANJALI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Captain, thermal sensors indicate a heat signature in Container Seventeen.", "name": "PILOT", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "How warm?", "name": "LUCIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Thirty-seven degrees Celsius.", "name": "PILOT", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "Yuki lowers her scanner.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Boris sets his crowbar against the seam.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Anjali edges away from the container, closer to the stowaway.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "The boy watches it with wide, unblinking eyes.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Don't open it.", "name": "STOWAWAY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Who are you?", "name": "LUCIAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Please, don't.", "name": "STOWAWAY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Captain, the lock's cooling.", "name": "BORIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "It's venting. Pressure's equalising.", "name": "YUKI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Warning. Structural integrity of Container Seventeen has been compromised.", "name": "PILOT", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "The seam splits.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "A hiss of white vapour floods the deck, Boris staggers back, Yuki fires a flare, Anjali drags the boy behind a crate, and Lucian draws his sidearm.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "The door swings open.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Inside, curled on a bed of packing foam, a figure raises its head.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "It has the boy's face.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}