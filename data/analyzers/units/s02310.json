{"scene_id": "s02310", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02310.fountain", "heading": "INT. CASINO COUNTING ROOM - NIGHT", "cast": [{"id": 0, "name": "ELIAS VANDERKOOI", "names": ["ELIAS VANDERKOOI", "ELIAS"], "gender": "m", "first": 4, "spoke": 2}, {"id": 1, "name": "MARISOL FONTANA", "names": ["MARISOL FONTANA", "MARISOL"], "gender": "f", "first": 6, "spoke": 2}, {"id": 2, "name": "DETECTIVE HARLAN BECKMANN", "names": ["DETECTIVE HARLAN BECKMANN", "BECKMANN"], "gender": "?", "first": 20, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. CASINO COUNTING ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Stacked cash.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Camera domes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A hum of machines.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ELIAS VANDERKOOI, fifty, in a grey suit, sits at a desk and sorts bills with a licked thumb.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He does not look up when the vault door clicks.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "His partner MARISOL FONTANA, forty, closes it behind her and leans against it.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "She holds a duffel bag by one strap.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She does not look at the money.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "She looks at him.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Late.", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Traffic.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He sets down the bills.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She lets the duffel slide to the floor and kicks it across the carpet.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "It stops against his shoe.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "That's the whole amount?", "name": "ELIAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "It's all of it.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Elias sighs.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He stands, slowly, and he unbuttons his jacket.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "A third figure steps out from behind the shelving.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "DETECTIVE HARLAN BECKMANN, sixty, in a trench coat, holds a badge in one hand and handcuffs in the other.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Evening.", "name": "BECKMANN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Marisol closes her eyes.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Elias lifts his hands, calm, almost relieved, and says nothing at all.", "para": 6, "sent": 1, "present": [0, 1, 2]}]}