{"scene_id": "s02311", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02311.fountain", "heading": "INT. PHOTO BOOTH, WEDDING RECEPTION - NIGHT", "cast": [{"id": 0, "name": "INGRID SOLBERG", "names": ["INGRID SOLBERG", "INGRID"], "gender": "f", "first": 3, "spoke": 6}, {"id": 1, "name": "THEO MARCHETTI", "names": ["THEO MARCHETTI", "THEO"], "gender": "f", "first": 4, "spoke": 5}, {"id": 2, "name": "PASCAL", "names": ["PASCAL"], "gender": "m", "first": 5, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. PHOTO BOOTH, WEDDING RECEPTION - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A curtained booth, red velvet, a strip of lightbulbs.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Muffled dance music thumps through the walls.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "INGRID SOLBERG, thirty, in a bridesmaid's green dress, sits on the stool with her shoes in her lap.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "THEO MARCHETTI, thirty-two, a groomsman, slides in beside her, tie loosened.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "PASCAL, the photographer's assistant, nineteen, sticks his head through the curtain with a coin tray.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Four frames. Strike a pose.", "name": "PASCAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "We're not together.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "We're not together.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Do not make this weird.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "The flash goes.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Ingrid and Theo both flinch and nearly fall off the stool.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Pascal ducks out.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "We haven't spoken in three years.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "We spoke in March.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "You said \"excuse me.\"", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "You were in the way of the cheese.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "The flash goes again.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Neither smiles.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "You look good.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Don't.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "I'm just saying.", "name": "THEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "I know what you're saying. You're saying it with that face.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Flash.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "She is looking at him.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "He is looking at her.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Flash.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "She leans in and kisses him, hard, and the booth shakes.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "The curtain parts.", "para": 4, "sent": 5, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Do you want me to keep the strip?", "name": "PASCAL", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}]}