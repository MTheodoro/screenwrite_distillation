{"scene_id": "s02312", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02312.fountain", "heading": "INT. HOUSEBOAT, DINING TABLE - NIGHT", "cast": [{"id": 0, "name": "ROSALEEN FITZPATRICK", "names": ["ROSALEEN FITZPATRICK", "ROSALEEN"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "THADDEUS FITZPATRICK", "names": ["THADDEUS FITZPATRICK", "THADDEUS"], "gender": "?", "first": 4, "spoke": 13}, {"id": 2, "name": "CILLIAN", "names": ["CILLIAN"], "gender": "m", "first": 6, "spoke": 12}, {"id": 3, "name": "YASMIN FITZPATRICK", "names": ["YASMIN FITZPATRICK", "YASMIN"], "gender": "?", "first": 4, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOUSEBOAT, DINING TABLE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A narrow cabin lit by a hurricane lamp.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A pot of stew steams.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The hull knocks gently against a pier.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ROSALEEN FITZPATRICK, sixty, her hair pinned up, ladles stew.", "para": 1, "sent": 0, "present": [0, 1, 3]}, {"u": 5, "kind": "action", "text": "Her husband THADDEUS FITZPATRICK, sixty-two, bearded, tears bread in silence.", "para": 1, "sent": 1, "present": [0, 1, 3]}, {"u": 6, "kind": "action", "text": "Their son CILLIAN, thirty-four, in a city jacket, stares at his bowl.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "And his wife YASMIN FITZPATRICK, thirty, folds her napkin into smaller and smaller squares.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Eat.", "name": "ROSALEEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "I'm not hungry.", "name": "CILLIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "You drove four hours.", "name": "ROSALEEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I had a sandwich.", "name": "CILLIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Where?", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "A service station.", "name": "CILLIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "They'll charge you three pounds for a sandwich.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "It was four.", "name": "CILLIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Robbery.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Yasmin, more stew?", "name": "ROSALEEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "I'm fine, thank you.", "name": "YASMIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "You didn't finish.", "name": "ROSALEEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "I'm full.", "name": "YASMIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "You're thin.", "name": "ROSALEEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "I'm what I always am.", "name": "YASMIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "A pause.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Thaddeus sets down the bread.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Your mother made this stew.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "It's good.", "name": "CILLIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "It's the same as last year.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "That's what makes it good.", "name": "CILLIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Then why do you look like that?", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Like what?", "name": "CILLIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Like a man who's sold the boat.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Rosaleen sets down the ladle.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Yasmin's napkin is a tiny white square.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Dad.", "name": "CILLIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Did you sell the boat?", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "I haven't sold anything.", "name": "CILLIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "You've had a man to look at her.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "That was a surveyor. For the bank.", "name": "CILLIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "The bank.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Thaddeus.", "name": "ROSALEEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "The bank, Rosaleen.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "The mortgage is three months behind. I didn't know how to say it.", "name": "CILLIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "So you brought a surveyor.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "I brought help.", "name": "CILLIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "I don't need help.", "name": "THADDEUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "He rises.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "The chair scrapes, the lamp swings, shadows slide across the walls.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "He goes up the stairs and out onto the deck, and the hull rocks under his boots.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Nobody moves.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}]}