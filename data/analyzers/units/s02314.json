{"scene_id": "s02314", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02314.fountain", "heading": "INT. JURY ROOM, OLD GRAIN EXCHANGE - DAY", "cast": [{"id": 0, "name": "FOREWOMAN GERTRUDE OYELOWO", "names": ["FOREWOMAN GERTRUDE OYELOWO", "GERTRUDE"], "gender": "?", "first": 6, "spoke": 5}, {"id": 1, "name": "QUIET MAN", "names": ["YOUNG MAN", "QUIET MAN", "THE YOUNG MAN"], "gender": "?", "first": 7, "spoke": 7}, {"id": 2, "name": "HOODIE", "names": ["HOODIE"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "CORNELIUS BELLWETHER", "names": ["CORNELIUS BELLWETHER", "BELLWETHER"], "gender": "m", "first": 8, "spoke": 3}, {"id": 4, "name": "WOMAN KNITTING", "names": ["WOMAN KNITTING", "KNITTING WOMAN"], "gender": "?", "first": 9, "spoke": 2}, {"id": 5, "name": "BUS DRIVER", "names": ["BUS DRIVER"], "gender": "?", "first": 10, "spoke": 3}, {"id": 6, "name": "ANSELM", "names": ["ANSELM"], "gender": "?", "first": 35, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. JURY ROOM, OLD GRAIN EXCHANGE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A long table of scarred oak.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Tall windows with blinds half drawn.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A pitcher of water sweats.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Dust motes spin.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Six jurors sit in a row.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "FOREWOMAN GERTRUDE OYELOWO, sixty, taps a pen.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "A YOUNG MAN IN A HOODIE slouches.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "MR. CORNELIUS BELLWETHER, seventy, in a bow tie, polishes his glasses.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "A WOMAN WITH KNITTING, plump, needles clicking.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "A BUS DRIVER in uniform, arms crossed.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "And a QUIET MAN at the end, thin, bald, who has said nothing.", "para": 1, "sent": 6, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "We'll go around. Verdict?", "name": "GERTRUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Guilty.", "name": "BELLWETHER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Not guilty.", "name": "THE YOUNG MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Guilty.", "name": "KNITTING WOMAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Guilty. Obviously.", "name": "BUS DRIVER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Juror six?", "name": "GERTRUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "The quiet man looks up.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "He sets a hand flat on the table.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Not guilty.", "name": "QUIET MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "On what grounds?", "name": "BELLWETHER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Reasonable doubt.", "name": "QUIET MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "There's no doubt.", "name": "BUS DRIVER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "There's some.", "name": "QUIET MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Where?", "name": "KNITTING WOMAN", "speaker": 4, "ext": [], "paren": ["counting stitches"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "The light switch.", "name": "QUIET MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "What about it?", "name": "GERTRUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "The defendant said he flipped it on. But the switch was installed upside down. Up means off.", "name": "QUIET MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "The needles stop clicking.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Bellwether puts his glasses back on.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Remarkable.", "name": "BELLWETHER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Told you.", "name": "THE YOUNG MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "What's your name, Juror six?", "name": "GERTRUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Anselm Rudd. Electrician.", "name": "ANSELM", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "Of course.", "name": "BUS DRIVER", "speaker": 5, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "dialogue", "text": "I'll explain it again, if anyone wants.", "name": "ANSELM", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "dialogue", "text": "We have all day.", "name": "GERTRUDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}