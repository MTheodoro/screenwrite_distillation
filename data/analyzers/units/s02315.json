{"scene_id": "s02315", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02315.fountain", "heading": "INT. ROOFTOP BAR, HOTEL TERRACE - NIGHT", "cast": [{"id": 0, "name": "STRANGER", "names": ["STRANGER"], "gender": "m", "first": 6, "spoke": 3}, {"id": 1, "name": "VIVIENNE ASHFORD-LANE", "names": ["VIVIENNE ASHFORD-LANE", "VIVIENNE"], "gender": "?", "first": 9, "spoke": 6}, {"id": 2, "name": "BARTENDER", "names": ["BARTENDER"], "gender": "?", "first": 12, "spoke": 0}, {"id": 3, "name": "DOMINIC", "names": ["DOMINIC"], "gender": "?", "first": 12, "spoke": 3}, {"id": 4, "name": "QUENTIN", "names": ["QUENTIN"], "gender": "f", "first": 24, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROOFTOP BAR, HOTEL TERRACE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Candles in glass chimneys.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A city of lights twenty floors down.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Jazz from a speaker.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The bar is nearly empty.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A velvet rope hangs from brass posts near the stairwell door.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "A STRANGER in a trench coat sits alone at the end of the bar, a half-finished martini before him.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "His hat is pulled low.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "On his sleeve is a small spot of dried blood.", "para": 1, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "VIVIENNE ASHFORD-LANE, thirty-five, in an emerald gown and long gloves, enters through the stairwell door.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She pauses.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She crosses to the bar and takes the stool beside his.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "The BARTENDER, DOMINIC, fifty, polishes a glass with a white cloth.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Whisky. Neat.", "name": "VIVIENNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Right away, Miss Ashford-Lane.", "name": "DOMINIC", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "The stranger turns his head.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "He studies her.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "She does not meet his gaze.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "You come here often?", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Every Thursday.", "name": "VIVIENNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Then you'll know the barman's been paid to forget me.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Dominic's polishing stops.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "The glass rings against the bar top.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Who are you?", "name": "VIVIENNE", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Call me Quentin.", "name": "STRANGER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "I'm the man who knows what your husband did on Tuesday.", "name": "QUENTIN", "speaker": 4, "ext": [], "paren": ["lifting his martini"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "She sets down her glove.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Her pulse jumps in her throat.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "She reaches for her purse.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Quentin's hand closes over her wrist, not roughly.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Don't. Dominic has a gun under the register, and I have a better one.", "name": "QUENTIN", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Miss Ashford-Lane, I'm sorry.", "name": "DOMINIC", "speaker": 3, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "You work for him?", "name": "VIVIENNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "For both of you. Different days.", "name": "DOMINIC", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Quentin releases her wrist.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "He sets a folded envelope on the bar and slides it across.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Open it.", "name": "QUENTIN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "She does.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "A single photograph.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Her husband, unmoving, at the foot of a staircase.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "She exhales.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "For a long moment she says nothing.", "para": 7, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Thank you.", "name": "VIVIENNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "That's it?", "name": "QUENTIN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "That's it.", "name": "VIVIENNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "She finishes her whisky.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "She leaves a very large tip.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}]}