{"scene_id": "s02316", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02316.fountain", "heading": "INT. PAWNSHOP, BACK ROOM - NIGHT", "cast": [{"id": 0, "name": "SILK", "names": ["SILK"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "MERCADO", "names": ["MERCADO"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "TWO-TON TOMMY", "names": ["TWO-TON TOMMY"], "gender": "?", "first": 5, "spoke": 1}, {"id": 3, "name": "PEARL", "names": ["PEARL"], "gender": "?", "first": 5, "spoke": 2}, {"id": 4, "name": "BIG ARTHUR", "names": ["BIG ARTHUR"], "gender": "?", "first": 5, "spoke": 1}, {"id": 5, "name": "SWEETS", "names": ["SWEETS"], "gender": "m", "first": 5, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. PAWNSHOP, BACK ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Shelves of guitars, cameras, wedding rings under glass.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single dusty lamp.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Tension thick as the smell.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SILAS \"SILK\" MERCADO, forties, in a silk shirt, leans on a safe.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Four men face him in a loose arc: TWO-TON TOMMY, enormous; PEARL, thin and quick; BIG ARTHUR, grey-bearded; and young SWEETS, jittery, with a revolver tucked in his waistband.", "para": 1, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 6, "kind": "dialogue", "text": "Gentlemen.", "name": "SILK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 7, "kind": "dialogue", "text": "Silk.", "name": "TWO-TON TOMMY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 8, "kind": "dialogue", "text": "You're late.", "name": "PEARL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 9, "kind": "dialogue", "text": "I'm exactly on time.", "name": "SILK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 10, "kind": "dialogue", "text": "He's lying.", "name": "SWEETS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Quiet, boy.", "name": "BIG ARTHUR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "Silk reaches for the safe dial.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "Sweets' hand twitches toward his waistband.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "Pearl and Tommy move together to block him, and Arthur steps between, and for a moment all four stand shoulder to shoulder, nobody breathing.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "action", "text": "The lamp flickers.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Easy. It's just the combination.", "name": "SILK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "He spins the dial.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "A click.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "The door swings open on rows of bundled cash.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Nobody moves.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Count it.", "name": "PEARL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Already did.", "name": "SILK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}