{"scene_id": "s02317", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02317.fountain", "heading": "INT. FAMILY MINIVAN, PARKED OUTSIDE GRANDMA'S HOUSE - DAY", "cast": [{"id": 0, "name": "DAD", "names": ["DAD"], "gender": "?", "first": 4, "spoke": 0}, {"id": 1, "name": "ROBERT OYELARAN", "names": ["ROBERT OYELARAN", "ROBERT"], "gender": "?", "first": 4, "spoke": 6}, {"id": 2, "name": "MOM", "names": ["MOM"], "gender": "?", "first": 5, "spoke": 0}, {"id": 3, "name": "WENDY OYELARAN", "names": ["WENDY OYELARAN", "WENDY"], "gender": "?", "first": 4, "spoke": 6}, {"id": 4, "name": "TEEN", "names": ["TEEN"], "gender": "?", "first": 6, "spoke": 0}, {"id": 5, "name": "MAYA", "names": ["MAYA"], "gender": "?", "first": 6, "spoke": 4}, {"id": 6, "name": "LITTLE BROTHER BENNY", "names": ["LITTLE BROTHER BENNY", "BENNY"], "gender": "?", "first": 6, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. FAMILY MINIVAN, PARKED OUTSIDE GRANDMA'S HOUSE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Rain taps the windshield.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The seats are littered with crayons and fast-food bags.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A tiny air freshener swings from the mirror.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DAD, ROBERT OYELARAN, forty-five, grips the wheel and stares at the house.", "para": 1, "sent": 0, "present": [0, 1, 3]}, {"u": 5, "kind": "action", "text": "MOM, WENDY OYELARAN, forty-three, in the passenger seat, adjusts her hair in the visor mirror.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "action", "text": "In the back, TEEN, MAYA, fifteen, scrolls her phone, earbuds in, and LITTLE BROTHER BENNY, seven, hugs a stuffed rabbit.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 7, "kind": "dialogue", "text": "Okay. Everyone. Smile, be polite, no complaining.", "name": "WENDY", "speaker": 3, "ext": [], "paren": ["to the car"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 8, "kind": "dialogue", "text": "Do I have to hug her?", "name": "BENNY", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 9, "kind": "dialogue", "text": "Yes.", "name": "ROBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "dialogue", "text": "She smells like cabbage.", "name": "BENNY", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "Benny.", "name": "WENDY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "Can we skip it this year?", "name": "MAYA", "speaker": 5, "ext": [], "paren": ["pulling an earbud"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "No, Maya.", "name": "ROBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "Great.", "name": "MAYA", "speaker": 5, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "Robert, you remember what we agreed.", "name": "WENDY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "No politics.", "name": "ROBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "No politics, no complaints about the casserole.", "name": "WENDY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "She makes it on purpose.", "name": "ROBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "Robert.", "name": "WENDY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "Fine.", "name": "ROBERT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "action", "text": "The front door of the house opens.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "action", "text": "GRANDMA waves from the porch in a pink cardigan.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "Everyone in the van freezes, then waves back at once, teeth bared in unison.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "She's got the casserole.", "name": "BENNY", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "I know.", "name": "ROBERT", "speaker": 1, "ext": [], "paren": ["under his breath"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "action", "text": "The doors open.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "They file out into the rain, Maya last, dragging her feet.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "She pauses to pocket her earbuds.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "Love you guys.", "name": "MAYA", "speaker": 5, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "What?", "name": "WENDY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "Nothing. Let's go.", "name": "MAYA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}