{"scene_id": "s02318", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02318.fountain", "heading": "INT. FARMHOUSE BASEMENT - NIGHT", "cast": [{"id": 0, "name": "DEZ", "names": ["DEZ"], "gender": "?", "first": 5, "spoke": 4}, {"id": 1, "name": "CALLUM KOWALCZYK", "names": ["KOWALCZYK", "CALLUM KOWALCZYK", "CALLUM"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "RHONDA", "names": ["RHONDA"], "gender": "f", "first": 7, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. FARMHOUSE BASEMENT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dirt floor.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single bare bulb on a cord.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Shelves of mason jars.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A furnace thumps like a heartbeat.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DESMOND \"DEZ\" KOWALCZYK, thirty, and his brother CALLUM KOWALCZYK, twenty-eight, crouch by a low iron door in the far wall.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Dez holds a crowbar, Callum a flashlight.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Their cousin RHONDA, thirty-five, stands on the steps, arms wrapped round herself.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Dez, don't.", "name": "RHONDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "We have to know.", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Dez is right.", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Callum, you're not helping.", "name": "RHONDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Rhonda, I'm trying.", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "He aims the light at the iron door.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "It is covered in scratches, long and deep.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Dez sets the crowbar in the seam and heaves.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Nothing.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "It's rusted shut.", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Together.", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "They push.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "The door groans.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Rhonda gasps.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Something inside gives a long low hiss, and the bulb flickers, then dies.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "The furnace stops thumping.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Dez? Callum?", "name": "RHONDA", "speaker": 2, "ext": [], "paren": ["in the dark"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "I'm here.", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "I'm here.", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Something's breathing.", "name": "RHONDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "That's us.", "name": "DEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "No. It isn't.", "name": "RHONDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "The bulb flares back.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Dez and Callum are alone on the dirt floor.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The door is wide open.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "The steps are empty.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Rhonda's voice calls from the dark behind the iron, small and cheerful.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Come on in, boys!", "name": "RHONDA", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}]}