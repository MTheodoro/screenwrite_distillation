{"scene_id": "s02319", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02319.fountain", "heading": "INT. INTERROGATION ROOM, PRECINCT 9 - NIGHT", "cast": [{"id": 0, "name": "JO", "names": ["JO"], "gender": "?", "first": 4, "spoke": 25}, {"id": 1, "name": "PRUITT", "names": ["PRUITT"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "CARMINE LUCIANO", "names": ["CARMINE LUCIANO", "CARMINE"], "gender": "m", "first": 5, "spoke": 25}], "units": [{"u": 0, "kind": "heading", "text": "INT. INTERROGATION ROOM, PRECINCT 9 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A steel table, two chairs, a one-way mirror that has seen better decades.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single fluorescent tube buzzes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A tape recorder sits between them, its reels still.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DETECTIVE JOSEPHINE \"JO\" PRUITT, forty-five, shirtsleeves rolled, leans back in her chair with a coffee.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Across from her sits CARMINE LUCIANO, fifty, in a camel overcoat, his hands folded, a gold ring on every finger.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Mr. Luciano. Thanks for coming in.", "name": "JO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "I came in because you asked nicely.", "name": "CARMINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "I always ask nicely.", "name": "JO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "That's what worries me.", "name": "CARMINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "She sets her coffee down.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "She switches on the tape recorder.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "The reels begin to turn.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "For the record, state your whereabouts on Saturday night.", "name": "JO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Home. With my wife.", "name": "CARMINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Your wife is in Palm Beach.", "name": "JO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Then I was home alone.", "name": "CARMINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Doing what?", "name": "JO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Reading.", "name": "CARMINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "What were you reading?", "name": "JO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "A cookbook.", "name": "CARMINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "She smiles.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "He doesn't.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "She slides a photograph across the table.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "He glances at it, then back at her face.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Do you know this man?", "name": "JO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "No.", "name": "CARMINE", "speaker": 2, "ext": [], "paren": ["a pause"], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "His name was Anthony Bellavance. He was found in the river.", "name": "JO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "A tragedy.", "name": "CARMINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "He was your accountant.", "name": "JO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "I have many accountants.", "name": "CARMINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "This one kept two sets of books.", "name": "JO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Carmine's jaw tightens.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "He unfolds his hands, places them flat on the table, and examines the rings.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Detective, are you charging me?", "name": "CARMINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Not yet.", "name": "JO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Then I'd like my lawyer.", "name": "CARMINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "He's on his way.", "name": "JO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Good.", "name": "CARMINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Good.", "name": "JO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "You're making a mistake.", "name": "CARMINE", "speaker": 2, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "You're making one too.", "name": "JO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "A long silence.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "The fluorescent tube buzzes.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Carmine takes a cigar from his coat.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "She watches him.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "He sniffs it, lets it hang in his fingers.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "May I?", "name": "CARMINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "No smoking.", "name": "JO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Even for old friends?", "name": "CARMINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "We're not friends.", "name": "JO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "You wound me.", "name": "CARMINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "I'd rather arrest you.", "name": "JO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "He laughs, genuinely, and puts the cigar away.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "You remind me of someone.", "name": "CARMINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "Who?", "name": "JO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "Your father.", "name": "CARMINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Her coffee cup stops halfway to her mouth.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "She sets it down slowly, deliberately, without a sound.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "Say that again.", "name": "JO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "I knew Mickey Pruitt. A good cop. A hard man. We had an understanding.", "name": "CARMINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "He never took a dime.", "name": "JO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "No. He took something better.", "name": "CARMINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "What?", "name": "JO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "My word.", "name": "CARMINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "Jo rises.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "The chair legs scrape.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "She walks to the mirror and stands with her back to him, her palms against the glass.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "In the reflection her face is steady and her hands are not.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 69, "kind": "dialogue", "text": "What did he ask for?", "name": "JO", "speaker": 0, "ext": [], "paren": ["not turning"], "dual": false, "present": [0, 1, 2]}, {"u": 70, "kind": "dialogue", "text": "He asked me to leave his daughter out of it.", "name": "CARMINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 71, "kind": "dialogue", "text": "Out of what?", "name": "JO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 72, "kind": "dialogue", "text": "Out of everything.", "name": "CARMINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 73, "kind": "action", "text": "She turns.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 74, "kind": "action", "text": "For the first time, Carmine looks tired.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 75, "kind": "action", "text": "He folds his hands again and waits.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 76, "kind": "action", "text": "The tape recorder turns.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 77, "kind": "dialogue", "text": "I need a minute.", "name": "JO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 78, "kind": "dialogue", "text": "Take two.", "name": "CARMINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 79, "kind": "action", "text": "She crosses to the door.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 80, "kind": "action", "text": "She opens it, pauses, and glances back.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 81, "kind": "dialogue", "text": "Don't go anywhere.", "name": "JO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 82, "kind": "dialogue", "text": "Where would I go?", "name": "CARMINE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 83, "kind": "action", "text": "She leaves.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 84, "kind": "action", "text": "The door closes.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 85, "kind": "action", "text": "He leans back and studies the mirror, and then, very slightly, he nods at it, as though at an old friend on the other side.", "para": 11, "sent": 2, "present": [0, 1, 2]}]}