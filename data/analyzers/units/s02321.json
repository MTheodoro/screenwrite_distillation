{"scene_id": "s02321", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02321.fountain", "heading": "EXT. CANAL LOCK - ABANDONED BARGE - DUSK", "cast": [{"id": 0, "name": "SERGEANT KOWALCZYK", "names": ["SERGEANT KOWALCZYK", "KOWALCZYK"], "gender": "?", "first": 5, "spoke": 6}, {"id": 1, "name": "PRIVATE TEMBO", "names": ["PRIVATE TEMBO", "TEMBO"], "gender": "?", "first": 8, "spoke": 2}, {"id": 2, "name": "CORPORAL ISHIDA", "names": ["CORPORAL ISHIDA", "ISHIDA"], "gender": "m", "first": 11, "spoke": 3}, {"id": 3, "name": "CIVILIAN WOMAN", "names": ["CIVILIAN WOMAN"], "gender": "f", "first": 26, "spoke": 4}, {"id": 4, "name": "MIREILLE", "names": ["MIREILLE"], "gender": "?", "first": 35, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. CANAL LOCK - ABANDONED BARGE - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "Mud.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Reeds.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A gutted barge half sunk in the lock chamber.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain thinning to nothing.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SERGEANT KOWALCZYK, 30s, ash-faced, crouches on the deck.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Rifle across his knees.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "He counts rounds by touch.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "PRIVATE TEMBO, 19, scrawny, huddles behind a coil of rope.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Helmet too big.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Shaking.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "CORPORAL ISHIDA, 20s, steady, sweeps the far bank through a cracked scope.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Distant guns, getting farther.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Is that it? Are they gone?", "name": "TEMBO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Shut up and breathe.", "name": "KOWALCZYK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Nothing moving. Tree line's clear.", "name": "ISHIDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Kowalczyk looks at the hatch.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "A knock from below.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Three slow raps.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "All three men freeze.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Rifles up.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Hands. Now.", "name": "KOWALCZYK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "The hatch lifts a few inches.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "A woman's hand.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Then a face.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "A CIVILIAN WOMAN, 30s, soaked, coat buttoned wrong, clutches a canvas bag to her chest.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Don't shoot. Please.", "name": "CIVILIAN WOMAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Who are you?", "name": "ISHIDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "I live here. I live on the barge.", "name": "CIVILIAN WOMAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Nobody lives here.", "name": "TEMBO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "I do.", "name": "CIVILIAN WOMAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Kowalczyk lowers the rifle an inch.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Doesn't lower it more.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Name.", "name": "KOWALCZYK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Mireille.", "name": "CIVILIAN WOMAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Anyone else down there, Mireille?", "name": "KOWALCZYK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "A cat.", "name": "MIREILLE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Tembo laughs.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Short.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Cracked.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Then it turns into something else and he presses his sleeve to his mouth.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Ishida hands him a canteen.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Doesn't say anything.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "You hungry?", "name": "KOWALCZYK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Yes.", "name": "MIREILLE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Kowalczyk digs in his pack.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Tosses a tin.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "She catches it with one hand, bag still clamped under the other arm.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "They'll come back at dawn.", "name": "MIREILLE", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "We know.", "name": "ISHIDA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "There's a way out. Under the sluice gate.", "name": "MIREILLE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Kowalczyk studies her.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Rain starts again, light.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "Show us.", "name": "KOWALCZYK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}