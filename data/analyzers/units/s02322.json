{"scene_id": "s02322", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02322.fountain", "heading": "INT. COURTHOUSE FREIGHT ELEVATOR - STUCK BETWEEN FLOORS - NIGHT", "cast": [{"id": 0, "name": "ROSALIND PETTIGREW", "names": ["ROSALIND PETTIGREW", "ROSALIND"], "gender": "?", "first": 4, "spoke": 27}, {"id": 1, "name": "DEMETRIUS OKONKWO-HALE", "names": ["DEMETRIUS OKONKWO-HALE", "DEMETRIUS"], "gender": "m", "first": 5, "spoke": 27}], "units": [{"u": 0, "kind": "heading", "text": "INT. COURTHOUSE FREIGHT ELEVATOR - STUCK BETWEEN FLOORS - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A steel box with a scarred wooden floor.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A work light flickers.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A stenciled sign: MAX LOAD 4000 LBS.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ROSALIND PETTIGREW, 50s, prosecutor, grips a banker's box.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "DEMETRIUS OKONKWO-HALE, 40s, defense counsel, leans on the back wall with a coffee cup.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "The elevator hangs still.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "A cable creaks overhead.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Twelve minutes.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "It's been eleven.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Then you can count. Good. Count how long my offer stands.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Your offer is manslaughter and eight years.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "It's a gift.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "It's a coin flip with the coin removed.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She presses the alarm button.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Nothing.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She presses it again.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Your client lied to the detective.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Your detective led him.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Your client said he was at the depot.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "He was at the depot.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Until nine.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Until nine fifteen.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "The body was found at nine twenty.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "The depot is eleven minutes from the creek.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Then he ran.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "In dress shoes. Carrying a toolbox.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Rosalind sets the banker's box down.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Opens it.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Pulls a photograph.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Holds it out without looking at him.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Look at it.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "I've seen it.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Look at it again.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "He takes the photograph.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "He studies it.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "His jaw works.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "The shoe prints don't match.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "The prints are smudged.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "They're smudged because your tech walked through them.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "That is a very convenient theory.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "It's a photograph.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "The elevator lurches.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Both of them grab the rail.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "The coffee spills across the floor.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "Both stare at the puddle as it spreads toward the box.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Rosalind snatches the box up.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Demetrius shoves his foot against the puddle, blocking it.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "That box is evidence.", "name": "DEMETRIUS", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "That box is mine.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "Then keep it dry.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "They both stop moving.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "The cable stops creaking.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "Silence.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "Was that the brake?", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "I don't know.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "Don't say \"I don't know\" to me.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "I'm not your witness.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "You're the one who wanted to take the freight elevator.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "You pushed the button.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "I was pointing at it.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "You pushed it.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "Rosalind sits down on the box.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "Straightens her skirt.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "Looks up at the ceiling vent, then at him.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "Six years.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "Four.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "Five, and he pleads to the lesser count.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "No.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "No?", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "He didn't do it.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "dialogue", "text": "Mr. Okonkwo-Hale, I have a thirty-year record that says everyone says that.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 72, "kind": "dialogue", "text": "And your record never once says someone was right?", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "Rosalind stands.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 74, "kind": "action", "text": "They are close in the small space.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 75, "kind": "action", "text": "Neither backs away.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 76, "kind": "dialogue", "text": "You think I want to be right?", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 77, "kind": "dialogue", "text": "I think you want to be done.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 78, "kind": "dialogue", "text": "That's the same thing.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 79, "kind": "dialogue", "text": "It isn't.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 80, "kind": "action", "text": "The light flickers off.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 81, "kind": "action", "text": "Total dark.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 82, "kind": "action", "text": "A beat.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 83, "kind": "action", "text": "Two beats.", "para": 11, "sent": 3, "present": [0, 1]}, {"u": 84, "kind": "action", "text": "It flickers on.", "para": 11, "sent": 4, "present": [0, 1]}, {"u": 85, "kind": "action", "text": "They are exactly where they were.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 86, "kind": "action", "text": "Neither has moved.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 87, "kind": "dialogue", "text": "Four years. Plea to the lesser. I'll sign it in this box.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 88, "kind": "dialogue", "text": "I'll need to hear it from you after we're out.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 89, "kind": "dialogue", "text": "You'll hear it.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 90, "kind": "dialogue", "text": "I'll need it in writing.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 91, "kind": "dialogue", "text": "Do you have a pen?", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 92, "kind": "action", "text": "He pats his pockets.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 93, "kind": "action", "text": "She pats hers.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 94, "kind": "action", "text": "They both check their jackets, then each other's eyes.", "para": 13, "sent": 2, "present": [0, 1]}, {"u": 95, "kind": "dialogue", "text": "No.", "name": "DEMETRIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 96, "kind": "dialogue", "text": "Of course not.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 97, "kind": "action", "text": "The elevator groans.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 98, "kind": "action", "text": "Begins, slowly, to rise.", "para": 14, "sent": 1, "present": [0, 1]}, {"u": 99, "kind": "action", "text": "They both look up.", "para": 14, "sent": 2, "present": [0, 1]}, {"u": 100, "kind": "action", "text": "Neither speaks.", "para": 14, "sent": 3, "present": [0, 1]}, {"u": 101, "kind": "action", "text": "The floor numbers light, one by one, over the door.", "para": 14, "sent": 4, "present": [0, 1]}]}