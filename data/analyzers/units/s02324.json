{"scene_id": "s02324", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02324.fountain", "heading": "INT. FISH-DRYING SHED - ICELANDIC COAST - DAWN", "cast": [{"id": 0, "name": "SKAR", "names": ["SKAR"], "gender": "?", "first": 6, "spoke": 0}, {"id": 1, "name": "ELINBORG", "names": ["ELINBORG"], "gender": "m", "first": 8, "spoke": 15}, {"id": 2, "name": "KARI", "names": ["KARI"], "gender": "f", "first": 11, "spoke": 7}, {"id": 3, "name": "BJARNI", "names": ["BJARNI"], "gender": "m", "first": 14, "spoke": 6}, {"id": 4, "name": "\u00d3SKAR", "names": ["\u00d3SKAR"], "gender": "?", "first": 19, "spoke": 15}, {"id": 5, "name": "SIGR\u00daN", "names": ["SIGR\u00daN"], "gender": "?", "first": 13, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. FISH-DRYING SHED - ICELANDIC COAST - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A long timber shed.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Slatted walls leak gray sea light.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Thousands of cod hang from the rafters in rows, stiff as boards.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The air smells of salt and iron.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A woodstove ticks in the corner.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "GRANDPA \u00d3SKAR, 80s, wears a wool cap pulled low and a face like a cliff.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "He sits on an overturned crate, mending a net with fingers that don't need to look.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "ELINBORG, 40s, his daughter, stands rigid by the door in a city coat.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Wrong boots.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She holds a folder against her chest.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "KARI, 16, her son, lounges against the wall in headphones, hood up.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Earbuds leaking tinny bass.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "SIGR\u00daN, 12, Kari's sister, sits cross-legged on the floor, counting fish with her lips.", "para": 4, "sent": 0, "present": [0, 1, 2, 5]}, {"u": 14, "kind": "action", "text": "BJARNI, 50s, \u00d3skar's other son, comes in last.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 5]}, {"u": 15, "kind": "action", "text": "Shoulders wide.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 5]}, {"u": 16, "kind": "action", "text": "A thermos in one fist.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 5]}, {"u": 17, "kind": "action", "text": "Mud to the knee.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 5]}, {"u": 18, "kind": "dialogue", "text": "You told me it was shut down.", "name": "ELINBORG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5]}, {"u": 19, "kind": "dialogue", "text": "It was shut down. Now it's open.", "name": "\u00d3SKAR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Dad wanted to dry one more season.", "name": "BJARNI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Dad is eighty-four.", "name": "ELINBORG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Dad can hear you.", "name": "\u00d3SKAR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Can we go?", "name": "KARI", "speaker": 2, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Kari, take those out.", "name": "ELINBORG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Why?", "name": "KARI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Because your grandfather is talking.", "name": "ELINBORG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Kari removes one earbud.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Slowly.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Like a concession.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Your mother wants to sell this place.", "name": "\u00d3SKAR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "I want to talk about it.", "name": "ELINBORG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "That's what selling is.", "name": "BJARNI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Seven hundred and twelve.", "name": "SIGR\u00daN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "What is?", "name": "BJARNI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "The fish.", "name": "SIGR\u00daN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Nobody answers her.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "The offer is real. A developer from Reykjav\u00edk. They want the shoreline.", "name": "ELINBORG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "They want a hotel.", "name": "\u00d3SKAR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "They want a lot of things.", "name": "ELINBORG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Dad built the racks.", "name": "BJARNI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "I built the racks. My father built the shed.", "name": "\u00d3SKAR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "And what did his father build?", "name": "ELINBORG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "Nothing. He died on a boat.", "name": "\u00d3SKAR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Pabbi.", "name": "ELINBORG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Don't Pabbi me.", "name": "\u00d3SKAR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Silence.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "The stove ticks.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "A cod sways on its string, knocking another.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "Dad, please.", "name": "ELINBORG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "Dad, enough.", "name": "BJARNI", "speaker": 3, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "Can I say something?", "name": "KARI", "speaker": 2, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "You can say something.", "name": "\u00d3SKAR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "I don't care about the hotel. I don't care about any of it. But I think... I think the smell here is the best thing I've ever smelled.", "name": "KARI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "Kari.", "name": "ELINBORG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "I'm serious. It smells like him. Like Afi. Like everything he's ever worn.", "name": "KARI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "That is a fair description.", "name": "\u00d3SKAR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "Seven hundred and twelve.", "name": "SIGR\u00daN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "dialogue", "text": "Okay, we heard you.", "name": "BJARNI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "Seven hundred and twelve is the number Mom said the developer wants.", "name": "SIGR\u00daN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "Sigr\u00fan.", "name": "ELINBORG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "dialogue", "text": "Seven hundred and twelve thousand. That's what they offered. I read it.", "name": "SIGR\u00daN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "dialogue", "text": "You read my folder.", "name": "ELINBORG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "dialogue", "text": "It was open.", "name": "SIGR\u00daN", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "dialogue", "text": "She counts well, this one.", "name": "\u00d3SKAR", "speaker": 4, "ext": [], "paren": ["a thin smile"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "dialogue", "text": "Pabbi. I'm not trying to take it from you.", "name": "ELINBORG", "speaker": 1, "ext": [], "paren": ["softer"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "dialogue", "text": "You are a little bit.", "name": "\u00d3SKAR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "dialogue", "text": "A little bit.", "name": "ELINBORG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "dialogue", "text": "It's all right. Everyone takes a little.", "name": "\u00d3SKAR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "action", "text": "He sets the net down.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "action", "text": "Stands.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "action", "text": "Walks to the nearest rack.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "action", "text": "Reaches up and lifts a fish from its string.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "action", "text": "Holds it out to Kari.", "para": 9, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "dialogue", "text": "Smell it.", "name": "\u00d3SKAR", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 75, "kind": "action", "text": "Kari does.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 76, "kind": "action", "text": "Closes his eyes.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 77, "kind": "dialogue", "text": "Yeah.", "name": "KARI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 78, "kind": "dialogue", "text": "Now tell me what it's worth.", "name": "\u00d3SKAR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 79, "kind": "dialogue", "text": "I don't know.", "name": "KARI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 80, "kind": "dialogue", "text": "Neither do I. That's the problem.", "name": "\u00d3SKAR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 81, "kind": "action", "text": "Elinborg laughs.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 82, "kind": "action", "text": "Wipes her eyes with the back of her glove.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 83, "kind": "action", "text": "Bjarni pours coffee into the thermos lid and hands it to his sister without a word.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 84, "kind": "action", "text": "She takes it.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 85, "kind": "action", "text": "Sigr\u00fan goes back to counting.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}