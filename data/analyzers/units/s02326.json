{"scene_id": "s02326", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02326.fountain", "heading": "INT. TELEGRAPH OFFICE - LOCUST SEASON - DAY", "cast": [{"id": 0, "name": "MARSHAL TOBIAS GREER", "names": ["MARSHAL TOBIAS GREER", "GREER"], "gender": "?", "first": 5, "spoke": 9}, {"id": 1, "name": "ODALYS", "names": ["ODALYS"], "gender": "f", "first": 6, "spoke": 2}, {"id": 2, "name": "COAL BRANNIGAN", "names": ["COAL BRANNIGAN", "COAL"], "gender": "?", "first": 9, "spoke": 5}, {"id": 3, "name": "SILAS PRUETT", "names": ["SILAS PRUETT", "SILAS"], "gender": "m", "first": 10, "spoke": 2}, {"id": 4, "name": "DESMOND YEBOAH", "names": ["DESMOND YEBOAH", "DESMOND"], "gender": "?", "first": 11, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. TELEGRAPH OFFICE - LOCUST SEASON - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Shuttered windows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A hum like a saw mill outside.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dust sifts through cracks.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single lamp.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MARSHAL TOBIAS GREER, 40s, sweat-stained duster, wedges a rolled blanket under the door.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "ODALYS, 30s, telegraph operator, taps a key.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Nothing comes back.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Three drovers sit on crates.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "COAL BRANNIGAN, big, bearded.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "SILAS PRUETT, old, hat in his lap.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "DESMOND YEBOAH, 20s, jittery, boots too clean.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Something skitters across the roof.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Nobody opens that door.", "name": "GREER", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Wasn't planning to.", "name": "COAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Keep the lamp low.", "name": "GREER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Line's dead. Cut somewhere east.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": ["to Greer"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Try Kearney.", "name": "GREER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "I did.", "name": "ODALYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Try again.", "name": "GREER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "She does.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "The key clicks, hollow.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Forty years. Never seen it this thick.", "name": "SILAS", "speaker": 3, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "What'd he say?", "name": "DESMOND", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "He's talking to himself.", "name": "COAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Is that a thing he does?", "name": "DESMOND", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Since his wife passed.", "name": "COAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Greer turns on them.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Quiet. All of you.", "name": "GREER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "A thud on the door.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Then another.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Something heavier.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Not an insect.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Everyone freezes.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Odalys lifts her hand from the key.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Not now.", "name": "GREER", "speaker": 0, "ext": ["CONT'D"], "paren": ["low, to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "He draws his revolver.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Checks the cylinder.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Marshal.", "name": "COAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Stay put.", "name": "GREER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "You think it's him?", "name": "COAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "I think it's someone who ought to be inside.", "name": "GREER", "speaker": 0, "ext": [], "paren": ["to Coal"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Desmond stands.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Sits.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Stands.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Do we open it or not?", "name": "DESMOND", "speaker": 4, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "They'll eat the leather first.", "name": "SILAS", "speaker": 3, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "The thud again.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "A voice, muffled, human, through the wood.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Odalys lunges for the lamp.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Greer grabs the blanket from the door.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "Back wall. Now.", "name": "GREER", "speaker": 0, "ext": [], "paren": ["to Coal, Silas, Desmond"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "They move.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Guns come out.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "The doorknob begins to turn.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4]}]}