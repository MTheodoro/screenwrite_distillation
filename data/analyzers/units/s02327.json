false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She stops chewing.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Sir.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "He took a municipal bus. In pajamas. Drove it to Tulsa.", "name": "HUGO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Marisol, is that the sleepwalker?", "name": "DOUG", "speaker": 2, "ext": ["O.S."], "paren": ["over the speaker, scratchy"], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Doug, you're on the intercom again.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Tell him it's two thousand.", "name": "DOUG", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Two thousand?", "name": "HUGO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "He said that on purpose.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I did.", "name": "DOUG", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Hugo pulls out a fistful of crumpled bills.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Counts.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Frowns.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Looks up.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "I have eleven hundred.", "name": "HUGO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Leave your watch.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "It's my father's watch.", "name": "HUGO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Then leave your car.", "name": "DOUG", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Then how do I take him home?", "name": "HUGO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "A long beat.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Marisol sets the mug down.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Presses the tube button.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "A canister whooshes toward Hugo's window.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Sign the form.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}