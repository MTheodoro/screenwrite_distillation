{"scene_id": "s02328", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02328.fountain", "heading": "INT. BELL FOUNDRY - CASTING FLOOR - NIGHT", "cast": [{"id": 0, "name": "SABINE MOREAU-KIM", "names": ["SABINE MOREAU-KIM", "MOREAU-KIM"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "ORLANDO PEEL", "names": ["ORLANDO PEEL", "PEEL"], "gender": "m", "first": 6, "spoke": 4}, {"id": 2, "name": "THEODORA VASS", "names": ["THEODORA VASS", "VASS"], "gender": "?", "first": 7, "spoke": 3}, {"id": 3, "name": "LIAM", "names": ["LIAM"], "gender": "?", "first": 8, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. BELL FOUNDRY - CASTING FLOOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cold furnaces.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sand molds in rows like sleeping beasts.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A crack in the skylight lets in one blade of moon.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DET. SABINE MOREAU-KIM, 40s, camel coat, kneels at an empty cradle where a bronze bell should hang.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She runs a thumb along the chain mark.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "ORLANDO PEEL, 60s, the foreman, stands with his arms crossed over a leather apron.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "THEODORA VASS, 30s, in a clean white shirt, watches him from the doorway.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "LIAM, 17, the apprentice, sits on an upturned bucket and doesn't look at anyone.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Four tons. Gone.", "name": "MOREAU-KIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "I told you. I locked up at ten.", "name": "PEEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "He always says ten.", "name": "VASS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "It was ten.", "name": "LIAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "It was ten.", "name": "PEEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Who has keys?", "name": "MOREAU-KIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Me.", "name": "PEEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Me.", "name": "VASS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Me.", "name": "LIAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "They answer nearly at once.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "The detective stands.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Brushes sand from her knee.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "You gave yours back.", "name": "PEEL", "speaker": 1, "ext": [], "paren": ["to Liam"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "No.", "name": "LIAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "You gave it to me.", "name": "VASS", "speaker": 2, "ext": [], "paren": ["over him"], "dual": true, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Which is it?", "name": "MOREAU-KIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "The kid studies his boots.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Peel's jaw tightens.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Vass crosses to the cradle, touches the chain, and for a second her hand shakes.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Thank you, Ms. Vass. That's all I needed.", "name": "MOREAU-KIM", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}