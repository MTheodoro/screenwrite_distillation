{"scene_id": "s02329", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02329.fountain", "heading": "INT. CAROUSEL PAVILION - DEPOSITION - DAY", "cast": [{"id": 0, "name": "ISADORA FENWICK-ADEYEMI", "names": ["ISADORA FENWICK-ADEYEMI", "ISADORA"], "gender": "f", "first": 4, "spoke": 18}, {"id": 1, "name": "HAROLD BENNIGAN", "names": ["HAROLD BENNIGAN", "HAROLD"], "gender": "?", "first": 6, "spoke": 14}, {"id": 2, "name": "MEI-LING", "names": ["MEI-LING"], "gender": "f", "first": 9, "spoke": 0}, {"id": 3, "name": "RAFAEL SOLORZANO", "names": ["RAFAEL SOLORZANO", "RAFAEL"], "gender": "m", "first": 11, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. CAROUSEL PAVILION - DEPOSITION - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A shuttered amusement park, midwinter.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Painted horses frozen mid-gallop circle a conference table dragged onto the platform.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dust floats in the cold light from the high windows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ISADORA FENWICK-ADEYEMI, 50s, sits upright at the head of the table, a legal pad squared before her.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She has not yet touched her pen.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "HAROLD BENNIGAN, 70, the witness, sits opposite in a camel overcoat that smells of cedar.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "His hands rest on a cane.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He studies the brass pole beside him as if it might speak.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "MEI-LING, 20s, the court reporter, bends over her steno machine in the corner.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Her fingers wait.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "RAFAEL SOLORZANO, 40s, opposing counsel, lounges in a chair three seats down.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "His tie is loosened.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "He has the air of a man who has lost nothing yet.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Mr. Bennigan, you operated this carousel for how many years?", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Thirty-one.", "name": "HAROLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "And in that time how many children rode it?", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "I don't know. Thousands.", "name": "HAROLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Tens of thousands, by the park's own ledger.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "If you say so.", "name": "HAROLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Objection. She's testifying.", "name": "RAFAEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "I'm reading from Exhibit Four.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Which my client hasn't seen.", "name": "RAFAEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "He signed the page.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Harold shifts.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "The cane taps the platform.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "A horse above him seems to lean closer.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "On the tenth of August, a brake pin sheared. A girl was thrown. Do you remember that?", "name": "ISADORA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "I remember.", "name": "HAROLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Was the pin inspected that morning?", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "It was.", "name": "HAROLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "By whom?", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "By me.", "name": "HAROLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Was it replaced?", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "It was not.", "name": "HAROLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Why not?", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Because the part was on order.", "name": "HAROLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "For how long?", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Six weeks.", "name": "HAROLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "And you ran the carousel anyway.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Objection.", "name": "RAFAEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "He said it was on order. I'm asking if he ran it.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "I ran it.", "name": "HAROLD", "speaker": 1, "ext": [], "paren": ["very quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Because the owner told you to.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Because that was the job.", "name": "HAROLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Was that the owner's instruction?", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Yes.", "name": "HAROLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Harold, don't.", "name": "RAFAEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Counsel, you may instruct the witness not to answer. You may not coach him.", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Rafael rises half out of his chair and sits down again.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Mei-Ling's fingers fly.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Mr. Bennigan, did the owner put that instruction in writing?", "name": "ISADORA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "I kept the note.", "name": "HAROLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Where is it?", "name": "ISADORA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "In my coat.", "name": "HAROLD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "A silence.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Rafael stares at the old man's pocket as if it might ignite.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Harold reaches in.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "Draws out a folded yellow paper.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "Lays it on the table.", "para": 7, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "It sits there, pale, over the scarred wood.", "para": 7, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "Isadora does not reach for it.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "She waits until Rafael does.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}]}