{"scene_id": "s02330", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02330.fountain", "heading": "INT. GRAIN SILO - CERES MINING COLONY - NIGHT CYCLE", "cast": [{"id": 0, "name": "COMMANDER ABEL TRASK", "names": ["COMMANDER ABEL TRASK", "TRASK"], "gender": "m", "first": 4, "spoke": 9}, {"id": 1, "name": "MOSES KWAME", "names": ["MOSES KWAME", "KWAME"], "gender": "m", "first": 7, "spoke": 9}, {"id": 2, "name": "CORE STORAGE", "names": ["CORE STORAGE"], "gender": "?", "first": 17, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRAIN SILO - CERES MINING COLONY - NIGHT CYCLE", "present": []}, {"u": 1, "kind": "action", "text": "A vertical steel cylinder, dim and echoing.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Frost on the catwalks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The grain gauge reads EMPTY in red.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "COMMANDER ABEL TRASK, 50s, in a patched thermal jacket, climbs the ladder to the upper platform.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "His breath fogs.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "His hand finds a rusted rail.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "MOSES KWAME, 30s, the colony engineer, waits at the top with a lantern and a datapad.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He hasn't slept.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "You sent for me.", "name": "TRASK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I sent for the Commander. Not the man who made the ration cuts.", "name": "KWAME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "There is no difference.", "name": "TRASK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "There was yesterday.", "name": "KWAME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Trask steps onto the platform.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "The grating hums under his boots.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Show me.", "name": "TRASK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Kwame lifts the lantern.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Across the platform, a hatch stands open, stamped CORE STORAGE - SEALED.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Inside, rows of crates.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Full.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Stacked to the ceiling.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Trask stares.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "His face doesn't change.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "He does not look at Kwame.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Four hundred tons. Forty days of food. Sealed since the council declared the shortage.", "name": "KWAME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Who else knows?", "name": "TRASK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Nobody.", "name": "KWAME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Then keep it that way.", "name": "TRASK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Kwame lowers the lantern.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "He steps between Trask and the hatch.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "You knew.", "name": "KWAME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "I signed the seal.", "name": "TRASK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "People have been rationing since spring.", "name": "KWAME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "People have been alive since spring.", "name": "TRASK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "My daughter has stopped growing.", "name": "KWAME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Trask finally looks at him.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "He is not the first to say that to me.", "name": "TRASK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Kwame's hand tightens on the datapad.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "He raises it as if to throw.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Trask doesn't flinch.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Doesn't move.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Open it. Tonight.", "name": "KWAME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "And in forty days?", "name": "TRASK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "We'll have forty days.", "name": "KWAME", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Trask takes a slow breath.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Reaches for the keypad.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Kwame watches his hand.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Trask enters a code.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "The lock chunks open.", "para": 9, "sent": 4, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "He shoves the door wide.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "A cold wind of old grain sweeps over them.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Kwame stumbles.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Trask catches his arm.", "para": 10, "sent": 3, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "For a moment, he holds on.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Then he lets go, and he doesn't look back.", "para": 11, "sent": 1, "present": [0, 1, 2]}]}