{"scene_id": "s02331", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02331.fountain", "heading": "INT. BAKERY - PREDAWN", "cast": [{"id": 0, "name": "PILAR", "names": ["PILAR"], "gender": "?", "first": 5, "spoke": 7}, {"id": 1, "name": "JONAH", "names": ["JONAH"], "gender": "?", "first": 7, "spoke": 6}, {"id": 2, "name": "DELACROIX-WU", "names": ["DELACROIX-WU", "MR. DELACROIX-WU"], "gender": "?", "first": 32, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. BAKERY - PREDAWN", "present": []}, {"u": 1, "kind": "action", "text": "A narrow shop.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Racks of proofing dough under cloth.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A radio plays low, in Portuguese.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Flour in the air like smoke.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "PILAR, 30s, scores loaves with a razor in fast, even strokes.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Apron, forearms white to the elbow.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "JONAH, 30s, the delivery driver, leans on the counter with a crate under one arm, and has been leaning there too long.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You're early.", "name": "PILAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "You're late.", "name": "JONAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I've been here since two.", "name": "PILAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "That's what I mean.", "name": "JONAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She doesn't smile.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She slides a tray into the oven, closes the door with her hip, and wipes her hands on her apron, and he pretends to read the crate label while she does.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "You bring the rye flour?", "name": "PILAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Forty pounds. And the thing you asked for.", "name": "JONAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He reaches into his jacket and pulls out a small paper bag, slightly crushed.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She takes it, opens it, looks inside.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "A single cherry.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "One?", "name": "PILAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "They only had one.", "name": "JONAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "It's July.", "name": "PILAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "That's when they stop having them.", "name": "JONAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She sets the cherry on the cutting board and looks at it as if it were a coin from a country she has never visited.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Jonah sets down the crate.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Steps closer.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "She doesn't step away.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "You shouldn't.", "name": "PILAR", "speaker": 0, "ext": ["CONT'D"], "paren": ["together"], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "I wanted to.", "name": "JONAH", "speaker": 1, "ext": [], "paren": ["together"], "dual": true, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "They both laugh, quietly.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "The radio fills the gap.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "The back door opens.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "MR. DELACROIX-WU, 70, her landlord, in a tweed cap and a rain-spotted coat, steps in stamping his shoes.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "He takes in the two of them, the cherry, the flour.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Pilar. The roof.", "name": "MR. DELACROIX-WU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "What about the roof?", "name": "PILAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "It leaks onto the dough.", "name": "MR. DELACROIX-WU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Pilar and Jonah look at the ceiling together.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "A drop forms.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Falls.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Lands on a loaf with a soft plop.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Nobody moves for a moment.", "para": 9, "sent": 4, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Jonah picks up the cherry and sets it gently on the damp loaf, like a crown.", "para": 9, "sent": 5, "present": [0, 1, 2]}]}