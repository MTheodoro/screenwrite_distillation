{"scene_id": "s02332", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02332.fountain", "heading": "INT. RUINED OPERA HOUSE - FIELD HOSPITAL - NIGHT", "cast": [{"id": 0, "name": "SISTER AGNIESZKA", "names": ["SISTER AGNIESZKA", "AGNIESZKA"], "gender": "?", "first": 5, "spoke": 8}, {"id": 1, "name": "SERGEANT HOLLIS BRANTLEY", "names": ["SERGEANT HOLLIS BRANTLEY", "BRANTLEY"], "gender": "?", "first": 8, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. RUINED OPERA HOUSE - FIELD HOSPITAL - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "The stage is a ward.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cots under gilded boxes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Candles in wine bottles.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Above, a painted ceiling of cherubs, half of it fallen onto the stalls.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SISTER AGNIESZKA, 30s, moves between the cots with a basin and a rag.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her habit is gray with dust.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She stops at the last bed.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "SERGEANT HOLLIS BRANTLEY, 20s, lies on the final cot.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "His left arm is bandaged to the shoulder.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He has been awake for hours.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She sets the basin down.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He watches her wring the rag.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Is it quiet out there?", "name": "BRANTLEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "It has been since midnight.", "name": "AGNIESZKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "He nods.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She presses the cloth to his forehead, and he flinches, then lets her.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "You have a kind hand, Sister.", "name": "BRANTLEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "I have a tired hand.", "name": "AGNIESZKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She smiles slightly.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "He almost does.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "The candle flames lean in a draft and straighten.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "I haven't heard a bomb in four hours.", "name": "BRANTLEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Don't say it aloud.", "name": "AGNIESZKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Why?", "name": "BRANTLEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Because the building listens.", "name": "AGNIESZKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "He laughs, then winces.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "She adjusts the blanket.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Her fingers brush the dog tags at his throat.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "She holds them a moment, turned to the candle.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Her face does not change.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Her hand does not move.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Brantley.", "name": "AGNIESZKA", "speaker": 0, "ext": ["CONT'D"], "paren": ["quietly"], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Yes?", "name": "BRANTLEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "That is an English name.", "name": "AGNIESZKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "It's my name.", "name": "BRANTLEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "She lets go of the tags.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Straightens.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Takes up the basin.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "I will bring you water.", "name": "AGNIESZKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Sister, I'm in the right ward, aren't I?", "name": "BRANTLEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "She stops.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "She does not turn.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "It is the only ward there is.", "name": "AGNIESZKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "She walks away, careful not to hurry.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "At the proscenium she sets down the basin, steps behind the curtain, and presses her back to the wall.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Her hand goes inside her habit.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "It comes out holding a pistol.", "para": 11, "sent": 1, "present": [0, 1]}]}