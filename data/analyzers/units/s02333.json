{"scene_id": "s02333", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02333.fountain", "heading": "INT. AGING CAVE - ALPINE CHEESE VAULT - NIGHT", "cast": [{"id": 0, "name": "VESNA", "names": ["VESNA"], "gender": "f", "first": 5, "spoke": 6}, {"id": 1, "name": "DMITRI", "names": ["DMITRI"], "gender": "m", "first": 8, "spoke": 5}, {"id": 2, "name": "KOFI", "names": ["KOFI"], "gender": "?", "first": 14, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. AGING CAVE - ALPINE CHEESE VAULT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Stone walls, sweating.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wheels of cheese stacked to the vaulted ceiling, wooden shelves groaning.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Humidity gauge on a post.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Temperature: 11 C.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "VESNA, 30s, in a hairnet and black coverall, drops from a ventilation shaft onto a shelf.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Lands soft.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Gloved hands to the stone.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "DMITRI, 40s, big for a safecracker, follows.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "His shoe slips on a wheel.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "It rolls.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He catches it against his chest and holds very still.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "You are a disaster.", "name": "VESNA", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "It's slippery.", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Talk to me. Where are you?", "name": "KOFI", "speaker": 2, "ext": ["V.O."], "paren": ["over earpiece, crackling"], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Inside. Cave three.", "name": "VESNA", "speaker": 0, "ext": [], "paren": ["touching her ear"], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Camera sweep in forty seconds. Left aisle. Don't breathe.", "name": "KOFI", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Vesna waves Dmitri forward.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "They creep along the wall.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "At the far end stands a steel cabinet with a keypad.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Dmitri sets down the cheese, wipes his hands, and presses his ear to the door as if listening to a heartbeat.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Vesna scans the ceiling for the camera, counting on her fingers.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Twenty seconds.", "name": "KOFI", "speaker": 2, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Is nineteen digits.", "name": "DMITRI", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "It's always nineteen digits.", "name": "VESNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Ten.", "name": "KOFI", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The camera swings toward them.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Dmitri throws himself between two stacks of cheese.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Vesna dives behind a ladder.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "The lens sweeps the aisle, pauses, moves on.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Vesna exhales.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Dmitri's arm trembles from holding the wheel above him.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Can I put it down?", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "No.", "name": "VESNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Alarm's armed. You have ninety seconds before the guard rotates.", "name": "KOFI", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Dmitri finally sets the cheese on the shelf.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Cracks his knuckles.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Starts the code.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "The keypad chirps, red, red, green.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "He glances at Vesna.", "para": 6, "sent": 4, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "She glances back.", "para": 6, "sent": 5, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Behind them, soft footsteps echo in the passage.", "para": 6, "sent": 6, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Vesna's eyes go wide.", "para": 6, "sent": 7, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "That's not the guard.", "name": "VESNA", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Say again?", "name": "KOFI", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "The cabinet clicks open.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Inside, a single wheel of cheese, wrapped in gold foil.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "That's it?", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "That's forty thousand euros of cheese.", "name": "VESNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "It's a little small.", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Footsteps closer.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Vesna grabs the wheel.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Dmitri grabs her sleeve.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "They bolt for the shaft.", "para": 8, "sent": 3, "present": [0, 1, 2]}]}