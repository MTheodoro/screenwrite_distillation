{"scene_id": "s02334", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02334.fountain", "heading": "EXT. SKY-WHALE MARKET - FLOATING DECK - DAWN", "cast": [{"id": 0, "name": "MIMSY", "names": ["MIMSY"], "gender": "?", "first": 4, "spoke": 12}, {"id": 1, "name": "ASHGROVE", "names": ["ASHGROVE"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "GID", "names": ["GID"], "gender": "?", "first": 6, "spoke": 10}, {"id": 3, "name": "THORNE", "names": ["THORNE"], "gender": "?", "first": 6, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SKY-WHALE MARKET - FLOATING DECK - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A vast whale drifts through pink clouds, its back lashed with rope bridges and canvas stalls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Lanterns burn in the morning.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Merchants shout in the distance.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MIRABEL \"MIMSY\" ASHGROVE, 20s, a thief in a patchwork cloak, crouches on a spice barrel.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "A copper compass spins in her fist.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "GIDEON \"GID\" THORNE, 30s, in the livery of the Harbor Guard, climbs the barrel stack behind her.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "His boots slap the planks.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Mimsy. Don't.", "name": "GID", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Gid.", "name": "MIMSY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Put it down.", "name": "GID", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "It was mine first.", "name": "MIMSY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "It belonged to the Admiral.", "name": "GID", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "The Admiral is dead.", "name": "MIMSY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "That doesn't make it yours.", "name": "GID", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Mimsy tosses the compass from hand to hand.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "He winces at each toss.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Steady, girl. Steady.", "name": "MIMSY", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Who are you talking to?", "name": "GID", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Nobody.", "name": "MIMSY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "She stands on the barrel.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Spreads her arms to the whole market below.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "The merchants glance up.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Good people of the Whale! This man would take my inheritance!", "name": "MIMSY", "speaker": 0, "ext": ["CONT'D"], "paren": ["loudly, to the crowd"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "A murmur.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "A woman drops a basket of figs.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "A boy points.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Nothing of the sort! Return to your stalls!", "name": "GID", "speaker": 2, "ext": [], "paren": ["to the crowd"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "He's a liar!", "name": "MIMSY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "She's a thief!", "name": "GID", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Both can be true.", "name": "MIMSY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Gid lunges.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Mimsy leaps.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "They collide midair and crash through the canvas roof of the fruit stall, tumbling in a heap of melons and rope.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Both lie flat for a second.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Then both scramble upright, glaring, each with one hand on the compass.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Let go, Mimsy.", "name": "GID", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "You first, Gid.", "name": "MIMSY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "They pull.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "The compass spins.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "The needle jerks west, then stops, pointing straight down at the clouds beneath the whale.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Both freeze.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "They look at the needle.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Then at each other.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Oh.", "name": "MIMSY", "speaker": 0, "ext": ["CONT'D"], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "It's pointing at the sea.", "name": "GID", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "It's pointing at something under the sea.", "name": "MIMSY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "The whale rumbles, a long, deep note that shakes the stalls.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "The lanterns sway.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "The merchants scatter, tipping carts.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Run?", "name": "GID", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Run.", "name": "MIMSY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "They pull the compass between them like a rope and sprint for the bow.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}]}