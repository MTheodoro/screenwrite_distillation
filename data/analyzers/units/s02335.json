{"scene_id": "s02335", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02335.fountain", "heading": "INT. BOWLING ALLEY - LANE 9 - NIGHT", "cast": [{"id": 0, "name": "HAPPY BIRTHDAY NOOR", "names": ["HAPPY BIRTHDAY NOOR", "NOOR"], "gender": "f", "first": 3, "spoke": 4}, {"id": 1, "name": "WESLEY", "names": ["WESLEY"], "gender": "?", "first": 7, "spoke": 3}, {"id": 2, "name": "BEANS", "names": ["BEANS"], "gender": "?", "first": 8, "spoke": 2}, {"id": 3, "name": "PRISCILLA", "names": ["PRISCILLA"], "gender": "f", "first": 9, "spoke": 1}, {"id": 4, "name": "NOOR'S MOTHER", "names": ["NOOR'S MOTHER"], "gender": "?", "first": 12, "spoke": 0}, {"id": 5, "name": "HAKIMI", "names": ["HAKIMI"], "gender": "?", "first": 12, "spoke": 0}, {"id": 6, "name": "RUDY", "names": ["RUDY"], "gender": "?", "first": 14, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. BOWLING ALLEY - LANE 9 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Neon pins on the wall.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Carpet printed with comets.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The scoring monitor above lane 9 reads HAPPY BIRTHDAY NOOR in rainbow letters.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "Balls clatter down the lanes in the dim.", "para": 0, "sent": 3, "present": [0]}, {"u": 5, "kind": "action", "text": "NOOR, 15, sits in a plastic chair with a paper crown tilted on her head.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She holds a slice of cake like a plate she's not sure she's allowed to eat from.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "WESLEY, 15, flips through the score sheet with studied boredom.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "BEANS, 14, bites a straw flat.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "PRISCILLA, 16, texts under the table, glancing up at the door every few seconds.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Nobody speaks.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "A ball thunders down the next lane, and all four of them watch it.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "NOOR'S MOTHER, MRS. HAKIMI, 40s, in a work blazer, stands at the shoe counter signing a receipt.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "She doesn't look at the kids.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "action", "text": "Behind the counter, RUDY, 60s, spritzes a pair of size sevens with disinfectant.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "action", "text": "He watches Noor the way a man watches weather.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "You're up, Noor.", "name": "WESLEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "I know.", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "It's your birthday. You go first.", "name": "WESLEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "I said I know.", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "action", "text": "She doesn't move.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "action", "text": "She sets the cake on her knee.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "action", "text": "Priscilla's phone buzzes, and she slides it into her sleeve.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "dialogue", "text": "Is she going to throw it or what?", "name": "BEANS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "Who?", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "Anyone.", "name": "BEANS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "She's not coming.", "name": "PRISCILLA", "speaker": 3, "ext": [], "paren": ["under her breath"], "dual": true, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "Who's not coming?", "name": "NOOR", "speaker": 0, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "Nobody. Throw the ball.", "name": "WESLEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "Noor rises.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "Takes a ten-pound ball from the rack.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "She holds it with both hands, studies the pins.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "action", "text": "Down the lane, the machine resets.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "At the counter, Mrs. Hakimi turns.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "action", "text": "For a moment her eyes meet her daughter's.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "action", "text": "She lifts one hand in a half wave, then returns to the receipt.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "Noor raises the ball.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "Draws back.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "Lets it go.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "It rolls hard and straight into the gutter.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "The monitor chirps: GUTTER.", "para": 9, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "action", "text": "No one says a word.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "Rudy sets down the disinfectant and presses the button that raises the bumpers.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "Noor stays at the line.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "Her paper crown has slipped over one eye.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "action", "text": "She does not fix it.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}]}