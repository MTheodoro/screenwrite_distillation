{"scene_id": "s02336", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02336.fountain", "heading": "INT. FLORESCENT BREAK ROOM - MERIDIAN SYNERGY CORP - DAY", "cast": [{"id": 0, "name": "YOUNG WOMAN", "names": ["YOUNG WOMAN"], "gender": "?", "first": 3, "spoke": 1}, {"id": 1, "name": "VOLKOV", "names": ["VOLKOV", "MS. VOLKOV"], "gender": "?", "first": 5, "spoke": 8}, {"id": 2, "name": "CASSANDRA", "names": ["CASSANDRA"], "gender": "?", "first": 7, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. FLORESCENT BREAK ROOM - MERIDIAN SYNERGY CORP - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A microwave beeps.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A motivational poster reads TEAMWORK in a font that has given up.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A YOUNG WOMAN in a lanyard stands before the coffee machine, holding two empty pods and one full one.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "She has the posture of someone who has been told not to touch anything.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "action", "text": "MS. VOLKOV, 50s, regional director, enters in a pencil skirt and a visible air of purpose.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "You're the intern.", "name": "MS. VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Yes. Cassandra.", "name": "YOUNG WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Cassandra. You've been here three weeks and I haven't seen you do one thing.", "name": "MS. VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "I've been doing the thing you asked.", "name": "CASSANDRA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "What thing?", "name": "MS. VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Shadowing you.", "name": "CASSANDRA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Ms. Volkov considers this.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She takes the pod from Cassandra, studies it, and drops it in the trash.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Then she should have noticed I don't drink this brand.", "name": "MS. VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "She did.", "name": "CASSANDRA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Who?", "name": "MS. VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Me. I noticed. I just didn't know she was allowed to say it.", "name": "CASSANDRA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "They look at each other.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "The microwave beeps again.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "You're promoted.", "name": "MS. VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "I'm what?", "name": "CASSANDRA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "To associate. Effective now. She who notices things should be in the meetings.", "name": "MS. VOLKOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Wait. Who is \"she\"?", "name": "CASSANDRA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Whoever's holding the pod.", "name": "MS. VOLKOV", "speaker": 1, "ext": [], "paren": ["already leaving"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "She exits.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Cassandra looks down at the pod.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Looks at the poster.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Quietly, she sets the pod on the counter and walks out after her.", "para": 5, "sent": 3, "present": [0, 1, 2]}]}