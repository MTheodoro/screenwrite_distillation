{"scene_id": "s02338", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02338.fountain", "heading": "INT. PET CEMETERY - GIFT SHOP - DAY", "cast": [{"id": 0, "name": "FENELLA ABERNATHY", "names": ["FENELLA ABERNATHY", "FENELLA"], "gender": "f", "first": 5, "spoke": 14}, {"id": 1, "name": "TOBY QUINN", "names": ["TOBY QUINN", "TOBY"], "gender": "m", "first": 7, "spoke": 7}, {"id": 2, "name": "TRACKSUIT MAN", "names": ["MAN", "TRACKSUIT MAN"], "gender": "?", "first": 9, "spoke": 13}, {"id": 3, "name": "TRACKSUIT", "names": ["TRACKSUIT"], "gender": "?", "first": 9, "spoke": 0}, {"id": 4, "name": "PRUITT", "names": ["PRUITT"], "gender": "?", "first": 25, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. PET CEMETERY - GIFT SHOP - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A cramped shop inside a converted barn.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Shelves of tiny urns, plush angel wings, paw-print stepping stones.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cash register shaped like a bone.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Soft harp music drifts from a speaker.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "FENELLA ABERNATHY, 50s, in a lavender smock, arranges a display of memorial candles.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She hums with the harp.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Behind the counter, TOBY QUINN, 20s, scrolls on his phone, a name tag reading TOBY (ASK ME ABOUT GRIEF).", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "The door jingles.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "A MAN IN A TRACKSUIT, 40s, sunglasses on indoors, steps in carrying a shoebox.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Hi. I'd like to bury a hamster.", "name": "TRACKSUIT MAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Oh. I'm so sorry for your loss.", "name": "FENELLA", "speaker": 0, "ext": [], "paren": ["warmly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "It's not a loss. It's a business decision.", "name": "TRACKSUIT MAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Fenella tilts her head.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Toby sets his phone down.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "What kind of hamster?", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "The kind that owes me money.", "name": "TRACKSUIT MAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "The harp plays on.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Plots start at three hundred dollars. For rodents, two hundred.", "name": "FENELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Does that include a marker?", "name": "TRACKSUIT MAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Marker is extra.", "name": "FENELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "What does it say?", "name": "TRACKSUIT MAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Whatever you want. \"Beloved companion.\" \"In loving memory.\"", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Can it say \"Dead\"?", "name": "TRACKSUIT MAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "We would have to run that by Mr. Pruitt.", "name": "FENELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "A phone on the wall rings.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Fenella answers it.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Rosewood Rest, this is Fenella.", "name": "FENELLA", "speaker": 0, "ext": ["CONT'D"], "paren": ["into phone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Fenella, it's Pruitt. Is someone trying to bury a hamster?", "name": "PRUITT", "speaker": 4, "ext": ["O.S."], "paren": ["over the phone, a gravelly voice"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "How did you know?", "name": "FENELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "It's the third this week.", "name": "PRUITT", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Are you quite sure it's a hamster?", "name": "FENELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "I have never been sure.", "name": "PRUITT", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Fenella covers the mouthpiece.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Whispers to Toby.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Mr. Pruitt says it's the third.", "name": "FENELLA", "speaker": 0, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Of what?", "name": "TOBY", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Of the week.", "name": "FENELLA", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "The Tracksuit Man shifts the shoebox from one arm to the other.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "It makes a small rattle.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Is there a problem?", "name": "TRACKSUIT MAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "No problem, sir. Fenella, the phone.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Mr. Pruitt, I'll call you back.", "name": "FENELLA", "speaker": 0, "ext": [], "paren": ["into phone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "She hangs up.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Do you take cash?", "name": "TRACKSUIT MAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "We take cash.", "name": "FENELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "We take cash.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Good. Because I'd like to pay in advance. For all of them.", "name": "TRACKSUIT MAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "He sets the shoebox on the counter.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Opens the lid a crack.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Fenella peeks inside.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Her smile freezes.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Toby leans in.", "para": 10, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "That's not a hamster.", "name": "TOBY", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "I told you. Business decision.", "name": "TRACKSUIT MAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Toby. Lock the door.", "name": "FENELLA", "speaker": 0, "ext": [], "paren": ["very calmly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "Toby locks the door.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "The harp plays on.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "Now. Tell me about your grief counseling.", "name": "TRACKSUIT MAN", "speaker": 2, "ext": [], "paren": ["removing his sunglasses"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "Fenella and Toby exchange a long look.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "Is everything all right in there?", "name": "PRUITT", "speaker": 4, "ext": ["O.S."], "paren": ["through the wall speaker, faint"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "dialogue", "text": "Perfectly fine, Mr. Pruitt!", "name": "FENELLA", "speaker": 0, "ext": [], "paren": ["brightly, to the speaker"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "dialogue", "text": "Sir, would you like a candle?", "name": "TOBY", "speaker": 1, "ext": [], "paren": ["to the Tracksuit Man"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "The man picks one up.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "Smells it.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "dialogue", "text": "Does this one come in lavender?", "name": "TRACKSUIT MAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "dialogue", "text": "It comes in lavender.", "name": "FENELLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "dialogue", "text": "Then I'll take it.", "name": "TRACKSUIT MAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "He sets down a wad of bills.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "action", "text": "Fenella counts them with trembling fingers.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "action", "text": "Toby stares at the box.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "action", "text": "The harp swells.", "para": 14, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "action", "text": "Slowly, Fenella slides the box off the counter and into a drawer, and shuts it as if closing a secret.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4]}]}