{"scene_id": "s02339", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02339.fountain", "heading": "EXT. RIVER OF ASH - FERRY LANDING - DUSK", "cast": [{"id": 0, "name": "FERRYWOMAN", "names": ["FERRYWOMAN"], "gender": "?", "first": 5, "spoke": 6}, {"id": 1, "name": "LANTERN VOICE", "names": ["VOICE", "LANTERN VOICE"], "gender": "?", "first": 8, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. RIVER OF ASH - FERRY LANDING - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "Gray water.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "No current, no wind.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A rickety dock lit by a single lantern.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Beyond it, a flat ferry with a rope-pulled mast.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "THE FERRYWOMAN, 60s, in a cloak the color of dust, stands at the stern with a long pole.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She doesn't speak.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She counts the figures lined up on the dock: shadows with hats, hands, the vague outline of people.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "A VOICE, deep, ancient, from the lantern, as if the flame were a mouth.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "How many tonight?", "name": "LANTERN VOICE", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She holds up four fingers, then one more.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Five. That's all?", "name": "LANTERN VOICE", "speaker": 1, "ext": ["O.S.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She nods.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Raises her pole.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Plants it in the water.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She turns to the shadows.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Step aboard. One at a time. No pushing.", "name": "FERRYWOMAN", "speaker": 0, "ext": [], "paren": ["to the whole line"], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She waits.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "They shuffle forward.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "One shadow stops at the rail.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She leans toward it.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "You owe me a coin.", "name": "FERRYWOMAN", "speaker": 0, "ext": ["CONT'D"], "paren": ["to that shadow"], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "The shadow doesn't move.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She sighs.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Pulls a coin from her cloak and drops it in the water.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Third time this month. Nobody carries their own coin anymore.", "name": "FERRYWOMAN", "speaker": 0, "ext": ["CONT'D"], "paren": ["muttering"], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "I heard that.", "name": "LANTERN VOICE", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "You were meant to.", "name": "FERRYWOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "She pushes off.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "The ferry drifts.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "The lantern recedes behind them.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Gradually, quietly, it dims, and the voice goes with it.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Don't be late.", "name": "LANTERN VOICE", "speaker": 1, "ext": ["O.S.", "CONT'D"], "paren": ["faint"], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "I am never late.", "name": "FERRYWOMAN", "speaker": 0, "ext": [], "paren": ["to the dark, flat"], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "A spark flies off the pole.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "For a heartbeat she is lit from below, and her face is young.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Then it is gone.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Hold on. It gets colder.", "name": "FERRYWOMAN", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the shadows, softly"], "dual": false, "present": [0, 1]}]}