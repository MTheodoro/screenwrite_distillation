{"scene_id": "s02340", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02340.fountain", "heading": "INT. SPEAKEASY BEHIND ABERNETHY & SONS FUNERAL PARLOR - NIGHT (1926)", "cast": [{"id": 0, "name": "MADAME CELESTINE DUBOIS", "names": ["MADAME CELESTINE DUBOIS", "MADAME DUBOIS"], "gender": "m", "first": 6, "spoke": 3}, {"id": 1, "name": "SHORTY", "names": ["SHORTY"], "gender": "?", "first": 8, "spoke": 1}, {"id": 2, "name": "WASHINGTON", "names": ["WASHINGTON"], "gender": "?", "first": 8, "spoke": 0}, {"id": 3, "name": "HORATIO PELL", "names": ["HORATIO PELL", "HORATIO"], "gender": "m", "first": 10, "spoke": 2}, {"id": 4, "name": "EUGENIA PELL", "names": ["EUGENIA PELL", "EUGENIA"], "gender": "?", "first": 10, "spoke": 2}, {"id": 5, "name": "BIG DOMINIC", "names": ["BIG DOMINIC"], "gender": "m", "first": 12, "spoke": 0}, {"id": 6, "name": "SAL", "names": ["SAL"], "gender": "m", "first": 12, "spoke": 0}, {"id": 7, "name": "INSPECTOR CORNELIUS BLACKWOOD", "names": ["INSPECTOR CORNELIUS BLACKWOOD", "INSPECTOR BLACKWOOD"], "gender": "m", "first": 32, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. SPEAKEASY BEHIND ABERNETHY & SONS FUNERAL PARLOR - NIGHT (1926)", "present": []}, {"u": 1, "kind": "action", "text": "A low cellar dressed as a mourning room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Black crepe on the walls.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Coffins serve as tables, lids propped for drinks.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A gramophone scratches out a muffled foxtrot.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Cigar smoke curls under a tin ceiling.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "MADAME CELESTINE DUBOIS, 50s, proprietress, in black beads and a veiled hat, sits behind the bar polishing a glass.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Eyes like flint.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "OTIS \"SHORTY\" WASHINGTON, 30s, bartender, small, quick, in a white apron stained gray.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "He pours without looking.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "At a coffin table, HORATIO PELL, 40s, banker, in a bowler, nurses a whiskey.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Beside him, his young wife, EUGENIA PELL, 20s, in a flapper dress, stares at the floor.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "In the corner, two men in dark coats: BIG DOMINIC, 30s, thick neck, and his partner, SAL, 20s, who bites his fingernails.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "Another round for the mourners. On the house.", "name": "MADAME DUBOIS", "speaker": 0, "ext": [], "paren": ["to the whole room"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "action", "text": "A weak cheer.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "action", "text": "Horatio raises his glass.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "action", "text": "Eugenia does not.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "Smile.", "name": "HORATIO", "speaker": 3, "ext": [], "paren": ["low, to Eugenia"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "dialogue", "text": "I am.", "name": "EUGENIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "dialogue", "text": "Don't look at the door.", "name": "HORATIO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "I wasn't.", "name": "EUGENIA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "action", "text": "Shorty slides two drinks across.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "action", "text": "Dominic watches Horatio.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "Sal rubs his thumb against his knee.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "dialogue", "text": "Lock the cellar.", "name": "MADAME DUBOIS", "speaker": 0, "ext": [], "paren": ["to Shorty, quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "dialogue", "text": "Yes, ma'am.", "name": "SHORTY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "action", "text": "He moves to the stairs.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "action", "text": "A heavy tread above.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "action", "text": "Someone knocks, twice, slow, then once, fast.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "Everyone stops.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "The gramophone needle skips.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "A new figure descends the stairs.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "action", "text": "INSPECTOR CORNELIUS BLACKWOOD, 50s, rain on his shoulders, badge in hand, steps into the lamplight.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "action", "text": "He surveys the room, the coffins, the crepe.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "dialogue", "text": "Evening, all. I'm told someone has died.", "name": "INSPECTOR BLACKWOOD", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "dialogue", "text": "Several, Inspector. Mostly of thirst.", "name": "MADAME DUBOIS", "speaker": 0, "ext": [], "paren": ["very evenly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "action", "text": "Dominic reaches inside his coat.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "action", "text": "Horatio's hand finds Eugenia's wrist.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "action", "text": "Sal stands, scraping his chair.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "dialogue", "text": "Always the same room.", "name": "INSPECTOR BLACKWOOD", "speaker": 7, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "action", "text": "He sets his badge on the bar.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 41, "kind": "action", "text": "Takes off his hat.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 42, "kind": "action", "text": "Places it beside it.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 43, "kind": "action", "text": "Nobody breathes.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 44, "kind": "dialogue", "text": "Gentlemen. Ladies. I'm here to pay my respects.", "name": "INSPECTOR BLACKWOOD", "speaker": 7, "ext": ["CONT'D"], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 45, "kind": "action", "text": "Silence.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 46, "kind": "action", "text": "Then Madame Dubois, slowly, pours him a glass.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}