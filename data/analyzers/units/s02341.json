{"scene_id": "s02341", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02341.fountain", "heading": "INT. OIL RIG - MEDICAL BAY - NIGHT", "cast": [{"id": 0, "name": "ILSABET HALVORSEN-REYES", "names": ["ILSABET HALVORSEN-REYES", "DR. HALVORSEN-REYES"], "gender": "?", "first": 5, "spoke": 9}, {"id": 1, "name": "WALLY", "names": ["WALLY"], "gender": "?", "first": 8, "spoke": 5}, {"id": 2, "name": "OKONJO", "names": ["OKONJO"], "gender": "?", "first": 8, "spoke": 0}, {"id": 3, "name": "CAPTAIN LOWE", "names": ["CAPTAIN LOWE"], "gender": "?", "first": 13, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. OIL RIG - MEDICAL BAY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A steel-walled room bolted to the deck of a North Sea platform.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single examination cot, an oxygen tank strapped to the wall, a shelf of rattling supplies.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The floor shudders with each wave.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain hammers the window.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. ILSABET HALVORSEN-REYES, 40s, in rain-stained scrubs, bends over the cot.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A headlamp hangs around her neck.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Her eyes are red but steady.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "On the cot lies WALLACE \"WALLY\" OKONJO, 50s, a roughneck, his shirt cut open.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "A pad of gauze soaks red above his ribs.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "He grits his teeth.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "A radio on the wall crackles.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "The signal is thin.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Doctor, we're losing the chopper window. Fifteen minutes.", "name": "CAPTAIN LOWE", "speaker": 3, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Understood.", "name": "DR. HALVORSEN-REYES", "speaker": 0, "ext": [], "paren": ["to the radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Doc...", "name": "WALLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Don't talk.", "name": "DR. HALVORSEN-REYES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Is it bad?", "name": "WALLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "It's a rib and a lung. I've seen worse.", "name": "DR. HALVORSEN-REYES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Where?", "name": "WALLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Not here.", "name": "DR. HALVORSEN-REYES", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "She lifts the gauze.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Looks.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Presses the dressing back down with the heel of her hand.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Wally hisses.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Everyone's standing by on deck. We can wait if you need more time.", "name": "CAPTAIN LOWE", "speaker": 3, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Nobody waits. Hear me? Nobody waits for me.", "name": "DR. HALVORSEN-REYES", "speaker": 0, "ext": [], "paren": ["to the radio, then to the empty room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "She opens a drawer.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Pulls out a chest tube kit and tears the sterile wrapper with her teeth.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Doc. If I don't...", "name": "WALLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Wally.", "name": "DR. HALVORSEN-REYES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Tell my wife I kept the lighthouse key.", "name": "WALLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "You tell her yourself.", "name": "DR. HALVORSEN-REYES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "She slides the tube in.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Wally shouts.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Then gasps.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Then, slowly, his chest rises, and his face loosens.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "There it is. Breathe with me.", "name": "DR. HALVORSEN-REYES", "speaker": 0, "ext": ["CONT'D"], "paren": ["to Wally"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "He breathes.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "She breathes.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "A wave shakes the room.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "The window goes white with spray.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Doctor?", "name": "CAPTAIN LOWE", "speaker": 3, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Captain, you can send the chopper. He's stable.", "name": "DR. HALVORSEN-REYES", "speaker": 0, "ext": [], "paren": ["to the radio, calm"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Copy that. Good work, Doctor.", "name": "CAPTAIN LOWE", "speaker": 3, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "She switches off the radio.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Slumps onto the stool.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Wally lifts a hand.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "She takes it.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}]}