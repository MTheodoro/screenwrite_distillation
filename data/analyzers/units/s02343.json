{"scene_id": "s02343", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02343.fountain", "heading": "EXT. DRY WELL - HOMESTEAD - DAY", "cast": [{"id": 0, "name": "AMOS", "names": ["AMOS", "OLD AMOS"], "gender": "m", "first": 4, "spoke": 19}, {"id": 1, "name": "TREVELYAN", "names": ["TREVELYAN"], "gender": "?", "first": 4, "spoke": 0}, {"id": 2, "name": "CASSIUS DELANEY", "names": ["CASSIUS DELANEY", "CASSIUS"], "gender": "?", "first": 5, "spoke": 20}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DRY WELL - HOMESTEAD - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Flat, cracked earth to the horizon.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single stone well, rope rotted and trailing in the dirt.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A windmill turns without conviction.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "AMOS \"OLD AMOS\" TREVELYAN, 60s, sits on the well's lip, a canteen across his knees, bootless, feet in the dust.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "CASSIUS DELANEY, 30s, rides up on a gray mare.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "Hat low, duster pale with road.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "He swings down and ties the horse to the windmill.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Afternoon, Amos.", "name": "CASSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Cassius. You're a long way from town.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "So are you.", "name": "CASSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I live here.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Not for long, I hear.", "name": "CASSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Amos unscrews the canteen.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Tilts it.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "A few drops fall on his tongue.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "They send you to talk me out?", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Nobody sends me.", "name": "CASSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "That's what I thought.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "The bank wants the land.", "name": "CASSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "The bank can have the dust.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "It's the dust they're paying for.", "name": "CASSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Then the bank's a fool.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Cassius crouches.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Picks up a clod and crumbles it.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "He looks into the well.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "How deep was she?", "name": "CASSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Forty feet when I dug her. Now? Maybe thirty-nine.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "You've been down there?", "name": "CASSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Every morning.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Why?", "name": "CASSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "To see if she changed her mind.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "A long silence.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "The windmill creaks.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "A hawk crosses the sky.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Amos, I've known you since I was a boy.", "name": "CASSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "You were a boy who stole my peaches.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "I was a boy who was hungry.", "name": "CASSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Same thing.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Cassius laughs, short.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Stands.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Brushes his hands on his pants.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "I came to tell you something.", "name": "CASSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Go on.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "There's water, Amos. East of here. A man in the hills found a spring.", "name": "CASSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Amos lowers the canteen.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "He turns his head slowly.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "How far?", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Two days. Maybe three, with a wagon.", "name": "CASSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "And who owns it?", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Nobody yet.", "name": "CASSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Nobody yet.", "name": "AMOS", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "He looks into the well.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Then, deliberately, he lifts one boot from the dust and pulls it on.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "Cassius, what do you want for it?", "name": "AMOS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "I want my name on the deed beside yours.", "name": "CASSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Amos stares at him for a long moment.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Then he reaches behind the well, pulls out a shotgun, and levels it at Cassius's chest.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "That's what I thought.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "Amos.", "name": "CASSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "You didn't come to tell me. You came to see if I'd say yes.", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Put it down, old man.", "name": "CASSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "Where's the spring, Cassius?", "name": "AMOS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "There is no spring.", "name": "CASSIUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "Amos's finger tightens.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "Cassius does not move.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "But there was a time you'd have believed me.", "name": "CASSIUS", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "The windmill creaks.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "Amos lowers the gun, slowly.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "He sits back on the well, looking older.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "Cassius mounts his mare and rides off, and Amos does not watch him go.", "para": 11, "sent": 3, "present": [0, 1, 2]}]}