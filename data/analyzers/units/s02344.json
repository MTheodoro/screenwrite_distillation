{"scene_id": "s02344", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02344.fountain", "heading": "INT. WAY STATION - STAGE STOP - NIGHT", "cast": [{"id": 0, "name": "MARGUERITE LAFLEUR", "names": ["MARGUERITE LAFLEUR", "MARGUERITE"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "HUDSON CROY", "names": ["HUDSON CROY", "HUDSON"], "gender": "m", "first": 5, "spoke": 5}, {"id": 2, "name": "OLD PETE", "names": ["OLD PETE"], "gender": "?", "first": 6, "spoke": 4}, {"id": 3, "name": "VOICE", "names": ["VOICE"], "gender": "?", "first": 19, "spoke": 0}, {"id": 4, "name": "DEPUTY KANE", "names": ["DEPUTY KANE"], "gender": "?", "first": 20, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. WAY STATION - STAGE STOP - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "One lamp, one table.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Four people circle a stew pot gone cold.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wind rattles the shutters.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MARGUERITE LAFLEUR, 40s, in a traveling dress, grips a carpetbag.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "HUDSON CROY, 30s, a drummer in a checked vest, drums his fingers.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "OLD PETE, 70, the station keeper, whittles.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "I paid for a coach to Sedalia.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "We all paid.", "name": "HUDSON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Coach left this morning.", "name": "OLD PETE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Without me?", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Without anyone. The driver took sick.", "name": "OLD PETE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Then who's out there?", "name": "HUDSON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Where?", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Listen.", "name": "HUDSON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Hoofbeats outside, slow.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "A rider dismounts.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Boots on the porch.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Not tonight.", "name": "OLD PETE", "speaker": 2, "ext": [], "paren": ["under his breath"], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "A VOICE (O.S.) outside, rough and unhurried.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Pete! Open up! I know you've got folks in there.", "name": "DEPUTY KANE", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Is he the law?", "name": "HUDSON", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "He is the law's cousin.", "name": "OLD PETE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Then we open it.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "We do not open it.", "name": "HUDSON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "I'll count to five!", "name": "DEPUTY KANE", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Hudson stands, walks to the door, and slides the bolt back.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Marguerite and Pete stare.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "He opens it wide.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}]}