{"scene_id": "s02345", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02345.fountain", "heading": "INT. DUGOUT CHAPEL - WESTERN FRONT - NIGHT", "cast": [{"id": 0, "name": "CHAPLAIN ROSARIO VELAZQUEZ", "names": ["CHAPLAIN ROSARIO VELAZQUEZ", "CHAPLAIN VELAZQUEZ"], "gender": "?", "first": 7, "spoke": 10}, {"id": 1, "name": "TEDDY", "names": ["TEDDY"], "gender": "?", "first": 9, "spoke": 14}, {"id": 2, "name": "LACROIX", "names": ["LACROIX"], "gender": "?", "first": 9, "spoke": 0}, {"id": 3, "name": "SERGEANT NIKOLAI BORISOV", "names": ["SERGEANT NIKOLAI BORISOV", "BORISOV"], "gender": "?", "first": 10, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. DUGOUT CHAPEL - WESTERN FRONT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cellar dug under a ruined church.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sandbags for pews.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cracked crucifix propped on an ammunition crate.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A gramophone, hand-cranked, plays one worn waltz.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Candle stubs.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "The earth trembles with a distant shelling.", "para": 0, "sent": 5, "present": []}, {"u": 7, "kind": "action", "text": "CHAPLAIN ROSARIO VELAZQUEZ, 40s, kneels at the crate, adjusting the crucifix.", "para": 1, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "His hands are quick and wrong.", "para": 1, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "PRIVATE EDMUND \"TEDDY\" LACROIX, 19, sits on a sandbag with a letter on his knee and a pencil behind his ear.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "SERGEANT NIKOLAI BORISOV, 30s, leans on the entrance, rifle slung, helmet dented.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Father. How do you write to someone you haven't spoken to in a year?", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "You begin with the weather.", "name": "CHAPLAIN VELAZQUEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "It's raining.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Then that's a start.", "name": "CHAPLAIN VELAZQUEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "She won't want to know about the rain.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Nobody wants to know about the rain. That's why it is safe.", "name": "CHAPLAIN VELAZQUEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Safe is a good word for it.", "name": "BORISOV", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Sergeant. You may sit.", "name": "CHAPLAIN VELAZQUEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "I'll stand.", "name": "BORISOV", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "What if I tell her the truth?", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Which truth?", "name": "CHAPLAIN VELAZQUEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "That I'm afraid.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "She knows that.", "name": "BORISOV", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "How?", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Everyone's afraid. The ones who say they're not are the ones lying.", "name": "BORISOV", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Sergeant Borisov is a wise man.", "name": "CHAPLAIN VELAZQUEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Sergeant Borisov is a tired man.", "name": "BORISOV", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Are you afraid, Sergeant?", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "I don't discuss it.", "name": "BORISOV", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "That's an answer.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Take it however you like.", "name": "BORISOV", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Edmund. Write what you would say if she were standing here.", "name": "CHAPLAIN VELAZQUEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "She would never be standing here.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Then write that.", "name": "CHAPLAIN VELAZQUEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "The shelling swells.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Dust sifts from the beams.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "The gramophone skips, and starts again.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Dear Mathilde. It is raining.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Good.", "name": "CHAPLAIN VELAZQUEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "There is a waltz playing. It's the only one we have.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "It's a bad waltz.", "name": "BORISOV", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "It's the only one.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Keep going.", "name": "CHAPLAIN VELAZQUEZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "I think of you at the window. I think of you hanging the washing. I think of you not thinking of me, and I'm glad.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Glad?", "name": "BORISOV", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "That she's not afraid for me.", "name": "TEDDY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "A very long silence.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Then Borisov crosses the cellar.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Sits beside Teddy on the sandbag.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Takes the pencil from behind the boy's ear, hands it to him, and says nothing more.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}]}