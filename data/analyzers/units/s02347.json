{"scene_id": "s02347", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02347.fountain", "heading": "INT. ORBITAL GREENHOUSE - HELIX STATION - \"DAY\" CYCLE", "cast": [{"id": 0, "name": "HELENA VASQUEZ-OLUWO", "names": ["HELENA VASQUEZ-OLUWO", "HELENA"], "gender": "f", "first": 6, "spoke": 20}, {"id": 1, "name": "JO", "names": ["JO"], "gender": "?", "first": 8, "spoke": 19}, {"id": 2, "name": "ARDEN", "names": ["ARDEN"], "gender": "?", "first": 8, "spoke": 0}, {"id": 3, "name": "COMMANDER RHEE", "names": ["COMMANDER RHEE"], "gender": "?", "first": 26, "spoke": 1}, {"id": 4, "name": "TEENAGE CADET", "names": ["TEENAGE CADET"], "gender": "?", "first": 53, "spoke": 0}, {"id": 5, "name": "CADET LISANDRA", "names": ["CADET LISANDRA"], "gender": "?", "first": 53, "spoke": 4}, {"id": 6, "name": "TECHNICIAN WU", "names": ["TECHNICIAN WU"], "gender": "?", "first": 84, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. ORBITAL GREENHOUSE - HELIX STATION - \"DAY\" CYCLE", "present": []}, {"u": 1, "kind": "action", "text": "A great curved garden turning slowly in space.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Glass arches filled with starlight.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rows of tomato vines, lemon dwarfs, stalks of corn, all tied to trellises with soft cord.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A gentle hum of pumps.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Water droplets drift, glittering.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "DR. HELENA VASQUEZ-OLUWO, 50s, botanist, floats upside down among the tomatoes with a clipboard strapped to her wrist.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "She is pinching a leaf, frowning.", "para": 1, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "Below her, hands on a rail, ENGINEER JOSEPHINE \"JO\" ARDEN, 30s, in a gray station jumpsuit, adjusts a valve and watches the readout.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "It's yellowing.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "The whole row?", "name": "JO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Half.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Is it the light?", "name": "JO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "It isn't the light.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Then the water.", "name": "JO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "It isn't the water either.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Then what?", "name": "JO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Helena pulls herself down the trellis.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "She hangs beside Jo.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "She holds out the leaf.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "It crumbles to powder in her fingers.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "That's not blight.", "name": "JO", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "No.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "That's... static.", "name": "JO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Yes. She thinks so too.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Who?", "name": "JO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Commander Rhee. She came by this morning.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "She didn't tell me.", "name": "JO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "She doesn't tell you things.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "She tells you.", "name": "JO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "She asks me things. It isn't the same.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Jo's jaw works.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "She taps the readout.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Numbers scroll in amber.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "She stops on one.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Helena. That's radiation.", "name": "JO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "I know.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "From where?", "name": "JO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "From outside.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "That's impossible. The shielding's rated for...", "name": "JO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "It was rated for the old sun.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Jo turns slowly.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "They look at each other.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "A droplet of water drifts between them and breaks against the glass.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "The station intercom chimes.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "A calm voice.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "All hands. Report to the central deck. All hands.", "name": "COMMANDER RHEE", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "That's her.", "name": "JO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Of course it is.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Jo pushes off the rail.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Helena grabs a handful of leaves, stuffs them in her pocket.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "They float down the long arc of the garden toward the airlock, side by side.", "para": 7, "sent": 2, "present": [1, 2, 3]}, {"u": 52, "kind": "action", "text": "Behind them, the tomatoes turn from red to gray.", "para": 7, "sent": 3, "present": [1, 2, 3]}, {"u": 53, "kind": "action", "text": "At the bulkhead, a TEENAGE CADET, 17, in an oversized uniform, drifts into their path, wide-eyed, a tablet clutched to her chest.", "para": 8, "sent": 0, "present": [1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "Doctor. Engineer. The Commander says it's the sun.", "name": "CADET LISANDRA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "We know.", "name": "JO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "She says there's a window. Eleven hours.", "name": "CADET LISANDRA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "For what?", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "dialogue", "text": "To decide.", "name": "CADET LISANDRA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "Helena closes her eyes.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "action", "text": "Jo takes the tablet from the cadet's hands and reads it.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "Then, very slowly, she hands it back.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "She turns her gaze to Helena.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "Helena doesn't open her eyes.", "para": 9, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "dialogue", "text": "Tell me.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "dialogue", "text": "We can evacuate half.", "name": "JO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "dialogue", "text": "Which half?", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "dialogue", "text": "Whichever half she says.", "name": "JO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "dialogue", "text": "And the rest?", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "dialogue", "text": "She says they'll have the garden.", "name": "JO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "dialogue", "text": "The garden's dying.", "name": "HELENA", "speaker": 0, "ext": [], "paren": ["a bitter breath"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "dialogue", "text": "She knows.", "name": "JO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "action", "text": "Cadet Lisandra stares from one woman to the other.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "action", "text": "She says nothing.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "action", "text": "A single drop of water drifts up and pops on her sleeve.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 75, "kind": "action", "text": "Then, beyond the arches, a flare lights the stars.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 76, "kind": "action", "text": "Jo and Helena turn together toward the glass.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 77, "kind": "action", "text": "The light climbs, white and silent, across their faces.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 78, "kind": "dialogue", "text": "That wasn't the sun.", "name": "CADET LISANDRA", "speaker": 5, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 79, "kind": "dialogue", "text": "No.", "name": "JO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 80, "kind": "dialogue", "text": "That was the shield failing.", "name": "HELENA", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 81, "kind": "action", "text": "The hum of the pumps rises.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 82, "kind": "action", "text": "The vines shiver on their trellises.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 83, "kind": "action", "text": "The sirens begin.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 84, "kind": "action", "text": "TECHNICIAN WU, 20s, bursts through the bulkhead, goggles up, breathless.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 85, "kind": "dialogue", "text": "Helena! Jo! The Commander wants you on the deck now!", "name": "TECHNICIAN WU", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 86, "kind": "dialogue", "text": "We're coming, Wu.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}