{"scene_id": "s02348", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02348.fountain", "heading": "EXT. RAILROAD CROSSING - BROKEN-DOWN SCHOOL BUS - DUSK", "cast": [{"id": 0, "name": "JUNE", "names": ["JUNE"], "gender": "f", "first": 4, "spoke": 7}, {"id": 1, "name": "RAYMOND", "names": ["RAYMOND"], "gender": "f", "first": 5, "spoke": 7}, {"id": 2, "name": "DEVI", "names": ["DEVI"], "gender": "?", "first": 6, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "EXT. RAILROAD CROSSING - BROKEN-DOWN SCHOOL BUS - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "A yellow bus idles dead on the tracks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The hood is up.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Crossing lights blink red, and a distant horn sounds.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "JUNE, 16, in a letterman jacket, kneels at the engine with a flashlight in her teeth.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "RAYMOND, 17, hovers beside her, shirt untucked.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "DEVI, 15, stands on the bus steps with a phone held high, hunting for a signal.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "It's the alternator.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "It's not the alternator.", "name": "JUNE", "speaker": 0, "ext": [], "paren": ["around the flashlight"], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "I have one bar. One. Don't move.", "name": "DEVI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "How would you know?", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "My dad's a mechanic.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Quiet, I'm calling.", "name": "DEVI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "He fixes lawnmowers.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "He fixes everything.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Hello? Hello? Is this 911?", "name": "DEVI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Tell them the train.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "There's a train coming!", "name": "DEVI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "How far?", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Two miles.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Three.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "They're asking where we are.", "name": "DEVI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Say Route Nine.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Say the crossing.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Route Nine, at the crossing!", "name": "DEVI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "The horn sounds again, nearer.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "All three look east.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Out. Everyone out.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "I'm out.", "name": "RAYMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "I'm out.", "name": "DEVI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "They run into the weeds, hand in hand in hand, as the bus sits alone in the red light.", "para": 3, "sent": 0, "present": [0, 1, 2]}]}