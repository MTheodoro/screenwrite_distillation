{"scene_id": "s02349", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02349.fountain", "heading": "INT. ICE-SCULPTURE WAREHOUSE - NIGHT", "cast": [{"id": 0, "name": "DRIVER", "names": ["DRIVER"], "gender": "m", "first": 5, "spoke": 15}, {"id": 1, "name": "MAGDA KOWALSKI", "names": ["MAGDA KOWALSKI", "MAGDA"], "gender": "f", "first": 8, "spoke": 13}, {"id": 2, "name": "ESME", "names": ["ESME"], "gender": "?", "first": 36, "spoke": 3}, {"id": 3, "name": "MARCUS", "names": ["MARCUS"], "gender": "?", "first": 52, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. ICE-SCULPTURE WAREHOUSE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A walk-in freezer the size of a hangar.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Frost smokes off the floor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Under blue work lights stand dozens of ice sculptures: swans, a dragon, a wedding cake, a life-size horse.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Everything glitters.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A DRIVER, 30s, ski mask pushed up onto his forehead, stands before the horse with a hand truck.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "He is shivering.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Beside him, a dolly holds a rolled-up carpet.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "MAGDA KOWALSKI, 40s, in a parka, arrives through a side door with a tool bag.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Her breath trails behind her like a ghost.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Why's the horse still here?", "name": "MAGDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "It's a horse.", "name": "DRIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I know it's a horse. Why's it still here? The plan was the cake.", "name": "MAGDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "The cake was too big.", "name": "DRIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "The cake was perfect.", "name": "MAGDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "It wouldn't fit the van.", "name": "DRIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Then you should've brought a bigger van.", "name": "MAGDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "I don't pick the vans.", "name": "DRIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Who does?", "name": "MAGDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Nobody. It's just what was left.", "name": "DRIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Magda sets down her tool bag and unzips it.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She takes out a cordless drill and a thermal blanket.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Help me wrap it.", "name": "MAGDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Wrap the horse?", "name": "DRIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "It's the horse now.", "name": "MAGDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "They drape the blanket over the sculpture.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "The Driver grunts, straining.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Frost clings to his cuffs.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "What's inside it again?", "name": "DRIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Don't ask.", "name": "MAGDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "I'm not asking. I'm... wondering.", "name": "DRIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Wondering is asking.", "name": "MAGDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Is it the necklace?", "name": "DRIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "She says nothing.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Drills a small hole at the horse's flank, and the bit whines through the ice.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "It's the necklace.", "name": "DRIVER", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Esme.", "name": "MAGDA", "speaker": 1, "ext": [], "paren": ["not turning"], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "What?", "name": "DRIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "That's my name. You've worked with me for six years and you still call me \"Magda\" in your head.", "name": "MAGDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Your name's Magda.", "name": "DRIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Is it?", "name": "MAGDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "He stops.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "He studies her.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "The drill bit catches something and goes silent.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Hold the light.", "name": "MAGDA", "speaker": 1, "ext": ["CONT'D"], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "ESME's hand goes into the hole.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "She withdraws a slim leather pouch, glittering with frost.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "She weighs it in her palm.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "So it's Esme.", "name": "DRIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "It's Esme.", "name": "ESME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "And I'm...", "name": "DRIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "You're the driver.", "name": "ESME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "I'd rather be Marcus.", "name": "DRIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Then you're Marcus.", "name": "ESME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "The Driver, now MARCUS, takes the pouch and slips it into his glove.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Esme. Door's open. Let's roll the horse.", "name": "MARCUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "They roll the wrapped horse toward the loading bay.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Behind them, the swans, the dragon, the cake, slowly bead with moisture in the warm draft of the open door.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}]}