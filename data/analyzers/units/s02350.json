{"scene_id": "s02350", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02350.fountain", "heading": "INT. STRANDED CABLE CAR - ALPINE RIDGE - DAWN", "cast": [{"id": 0, "name": "HANNELORE BR", "names": ["HANNELORE BR", "HANNELORE"], "gender": "f", "first": 8, "spoke": 6}, {"id": 1, "name": "CKNER", "names": ["CKNER"], "gender": "?", "first": 8, "spoke": 0}, {"id": 2, "name": "ISAAC MBEKI-LOWE", "names": ["ISAAC MBEKI-LOWE", "ISAAC"], "gender": "f", "first": 11, "spoke": 5}, {"id": 3, "name": "PAULINE ACHTERBERG", "names": ["PAULINE ACHTERBERG", "PAULINE"], "gender": "f", "first": 14, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. STRANDED CABLE CAR - ALPINE RIDGE - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A glass-walled gondola hanging motionless over a gorge.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Frost on the windows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A white sea of cloud below.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The cable creaks.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A single bench seat, a steel pole.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "Three passengers.", "para": 1, "sent": 0, "present": []}, {"u": 7, "kind": "action", "text": "They have been here since last night.", "para": 1, "sent": 1, "present": []}, {"u": 8, "kind": "action", "text": "HANNELORE BR\u00dcCKNER, 60s, in a loden coat, sits upright with her handbag on her knees.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Her lips are blue.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She has not complained once.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "ISAAC MBEKI-LOWE, 30s, in a ski jacket, crouches against the door.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "His phone is dead.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "He taps it anyway.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "PAULINE ACHTERBERG, 20s, in a thin windbreaker, huddles in the corner with a thermos.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "She unscrews it, checks it, screws it shut.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "The gondola sways.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Everyone stops breathing until it stills.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Anyone have a lighter?", "name": "ISAAC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "I don't smoke.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "It's not for smoking.", "name": "ISAAC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "I have matches.", "name": "PAULINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Why didn't you say?", "name": "ISAAC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "You didn't ask.", "name": "PAULINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "She hands him a small box.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "He takes it, strikes one.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "It flares and dies.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "He strikes another and cups it.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "They all lean toward the tiny glow like a campfire.", "para": 6, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Hannelore opens her handbag.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Takes out a folded newspaper.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Smooths it on her knee.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Holds it out.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "It burns.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "It's your paper.", "name": "ISAAC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "It's yesterday's.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Isaac takes it.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Tears off a corner.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Lights it.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "A thin yellow flame climbs and wavers, and the gondola glows for a few seconds.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Nobody speaks.", "para": 8, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Pauline reaches out and lets her palm hover over the flame.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Isaac moves the paper closer to her without a word.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "When it burns down to his fingers, he lets it fall and stamps it out.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "The cable jolts.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Everyone grabs a rail.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "A distant mechanical groan comes from the tower.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Hannelore turns her head slowly toward the sound, as though recognizing an old acquaintance.", "para": 10, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "That is the generator.", "name": "HANNELORE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "How do you know?", "name": "ISAAC", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "My husband built the first one.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Is that good?", "name": "PAULINE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "It means they are trying.", "name": "HANNELORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "The gondola lurches forward a foot and stops.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Pauline laughs once, a dry bark.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Isaac slides down the door and sits.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Hannelore folds her hands again, and for the first time her shoulders drop.", "para": 11, "sent": 3, "present": [0, 1, 2, 3]}]}