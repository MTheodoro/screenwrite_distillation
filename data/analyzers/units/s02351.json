{"scene_id": "s02351", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02351.fountain", "heading": "INT. NOBLE'S PAWN & LOAN - BLACKOUT - NIGHT", "cast": [{"id": 0, "name": "OBINNA AKPAN", "names": ["OBINNA AKPAN", "OBINNA"], "gender": "m", "first": 4, "spoke": 7}, {"id": 1, "name": "ROSALIE", "names": ["ROSALIE"], "gender": "?", "first": 6, "spoke": 4}, {"id": 2, "name": "WOMAN", "names": ["WOMAN"], "gender": "?", "first": 12, "spoke": 0}, {"id": 3, "name": "DEVAKI", "names": ["DEVAKI"], "gender": "?", "first": 12, "spoke": 9}, {"id": 4, "name": "MOOSE", "names": ["MOOSE"], "gender": "m", "first": 13, "spoke": 2}, {"id": 5, "name": "CHESTER", "names": ["CHESTER"], "gender": "?", "first": 14, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. NOBLE'S PAWN & LOAN - BLACKOUT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Total dark but for the red glow of an emergency exit sign and the guttering flame of one candle.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Glass cases glint with watches and wedding bands.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Guitars hang from the wall like bats.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A thin man, OBINNA AKPAN, 40s, stands behind the counter with a baseball bat in both hands.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "His knuckles whiten.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Beside him, his teenage daughter, ROSALIE, 16, clutches a flashlight she has not dared switch on.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "The bell above the door jingles.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Three silhouettes enter.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "We're closed.", "name": "OBINNA", "speaker": 0, "ext": [], "paren": ["to the dark"], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "A match flares.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "A woman's face, hard and young, lit from below.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "THE WOMAN, who calls herself DEVAKI, 30s, in a raincoat, holds the match up and surveys the store with an easy, patient eye.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Behind her, a big man in a hoodie: MOOSE, 40s, shaved head, jiggling a ring of keys.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Another shape lingers in the doorway: CHESTER, 60s, in a flat cap, one hand on the knob, as if he might leave.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Nobody panic. We only came for what's ours.", "name": "DEVAKI", "speaker": 3, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "There's nothing here that's yours.", "name": "OBINNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Not yet.", "name": "DEVAKI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "action", "text": "She walks to the glass case.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Taps it with a ringed finger.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Open it.", "name": "DEVAKI", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "The power's out. The register won't...", "name": "OBINNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "I didn't say the register.", "name": "DEVAKI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Obinna swallows.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "He looks at Rosalie.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "She shakes her head in a tiny motion.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "He sets the bat down on the counter.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Rosie. Back room.", "name": "OBINNA", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "No.", "name": "ROSALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Now.", "name": "OBINNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "I'm not leaving you.", "name": "ROSALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Moose steps closer, jingling his keys.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Chester murmurs, barely audible, to no one.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "This isn't what we agreed.", "name": "CHESTER", "speaker": 5, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Chester.", "name": "DEVAKI", "speaker": 3, "ext": [], "paren": ["without turning"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Yes.", "name": "CHESTER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Shut the door.", "name": "DEVAKI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "He does.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "The bell jingles.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "The store seems to shrink.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Obinna takes a key from his belt, fits it to the case, and turns it with a click.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Devaki lifts the lid.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "She takes out a small velvet bag.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Opens it.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Pours a ring into her palm.", "para": 9, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "She inspects it by the match, and her face softens for one second.", "para": 9, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "We're done. Nobody follows.", "name": "DEVAKI", "speaker": 3, "ext": ["CONT'D"], "paren": ["to the group"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "That's it?", "name": "MOOSE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "That's it.", "name": "DEVAKI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "It's one ring.", "name": "MOOSE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "It's my mother's ring.", "name": "DEVAKI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "She slips it onto her finger.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "The match burns down.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "She shakes it out.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "In the dark, the bell jingles, and the three shapes slip out.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "For a long moment, neither Obinna nor Rosalie moves.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "Then Rosalie clicks on the flashlight.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "Its beam finds the empty case, the open velvet bag, and a small stack of cash left on the glass.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "dialogue", "text": "Dad. They paid for it.", "name": "ROSALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "They paid for it.", "name": "OBINNA", "speaker": 0, "ext": [], "paren": ["a slow breath"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "action", "text": "He picks up the cash.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "action", "text": "Counts.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "Frowns.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "Counts again, and frowns harder.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "dialogue", "text": "How much?", "name": "ROSALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "dialogue", "text": "Three times the ring.", "name": "OBINNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "action", "text": "He sets the money on the counter and looks at the door, in the dark, where the bell is still faintly swinging.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}