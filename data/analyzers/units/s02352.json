{"scene_id": "s02352", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02352.fountain", "heading": "INT. NIGHT FERRY - GALLEY - NIGHT", "cast": [{"id": 0, "name": "CAPTAIN EZEKIEL FARROW", "names": ["CAPTAIN EZEKIEL FARROW", "CAPTAIN FARROW"], "gender": "m", "first": 6, "spoke": 12}, {"id": 1, "name": "FIRST MATE ODESSA LIN", "names": ["FIRST MATE ODESSA LIN", "LIN"], "gender": "?", "first": 7, "spoke": 4}, {"id": 2, "name": "COOK BARNABY OKORO", "names": ["COOK BARNABY OKORO", "BARNABY"], "gender": "?", "first": 8, "spoke": 3}, {"id": 3, "name": "DECKHAND SVEN HALLGREN", "names": ["DECKHAND SVEN HALLGREN", "SVEN"], "gender": "m", "first": 9, "spoke": 4}, {"id": 4, "name": "NAVIGATOR PRIYANKA DESHMUKH", "names": ["NAVIGATOR PRIYANKA DESHMUKH", "PRIYANKA"], "gender": "f", "first": 10, "spoke": 3}, {"id": 5, "name": "ENGINEER YURI KOZLOV", "names": ["ENGINEER YURI KOZLOV", "YURI"], "gender": "?", "first": 11, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT FERRY - GALLEY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped steel galley below the car deck.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Condensation drips from pipes.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A coffee urn gurgles.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Six crew crowd a bolted table beneath a swinging lamp.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The engine drones through the floor.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "CAPTAIN EZEKIEL FARROW, 60s, at the head, stirs a mug he doesn't drink.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "FIRST MATE ODESSA LIN, 40s, flips through a logbook.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "COOK BARNABY OKORO, 50s, wipes a spotless counter.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "DECKHAND SVEN HALLGREN, 20s, jiggles his knee.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "NAVIGATOR PRIYANKA DESHMUKH, 30s, studies a chart.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "And at the end, ENGINEER YURI KOZLOV, 50s, an oil-stained cap in his fist.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "I called you here because someone has been in the cargo hold.", "name": "CAPTAIN FARROW", "speaker": 0, "ext": [], "paren": ["to the table"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Which hold?", "name": "LIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "The sealed one.", "name": "CAPTAIN FARROW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "There's no sealed hold.", "name": "SVEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "There is now.", "name": "CAPTAIN FARROW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "I never liked this run.", "name": "BARNABY", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Captain, the manifest lists nothing sealed.", "name": "PRIYANKA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "The manifest was edited.", "name": "CAPTAIN FARROW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "By whom?", "name": "LIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "By someone with access.", "name": "CAPTAIN FARROW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "That's all of us.", "name": "YURI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Yes. That's the point.", "name": "CAPTAIN FARROW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "A heavy silence.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "The lamp swings.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Sven stops jiggling his knee.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Is it dangerous?", "name": "SVEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "I don't know.", "name": "CAPTAIN FARROW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Then why tell us?", "name": "BARNABY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Because one of you already knows.", "name": "CAPTAIN FARROW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Nobody moves.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Priyanka sets down her pen.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Lin closes the logbook.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "You think it's one of us.", "name": "LIN", "speaker": 1, "ext": [], "paren": ["to the Captain"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "I think it is two of you.", "name": "CAPTAIN FARROW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Then say who.", "name": "YURI", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "I will not. Not yet.", "name": "CAPTAIN FARROW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "This is insane.", "name": "SVEN", "speaker": 3, "ext": [], "paren": ["under his breath"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Sit still.", "name": "PRIYANKA", "speaker": 4, "ext": [], "paren": ["to Sven"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "I am sitting.", "name": "SVEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "You are vibrating.", "name": "PRIYANKA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Thirty years at sea and I'm cooking for a hanging.", "name": "BARNABY", "speaker": 2, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "At the next port, a team boards. Customs, perhaps police. Anyone wishing to speak before then, my door is open.", "name": "CAPTAIN FARROW", "speaker": 0, "ext": [], "paren": ["to the whole table, calmly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "And if no one does?", "name": "LIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Then I will have to guess.", "name": "CAPTAIN FARROW", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "The lamp swings.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "The engine drones.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "A faint knocking begins, somewhere far below the floor, slow and patient, like a fist on a locked door.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "Every head turns.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}]}