{"scene_id": "s02353", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02353.fountain", "heading": "INT. CLOSED PLANETARIUM - OVERNIGHT SLEEPOVER - NIGHT", "cast": [{"id": 0, "name": "MAEVE ARMSTRONG", "names": ["MAEVE ARMSTRONG", "MAEVE"], "gender": "f", "first": 6, "spoke": 8}, {"id": 1, "name": "TARIQ BELLAMY", "names": ["TARIQ BELLAMY", "TARIQ"], "gender": "?", "first": 7, "spoke": 6}, {"id": 2, "name": "WINONA SHORTBULL", "names": ["WINONA SHORTBULL", "WINONA"], "gender": "?", "first": 8, "spoke": 5}, {"id": 3, "name": "CALLUM TREMBLAY", "names": ["CALLUM TREMBLAY", "CALLUM"], "gender": "?", "first": 9, "spoke": 3}, {"id": 4, "name": "IMOGEN ABARA", "names": ["IMOGEN ABARA", "IMOGEN"], "gender": "f", "first": 10, "spoke": 4}, {"id": 5, "name": "PETROS KALOGEROS", "names": ["PETROS KALOGEROS", "PETROS"], "gender": "?", "first": 11, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. CLOSED PLANETARIUM - OVERNIGHT SLEEPOVER - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A great domed theater.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of reclined seats, and a projector like a monstrous insect at the center of the floor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The dome above is blank.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Six sleeping bags lie in a ragged circle under the projector, and a lantern throws their shadows up the curved wall.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Six teenagers sit on the carpet in pajamas, a paper plate of cold pizza between them, the box lid torn open.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "MAEVE ARMSTRONG, 16, the host, cross-legged, in a faded band shirt, plays with a thread on her sleeve.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "TARIQ BELLAMY, 17, beside her, glances at the exit doors.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "WINONA SHORTBULL, 16, hugs a pillow, eyes bright.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "CALLUM TREMBLAY, 17, snaps a glow stick over and over.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "IMOGEN ABARA, 15, whispers into her hood.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "And at the edge, a quiet boy, PETROS KALOGEROS, 16, watches the dome with unblinking calm.", "para": 2, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "action", "text": "The projector hums.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "action", "text": "A small red light blinks on it, then goes dark.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Okay. Truth or dare.", "name": "MAEVE", "speaker": 0, "ext": [], "paren": ["to the group"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "No.", "name": "CALLUM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Yes.", "name": "MAEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "It's two in the morning.", "name": "TARIQ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "That's when it works.", "name": "MAEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Don't be weird.", "name": "WINONA", "speaker": 2, "ext": [], "paren": ["to Maeve"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "I'm not weird. I'm hosting.", "name": "MAEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "It's too cold in here.", "name": "IMOGEN", "speaker": 4, "ext": [], "paren": ["softly, to herself"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "It's the dome. The air has nowhere to go.", "name": "PETROS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "That's... a thing you know?", "name": "IMOGEN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Mm.", "name": "PETROS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "The lantern flickers.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Callum snaps the glow stick, and the green light ripples across their faces.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "The dome is still dark.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Dare. Tariq. Go to the control booth and bring back the key.", "name": "MAEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "What key?", "name": "TARIQ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "The one in the booth.", "name": "MAEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "There's no key.", "name": "TARIQ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "Then bring me whatever's there.", "name": "MAEVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Tariq stands.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Looks at the dark doors.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Then at the others.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Nobody encourages him.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Fine.", "name": "TARIQ", "speaker": 1, "ext": [], "paren": ["under his breath"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "He crosses the floor.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "His footsteps die quickly in the carpet.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "The others watch him go.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Do you hear that?", "name": "WINONA", "speaker": 2, "ext": [], "paren": ["to the group, whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "What?", "name": "CALLUM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "Humming.", "name": "WINONA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "It's the projector.", "name": "IMOGEN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "It's not the projector.", "name": "WINONA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "It's coming from above.", "name": "PETROS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "All six faces lift to the dome.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "Stars flicker on, one by one, then dozens, then thousands, the whole sky spilling across the curve.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "No one touches a button.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "A warm voice murmurs from somewhere, soft as a lullaby, in a language none of them know.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "Tariq!", "name": "CALLUM", "speaker": 3, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "Tariq stands at the booth door, still as a statue, his back to them.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "He does not answer.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "Tariq?", "name": "MAEVE", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "Slowly, he turns.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "His face is calm.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "His eyes reflect the stars.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "He smiles at them.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "dialogue", "text": "It's beautiful.", "name": "TARIQ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "Tariq. Come back.", "name": "WINONA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "dialogue", "text": "You should see it from here.", "name": "TARIQ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "dialogue", "text": "No.", "name": "IMOGEN", "speaker": 4, "ext": [], "paren": ["barely audible"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "dialogue", "text": "Nobody go to the booth.", "name": "PETROS", "speaker": 5, "ext": [], "paren": ["to the group"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "The humming rises.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "Callum drops the glow stick.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "action", "text": "It rolls into the center of the circle and goes out.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "action", "text": "In the dark, the stars on the dome begin, ever so slowly, to turn.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}]}