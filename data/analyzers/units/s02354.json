{"scene_id": "s02354", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02354.fountain", "heading": "INT. FUNERAL HOME - FAMILY ROOM - DAY", "cast": [{"id": 0, "name": "OLIVER STANHOPE", "names": ["OLIVER STANHOPE", "OLIVER"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "WINIFRED STANHOPE-DUVAL", "names": ["WINIFRED STANHOPE-DUVAL", "WINIFRED"], "gender": "?", "first": 5, "spoke": 6}, {"id": 2, "name": "LUCIAN STANHOPE", "names": ["LUCIAN STANHOPE", "LUCIAN"], "gender": "?", "first": 4, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. FUNERAL HOME - FAMILY ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Beige carpet, a box of tissues on every surface.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A framed print of a wheat field.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A coffee urn steams on a side table.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "OLIVER STANHOPE, 50s, in a black suit too big at the shoulders, stands facing the wall.", "para": 1, "sent": 0, "present": [0, 2]}, {"u": 5, "kind": "action", "text": "His sister, WINIFRED STANHOPE-DUVAL, 50s, sits on the sofa with a binder of arrangements.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "We should choose the casket today.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Dad wanted pine.", "name": "OLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Dad wanted a lot of things.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "He wanted pine.", "name": "OLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "He wanted to be left alone.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "The door opens.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "LUCIAN STANHOPE, 20s, their nephew, steps in, hair wet from rain, a duffel on his shoulder.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "I got the earlier flight.", "name": "LUCIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "You weren't invited.", "name": "OLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Oliver.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "It's my grandfather.", "name": "LUCIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "It's my father.", "name": "OLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Both of you stop.", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I didn't come to fight.", "name": "LUCIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "You came to take the watch.", "name": "OLIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "I came to say goodbye!", "name": "LUCIAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Quiet! Both of you, quiet!", "name": "WINIFRED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Oliver swings around.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "His hand shakes.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "The binder slides off Winifred's lap and hits the floor with a slap.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Nobody picks it up.", "para": 3, "sent": 3, "present": [0, 1, 2]}]}