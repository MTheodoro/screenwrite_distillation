{"scene_id": "s02357", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02357.fountain", "heading": "EXT. GHOST TOWN - DEAD FERRY LANDING - DUSK", "cast": [{"id": 0, "name": "SHERIFF MORDECAI WELLS", "names": ["SHERIFF MORDECAI WELLS", "WELLS"], "gender": "m", "first": 5, "spoke": 9}, {"id": 1, "name": "CALISTA REYNOSO", "names": ["CALISTA REYNOSO", "CALISTA"], "gender": "f", "first": 8, "spoke": 6}, {"id": 2, "name": "PRESTON GRIGGS", "names": ["PRESTON GRIGGS", "GRIGGS"], "gender": "m", "first": 12, "spoke": 3}, {"id": 3, "name": "DISPATCH", "names": ["DISPATCH"], "gender": "?", "first": 26, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. GHOST TOWN - DEAD FERRY LANDING - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "A dry riverbed.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A rotting dock with no water beneath it.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wind in a broken pilot-house.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A weathered sign: LAST CROSSING.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SHERIFF MORDECAI WELLS, 50s, bone-thin, gray coat.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A tin star gone dull.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "He stands at the end of the pier, hat tipped back.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "CALISTA REYNOSO, 20s, a bounty hunter in dusty leathers.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Scarred cheek.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Dual pistols.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She sits on a barrel, legs swinging.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "PRESTON GRIGGS, 40s, in irons, wrists chained, face swollen.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "He kneels on the planks.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "A radio set crackles from a saddlebag.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "You said the river was here.", "name": "WELLS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "It was here.", "name": "CALISTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Where is it now?", "name": "WELLS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Went to Mexico, I guess.", "name": "CALISTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Griggs laughs, a raw cough.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Told you. Told you both.", "name": "GRIGGS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Shut him up.", "name": "WELLS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "He's tired.", "name": "CALISTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Tired. That's the word.", "name": "GRIGGS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The radio spits static.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "A woman's voice, faint.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Sheriff Wells, come in. Sheriff Wells.", "name": "DISPATCH", "speaker": 3, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Wells crosses the dock.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Lifts the receiver.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "This is Wells.", "name": "WELLS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Mordecai. The judge says to bring him in alive.", "name": "DISPATCH", "speaker": 3, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Understood.", "name": "WELLS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Alive. You hear?", "name": "DISPATCH", "speaker": 3, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "I heard.", "name": "WELLS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "He sets the receiver down.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Turns.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Well?", "name": "CALISTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Judge wants him breathing.", "name": "WELLS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Judge isn't here.", "name": "CALISTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "There it is.", "name": "GRIGGS", "speaker": 2, "ext": [], "paren": ["smiling"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Wells pulls his revolver.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Calista lays a hand on one of hers.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "The wind kicks up dust.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "A loose plank bangs somewhere.", "para": 9, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Nobody moves.", "para": 9, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "We take him in at dawn.", "name": "WELLS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "And tonight?", "name": "CALISTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "We sit.", "name": "WELLS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "He holsters the gun.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Sits on the dock edge, legs over the dry bed.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "After a moment, Calista joins him.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Griggs, between them, lowers his head.", "para": 10, "sent": 3, "present": [0, 1, 2, 3]}]}