{"scene_id": "s02359", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02359.fountain", "heading": "EXT. SHELLED VINEYARD - DAWN", "cast": [{"id": 0, "name": "CORPORAL ELIAS VOSS", "names": ["CORPORAL ELIAS VOSS", "VOSS"], "gender": "m", "first": 4, "spoke": 1}, {"id": 1, "name": "SERGEANT MARISKA DOBOS", "names": ["SERGEANT MARISKA DOBOS", "DOBOS"], "gender": "m", "first": 7, "spoke": 2}, {"id": 2, "name": "CHILD", "names": ["CHILD"], "gender": "m", "first": 18, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SHELLED VINEYARD - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Rows of broken vines in gray mist.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A stone wall half collapsed.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A crater at its foot, still smoking.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CORPORAL ELIAS VOSS, 20s, lies in the crater with his rifle across his chest.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He listens to his own breath.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "He has not spoken in hours.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "SERGEANT MARISKA DOBOS, 30s, crawls up beside him on elbows, helmet scraped silver.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She lowers herself into the crater without a sound.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "They're gone.", "name": "DOBOS", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Gone where?", "name": "VOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Over the ridge.", "name": "DOBOS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He lets out a breath he has held since midnight.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "His hand, still locked on the rifle, begins to shake.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She watches it and says nothing, then lays hers over his until the shaking slows.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "A scrape of stone.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "They both freeze.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "A boy rises from behind the wall.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "A CHILD, 8, in a man's coat, his cheeks smeared with dirt, holding a single bunch of grapes.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "He looks at the rifles.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "At them.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "He holds out the grapes.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Voss lowers the rifle.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Dobos takes a grape.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Eats it.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Nods once.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The child nods back and vanishes behind the wall.", "para": 7, "sent": 4, "present": [0, 1, 2]}]}