{"scene_id": "s02360", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02360.fountain", "heading": "INT. PUBLIC POOL - SWIM MEET - EVENING", "cast": [{"id": 0, "name": "COACH TREVOR PIKE", "names": ["COACH TREVOR PIKE", "PIKE"], "gender": "?", "first": 5, "spoke": 6}, {"id": 1, "name": "DANI KOWALCZYK", "names": ["DANI KOWALCZYK", "DANI"], "gender": "f", "first": 6, "spoke": 4}, {"id": 2, "name": "ANNELIESE VEGA", "names": ["ANNELIESE VEGA"], "gender": "f", "first": 12, "spoke": 0}, {"id": 3, "name": "STARTER", "names": ["STARTER"], "gender": "?", "first": 24, "spoke": 1}, {"id": 4, "name": "TEENAGE TIMEKEEPER", "names": ["TEENAGE TIMEKEEPER", "TIMEKEEPER"], "gender": "?", "first": 35, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. PUBLIC POOL - SWIM MEET - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Chlorine haze.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Echoing whistles.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Lane ropes in red and white.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Parents crowd the bleachers with foam fingers.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "COACH TREVOR PIKE, 40s, in a wind jacket and a stopwatch lanyard, kneels at the edge of lane four, speaking low.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "At his feet, DANI KOWALCZYK, 17, in a cap and goggles, rocks on her heels.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "She'll be on your left. Don't watch her.", "name": "PIKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "I won't.", "name": "DANI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "You will.", "name": "PIKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I will.", "name": "DANI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He grins and squeezes her shoulder.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Across the deck, in lane five, ANNELIESE VEGA, 17, shakes out her arms.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Her coach says something.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "She answers without looking.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Her eyes are on Dani.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Dani looks back.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Neither blinks.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "She beat your time last week.", "name": "PIKE", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I know.", "name": "DANI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "She's going to start fast.", "name": "PIKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "So will I.", "name": "DANI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "The starter walks to the end of the deck.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "A hush spreads over the bleachers.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Swimmers, take your marks.", "name": "STARTER", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Dani steps onto the block.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Anneliese steps onto hers.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "They bend.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "A gun cracks.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Both dive.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "The water closes over them like glass.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Pike jogs along the side, timer in fist.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Dani and Anneliese surface together and churn, white water, arms rising in perfect rhythm.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "At the halfway turn, they flip within a breath of each other.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "A girl in the stands screams.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "A TEENAGE TIMEKEEPER, 15, in a borrowed volunteer shirt, appears beside Pike with a clipboard, wide-eyed.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Coach, which one is yours?", "name": "TIMEKEEPER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "The one on the left.", "name": "PIKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "They're both on the left.", "name": "TIMEKEEPER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Then the one who's winning.", "name": "PIKE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "She grins.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "The swimmers surge toward the wall.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Anneliese reaches first by half a hand.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Dani slaps the tile a hair behind.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "The scoreboard blinks.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Both girls hang from the lane rope, gasping, staring at the numbers.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Anneliese raises one fist.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Dani turns her face to the water, and the goggles hide her eyes.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4]}]}