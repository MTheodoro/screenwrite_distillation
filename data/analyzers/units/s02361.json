{"scene_id": "s02361", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02361.fountain", "heading": "INT. TROLL BRIDGE TOLLHOUSE - DUSK", "cast": [{"id": 0, "name": "BRUNHILDE GRUMBLEDOWN", "names": ["BRUNHILDE GRUMBLEDOWN", "BRUNHILDE"], "gender": "f", "first": 5, "spoke": 3}, {"id": 1, "name": "ULFRIC", "names": ["ULFRIC"], "gender": "?", "first": 7, "spoke": 2}, {"id": 2, "name": "ERLANDEL", "names": ["ERLANDEL"], "gender": "m", "first": 8, "spoke": 2}, {"id": 3, "name": "SPRIGGET", "names": ["SPRIGGET"], "gender": "f", "first": 9, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. TROLL BRIDGE TOLLHOUSE - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "A stone hut under a mossy arch.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A kettle on a hook.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Coins in neat stacks.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain taps the slate roof.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "BRUNHILDE GRUMBLEDOWN, 100s, a troll in a patched apron, stirs the kettle.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her knuckles are mossy, her hands slow.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Her son, ULFRIC, 40s, sits in a corner with his huge back to her, whittling a bone flute that will never be finished.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "A lean elf, ERLANDEL, 20s, slips in from the rain and shakes out his cloak; he slides three silver coins onto the counter without a word.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "A small goblin girl, SPRIGGET, 8, perches on the windowsill and swings her feet.", "para": 1, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Evening, Mother Brunhilde.", "name": "ERLANDEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Erlandel. You're thinner.", "name": "BRUNHILDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "The road is long.", "name": "ERLANDEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "So is the winter.", "name": "BRUNHILDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Ulfric does not turn.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "The flute scrapes.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Sprigget leans toward Erlandel and whispers, loudly.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "He hasn't spoken since the flood.", "name": "SPRIGGET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "I speak.", "name": "ULFRIC", "speaker": 1, "ext": [], "paren": ["low, to the wall"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Ulfric.", "name": "BRUNHILDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "I speak when there's something worth saying.", "name": "ULFRIC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Brunhilde ladles tea into four cups and sets them on the counter, one at a time, nudging the last toward her son.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "He reaches back without looking and takes it.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Erlandel drinks.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Sprigget hops down, steals a coin, and slips it into her sleeve while everyone pretends to watch the kettle.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Rain pours.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}]}