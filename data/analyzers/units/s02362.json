{"scene_id": "s02362", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02362.fountain", "heading": "INT. LIGHTHOUSE LAMP ROOM - STORM - NIGHT", "cast": [{"id": 0, "name": "INSPECTOR HOLLOWAY BRAITHWAITE", "names": ["INSPECTOR HOLLOWAY BRAITHWAITE", "BRAITHWAITE"], "gender": "?", "first": 5, "spoke": 6}, {"id": 1, "name": "KEEPER MARIGOLD FINCH", "names": ["KEEPER MARIGOLD FINCH", "FINCH"], "gender": "?", "first": 6, "spoke": 1}, {"id": 2, "name": "ANSELM OYEDELE", "names": ["ANSELM OYEDELE", "OYEDELE"], "gender": "?", "first": 7, "spoke": 2}, {"id": 3, "name": "SISTER CORDELIA", "names": ["SISTER CORDELIA", "CORDELIA"], "gender": "?", "first": 8, "spoke": 1}, {"id": 4, "name": "DESDEMONA QUILL", "names": ["DESDEMONA QUILL", "QUILL"], "gender": "?", "first": 9, "spoke": 1}, {"id": 5, "name": "COASTGUARD", "names": ["COASTGUARD"], "gender": "?", "first": 22, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. LIGHTHOUSE LAMP ROOM - STORM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A circular room of glass and brass.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The great lens turns slowly, throwing beams across black water.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain slaps the windows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Five people crowd the narrow gallery, wet coats steaming.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "INSPECTOR HOLLOWAY BRAITHWAITE, 50s, trench coat, notebook, studies the room.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "KEEPER MARIGOLD FINCH, 60s, grips a lantern.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "DR. ANSELM OYEDELE, 40s, holds a medical bag.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "SISTER CORDELIA, 30s, fingers a rosary.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "And the boat captain, DESDEMONA QUILL, 50s, arms folded by the stairs.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "A body lies under a tarp at the center of the floor.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Nobody leaves until I say.", "name": "BRAITHWAITE", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "The tide says otherwise.", "name": "QUILL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Then the tide can wait.", "name": "BRAITHWAITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Fourteen years and not one drowned. Now this.", "name": "FINCH", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "He wasn't drowned.", "name": "OYEDELE", "speaker": 2, "ext": [], "paren": ["to Braithwaite"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "How do you know?", "name": "BRAITHWAITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Because there's no water in his lungs.", "name": "OYEDELE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "A beat.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "The lens beam sweeps across the faces, one by one.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "I saw nothing.", "name": "CORDELIA", "speaker": 3, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "A radio on the wall crackles.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Lighthouse, this is Coastguard. Storm has closed the channel. Repeat, no boats until dawn.", "name": "COASTGUARD", "speaker": 5, "ext": ["V.O."], "paren": ["over radio, thin"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Understood. Hold position.", "name": "BRAITHWAITE", "speaker": 0, "ext": [], "paren": ["to the radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Is anyone injured?", "name": "COASTGUARD", "speaker": 5, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Not anymore.", "name": "BRAITHWAITE", "speaker": 0, "ext": [], "paren": ["glancing at the tarp"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "He switches off the radio.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "The beam sweeps again.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "This time he is watching Finch.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "I'll ask once. Who was at the lamp when it went dark?", "name": "BRAITHWAITE", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the whole room"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Nobody answers.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Then, far above, the lens stops turning.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}