{"scene_id": "s02363", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02363.fountain", "heading": "INT. HOSPITAL ROOFTOP GARDEN - MORNING", "cast": [{"id": 0, "name": "IMELDA FAIRWEATHER-NKEMELU", "names": ["IMELDA FAIRWEATHER-NKEMELU"], "gender": "?", "first": 6, "spoke": 0}, {"id": 1, "name": "ARTHUR PENHALIGON", "names": ["ARTHUR PENHALIGON", "PENHALIGON"], "gender": "?", "first": 9, "spoke": 10}, {"id": 2, "name": "JULIETTE PENHALIGON", "names": ["JULIETTE PENHALIGON", "JULIETTE"], "gender": "f", "first": 9, "spoke": 2}, {"id": 3, "name": "NURSE BEATRIX OYELAKIN", "names": ["NURSE BEATRIX OYELAKIN", "BEATRIX"], "gender": "?", "first": 13, "spoke": 1}, {"id": 4, "name": "DR. FAIRWEATHER", "names": ["DR. FAIRWEATHER"], "gender": "?", "first": 6, "spoke": 11}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOSPITAL ROOFTOP GARDEN - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "A walled terrace above the oncology wing.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Raised beds of lavender and rosemary.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wrought-iron benches, a trellis of late roses.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Pigeons strut.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The city hums far below.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "DR. IMELDA FAIRWEATHER-NKEMELU, 50s, in a white coat gone limp, sits on a bench with a paper cup.", "para": 1, "sent": 0, "present": [0, 4]}, {"u": 7, "kind": "action", "text": "She has not slept.", "para": 1, "sent": 1, "present": [0, 4]}, {"u": 8, "kind": "action", "text": "A gray streak runs through her hair.", "para": 1, "sent": 2, "present": [0, 4]}, {"u": 9, "kind": "action", "text": "MR. ARTHUR PENHALIGON, 70s, in a hospital gown and a corduroy cardigan, sits beside her, IV pole parked at his knee.", "para": 2, "sent": 0, "present": [0, 1, 2, 4]}, {"u": 10, "kind": "action", "text": "His cheeks are hollow.", "para": 2, "sent": 1, "present": [0, 1, 2, 4]}, {"u": 11, "kind": "action", "text": "His eyes are very clear.", "para": 2, "sent": 2, "present": [0, 1, 2, 4]}, {"u": 12, "kind": "action", "text": "His daughter, JULIETTE PENHALIGON, 40s, in a trench coat, perches on the bench's arm, hands clasped.", "para": 3, "sent": 0, "present": [0, 1, 2, 4]}, {"u": 13, "kind": "action", "text": "A nurse, NURSE BEATRIX OYELAKIN, 30s, in blue scrubs, hovers at the door with a clipboard.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "You'll tell it plainly, Doctor.", "name": "PENHALIGON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Yes.", "name": "DR. FAIRWEATHER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Good. Everyone else has been very gentle.", "name": "PENHALIGON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "The scan shows the tumor has spread to the liver.", "name": "DR. FAIRWEATHER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "How long?", "name": "PENHALIGON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Weeks. Perhaps a few months.", "name": "DR. FAIRWEATHER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Dad.", "name": "JULIETTE", "speaker": 2, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "It's all right, Juliette.", "name": "PENHALIGON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "We can keep you comfortable. We can plan the time.", "name": "DR. FAIRWEATHER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Plan.", "name": "PENHALIGON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Yes.", "name": "DR. FAIRWEATHER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "I have been planning since I was a young man. I planned to write a novel. I planned to see Lisbon.", "name": "PENHALIGON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Have you seen Lisbon?", "name": "DR. FAIRWEATHER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Never.", "name": "PENHALIGON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Then there is something to plan.", "name": "DR. FAIRWEATHER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "You are a surprising doctor.", "name": "PENHALIGON", "speaker": 1, "ext": [], "paren": ["a thin smile"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "I have been told.", "name": "DR. FAIRWEATHER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Can he travel?", "name": "JULIETTE", "speaker": 2, "ext": [], "paren": ["to the doctor"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "With supervision. In two weeks. Not more.", "name": "DR. FAIRWEATHER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Doctor, the families are waiting in Bay Three.", "name": "BEATRIX", "speaker": 3, "ext": [], "paren": ["from the door"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Two minutes.", "name": "DR. FAIRWEATHER", "speaker": 4, "ext": [], "paren": ["rising, to Beatrix"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Doctor.", "name": "PENHALIGON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Yes, Mr. Penhaligon.", "name": "DR. FAIRWEATHER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Thank you for sitting.", "name": "PENHALIGON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "She nods.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Touches his shoulder for a moment, light as a petal, and goes.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "The door closes.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "A pigeon lands on the trellis.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Juliette takes her father's hand.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "He looks at the lavender.", "para": 5, "sent": 5, "present": [0, 1, 2, 3, 4]}]}