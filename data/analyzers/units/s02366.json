{"scene_id": "s02366", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02366.fountain", "heading": "INT. NIGHT BUS DEPOT - WAITING ROOM - NIGHT", "cast": [{"id": 0, "name": "LORENZA ABDULLAHI", "names": ["LORENZA ABDULLAHI"], "gender": "f", "first": 7, "spoke": 0}, {"id": 1, "name": "STATION ANNOUNCER", "names": ["STATION ANNOUNCER"], "gender": "?", "first": 17, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT BUS DEPOT - WAITING ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent tubes buzz.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Plastic seats bolted in rows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A vending machine hums, its glass fogged.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A schedule board shows every departure as DELAYED.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The door opens.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "A gust of cold.", "para": 1, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "LORENZA ABDULLAHI, 50s, in a long wool coat and a knit cap, drags a small wheeled suitcase over the threshold.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "She stops.", "para": 1, "sent": 3, "present": [0]}, {"u": 9, "kind": "action", "text": "Looks around.", "para": 1, "sent": 4, "present": [0]}, {"u": 10, "kind": "action", "text": "No one else.", "para": 1, "sent": 5, "present": [0]}, {"u": 11, "kind": "action", "text": "She chooses a seat near the machine and sits, the suitcase upright beside her like a patient child.", "para": 1, "sent": 6, "present": [0]}, {"u": 12, "kind": "action", "text": "She takes out a thermos.", "para": 2, "sent": 0, "present": [0]}, {"u": 13, "kind": "action", "text": "Pours.", "para": 2, "sent": 1, "present": [0]}, {"u": 14, "kind": "action", "text": "Her hands shake slightly.", "para": 2, "sent": 2, "present": [0]}, {"u": 15, "kind": "action", "text": "She drinks.", "para": 2, "sent": 3, "present": [0]}, {"u": 16, "kind": "action", "text": "A public address speaker clicks.", "para": 3, "sent": 0, "present": [0]}, {"u": 17, "kind": "dialogue", "text": "Attention passengers. The ten-fifteen to Redding has been delayed. We apologize for the inconvenience.", "name": "STATION ANNOUNCER", "speaker": 1, "ext": ["V.O."], "paren": ["over speaker, tinny"], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Lorenza checks her watch.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "It is ten-forty.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "New departure time: unknown.", "name": "STATION ANNOUNCER", "speaker": 1, "ext": ["V.O.", "CONT'D"], "paren": ["over speaker"], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She screws the cap on the thermos.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Sets it in her lap.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She looks at the empty seats, one by one, as if counting.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She opens her handbag.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Takes out a folded letter.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Reads the first line.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Reads it again.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Refolds it and slides it back.", "para": 6, "sent": 4, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "The vending machine rattles and drops something into its tray, unprompted.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Lorenza looks at it for a long moment.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "She stands, crosses to it, bends, and lifts out a packet of peanuts.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "She turns it over.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Opens it.", "para": 7, "sent": 4, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Eats one.", "para": 7, "sent": 5, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Passengers are advised to remain in the waiting area.", "name": "STATION ANNOUNCER", "speaker": 1, "ext": ["V.O.", "CONT'D"], "paren": ["over speaker"], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Lorenza returns to her seat.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Smooths her coat over her knees.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Sits very straight, and waits.", "para": 8, "sent": 2, "present": [0, 1]}]}