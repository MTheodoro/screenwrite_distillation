{"scene_id": "s02367", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02367.fountain", "heading": "INT. FLOODED PARISH CHURCH - BELFRY STAIRCASE - NIGHT", "cast": [{"id": 0, "name": "FATHER AUGUSTINE BELLWEATHER", "names": ["FATHER AUGUSTINE BELLWEATHER", "FATHER BELLWEATHER"], "gender": "?", "first": 5, "spoke": 7}, {"id": 1, "name": "BARTY", "names": ["BARTY"], "gender": "m", "first": 7, "spoke": 8}, {"id": 2, "name": "GRAVES", "names": ["GRAVES"], "gender": "?", "first": 7, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. FLOODED PARISH CHURCH - BELFRY STAIRCASE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A narrow stone stair spiraling up inside the bell tower.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Black water laps the lower steps, thick with floating hymnals.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single candle burns in a niche.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Wind moans through the louvers above.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "FATHER AUGUSTINE BELLWEATHER, 60s, in a soaked cassock, climbs backward up the stairs, a crucifix held out like a shield.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "His breath comes in small, terrified gasps.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Below him, in the water, something rises: BARTHOLOMEW \"BARTY\" GRAVES, 40s, the sexton, drowned-pale, eyes open, his coat streaming.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "He climbs the stairs hand over hand, unhurried, smiling.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Barty. Stay where you are.", "name": "FATHER BELLWEATHER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Father. It's cold down here.", "name": "BARTY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I know. I know it is.", "name": "FATHER BELLWEATHER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "You left me.", "name": "BARTY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "I went for help.", "name": "FATHER BELLWEATHER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "You went for the key.", "name": "BARTY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "The priest stops.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "His heel finds the next stair.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "He grips the rail.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "The bell is not for you, Barty.", "name": "FATHER BELLWEATHER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Then who is it for?", "name": "BARTY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "It is for all of us.", "name": "FATHER BELLWEATHER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Ring it.", "name": "BARTY", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "A telephone rings.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Somewhere high in the belfry, an old black rotary set, impossible, plugged into nothing.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "It rings and rings.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Father Bellweather, please pick up.", "name": "BARTY", "speaker": 1, "ext": ["V.O."], "paren": ["from the phone, distant"], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "God have mercy.", "name": "FATHER BELLWEATHER", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "That is not me.", "name": "BARTY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Father, please. I'm waiting.", "name": "BARTY", "speaker": 1, "ext": ["V.O."], "paren": ["from the phone"], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "The priest turns his face toward the sound.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Barty reaches a pale hand to his ankle.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The candle gutters.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Water rises another step.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Then let me answer.", "name": "FATHER BELLWEATHER", "speaker": 0, "ext": [], "paren": ["very quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "He tears free, lunges up the last turn of the stairs, and the dark closes behind him like a door.", "para": 6, "sent": 0, "present": [0, 1, 2]}]}