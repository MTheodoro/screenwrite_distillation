{"scene_id": "s02371", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02371.fountain", "heading": "INT. 24-HOUR LAUNDROMAT - NIGHT", "cast": [{"id": 0, "name": "WREN", "names": ["WREN"], "gender": "?", "first": 3, "spoke": 3}, {"id": 1, "name": "TEO", "names": ["TEO"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "ABARA", "names": ["ABARA", "MRS. ABARA"], "gender": "?", "first": 17, "spoke": 1}, {"id": 4, "name": "BAZ", "names": ["BAZ"], "gender": "?", "first": 23, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. 24-HOUR LAUNDROMAT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent hum.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dryers turning, nobody watching.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "WREN, thirties, sits on a folding table with a paperback open.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "She hasn't turned a page in ten minutes.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "action", "text": "Across the room, TEO, nineteen, feeds quarters into a machine that doesn't need them.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "A STRANGER in a wet raincoat enters.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Sets a duffel on the counter.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Looks at neither of them.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Machine four broken?", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Eats quarters.", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He nods.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Doesn't move.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She turns a page.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Teo drops a coin.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "It rolls.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Nobody picks it up.", "para": 3, "sent": 5, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "MRS. ABARA, seventies, folds towels behind the counter, slow and exact.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Eleven-forty. Dryers lock at midnight.", "name": "MRS. ABARA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Plenty of time.", "name": "STRANGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "He unzips the duffel one inch.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Zips it again.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Wren watches the zipper, then the book.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "You're Baz.", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Who's asking.", "name": "BAZ", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Nobody. Machine four's yours.", "name": "WREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "He takes the duffel to machine four.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Opens the door.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Climbs the stool.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Reaches behind the drum.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Teo, still not looking, feeds in another quarter.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}]}