{"scene_id": "s02373", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02373.fountain", "heading": "INT. MINIATURE GOLF CLUBHOUSE - DAY", "cast": [{"id": 0, "name": "CAPTAIN HOOK'S INVITATIONAL", "names": ["CAPTAIN HOOK'S INVITATIONAL"], "gender": "?", "first": 4, "spoke": 0}, {"id": 1, "name": "BARNABY PLOTT", "names": ["BARNABY PLOTT", "BARNABY"], "gender": "m", "first": 5, "spoke": 12}, {"id": 2, "name": "DEE", "names": ["DEE"], "gender": "f", "first": 6, "spoke": 12}, {"id": 3, "name": "OKAFOR-LINDQVIST", "names": ["OKAFOR-LINDQVIST"], "gender": "?", "first": 6, "spoke": 0}, {"id": 4, "name": "MARCUS VANCE", "names": ["MARCUS VANCE", "MARCUS", "VANCE"], "gender": "m", "first": 7, "spoke": 15}, {"id": 5, "name": "TALL STRANGER", "names": ["TALL STRANGER", "STRANGER"], "gender": "?", "first": 34, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. MINIATURE GOLF CLUBHOUSE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A snack-bar-and-trophy-case combo built to look like a pirate ship, with a fibreglass parrot bolted over the register.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The carpet is the green of a sick lawn.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain taps the porthole windows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A hand-lettered banner reads: CAPTAIN HOOK'S INVITATIONAL - FINAL ROUND.", "para": 0, "sent": 3, "present": [0]}, {"u": 5, "kind": "action", "text": "BARNABY PLOTT, sixties, beard dyed an unnatural black, in a captain's hat and a tracksuit, polishes a plastic trophy with a napkin.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "At the counter, DOLORES \"DEE\" OKAFOR-LINDQVIST, forties, a brisk accountant in a rain slicker, studies a clipboard.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "In a booth, young MARCUS VANCE, twenty, wears a bowling shirt and sips a slushie with great solemnity.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "So the prize pool is four hundred dollars.", "name": "DEE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Four hundred and twelve. Counting the raffle.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "And the entry fees were forty each, eleven entrants.", "name": "DEE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Correct.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Then the prize pool is four forty.", "name": "DEE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Ah. Well. There's the hat.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Barnaby.", "name": "DEE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "The hat was twenty-eight dollars.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "It's a good hat.", "name": "MARCUS", "speaker": 4, "ext": [], "paren": ["through straw"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Nobody asked you.", "name": "DEE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Sorry.", "name": "MARCUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "A beat of calm.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Barnaby sets the trophy on the shelf.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Dee clicks her pen shut.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "The rain eases.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "For a moment the whole place feels cosy.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "You know, I think this is the best year we've had.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "It might be.", "name": "DEE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "The windmill was running smooth this morning.", "name": "MARCUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "That windmill has not run smooth since the Reagan administration.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Well. It did today.", "name": "MARCUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Who's the other finalist?", "name": "DEE", "speaker": 2, "ext": [], "paren": ["still writing"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Some fellow. Showed up at nine, paid cash. Name on the sheet is... Smith.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Just Smith.", "name": "DEE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "I assumed he was shy.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "The door opens.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "A TALL STRANGER in a trench coat enters, shaking out an umbrella.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Sixty, silver hair, eyes like cold coins.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "He walks to the counter and sets a putter on it.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "I'm here for the final.", "name": "STRANGER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Mister Smith! Wonderful. Dee, this is the competition.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "It's not Smith.", "name": "STRANGER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Pardon?", "name": "DEE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "It's Vance.", "name": "STRANGER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Marcus chokes on his slushie.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Barnaby looks from the stranger to Marcus and back.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Dee puts down her pen.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Dad?", "name": "MARCUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Hello, Marcus.", "name": "VANCE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "You two know each other?", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "He told me he was dead.", "name": "MARCUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "I told you I was in Arizona.", "name": "VANCE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "For nine years.", "name": "MARCUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "Mr. Vance, we don't actually have a rule about estranged fathers, but I think I should say the raffle money is already spent.", "name": "DEE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "Spent on the hat.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "Barnaby.", "name": "DEE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "I read about the tournament in the paper. Your name was on the entry list. I thought, he's still playing.", "name": "VANCE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "I never stopped.", "name": "MARCUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "I know. I used to watch you through the fence.", "name": "VANCE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "Barnaby takes off the hat and holds it to his chest.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "Dee's eyes go wide.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "Nobody speaks.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "action", "text": "The parrot above the register creaks on its bolt.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "dialogue", "text": "Fine. Eighteen holes. Winner buys lunch.", "name": "MARCUS", "speaker": 4, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "dialogue", "text": "And the loser?", "name": "VANCE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "dialogue", "text": "Asks the other one a question.", "name": "MARCUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "Vance nods once.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "He picks up his putter.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "action", "text": "Marcus slides out of the booth with his own, an old one with tape on the grip.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "dialogue", "text": "I think that's the best tournament we've ever had.", "name": "BARNABY", "speaker": 1, "ext": [], "paren": ["whispering to Dee"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "dialogue", "text": "I'm still short twelve dollars.", "name": "DEE", "speaker": 2, "ext": [], "paren": ["whispering back"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}