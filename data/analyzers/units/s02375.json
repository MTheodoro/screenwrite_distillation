{"scene_id": "s02375", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02375.fountain", "heading": "EXT. RIVER FERRY LANDING - NOON", "cast": [{"id": 0, "name": "OSCAR PIKE", "names": ["OSCAR PIKE", "OSCAR"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 6, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. RIVER FERRY LANDING - NOON", "present": []}, {"u": 1, "kind": "action", "text": "A flat raft on a rope.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Mud bank.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Two mules asleep standing.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "OSCAR PIKE, sixty, ferryman, sits on a barrel, whittling.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Doesn't look up.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "A STRANGER rides down the bank.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Dusty hat.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Rifle across the saddle.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Stops at the water's edge.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Two bits a horse.", "name": "OSCAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "One horse.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Then two bits.", "name": "OSCAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "The stranger pays.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Dismounts.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Leads the horse onto the raft.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Oscar sets down the knife, stands, takes the rope.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Easy now, you lot.", "name": "OSCAR", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the mules"], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "They push off.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Water slaps the planks.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Halfway across the stranger speaks.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "You ever hear of a man called Hollis Dane?", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Lord help me.", "name": "OSCAR", "speaker": 0, "ext": [], "paren": ["muttering, to himself"], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "That's a no?", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Name's familiar. Nothing more.", "name": "OSCAR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "The stranger nods.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Takes off his hat.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Wipes the band with a thumb.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Dane. That's my name now.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Oscar keeps hauling the rope.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Doesn't miss a pull.", "para": 6, "sent": 1, "present": [0, 1]}]}