{"scene_id": "s02376", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02376.fountain", "heading": "INT. MINIVAN - AUTOMATIC CAR WASH - DAY", "cast": [{"id": 0, "name": "ADAEZE OBI", "names": ["ADAEZE OBI", "ADAEZE"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "GREG OBI", "names": ["GREG OBI", "GREG"], "gender": "m", "first": 4, "spoke": 6}, {"id": 2, "name": "TEENAGER", "names": ["TEENAGER"], "gender": "?", "first": 7, "spoke": 3}, {"id": 3, "name": "SAMIR", "names": ["SAMIR"], "gender": "?", "first": 24, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. MINIVAN - AUTOMATIC CAR WASH - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Dark.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Brushes thump the roof.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Soap slides down the glass.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ADAEZE OBI, forties, grips the wheel.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Eyes ahead.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Her husband GREG OBI, forties, in the passenger seat, scrolls his phone.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "In the back, a TEENAGER in a hoodie stares at the ceiling.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Two days. That's all I'm saying.", "name": "GREG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "You've said it four times.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Because nobody answers.", "name": "GREG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "The brush hits the windshield.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Foam.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Roar.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "He's right here. Ask him.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "I'm asking you.", "name": "GREG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "The teenager pulls out an earbud.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I'm not going.", "name": "TEENAGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Nobody asked you.", "name": "GREG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "You literally just did.", "name": "TEENAGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Don't talk to your father like that.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Like what? Like I have an opinion?", "name": "TEENAGER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Greg turns in his seat.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Adaeze's knuckles whiten.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Samir. Look at me.", "name": "GREG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "No.", "name": "SAMIR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Samir.", "name": "GREG", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "You're not even driving!", "name": "SAMIR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "The rollers shriek.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "The van lurches.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Adaeze slams the brake and the car wash stalls with a groan.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Water drips.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "No one speaks.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Both of you. Out. Now.", "name": "ADAEZE", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "She unbuckles.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Opens her door.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Steps into the foam.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}]}