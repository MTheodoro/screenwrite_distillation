{"scene_id": "s02382", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02382.fountain", "heading": "INT. WIRELESS HUT - ATLANTIC COAST - NIGHT, 1941", "cast": [{"id": 0, "name": "CORPORAL EMMELINE ROSKILLY", "names": ["CORPORAL EMMELINE ROSKILLY", "EMMELINE"], "gender": "?", "first": 5, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. WIRELESS HUT - ATLANTIC COAST - NIGHT, 1941", "present": []}, {"u": 1, "kind": "action", "text": "A low shed of sandbags and corrugated iron.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single oil lamp swings from a hook.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The sea batters the rocks outside.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "On a deal table, a wire recorder spins slowly beside a heavy radio set with a brass key.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CORPORAL EMMELINE ROSKILLY, twenties, in a greatcoat and a woollen cap, sits upright on a crate.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A headset is clamped over one ear.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Her pencil moves steadily over a message pad.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "She has not blinked in some time.", "para": 1, "sent": 3, "present": [0]}, {"u": 9, "kind": "action", "text": "The radio crackles.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "Over it, a steady drone: enemy bombers, far off, growing nearer.", "para": 2, "sent": 1, "present": [0]}, {"u": 11, "kind": "dialogue", "text": "Steady, girl.", "name": "EMMELINE", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0]}, {"u": 12, "kind": "action", "text": "She taps the key.", "para": 3, "sent": 0, "present": [0]}, {"u": 13, "kind": "action", "text": "Pauses.", "para": 3, "sent": 1, "present": [0]}, {"u": 14, "kind": "action", "text": "Taps again.", "para": 3, "sent": 2, "present": [0]}, {"u": 15, "kind": "action", "text": "The recorder spins, catching her.", "para": 3, "sent": 3, "present": [0]}, {"u": 16, "kind": "dialogue", "text": "Station Albatross to all vessels. Enemy aircraft sighted bearing two-seven-zero. Repeat, two-seven-zero. Take cover.", "name": "EMMELINE", "speaker": 0, "ext": ["V.O."], "paren": ["recording"], "dual": false, "present": [0]}, {"u": 17, "kind": "action", "text": "The lamp swings.", "para": 4, "sent": 0, "present": [0]}, {"u": 18, "kind": "action", "text": "A distant thump shakes dust from the rafters.", "para": 4, "sent": 1, "present": [0]}, {"u": 19, "kind": "action", "text": "She does not look up.", "para": 4, "sent": 2, "present": [0]}, {"u": 20, "kind": "action", "text": "She taps the key again.", "para": 4, "sent": 3, "present": [0]}, {"u": 21, "kind": "dialogue", "text": "Albatross to convoy. Confirm receipt.", "name": "EMMELINE", "speaker": 0, "ext": ["CONT'D"], "paren": ["into mouthpiece"], "dual": false, "present": [0]}, {"u": 22, "kind": "action", "text": "Nothing.", "para": 5, "sent": 0, "present": [0]}, {"u": 23, "kind": "action", "text": "Static.", "para": 5, "sent": 1, "present": [0]}, {"u": 24, "kind": "action", "text": "The drone rises to a roar.", "para": 5, "sent": 2, "present": [0]}, {"u": 25, "kind": "action", "text": "She reaches for the recorder and rewinds it a few inches.", "para": 6, "sent": 0, "present": [0]}, {"u": 26, "kind": "action", "text": "Plays it back.", "para": 6, "sent": 1, "present": [0]}, {"u": 27, "kind": "action", "text": "Her own voice again, steady.", "para": 6, "sent": 2, "present": [0]}, {"u": 28, "kind": "dialogue", "text": "Take cover.", "name": "EMMELINE", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": ["recording"], "dual": false, "present": [0]}, {"u": 29, "kind": "action", "text": "Another thump, closer.", "para": 7, "sent": 0, "present": [0]}, {"u": 30, "kind": "action", "text": "The lamp goes out.", "para": 7, "sent": 1, "present": [0]}, {"u": 31, "kind": "action", "text": "In the dark, her hands keep working the key, tap, tap, tap, as the walls shake around her.", "para": 7, "sent": 2, "present": [0]}, {"u": 32, "kind": "dialogue", "text": "Confirm receipt. Confirm receipt. Confirm...", "name": "EMMELINE", "speaker": 0, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0]}, {"u": 33, "kind": "action", "text": "A ragged voice breaks through the static, faint, hers alone in the room, played from the spinning spool.", "para": 8, "sent": 0, "present": [0]}, {"u": 34, "kind": "dialogue", "text": "Take cover.", "name": "EMMELINE", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": ["recording"], "dual": false, "present": [0]}, {"u": 35, "kind": "action", "text": "She keeps tapping.", "para": 9, "sent": 0, "present": [0]}]}