{"scene_id": "s02383", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02383.fountain", "heading": "INT. COURTHOUSE ELEVATOR - DAY", "cast": [{"id": 0, "name": "NOOR FARHAT", "names": ["NOOR FARHAT", "NOOR"], "gender": "m", "first": 5, "spoke": 6}, {"id": 1, "name": "LUCAS BRENNER", "names": ["LUCAS BRENNER", "LUCAS"], "gender": "m", "first": 6, "spoke": 6}, {"id": 2, "name": "MARSHAL DELACROIX-ITO", "names": ["MARSHAL DELACROIX-ITO", "DELACROIX-ITO"], "gender": "m", "first": 7, "spoke": 3}, {"id": 3, "name": "MAN IN GREY SUIT", "names": ["MAN", "MAN IN GREY SUIT"], "gender": "?", "first": 7, "spoke": 4}, {"id": 4, "name": "GREY SUIT", "names": ["GREY SUIT"], "gender": "?", "first": 7, "spoke": 0}, {"id": 5, "name": "VOSS", "names": ["VOSS"], "gender": "?", "first": 35, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. COURTHOUSE ELEVATOR - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Brushed steel.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A brass plate reads MAX 8.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The display above the door shows 4, then goes dark.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The car jolts and stops.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "NOOR FARHAT, thirties, plaintiff's counsel, grips a rolling briefcase.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "LUCAS BRENNER, forties, defence counsel, checks his watch.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "U.S. MARSHAL DELACROIX-ITO, fifties, heavyset, stands against the back wall with arms crossed, and beside him a MAN IN A GREY SUIT, sixty, holds a banker's box against his chest like a shield.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "Emergency light.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "Hum.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Silence.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Nobody panic.", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Nobody's panicking.", "name": "LUCAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "I'm calling it in.", "name": "DELACROIX-ITO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "He thumbs the call button.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Static from the speaker.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "We have a nine-thirty.", "name": "LUCAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "We have a nine-thirty. You have a motion to suppress.", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Which you'll lose.", "name": "LUCAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Which I won't.", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "The grey-suited man shifts the box.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Noor notices.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Lucas notices.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Delacroix-Ito does not, because he is listening to the speaker.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Who are you?", "name": "NOOR", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the man"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Records clerk. Sub-basement.", "name": "MAN IN GREY SUIT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "At a nine-thirty hearing?", "name": "LUCAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "I was told to bring this up.", "name": "MAN IN GREY SUIT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Lucas steps toward him.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Noor steps with him.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Delacroix-Ito peels off the wall, one hand drifting to his belt, and the three of them close in around the box as the light flickers and the man backs into a corner with nowhere left to go.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Open it.", "name": "LUCAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "I can't.", "name": "MAN IN GREY SUIT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Open it.", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Marshal-", "name": "MAN IN GREY SUIT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Mister Voss, isn't it? Ernest Voss?", "name": "DELACROIX-ITO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Yes.", "name": "VOSS", "speaker": 5, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "Open the box, Ernest.", "name": "DELACROIX-ITO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Voss lifts the lid.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Inside, a stack of yellowed folders and a small revolver, wrapped in a handkerchief.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "The speaker crackles with something about maintenance.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Nobody listens.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "That's the evidence from the Hendricks file.", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "That was destroyed.", "name": "LUCAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "So was I.", "name": "VOSS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "The elevator lurches.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "The display flickers to 4.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "The door begins to open on a hallway full of lawyers, and Voss, holding the box, looks at the faces waiting there and does not step out.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}