{"scene_id": "s02384", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02384.fountain", "heading": "INT. ROLLER RINK - 2 A.M.", "cast": [{"id": 0, "name": "DANI", "names": ["DANI"], "gender": "f", "first": 4, "spoke": 2}, {"id": 1, "name": "KOFI", "names": ["KOFI"], "gender": "?", "first": 5, "spoke": 1}, {"id": 2, "name": "MEI", "names": ["MEI"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "RAFA", "names": ["RAFA"], "gender": "?", "first": 7, "spoke": 1}, {"id": 4, "name": "LAZLO", "names": ["LAZLO"], "gender": "?", "first": 27, "spoke": 3}, {"id": 5, "name": "DJ", "names": ["DJ"], "gender": "?", "first": 27, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROLLER RINK - 2 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "Disco ball dead.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Floor lights low.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Speakers hiss.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DANI, seventeen, laces her skates on the carpeted bench.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside her, KOFI sits with his helmet in his lap.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "MEI leans on the rail, chewing a straw.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "RAFA, the baby of the group, sits cross-legged on the floor.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "She stands.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Wobbles.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "He catches her elbow.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Don't.", "name": "DANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "I'm not.", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "He lets go.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "She rolls out onto the maple.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Slow.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Steady.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Then faster.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "We're not supposed to be here.", "name": "MEI", "speaker": 2, "ext": [], "paren": ["to the others"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "The door was open.", "name": "RAFA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Doors open when you break them.", "name": "MEI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Dani circles the rink and spins.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Her arms go wide.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "For a moment she's lit by the red EXIT sign alone.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "A light snaps on in the booth.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "A hand slams a switch.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "The music blares: a polka.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "MR. LAZLO, seventies, in a bathrobe and a rink-guard jacket, lumbers out of the DJ booth.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "He holds a bat.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Who's closing this place?", "name": "LAZLO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Nobody, sir.", "name": "DANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Then who's skating?", "name": "LAZLO", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Kofi raises a hand.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Mei raises a hand.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Rafa, after a beat, raises both.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Eight dollars a head. Cash.", "name": "LAZLO", "speaker": 4, "ext": ["CONT'D"], "paren": ["lowering the bat"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}