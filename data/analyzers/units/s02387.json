{"scene_id": "s02387", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02387.fountain", "heading": "INT. MEAT-PACKING COLD STORAGE - NIGHT", "cast": [{"id": 0, "name": "ROCCO DELAVEGA", "names": ["ROCCO DELAVEGA", "ROCCO"], "gender": "m", "first": 5, "spoke": 6}, {"id": 1, "name": "IMANI BROOKSHIRE-ADE", "names": ["IMANI BROOKSHIRE-ADE", "IMANI"], "gender": "?", "first": 6, "spoke": 5}, {"id": 2, "name": "DUTCH PELLEGRINO", "names": ["DUTCH PELLEGRINO", "DUTCH"], "gender": "m", "first": 7, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. MEAT-PACKING COLD STORAGE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Steel racks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Hanging sides of beef in plastic.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Breath clouds.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single caged bulb.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ROCCO DELAVEGA, fifties, in a wool overcoat, stands with his back to a swinging carcass.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "IMANI BROOKSHIRE-ADE, thirties, in a puffy parka, holds a duffel bag.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "DUTCH PELLEGRINO, forties, scarf over his mouth, keeps one hand in his pocket.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Count it.", "name": "ROCCO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "I counted it.", "name": "IMANI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Count it again.", "name": "ROCCO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "She unzips the bag.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Stacks of bills, rubber-banded.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She thumbs one.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Dutch watches her hands.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Light.", "name": "DUTCH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "It's not light.", "name": "IMANI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "It's light.", "name": "DUTCH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Is it?", "name": "ROCCO", "speaker": 0, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Imani shoves the bag across the floor.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Dutch pulls his hand from his pocket.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "A pistol.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Imani's own gun clears the parka at the same instant.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Rocco steps between them, palms up, and all three freeze.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Put them down.", "name": "ROCCO", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "You first.", "name": "IMANI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "You first.", "name": "DUTCH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "He's lying.", "name": "IMANI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "She's lying.", "name": "DUTCH", "speaker": 2, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Rocco lowers his hands and, with a sigh, takes a step back into the swinging beef.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "He hits it with his shoulder.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The carcass swings out, across the frame, between Imani and Dutch.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "They lunge.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "The pistols go off together, twice.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Meat jerks on its hook.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Rocco drops flat.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Imani rolls behind a rack.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Dutch scrambles for the bag, clawing at the zipper.", "para": 5, "sent": 5, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Come on, come on...", "name": "DUTCH", "speaker": 2, "ext": ["CONT'D"], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "A drip from the ceiling.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Three people breathing hard in the cold.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Anyone hit?", "name": "ROCCO", "speaker": 0, "ext": [], "paren": ["from the floor"], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "No.", "name": "IMANI", "speaker": 1, "ext": [], "paren": ["from behind the rack"], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "No.", "name": "DUTCH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Then count it again.", "name": "ROCCO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}