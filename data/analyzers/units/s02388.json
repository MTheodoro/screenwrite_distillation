{"scene_id": "s02388", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02388.fountain", "heading": "INT. HOUSEBOAT GALLEY - THANKSGIVING - DUSK", "cast": [{"id": 0, "name": "GRAN ODALYS BEAUCHAMP", "names": ["GRAN ODALYS BEAUCHAMP", "GRAN ODALYS"], "gender": "f", "first": 5, "spoke": 7}, {"id": 1, "name": "KEZIAH", "names": ["KEZIAH"], "gender": "?", "first": 6, "spoke": 5}, {"id": 2, "name": "PAVEL", "names": ["PAVEL"], "gender": "m", "first": 7, "spoke": 3}, {"id": 3, "name": "EZRA", "names": ["EZRA"], "gender": "?", "first": 7, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOUSEBOAT GALLEY - THANKSGIVING - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "A narrow kitchen the length of a railway carriage, every surface gleaming with small domestic order.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Condensation clouds the porthole.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Outside, lake water slaps the hull in the failing light.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A turkey rests under foil on the counter, steaming faintly.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "GRAN ODALYS BEAUCHAMP, seventy, sits at the end of the fold-down table with a crocheted shawl across her knees.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her daughter KEZIAH, forties, moves between stove and sink with the quick, precise gestures of someone who has done this a hundred times.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Her husband PAVEL, forties, stands in the doorway with a bottle of wine, unsure where to put it, and at the table's other end EZRA, twelve, folds a paper napkin into a series of increasingly elaborate boats.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "She says nothing.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "He says nothing.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "The kettle begins to whistle.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Everyone sit. It's almost ready.", "name": "KEZIAH", "speaker": 1, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "I'll pour.", "name": "PAVEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "You'll pour after grace.", "name": "KEZIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "I can pour before grace.", "name": "PAVEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "She shoots him a look.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "He sets the bottle down and sits.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Ezra's boat tips on its side.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "He rights it.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Ezra, darling. Come sit by me.", "name": "GRAN ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "I'm fine here.", "name": "EZRA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Come sit by me.", "name": "GRAN ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "He slides along the bench.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "She pats his knee.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "For a moment, nobody breathes, and the water laps and the kettle shrieks and Keziah moves it off the flame without looking.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Don't. Don't. Don't.", "name": "KEZIAH", "speaker": 1, "ext": [], "paren": ["muttering to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "She carries the turkey to the table, slides it into place, and unwraps the foil.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Steam rises over their faces.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Pavel clears his throat.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "It looks wonderful.", "name": "PAVEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "It looks like the one from nineteen eighty-eight.", "name": "GRAN ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Mother.", "name": "KEZIAH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "I'm saying it's lovely.", "name": "GRAN ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "She lifts her glass of water.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Looks at each of them in turn.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Her gaze stops on Keziah.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "I have something to tell you all.", "name": "GRAN ODALYS", "speaker": 0, "ext": ["CONT'D"], "paren": ["to everyone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Ezra stops folding.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Pavel sits very still.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Keziah grips the carving knife.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "I sold the house.", "name": "GRAN ODALYS", "speaker": 0, "ext": ["CONT'D"], "paren": ["to Keziah"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Mother.", "name": "KEZIAH", "speaker": 1, "ext": [], "paren": ["a whisper"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "And I'm moving onto this boat.", "name": "GRAN ODALYS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Silence.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "The water slaps.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "The turkey steams.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Ezra lets go of the napkin and it unfolds on the table.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}]}