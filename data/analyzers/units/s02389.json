{"scene_id": "s02389", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02389.fountain", "heading": "INT. DECOMMISSIONED PLANETARIUM - NIGHT", "cast": [{"id": 0, "name": "VERA KOSTOPOULOS", "names": ["VERA KOSTOPOULOS", "VERA"], "gender": "m", "first": 4, "spoke": 15}, {"id": 1, "name": "MAN", "names": ["MAN"], "gender": "?", "first": 10, "spoke": 7}, {"id": 2, "name": "ARJUN", "names": ["ARJUN"], "gender": "?", "first": 27, "spoke": 10}, {"id": 3, "name": "SOUND", "names": ["SOUND"], "gender": "?", "first": 39, "spoke": 0}, {"id": 4, "name": "HALE", "names": ["HALE"], "gender": "m", "first": 37, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. DECOMMISSIONED PLANETARIUM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A round chamber of tiered seats under a cracked dome.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A projector in the centre, shrouded in a tarp.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain falls through a hole in the ceiling onto the floor and runs toward a drain.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "VERA KOSTOPOULOS, forties, in a black raincoat, stands at the foot of the aisle with a flashlight.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She sweeps it across the seats.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "dialogue", "text": "Anyone here?", "name": "VERA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 7, "kind": "action", "text": "Nothing.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "She takes a step.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "Her heel clicks on tile.", "para": 2, "sent": 2, "present": [0]}, {"u": 10, "kind": "action", "text": "A MAN steps out from behind the projector, hands visible.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Thirties, drenched, a satchel across his chest.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "You're late.", "name": "MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "You didn't say a time.", "name": "VERA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "I said midnight.", "name": "MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "It's midnight.", "name": "VERA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "It's twelve-oh-four.", "name": "MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She lowers the flashlight.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He doesn't relax.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "You have it?", "name": "VERA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "You have the money?", "name": "MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "I have a favour.", "name": "VERA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "I don't take favours.", "name": "MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "What's your name?", "name": "VERA", "speaker": 0, "ext": [], "paren": ["sighing"], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "You don't need my name.", "name": "MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I need something to call you.", "name": "VERA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "He glances at the dome, at the rain, at the dark gaps between seats.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Arjun.", "name": "MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Arjun.", "name": "VERA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Don't say it twice. It makes it real.", "name": "ARJUN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "She nods.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "He opens the satchel, pulls out a thick manila envelope, and holds it up like a flag.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "She reaches.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "He pulls it back.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "First tell me who sent you.", "name": "ARJUN", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "You know who.", "name": "VERA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Say it.", "name": "ARJUN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Hale.", "name": "VERA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 38, "kind": "dialogue", "text": "Hale. God.", "name": "ARJUN", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 4]}, {"u": 39, "kind": "action", "text": "A SOUND from the upper tier: a scrape.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Both of them go still.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Vera lifts the flashlight.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "The beam finds a seat, empty.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Another.", "para": 7, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Empty.", "para": 7, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Then a figure on the highest row, sitting calmly with a pistol on his lap.", "para": 7, "sent": 6, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "HALE, fifties, in a camel coat, soft-spoken, says nothing.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "You brought him.", "name": "ARJUN", "speaker": 2, "ext": ["CONT'D"], "paren": ["to Vera"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "I didn't.", "name": "VERA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "She didn't.", "name": "HALE", "speaker": 4, "ext": [], "paren": ["calling down"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "He stands.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Descends one step at a time, the gun held loosely, the way a man holds a cup of tea.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "I do apologise for the theatre. I always did love a planetarium.", "name": "HALE", "speaker": 4, "ext": ["CONT'D"], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "Vera, run.", "name": "ARJUN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "There's nowhere to run.", "name": "VERA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "Quite right.", "name": "HALE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "He reaches the aisle.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "Arjun clutches the satchel.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Vera sets down the flashlight, slowly, and the beam rolls across the floor and lights the three of them from below.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "dialogue", "text": "The envelope, Arjun.", "name": "HALE", "speaker": 4, "ext": ["CONT'D"], "paren": ["gently"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "Arjun hesitates.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "Then tosses it.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "It slaps on the tiles at Hale's feet.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "He picks it up.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "Opens it.", "para": 11, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "Looks inside.", "para": 11, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "It is empty.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "dialogue", "text": "Oh, dear.", "name": "HALE", "speaker": 4, "ext": ["CONT'D"], "paren": ["still gentle"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "dialogue", "text": "I burned it.", "name": "ARJUN", "speaker": 2, "ext": [], "paren": ["small"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "dialogue", "text": "When?", "name": "HALE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "dialogue", "text": "Tonight. Before I came.", "name": "ARJUN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "action", "text": "Hale laughs, softly, and aims the gun at Arjun's chest.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "action", "text": "Vera moves, fast, and slams the flashlight into his wrist.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "action", "text": "The shot cracks off the dome.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "action", "text": "Rain hisses on the floor.", "para": 13, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "action", "text": "Vera and Hale grapple.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 76, "kind": "action", "text": "The gun skitters under a seat.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 77, "kind": "action", "text": "Arjun scrambles after it.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 78, "kind": "dialogue", "text": "Arjun! Leave it!", "name": "VERA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 79, "kind": "dialogue", "text": "I've got it!", "name": "ARJUN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 80, "kind": "dialogue", "text": "Don't.", "name": "HALE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 81, "kind": "action", "text": "Arjun rises, gun in both hands, shaking.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 82, "kind": "action", "text": "He aims at Hale.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 83, "kind": "action", "text": "Hale raises his palms.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 84, "kind": "action", "text": "The rain falls between them.", "para": 15, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 85, "kind": "dialogue", "text": "Breathe. Just breathe.", "name": "ARJUN", "speaker": 2, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 86, "kind": "dialogue", "text": "Arjun. Look at me. Put it down.", "name": "VERA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 87, "kind": "action", "text": "He lowers it an inch.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 88, "kind": "action", "text": "Another.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 89, "kind": "action", "text": "The dome groans.", "para": 16, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 90, "kind": "action", "text": "A chunk of plaster falls and shatters beside the projector, and when they all look up, Hale is gone.", "para": 16, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 91, "kind": "dialogue", "text": "Hale!", "name": "VERA", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the empty room"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 92, "kind": "action", "text": "Only the rain answers.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4]}]}