{"scene_id": "s02390", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02390.fountain", "heading": "INT. NATURAL HISTORY TAXIDERMY ANNEX - AFTER HOURS", "cast": [{"id": 0, "name": "LOUISA TRAN-WOLCOTT", "names": ["LOUISA TRAN-WOLCOTT", "LOUISA"], "gender": "?", "first": 4, "spoke": 13}, {"id": 1, "name": "DELIVERY MAN", "names": ["MAN", "DELIVERY MAN", "SECOND MAN"], "gender": "?", "first": 7, "spoke": 11}, {"id": 2, "name": "PIKE", "names": ["PIKE"], "gender": "?", "first": 28, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. NATURAL HISTORY TAXIDERMY ANNEX - AFTER HOURS", "present": []}, {"u": 1, "kind": "action", "text": "A long shelved room of glass eyes and stuffed things.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A moose head presides over a card table.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dust floats in the beam of a desk lamp.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LOUISA TRAN-WOLCOTT, fifties, in cardigan and reading glasses, sorts pencils at a desk.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She is the night curator, and she is very bored.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "A figure in a delivery uniform enters through the loading door with a hand truck and a crate.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "It is a MAN, thirties, with a clipboard.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Package for Mr. Abernathy.", "name": "DELIVERY MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Abernathy retired in March.", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Then I'm in the wrong place.", "name": "DELIVERY MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Looks like it.", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He doesn't leave.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He pulls the crate toward the moose.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Louisa watches him over her glasses.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Is that a bird?", "name": "LOUISA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "It's an owl.", "name": "DELIVERY MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Oh. Which?", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Barn. Dead.", "name": "DELIVERY MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "They're all dead in here, dear.", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "He smiles, finally.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Sets the clipboard down.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "A SECOND MAN, bulky, steps through the loading door, unnoticed by Louisa, and begins loosening the screws on a display case.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "You'll have to sign in. There's a ledger.", "name": "LOUISA", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the Delivery Man"], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Sure. Name?", "name": "DELIVERY MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Mine?", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Yours.", "name": "DELIVERY MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Louisa.", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Louisa. I'm Pike.", "name": "DELIVERY MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "She's Louisa.", "name": "PIKE", "speaker": 2, "ext": [], "paren": ["to the Second Man"], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Thanks, Pike.", "name": "SECOND MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Louisa turns.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The Second Man holds up a stuffed fox in one hand and a velvet bag in the other.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "That's the Kensington fox.", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Is it?", "name": "SECOND MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "It's worth nothing.", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Then you won't mind.", "name": "SECOND MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Please don't.", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Please don't.", "name": "PIKE", "speaker": 2, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "The Second Man pauses.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "The fox's glass eye catches the lamp.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "You said she'd be asleep.", "name": "SECOND MAN", "speaker": 1, "ext": [], "paren": ["to Pike"], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "She was supposed to be.", "name": "PIKE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "I never sleep. I'm a curator.", "name": "LOUISA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "She picks up her pencils, one by one, and sets them in a mug.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Take the fox. Leave the moose. He's been here longer than I have.", "name": "LOUISA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "The Second Man nods.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Pike nods.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "They leave with the fox and the owl crate, and the moose watches them go.", "para": 8, "sent": 2, "present": [0, 1, 2]}]}