{"scene_id": "s02392", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02392.fountain", "heading": "INT. FATHER'S TACKLE SHOP - EVENING", "cast": [{"id": 0, "name": "CALLIE FENWICK-NAKAMURA", "names": ["CALLIE FENWICK-NAKAMURA", "CALLIE"], "gender": "?", "first": 4, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. FATHER'S TACKLE SHOP - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Rows of rods in wall racks, tins of hooks, a stuffed pike on a plaque.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A bell above the door has gone still.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The shop smells of old rope and kerosene.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CALLIE FENWICK-NAKAMURA, forties, in a canvas jacket, stands at the counter with a cardboard box.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She is packing a life's work into it.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "A pair of reading glasses.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "A thermos.", "para": 1, "sent": 3, "present": [0]}, {"u": 8, "kind": "action", "text": "A ledger.", "para": 1, "sent": 4, "present": [0]}, {"u": 9, "kind": "action", "text": "She works slowly, as if the objects might break if she hurried.", "para": 1, "sent": 5, "present": [0]}, {"u": 10, "kind": "action", "text": "On the wall, a landline phone with a long curled cord.", "para": 2, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "Beside it, an answering machine blinks 1.", "para": 2, "sent": 1, "present": [0]}, {"u": 12, "kind": "action", "text": "She stops.", "para": 3, "sent": 0, "present": [0]}, {"u": 13, "kind": "action", "text": "Looks at the machine.", "para": 3, "sent": 1, "present": [0]}, {"u": 14, "kind": "action", "text": "Looks away.", "para": 3, "sent": 2, "present": [0]}, {"u": 15, "kind": "action", "text": "Picks up the thermos.", "para": 3, "sent": 3, "present": [0]}, {"u": 16, "kind": "action", "text": "Sets it down.", "para": 3, "sent": 4, "present": [0]}, {"u": 17, "kind": "action", "text": "Her hand drifts to the button and then retreats.", "para": 3, "sent": 5, "present": [0]}, {"u": 18, "kind": "action", "text": "She goes to the window, flips the sign from OPEN to CLOSED, and rests her forehead on the cold glass.", "para": 4, "sent": 0, "present": [0]}, {"u": 19, "kind": "action", "text": "The machine clicks.", "para": 5, "sent": 0, "present": [0]}, {"u": 20, "kind": "action", "text": "A tape whirs.", "para": 5, "sent": 1, "present": [0]}, {"u": 21, "kind": "dialogue", "text": "Hi, you've reached Fenwick's Tackle. We're out on the water. Leave a message and we'll call you back when the fish quit biting.", "name": "CALLIE", "speaker": 0, "ext": ["V.O."], "paren": ["recorded greeting"], "dual": false, "present": [0]}, {"u": 22, "kind": "action", "text": "A BEEP.", "para": 6, "sent": 0, "present": [0]}, {"u": 23, "kind": "action", "text": "She turns around.", "para": 7, "sent": 0, "present": [0]}, {"u": 24, "kind": "action", "text": "Slowly.", "para": 7, "sent": 1, "present": [0]}, {"u": 25, "kind": "action", "text": "Crosses to the counter.", "para": 7, "sent": 2, "present": [0]}, {"u": 26, "kind": "action", "text": "Presses the button again.", "para": 7, "sent": 3, "present": [0]}, {"u": 27, "kind": "dialogue", "text": "Hi, you've reached Fenwick's Tackle...", "name": "CALLIE", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": ["recorded greeting"], "dual": false, "present": [0]}, {"u": 28, "kind": "action", "text": "She presses stop.", "para": 8, "sent": 0, "present": [0]}, {"u": 29, "kind": "action", "text": "The tape clicks.", "para": 8, "sent": 1, "present": [0]}, {"u": 30, "kind": "action", "text": "She stands with her palm flat on the machine, the way one touches a sleeping animal.", "para": 8, "sent": 2, "present": [0]}, {"u": 31, "kind": "action", "text": "Then, briskly, she wraps the cord around her wrist and pulls the phone off the wall.", "para": 9, "sent": 0, "present": [0]}, {"u": 32, "kind": "action", "text": "A cloud of plaster dust drifts down.", "para": 9, "sent": 1, "present": [0]}, {"u": 33, "kind": "action", "text": "She sets the phone in the box.", "para": 9, "sent": 2, "present": [0]}, {"u": 34, "kind": "action", "text": "Folds the flaps.", "para": 9, "sent": 3, "present": [0]}, {"u": 35, "kind": "action", "text": "Tapes them shut.", "para": 9, "sent": 4, "present": [0]}, {"u": 36, "kind": "action", "text": "The bell above the door rings.", "para": 10, "sent": 0, "present": [0]}, {"u": 37, "kind": "action", "text": "She does not look up.", "para": 10, "sent": 1, "present": [0]}, {"u": 38, "kind": "action", "text": "She reaches for the stuffed pike on its plaque and takes it down, runs a finger along its glass eye, and, to the empty shop, in a voice almost too quiet to hear:", "para": 10, "sent": 2, "present": [0]}, {"u": 39, "kind": "dialogue", "text": "We'll call you back.", "name": "CALLIE", "speaker": 0, "ext": [], "paren": ["recorded greeting"], "dual": false, "present": [0]}, {"u": 40, "kind": "action", "text": "She tucks the pike under her arm.", "para": 11, "sent": 0, "present": [0]}, {"u": 41, "kind": "action", "text": "Picks up the box.", "para": 11, "sent": 1, "present": [0]}, {"u": 42, "kind": "action", "text": "Turns off the light.", "para": 11, "sent": 2, "present": [0]}]}