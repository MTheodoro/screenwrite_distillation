{"scene_id": "s02393", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02393.fountain", "heading": "INT. FERRY TERMINAL WAITING ROOM - IMPROVISED CLINIC - NIGHT", "cast": [{"id": 0, "name": "SOLVEIG ABIODUN", "names": ["SOLVEIG ABIODUN", "SOLVEIG"], "gender": "f", "first": 5, "spoke": 18}, {"id": 1, "name": "OLD MAN", "names": ["OLD MAN"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "NURSE PRAKASH IYENGAR", "names": ["NURSE PRAKASH IYENGAR", "PRAKASH"], "gender": "?", "first": 6, "spoke": 7}, {"id": 3, "name": "PARAMEDIC LUCIA FERREIRA-HOLT", "names": ["PARAMEDIC LUCIA FERREIRA-HOLT", "LUCIA"], "gender": "?", "first": 7, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. FERRY TERMINAL WAITING ROOM - IMPROVISED CLINIC - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A blizzard rattles the windows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of molded plastic chairs have been pushed aside to make room for six camp cots.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A vending machine glows in the corner.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Blankets, IV poles borrowed from a stalled ambulance, a whiteboard on which someone has written TRIAGE in red marker.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. SOLVEIG ABIODUN, forties, in a parka over green scrubs, kneels beside a cot where an OLD MAN lies grey-faced under three blankets.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Behind her, NURSE PRAKASH IYENGAR, thirties, tapes a gauze pad to a young woman's arm.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "At the doorway, PARAMEDIC LUCIA FERREIRA-HOLT, twenties, stamps snow from her boots and drops an equipment bag.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "I need quiet. All of you. Quiet.", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "The room hushes.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Wind howls.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "A vending machine hums.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Road's closed. Plow can't get through before dawn.", "name": "LUCIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "How long is that?", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Nine hours. Maybe ten.", "name": "LUCIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Ten.", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Doctor, I'm out of saline.", "name": "PRAKASH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "How many bags?", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Two.", "name": "PRAKASH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Use one on him. Save the last.", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "For?", "name": "PRAKASH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "For whoever's worse.", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "She stands.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Her knees crack.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "She crosses the room to the whiteboard and writes a number beside the first name.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Pressure?", "name": "SOLVEIG", "speaker": 0, "ext": ["CONT'D"], "paren": ["to Lucia"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Ninety over fifty.", "name": "LUCIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Pulse?", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "One-thirty.", "name": "LUCIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "That's not a stable man.", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "He was fine an hour ago.", "name": "LUCIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "They always are.", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Doctor, there's something you should see.", "name": "PRAKASH", "speaker": 2, "ext": [], "paren": ["low, to Solveig"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "She follows him to the corner cot.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "The young woman Prakash was tending lifts her sleeve.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Under the gauze, the skin is bruised black from elbow to wrist.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "How long has she been like this?", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "She says since the bus.", "name": "PRAKASH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "What bus?", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "The one that skidded on the bridge. She walked here.", "name": "LUCIA", "speaker": 3, "ext": [], "paren": ["from across the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "She walked here on that arm?", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Four miles.", "name": "LUCIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Everyone in this room is lying about how bad it is.", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": ["shaking her head"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Including you.", "name": "PRAKASH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Including me.", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "The lights flicker.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Everyone looks up.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "The vending machine goes dark.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "A groan from the old man's cot.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Lucia runs to him.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Solveig stays where she is, watching the ceiling lights hum back to life.", "para": 5, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Nobody panic. We have generators. We have blankets. We have each other, and I know that sounds like a poster.", "name": "SOLVEIG", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the whole room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "A weak laugh from one of the cots.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Get me the last bag.", "name": "SOLVEIG", "speaker": 0, "ext": ["CONT'D"], "paren": ["quiet, to Prakash"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "For her?", "name": "PRAKASH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "For him.", "name": "SOLVEIG", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Doctor! His pressure's dropping!", "name": "LUCIA", "speaker": 3, "ext": [], "paren": ["calling"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Solveig is already moving.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}]}