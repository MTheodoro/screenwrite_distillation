{"scene_id": "s02395", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02395.fountain", "heading": "INT. LIGHTHOUSE KEEPER'S COTTAGE - KITCHEN - NIGHT", "cast": [{"id": 0, "name": "INSPECTOR WILHELMINA CROSS", "names": ["INSPECTOR WILHELMINA CROSS", "CROSS"], "gender": "f", "first": 4, "spoke": 11}, {"id": 1, "name": "YOUNG MAN", "names": ["YOUNG MAN"], "gender": "?", "first": 5, "spoke": 6}, {"id": 2, "name": "TOBIAS", "names": ["TOBIAS"], "gender": "?", "first": 17, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. LIGHTHOUSE KEEPER'S COTTAGE - KITCHEN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A pot of tea between them on a scarred table.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Oil lamp.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain on the glass.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "INSPECTOR WILHELMINA CROSS, fifties, sits with her coat still on.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across from her, a YOUNG MAN in a fisherman's jersey, hands round his cup.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "You said you were alone that night.", "name": "CROSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "I was.", "name": "YOUNG MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "The log says three lamps were lit.", "name": "CROSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I lit one.", "name": "YOUNG MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Then who lit the other two?", "name": "CROSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "The wind, maybe.", "name": "YOUNG MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Lamps don't catch on wind.", "name": "CROSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Then I don't know.", "name": "YOUNG MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Mr. Penhallow. I've been doing this a long time. In my experience, a man who says \"I don't know\" three times in a row knows exactly.", "name": "CROSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I'm not Penhallow.", "name": "YOUNG MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "No?", "name": "CROSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Penhallow's my uncle. He's the keeper. I'm Tobias. I came up on the supply boat on Tuesday.", "name": "YOUNG MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Tobias.", "name": "CROSS", "speaker": 0, "ext": [], "paren": ["after a long pause"], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Yes.", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Then where is your uncle, Tobias?", "name": "CROSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Out on the rocks. He goes every night. To watch for ships.", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "There are no ships tonight.", "name": "CROSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "He doesn't believe that.", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "And the third lamp?", "name": "CROSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "That's for the ones who don't come back.", "name": "TOBIAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "A beat.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Rain.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "The kettle ticks.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Tobias. I think you should tell me everything.", "name": "CROSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}