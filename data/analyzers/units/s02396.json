{"scene_id": "s02396", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02396.fountain", "heading": "INT. COVERED BRIDGE - STALLED STAGECOACH - DAY", "cast": [{"id": 0, "name": "SHERIFF AMOS TULL", "names": ["SHERIFF AMOS TULL", "TULL"], "gender": "m", "first": 4, "spoke": 8}, {"id": 1, "name": "CORDELIA RUSK", "names": ["CORDELIA RUSK", "CORDELIA"], "gender": "?", "first": 5, "spoke": 6}, {"id": 2, "name": "DEPUTY WENDELL AUBREY", "names": ["DEPUTY WENDELL AUBREY", "WENDELL"], "gender": "?", "first": 6, "spoke": 2}, {"id": 3, "name": "REVEREND IGNATIUS MBEKI", "names": ["REVEREND IGNATIUS MBEKI", "MBEKI"], "gender": "?", "first": 7, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. COVERED BRIDGE - STALLED STAGECOACH - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Timbers creak overhead.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A river roars beneath.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The coach sits dead centre, one wheel jammed in a gap in the planking, horses stamping and blowing at the near end.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SHERIFF AMOS TULL, fifties, a deep-lined face under a flat hat, stands at the coach door with a shotgun cradled in the crook of his arm.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across the bridge from him, CORDELIA RUSK, thirties, in a black duster, waits on a grey mare with a rifle across her pommel.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Between them, in the coach window, DEPUTY WENDELL AUBREY, twenty, sweats through his collar.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Beside the wheel, REVEREND IGNATIUS MBEKI, sixty, kneels in the dust with an open Bible, whispering.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Nobody move.", "name": "TULL", "speaker": 0, "ext": [], "paren": ["to everyone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Nobody's moving, Sheriff.", "name": "CORDELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Then why's your hand on that stock?", "name": "TULL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Habit.", "name": "CORDELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Get that wheel loose.", "name": "TULL", "speaker": 0, "ext": [], "paren": ["to Wendell"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "I'm trying, sir.", "name": "WENDELL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Try harder.", "name": "TULL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Wendell climbs down.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "He crouches by the wheel and shoves at it with both hands.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "The coach does not budge.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "The river roars.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Cordelia nudges the mare one step forward.", "para": 2, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Lord, if it be Thy will.", "name": "MBEKI", "speaker": 3, "ext": [], "paren": ["murmuring"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Preacher, I'd say it's the Lord's will you stay put.", "name": "CORDELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Madam, I am praying for your soul.", "name": "MBEKI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Then pray for the wheel.", "name": "CORDELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Enough.", "name": "TULL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Wendell strains.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "The coach shifts an inch, and everyone freezes.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "He looks up at Tull, eyes wide.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "It's moving.", "name": "WENDELL", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Keep going.", "name": "TULL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Easy, easy.", "name": "CORDELIA", "speaker": 1, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "The wheel pops free with a crack.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "The coach lurches forward.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Wendell leaps aside.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Cordelia lifts the rifle halfway.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Tull cocks the shotgun, and for a long second the two of them regard each other down the length of the bridge.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Let it pass.", "name": "TULL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Why?", "name": "CORDELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Because there's a preacher in the road.", "name": "TULL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "She looks at Mbeki, still on his knees, and lowers the rifle.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}]}