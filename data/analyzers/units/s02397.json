{"scene_id": "s02397", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02397.fountain", "heading": "INT. ABANDONED HOTEL POOL - DAWN", "cast": [{"id": 0, "name": "HENRIK SOLBERG", "names": ["HENRIK SOLBERG", "HENRIK"], "gender": "m", "first": 5, "spoke": 8}, {"id": 1, "name": "ASHA NDLOVU-REYES", "names": ["ASHA NDLOVU-REYES", "ASHA"], "gender": "?", "first": 7, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED HOTEL POOL - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A drained lap pool under a skylight patched with plywood.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Peeling blue tiles.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A diving board with one rusted bolt.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Pale light falls in stripes across the floor of the deep end.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "HENRIK SOLBERG, sixties, in a long wool coat, sits on a plastic chair at the shallow end with a stopwatch hanging from his neck.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "He is a retired coach with a patient, ruined face.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "At the edge of the deep end, ASHA NDLOVU-REYES, twenty, in a tracksuit, stretches her shoulders and rolls her neck.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She has not looked at him since she arrived.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He clears his throat.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She does not turn.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She steps onto the diving board.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "It flexes and groans beneath her bare feet.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She bounces once, testing, and the whole structure sings, and he half rises from the chair.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Asha.", "name": "HENRIK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "It's fine.", "name": "ASHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "The board is not fine.", "name": "HENRIK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "It has held before.", "name": "ASHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He sits back down, slowly.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "The stopwatch swings against his chest.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She bounces again, higher, and the bolt shrieks in its socket, and still she does not stop.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "The pool is empty.", "name": "HENRIK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "I know.", "name": "ASHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "I only mention it.", "name": "HENRIK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She laughs, a short surprised sound that echoes off the tiles.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "She lowers herself to the end of the board and sits there, legs dangling above eleven feet of nothing.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Do you remember the last time you timed me?", "name": "ASHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Sydney.", "name": "HENRIK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "You said I was a second slow.", "name": "ASHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "You were a second slow.", "name": "HENRIK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "I was a tenth slow. I looked it up.", "name": "ASHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "He lifts the stopwatch.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Studies it.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Thumbs the button.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "It clicks.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Then it was a tenth.", "name": "HENRIK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "She stands again.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Walks to the very edge.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Spreads her arms and looks up at the skylight, where the plywood has split to let in one thin blade of gold.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Start the watch.", "name": "ASHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "For what?", "name": "HENRIK", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Just start it.", "name": "ASHA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "He starts it.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "She bends her knees.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "Holds.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "And then, softly, to nobody, she dives, a clean arc, arms together, into the long empty blue, and at the last instant her fingertips brush the floor and she rolls and comes up laughing, breathless, filthy, alive.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "He stops the watch.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Looks at it.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Does not say the number.", "para": 9, "sent": 2, "present": [0, 1]}]}