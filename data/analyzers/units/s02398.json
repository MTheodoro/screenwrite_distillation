{"scene_id": "s02398", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02398.fountain", "heading": "INT. ESCAPE ROOM - \"THE MUMMY'S REVENGE\" - NIGHT", "cast": [{"id": 0, "name": "CHAD BROADHURST", "names": ["CHAD BROADHURST", "CHAD"], "gender": "?", "first": 5, "spoke": 10}, {"id": 1, "name": "BERNICE ADEYEMI-STONE", "names": ["BERNICE ADEYEMI-STONE", "BERNICE"], "gender": "f", "first": 6, "spoke": 6}, {"id": 2, "name": "MOOSA QURESHI", "names": ["MOOSA QURESHI", "MOOSA"], "gender": "?", "first": 7, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. ESCAPE ROOM - \"THE MUMMY'S REVENGE\" - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A fake tomb of papier-mache and gaffer tape.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Hieroglyphs painted in marker.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A sarcophagus lid leans against one wall.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A digital timer on the wall reads 03:12 and counts down.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CHAD BROADHURST, thirties, in a polo and cargo shorts, paces with a plastic torch.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "BERNICE ADEYEMI-STONE, sixties, sits cross-legged on the floor sorting scraps of papyrus into piles.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "MOOSA QURESHI, twenties, headset on, stares at a wall of buttons.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Okay, team. Focus. Focus!", "name": "CHAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "We're focused, Chad.", "name": "BERNICE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Moosa, buddy, what's the clue?", "name": "CHAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "It says, \"Where the sun meets the river.\"", "name": "MOOSA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Meaning?", "name": "CHAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "No idea.", "name": "MOOSA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Bernice?", "name": "CHAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Hush, I'm sorting.", "name": "BERNICE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Chad flings the torch at the sarcophagus.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "It bounces off the lid and clatters across the floor.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "All three freeze, then lunge for it at once.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Bernice gets there first and, with surprising speed, snatches it up.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Chad stumbles into Moosa.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Moosa trips over the papyrus piles.", "para": 2, "sent": 5, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "The three of them land in a heap beside the sarcophagus.", "para": 2, "sent": 6, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Now look what you've done!", "name": "BERNICE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Me?", "name": "CHAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "It's the third piece. It's in the lid.", "name": "MOOSA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "What?", "name": "CHAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "The lid. It's a door.", "name": "MOOSA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "They scramble up.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Heave together.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "The lid swings open.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Inside, a brass key on a satin pillow.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Moosa, you genius!", "name": "CHAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "I'm the one who sorted.", "name": "BERNICE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "I just read the clue.", "name": "MOOSA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Same difference.", "name": "CHAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Chad snatches the key.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Runs to the door.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Jams it in.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "It does not turn.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "The timer blinks 00:30.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Try it the other way, you oaf!", "name": "BERNICE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "It's a key. There's only one way!", "name": "CHAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "It's a left-handed lock.", "name": "MOOSA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "That's not a thing!", "name": "CHAD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Give me that.", "name": "BERNICE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "They struggle over the key, all three pulling, and the door finally swings open on a dim corridor and a flashing EXIT sign.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "We did it!", "name": "MOOSA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Chad collapses to the floor.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Bernice tidies her hair.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Moosa pumps a fist.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "The timer reads 00:04.", "para": 6, "sent": 3, "present": [0, 1, 2]}]}