{"scene_id": "s02399", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02399.fountain", "heading": "INT. GRANDMOTHER'S SEWING ROOM - AFTERNOON", "cast": [{"id": 0, "name": "GRANDMA WINNIFRED", "names": ["GRANDMA WINNIFRED", "WINNIFRED"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "JASPER", "names": ["JASPER"], "gender": "?", "first": 4, "spoke": 3}, {"id": 2, "name": "LOTTE", "names": ["LOTTE"], "gender": "?", "first": 4, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRANDMOTHER'S SEWING ROOM - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "A small sunlit room of buttons, bobbins and bolts of cloth, with a treadle sewing machine under the window.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A cat sleeps in a basket of scraps.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dust floats in the light.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "GRANDMA WINNIFRED, seventies, in a lilac cardigan, sits at the machine feeding a seam under the needle, while her grandson JASPER, ten, sprawls on the rug sorting buttons by colour and sorting them again by size, and his sister LOTTE, thirteen, perches on the windowsill, picking at a loose thread on her sleeve and watching a bird on the wire outside, and nobody says a word for a long, pleasant minute.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "Jasper, hand me the blue.", "name": "WINNIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Which blue?", "name": "JASPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "The blue that looks like the sea in July.", "name": "WINNIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "He holds up a spool.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "She squints.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Nods.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He crawls across the floor to deliver it.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Gran, can I borrow the green scissors?", "name": "LOTTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "They're in the drawer.", "name": "WINNIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Which drawer?", "name": "LOTTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "The one that squeaks.", "name": "WINNIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Lotte slides off the sill and finds it.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Takes the scissors.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Cuts the thread on her sleeve.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Sits back down.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Gran, how long have you had this machine?", "name": "JASPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Since before your mother was born.", "name": "WINNIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "That's old.", "name": "JASPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "So am I.", "name": "WINNIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Nobody laughs.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Winnifred smiles.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The needle thuds.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "The cat stretches in its basket and resettles, and outside the bird takes off from the wire.", "para": 4, "sent": 3, "present": [0, 1, 2]}]}