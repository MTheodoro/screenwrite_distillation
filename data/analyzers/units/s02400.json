{"scene_id": "s02400", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02400.fountain", "heading": "INT. HOSPICE ROOFTOP GARDEN - NIGHT", "cast": [{"id": 0, "name": "ANNELIESE OKORO", "names": ["ANNELIESE OKORO", "ANNELIESE"], "gender": "f", "first": 5, "spoke": 5}, {"id": 1, "name": "TOMAS QUISPE-HALLORAN", "names": ["TOMAS QUISPE-HALLORAN", "TOMAS"], "gender": "m", "first": 6, "spoke": 1}, {"id": 2, "name": "ALDER FINCH", "names": ["ALDER FINCH", "ALDER"], "gender": "m", "first": 7, "spoke": 13}, {"id": 3, "name": "WILHELMINA", "names": ["WILHELMINA"], "gender": "?", "first": 7, "spoke": 0}, {"id": 4, "name": "BILLIE", "names": ["BILLIE"], "gender": "m", "first": 7, "spoke": 11}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOSPICE ROOFTOP GARDEN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A rectangle of raised beds and herb planters ringed by a low brick wall, high above the sleeping city.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "String lights glow in the warm dark.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The scent of rosemary and wet soil drifts across the concrete.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "At the far edge, a bench faces the distant river.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DR. ANNELIESE OKORO, fifties, in a long cardigan over her scrubs, stands with a paper cup of tea and watches the city the way some people watch the sea.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her night nurse, TOMAS QUISPE-HALLORAN, thirties, drops a folded blanket on the bench and settles beside it, a battered thermos between his knees.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "In a wheelchair at the centre of the garden, wrapped in a quilt with his white hair standing up in tufts, ALDER FINCH, eighty-one, tilts his face to the sky, and behind him his daughter WILHELMINA, \"BILLIE,\" forties, in a rain jacket, pushes the chair an inch closer to the herbs, then an inch back, unable to settle.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "Is that Orion?", "name": "ALDER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "That's a satellite, Dad.", "name": "BILLIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "It's moving too slow.", "name": "ALDER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "It's a plane, then.", "name": "BILLIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "It's Orion. You always did hate being wrong.", "name": "ALDER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Billie laughs.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Anneliese sips her tea.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Tomas pours coffee into the thermos cap and passes it to Billie, who accepts it without looking.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "It's a lovely night for it.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Warmest of the year.", "name": "TOMAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Mr. Finch, are you comfortable?", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "I'm a hundred and twelve percent comfortable. Don't fuss.", "name": "ALDER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "I wouldn't dream of it.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "She would.", "name": "ALDER", "speaker": 2, "ext": [], "paren": ["to Billie"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Billie smiles.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "A breeze stirs the string lights.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Somewhere below, a siren starts and fades.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Alder closes his eyes.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Your mother planted rosemary like this. Behind the garage.", "name": "ALDER", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "I remember.", "name": "BILLIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "She'd stand there for an hour. Wouldn't say anything.", "name": "ALDER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "I used to think she was hiding from us.", "name": "BILLIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "She was.", "name": "ALDER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Dad.", "name": "BILLIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Not from you. From the noise of it. All of us. Four kids and a dog and me.", "name": "ALDER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Tomas looks at Anneliese.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "She shakes her head, very slightly.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "He stays seated.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Did you ever tell her you understood?", "name": "BILLIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "I never did.", "name": "ALDER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Why not?", "name": "BILLIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Because I didn't. Not until I got old enough to sit still.", "name": "ALDER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "He opens his eyes and looks up.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "A long quiet.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "The lights hum.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "You'll tell the others I was grateful?", "name": "ALDER", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "They know.", "name": "BILLIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Tell them anyway. Men say things at the end that they ought to have said at the beginning.", "name": "ALDER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Billie takes his hand.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "He squeezes it.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "His other hand, the one on the arm of the chair, begins to tremble, very slightly, then goes still.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Anneliese puts down her cup.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Tomas rises, and the two of them cross the garden without hurry.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Anneliese kneels.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "She places two fingers on his wrist, and then, gently, takes them away.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "Billie.", "name": "ANNELIESE", "speaker": 0, "ext": ["CONT'D"], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "I know.", "name": "BILLIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "I'm so sorry.", "name": "ANNELIESE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "No. Don't be. He was right about Orion.", "name": "BILLIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "She looks up.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "A thin line of stars, faint above the city glow.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "She wipes her cheek with the heel of her hand.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "Could you give us a minute?", "name": "BILLIE", "speaker": 4, "ext": ["CONT'D"], "paren": ["to Tomas"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "He nods.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "Takes the blanket from the bench and lays it over the old man's knees.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}]}