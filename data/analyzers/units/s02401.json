{"scene_id": "s02401", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02401.fountain", "heading": "INT. CAMPER VAN - DRIVE-IN LOT - NIGHT", "cast": [{"id": 0, "name": "JOJO", "names": ["JOJO"], "gender": "?", "first": 5, "spoke": 4}, {"id": 1, "name": "MARISOL", "names": ["MARISOL"], "gender": "f", "first": 6, "spoke": 5}, {"id": 2, "name": "DEV", "names": ["DEV"], "gender": "m", "first": 7, "spoke": 2}, {"id": 3, "name": "ANSEL", "names": ["ANSEL"], "gender": "?", "first": 8, "spoke": 3}, {"id": 4, "name": "MOTHER", "names": ["MOTHER"], "gender": "?", "first": 28, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. CAMPER VAN - DRIVE-IN LOT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cramped.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cassette deck.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A bulb on a cord.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Through the open back doors, a giant screen flickers silently in the dark.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "JOJO, seventeen, drives a fork through a can of beans.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "MARISOL, her sister, sixteen, paints her toenails.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "DEV, Jojo's boyfriend, strums a ukulele.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "ANSEL, twelve, the kid brother, lies on the floor under a sleeping bag.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Four more minutes, then we leave.", "name": "JOJO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "You said that at nine.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I said it at nine-thirty.", "name": "JOJO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Whatever.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Play it again, Ans?", "name": "DEV", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "No.", "name": "ANSEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Please?", "name": "DEV", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "It's my song.", "name": "ANSEL", "speaker": 3, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "The ukulele stops.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Everyone is quiet.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Jojo sets down the fork.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "The screen goes dark.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "A phone buzzes on the dash.", "para": 2, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Don't pick that up.", "name": "JOJO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "I'm not.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "It buzzes again.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Marisol picks it up.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Sighs.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Puts it on speaker.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Girls? Where are you?", "name": "MOTHER", "speaker": 4, "ext": ["V.O."], "paren": ["over phone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "At the movie, Mom.", "name": "JOJO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Which movie?", "name": "MOTHER", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "The one with the dog.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": ["quickly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "The one with the dog died in the last one.", "name": "MOTHER", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "It's a sequel.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Is Ansel with you?", "name": "MOTHER", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Jojo looks at the floor.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Marisol looks at the screen.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Dev puts his hand over the ukulele strings.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "From under the sleeping bag comes the smallest voice in the van.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Hi, Mom.", "name": "ANSEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Ansel Mbeki-Dunmore. Home. Now.", "name": "MOTHER", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Click.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Dial tone.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "The four of them sit in the bulb's weak light, and then, all at once, Jojo starts to laugh, and so does Marisol, and so does Dev, helplessly, and even Ansel's shoulders begin to shake under the nylon.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}]}