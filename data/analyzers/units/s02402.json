{"scene_id": "s02402", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02402.fountain", "heading": "INT. DINING CAR - OVERNIGHT EXPRESS - NIGHT", "cast": [{"id": 0, "name": "ELEANOR WHITCOMBE", "names": ["ELEANOR WHITCOMBE", "ELEANOR"], "gender": "f", "first": 4, "spoke": 7}, {"id": 1, "name": "AUGUSTIN ROCHE", "names": ["AUGUSTIN ROCHE", "ROCHE"], "gender": "m", "first": 5, "spoke": 8}, {"id": 2, "name": "PORTER", "names": ["PORTER"], "gender": "?", "first": 17, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. DINING CAR - OVERNIGHT EXPRESS - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "White linen, silver pots, amber lamps.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The train sways.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dark country slides past the windows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ELEANOR WHITCOMBE, fifties, in a grey travelling suit, sits alone at a table for two, a cup of black coffee cooling in front of her.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across the car, AUGUSTIN ROCHE, sixties, a gaunt gentleman in a dinner jacket, folds his newspaper and approaches.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Madame Whitcombe.", "name": "ROCHE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Monsieur Roche.", "name": "ELEANOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "I did not expect to find you on this train.", "name": "ROCHE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I did not expect to be found.", "name": "ELEANOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He takes the chair opposite without being asked.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She lets him.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Twenty years.", "name": "ROCHE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Twenty-two.", "name": "ELEANOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "You haven't changed.", "name": "ROCHE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "You have, thank God.", "name": "ELEANOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He smiles.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "A PORTER in a white jacket appears at the table's edge with a silver pot.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "More coffee, madame?", "name": "PORTER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "No. Thank you.", "name": "ELEANOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Nothing for me.", "name": "ROCHE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "The Porter withdraws.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "The train rocks into a curve.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "I kept the letters, you know.", "name": "ROCHE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "I burned yours.", "name": "ELEANOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "I assumed.", "name": "ROCHE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Do not make it sound like a kindness.", "name": "ELEANOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "It was not meant as one.", "name": "ROCHE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "She lifts her cup.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Sets it down.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "The lamp flickers.", "para": 5, "sent": 2, "present": [0, 1, 2]}]}