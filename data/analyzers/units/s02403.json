{"scene_id": "s02403", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02403.fountain", "heading": "INT. ICE-FISHING HUT - NIGHT", "cast": [{"id": 0, "name": "BRENNA TALLCHIEF", "names": ["BRENNA TALLCHIEF", "BRENNA"], "gender": "?", "first": 5, "spoke": 4}, {"id": 1, "name": "RANGER", "names": ["RANGER"], "gender": "?", "first": 9, "spoke": 4}, {"id": 2, "name": "SOL TALLCHIEF", "names": ["SOL TALLCHIEF", "SOL"], "gender": "?", "first": 5, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. ICE-FISHING HUT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Tin walls ticking with frost.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A propane lantern.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A square hole in the floor shows black water.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A radio on a shelf hisses.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "BRENNA TALLCHIEF, thirties, huddles in a parka, a thermos shaking in both hands.", "para": 1, "sent": 0, "present": [0, 2]}, {"u": 6, "kind": "action", "text": "She has not slept.", "para": 1, "sent": 1, "present": [0, 2]}, {"u": 7, "kind": "action", "text": "The ice groans somewhere under the hut and she flinches.", "para": 1, "sent": 2, "present": [0, 2]}, {"u": 8, "kind": "action", "text": "The radio crackles.", "para": 2, "sent": 0, "present": [0, 2]}, {"u": 9, "kind": "dialogue", "text": "Hut Four, Hut Four, this is Ranger Station. Do you copy?", "name": "RANGER", "speaker": 1, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Brenna lunges for the handset.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Copy! Copy, I'm here!", "name": "BRENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Ice is breaking up on the east side. You need to move.", "name": "RANGER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "He's out on it! My brother's out on it!", "name": "BRENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Say again?", "name": "RANGER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "The door bangs open.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "A blast of snow.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "SOL TALLCHIEF, twenty, bursts in, soaked to the thighs, lugging a sled.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Sol!", "name": "BRENNA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "She hauls him in by the collar.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "He drops the sled.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Falls to his knees.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "The ice booms under them, one long cracking roar.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Go. Go!", "name": "SOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "She seizes the radio.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "He grabs the lantern.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The floor tilts.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "We're leaving. We're leaving now.", "name": "BRENNA", "speaker": 0, "ext": [], "paren": ["into handset"], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Copy. Godspeed.", "name": "RANGER", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "They burst out through the door.", "para": 7, "sent": 0, "present": [0, 1, 2]}]}