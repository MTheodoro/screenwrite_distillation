{"scene_id": "s02404", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02404.fountain", "heading": "INT. BARBERSHOP - TUMBLEWEED, TEXAS - DAY", "cast": [{"id": 0, "name": "EZEKIEL MOSS", "names": ["EZEKIEL MOSS", "EZEKIEL"], "gender": "?", "first": 4, "spoke": 7}, {"id": 1, "name": "CLEMENTINE HATCH", "names": ["CLEMENTINE HATCH", "CLEMENTINE"], "gender": "f", "first": 5, "spoke": 6}, {"id": 2, "name": "DEPUTY LUKE ARMITAGE", "names": ["DEPUTY LUKE ARMITAGE", "LUKE"], "gender": "m", "first": 18, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. BARBERSHOP - TUMBLEWEED, TEXAS - DAY", "present": []}, {"u": 1, "kind": "action", "text": "One chair.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "One mirror.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cracked leather strop.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "EZEKIEL MOSS, fifties, barber, snips at the air.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "In the chair, CLEMENTINE HATCH, forties, in a man's hat and a long duster, sits with a towel round her neck.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Just the ends?", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Just the ends.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Snip.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Snip.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "You passing through?", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Looking for someone.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Aren't we all.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "A man called Rafferty. Red beard. Left ear missing.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Don't know him.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "You'd remember the ear.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "I would.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "The bell on the door jingles.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "DEPUTY LUKE ARMITAGE, twenty-five, wide-eyed, steps in, hat in hand.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Pardon me, Mr. Moss. The sheriff wants a word with the lady.", "name": "LUKE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "She's mid-trim.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "He said it was urgent.", "name": "LUKE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Tell him I'm busy.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": ["not turning"], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "He said you'd say that.", "name": "LUKE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Then he knows the answer.", "name": "CLEMENTINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Luke shifts his weight.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Ezekiel lowers the scissors.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Son, why don't you take a seat and wait your turn.", "name": "EZEKIEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Luke sits.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "The clock ticks.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "The snipping resumes.", "para": 5, "sent": 2, "present": [0, 1, 2]}]}