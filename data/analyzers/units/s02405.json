{"scene_id": "s02405", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02405.fountain", "heading": "INT. NIGHT NURSERY GREENHOUSE - NIGHT", "cast": [{"id": 0, "name": "NADINE FALK", "names": ["NADINE FALK", "NADINE"], "gender": "f", "first": 5, "spoke": 7}, {"id": 1, "name": "YUKI HASEGAWA-DIOP", "names": ["YUKI HASEGAWA-DIOP", "YUKI"], "gender": "?", "first": 6, "spoke": 6}, {"id": 2, "name": "PIM", "names": ["PIM"], "gender": "m", "first": 7, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT NURSERY GREENHOUSE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Glass walls, steamed over.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of seedling trays under purple grow lights.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A hose drips.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Beyond the panes, a black field and a single sodium lamp on a pole.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "NADINE FALK, thirties, kneels between two benches, a headlamp strapped over her beanie.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "YUKI HASEGAWA-DIOP, thirties, stands at the potting table with a clipboard.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "PIM, nine, the owner's grandson, sits on an upturned bucket with a flashlight.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Nobody speaks.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Something taps the glass.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Once.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Did you hear that?", "name": "PIM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "It's the heater.", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "It sounded like a knuckle.", "name": "PIM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "It's the heater, Pim.", "name": "YUKI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "She writes something on her clipboard.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Her pen skips.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Tap.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Tap.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Nadine stands.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Her headlamp sweeps the wall of glass.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Nothing but the dark, and her own reflection.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Okay.", "name": "NADINE", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "She goes back to her seedlings.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "She is shaking.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "She pretends she isn't.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The grow lights flicker.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "The hose stops dripping.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "The silence is worse.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Pim aims his flashlight at the far end of the greenhouse.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "The beam lands on a tray of tomato starts, and the starts are all leaning, every one, toward the glass.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "They moved.", "name": "PIM", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Plants lean toward light.", "name": "YUKI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "There's no light out there.", "name": "PIM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "There's the lamp.", "name": "YUKI", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "The lamp's off.", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "They turn.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "The sodium lamp has gone dark.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "The field is perfectly black.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Something taps the glass, closer, at the door.", "para": 10, "sent": 3, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Pim, come here.", "name": "NADINE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Pim, come here.", "name": "YUKI", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Pim rises.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "The flashlight shakes.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "The door handle begins to turn.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Slowly.", "para": 11, "sent": 3, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Nadine grabs Pim and pulls him behind her.", "para": 11, "sent": 4, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Yuki seizes a trowel from the table and holds it like a knife.", "para": 11, "sent": 5, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "The door opens an inch.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "A long cold breath moves down the rows.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "The tomato starts shiver and lie flat.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Is it gone?", "name": "PIM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Don't talk.", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Yuki steps toward the door.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "She reaches.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "She gets her fingers around the edge and, in one hard movement, slams it shut and throws the bolt.", "para": 13, "sent": 2, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "For a moment, silence.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Then, from outside, a single patient knock.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Not on the glass.", "para": 14, "sent": 2, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "On the bolt, from the other side.", "para": 14, "sent": 3, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "Nadine?", "name": "YUKI", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Yes?", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "I don't think it wants to come in.", "name": "YUKI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "What does it want?", "name": "NADINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "Behind her, in the dark, one by one, the grow lights go out.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "It wants to know if we're alone.", "name": "PIM", "speaker": 2, "ext": [], "paren": ["very small"], "dual": false, "present": [0, 1, 2]}]}