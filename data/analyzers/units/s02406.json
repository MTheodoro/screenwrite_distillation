{"scene_id": "s02406", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02406.fountain", "heading": "INT. HARGREAVE MANOR - KITCHEN - NIGHT", "cast": [{"id": 0, "name": "CONSTANCE HARGREAVE", "names": ["CONSTANCE HARGREAVE", "MRS. HARGREAVE"], "gender": "f", "first": 4, "spoke": 4}, {"id": 1, "name": "VOICE", "names": ["VOICE"], "gender": "?", "first": 12, "spoke": 2}, {"id": 2, "name": "ELIOT PEMBERTON", "names": ["ELIOT PEMBERTON", "PEMBERTON"], "gender": "m", "first": 22, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. HARGREAVE MANOR - KITCHEN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Black range, copper pans, a scrubbed oak table.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A dumbwaiter hatch in the wall, shut.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single gaslight hisses.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MRS. CONSTANCE HARGREAVE, fifties, in black bombazine, stands at the table, her hands on its edge.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "The house is silent.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "The cook has gone to bed.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "The dumbwaiter rope creaks.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "She freezes.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "dialogue", "text": "Who is hauling that?", "name": "MRS. HARGREAVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 10, "kind": "action", "text": "The rope creaks again.", "para": 3, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "The hatch shudders.", "para": 3, "sent": 1, "present": [0]}, {"u": 12, "kind": "action", "text": "A VOICE drifts down the shaft, thin and echoing.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Constance?", "name": "VOICE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Mrs. Hargreave goes white.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "That isn't possible.", "name": "MRS. HARGREAVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Constance, it's cold up here.", "name": "VOICE", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Be quiet.", "name": "MRS. HARGREAVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "The hatch slides open an inch, on its own.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Black beyond.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "A smell of damp earth.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "The kitchen door swings in.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "DR. ELIOT PEMBERTON, sixties, in a travelling coat, shakes snow from his hat and stops.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Good Lord. What's happened?", "name": "PEMBERTON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Mrs. Hargreave points at the hatch with a trembling hand.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "My husband is in the wall.", "name": "MRS. HARGREAVE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The gaslight gutters out.", "para": 8, "sent": 0, "present": [0, 1, 2]}]}