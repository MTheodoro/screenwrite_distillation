{"scene_id": "s02407", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02407.fountain", "heading": "INT. SCHOOL BUS - FOG ROAD - NIGHT", "cast": [{"id": 0, "name": "MABEL TRASK", "names": ["MABEL TRASK", "MABEL"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "CORA", "names": ["CORA"], "gender": "?", "first": 6, "spoke": 2}, {"id": 2, "name": "BAXTER", "names": ["BAXTER"], "gender": "?", "first": 7, "spoke": 2}, {"id": 3, "name": "OSWIN", "names": ["OSWIN"], "gender": "?", "first": 8, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. SCHOOL BUS - FOG ROAD - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A yellow bus idles on a country road, headlights swallowed by white fog.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The windows are fogged on the inside too.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rows of green vinyl seats, empty except for four.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MABEL TRASK, fifties, driver, grips the big wheel in cracked leather gloves.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She wears a cardigan and a hairnet and has not spoken since the engine stalled.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Behind her, in the first seat, CORA, ten, hugs a lunchbox.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Across the aisle, her brother BAXTER, eight, draws a face in the window glass.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "In the rear, hunched against the emergency door, OSWIN, fourteen, wears headphones around his neck.", "para": 1, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Why'd we stop?", "name": "BAXTER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Fog.", "name": "MABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "That's not a reason.", "name": "CORA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "It's the only one I've got.", "name": "MABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "There's something in the road.", "name": "OSWIN", "speaker": 3, "ext": [], "paren": ["from the back"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "There's something in the road.", "name": "CORA", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Mabel leans forward.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "The headlights show only white.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Then, at the edge of the beam, a tall figure, motionless, in a long coat, head tilted.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Stay in your seats.", "name": "MABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Is it a man?", "name": "BAXTER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "I don't know.", "name": "MABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "The figure takes a step.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Then another.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Mabel's hand slides to the door lever.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "The knuckles whiten.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Don't open it.", "name": "OSWIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "I'm not going to.", "name": "MABEL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "The figure lifts a hand.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Taps the glass of the windshield, once, with one long finger.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Mabel shuts off the headlights.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Dark.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Four sets of breathing.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}]}