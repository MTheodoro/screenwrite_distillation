{"scene_id": "s02408", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02408.fountain", "heading": "INT. BEEKEEPERS' CONVENTION - HOSPITALITY SUITE - NIGHT", "cast": [{"id": 0, "name": "LENKA PROCHAZKA-ODUYA", "names": ["LENKA PROCHAZKA-ODUYA", "LENKA"], "gender": "?", "first": 4, "spoke": 9}, {"id": 1, "name": "BASHIR KAMANGA", "names": ["BASHIR KAMANGA", "BASHIR"], "gender": "?", "first": 5, "spoke": 7}, {"id": 2, "name": "COLETTE VANTERPOOL", "names": ["COLETTE VANTERPOOL", "COLETTE"], "gender": "?", "first": 6, "spoke": 7}, {"id": 3, "name": "MAGNUS EKSTROM", "names": ["MAGNUS EKSTROM", "MAGNUS"], "gender": "?", "first": 6, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. BEEKEEPERS' CONVENTION - HOSPITALITY SUITE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A beige hotel function room hung with banners reading BUZZ 2026.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Folding tables of honey jars, a punch bowl, a cardboard cut-out of a queen bee with a crown.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Fluorescent light and carpet the colour of old tea.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LENKA PROCHAZKA-ODUYA, thirties, in a sage cardigan with a lanyard, arranges honey jars by shade of amber.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "BASHIR KAMANGA, thirties, in a bow tie, leans on the next table, pretending to read the label on a jar.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Near the punch, her friend COLETTE VANTERPOOL, forties, laughs at something on her phone, and beside her MAGNUS EKSTROM, fifties, stirs the punch with a ladle and tastes it with a frown.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "That's a clover.", "name": "BASHIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "It's a buckwheat.", "name": "LENKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "It's a clover that's had a hard life.", "name": "BASHIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Do you always correct strangers?", "name": "LENKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "I'm not a stranger. I'm the one who sat behind you at the keynote.", "name": "BASHIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "You were breathing on my neck.", "name": "LENKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "I was taking notes.", "name": "BASHIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Lenka! Come taste this!", "name": "COLETTE", "speaker": 2, "ext": [], "paren": ["across the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Excuse me.", "name": "LENKA", "speaker": 0, "ext": [], "paren": ["to Bashir"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "It needs more lemon.", "name": "MAGNUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "It needs less lemon.", "name": "COLETTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "It needs a different punch.", "name": "MAGNUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "What's the matter?", "name": "LENKA", "speaker": 0, "ext": [], "paren": ["arriving"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Magnus thinks he's a sommelier.", "name": "COLETTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "I am a sommelier.", "name": "MAGNUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "You're a retired dentist.", "name": "COLETTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "I'm both.", "name": "MAGNUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "May I try?", "name": "BASHIR", "speaker": 1, "ext": [], "paren": ["drifting over"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "By all means.", "name": "MAGNUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Bashir dips a cup, sips, and gives a thoughtful nod.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Honey. Citrus. A touch of regret.", "name": "BASHIR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "That's the buckwheat.", "name": "LENKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "He's cute.", "name": "COLETTE", "speaker": 2, "ext": [], "paren": ["to Lenka, low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "He's wrong about the clover.", "name": "LENKA", "speaker": 0, "ext": [], "paren": ["low, to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Then forgive him.", "name": "COLETTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Never.", "name": "LENKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "I'll wear you down.", "name": "BASHIR", "speaker": 1, "ext": [], "paren": ["overhearing"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "You can try.", "name": "LENKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "This is the most romantic thing I have ever seen at a beekeepers' convention.", "name": "MAGNUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "It's the only thing.", "name": "COLETTE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "And I've been to eleven.", "name": "MAGNUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}