{"scene_id": "s02410", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02410.fountain", "heading": "INT. SEEDSHIP ARK ORION - CRYO BAY - SHIP NIGHT", "cast": [{"id": 0, "name": "CAPTAIN IDRIS NWOSU-VALDEZ", "names": ["CAPTAIN IDRIS NWOSU-VALDEZ", "IDRIS"], "gender": "?", "first": 4, "spoke": 9}, {"id": 1, "name": "ENGINEER PELL KOVALENKO-ASANTE", "names": ["ENGINEER PELL KOVALENKO-ASANTE", "PELL"], "gender": "?", "first": 5, "spoke": 7}, {"id": 2, "name": "WICKET", "names": ["WICKET"], "gender": "?", "first": 6, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. SEEDSHIP ARK ORION - CRYO BAY - SHIP NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cathedral of frost-furred pods stretching into darkness.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Blue maintenance lights pulse along the deck.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Condensation drips from the ceiling in slow, measured drops.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CAPTAIN IDRIS NWOSU-VALDEZ, fifties, in a thermal jacket, walks the central aisle with a handheld scanner.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "ENGINEER PELL KOVALENKO-ASANTE, thirties, follows with a tool belt that jingles.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Between them, a drone the size of a toaster, WICKET, hovers and emits a low, cheerful chime.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Wicket, status.", "name": "IDRIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Pods one through forty nominal. Pod forty-one, reading unusual.", "name": "WICKET", "speaker": 2, "ext": [], "paren": ["synthetic"], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Unusual how?", "name": "PELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Warm.", "name": "WICKET", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Idris stops.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Pell stops.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Warm.", "name": "IDRIS", "speaker": 0, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "That's not on the manifest.", "name": "PELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Nothing's on the manifest tonight.", "name": "IDRIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "They hurry down the aisle.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "The pods blur by.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "At forty-one, a fogged glass hatch.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Behind it, a human shape, motionless.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Captain.", "name": "PELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "I see her.", "name": "IDRIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "She shouldn't be awake.", "name": "PELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "She isn't. Yet.", "name": "IDRIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "He wipes the glass with a sleeve.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "A woman's face, eyes closed, a bead of sweat on her brow.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Wicket, who is she?", "name": "IDRIS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Passenger forty-one. Dr. Amara Chukwu-Lindgren. Botanist.", "name": "WICKET", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "One of ours?", "name": "PELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "One of nobody's. She is not in the registry.", "name": "WICKET", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Pell steps back.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The scanner in Idris's hand chirps.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Everyone stay where you are.", "name": "IDRIS", "speaker": 0, "ext": [], "paren": ["to the bay, calm"], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "There's no one here to stay.", "name": "PELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "I know. I like saying it.", "name": "IDRIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "The pod's lights flicker green.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Captain, I think she's waking up.", "name": "PELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Then she's early.", "name": "IDRIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "By one hundred and eleven years.", "name": "WICKET", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "The hatch hisses.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Frost cracks.", "para": 7, "sent": 1, "present": [0, 1, 2]}]}