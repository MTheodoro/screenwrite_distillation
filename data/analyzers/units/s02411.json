{"scene_id": "s02411", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02411.fountain", "heading": "INT. APARTMENT KITCHEN - 3 A.M.", "cast": [{"id": 0, "name": "NOREEN CALLAHAN-SINGH", "names": ["NOREEN CALLAHAN-SINGH", "NOREEN"], "gender": "?", "first": 3, "spoke": 4}, {"id": 1, "name": "ANSELM CALLAHAN-SINGH", "names": ["ANSELM CALLAHAN-SINGH", "ANSELM"], "gender": "?", "first": 3, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. APARTMENT KITCHEN - 3 A.M.", "present": []}, {"u": 1, "kind": "action", "text": "One lamp.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A wailing baby monitor on the counter, its green bars spiking.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "NOREEN CALLAHAN-SINGH, thirties, in a faded T-shirt, jiggles a bottle on the stove, glances at the monitor, flips the burner off, and bangs the pot against the sink while her husband ANSELM CALLAHAN-SINGH, thirties, stumbles in with a blanket over his shoulder, bumps the doorframe, mutters a curse, grabs the bottle out of her hand, and shakes it near his ear to test the heat.", "para": 0, "sent": 2, "present": [0, 1]}, {"u": 4, "kind": "dialogue", "text": "It's too hot.", "name": "NOREEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "It's fine.", "name": "ANSELM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Test it on your wrist.", "name": "NOREEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Hold on, buddy. Daddy's coming.", "name": "ANSELM", "speaker": 1, "ext": [], "paren": ["to the monitor"], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Why is nobody else awake in this building?", "name": "NOREEN", "speaker": 0, "ext": [], "paren": ["to the kitchen"], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "They have earplugs.", "name": "ANSELM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She snatches the bottle back, holds it under the cold tap, and hands it over.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He nods once.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She leans on the counter and rubs her eyes as the cries rise to a pitch, then a hiccup, then, somehow, a silence.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "They look at the monitor.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "The bars flatten.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Don't breathe.", "name": "NOREEN", "speaker": 0, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "I'm not.", "name": "ANSELM", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1]}]}