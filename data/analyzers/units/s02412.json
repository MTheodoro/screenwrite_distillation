{"scene_id": "s02412", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02412.fountain", "heading": "INT. HIGH SCHOOL GYM - WRESTLING MAT - EVENING", "cast": [{"id": 0, "name": "COACH DELACROIX", "names": ["COACH DELACROIX"], "gender": "?", "first": 4, "spoke": 2}, {"id": 1, "name": "REFEREE BOHDAN", "names": ["REFEREE BOHDAN"], "gender": "m", "first": 5, "spoke": 2}, {"id": 2, "name": "HUGO ABERNATHY", "names": ["HUGO ABERNATHY"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "KARIM SZYMANSKI", "names": ["KARIM SZYMANSKI", "KARIM"], "gender": "?", "first": 6, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. HIGH SCHOOL GYM - WRESTLING MAT - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Bleachers half-full.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A banner reading STATE SEMIFINAL sags from the rafters.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Two boys in singlets circle on a faded blue mat.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "COACH DELACROIX, fifties, stands at the edge in a windbreaker, arms folded.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "REFEREE BOHDAN, sixties, crouches nearby with a whistle in his teeth.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "On the mat, HUGO ABERNATHY, seventeen, red singlet, and KARIM SZYMANSKI, seventeen, blue, lock hands.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "He drops low.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "He shoots.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "He grabs a leg and drives.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "The other boy sprawls and rolls, and he scrambles to his knees and goes for the half nelson, and for a second they are one tangle of limbs and sweat.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Stay off his hips!", "name": "COACH DELACROIX", "speaker": 0, "ext": [], "paren": ["to the whole gym"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Watch your hands.", "name": "REFEREE BOHDAN", "speaker": 1, "ext": [], "paren": ["to Hugo"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Come on, come on...", "name": "KARIM", "speaker": 3, "ext": [], "paren": ["muttering to himself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "The whistle shrieks.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "They break.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "The gym holds its breath.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Referee Bohdan points to the blue boy.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Two points.", "name": "REFEREE BOHDAN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "He gets up slowly.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "He looks at the scoreboard.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Looks at his coach.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Shakes out his arms and lowers himself back into a stance, and across from him the other boy exhales, long and loud, and settles in.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "You're fine. You're fine.", "name": "COACH DELACROIX", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}]}