{"scene_id": "s02413", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02413.fountain", "heading": "EXT. DRAINED POOL SKATE BOWL - DUSK", "cast": [{"id": 0, "name": "SADIE PRZYBYLSKI", "names": ["SADIE PRZYBYLSKI", "SADIE"], "gender": "f", "first": 5, "spoke": 4}, {"id": 1, "name": "JUNO TEAGUE-BALOGUN", "names": ["JUNO TEAGUE-BALOGUN", "JUNO"], "gender": "f", "first": 6, "spoke": 5}, {"id": 2, "name": "OLU", "names": ["OLU"], "gender": "m", "first": 7, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DRAINED POOL SKATE BOWL - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "Cracked turquoise concrete.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Graffiti tags.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A chain-link fence with a hole cut in it.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Orange sky.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "SADIE PRZYBYLSKI, sixteen, crouches at the lip with her board, knuckles whitened.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "At the bottom of the bowl, JUNO TEAGUE-BALOGUN, seventeen, spins a wheel with one finger.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Ten feet away, her friend OLU, seventeen, sits on the edge, a camera in his lap, not filming.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Nobody has said a word in a while.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "You're going to fall.", "name": "JUNO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I know.", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "So why?", "name": "JUNO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Sadie shrugs.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She drops in.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Wheels roar on concrete.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "She carves up the far wall, hangs for one stalled instant, and the board skids sideways from under her.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "She hits the bowl floor hard.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Juno is on her feet.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Olu is on his feet.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "All three hover.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "You good?", "name": "OLU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Yeah.", "name": "SADIE", "speaker": 0, "ext": [], "paren": ["laughing, wincing"], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "She sits up.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "A bloodied elbow.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Juno kneels.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Olu raises the camera, then lowers it again.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Let me see.", "name": "JUNO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "It's nothing.", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "It's something.", "name": "JUNO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Sadie pulls her arm away.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Juno lets her.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "They sit.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Olu sits too.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "The sky goes violet over the bowl, and a streetlight buzzes on.", "para": 6, "sent": 4, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "My dad's picking me up at eight.", "name": "OLU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Okay.", "name": "SADIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Okay.", "name": "JUNO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Nobody moves.", "para": 7, "sent": 0, "present": [0, 1, 2]}]}