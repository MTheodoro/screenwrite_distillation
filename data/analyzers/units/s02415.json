4]}, {"u": 10, "kind": "dialogue", "text": "You said that an hour ago.", "name": "BLAISE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Stop kicking.", "name": "TEODORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "He kicks harder.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "She slaps his knee.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "He yelps.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "The baby shrieks.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Mateus turns the radio up.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Turn that down.", "name": "ILSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "It's the good part.", "name": "MATEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "It's the same part it's always been.", "name": "ILSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Dad, he's kicking me.", "name": "TEODORA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Blaise.", "name": "MATEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "She started it.", "name": "BLAISE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Mateus, the exit.", "name": "ILSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "He swerves.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Brakes squeal.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "The cooler thumps.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Nandi howls.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "A truck blasts its horn.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Sorry. Sorry.", "name": "MATEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "You missed it.", "name": "ILSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "I did not.", "name": "MATEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "You did.", "name": "ILSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "I'm telling Mom you broke the cooler.", "name": "TEODORA", "speaker": 2, "ext": [], "paren": ["to Blaise, low"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "I did not!", "name": "BLAISE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "The giraffe flies across the car and hits the windshield.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Silence.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "The baby laughs.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}]}