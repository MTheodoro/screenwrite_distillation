{"scene_id": "s02416", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02416.fountain", "heading": "EXT. SUBURBAN DRIVEWAY - MOVING DAY - DUSK", "cast": [{"id": 0, "name": "THADDEUS GRIMALDI-HOLT", "names": ["THADDEUS GRIMALDI-HOLT", "THADDEUS"], "gender": "?", "first": 4, "spoke": 2}, {"id": 1, "name": "PHOEBE", "names": ["PHOEBE"], "gender": "?", "first": 5, "spoke": 4}, {"id": 2, "name": "REGGIE", "names": ["REGGIE"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "SUNITA", "names": ["SUNITA"], "gender": "?", "first": 6, "spoke": 0}, {"id": 4, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 6, "spoke": 2}, {"id": 5, "name": "DWIGHT", "names": ["DWIGHT"], "gender": "?", "first": 14, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SUBURBAN DRIVEWAY - MOVING DAY - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "An empty truck.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cardboard crushed in a pile.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A \"SOLD\" sign stuck in the lawn.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "THADDEUS GRIMALDI-HOLT, sixty, in work gloves, shuts the truck's rear door.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "His wife PHOEBE, fifty-eight, stands on the porch with an empty vase.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Their son REGGIE, thirty, and daughter-in-law SUNITA, twenty-eight, lean on a rented van, and a STRANGER in a sports coat pulls up in a sedan and gets out with a clipboard and a key.", "para": 1, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "dialogue", "text": "That's the last of it.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "It's not the last.", "name": "PHOEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "She goes inside.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "Comes out with a lamp.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Hands it to Reggie, who carries it to the van, trips on the kerb, catches himself, and sets the lamp on the roof as Sunita rushes in to rescue it, and Thaddeus laughs, and Phoebe laughs too, and then, abruptly, she doesn't.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Mr. and Mrs. Grimaldi-Holt?", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "That's us.", "name": "THADDEUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "I'm Dwight, from the title company. I just need the keys.", "name": "STRANGER", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Dwight.", "name": "PHOEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Yes, ma'am.", "name": "DWIGHT", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Forty-one years.", "name": "PHOEBE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "I understand.", "name": "DWIGHT", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "She lifts the key ring off her finger, slowly.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Looks at it.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Looks at the house.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Presses it into his palm and folds his fingers over it.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Be good to her.", "name": "PHOEBE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}