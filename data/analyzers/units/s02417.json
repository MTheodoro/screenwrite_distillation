{"scene_id": "s02417", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02417.fountain", "heading": "INT. TERRAFORM DOME CATHEDRAL - MORNING", "cast": [{"id": 0, "name": "IMOGEN VASQUEZ-LINDQ", "names": ["IMOGEN VASQUEZ-LINDQ", "IMOGEN"], "gender": "?", "first": 4, "spoke": 7}, {"id": 1, "name": "MAGISTRATE ODALIE FREMONT", "names": ["MAGISTRATE ODALIE FREMONT", "ODALIE"], "gender": "f", "first": 5, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. TERRAFORM DOME CATHEDRAL - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "A nave of living glass.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of saplings in the aisles.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Sunlight filters green through the canopy and falls on a stone altar in which a bonsai is rooted.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. IMOGEN VASQUEZ-LINDQ, fifties, tends the tree with a tiny pair of clippers.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Behind her, MAGISTRATE ODALIE FREMONT, sixties, in a long grey robe, enters through the great door and walks the aisle with unhurried steps.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "You're up early.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "The tree is.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "It doesn't sleep.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "It does. It just doesn't tell anyone.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Odalie stops beside the altar.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She lays a gloved hand on the trunk.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Imogen's clippers pause.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "The council voted last night.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "I heard.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Then you know.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "They're closing the dome.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Not closing. Reassigning.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "That's a lovely word for it.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": ["laughing softly"], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She resumes clipping.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "A leaf drops.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Odalie catches it in her palm.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "She asked me to give you this.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Who?", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "The one who planted it.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "She opens her hand.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "In it lies a small brass key.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Imogen stares.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Clippers fall from her fingers and ring on the stone.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "She said it didn't exist.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "She said many things.", "name": "ODALIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}