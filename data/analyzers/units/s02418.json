{"scene_id": "s02418", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02418.fountain", "heading": "INT. PRISONER TRANSPORT VAN - NIGHT", "cast": [{"id": 0, "name": "ATTORNEY LENORE ISHIGURO-BAPTISTE", "names": ["ATTORNEY LENORE ISHIGURO-BAPTISTE", "LENORE"], "gender": "?", "first": 5, "spoke": 7}, {"id": 1, "name": "DERRICK MALONEY", "names": ["DERRICK MALONEY", "DERRICK"], "gender": "m", "first": 6, "spoke": 6}, {"id": 2, "name": "DEPUTY RHONDA CALLOWAY", "names": ["DEPUTY RHONDA CALLOWAY", "CALLOWAY"], "gender": "?", "first": 7, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. PRISONER TRANSPORT VAN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A steel box on wheels.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Bench seats facing each other.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wire mesh between the compartments.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A bare bulb swings with every turn.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ATTORNEY LENORE ISHIGURO-BAPTISTE, forties, in a camel coat, perches on the end of the bench with a briefcase on her lap.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Across from her, DERRICK MALONEY, twenty-two, in an orange jumpsuit and wrist chains, glares at the floor.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "In the mesh-guarded front seat, DEPUTY RHONDA CALLOWAY, fifties, drives with one eye on the mirror.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Listen to me. Don't say anything at the arraignment.", "name": "LENORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "I didn't do it.", "name": "DERRICK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I know.", "name": "LENORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Then why are we-", "name": "DERRICK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Because the judge doesn't know.", "name": "LENORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "The van hits a pothole.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Derrick bangs his head on the wall.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "They said I'd get bail.", "name": "DERRICK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "They said maybe.", "name": "LENORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Maybe isn't bail.", "name": "DERRICK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Quiet back there.", "name": "CALLOWAY", "speaker": 2, "ext": [], "paren": ["from the front"], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "We're talking, Deputy.", "name": "LENORE", "speaker": 0, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "It's none of your business.", "name": "DERRICK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "It's all of my business. I'm driving.", "name": "CALLOWAY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Derrick leans forward.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "The chains rattle.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Lenore touches his knee with two fingers.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Derrick. Stop.", "name": "LENORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "He freezes.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Slowly sits back.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "The tension drains from his shoulders.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "He breathes out, long and unsteady.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Okay.", "name": "DERRICK", "speaker": 1, "ext": [], "paren": ["very quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Okay.", "name": "LENORE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The van turns a corner.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Through the mesh, Calloway's eyes meet Lenore's in the mirror, and for a moment, they share something like sympathy.", "para": 5, "sent": 1, "present": [0, 1, 2]}]}