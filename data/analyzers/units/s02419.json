{"scene_id": "s02419", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02419.fountain", "heading": "EXT. FLOODED QUARRY - NIGHT", "cast": [{"id": 0, "name": "THEA OYELARAN-MCBRIDE", "names": ["THEA OYELARAN-MCBRIDE", "THEA"], "gender": "f", "first": 6, "spoke": 5}, {"id": 1, "name": "JUNE", "names": ["JUNE"], "gender": "?", "first": 7, "spoke": 5}, {"id": 2, "name": "BASARAN", "names": ["BASARAN"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "RILEY DESCHAMPS-ADU", "names": ["RILEY DESCHAMPS-ADU", "RILEY"], "gender": "?", "first": 8, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FLOODED QUARRY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A bowl of black water ringed by white limestone cliffs.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Moonlight lays a long silver road across the surface.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Crickets.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Distant dogs.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Three bicycles lie in the grass.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "THEA OYELARAN-MCBRIDE, seventeen, stands on the lip of a twelve-foot ledge in her undershirt and shorts, toes curled over the edge.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Below, her cousin JUNIPER \"JUNE\" BASARAN, sixteen, treads water with her hair plastered to her skull, grinning up.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Behind Thea, on the rock, RILEY DESCHAMPS-ADU, seventeen, sits cross-legged with a towel over her shoulders, and she says nothing, and she watches.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Jump!", "name": "JUNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Give me a second.", "name": "THEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "You've had ten.", "name": "JUNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "I'm thinking.", "name": "THEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Don't think. Just fall.", "name": "JUNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Thea looks down.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "The water is a black mirror.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Her reflection wavers.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "You don't have to.", "name": "RILEY", "speaker": 3, "ext": [], "paren": ["from behind"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "I know I don't.", "name": "THEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Then why-", "name": "RILEY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Because June did.", "name": "THEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "I'm right here.", "name": "JUNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Thea steps back.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Steps forward.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Back again.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "The three of them breathe in the dark.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "A fish rises somewhere and breaks the silver road into pieces.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Thea shouts, a wordless animal sound, and runs three steps and leaps.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "She flails, arms wheeling, and plunges into the black.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "The splash soaks June, who yelps and goes under.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Riley leaps up, the towel falling, and scrambles to the edge.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Thea!", "name": "RILEY", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Nothing.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Ripples spread.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "The moon shatters and slowly reassembles.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Then two heads break the surface, gasping, laughing, spitting water, and June and Thea cling to each other in the middle of the quarry.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "You did it!", "name": "JUNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "I think I swallowed a frog.", "name": "THEA", "speaker": 0, "ext": [], "paren": ["coughing"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Riley sits down hard on the rock.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "She presses a hand to her chest, and her shoulders shake, and no one can tell if she is laughing or crying.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}]}