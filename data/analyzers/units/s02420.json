{"scene_id": "s02420", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02420.fountain", "heading": "INT. PARKING GARAGE ROOFTOP - BOCCE COURT - DUSK", "cast": [{"id": 0, "name": "INES VARGA", "names": ["INES VARGA", "INES"], "gender": "f", "first": 4, "spoke": 6}, {"id": 1, "name": "DOV LINDQVIST", "names": ["DOV LINDQVIST", "DOV"], "gender": "?", "first": 6, "spoke": 4}, {"id": 2, "name": "KALANI AKANA", "names": ["KALANI AKANA", "KALANI"], "gender": "m", "first": 10, "spoke": 2}, {"id": 3, "name": "ROSCOE BAPTISTE", "names": ["ROSCOE BAPTISTE", "ROSCOE"], "gender": "?", "first": 11, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. PARKING GARAGE ROOFTOP - BOCCE COURT - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "Astroturf laid over oil-stained concrete.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sodium lights flicker on.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A hand-painted sign: \"LEVEL 6 BOCCE CLUB.\"", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "INES VARGA (60s, windbreaker, clipboard she never writes on) stands at the foul line.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Arms folded.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "DOV LINDQVIST (17, hoodie, too-big sneakers) rolls a ball.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "It dies short.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Nobody speaks.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Ines marks nothing.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "KALANI AKANA (30s, delivery-driver vest still on) crouches by the pallino, measuring with a shoelace.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "ROSCOE BAPTISTE (70s, folding chair, thermos) watches from the exit ramp.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Again. Same lane.", "name": "INES", "speaker": 0, "ext": [], "paren": ["to everyone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Dov collects the balls.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Counts them twice.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Rolls again.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Short.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Twelve inches.", "name": "KALANI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Eleven.", "name": "DOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Kalani shows the shoelace.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Dov looks away.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Wind's up.", "name": "ROSCOE", "speaker": 3, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "There is no wind.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Ines walks to Dov.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Takes a ball from his hand.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Puts it back in the rack, gently.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Eat something.", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "I ate.", "name": "DOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "She looks at his sneakers.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Then at the empty parking spaces below the rail, where no car has come for him.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Kalani, you're up.", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Kalani stands.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Wipes her palms on the vest.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Rolls.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "The ball kisses the pallino and stops.", "para": 11, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Roscoe lifts the thermos in salute.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Nobody else reacts.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Lucky.", "name": "DOV", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Heard that.", "name": "KALANI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Last end. Then lights off.", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "She turns away to the stairwell door.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Pauses with her hand on the bar.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Your dad called the club line.", "name": "INES", "speaker": 0, "ext": ["CONT'D"], "paren": ["without turning"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Dov's hand stops over the rack.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "What did you tell him?", "name": "DOV", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "That we're closed.", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "She exits.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "The door sighs shut.", "para": 15, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Dov picks up a ball.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Rolls it.", "para": 16, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "It lands inches from the pallino.", "para": 16, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "He stares at it.", "para": 17, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Nobody congratulates him.", "para": 17, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Kalani quietly hands him the shoelace.", "para": 17, "sent": 2, "present": [0, 1, 2, 3]}]}