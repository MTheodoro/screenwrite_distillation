{"scene_id": "s02423", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02423.fountain", "heading": "INT. CAROUSEL WORKSHOP - DAY", "cast": [{"id": 0, "name": "XIMENA DELACROIX-ORTEGA", "names": ["XIMENA DELACROIX-ORTEGA", "XIMENA"], "gender": "f", "first": 5, "spoke": 4}, {"id": 1, "name": "WOMAN", "names": ["WOMAN"], "gender": "?", "first": 6, "spoke": 4}, {"id": 2, "name": "PAVEL KORCHAK", "names": ["PAVEL KORCHAK", "PAVEL"], "gender": "?", "first": 18, "spoke": 2}, {"id": 3, "name": "ISOLDE", "names": ["ISOLDE"], "gender": "?", "first": 23, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. CAROUSEL WORKSHOP - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Painted horses hang from ceiling chains.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Gold leaf.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Sawdust.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A radio plays accordion music.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "XIMENA DELACROIX-ORTEGA (30s, tool belt, brush behind her ear) paints an eye on a wooden stallion.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A WOMAN enters.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Grey raincoat.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Umbrella dripping.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "She scans the room.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Counts exits.", "para": 2, "sent": 4, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "You're the restorer?", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Depends who's asking.", "name": "XIMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Someone who needs the third horse from the left.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Ximena sets down the brush.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Wipes her hands slowly.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "That horse is spoken for.", "name": "XIMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "By who?", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "PAVEL KORCHAK (60s, apron, glasses on a cord) emerges from behind a lion.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Holds a mallet like a baton.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "By me.", "name": "PAVEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "The woman smiles.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Closes the umbrella.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Isolde Marchetti. Now we can all stop pretending.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Isolde. Right.", "name": "XIMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Beat.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Pavel lowers the mallet.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "You're early.", "name": "PAVEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Rain made the traffic light.", "name": "ISOLDE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "She approaches the third horse.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Taps its hollow belly.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "A soft metallic ring.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Still sealed?", "name": "ISOLDE", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Gold leaf over solder.", "name": "XIMENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Good. Nobody looks at a gilded horse.", "name": "ISOLDE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "The accordion swells.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Pavel turns the radio up.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}]}