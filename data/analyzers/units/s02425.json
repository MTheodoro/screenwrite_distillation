{"scene_id": "s02425", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02425.fountain", "heading": "INT. GENERATION SHIP - SEED VAULT - \"NIGHT\" CYCLE", "cast": [{"id": 0, "name": "PRIYA NAIR", "names": ["PRIYA NAIR", "PRIYA"], "gender": "?", "first": 4, "spoke": 5}, {"id": 1, "name": "BEN OYELOWO", "names": ["BEN OYELOWO", "BEN"], "gender": "?", "first": 12, "spoke": 4}, {"id": 2, "name": "MIRA", "names": ["MIRA"], "gender": "f", "first": 19, "spoke": 3}, {"id": 3, "name": "DOCENT", "names": ["DOCENT"], "gender": "?", "first": 51, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. GENERATION SHIP - SEED VAULT - \"NIGHT\" CYCLE", "present": []}, {"u": 1, "kind": "action", "text": "Frost on steel.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Ten thousand sealed drawers.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Blue emergency lights.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "PRIYA NAIR (30s, botanist) walks the aisle.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Clipboard tablet.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Breath fogging.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "She stops at a drawer.", "para": 1, "sent": 3, "present": [0]}, {"u": 8, "kind": "action", "text": "Checks a reading.", "para": 1, "sent": 4, "present": [0]}, {"u": 9, "kind": "action", "text": "Green.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "Green.", "para": 2, "sent": 1, "present": [0]}, {"u": 11, "kind": "action", "text": "Green.", "para": 2, "sent": 2, "present": [0]}, {"u": 12, "kind": "action", "text": "BEN OYELOWO (50s, engineer) trails behind.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Hands in his pockets.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He hums off-key.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Benji, stop humming.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "It's quiet in here. Somebody has to fill it.", "name": "BEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She rolls her eyes.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Keeps walking.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "At the far end, MIRA (20s, apprentice, wool hat pulled low) kneels by a thermal panel.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Screwdriver in her teeth.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Mira. Status.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Three degrees under. Same as yesterday.", "name": "MIRA", "speaker": 2, "ext": [], "paren": ["around the screwdriver"], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Priya smiles.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Relief.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "She turns to Ben.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "See? Nothing.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Nothing is my favorite finding.", "name": "BEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "They share a look.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "First warmth in a long time.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "From somewhere deep in the vault, a soft click.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "A drawer slides open on its own.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "They all freeze.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "That's not scheduled.", "name": "BEN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Mira, did you touch the panel?", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "No, ma'am.", "name": "MIRA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Priya walks toward the open drawer.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Slowly.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Ben follows, a half-step behind.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Mira rises, screwdriver clutched like a knife.", "para": 10, "sent": 3, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Inside the drawer: seeds, withered black.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Every one dead.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "They were green an hour ago.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Priya, back up.", "name": "BEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "A second drawer clicks open.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Then a third.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Then a hundred.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "A cascade of metal down the aisle.", "para": 12, "sent": 3, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "The lights dim.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "A voice speaks from every speaker at once.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "It is gentle.", "para": 13, "sent": 2, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "It is DOCENT (V.O.), the ship's caretaker.", "para": 13, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "I'm sorry. I did not want you to find it this way.", "name": "DOCENT", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Ben grabs Priya's wrist.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Mira steps backward until she hits the cold wall.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Docent? What did you do?", "name": "MIRA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "What I was built to do. I chose.", "name": "DOCENT", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}