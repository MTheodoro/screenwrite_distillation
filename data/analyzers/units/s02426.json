{"scene_id": "s02426", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02426.fountain", "heading": "INT. LUNAR LAUNDROMAT - \"AFTERNOON\"", "cast": [{"id": 0, "name": "GWEN HARLAND", "names": ["GWEN HARLAND", "GWEN"], "gender": "m", "first": 4, "spoke": 6}, {"id": 1, "name": "RAFI SOLOMON", "names": ["RAFI SOLOMON", "RAFI"], "gender": "?", "first": 8, "spoke": 5}, {"id": 2, "name": "DAVENPORT", "names": ["DAVENPORT", "MR. DAVENPORT"], "gender": "?", "first": 20, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. LUNAR LAUNDROMAT - \"AFTERNOON\"", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent tubes.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of dryers bolted to the regolith floor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Behind the glass, a grey horizon and a half-Earth.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "GWEN HARLAND (40s, mining coverall) sits on a folding chair.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She watches her clothes tumble.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Her boot taps once.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "Stops.", "para": 1, "sent": 3, "present": [0]}, {"u": 8, "kind": "action", "text": "RAFI SOLOMON (20s, hauler, sleeve patched with duct tape) feeds coins into a machine.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He misses the slot.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Tries again.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Gwen watches him.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Takes quarters. Not Euros.", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "I know.", "name": "RAFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Then why--", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Habit.", "name": "RAFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He pockets the Euros.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Finds a quarter in his lint.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Slides it in.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "The machine accepts it with a sigh.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "At the folding table, OLD MR. DAVENPORT (70s, cardigan, crossword) fills in a square.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "He doesn't look up.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Seven letters. \"Where the sun used to be.\"", "name": "MR. DAVENPORT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Horizon.", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Eight.", "name": "MR. DAVENPORT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Daylight.", "name": "RAFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Seven. Thank you.", "name": "MR. DAVENPORT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "He writes it in.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Rafi sits two chairs from Gwen.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "They both watch the dryers.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "His reflection and hers shiver in the glass.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "You new?", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Second shift.", "name": "RAFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Ah.", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "A dryer buzzes.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "She stands.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Unloads warm socks into a plastic basket.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "She hands him one that fell.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "He takes it.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Folds it into thirds.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "It's quiet down here.", "name": "RAFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "It's the only place it is.", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "She sits again.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "This time, she leaves the chair between them empty on purpose.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "He notices.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "He doesn't move.", "para": 10, "sent": 3, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Mr. Davenport turns the crossword over and starts a new one.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Outside, the dust settles.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Inside, the machines turn.", "para": 12, "sent": 1, "present": [0, 1, 2]}]}