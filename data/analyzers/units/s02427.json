{"scene_id": "s02427", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02427.fountain", "heading": "INT. RUINED BREWERY CELLAR - NIGHT", "cast": [{"id": 0, "name": "SERGEANT HOLLIS BRANNIGAN", "names": ["SERGEANT HOLLIS BRANNIGAN", "BRANNIGAN"], "gender": "m", "first": 4, "spoke": 8}, {"id": 1, "name": "PRIVATE TOMAS KEPLER", "names": ["PRIVATE TOMAS KEPLER", "KEPLER"], "gender": "m", "first": 5, "spoke": 5}, {"id": 2, "name": "CAPTAIN LUCIEN DUVAL", "names": ["CAPTAIN LUCIEN DUVAL", "DUVAL"], "gender": "m", "first": 31, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. RUINED BREWERY CELLAR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Vaulted brick, half collapsed.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Copper vats stand dented and silent.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dust sifts from the ceiling with every distant shell.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SERGEANT HOLLIS BRANNIGAN (30s, helmet strapped, face grey with plaster) crouches behind a barrel, rifle across his knee.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Opposite him, PRIVATE TOMAS KEPLER (19, glasses cracked at one corner) huddles with a radio set strapped to his back.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Kepler, get me headquarters.", "name": "BRANNIGAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Trying, Sarge.", "name": "KEPLER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He turns a dial.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Static, then a thread of music from far away.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He jerks back.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "That's a German station.", "name": "KEPLER", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Turn it off.", "name": "BRANNIGAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "I can't, it won't--", "name": "KEPLER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "A shell lands overhead.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Dust pours.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Brannigan drags Kepler under a vat.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "They crouch, shoulders pressed, breathing hard.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Listen. When this stops, we move. You first.", "name": "BRANNIGAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Me?", "name": "KEPLER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "You've got the radio.", "name": "BRANNIGAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Kepler nods.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Swallows.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "His hands shake.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Brannigan notices, says nothing, lays his own hand over the boy's for a moment.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Footsteps on the stairs.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Both men freeze.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Rifles up.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "A figure descends.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Hands raised.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Torn coat.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "CAPTAIN LUCIEN DUVAL (40s, French officer, bandage around his head) enters from the shadows, a lantern in one fist.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Do not shoot. I am on your side.", "name": "DUVAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Prove it.", "name": "BRANNIGAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Vive la France.", "name": "DUVAL", "speaker": 2, "ext": [], "paren": ["in English, slowly"], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "That's not proof.", "name": "KEPLER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "^Show me your tags.", "name": "BRANNIGAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Show me yours, American.", "name": "DUVAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Duval lowers the lantern.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Dust floats between the three men.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Slowly, Brannigan lowers the rifle.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Sit down, Captain. You look half dead.", "name": "BRANNIGAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Duval sits against a vat.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Draws a flask.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Offers it to Kepler.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Beer. From this very cellar. Before the war.", "name": "DUVAL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Kepler stares.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Takes it.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Drinks.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Coughs.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "A laugh bursts out of him, wet and astonished.", "para": 9, "sent": 4, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Overhead, the shelling resumes, closer.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "The three men look up as one.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "On three, we go.", "name": "BRANNIGAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "The lantern flame gutters.", "para": 11, "sent": 0, "present": [0, 1, 2]}]}