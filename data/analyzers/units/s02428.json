{"scene_id": "s02428", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02428.fountain", "heading": "INT. TELEPHONE EXCHANGE - SWITCHBOARD ROOM - NIGHT (1927)", "cast": [{"id": 0, "name": "NELL FAIRWEATHER", "names": ["NELL FAIRWEATHER", "NELL"], "gender": "f", "first": 4, "spoke": 5}, {"id": 1, "name": "ADELAIDE PRUITT", "names": ["ADELAIDE PRUITT", "ADELAIDE"], "gender": "f", "first": 5, "spoke": 5}, {"id": 2, "name": "LOUISA COBB", "names": ["LOUISA COBB", "LOUISA"], "gender": "f", "first": 6, "spoke": 2}, {"id": 3, "name": "CALLER", "names": ["CALLER"], "gender": "?", "first": 8, "spoke": 2}, {"id": 4, "name": "FIRE CAPTAIN", "names": ["FIRE CAPTAIN"], "gender": "?", "first": 27, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. TELEPHONE EXCHANGE - SWITCHBOARD ROOM - NIGHT (1927)", "present": []}, {"u": 1, "kind": "action", "text": "A long room of mahogany switchboards.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rows of operators in headsets, cords snaking in brass.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Gas lamps hiss.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "NELL FAIRWEATHER (20s, operator, tight bun) plugs a cord into a jack.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "At the next board, ADELAIDE PRUITT (40s, supervisor, pince-nez) watches over her shoulder.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Behind them, LOUISA COBB (50s, veteran operator, knitting needle in her hair) works two cords at once.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Number, please.", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Mayfair 2290.", "name": "CALLER", "speaker": 3, "ext": ["V.O."], "paren": ["over the line, crackling"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "One moment.", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "She plugs.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "The line hums.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Adelaide leans closer.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Dear, who is that?", "name": "ADELAIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "A gentleman. He sounds upset.", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Let me hear.", "name": "ADELAIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "She takes a spare headset.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Listens.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Her face changes.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Tell them the bank is on fire.", "name": "CALLER", "speaker": 3, "ext": ["V.O."], "paren": ["over the line"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Adelaide rips off the headset.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Louisa! Ring the fire brigade!", "name": "ADELAIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Already plugged, ma'am!", "name": "LOUISA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "^Brigade on the line!", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "^Brigade on the line!", "name": "LOUISA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "They speak in perfect unison, startled at themselves, and nearly laugh.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "The line crackles.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "A new voice, the FIRE CAPTAIN (V.O.), booms through the headset.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Engine Four rolling. Thank you, ladies.", "name": "FIRE CAPTAIN", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Nell lowers her cord.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Her hands shake.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Adelaide places a firm palm on her shoulder.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "You did well.", "name": "ADELAIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "I only said \"number, please.\"", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Sometimes that's all it takes.", "name": "ADELAIDE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Louisa unplugs the last cord with a click.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "The room exhales.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "A hundred cords sway.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Quiet returns.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}]}