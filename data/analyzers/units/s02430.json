{"scene_id": "s02430", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02430.fountain", "heading": "EXT. SLED DOG RACE - MIDPOINT CHECKPOINT - NIGHT", "cast": [{"id": 0, "name": "NILA KOYUK", "names": ["NILA KOYUK", "NILA"], "gender": "f", "first": 7, "spoke": 16}, {"id": 1, "name": "HESTER VANCE", "names": ["HESTER VANCE", "VANCE"], "gender": "?", "first": 13, "spoke": 13}, {"id": 2, "name": "RACE MARSHAL", "names": ["RACE MARSHAL"], "gender": "?", "first": 28, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SLED DOG RACE - MIDPOINT CHECKPOINT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A frozen lake.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wind carves the snow into long, sharp ridges.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A canvas tent glows orange at the shore, lit by a generator whose hum is swallowed by the dark.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Beyond it, forty sled dogs lie curled in straw beds, steam rising off their backs.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A battered radio on a folding table crackles.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "A hand-lettered sign flaps from a pole: \"CHECKPOINT 6 - 480 MILES TO GO.\"", "para": 1, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "NILA KOYUK (30s, musher, parka stiff with ice, goggles pushed up) stands at the edge of the straw, counting dogs under her breath.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Eleven.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "Twelve.", "para": 2, "sent": 2, "present": [0]}, {"u": 10, "kind": "action", "text": "Thirteen.", "para": 2, "sent": 3, "present": [0]}, {"u": 11, "kind": "action", "text": "She stops.", "para": 2, "sent": 4, "present": [0]}, {"u": 12, "kind": "action", "text": "Counts again.", "para": 2, "sent": 5, "present": [0]}, {"u": 13, "kind": "action", "text": "DR. HESTER VANCE (50s, race veterinarian, round glasses fogged white) kneels beside a sleek husky named Biscuit.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She runs her gloved fingers along the dog's foreleg.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Easy, girl. Easy.", "name": "VANCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "How's the wrist?", "name": "NILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "She's favoring it. Not broken. Not good, either.", "name": "VANCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "She's my lead dog, Doc.", "name": "NILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Then she shouldn't lead tonight.", "name": "VANCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Nila crouches.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "The wind pushes at her hood.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "She takes Biscuit's face in both hands.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "The dog licks her chin.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Hey, Biscuit. Hey. You tired?", "name": "NILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "The dog thumps her tail.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Nila exhales, long and slow.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "The radio crackles.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "RACE MARSHAL (V.O.) comes through, flat with distance.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Checkpoint Six, this is Marshal. Weather's closing from the north. Teams have a two-hour window.", "name": "RACE MARSHAL", "speaker": 2, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Copy, Marshal. Two hours.", "name": "NILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Koyuk, you're in third. Chandler is forty minutes ahead.", "name": "RACE MARSHAL", "speaker": 2, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Nila's jaw tightens.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Vance glances up.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Forty minutes isn't far.", "name": "VANCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "It's far enough.", "name": "NILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "She stands.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Brushes snow from her knees.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Looks across the lake, where nothing but white and darkness meets.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Doc, what would you do?", "name": "NILA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "I'd scratch.", "name": "VANCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "I mean really.", "name": "NILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Really? I'd scratch.", "name": "VANCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Nila laughs, short and bitter.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "That's not very sporting.", "name": "NILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "I'm a vet. I treat the ones who can't speak. You know what she's saying right now.", "name": "VANCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Both women look at Biscuit.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "The dog limps one step, then another, then stops and looks back at Nila, ears forward.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "She wants to go.", "name": "NILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "She wants to please you. There's a difference.", "name": "VANCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Silence.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "The generator coughs.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "The wind rises.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Nila walks to the sled.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Checks the brush bow.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Runs a hand along the runner.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Doesn't pick up the snow hook.", "para": 12, "sent": 3, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "Two hours.", "name": "NILA", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "She turns back.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "Doc, give me a second lead. Anyone.", "name": "NILA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "Pepper's strong. Not fast.", "name": "VANCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Strong is fine.", "name": "NILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "Vance stands and whistles.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "A gray dog bounds out of the straw, tail whipping.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "Pepper. You're promoted.", "name": "VANCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "Don't let me down.", "name": "NILA", "speaker": 0, "ext": [], "paren": ["to the dog"], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "Pepper barks once, bright and sure.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "The radio crackles again.", "para": 16, "sent": 0, "present": [0, 1, 2]}, {"u": 68, "kind": "dialogue", "text": "Koyuk, confirm you're rolling?", "name": "RACE MARSHAL", "speaker": 2, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "Nila lifts the handset.", "para": 17, "sent": 0, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "Looks at Vance.", "para": 17, "sent": 1, "present": [0, 1, 2]}, {"u": 71, "kind": "action", "text": "Vance gives the smallest nod.", "para": 17, "sent": 2, "present": [0, 1, 2]}, {"u": 72, "kind": "dialogue", "text": "Rolling, Marshal. Give me a green flag.", "name": "NILA", "speaker": 0, "ext": [], "paren": ["into the radio"], "dual": false, "present": [0, 1, 2]}, {"u": 73, "kind": "action", "text": "She hangs up.", "para": 18, "sent": 0, "present": [0, 1, 2]}, {"u": 74, "kind": "action", "text": "Pulls her goggles down.", "para": 18, "sent": 1, "present": [0, 1, 2]}, {"u": 75, "kind": "dialogue", "text": "Doc, if it goes bad--", "name": "NILA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 76, "kind": "dialogue", "text": "Then I'll be here with a heater and a flask.", "name": "VANCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 77, "kind": "dialogue", "text": "Sounds like a plan.", "name": "NILA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 78, "kind": "dialogue", "text": "It's the only one I've got.", "name": "VANCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 79, "kind": "action", "text": "Nila steps onto the runners.", "para": 19, "sent": 0, "present": [0, 1, 2]}, {"u": 80, "kind": "action", "text": "Biscuit watches her go from the straw.", "para": 19, "sent": 1, "present": [0, 1, 2]}, {"u": 81, "kind": "action", "text": "Her tail slowly sinks.", "para": 19, "sent": 2, "present": [0, 1, 2]}, {"u": 82, "kind": "action", "text": "Vance kneels beside the old lead dog.", "para": 20, "sent": 0, "present": [0, 1, 2]}, {"u": 83, "kind": "dialogue", "text": "She'll be back, girl.", "name": "VANCE", "speaker": 1, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 84, "kind": "action", "text": "The sled lurches.", "para": 21, "sent": 0, "present": [0, 1, 2]}, {"u": 85, "kind": "action", "text": "Thirteen dogs pull into the blue dark.", "para": 21, "sent": 1, "present": [0, 1, 2]}, {"u": 86, "kind": "action", "text": "The tent shrinks to a single orange spark, then nothing.", "para": 21, "sent": 2, "present": [0, 1, 2]}, {"u": 87, "kind": "action", "text": "Vance stays kneeling, one hand on Biscuit's flank, until the radio crackles with the next team.", "para": 22, "sent": 0, "present": [0, 1, 2]}]}