{"scene_id": "s02431", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02431.fountain", "heading": "INT. FERRY TICKET BOOTH - NIGHT", "cast": [{"id": 0, "name": "AGNES VERHOEVEN", "names": ["AGNES VERHOEVEN", "AGNES"], "gender": "f", "first": 4, "spoke": 4}, {"id": 1, "name": "ILYAS BENALI", "names": ["ILYAS BENALI", "ILYAS"], "gender": "?", "first": 6, "spoke": 2}, {"id": 2, "name": "JUNIPER PARK", "names": ["JUNIPER PARK", "JUNIPER"], "gender": "?", "first": 16, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. FERRY TICKET BOOTH - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cramped glass cubicle on a dock.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rain streaks the windows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "One heater glows orange.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "AGNES VERHOEVEN (60s, cardigan, reading glasses) counts coins into neat towers.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She does not look up when the door opens.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "A young man, ILYAS BENALI (20s, soaked jacket, duffel bag), steps in and stands dripping on the mat.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He holds out a crumpled ticket.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Last boat left an hour ago.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "It says ten fifteen.", "name": "ILYAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "It says a lot of things.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He keeps holding the ticket.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She finally takes it.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Smooths it flat with her thumb.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Studies it too long.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Behind Ilyas, the door opens again.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "A teenage girl, JUNIPER PARK (16, backpack, earbuds), slips in and stands against the wall, pretending not to listen.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "My mother is on that island.", "name": "ILYAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Then she'll still be there tomorrow.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "He slams the duffel onto the counter.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Coins jump.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Agnes does not flinch.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "She re-stacks them one by one.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Juniper pulls out an earbud.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "I have a boat.", "name": "JUNIPER", "speaker": 2, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Both turn to her.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "She shrugs, suddenly shy.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "My dad's. It's small. I can take you.", "name": "JUNIPER", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Agnes lays down her glasses.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Studies the girl.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Then Ilyas.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Then the ticket.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "She tears it in half and slides the pieces across the counter.", "para": 8, "sent": 4, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Refund. Go.", "name": "AGNES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Ilyas stares.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Then, wordlessly, he takes the halves and follows Juniper out into the rain.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Agnes watches them disappear.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Picks up her coins.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Starts again from one.", "para": 10, "sent": 2, "present": [0, 1, 2]}]}