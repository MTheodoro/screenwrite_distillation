{"scene_id": "s02432", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02432.fountain", "heading": "INT. MOONLIT GLASSHOUSE - NIGHT", "cast": [{"id": 0, "name": "LYRA THISTLEWOOD", "names": ["LYRA THISTLEWOOD", "LYRA"], "gender": "f", "first": 5, "spoke": 4}, {"id": 1, "name": "ORRIN ASHGROVE", "names": ["ORRIN ASHGROVE", "ORRIN"], "gender": "m", "first": 7, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. MOONLIT GLASSHOUSE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A vast greenhouse overgrown with silver ferns.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Every pane glows faintly blue.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Fireflies drift like loose stars.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "In the center, a stone fountain trickles water that sparkles like crushed glass.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LYRA THISTLEWOOD (20s, witch's apprentice, patched green cloak, a satchel of dried herbs) kneels by the fountain, whispering to a small seedling.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A shadow falls over her.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "ORRIN ASHGROVE (60s, gaunt, a staff of black ash, eyes the color of old coins) steps from between the ferns.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You are trespassing.", "name": "ORRIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I'm borrowing.", "name": "LYRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "That is a more polite word for the same crime.", "name": "ORRIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Lyra rises, clutching the seedling to her chest.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "It was dying. Nobody was tending it.", "name": "LYRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "It was not yours to save.", "name": "ORRIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "^It was not yours to starve.", "name": "LYRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "They speak at once, sharp and certain.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "The fountain's trickle stops.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Fireflies freeze mid-flight.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Orrin lowers his staff.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "A long breath leaves him.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "The fireflies stir again.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Plant it by the east wall. It needs the morning.", "name": "ORRIN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Lyra blinks.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "A smile flickers.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "You are not going to curse me?", "name": "LYRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Not before breakfast.", "name": "ORRIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}