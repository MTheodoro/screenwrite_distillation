{"scene_id": "s02433", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02433.fountain", "heading": "INT. MINIVAN - AUTOMATIC CAR WASH - DAY", "cast": [{"id": 0, "name": "CAROL DREXLER", "names": ["CAROL DREXLER", "CAROL"], "gender": "f", "first": 4, "spoke": 24}, {"id": 1, "name": "MAYA DREXLER", "names": ["MAYA DREXLER", "MAYA"], "gender": "f", "first": 4, "spoke": 23}], "units": [{"u": 0, "kind": "heading", "text": "INT. MINIVAN - AUTOMATIC CAR WASH - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Soapy foam slides down the windshield in thick white ropes.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Giant blue brushes thump and whirl.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The minivan sits motionless on the track, trapped in a dim, wet cave.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CAROL DREXLER (40s, bun, sunglasses on her head, a coffee cup that has gone cold) grips the wheel with both hands.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "In the passenger seat, her daughter MAYA DREXLER (15, hoodie, knees up, phone dark in her lap) stares at the side mirror.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Neither speaks.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "The brushes thump.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Seatbelt.", "name": "CAROL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "It's on.", "name": "MAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "It's behind you.", "name": "CAROL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Maya yanks it across.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Clicks it in.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Hard.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Thank you.", "name": "CAROL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "You're welcome.", "name": "MAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "The brushes sweep over the roof with a long howl.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Carol flinches.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Maya notices and pretends not to.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Twelve dollars. For this.", "name": "CAROL", "speaker": 0, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "You could have just washed it at home.", "name": "MAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "We don't have a hose.", "name": "CAROL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "We have a hose. Dad has a hose.", "name": "MAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Carol's knuckles whiten.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I'm not talking about your father.", "name": "CAROL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "You just did.", "name": "MAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "You brought him up.", "name": "CAROL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "I said \"hose.\"", "name": "MAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "You said it like a weapon.", "name": "CAROL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Maya turns, finally, to look at her mother.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Her eyes are red-rimmed but dry.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Can we just go?", "name": "MAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Where? We're in a tunnel, Maya.", "name": "CAROL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Then can we stop pretending this is about the car?", "name": "MAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Carol laughs once, sharp.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "It cracks.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "She lifts the cup, drinks the cold coffee, grimaces.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Everyone out there gets a clean car. I get this.", "name": "CAROL", "speaker": 0, "ext": [], "paren": ["to the windshield"], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Mom. Out loud, please.", "name": "MAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "I said it out loud.", "name": "CAROL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "You said it to the foam.", "name": "MAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Carol sets the cup in the holder too hard.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Coffee sloshes over her wrist.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "She ignores it.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "You want out loud? Fine. I'm tired.", "name": "CAROL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Okay.", "name": "MAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "I'm tired of driving you to your father's. I'm tired of driving you back. I'm tired of him calling you before I do.", "name": "CAROL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "He doesn't--", "name": "MAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "He does.", "name": "CAROL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "He calls to ask about me, not about you.", "name": "MAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Is that supposed to make it better?", "name": "CAROL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "Maya says nothing.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "The brushes slam against the van.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "Water roars.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "The cabin shakes.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 56, "kind": "dialogue", "text": "He asked if you were okay.", "name": "MAYA", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "Carol freezes.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "Her hand drifts to her mouth.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "When?", "name": "CAROL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "Sunday.", "name": "MAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "What did you say?", "name": "CAROL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "I said you were fine.", "name": "MAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "Well, that was a lie.", "name": "CAROL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "I know.", "name": "MAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "A long beat.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "The water slows.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 67, "kind": "action", "text": "The foam slides off the glass in thick sheets.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "Carol reaches across the console.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "Maya doesn't pull away.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 70, "kind": "action", "text": "Their hands meet on the cup holder, sticky with coffee.", "para": 12, "sent": 2, "present": [0, 1]}, {"u": 71, "kind": "dialogue", "text": "I'm sorry I yelled at the car wash.", "name": "CAROL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 72, "kind": "dialogue", "text": "You didn't yell.", "name": "MAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 73, "kind": "dialogue", "text": "I thought about it.", "name": "CAROL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 74, "kind": "action", "text": "Maya almost smiles.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 75, "kind": "action", "text": "Wipes her nose on her sleeve.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 76, "kind": "dialogue", "text": "Can I say something?", "name": "MAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 77, "kind": "dialogue", "text": "Always.", "name": "CAROL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 78, "kind": "dialogue", "text": "I don't want to pick.", "name": "MAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 79, "kind": "dialogue", "text": "I know, baby.", "name": "CAROL", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1]}, {"u": 80, "kind": "dialogue", "text": "I mean it. I don't want to ride in one car and then the other like I'm a package.", "name": "MAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 81, "kind": "dialogue", "text": "You're not a package.", "name": "CAROL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 82, "kind": "dialogue", "text": "It feels like it.", "name": "MAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 83, "kind": "action", "text": "Carol closes her eyes.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 84, "kind": "action", "text": "Maya squeezes her hand.", "para": 14, "sent": 1, "present": [0, 1]}, {"u": 85, "kind": "action", "text": "They sit, joined, as the dryers roar and warm air blasts across the windshield.", "para": 14, "sent": 2, "present": [0, 1]}, {"u": 86, "kind": "action", "text": "The light ahead turns green.", "para": 15, "sent": 0, "present": [0, 1]}, {"u": 87, "kind": "action", "text": "A gate lifts.", "para": 15, "sent": 1, "present": [0, 1]}, {"u": 88, "kind": "action", "text": "Daylight spills in.", "para": 15, "sent": 2, "present": [0, 1]}, {"u": 89, "kind": "action", "text": "Carol opens her eyes.", "para": 16, "sent": 0, "present": [0, 1]}, {"u": 90, "kind": "action", "text": "Both women look at the bright rectangle of the exit.", "para": 16, "sent": 1, "present": [0, 1]}, {"u": 91, "kind": "action", "text": "Neither moves to start the engine.", "para": 16, "sent": 2, "present": [0, 1]}, {"u": 92, "kind": "dialogue", "text": "Let's sit a minute.", "name": "CAROL", "speaker": 0, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1]}, {"u": 93, "kind": "dialogue", "text": "Okay.", "name": "MAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 94, "kind": "action", "text": "The dryers sigh and fall quiet.", "para": 17, "sent": 0, "present": [0, 1]}, {"u": 95, "kind": "action", "text": "The van rests in the doorway of the sun.", "para": 17, "sent": 1, "present": [0, 1]}]}