{"scene_id": "s02435", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02435.fountain", "heading": "INT. STAGECOACH WAY STATION - SUPPER - NIGHT", "cast": [{"id": 0, "name": "CALLOWAY DREW", "names": ["CALLOWAY DREW", "CALLOWAY"], "gender": "m", "first": 4, "spoke": 10}, {"id": 1, "name": "ABIGAIL STROUD", "names": ["ABIGAIL STROUD", "ABIGAIL"], "gender": "f", "first": 5, "spoke": 5}, {"id": 2, "name": "REUBEN TALLCHIEF", "names": ["REUBEN TALLCHIEF", "REUBEN"], "gender": "?", "first": 6, "spoke": 6}, {"id": 3, "name": "HOMER PRICE", "names": ["HOMER PRICE", "HOMER"], "gender": "?", "first": 7, "spoke": 3}, {"id": 4, "name": "MAGDALENA SOTO", "names": ["MAGDALENA SOTO", "MAGDALENA"], "gender": "f", "first": 8, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. STAGECOACH WAY STATION - SUPPER - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A low adobe room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "One long table, a smoking lamp, a cracked piano that no one has played in years.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Wind rattles the shutters.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CALLOWAY DREW (40s, dusty duster, tin star pinned inside the collar) sits at the head of the table, eating beans without hurry.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Beside him, ABIGAIL STROUD (30s, widow's black, gloves still on) pushes her plate away.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Across from them, REUBEN TALLCHIEF (50s, stagecoach driver, scarred hands) cuts bread.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "HOMER PRICE (20s, station boy, apron too long) fills cups.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "MAGDALENA SOTO (40s, cook, sleeves rolled) stands at the stove with her back to the room.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Good beans.", "name": "CALLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Same beans as last week.", "name": "MAGDALENA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Then I was wrong last week.", "name": "CALLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "The coach is late.", "name": "REUBEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "It's always late.", "name": "CALLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Not this late.", "name": "REUBEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Perhaps the road is bad.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Road's the same as always, ma'am.", "name": "REUBEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Mr. Tallchief says there's something moving out past the dry wash. He saw it from the roof.", "name": "HOMER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "I said no such thing, boy.", "name": "REUBEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "You said \"somebody.\"", "name": "HOMER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Homer. Cups.", "name": "MAGDALENA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Homer pours.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "His hand shakes.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "A little coffee spills on the table.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Easy.", "name": "CALLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Yes, sir.", "name": "HOMER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Marshal, what is a man like you doing at a way station?", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Eating beans.", "name": "CALLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "That is not an answer.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "It's the true one.", "name": "CALLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "He's waiting on somebody.", "name": "MAGDALENA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Magdalena.", "name": "CALLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "What? She asked.", "name": "MAGDALENA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "I'll tell you what he's waiting on. He's waiting on whoever shot Harlan Boyce at the Platte crossing.", "name": "REUBEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "^I did.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "^She did.", "name": "REUBEN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "They say it at the same instant, one with certainty, one with dread.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "The wind stops.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "The lamp flame stands straight.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Calloway sets his spoon down.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Ma'am?", "name": "CALLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Abigail pulls off one glove.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Lays it on the table.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Then the other.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Harlan Boyce killed my husband. I waited eleven years. I was a very patient woman.", "name": "ABIGAIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Nobody moves.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Homer drops the pot.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "It rings on the floor like a church bell.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Magdalena, lock the door.", "name": "CALLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "It's already locked.", "name": "MAGDALENA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Then lock it again.", "name": "CALLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}