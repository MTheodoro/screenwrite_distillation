{"scene_id": "s02436", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02436.fountain", "heading": "INT. ABANDONED DRIVE-IN CONCESSION STAND - NIGHT", "cast": [{"id": 0, "name": "CASS WHITLOCK", "names": ["CASS WHITLOCK", "CASS"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "DRE FONTAINE", "names": ["DRE FONTAINE", "DRE"], "gender": "m", "first": 5, "spoke": 6}, {"id": 2, "name": "PILAR NAVARRO", "names": ["PILAR NAVARRO", "PILAR"], "gender": "?", "first": 6, "spoke": 6}, {"id": 3, "name": "WENDELL OKORO", "names": ["WENDELL OKORO", "WENDELL"], "gender": "m", "first": 7, "spoke": 6}, {"id": 4, "name": "SOUND", "names": ["SOUND"], "gender": "?", "first": 14, "spoke": 0}, {"id": 5, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 25, "spoke": 4}, {"id": 6, "name": "ELIAS", "names": ["ELIAS"], "gender": "?", "first": 38, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED DRIVE-IN CONCESSION STAND - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dead popcorn machine.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A counter thick with dust.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Through the broken window, a giant blank screen glows faintly in the moonlight, its white surface pocked with rain stains.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CASS WHITLOCK (20s, flashlight, hoodie) crouches behind the counter, sorting through a box of old tickets.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "DRE FONTAINE (20s, camera around neck) films the room.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "PILAR NAVARRO (20s, sweater, scared but trying not to be) holds a thermos with both hands.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "WENDELL OKORO (30s, backpack, glasses) sits on an upturned bucket, reading from his phone.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Nothing in here but mice.", "name": "CASS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Mice are content. Keep rolling.", "name": "DRE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "According to the blog, a projectionist died in 1974. Burned alive in the booth.", "name": "WENDELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Can we not?", "name": "PILAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "I'm just reading.", "name": "WENDELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Read quieter.", "name": "DRE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "A SOUND outside.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "A thin, rhythmic scrape, like a shovel on gravel.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "All four freeze.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Was that you?", "name": "PILAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "I'm right here.", "name": "CASS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Somebody's out there.", "name": "DRE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Maybe a groundskeeper.", "name": "WENDELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Nobody's kept this ground in thirty years.", "name": "PILAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "The scraping stops.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "The door handle turns slowly.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Then the door swings open on its own.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "A STRANGER stands in the doorway.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Soaked coat, no hat.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "His face hidden in the dark.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "You shouldn't be here.", "name": "STRANGER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Sir, we're just--", "name": "CASS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "You shouldn't be here.", "name": "STRANGER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Dude, you scared the hell out of us.", "name": "DRE", "speaker": 1, "ext": [], "paren": ["lowering the camera"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "We'll leave.", "name": "PILAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "We were leaving. We were literally--", "name": "WENDELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "It's not you I worry about.", "name": "STRANGER", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Dre's flashlight finds his face.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Gaunt, kind, tired.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Not at all what they expected.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "My name is Elias. I keep the screen.", "name": "STRANGER", "speaker": 5, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "dialogue", "text": "There's a screen?", "name": "PILAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "There's always a screen. And at midnight it plays.", "name": "ELIAS", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "dialogue", "text": "Plays what?", "name": "WENDELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "dialogue", "text": "Whatever you're most afraid of.", "name": "ELIAS", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "Cass laughs, nervous.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "Dre raises the camera again.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "Okay, that's good. Do that again.", "name": "DRE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "dialogue", "text": "It's ten to midnight.", "name": "ELIAS", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "Pilar grabs Cass's sleeve.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "Wendell closes his phone.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "action", "text": "Beyond the window, the giant screen flickers from white to grey to black.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "dialogue", "text": "Cass, I want to go.", "name": "PILAR", "speaker": 2, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "dialogue", "text": "We're going.", "name": "CASS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "dialogue", "text": "Which way?", "name": "WENDELL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "dialogue", "text": "Don't take the road. Take the field.", "name": "ELIAS", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "dialogue", "text": "Why the field?", "name": "DRE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "dialogue", "text": "Because the road is where it waits.", "name": "ELIAS", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "action", "text": "The first frame of film lights the screen.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "action", "text": "Four faces turn toward it, orange and bright.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "action", "text": "On the screen: the concession stand.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 59, "kind": "action", "text": "Four silhouettes in the window.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 60, "kind": "action", "text": "And behind them, a fifth.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}]}