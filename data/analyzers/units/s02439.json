{"scene_id": "s02439", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02439.fountain", "heading": "EXT. SALT FLATS - DUSK", "cast": [{"id": 0, "name": "AMOS QUARLES", "names": ["AMOS QUARLES", "AMOS"], "gender": "?", "first": 4, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SALT FLATS - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "Blinding white ground.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A lone wagon with a broken wheel.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Heat shimmer.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "AMOS QUARLES (50s, sunburned, hat brim torn) sits on the tailgate with a pencil stub and a crumpled sheet of paper.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He writes.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "Stops.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "Rereads.", "para": 1, "sent": 3, "present": [0]}, {"u": 8, "kind": "dialogue", "text": "Dear Ruth. The wheel went at noon. The water went at two.", "name": "AMOS", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0]}, {"u": 9, "kind": "action", "text": "He licks the pencil.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "dialogue", "text": "I walked to the ridge. Nothing there but wind.", "name": "AMOS", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 11, "kind": "action", "text": "He stands.", "para": 3, "sent": 0, "present": [0]}, {"u": 12, "kind": "action", "text": "Shades his eyes.", "para": 3, "sent": 1, "present": [0]}, {"u": 13, "kind": "action", "text": "Nothing in any direction.", "para": 3, "sent": 2, "present": [0]}, {"u": 14, "kind": "action", "text": "Amos kicks the dead wheel.", "para": 4, "sent": 0, "present": [0]}, {"u": 15, "kind": "action", "text": "It rolls an inch, falls over.", "para": 4, "sent": 1, "present": [0]}, {"u": 16, "kind": "dialogue", "text": "I think I'll wait for the stars. They never lied to me yet.", "name": "AMOS", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 17, "kind": "action", "text": "He sits back down.", "para": 5, "sent": 0, "present": [0]}, {"u": 18, "kind": "action", "text": "Folds the letter into his hat.", "para": 5, "sent": 1, "present": [0]}, {"u": 19, "kind": "action", "text": "Far off, a faint metallic ring.", "para": 6, "sent": 0, "present": [0]}, {"u": 20, "kind": "action", "text": "A bell.", "para": 6, "sent": 1, "present": [0]}, {"u": 21, "kind": "action", "text": "Amos looks up.", "para": 7, "sent": 0, "present": [0]}, {"u": 22, "kind": "dialogue", "text": "Well, now.", "name": "AMOS", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0]}, {"u": 23, "kind": "action", "text": "He stands.", "para": 8, "sent": 0, "present": [0]}, {"u": 24, "kind": "action", "text": "Picks up his canteen.", "para": 8, "sent": 1, "present": [0]}, {"u": 25, "kind": "action", "text": "Shakes it.", "para": 8, "sent": 2, "present": [0]}, {"u": 26, "kind": "action", "text": "Empty.", "para": 8, "sent": 3, "present": [0]}, {"u": 27, "kind": "action", "text": "He walks toward the sound anyway.", "para": 8, "sent": 4, "present": [0]}]}