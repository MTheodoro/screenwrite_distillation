{"scene_id": "s02440", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02440.fountain", "heading": "INT. PHOTOGRAPHY STUDIO - DAY (1893)", "cast": [{"id": 0, "name": "CORNELIUS BRACKENRIDGE", "names": ["CORNELIUS BRACKENRIDGE", "CORNELIUS"], "gender": "m", "first": 4, "spoke": 5}, {"id": 1, "name": "PHILIPPA ASHWORTH", "names": ["PHILIPPA ASHWORTH", "PHILIPPA"], "gender": "?", "first": 5, "spoke": 2}, {"id": 2, "name": "FENWICK ASHWORTH", "names": ["FENWICK ASHWORTH", "FENWICK"], "gender": "?", "first": 5, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. PHOTOGRAPHY STUDIO - DAY (1893)", "present": []}, {"u": 1, "kind": "action", "text": "Skylight.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Brass camera on a tripod.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Velvet backdrop painted with a fake garden.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CORNELIUS BRACKENRIDGE (50s, photographer, black cloth over his head) fusses behind the lens.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "On a carved chair, PHILIPPA ASHWORTH (20s, high collar, rigid as a candlestick) holds a bouquet.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "Beside her stands FENWICK ASHWORTH (60s, her father, top hat, walking stick, mustache like a pair of wings).", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Perfectly still, Miss Ashworth. Ten seconds.", "name": "CORNELIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "I am always perfectly still.", "name": "PHILIPPA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Philippa, do not speak.", "name": "FENWICK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Quiet, please.", "name": "CORNELIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He removes the lens cap.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Counts under his breath.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "One.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Two.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Philippa's eye twitches.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Fenwick's grip on the cane tightens.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Five.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Six.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "A fly lands on Fenwick's nose.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "He sneers.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "The fly crawls.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Eight.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Nine.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Philippa's bouquet trembles.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "A petal drops.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Ten.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Cornelius caps the lens with a flourish.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Splendid.", "name": "CORNELIUS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Cornelius, there was a fly!", "name": "FENWICK", "speaker": 2, "ext": [], "paren": ["exploding"], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "I saw nothing.", "name": "CORNELIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "It was on my face!", "name": "FENWICK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Papa, you blinked. It will be a blur.", "name": "PHILIPPA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Cornelius sighs, lifts the plate holder, and slides in a fresh one.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Again, then. Perfectly still.", "name": "CORNELIUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}