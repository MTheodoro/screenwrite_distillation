{"scene_id": "s02443", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02443.fountain", "heading": "INT. NIGHT TRAIN - DINING CAR - SNOWSTORM", "cast": [{"id": 0, "name": "WOMAN", "names": ["WOMAN"], "gender": "f", "first": 6, "spoke": 5}, {"id": 1, "name": "CALLUM FAIRBROTHER", "names": ["CALLUM FAIRBROTHER", "CALLUM"], "gender": "m", "first": 8, "spoke": 17}, {"id": 2, "name": "GIORGOS ANAGNOSTOU", "names": ["GIORGOS ANAGNOSTOU", "GIORGOS"], "gender": "?", "first": 17, "spoke": 5}, {"id": 3, "name": "NADIA", "names": ["NADIA"], "gender": "f", "first": 29, "spoke": 12}, {"id": 4, "name": "ELDERLY COUPLE", "names": ["ELDERLY COUPLE"], "gender": "?", "first": 42, "spoke": 0}, {"id": 5, "name": "HEDDA LINDQVIST-ROSE", "names": ["HEDDA LINDQVIST-ROSE", "HEDDA"], "gender": "?", "first": 42, "spoke": 7}, {"id": 6, "name": "AMBROSE", "names": ["AMBROSE"], "gender": "?", "first": 42, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT TRAIN - DINING CAR - SNOWSTORM", "present": []}, {"u": 1, "kind": "action", "text": "White-clothed tables, brass lamps, windows frosted from outside.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The car sways.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A candle gutters in every glass.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "At the far end, a tarnished samovar steams.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Only a handful of passengers remain.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "A WOMAN (30s, trench coat, damp hair) sits alone at a two-top, a closed book in front of her.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "She hasn't turned a page in twenty minutes.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "CALLUM FAIRBROTHER (30s, rumpled suit, tie loosened) stands at the doorway, scanning for a seat.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "The car is nearly empty and every table is free.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He walks to hers anyway.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Is this taken?", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "There are fourteen empty tables.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "I can count.", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She almost smiles.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Gestures to the chair.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "He sits.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "GIORGOS ANAGNOSTOU (50s, waiter, white jacket, impeccable mustache) glides over with a menu.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Madam, sir. Tonight we have lamb or lamb.", "name": "GIORGOS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Lamb.", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "The same.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "A wise choice. Wine?", "name": "GIORGOS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Red.", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Whatever he's having.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Giorgos nods and withdraws.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Callum straightens his cutlery.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "She watches him do it.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "You're nervous.", "name": "WOMAN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "I'm on a train in a blizzard with a stranger.", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Nadia.", "name": "WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Pardon?", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "My name. Nadia Haddad. Now I'm not a stranger.", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Callum.", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "That's a Scottish name.", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "My mother was Scottish. My father was an accountant.", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "And you?", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Also an accountant.", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Ah. That explains the cutlery.", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "They both laugh.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "The train lurches.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Candles flicker.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "A glass slides and Callum catches it without looking, almost gracefully.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Behind them, an ELDERLY COUPLE enters: HEDDA LINDQVIST-ROSE (70s, pearls, cane) and AMBROSE (70s, bow tie, a flask) bickering softly in tandem.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "dialogue", "text": "Ambrose, you promised no more than one.", "name": "HEDDA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "dialogue", "text": "I promised no more than one at a time.", "name": "AMBROSE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "dialogue", "text": "That's not what a promise is.", "name": "HEDDA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 46, "kind": "dialogue", "text": "It's what a promise is when you've been married fifty years.", "name": "AMBROSE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 47, "kind": "action", "text": "They pass the table.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 48, "kind": "action", "text": "Hedda stops.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 49, "kind": "dialogue", "text": "My dears, you make a handsome pair.", "name": "HEDDA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 50, "kind": "dialogue", "text": "Oh, we're not--", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 51, "kind": "dialogue", "text": "We just met.", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 52, "kind": "dialogue", "text": "That's how it starts.", "name": "AMBROSE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 53, "kind": "dialogue", "text": "That's exactly how it starts.", "name": "HEDDA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 54, "kind": "action", "text": "They settle at the table behind them, still murmuring.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 55, "kind": "action", "text": "Nadia lowers her voice.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 56, "kind": "dialogue", "text": "They're adorable.", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 57, "kind": "dialogue", "text": "They're terrifying.", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 58, "kind": "action", "text": "Giorgos returns with wine.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 59, "kind": "action", "text": "Pours two glasses, then pauses over the third table.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 60, "kind": "dialogue", "text": "Sir, madam, may I recommend the plum tart? It is the only thing I make myself.", "name": "GIORGOS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 61, "kind": "dialogue", "text": "Two, please.", "name": "HEDDA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 62, "kind": "dialogue", "text": "Three. For the road.", "name": "AMBROSE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 63, "kind": "dialogue", "text": "We are on the train, sir.", "name": "GIORGOS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 64, "kind": "dialogue", "text": "Even so.", "name": "AMBROSE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 65, "kind": "action", "text": "Callum raises his glass to Nadia.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 66, "kind": "action", "text": "She lifts hers.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 67, "kind": "action", "text": "Their eyes catch, hold.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 68, "kind": "dialogue", "text": "To blizzards.", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 69, "kind": "dialogue", "text": "To stranded trains.", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 70, "kind": "dialogue", "text": "^To fifty years!", "name": "HEDDA", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 71, "kind": "dialogue", "text": "^To another fifty!", "name": "AMBROSE", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 72, "kind": "dialogue", "text": "To everyone.", "name": "NADIA", "speaker": 3, "ext": [], "paren": ["laughing"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 73, "kind": "action", "text": "Giorgos steps back.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 74, "kind": "action", "text": "The couple chatters.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 75, "kind": "action", "text": "The train rocks.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 76, "kind": "action", "text": "For a moment the whole car glows.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 77, "kind": "action", "text": "Then the lights flicker and die.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 78, "kind": "action", "text": "Darkness.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 79, "kind": "action", "text": "A scream of brakes.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 80, "kind": "action", "text": "The car lurches.", "para": 13, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 81, "kind": "action", "text": "Glass shatters.", "para": 13, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 82, "kind": "dialogue", "text": "Nadia?", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 83, "kind": "dialogue", "text": "I'm here.", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 84, "kind": "dialogue", "text": "Hold on to me.", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 85, "kind": "action", "text": "A hand finds a hand in the dark.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 86, "kind": "dialogue", "text": "Ambrose!", "name": "HEDDA", "speaker": 5, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 87, "kind": "dialogue", "text": "Right here, love.", "name": "AMBROSE", "speaker": 6, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 88, "kind": "dialogue", "text": "Please remain seated.", "name": "GIORGOS", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 89, "kind": "action", "text": "The train shudders to a stop.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 90, "kind": "action", "text": "Snow hisses against the windows.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 91, "kind": "action", "text": "Somewhere, a single match is struck, and a tiny flame blooms.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 92, "kind": "dialogue", "text": "Callum.", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 93, "kind": "dialogue", "text": "Yes?", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 94, "kind": "dialogue", "text": "I think I'd like to know your last name.", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 95, "kind": "dialogue", "text": "Fairbrother.", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 96, "kind": "dialogue", "text": "That is a terrible name.", "name": "NADIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 97, "kind": "dialogue", "text": "I'm told it's improving.", "name": "CALLUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}]}