{"scene_id": "s02444", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02444.fountain", "heading": "INT. SHIPBOARD OPERATING THEATRE - NIGHT", "cast": [{"id": 0, "name": "SAOIRSE KELLEHER-MBEKI", "names": ["SAOIRSE KELLEHER-MBEKI", "SAOIRSE"], "gender": "?", "first": 9, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. SHIPBOARD OPERATING THEATRE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A hospital ship in mid-ocean.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Steel walls, bolted tables, lamps swaying in their housings.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The deck rolls with a slow rhythm.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Water drips from an unseen pipe.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The theatre is empty.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "Instruments laid out in perfect rows.", "para": 1, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "A digital recorder rests on the scrub sink, its red light blinking.", "para": 1, "sent": 2, "present": []}, {"u": 8, "kind": "action", "text": "The door swings open.", "para": 2, "sent": 0, "present": []}, {"u": 9, "kind": "action", "text": "A woman steps through: DR. SAOIRSE KELLEHER-MBEKI (40s, blue scrubs soaked at the collar, surgical cap, eyes red from forty hours awake).", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "She carries a paper cup of tea and a patient file.", "para": 2, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "She sets the cup down.", "para": 3, "sent": 0, "present": [0]}, {"u": 12, "kind": "action", "text": "Looks at the empty table.", "para": 3, "sent": 1, "present": [0]}, {"u": 13, "kind": "dialogue", "text": "Nobody. Good.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 14, "kind": "action", "text": "She picks up the recorder.", "para": 4, "sent": 0, "present": [0]}, {"u": 15, "kind": "action", "text": "Presses play.", "para": 4, "sent": 1, "present": [0]}, {"u": 16, "kind": "action", "text": "Her own voice fills the room, taped hours earlier.", "para": 4, "sent": 2, "present": [0]}, {"u": 17, "kind": "dialogue", "text": "Patient Adebayo. Male, fifty-two. Perforated bowel. We began at nineteen hundred.", "name": "SAOIRSE", "speaker": 0, "ext": ["V.O."], "paren": ["recording"], "dual": false, "present": [0]}, {"u": 18, "kind": "action", "text": "Saoirse stops the recording.", "para": 5, "sent": 0, "present": [0]}, {"u": 19, "kind": "action", "text": "Rewinds.", "para": 5, "sent": 1, "present": [0]}, {"u": 20, "kind": "action", "text": "Plays again.", "para": 5, "sent": 2, "present": [0]}, {"u": 21, "kind": "dialogue", "text": "Complication at twenty-one-forty. Hemorrhage. We called it at twenty-two-ten.", "name": "SAOIRSE", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": ["recording"], "dual": false, "present": [0]}, {"u": 22, "kind": "action", "text": "She snaps it off.", "para": 6, "sent": 0, "present": [0]}, {"u": 23, "kind": "action", "text": "Her hand trembles.", "para": 6, "sent": 1, "present": [0]}, {"u": 24, "kind": "action", "text": "She sits on the edge of the table, hard.", "para": 6, "sent": 2, "present": [0]}, {"u": 25, "kind": "dialogue", "text": "Twenty-two-ten.", "name": "SAOIRSE", "speaker": 0, "ext": [], "paren": ["softly"], "dual": false, "present": [0]}, {"u": 26, "kind": "action", "text": "She lifts the tea and sips.", "para": 7, "sent": 0, "present": [0]}, {"u": 27, "kind": "action", "text": "Grimaces.", "para": 7, "sent": 1, "present": [0]}, {"u": 28, "kind": "action", "text": "It's cold.", "para": 7, "sent": 2, "present": [0]}, {"u": 29, "kind": "action", "text": "She sips again anyway.", "para": 7, "sent": 3, "present": [0]}, {"u": 30, "kind": "action", "text": "The ship pitches.", "para": 8, "sent": 0, "present": [0]}, {"u": 31, "kind": "action", "text": "The tea slides off the sink and spills across the floor.", "para": 8, "sent": 1, "present": [0]}, {"u": 32, "kind": "action", "text": "She does not move.", "para": 8, "sent": 2, "present": [0]}, {"u": 33, "kind": "dialogue", "text": "I did everything right.", "name": "SAOIRSE", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the empty room"], "dual": false, "present": [0]}, {"u": 34, "kind": "action", "text": "No answer.", "para": 9, "sent": 0, "present": [0]}, {"u": 35, "kind": "action", "text": "Water drips.", "para": 9, "sent": 1, "present": [0]}, {"u": 36, "kind": "action", "text": "She stands, crosses to the instrument tray, and lifts a scalpel.", "para": 10, "sent": 0, "present": [0]}, {"u": 37, "kind": "action", "text": "Turns it in the light.", "para": 10, "sent": 1, "present": [0]}, {"u": 38, "kind": "action", "text": "Sets it down.", "para": 10, "sent": 2, "present": [0]}, {"u": 39, "kind": "action", "text": "Picks up the recorder again.", "para": 10, "sent": 3, "present": [0]}, {"u": 40, "kind": "dialogue", "text": "Dictation. Adebayo, continued. Cause of death: acute hemorrhage secondary to--", "name": "SAOIRSE", "speaker": 0, "ext": ["CONT'D"], "paren": ["into recorder"], "dual": false, "present": [0]}, {"u": 41, "kind": "action", "text": "Her voice catches.", "para": 11, "sent": 0, "present": [0]}, {"u": 42, "kind": "action", "text": "She presses stop.", "para": 11, "sent": 1, "present": [0]}, {"u": 43, "kind": "action", "text": "Closes her eyes.", "para": 11, "sent": 2, "present": [0]}, {"u": 44, "kind": "action", "text": "She keeps speaking to the empty theatre.", "para": 12, "sent": 0, "present": [0]}, {"u": 45, "kind": "dialogue", "text": "I'm sorry. I'm so sorry.", "name": "SAOIRSE", "speaker": 0, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0]}, {"u": 46, "kind": "action", "text": "She pulls a grey ship's blanket from a shelf and drapes it over her shoulders.", "para": 13, "sent": 0, "present": [0]}, {"u": 47, "kind": "action", "text": "Presses the recorder to her chest.", "para": 13, "sent": 1, "present": [0]}, {"u": 48, "kind": "dialogue", "text": "Time of death, twenty-two-ten. Closing.", "name": "SAOIRSE", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": ["recording, from earlier"], "dual": false, "present": [0]}, {"u": 49, "kind": "action", "text": "She opens her eyes.", "para": 14, "sent": 0, "present": [0]}, {"u": 50, "kind": "action", "text": "Sets the recorder in its cradle, light still blinking, and sits in the dark alone.", "para": 14, "sent": 1, "present": [0]}]}