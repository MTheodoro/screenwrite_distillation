{"scene_id": "s02448", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02448.fountain", "heading": "INT. SHIPPING CONTAINER PICKLEBALL COURT - EVENING", "cast": [{"id": 0, "name": "ANNIKA STRAND", "names": ["ANNIKA STRAND", "ANNIKA"], "gender": "f", "first": 4, "spoke": 8}, {"id": 1, "name": "SOLEDAD VEGA", "names": ["SOLEDAD VEGA", "SOLEDAD"], "gender": "?", "first": 4, "spoke": 4}, {"id": 2, "name": "MARCUS BELL", "names": ["MARCUS BELL", "MARCUS"], "gender": "m", "first": 5, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. SHIPPING CONTAINER PICKLEBALL COURT - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "A forty-foot steel container, opened at both ends, its inside painted court-green.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Folding chairs line one wall.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A net sags between two rusted poles.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ANNIKA STRAND (30s, visor, knee brace) and SOLEDAD VEGA (30s, sweatband, quick feet) face each other across the net.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "MARCUS BELL (40s, referee, whistle, clipboard) sits on a stepladder at the sideline.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "First to eleven. Win by two.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Marcus, we know.", "name": "ANNIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Just saying it for the record.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Serve, Annika.", "name": "SOLEDAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Soledad, you serve.", "name": "ANNIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "It's your turn.", "name": "SOLEDAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "It was your turn.", "name": "ANNIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Neither of you serves until I say.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "They glare.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Marcus lifts his whistle.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Waits.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Blows.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Annika serves.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Soledad returns, low.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Annika scrambles.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "She lobs.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Soledad smashes.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Annika dives.", "para": 3, "sent": 5, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Misses.", "para": 3, "sent": 6, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Point, Soledad.", "name": "MARCUS", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "She stepped in the kitchen!", "name": "ANNIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "She did not.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Marcus, I saw her foot.", "name": "ANNIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Annika, I saw her foot too, and it was behind the line.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Soledad grins.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Annika hurls her paddle onto the steel floor.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "It clangs.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "That's a warning.", "name": "MARCUS", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "You're a warning.", "name": "ANNIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Be nice, Annika.", "name": "SOLEDAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "She's nice. I'm nice. You're not even here.", "name": "ANNIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Soledad bounces the ball.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Eight-two. Want to forfeit?", "name": "SOLEDAD", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Never.", "name": "ANNIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "She retrieves the paddle.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Plants her feet.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Her knuckles whiten.", "para": 6, "sent": 2, "present": [0, 1, 2]}]}