{"scene_id": "s02450", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02450.fountain", "heading": "INT. MOBILE DIALYSIS TRUCK - DAY", "cast": [{"id": 0, "name": "THANDIWE MOLOI", "names": ["THANDIWE MOLOI", "MOLOI"], "gender": "f", "first": 4, "spoke": 12}, {"id": 1, "name": "ELLSWORTH CRANE", "names": ["ELLSWORTH CRANE", "ELLSWORTH"], "gender": "m", "first": 5, "spoke": 15}, {"id": 2, "name": "NURSE KRZYSZTOF WIERZBICKI", "names": ["NURSE KRZYSZTOF WIERZBICKI", "KRZYSZTOF"], "gender": "m", "first": 6, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. MOBILE DIALYSIS TRUCK - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A converted delivery truck parked on a gravel lot beside a wheat field.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Inside: three recliners, humming machines, tubing coiled like pale vines.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Sunlight leaks through a sliver of window.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DR. THANDIWE MOLOI (40s, braids pinned up, lanyard heavy with keys) adjusts a monitor.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "ELLSWORTH CRANE (70s, farmer's cap, forearms like rope) sits in the nearest recliner, one arm hooked to a machine.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "NURSE KRZYSZTOF WIERZBICKI (30s, scrubs, a crossword folded in his pocket) calibrates a pump.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "You'd think a man could get his blood cleaned closer to home.", "name": "ELLSWORTH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "You'd think.", "name": "MOLOI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Forty miles each way, three days a week.", "name": "ELLSWORTH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "It's thirty-eight miles, Mr. Crane.", "name": "KRZYSZTOF", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Not from my end.", "name": "ELLSWORTH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "How's the pressure?", "name": "MOLOI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Same as always. Low and stubborn.", "name": "ELLSWORTH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Hundred-ten over seventy.", "name": "KRZYSZTOF", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Fine. Any dizziness?", "name": "MOLOI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Only from the cooking at the diner.", "name": "ELLSWORTH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Mr. Crane, you aren't supposed to be eating at the diner.", "name": "KRZYSZTOF", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Son, it's the only place that serves pie.", "name": "ELLSWORTH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Ellsworth.", "name": "MOLOI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "One slice.", "name": "ELLSWORTH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Last week it was three.", "name": "MOLOI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "It was a small week.", "name": "ELLSWORTH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Krzysztof laughs into his mask.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Moloi shakes her head, but she's smiling.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Okay. Run is two hours. If you need anything--", "name": "MOLOI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "I know. Press the button.", "name": "ELLSWORTH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Press the button.", "name": "MOLOI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "And don't die.", "name": "ELLSWORTH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "That one too.", "name": "MOLOI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "The machine hums.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Ellsworth closes his eyes.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Krzysztof returns to his crossword.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Then the machine chirps.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "A low, dull alarm.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Krzysztof and Moloi glance at the monitor at the same time.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "A red line climbs.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Air in the line.", "name": "KRZYSZTOF", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Clamp it.", "name": "MOLOI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Krzysztof lunges.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Moloi dives for the other end.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Their hands collide on the tubing, fingers tangling, both clamp at once.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "The alarm shrieks.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "What's wrong?", "name": "ELLSWORTH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Nothing. Stay still.", "name": "MOLOI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Doctor.", "name": "ELLSWORTH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Mr. Crane, I need you to breathe.", "name": "MOLOI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Krzysztof and Moloi lean over him, working in tandem.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Krzysztof flushes the line.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Moloi checks the needle.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Ellsworth's face is gray.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Silence.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "The alarm stops.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "The monitor steadies.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Ellsworth opens one eye.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "Was that me?", "name": "ELLSWORTH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "It was the line.", "name": "MOLOI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "Thank God.", "name": "ELLSWORTH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "Not funny, Mr. Crane.", "name": "KRZYSZTOF", "speaker": 2, "ext": [], "paren": ["shaky"], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "Wasn't joking.", "name": "ELLSWORTH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}