{"scene_id": "s02451", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02451.fountain", "heading": "INT. OFFICE BREAK ROOM - MORNING", "cast": [{"id": 0, "name": "FAMILY", "names": ["FAMILY"], "gender": "?", "first": 3, "spoke": 0}, {"id": 1, "name": "BRENDA SZABO", "names": ["BRENDA SZABO", "BRENDA"], "gender": "f", "first": 4, "spoke": 1}, {"id": 2, "name": "QUENTIN FAIRLEIGH", "names": ["QUENTIN FAIRLEIGH", "QUENTIN"], "gender": "m", "first": 5, "spoke": 2}, {"id": 3, "name": "RAVINDRA SHETTY", "names": ["RAVINDRA SHETTY", "RAVINDRA"], "gender": "?", "first": 6, "spoke": 1}, {"id": 4, "name": "TESS OKAFOR-LUND", "names": ["TESS OKAFOR-LUND", "TESS"], "gender": "?", "first": 7, "spoke": 2}, {"id": 5, "name": "ARCHIBALD STONE", "names": ["ARCHIBALD STONE", "ARCHIBALD"], "gender": "?", "first": 18, "spoke": 3}, {"id": 6, "name": "ALL", "names": ["ALL"], "gender": "?", "first": 21, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. OFFICE BREAK ROOM - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent hum.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A vending machine stuffed with a single bag of pretzels.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A laminated sign: \"WE ARE A FAMILY.\"", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "BRENDA SZABO (50s, lanyard, cardigan) stands at the coffee maker, stirring a cup that is already stirred.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "QUENTIN FAIRLEIGH (30s, ironed shirt) stares at his phone.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "RAVINDRA SHETTY (40s, headset, one earbud in) pours water on a dying plant.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "TESS OKAFOR-LUND (20s, intern, binder) hugs the wall.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "Nobody talks.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "The coffee maker gurgles.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Anyone get the memo?", "name": "QUENTIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Which one?", "name": "BRENDA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "The one about the other memo.", "name": "QUENTIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "I thought it was cancelled.", "name": "RAVINDRA", "speaker": 3, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "There's a memo?", "name": "TESS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Brenda and Quentin exchange a look.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Then they study the pretzels.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "The door opens.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "ARCHIBALD STONE (50s, tailored suit, a smile like a hospital bed) steps in.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Everyone stiffens.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Good morning, family.", "name": "ARCHIBALD", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Morning.", "name": "ALL", "speaker": 6, "ext": [], "paren": ["mumbled"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "action", "text": "Archibald crosses to the vending machine.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "Puts in a coin.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "The pretzels fall.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 25, "kind": "action", "text": "He opens the bag.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 26, "kind": "dialogue", "text": "Tess, I hear you've been rearranging the supply closet.", "name": "ARCHIBALD", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 27, "kind": "dialogue", "text": "I was told to--", "name": "TESS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 28, "kind": "dialogue", "text": "It's lovely. Truly. We should have a meeting about it.", "name": "ARCHIBALD", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "action", "text": "Brenda drops her spoon.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "action", "text": "It clatters.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "Quentin sets his phone face down.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "action", "text": "Ravindra waters the plant again.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "It drowns.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6]}]}