{"scene_id": "s02452", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02452.fountain", "heading": "INT. SUBMARINE MUSEUM - TORPEDO ROOM - WRESTLING MAT - NIGHT", "cast": [{"id": 0, "name": "HARBOR DISTRICT WRESTLING", "names": ["HARBOR DISTRICT WRESTLING"], "gender": "?", "first": 5, "spoke": 0}, {"id": 1, "name": "COACH BASIL MWANGI", "names": ["COACH BASIL MWANGI", "BASIL"], "gender": "?", "first": 6, "spoke": 16}, {"id": 2, "name": "DMITRI VOLKOV", "names": ["DMITRI VOLKOV", "DMITRI"], "gender": "m", "first": 8, "spoke": 11}, {"id": 3, "name": "HECTOR LE", "names": ["HECTOR LE", "HECTOR"], "gender": "?", "first": 9, "spoke": 7}, {"id": 4, "name": "N-ABARA", "names": ["N-ABARA"], "gender": "?", "first": 9, "spoke": 0}, {"id": 5, "name": "EDDIE PRAGER", "names": ["EDDIE PRAGER", "EDDIE"], "gender": "m", "first": 10, "spoke": 12}], "units": [{"u": 0, "kind": "heading", "text": "INT. SUBMARINE MUSEUM - TORPEDO ROOM - WRESTLING MAT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "The torpedo room of a decommissioned Cold War submarine, converted into a practice space.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rusted racks line the walls.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A blue wrestling mat covers the deck plates.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Pipes sweat overhead; a green emergency bulb throws everything into the color of pond water.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A faded banner: \"HARBOR DISTRICT WRESTLING - STATE TRIALS.\"", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "COACH BASIL MWANGI (50s, squat, bald, whistle on a bootlace) paces the edge of the mat.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He holds a stopwatch and a coffee thermos, and uses neither.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "DMITRI VOLKOV (17, heavy shoulders, scarred eyebrow) crouches on the mat, rolling his neck.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "HECTOR LE\u00d3N-ABARA (17, wiry, taped fingers) shakes out his arms in the opposite corner.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "EDDIE PRAGER (30s, local ref, striped shirt, reading glasses on a cord) squats between them to inspect their singlets.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 11, "kind": "dialogue", "text": "Last round of the night. Winner goes to State.", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Coach, we've wrestled forty times.", "name": "DMITRI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "This is the forty-first.", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "He always gets the underhook.", "name": "HECTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Then you break it.", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "He won't.", "name": "DMITRI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "I will.", "name": "HECTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Boys.", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Gentlemen. Hands.", "name": "EDDIE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "They touch hands.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Both are damp.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Wrestle.", "name": "EDDIE", "speaker": 5, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "They lock up.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Dmitri drives.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Hector sprawls.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "The mat squeaks.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Hips, Hector!", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Get off me.", "name": "DMITRI", "speaker": 2, "ext": [], "paren": ["grunting"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Get off me!", "name": "HECTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Both of you, break!", "name": "EDDIE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "They break.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Circle.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Dmitri shoots a double.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Hector hops back, drops his weight, and rides Dmitri to the mat.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "That's it!", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "Two points, Le\u00f3n-Abara.", "name": "EDDIE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "That was a stall!", "name": "DMITRI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "It was not.", "name": "EDDIE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "It was beautiful.", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Coach, whose side are you on?", "name": "DMITRI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Both. Neither. Wrestling.", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Dmitri spits on the mat.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Hector smirks.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Eddie raises a warning finger.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "One more of that, Volkov, and it's a penalty.", "name": "EDDIE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "He's baiting me.", "name": "DMITRI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "He's tired.", "name": "HECTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "They're both tired. Wrestle!", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "They lock up again.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "The green bulb flickers.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Dmitri snaps a headlock.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "Hector twists.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "For a moment they are one tangled shape.", "para": 8, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "Pin, pin, hold it--", "name": "EDDIE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "Get your shoulders up, Hector!", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "I'm trying!", "name": "HECTOR", "speaker": 3, "ext": [], "paren": ["through his teeth"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "Stay down!", "name": "DMITRI", "speaker": 2, "ext": [], "paren": ["through his teeth"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "The pipes overhead groan.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "A drop of condensation splashes onto Eddie's glasses.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "action", "text": "He wipes it, never taking his eyes from the mat.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "dialogue", "text": "One. Two.", "name": "EDDIE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "action", "text": "Hector bridges.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "His neck veins strain.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "Dmitri leans harder.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "dialogue", "text": "Coach says up, Hector, up!", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "dialogue", "text": "Coach says what?", "name": "HECTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "dialogue", "text": "UP!", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "action", "text": "Hector explodes.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "action", "text": "He throws a hip, rolls, and lands on top of Dmitri with a crash that shakes the deck plates.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "action", "text": "Dmitri's shoulders hit the mat.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "dialogue", "text": "One. Two. Three!", "name": "EDDIE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "action", "text": "He slaps the mat.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "action", "text": "Hector rolls away, chest heaving.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "action", "text": "Dmitri lies face up, staring at the pipes.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 75, "kind": "dialogue", "text": "Winner, Le\u00f3n-Abara.", "name": "EDDIE", "speaker": 5, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 76, "kind": "action", "text": "Silence.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 77, "kind": "action", "text": "Basil sets down the thermos.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 78, "kind": "action", "text": "Walks onto the mat and kneels beside Dmitri.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 79, "kind": "dialogue", "text": "You okay, Volkov?", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 80, "kind": "dialogue", "text": "Fine.", "name": "DMITRI", "speaker": 2, "ext": [], "paren": ["flat"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 81, "kind": "dialogue", "text": "You wrestled well.", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 82, "kind": "dialogue", "text": "I lost.", "name": "DMITRI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 83, "kind": "dialogue", "text": "Both of those things are true.", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 84, "kind": "action", "text": "Dmitri sits up.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 85, "kind": "action", "text": "Hector offers a hand.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 86, "kind": "action", "text": "Dmitri looks at it for a long beat.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 87, "kind": "action", "text": "Takes it.", "para": 14, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 88, "kind": "dialogue", "text": "Take it to State.", "name": "DMITRI", "speaker": 2, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 89, "kind": "dialogue", "text": "I will.", "name": "HECTOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 90, "kind": "dialogue", "text": "And break his underhook.", "name": "DMITRI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 91, "kind": "action", "text": "Hector grins.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 92, "kind": "action", "text": "Eddie checks his stopwatch and folds his glasses.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 93, "kind": "dialogue", "text": "I'm going home.", "name": "EDDIE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 94, "kind": "dialogue", "text": "Coffee, Eddie?", "name": "BASIL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 95, "kind": "dialogue", "text": "God, yes.", "name": "EDDIE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 96, "kind": "action", "text": "The green bulb buzzes.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 97, "kind": "action", "text": "Somewhere deep in the sub, a drip keeps time.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}