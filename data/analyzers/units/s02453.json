{"scene_id": "s02453", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02453.fountain", "heading": "INT. OCEAN LINER - WIRELESS ROOM - NIGHT (1912)", "cast": [{"id": 0, "name": "OTTOLINE FARRINGTON-ADE", "names": ["OTTOLINE FARRINGTON-ADE", "OTTOLINE"], "gender": "f", "first": 4, "spoke": 3}, {"id": 1, "name": "PERCIVAL SUTTON-KAGAN", "names": ["PERCIVAL SUTTON-KAGAN", "PERCIVAL"], "gender": "?", "first": 6, "spoke": 2}, {"id": 2, "name": "CAPTAIN WEXFORD", "names": ["CAPTAIN WEXFORD"], "gender": "?", "first": 7, "spoke": 2}, {"id": 3, "name": "CARPATHIA OPERATOR", "names": ["CARPATHIA OPERATOR"], "gender": "?", "first": 27, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. OCEAN LINER - WIRELESS ROOM - NIGHT (1912)", "present": []}, {"u": 1, "kind": "action", "text": "A cramped cabin lined with brass dials and copper coils.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A single lamp swings on a chain.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The sound of the sea is a low roar beyond the bulkhead.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "OTTOLINE FARRINGTON-ADE (20s, wireless operator, jacket too large, headphones clamped over her ears) taps a telegraph key.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She is thin, pale, her fingers raw from hours of work.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "PERCIVAL SUTTON-KAGAN (30s, junior officer, his collar loosened) sits beside her, a stack of messages on his knee.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "CAPTAIN WEXFORD (60s, white beard, frayed cap) stands in the doorway, filling it.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "She keys a final burst and listens.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Static.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "A long hiss.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Anything?", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Not yet.", "name": "OTTOLINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Keep sending.", "name": "CAPTAIN WEXFORD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "She nods and taps again.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "SOS.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "SOS.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "The key clicks.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Percival watches her hand.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "He glances at the captain.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "The captain says nothing.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "A new sound in the headphones.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "A thin, far voice.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Ottoline stiffens.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Someone's answering.", "name": "OTTOLINE", "speaker": 0, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "She presses the headset tighter.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Her eyes widen.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Titanic, this is Carpathia. We are coming. Hold on.", "name": "CARPATHIA OPERATOR", "speaker": 3, "ext": ["V.O."], "paren": ["over wireless, faint"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Percival gasps.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Captain Wexford closes his eyes.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Ottoline bursts into tears and laughs at the same time.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Four hours!", "name": "OTTOLINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Four hours!", "name": "PERCIVAL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Tell them to hurry.", "name": "CAPTAIN WEXFORD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Ottoline taps the reply.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Her fingers steady.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "When she finishes, she leans back and shuts her eyes.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "The lamp stops swinging.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "For the first time that night, the room is still.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}]}