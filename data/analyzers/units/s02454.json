{"scene_id": "s02454", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02454.fountain", "heading": "INT. FUNERAL HOME - BASEMENT KITCHEN - NIGHT", "cast": [{"id": 0, "name": "DOROTHEA PELLEGRINO", "names": ["DOROTHEA PELLEGRINO", "DOROTHEA"], "gender": "?", "first": 4, "spoke": 11}, {"id": 1, "name": "STANLEY PELLEGRINO", "names": ["STANLEY PELLEGRINO", "STANLEY"], "gender": "?", "first": 4, "spoke": 11}, {"id": 2, "name": "ROSALIND VANCOUVER-ADEYEMI", "names": ["ROSALIND VANCOUVER-ADEYEMI", "ROSALIND"], "gender": "f", "first": 7, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. FUNERAL HOME - BASEMENT KITCHEN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A low-ceilinged room with a stainless-steel prep table, an old gas range, and a long counter heaped with covered casserole dishes.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A hand-lettered sign over the sink reads \"PLEASE LABEL YOUR PAN.\"", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Upstairs, muffled footsteps and the low murmur of mourners.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "DOROTHEA PELLEGRINO (60s, black dress, cardigan, reading glasses on a chain) stands at the counter peeling foil from a lasagna.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Her hands are quick, efficient, furious.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "STANLEY PELLEGRINO (60s, her brother, stiff suit, thinning hair) sits at the prep table with a cup of untouched coffee.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "ROSALIND VANCOUVER-ADEYEMI (40s, their cousin, heels in one hand) pours wine into a plastic cup.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Stanley, bring me the serving spoons.", "name": "DOROTHEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Where are they?", "name": "STANLEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Where they have always been.", "name": "DOROTHEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "I haven't been down here in ten years.", "name": "STANLEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Then you won't know where they are. Rosalind, the spoons.", "name": "DOROTHEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Drawer by the sink.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": ["over her shoulder"], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Rosalind opens the drawer, fishes out three spoons, and hands them to Dorothea without looking.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Thank you.", "name": "DOROTHEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Of course.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Dorothea lays the spoons across the dishes.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Stanley rises, picks up the coffee, sets it down, picks up a casserole instead.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "That's heavy.", "name": "STANLEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "It is a lasagna.", "name": "DOROTHEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "It's heavy.", "name": "STANLEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Then put it down.", "name": "DOROTHEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "I'm trying to help.", "name": "STANLEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Dorothea turns.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Her jaw works.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "You could have helped with the hospital bills.", "name": "DOROTHEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Dot.", "name": "STANLEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "You could have helped when Mama was sick.", "name": "DOROTHEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "That's not fair.", "name": "STANLEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Here we go.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": ["to the wine"], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Stanley slams the casserole on the counter.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The foil crumples.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Rosalind steps between them, arms out, wine sloshing.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Everyone! Everyone, upstairs can hear you!", "name": "ROSALIND", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Both siblings freeze.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "A chair scrapes overhead.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Footsteps stop.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Mama would be mortified.", "name": "DOROTHEA", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "She'd be laughing.", "name": "STANLEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "She would not.", "name": "DOROTHEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "She would. She loved a good fight.", "name": "STANLEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Dorothea almost smiles.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "She hides it behind a cough.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Rosalind sets down her cup and takes both of their hands.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Listen to me. We are going to carry these dishes upstairs, and we are going to be kind to each other.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Rosalind.", "name": "STANLEY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "And afterward, you can scream at me in the parking lot.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "I will.", "name": "DOROTHEA", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "I might.", "name": "STANLEY", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Rosalind lets go.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "The three of them stare at one another, then at the counter full of lasagna and pie and ham.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Stanley lifts a tray.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Dorothea lifts another.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Rosalind hooks her shoes on two fingers and grabs the wine.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "They file up the stairs one behind the other, the dishes clinking.", "para": 10, "sent": 0, "present": [0, 1, 2]}]}