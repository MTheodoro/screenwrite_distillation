{"scene_id": "s02455", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02455.fountain", "heading": "INT. TRAIN STATION - LOST AND FOUND OFFICE - EVENING", "cast": [{"id": 0, "name": "HELENA MARCZAK", "names": ["HELENA MARCZAK", "HELENA"], "gender": "?", "first": 4, "spoke": 14}, {"id": 1, "name": "MAN", "names": ["MAN"], "gender": "?", "first": 6, "spoke": 8}, {"id": 2, "name": "TEODOR", "names": ["TEODOR"], "gender": "?", "first": 29, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. TRAIN STATION - LOST AND FOUND OFFICE - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "A narrow room of wire shelves heaped with umbrellas, scarves, odd gloves, a taxidermied owl in a glass bell jar.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A brass counter bell.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A flickering fluorescent strip.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "HELENA MARCZAK (50s, cardigan, lanyard) sits behind the counter with a ledger.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She writes slowly, ignoring the clock above her.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "A MAN enters.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Mid-forties, gray overcoat, wet hair.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He holds a ticket stub like a talisman and does not step past the mat.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Hello. I lost something.", "name": "MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Everyone has.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "A leather satchel. Brown. It has my initials.", "name": "MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Which are?", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "T.R.", "name": "MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "That's not much.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "It is to me.", "name": "MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Helena turns pages.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Her finger travels down a column.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She stops.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Brown satchel, T.R. Brought in Tuesday. Found on Platform Four.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Yes.", "name": "MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Under a bench.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "I was waiting for a train.", "name": "MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Which one?", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "The man hesitates.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I don't remember.", "name": "MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Helena sets down her pen, looks at him properly.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "His hands shake slightly.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Sir, what's your name?", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Teodor.", "name": "MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Teodor what?", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Rusu.", "name": "TEODOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Then it's yours, Mr. Rusu.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "She goes to the shelf, lifts the satchel, sets it on the counter between them.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Teodor stares at it but does not touch it.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "What's in it?", "name": "TEODOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "I don't open them.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Would you?", "name": "TEODOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "That's not my job.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Teodor unbuckles the strap.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "His hand freezes at the flap.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "He looks up.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "^I'm afraid.", "name": "TEODOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "^I know.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "They say it together, softly, and the fluorescent strip buzzes.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Teodor opens the flap.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Inside, a child's red mitten.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "He lifts it out.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Holds it against his chest.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "dialogue", "text": "Thank you.", "name": "TEODOR", "speaker": 2, "ext": ["CONT'D"], "paren": ["barely audible"], "dual": false, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Helena nods.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Writes nothing in the ledger.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Behind her the owl watches from its jar.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Do you keep things that no one comes for?", "name": "TEODOR", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "Seven years. Then we donate them.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "Seven years.", "name": "TEODOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "Mr. Rusu. You came.", "name": "HELENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "He nods, once.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Tucks the mitten into his coat.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Walks out into the rain.", "para": 11, "sent": 2, "present": [0, 1, 2]}]}