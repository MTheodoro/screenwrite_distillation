{"scene_id": "s02456", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02456.fountain", "heading": "INT. AMBULANCE - MOVING - NIGHT", "cast": [{"id": 0, "name": "CYRUS BEAUMONT-OKAFOR", "names": ["CYRUS BEAUMONT-OKAFOR", "CYRUS"], "gender": "m", "first": 6, "spoke": 9}, {"id": 1, "name": "WOMAN", "names": ["WOMAN"], "gender": "f", "first": 7, "spoke": 3}, {"id": 2, "name": "ODILE", "names": ["ODILE"], "gender": "?", "first": 30, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. AMBULANCE - MOVING - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A gridlocked highway.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Red tail lights stretch to the horizon.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The ambulance siren whoops, goes silent, whoops again.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "It is not moving.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "CYRUS BEAUMONT-OKAFOR (30s, paramedic, reflective vest, steady hands) kneels beside a stretcher.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "On it lies a WOMAN (60s, oxygen mask, silver hair plastered to her forehead, a rosary wound around one wrist).", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Ma'am, stay with me.", "name": "CYRUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "The woman's lips move behind the mask.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Say again?", "name": "CYRUS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Pain.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Where?", "name": "CYRUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Here.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She presses a shaking hand against her sternum.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Cyrus checks the monitor.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "The line jumps.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He tears open a packet.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Aspirin. Chew.", "name": "CYRUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She chews.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Winces.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "He adjusts the oxygen.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "A horn blares from the cab, long and helpless.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Cyrus slams his fist on the partition.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Anything?", "name": "CYRUS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Nothing.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Rain beats the roof.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "He turns back to the woman.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Her eyes are glassy.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "What's your name?", "name": "CYRUS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Odile.", "name": "WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Odile. I'm Cyrus. We'll get you there.", "name": "CYRUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "You're kind.", "name": "ODILE", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "I'm stuck.", "name": "CYRUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Both.", "name": "ODILE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "The monitor chirps.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Cyrus grabs the paddles, then lets them fall back.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Her rhythm steadies, ragged but present.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "He grips her hand.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "She grips his.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "The rosary beads dig into both their palms.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Odile, listen. If you can hear me, squeeze.", "name": "CYRUS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "She squeezes.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Outside, the red lights ahead begin to slide apart, and a lane opens.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "The ambulance lurches forward.", "para": 12, "sent": 0, "present": [0, 1, 2]}]}