{"scene_id": "s02457", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02457.fountain", "heading": "INT. FLORIST'S COLD ROOM - NIGHT", "cast": [{"id": 0, "name": "IMOGEN HARTLEY-SOLANKI", "names": ["IMOGEN HARTLEY-SOLANKI", "IMOGEN"], "gender": "?", "first": 4, "spoke": 9}, {"id": 1, "name": "DARIO FENWICK-ADEBAYO", "names": ["DARIO FENWICK-ADEBAYO", "DARIO"], "gender": "m", "first": 5, "spoke": 9}, {"id": 2, "name": "WINNIE ZHAO", "names": ["WINNIE ZHAO", "WINNIE"], "gender": "f", "first": 6, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. FLORIST'S COLD ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Steel shelves heavy with buckets of peonies, ranunculus, white lilacs.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The compressor hums.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Everything is breath and mist.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "IMOGEN HARTLEY-SOLANKI (30s, apron, secateurs) trims stems at a work table.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "DARIO FENWICK-ADEBAYO (30s, bike courier, helmet under his arm) hovers at the door.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "WINNIE ZHAO (60s, shop owner, quilted vest, thick glasses) counts invoices.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "I can come back.", "name": "DARIO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "It's fine.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "He's here for the roses.", "name": "WINNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Two dozen. For tonight.", "name": "DARIO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Red?", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "White.", "name": "DARIO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Imogen pauses, a stem in mid-air.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "White. Right.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Dario, that's a funeral color.", "name": "WINNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "It's what she likes.", "name": "DARIO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Who?", "name": "WINNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "A friend.", "name": "DARIO", "speaker": 1, "ext": [], "paren": ["quickly"], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Eighteen dollars a dozen.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Okay.", "name": "DARIO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "She wraps.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Her thumb catches a thorn.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "She doesn't flinch.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Imogen, you're bleeding.", "name": "WINNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "I'm fine.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Do you need a--", "name": "DARIO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "I'm fine.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Dario retrieves a tissue from his pocket and holds it out.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "She hesitates, then takes it.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Their fingers touch.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Hey, Imogen.", "name": "DARIO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Mm.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Never mind.", "name": "DARIO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "She finishes the bouquet.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Slides it across the table.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Neither of them reaches for it.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "The roses go in his hands, dear.", "name": "WINNIE", "speaker": 2, "ext": [], "paren": ["pointedly"], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Imogen lifts them.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Dario takes them.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "The mist swirls between them.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "He leaves.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "The door clicks.", "para": 6, "sent": 4, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "White roses.", "name": "WINNIE", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "I know.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "He's not buying them for a friend.", "name": "WINNIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "I know.", "name": "IMOGEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "She lifts the next stem.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "The scissors snap.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Winnie goes back to her invoices.", "para": 7, "sent": 2, "present": [0, 1, 2]}]}