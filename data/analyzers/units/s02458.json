{"scene_id": "s02458", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02458.fountain", "heading": "INT. COURTHOUSE - JURY DELIBERATION ROOM - DAY", "cast": [{"id": 0, "name": "GRETCHEN LANDOWSKI", "names": ["GRETCHEN LANDOWSKI", "GRETCHEN"], "gender": "?", "first": 3, "spoke": 4}, {"id": 1, "name": "JUROR 8", "names": ["JUROR", "JUROR 8"], "gender": "?", "first": 3, "spoke": 4}, {"id": 2, "name": "MOHAN IYER", "names": ["MOHAN IYER", "MOHAN"], "gender": "?", "first": 4, "spoke": 2}, {"id": 3, "name": "BETTINA OYELOWO", "names": ["BETTINA OYELOWO", "BETTINA"], "gender": "?", "first": 5, "spoke": 2}, {"id": 4, "name": "WALT BRZEZINSKI", "names": ["WALT BRZEZINSKI", "WALT"], "gender": "?", "first": 6, "spoke": 2}, {"id": 5, "name": "ISAAC", "names": ["ISAAC"], "gender": "?", "first": 20, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. COURTHOUSE - JURY DELIBERATION ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A bare table, twelve chairs, a ticking radiator.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Five jurors remain at the table; the others are on break.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "GRETCHEN LANDOWSKI (JUROR 3) (50s, perm, sharp elbows) taps her pen.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "MOHAN IYER (JUROR 5) (40s, tie loosened, calculator) stares at the table.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 5, "kind": "action", "text": "BETTINA OYELOWO (JUROR 11) (60s, church hat) folds her hands.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "action", "text": "WALT BRZEZINSKI (JUROR 12) (70s, hearing aid, windbreaker) peels an orange.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 7, "kind": "action", "text": "JUROR 8 (30s, rolled sleeves, tired eyes) stands by the window.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "It's open and shut.", "name": "GRETCHEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Is it?", "name": "JUROR 8", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Ten to two. We've been here for six hours.", "name": "GRETCHEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "I'm not asking you to change your mind. I'm asking you to hear mine.", "name": "JUROR 8", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "We've heard it.", "name": "MOHAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Have you?", "name": "JUROR 8", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Let him speak, Mohan.", "name": "BETTINA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "What did he say?", "name": "WALT", "speaker": 4, "ext": [], "paren": ["too loudly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "He wants to speak!", "name": "BETTINA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Then let him!", "name": "WALT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Juror 8 turns from the window.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "He looks at each face.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "My name is Isaac. I know we've avoided names. But a man's life is on that table, and I don't want to decide it with numbers.", "name": "JUROR 8", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Fine. Isaac. Say your piece.", "name": "GRETCHEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "The witness couldn't have seen the face at that distance. I stood at the same window yesterday.", "name": "ISAAC", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "You went to the scene?", "name": "MOHAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "I went home. I stood at my own window.", "name": "ISAAC", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "That's not evidence.", "name": "GRETCHEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Neither is a guess.", "name": "ISAAC", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "The radiator knocks.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Walt offers Bettina half his orange.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "She takes it.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}]}