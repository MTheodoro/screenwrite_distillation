{"scene_id": "s02459", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02459.fountain", "heading": "INT. CORPORATE ESCAPE ROOM - AFTERNOON", "cast": [{"id": 0, "name": "LONNIE KASPRZAK", "names": ["LONNIE KASPRZAK", "LONNIE"], "gender": "?", "first": 5, "spoke": 9}, {"id": 1, "name": "DEEPA MURTHY-LANGE", "names": ["DEEPA MURTHY-LANGE", "DEEPA"], "gender": "f", "first": 6, "spoke": 6}, {"id": 2, "name": "WILHELM TSAI", "names": ["WILHELM TSAI", "WILHELM"], "gender": "?", "first": 7, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. CORPORATE ESCAPE ROOM - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "A fake Egyptian tomb: plywood hieroglyphs, a papier-mache sarcophagus, a countdown clock glowing red.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "12:00.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "11:59.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The team stands in a huddle.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "LONNIE KASPRZAK (40s, VP of Synergy, polo shirt, lanyard) holds a golden key.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "DEEPA MURTHY-LANGE (30s, project manager, clipboard) studies a wall of glyphs.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "WILHELM TSAI (20s, junior analyst, vest, eager) pokes the sarcophagus.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Okay team, I have a feeling about this key.", "name": "LONNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "It's a prop, Lonnie.", "name": "DEEPA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "It could be the key to the sarcophagus!", "name": "WILHELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "It could be the key to success.", "name": "LONNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "It could be the key to nothing.", "name": "DEEPA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "I think I found a latch!", "name": "WILHELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Wilhelm, don't touch the mummy.", "name": "LONNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Lonnie, he is not a mummy, he's a Styrofoam sarcophagus.", "name": "DEEPA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "It's a very good sarcophagus.", "name": "WILHELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "The clock ticks.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "10:42.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Deepa, translate the glyphs.", "name": "LONNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "They say, \"This is not real.\"", "name": "DEEPA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Interesting.", "name": "LONNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Maybe it's a riddle!", "name": "WILHELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Everything is a riddle, Wilhelm.", "name": "LONNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Deepa rips the clipboard off its hook.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Lonnie shoves the key into the sarcophagus lock.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "It turns with a satisfying click.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "The lid hisses open.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Inside: a rubber snake and a plastic trophy.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "We did it.", "name": "LONNIE", "speaker": 0, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "We finished a team-building exercise.", "name": "DEEPA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "We won?", "name": "WILHELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "We won!", "name": "LONNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "They scream.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "High-five.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Hug.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Deepa exhales, a real laugh breaking through her professional mask.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "A buzzer sounds.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "The red clock flashes.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "00:00.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "It's over.", "name": "DEEPA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Was it ever really about winning?", "name": "LONNIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Yes.", "name": "WILHELM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}