{"scene_id": "s02460", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02460.fountain", "heading": "INT. DRAGON'S TAX OFFICE - DAY", "cast": [{"id": 0, "name": "GORLAN THRUM", "names": ["GORLAN THRUM", "GORLAN"], "gender": "?", "first": 4, "spoke": 8}, {"id": 1, "name": "PHINEAS ABERNATHY-OLU", "names": ["PHINEAS ABERNATHY-OLU", "PHINEAS"], "gender": "m", "first": 5, "spoke": 7}, {"id": 2, "name": "VESUVIA", "names": ["VESUVIA"], "gender": "?", "first": 16, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. DRAGON'S TAX OFFICE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A cave lined with ledgers.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Gold coins in neat stacks.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A huge brass desk, a quill taller than a man.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "GORLAN THRUM (40s, goblin accountant, ink-stained, eyeshade) sits on a towering stool.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "PHINEAS ABERNATHY-OLU (30s, human farmer, hat in hands) stands before him, shaking.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Your tithe is eleven sheep.", "name": "GORLAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Eleven, Master Gorlan?", "name": "PHINEAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Eleven.", "name": "GORLAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I have nine.", "name": "PHINEAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "You have nine and a ewe in lamb.", "name": "GORLAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "She isn't due until spring.", "name": "PHINEAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Lambs count.", "name": "GORLAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "A rumble shakes the cave.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Dust sifts from the ceiling.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "A voice booms from somewhere beyond the ledgers.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Gorlan, is the farmer negotiating?", "name": "VESUVIA", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "No, Your Radiance.", "name": "GORLAN", "speaker": 0, "ext": [], "paren": ["calling back"], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "I would never.", "name": "PHINEAS", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Good. I dislike negotiation.", "name": "VESUVIA", "speaker": 2, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Phineas, the dragon is generous but not patient. Choose.", "name": "GORLAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "What are my choices?", "name": "PHINEAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Eleven sheep, or an apple pie every Sunday for ten years.", "name": "GORLAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Pie?", "name": "PHINEAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Her Radiance has a sweet tooth.", "name": "GORLAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Then I choose the pie.", "name": "PHINEAS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Excellent.", "name": "VESUVIA", "speaker": 2, "ext": ["O.S."], "paren": ["delighted"], "dual": false, "present": [0, 1, 2]}]}