{"scene_id": "s02462", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02462.fountain", "heading": "INT. LIGHTHOUSE - LAMP ROOM - DAWN", "cast": [{"id": 0, "name": "OTTILIE BRANDVOLD", "names": ["OTTILIE BRANDVOLD", "OTTILIE"], "gender": "?", "first": 4, "spoke": 7}, {"id": 1, "name": "HENRIETTA ASHDOWN-RAO", "names": ["HENRIETTA ASHDOWN-RAO", "HENRIETTA"], "gender": "f", "first": 5, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. LIGHTHOUSE - LAMP ROOM - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A circular room of glass and brass.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The great lens turns with a slow, hypnotic creak.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Gulls cry outside.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "OTTILIE BRANDVOLD (60s, keeper, oilskin, spyglass) stands at the rail.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across the room, HENRIETTA ASHDOWN-RAO (30s, inspector, crisp coat, leather satchel) opens her notebook.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Miss Brandvold, the log says the lamp went dark at three.", "name": "HENRIETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "It did.", "name": "OTTILIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "For eleven minutes.", "name": "HENRIETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "For eleven minutes.", "name": "OTTILIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "And you were here?", "name": "HENRIETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I was asleep.", "name": "OTTILIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Henrietta lowers the notebook.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "A keeper is not permitted to sleep.", "name": "HENRIETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "A keeper is not permitted to many things.", "name": "OTTILIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "The lens turns.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "A shaft of pale light sweeps across both women's faces.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "A ship went aground in those eleven minutes.", "name": "HENRIETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "I know.", "name": "OTTILIE", "speaker": 0, "ext": [], "paren": ["flat"], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Forty lives.", "name": "HENRIETTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Ottilie turns from the rail.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Her hands are steady.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Her face is not.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Forty-one. I counted the cabin boy twice.", "name": "OTTILIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She sinks onto a stool.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Henrietta waits, pen frozen.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Write it down. All of it.", "name": "OTTILIE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Henrietta nods.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "She writes.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Her hand shakes.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "The lens creaks.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "The light sweeps on.", "para": 6, "sent": 4, "present": [0, 1]}]}