{"scene_id": "s02464", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02464.fountain", "heading": "EXT. SKI GONDOLA - MIDWAY - DUSK", "cast": [{"id": 0, "name": "RAVENNA OKONKWO-DALE", "names": ["RAVENNA OKONKWO-DALE", "RAVENNA"], "gender": "?", "first": 6, "spoke": 8}, {"id": 1, "name": "LORENZO BIANCHI-RAO", "names": ["LORENZO BIANCHI-RAO", "LORENZO"], "gender": "m", "first": 7, "spoke": 5}, {"id": 2, "name": "KWAME ASANTE", "names": ["KWAME ASANTE", "KWAME"], "gender": "m", "first": 8, "spoke": 4}, {"id": 3, "name": "LOTTE HOLMGREN", "names": ["LOTTE HOLMGREN", "LOTTE"], "gender": "f", "first": 9, "spoke": 5}, {"id": 4, "name": "PEARL WAKEFIELD", "names": ["PEARL WAKEFIELD", "PEARL"], "gender": "f", "first": 10, "spoke": 5}, {"id": 5, "name": "CONTROL", "names": ["CONTROL"], "gender": "?", "first": 17, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SKI GONDOLA - MIDWAY - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "A six-seat gondola cabin dangling in the blue hour, stalled between two pylons over a canyon of pines.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wind taps the glass.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Snow dusts the roof.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The cable above is dead still.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Inside, five people sit in silence, knees almost touching.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "RAVENNA OKONKWO-DALE (40s, ski patrol jacket, radio on her chest) watches the pylon.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "LORENZO BIANCHI-RAO (60s, fur-trimmed parka, fake smile) clutches a thermos.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "KWAME ASANTE (20s, snowboarder, beanie, headphones) stares at his boots.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "LOTTE HOLMGREN (30s, ski instructor, red jacket) cradles her phone.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "And in the corner, curled around a school backpack, PEARL WAKEFIELD (10, pink helmet, wide eyes) hugs her knees.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Nobody speaks.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "The cabin sways once, then holds.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Everybody stay seated.", "name": "RAVENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "We are seated.", "name": "LORENZO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "I'm saying it so it's said.", "name": "RAVENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "The radio on her chest crackles.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "CONTROL (V.O.) comes through, flat and distant.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Gondola Seven, this is Base. We have a generator fault. Estimated restart forty minutes.", "name": "CONTROL", "speaker": 5, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "Copy, Base. We have five on board, one minor.", "name": "RAVENNA", "speaker": 0, "ext": [], "paren": ["into radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Copy. Keep them calm.", "name": "CONTROL", "speaker": 5, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Ravenna lowers the radio.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Looks around.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Everyone has heard.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Forty minutes.", "name": "LOTTE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Forty minutes is nothing.", "name": "KWAME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "It is cold.", "name": "LORENZO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Pearl lifts her head.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Can I have my mom?", "name": "PEARL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Lotte reaches across.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Pearl shrinks back, then lets her take one hand.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Hey. I'm Lotte. I teach kids how to ski.", "name": "LOTTE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "I'm not good.", "name": "PEARL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Nobody's good at first.", "name": "LOTTE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "Lorenzo unscrews the thermos.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Pours a little into the cap.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Offers it to Pearl.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Ravenna intercepts.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "Cocoa?", "name": "RAVENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Brandy.", "name": "LORENZO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "No.", "name": "RAVENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "It is only a little.", "name": "LORENZO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "She's ten.", "name": "RAVENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "He sighs and drinks it himself.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Kwame watches the pylon; the wind picks up and the cabin rocks.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Everyone grabs a bar, a seat, a knee.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Pearl yelps.", "para": 9, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "The rocking eases.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "A hush falls.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "Kwame lowers his head and begins to hum, low, tuneless.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "One by one, they listen.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "That's nice. Keep going.", "name": "LOTTE", "speaker": 3, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "Lorenzo shifts.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "His fur collar rustles.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "He leans forward and, for the first time, speaks without the smile.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "I am afraid of heights.", "name": "LORENZO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "Nobody answers.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "Ravenna lays a hand on his knee.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "Kwame removes one earbud and offers it to Pearl without looking.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "Pearl hesitates, then puts it in.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "action", "text": "Her eyes widen.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "dialogue", "text": "It's loud.", "name": "PEARL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "dialogue", "text": "Yeah.", "name": "KWAME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "dialogue", "text": "I like it.", "name": "PEARL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "Something clanks overhead.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "All five look up.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "action", "text": "A wire hums.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "action", "text": "The gondola shudders, then drops six inches and catches.", "para": 14, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "action", "text": "Pearl screams.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "action", "text": "Lotte grabs her.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "action", "text": "Lorenzo grips the bar.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "action", "text": "Kwame's humming rises.", "para": 15, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "dialogue", "text": "Base! Base, we just dropped!", "name": "RAVENNA", "speaker": 0, "ext": [], "paren": ["into radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "dialogue", "text": "Gondola Seven, say again?", "name": "CONTROL", "speaker": 5, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "dialogue", "text": "We dropped six inches!", "name": "RAVENNA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 75, "kind": "dialogue", "text": "Copy. Stand by.", "name": "CONTROL", "speaker": 5, "ext": ["V.O."], "paren": ["over radio"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 76, "kind": "action", "text": "The cabin trembles.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 77, "kind": "action", "text": "Nobody breathes.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 78, "kind": "action", "text": "The cable twitches.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 79, "kind": "action", "text": "A creak runs down it like a bowstring.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 80, "kind": "action", "text": "The gondola lurches forward, one foot, two, then stops again.", "para": 17, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 81, "kind": "dialogue", "text": "We're moving.", "name": "KWAME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 82, "kind": "dialogue", "text": "We're moving!", "name": "LOTTE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 83, "kind": "action", "text": "Kwame's humming swells.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 84, "kind": "action", "text": "Lorenzo closes his eyes.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 85, "kind": "action", "text": "Pearl takes out the earbud and hands it back, solemn.", "para": 18, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 86, "kind": "dialogue", "text": "Thanks.", "name": "PEARL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 87, "kind": "dialogue", "text": "Anytime.", "name": "KWAME", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 88, "kind": "action", "text": "The gondola glides, smooth and certain, down toward the lights of the valley.", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 89, "kind": "action", "text": "Ravenna lowers the radio.", "para": 20, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 90, "kind": "action", "text": "Closes her eyes.", "para": 20, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 91, "kind": "action", "text": "Exhales for the first time in forty minutes.", "para": 20, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}