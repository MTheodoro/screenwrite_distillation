{"scene_id": "s02466", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02466.fountain", "heading": "EXT. TIDE POOLS - DAWN", "cast": [{"id": 0, "name": "NOOR HADDAD-PETERS", "names": ["NOOR HADDAD-PETERS", "NOOR"], "gender": "f", "first": 5, "spoke": 10}, {"id": 1, "name": "FIONA ESCOBAR-LINDQVIST", "names": ["FIONA ESCOBAR-LINDQVIST", "FIONA"], "gender": "?", "first": 9, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "EXT. TIDE POOLS - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A rocky shelf slick with kelp, exposed at the edge of a retreating sea.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Mist clings to the water.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Gulls wheel overhead.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Pools lie scattered like dropped mirrors, each holding a patch of pink sky.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "NOOR HADDAD-PETERS, sixteen, kneels at the lip of the nearest pool in a yellow raincoat too big for her.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She is small, serious, hair braided tightly against the wind.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "A notebook is wrapped in a freezer bag at her knee.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "She watches the water as if it might speak.", "para": 1, "sent": 3, "present": [0]}, {"u": 9, "kind": "action", "text": "FIONA ESCOBAR-LINDQVIST, sixteen, stands a few feet back, arms folded.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She wears a grey hoodie and borrowed rubber boots.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Her eyes keep drifting from the pool to the horizon and back to Noor.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She shifts her weight.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "A pebble clicks under her heel.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Noor does not look up.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She is the one who brought Fiona here.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She is the one who won't say why.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "You said there was something to see.", "name": "FIONA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Wait.", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "It's freezing.", "name": "FIONA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "She said wait.", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Who's \"she\"?", "name": "FIONA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Noor does not answer.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She is still looking at the water.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "A ripple moves under the surface, slow, purposeful.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "She holds her breath.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Then, quite deliberately, she reaches out and slides a finger into the pool.", "para": 5, "sent": 4, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "An anemone opens around it, soft pink petals curling, and closes again, gentle as a handshake.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "There.", "name": "NOOR", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Fiona edges closer.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "She crouches.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "She stares, unblinking, at the little flower of tentacles.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "It's alive.", "name": "FIONA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "It's alive.", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "It's... holding on.", "name": "FIONA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "She does that when she's afraid.", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Or when she's happy.", "name": "FIONA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Maybe both.", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "She looks up at last.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "The two girls stare at each other across the water.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "The mist breaks.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "A shaft of sunlight lances across the pool and turns it gold.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "You brought me here to show me this.", "name": "FIONA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Yes.", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Why?", "name": "FIONA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Because you said nothing ever stays.", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Fiona's mouth tightens.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "She wipes her eyes with the back of her sleeve, angry at herself.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "That's not fair.", "name": "FIONA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "It isn't.", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "You used a sea creature to make a point.", "name": "FIONA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "It worked.", "name": "NOOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "Fiona laughs.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "A wet, startled sound.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "She sits back on the rock, boots splashing, and the anemone opens again in the widening ripples.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "She wipes her nose and does not look at Noor.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "She does not need to.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "The tide begins to turn.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "Water laps at the shelf's far edge, patient and inevitable.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "The two of them sit on, sharing the cold, and the light climbs.", "para": 12, "sent": 2, "present": [0, 1]}]}