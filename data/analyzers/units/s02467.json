{"scene_id": "s02467", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02467.fountain", "heading": "INT. RURAL PHARMACY - COUNTER - DAY", "cast": [{"id": 0, "name": "WINIFRED OYELARAN-SCOTT", "names": ["WINIFRED OYELARAN-SCOTT", "WINIFRED"], "gender": "f", "first": 3, "spoke": 12}, {"id": 1, "name": "ELMER HOLLOWAY", "names": ["ELMER HOLLOWAY", "ELMER"], "gender": "m", "first": 4, "spoke": 7}, {"id": 2, "name": "GABRIEL FONTANA-ABARA", "names": ["GABRIEL FONTANA-ABARA", "GABRIEL"], "gender": "m", "first": 5, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. RURAL PHARMACY - COUNTER - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A tiny drugstore: wooden floorboards, a spinning card rack, an electric fan.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Behind the counter, shelves of amber bottles and a handwritten \"No Credit\" sign.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "WINIFRED OYELARAN-SCOTT (50s, white coat, reading glasses on her head) counts pills onto a tray.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "ELMER HOLLOWAY (70s, overalls, seed cap) leans on the counter with both elbows.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "GABRIEL FONTANA-ABARA (30s, delivery driver, clipboard) waits behind him, shifting his weight.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Elmer, you're on the wrong dosage.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Gabriel says it's right.", "name": "ELMER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "I said it was what the doctor wrote.", "name": "GABRIEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Doctors write all sorts of things.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Winifred, I've taken these for twenty years.", "name": "ELMER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "And the dosage changed in March.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "It changed in February.", "name": "GABRIEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "It changed in March, Gabriel. I have the paper.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Then show me the paper.", "name": "ELMER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "It's in the back.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "I'll fetch it.", "name": "GABRIEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "You'll do no such thing.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "It's my job to deliver.", "name": "GABRIEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Your job is to hand me the bottle.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Gabriel sets a bottle on the counter.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Winifred picks it up, squints, reads the label, and sets it down again.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "This is the wrong strength.", "name": "WINIFRED", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "See?", "name": "ELMER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "It came from the warehouse.", "name": "GABRIEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "It came from your truck.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "She's got you, son.", "name": "ELMER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Elmer, whose side are you on?", "name": "GABRIEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "My own.", "name": "ELMER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Winifred sighs, pulls a fresh bottle off the shelf, and labels it in a small, steady hand.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "One tablet. Morning. With food.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "I eat food.", "name": "ELMER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Eat more of it.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "She slides the bottle across.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Elmer takes it, tips his cap, and shuffles to the door.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Winifred, I'm sorry.", "name": "GABRIEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Don't be. Just check twice.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Yes, ma'am.", "name": "GABRIEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "The fan hums.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "The cards in the rack tick, one against another.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Nothing else moves.", "para": 5, "sent": 2, "present": [0, 1, 2]}]}