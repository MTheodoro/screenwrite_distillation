{"scene_id": "s02468", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02468.fountain", "heading": "INT. COUNTY FAIR - PIE-EATING CONTEST - JUDGES' TENT - DAY", "cast": [{"id": 0, "name": "MC BIFF DONNELLY", "names": ["MC BIFF DONNELLY", "BIFF"], "gender": "?", "first": 3, "spoke": 4}, {"id": 1, "name": "GLORIA TREJO-LINDQVIST", "names": ["GLORIA TREJO-LINDQVIST", "GLORIA"], "gender": "?", "first": 4, "spoke": 6}, {"id": 2, "name": "HIROSHI TANAKA", "names": ["HIROSHI TANAKA", "HIROSHI"], "gender": "?", "first": 5, "spoke": 4}, {"id": 3, "name": "DELIA OKONJO-BRANT", "names": ["DELIA OKONJO-BRANT", "DELIA"], "gender": "f", "first": 6, "spoke": 4}, {"id": 4, "name": "WINSTON PERCY", "names": ["WINSTON PERCY", "WINSTON"], "gender": "m", "first": 7, "spoke": 5}, {"id": 5, "name": "WOMAN IN VISOR", "names": ["WOMAN", "WOMAN IN VISOR"], "gender": "?", "first": 8, "spoke": 1}, {"id": 6, "name": "VISOR", "names": ["VISOR"], "gender": "?", "first": 8, "spoke": 0}, {"id": 7, "name": "ROXANNE", "names": ["ROXANNE"], "gender": "?", "first": 21, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. COUNTY FAIR - PIE-EATING CONTEST - JUDGES' TENT - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Red-and-white striped canvas, folding tables, a banner: \"47TH ANNUAL BLUEBERRY BLOWOUT.\"", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Flies circle a bowl of whipped cream.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "MC BIFF DONNELLY (50s, straw hat, microphone) stands on a crate.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "GLORIA TREJO-LINDQVIST (60s, judge's sash, clipboard) sits at the center table.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "HIROSHI TANAKA (40s, judge, bib already stained) holds a spoon.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "DELIA OKONJO-BRANT (30s, junior judge, notebook) fans herself.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "WINSTON PERCY (70s, former champion, tweed blazer) leans on a cane.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "A WOMAN IN A VISOR (40s, sunburnt, sunglasses) lurks near the pies.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 9, "kind": "dialogue", "text": "Ladies and gentlemen, we are down to the final three contestants!", "name": "BIFF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 10, "kind": "dialogue", "text": "We are down to two. One was disqualified for swallowing the tin.", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 11, "kind": "dialogue", "text": "It's still dramatic!", "name": "BIFF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 12, "kind": "dialogue", "text": "This crust is excellent.", "name": "HIROSHI", "speaker": 2, "ext": [], "paren": ["chewing"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 13, "kind": "dialogue", "text": "Hiroshi, you're not supposed to eat the evidence.", "name": "DELIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 14, "kind": "dialogue", "text": "It's a pie. It's meant to be eaten.", "name": "HIROSHI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 15, "kind": "dialogue", "text": "In my day, you'd be thrown out for tasting.", "name": "WINSTON", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 16, "kind": "dialogue", "text": "In your day, Winston, you ate the judges.", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 17, "kind": "dialogue", "text": "Only once!", "name": "WINSTON", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "action", "text": "The woman in the visor steps forward, whispering something to Gloria.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "action", "text": "Gloria frowns.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "Who are you?", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "dialogue", "text": "Roxanne. Roxanne Pike. I'm entry number 14.", "name": "WOMAN IN VISOR", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 22, "kind": "dialogue", "text": "Number 14 was disqualified.", "name": "DELIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 23, "kind": "dialogue", "text": "That's why I'm here to protest.", "name": "ROXANNE", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 24, "kind": "dialogue", "text": "Folks, we have a protest!", "name": "BIFF", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 25, "kind": "dialogue", "text": "Delia, hold my spoon.", "name": "HIROSHI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 26, "kind": "dialogue", "text": "I'm holding my own.", "name": "DELIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 27, "kind": "dialogue", "text": "Back in my day--", "name": "WINSTON", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 28, "kind": "dialogue", "text": "Winston.", "name": "GLORIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 29, "kind": "dialogue", "text": "Yes, dear.", "name": "WINSTON", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 30, "kind": "action", "text": "Roxanne slams a pie tin onto the table.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 31, "kind": "action", "text": "Blueberry sprays across Gloria's clipboard.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "action", "text": "Delia shrieks.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "action", "text": "Hiroshi dives.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "action", "text": "Biff leaps off the crate.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "action", "text": "Winston swings his cane and cracks the whipped cream bowl in two.", "para": 3, "sent": 5, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "dialogue", "text": "Order! Order at the fair!", "name": "GLORIA", "speaker": 1, "ext": [], "paren": ["shouting"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "dialogue", "text": "This pie was perfect!", "name": "ROXANNE", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "dialogue", "text": "It was!", "name": "HIROSHI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "dialogue", "text": "It really was!", "name": "DELIA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "dialogue", "text": "It was a masterpiece!", "name": "WINSTON", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 41, "kind": "dialogue", "text": "Fine. Reinstated.", "name": "GLORIA", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 42, "kind": "action", "text": "Roxanne straightens.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 43, "kind": "action", "text": "Wipes blueberry from her visor.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 44, "kind": "action", "text": "Smiles for the first time.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 45, "kind": "dialogue", "text": "Folks, we have a winner!", "name": "BIFF", "speaker": 0, "ext": [], "paren": ["into mic"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}]}