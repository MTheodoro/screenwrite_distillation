{"scene_id": "s02470", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02470.fountain", "heading": "INT. CABLE-CAR SUMMIT STATION - CONTROL ROOM - NIGHT", "cast": [{"id": 0, "name": "INGRID VOSS", "names": ["INGRID VOSS", "INGRID"], "gender": "?", "first": 4, "spoke": 13}, {"id": 1, "name": "KOFI OSEI", "names": ["KOFI OSEI", "KOFI"], "gender": "?", "first": 6, "spoke": 9}, {"id": 2, "name": "HALVORSEN", "names": ["HALVORSEN"], "gender": "?", "first": 23, "spoke": 5}, {"id": 3, "name": "BASHIR NAZARI", "names": ["BASHIR NAZARI", "BASHIR"], "gender": "?", "first": 52, "spoke": 6}, {"id": 4, "name": "LENKA DROZD", "names": ["LENKA DROZD", "LENKA"], "gender": "?", "first": 62, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. CABLE-CAR SUMMIT STATION - CONTROL ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Wind hums in the cables.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Frost on the glass.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A space heater ticks.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "INGRID VOSS, 50s, station operator, grey braid, both hands around a steel thermos.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She watches a bank of monitors.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "KOFI OSEI, 20s, apprentice mechanic, grease on his cuffs, sits on a crate eating crackers.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Quiet.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Too quiet.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Last car's late.", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Snow on the line.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "You said that an hour ago.", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "It was snowing an hour ago.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He laughs.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She doesn't.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "On the monitor: a single gondola, CAR 7, crawling up through the dark.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "One passenger?", "name": "KOFI", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "One ticket. Cash.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Kofi crunches a cracker.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Brushes crumbs off his knee.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Who rides up at midnight?", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Someone who wants the view.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "The radio on the desk CRACKLES.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Base to summit. Ingrid, you there?", "name": "HALVORSEN", "speaker": 2, "ext": ["V.O."], "paren": ["over radio, thin"], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Ingrid thumbs the key.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Go ahead, Halvorsen.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Quick check. You got Car 7 on your board?", "name": "HALVORSEN", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Coming up now.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Silence on the line.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Static.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Too long.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Ingrid. Car 7 is in the depot.", "name": "HALVORSEN", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Kofi stops chewing.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Say again.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Seven's parked. Locked out since six. I'm looking at it.", "name": "HALVORSEN", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Ingrid's eyes go to the monitor.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "The car climbs.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Closer.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Then what is that?", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Kill the lights.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "What?", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Kill them.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "He slaps the wall switch.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Dark.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Only the monitors glow.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Bolt of cold air.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "The stairwell door at the back, open an inch.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "It was shut.", "para": 13, "sent": 2, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Kofi sees it.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Freezes.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Somebody's already up here.", "name": "KOFI", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "A gloved hand pushes the door wide.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "BASHIR NAZARI, 30s, ski jacket, no skis, steps in.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Calm hands.", "para": 16, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Wet boots.", "para": 16, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "A ticket stub between two fingers.", "para": 16, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Evening.", "name": "BASHIR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "You came up the service stairs.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "Eleven hundred steps. I like the exercise.", "name": "BASHIR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "Then who's in the car?", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "Ah.", "name": "BASHIR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "He checks his watch.", "para": 17, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "That'll be Lenka.", "name": "BASHIR", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "The glass behind them shudders.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "Car 7 slams into the dock.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "Doors hiss open.", "para": 18, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "LENKA DROZD, 40s, shaved head, black coveralls, a coil of cable ties over one shoulder, steps out of the empty-looking cabin.", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "action", "text": "Unhurried.", "para": 19, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "dialogue", "text": "Sorry. Traffic.", "name": "LENKA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "Ingrid backs against the desk.", "para": 20, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "action", "text": "Her hand finds the radio.", "para": 20, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "dialogue", "text": "Halvorsen. Don't send anyone.", "name": "INGRID", "speaker": 0, "ext": [], "paren": ["low, to the radio"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "dialogue", "text": "Already sent. Two minutes.", "name": "HALVORSEN", "speaker": 2, "ext": ["V.O."], "paren": ["tight"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "dialogue", "text": "No. It's four. Your cable's cold.", "name": "LENKA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "action", "text": "She smiles at Kofi.", "para": 21, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "dialogue", "text": "Crackers. Good. Long night.", "name": "LENKA", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 76, "kind": "action", "text": "Bashir locks the stairwell door.", "para": 22, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 77, "kind": "action", "text": "Click.", "para": 22, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 78, "kind": "action", "text": "Ingrid lifts the thermos.", "para": 23, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 79, "kind": "action", "text": "Sets it down.", "para": 23, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 80, "kind": "action", "text": "Slowly.", "para": 23, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 81, "kind": "dialogue", "text": "What do you want?", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 82, "kind": "dialogue", "text": "The ledger.", "name": "BASHIR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 83, "kind": "dialogue", "text": "There is no ledger.", "name": "INGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 84, "kind": "dialogue", "text": "Ingrid. Your husband said you'd say that.", "name": "BASHIR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 85, "kind": "action", "text": "Her face doesn't move.", "para": 24, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 86, "kind": "action", "text": "Kofi looks at her.", "para": 24, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 87, "kind": "dialogue", "text": "Husband?", "name": "KOFI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 88, "kind": "action", "text": "Wind drops.", "para": 25, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 89, "kind": "action", "text": "The heater ticks.", "para": 25, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 90, "kind": "action", "text": "The cable above them goes still.", "para": 25, "sent": 2, "present": [0, 1, 2, 3, 4]}]}