{"scene_id": "s02471", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02471.fountain", "heading": "INT. MUNICIPAL LOST PROPERTY OFFICE - DAY", "cast": [{"id": 0, "name": "DOREEN PALMQUIST", "names": ["DOREEN PALMQUIST", "DOREEN"], "gender": "f", "first": 5, "spoke": 15}, {"id": 1, "name": "PAULO MENDES-RIBEIRO", "names": ["PAULO MENDES-RIBEIRO", "PAULO"], "gender": "m", "first": 7, "spoke": 12}, {"id": 2, "name": "GRANT HOLLIS", "names": ["GRANT HOLLIS", "GRANT"], "gender": "?", "first": 39, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. MUNICIPAL LOST PROPERTY OFFICE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A long basement room under a bus depot.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Steel shelves labelled by month.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Hundreds of umbrellas hang from the pipes like sleeping bats.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single fluorescent tube flickers over the counter.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "DOREEN PALMQUIST, 60s, cardigan buttoned to the neck, reading glasses on a chain, sorts a tray of single gloves.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Everything on her desk is squared to the edge.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "PAULO MENDES-RIBEIRO, 30s, damp raincoat, a worn leather folder under his arm, stands at the counter.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He has been standing there for some time.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Form 12-B.", "name": "DOREEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I filled in a 12-B.", "name": "PAULO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "You filled in a 12-A.", "name": "DOREEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "They look the same.", "name": "PAULO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "They are not the same.", "name": "DOREEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She hands him a form.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "He takes it.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Uses the pen on the chain, which is short, so he has to lean over the counter to write.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Colour of umbrella?", "name": "PAULO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "You tell me.", "name": "DOREEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Black.", "name": "PAULO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Doreen turns slowly toward the shelves.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Hundreds of black umbrellas.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Describe it.", "name": "DOREEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "It's an umbrella.", "name": "PAULO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She sets down the glove.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Aligns it with the others.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Handle?", "name": "DOREEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Wooden. Duck head.", "name": "PAULO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "A duck.", "name": "DOREEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "It was my father's.", "name": "PAULO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Doreen's pen stops.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Starts again.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Duck-handled. Black. Bus route?", "name": "DOREEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Forty-one.", "name": "PAULO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Day?", "name": "DOREEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Tuesday. Or Wednesday.", "name": "PAULO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Doreen removes her glasses.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Lets them hang.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Breathes through her nose.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "GRANT HOLLIS, 20s, a high-vis vest over a suit, wheels in a cart of fresh umbrellas, humming.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "He drops the cart handle.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "It clangs.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Got a batch off the forty-one.", "name": "GRANT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Paulo and Doreen both look at the cart.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "A black umbrella, duck handle, on top.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "That's it.", "name": "PAULO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "That is a batch item. It is not yet logged.", "name": "DOREEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "It's my father's.", "name": "PAULO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "It is not yet logged.", "name": "DOREEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Paulo reaches.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Doreen's hand lands flat on the umbrella first.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Quick for sixty.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "I could just log it?", "name": "GRANT", "speaker": 2, "ext": [], "paren": ["to the floor"], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "You could not.", "name": "DOREEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "Give me the umbrella.", "name": "PAULO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "dialogue", "text": "Form 12-B.", "name": "DOREEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Paulo tears the form in half.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Then in half again.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Lets the pieces fall onto the counter.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Doreen watches them land.", "para": 11, "sent": 3, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "She picks up a stamp.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "Brings it down on the first piece, hard.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "Then the second.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 63, "kind": "action", "text": "Then the third.", "para": 12, "sent": 3, "present": [0, 1, 2]}, {"u": 64, "kind": "action", "text": "Thud.", "para": 12, "sent": 4, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "Thud.", "para": 12, "sent": 5, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "Thud.", "para": 12, "sent": 6, "present": [0, 1, 2]}, {"u": 67, "kind": "dialogue", "text": "I'll come back.", "name": "GRANT", "speaker": 2, "ext": [], "paren": ["backing the cart toward the door"], "dual": false, "present": [0, 1, 2]}, {"u": 68, "kind": "dialogue", "text": "Stay where you are, Mr. Hollis.", "name": "DOREEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "She lifts the umbrella by the duck's neck and holds it out across the counter, level, like a sword being surrendered.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 70, "kind": "dialogue", "text": "Sign for it.", "name": "DOREEN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 71, "kind": "action", "text": "Paulo takes it.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 72, "kind": "action", "text": "His hand shakes.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 73, "kind": "action", "text": "He signs the stamped paper with the chain pen, bent double over the counter, and the pen's bead chain snaps.", "para": 14, "sent": 2, "present": [0, 1, 2]}, {"u": 74, "kind": "action", "text": "Everyone looks at the pen.", "para": 15, "sent": 0, "present": [0, 1, 2]}]}