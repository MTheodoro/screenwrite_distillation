{"scene_id": "s02473", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02473.fountain", "heading": "EXT. SALT FLAT - DAY", "cast": [{"id": 0, "name": "MAREN LUND", "names": ["MAREN LUND", "MAREN"], "gender": "f", "first": 4, "spoke": 6}, {"id": 1, "name": "DELPHINE ACHTERBERG", "names": ["DELPHINE ACHTERBERG", "DELPHINE"], "gender": "f", "first": 5, "spoke": 5}, {"id": 2, "name": "OKAFOR", "names": ["OKAFOR"], "gender": "m", "first": 8, "spoke": 5}, {"id": 3, "name": "RANGER", "names": ["RANGER"], "gender": "?", "first": 33, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. SALT FLAT - DAY", "present": []}, {"u": 1, "kind": "action", "text": "White to every horizon.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A dead pickup sits hood-up, its shadow short.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Heat shimmers.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MAREN LUND, 30s, sunburnt, wraps a rag around her wrist.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "DELPHINE ACHTERBERG, 40s, sits in the shade of the open tailgate, boots off, counting water bottles.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "She lines them up.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Four.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "OKAFOR, 50s, studies the engine, wrench in hand.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "He doesn't speak much.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Maren drops the rag.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "She walks to Delphine and she crouches.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "She nudges the bottles with a finger.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She reaches for one and she is stopped by Delphine's hand.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Four.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Four's fine.", "name": "MAREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Four is two days. Three if she stops complaining.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Who?", "name": "MAREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Pick one.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Okafor wipes his hands on his trousers.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Closes the hood.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "It thuds.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Fuel line's cracked.", "name": "OKAFOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Fixable?", "name": "MAREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "With tape. Not with salt in it.", "name": "OKAFOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Maren stands.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Delphine tilts her head.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "They share a look.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Maren turns to the horizon.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "She shades her eyes.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "A glint far out, then nothing.", "para": 5, "sent": 5, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The radio inside the cab crackles.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Okafor leans in through the window and keys it.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Station Two-Four. Anyone on this channel.", "name": "RANGER", "speaker": 3, "ext": ["V.O."], "paren": ["garbled"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Two-Four, this is the Isuzu on the east track. We're stuck.", "name": "OKAFOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Copy east track. Say position.", "name": "RANGER", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Forty kilometres past the marker. White ground. No landmark.", "name": "OKAFOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Copy. We'll send a truck at first light. Hold your position.", "name": "RANGER", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "First light's fourteen hours.", "name": "MAREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Then we hold.", "name": "OKAFOR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "He releases the key.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Static.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Maren sits down in the sand beside the tailgate.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Delphine hands her a bottle.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Maren pushes it back.", "para": 7, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "You first.", "name": "MAREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "I'm fine.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "You're not.", "name": "MAREN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "She's not either.", "name": "DELPHINE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Maren glances at Okafor.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "He's already looking at the sky.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "He pulls the tape from the glove box.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "He kneels at the front wheel and begins to wind it around the line.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Slow, careful.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Neither of the women speaks.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Wind shifts the salt in a long ribbon across the ground.", "para": 9, "sent": 3, "present": [0, 1, 2, 3]}]}