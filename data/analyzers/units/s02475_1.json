{"scene_id": "s02475_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02475.fountain", "heading": "INT. HOSPITAL ELEVATOR - CONTINUOUS", "cast": [{"id": 0, "name": "NASRIN", "names": ["NASRIN"], "gender": "?", "first": 5, "spoke": 3}, {"id": 1, "name": "DESMOND", "names": ["DESMOND"], "gender": "m", "first": 5, "spoke": 2}, {"id": 2, "name": "BEA", "names": ["BEA"], "gender": "f", "first": 7, "spoke": 3}, {"id": 3, "name": "TOMMASO", "names": ["TOMMASO"], "gender": "?", "first": 3, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOSPITAL ELEVATOR - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Doors close.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The gurney fills the car.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Tommaso holds a bag valve mask.", "para": 0, "sent": 2, "present": [3]}, {"u": 4, "kind": "action", "text": "The elevator hums downward.", "para": 0, "sent": 3, "present": [3]}, {"u": 5, "kind": "dialogue", "text": "Desmond, I'm Dr. Farouq. You're in a hospital. We're taking you straight to trauma.", "name": "NASRIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 6, "kind": "dialogue", "text": "My son's six. He'll think I left him.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 7, "kind": "dialogue", "text": "Then we'll find him, Desmond. I'll call the site foreman myself.", "name": "BEA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Doc, pressure's dropping.", "name": "TOMMASO", "speaker": 3, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Bea, two units O-neg, wide open. Tommaso, stay on his airway.", "name": "NASRIN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "The elevator dings.", "para": 1, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Doors open onto the bright, loud corridor of the emergency department.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Stay with me, Desmond. Talk to Bea about your son.", "name": "NASRIN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Bea walks fast beside the bed.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "What's his name?", "name": "BEA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Kwabena. Kwabena likes dinosaurs.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Then Kwabena is going to meet the biggest dinosaur in this building. You hold on.", "name": "BEA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "They roll out of frame.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}]}