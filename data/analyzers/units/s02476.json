{"scene_id": "s02476", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02476.fountain", "heading": "INT. S.S. MARGUERITE - PURSER'S OFFICE - NIGHT - 1912", "cast": [{"id": 0, "name": "PURSER HOLLOWAY", "names": ["PURSER HOLLOWAY", "HOLLOWAY"], "gender": "m", "first": 4, "spoke": 3}, {"id": 1, "name": "STOWAWAY", "names": ["STOWAWAY"], "gender": "?", "first": 4, "spoke": 2}, {"id": 2, "name": "DECKHAND", "names": ["DECKHAND"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "CAPTAIN VANE", "names": ["CAPTAIN VANE", "VANE"], "gender": "m", "first": 8, "spoke": 6}, {"id": 4, "name": "CLEMENTINE", "names": ["CLEMENTINE"], "gender": "?", "first": 15, "spoke": 2}, {"id": 5, "name": "PIP", "names": ["PIP"], "gender": "?", "first": 6, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. S.S. MARGUERITE - PURSER'S OFFICE - NIGHT - 1912", "present": []}, {"u": 1, "kind": "action", "text": "Brass lamp.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rolling floor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A stack of passenger manifests slides with every swell.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "PURSER HOLLOWAY, 50s, neat as a pin, drags a STOWAWAY by the collar into the office.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "The Stowaway is small, soot-faced, in a boy's cap and oversized coat.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Pip, a young DECKHAND, hovers by the door.", "para": 1, "sent": 2, "present": [0, 1, 2, 5]}, {"u": 7, "kind": "dialogue", "text": "Another one, Captain, in the coal bunker!", "name": "HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 5]}, {"u": 8, "kind": "action", "text": "CAPTAIN VANE, 60s, white beard, brass buttons, looks up from his chart without hurry.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 5]}, {"u": 9, "kind": "dialogue", "text": "A boy?", "name": "VANE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5]}, {"u": 10, "kind": "dialogue", "text": "I am no boy.", "name": "STOWAWAY", "speaker": 1, "ext": [], "paren": ["a woman's voice, defiant"], "dual": false, "present": [0, 1, 2, 3, 5]}, {"u": 11, "kind": "action", "text": "The cap falls.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 5]}, {"u": 12, "kind": "action", "text": "Dark curls spill out.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 5]}, {"u": 13, "kind": "action", "text": "Holloway lets go as if burned.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 5]}, {"u": 14, "kind": "dialogue", "text": "Name?", "name": "VANE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5]}, {"u": 15, "kind": "dialogue", "text": "Clementine Ashworth. And you will take me to New York.", "name": "STOWAWAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "She'll be put off at Queenstown!", "name": "HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Mr. Holloway, we left Queenstown yesterday.", "name": "VANE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "There! You see?", "name": "CLEMENTINE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "action", "text": "Pip snickers.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "action", "text": "Holloway glares at him.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "Miss Ashworth, what is in New York?", "name": "VANE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "My father. He thinks I'm dead.", "name": "CLEMENTINE", "speaker": 4, "ext": [], "paren": ["softer"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "The lamp swings.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Everyone watches the shadows swing with it.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "Pip. Fetch Miss Ashworth some tea and a blanket.", "name": "VANE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Aye, sir!", "name": "PIP", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "He's gone.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Holloway sputters.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "Captain, regulations!", "name": "HOLLOWAY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Regulations don't swim, Mr. Holloway. And neither, I suspect, do you.", "name": "VANE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "He turns the chart.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Holloway slumps into his chair.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "Clementine laughs, and the ship rolls on.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}