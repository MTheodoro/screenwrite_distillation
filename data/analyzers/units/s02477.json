{"scene_id": "s02477", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02477.fountain", "heading": "INT. COUNTY JAIL - ATTORNEY VISITING ROOM - DAY", "cast": [{"id": 0, "name": "ROSALIND KESSLER", "names": ["ROSALIND KESSLER", "ROSALIND"], "gender": "?", "first": 4, "spoke": 8}, {"id": 1, "name": "CALLUM BRAY", "names": ["CALLUM BRAY", "CALLUM"], "gender": "m", "first": 6, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. COUNTY JAIL - ATTORNEY VISITING ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A cinderblock booth.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Scratched glass.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A black phone handset on a steel cord.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ROSALIND KESSLER, 40s, grey suit, legal pad, sits very straight.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She lifts the handset.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "On the other side of the glass, CALLUM BRAY, 30s, orange jumpsuit, rubs his thumb over an old tattoo and lifts his own handset.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "You came.", "name": "CALLUM", "speaker": 1, "ext": ["V.O."], "paren": ["through the phone"], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "It's Thursday.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "You brought the pad.", "name": "CALLUM", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I always bring the pad.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She uncaps a pen.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Doesn't write.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "The state has the security footage.", "name": "ROSALIND", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Of what?", "name": "CALLUM", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Of the loading dock. Eleven fourteen. You told me you were home.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Callum looks at his thumb.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "His jaw shifts.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "I was home at eleven.", "name": "CALLUM", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "At eleven fourteen, you're on the dock.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Camera clocks drift.", "name": "CALLUM", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "This one doesn't. It's synced to the satellite.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Callum sets the handset down on the shelf.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Picks it up again.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Sits back.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Rosalind's pen taps once on the pad.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Callum. I put your mother's name on the witness list.", "name": "ROSALIND", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "His eyes close.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "Take it off.", "name": "CALLUM", "speaker": 1, "ext": ["V.O."], "paren": ["very quiet"], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Then tell me what happened on the dock.", "name": "ROSALIND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "He slams the handset against the glass.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "The sound is enormous.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Rosalind doesn't flinch.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "She waits.", "para": 7, "sent": 3, "present": [0, 1]}]}