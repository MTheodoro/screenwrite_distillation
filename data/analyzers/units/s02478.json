}, {"u": 10, "kind": "action", "text": "TANVEER KHATRI, 50s, the curator, lies sprawled below the projector, a brass key in his fist.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Everyone freezes.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "BEATA LOWENSTEIN, 30s, the donor, and COSIMO FERRANTE, 60s, the rival, point at each other.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "He did it!", "name": "BEATA / COSIMO", "speaker": 2, "ext": [], "paren": ["together"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "I never touched him!", "name": "BEATA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "I was across the room!", "name": "COSIMO", "speaker": 3, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "WREN, 20s, the usher, bolts for the exit.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "action", "text": "DOYLE, 40s, the security guard, tackles her.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 18, "kind": "action", "text": "Both crash into a row of recliners.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 19, "kind": "action", "text": "The seats fold.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 20, "kind": "dialogue", "text": "Enough!", "name": "ILSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 21, "kind": "action", "text": "Tanveer sits up, groaning, rubbing his skull.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 22, "kind": "dialogue", "text": "Who turned off my sky?", "name": "TANVEER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 23, "kind": "action", "text": "Everyone breathes out.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 24, "kind": "action", "text": "Ilse pockets her badge, almost smiling.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}]}