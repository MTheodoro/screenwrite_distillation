{"scene_id": "s02479", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02479.fountain", "heading": "INT. BOWLING ALLEY - AFTER HOURS", "cast": [{"id": 0, "name": "SAL", "names": ["SAL"], "gender": "?", "first": 4, "spoke": 3}, {"id": 1, "name": "DUKE", "names": ["DUKE"], "gender": "?", "first": 5, "spoke": 2}, {"id": 2, "name": "MOSES", "names": ["MOSES"], "gender": "m", "first": 6, "spoke": 4}, {"id": 3, "name": "BARNEY", "names": ["BARNEY"], "gender": "?", "first": 7, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. BOWLING ALLEY - AFTER HOURS", "present": []}, {"u": 1, "kind": "action", "text": "Half the lanes dark.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Shoes stacked on the counter.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A jukebox hums, unplugged.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SAL, 60, silver hair, sits at lane six, polishing a bowling ball.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "DUKE, 40s, big, lingers by the pin-return.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "MOSES, 30s, nervous, holds a gym bag against his stomach.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "BARNEY, 50s, the owner, wipes a glass behind the bar.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Quiet.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Almost cozy.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "You made good time.", "name": "SAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Traffic was nothing.", "name": "MOSES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "t