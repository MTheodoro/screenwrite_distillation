 3]}, {"u": 27, "kind": "action", "text": "Sal sets the ball in its rack.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "He stands.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Duke steps behind Moses.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Moses drops the bag.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}]}