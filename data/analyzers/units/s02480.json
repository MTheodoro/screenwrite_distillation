{"scene_id": "s02480", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02480.fountain", "heading": "INT. ICE ARENA - ZAMBONI BAY - NIGHT", "cast": [{"id": 0, "name": "LUCIANA FERRARI-OYELE", "names": ["LUCIANA FERRARI-OYELE", "LUCIANA"], "gender": "?", "first": 5, "spoke": 7}, {"id": 1, "name": "DEACON BRUNO", "names": ["DEACON BRUNO", "DEACON"], "gender": "?", "first": 7, "spoke": 7}, {"id": 2, "name": "BARTOSZ", "names": ["BARTOSZ"], "gender": "?", "first": 22, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. ICE ARENA - ZAMBONI BAY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Concrete.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fluorescent hum.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A resurfacer idles, steam rising off its blade.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Puddles on the floor.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "LUCIANA FERRARI-OYELE, 20s, goalie, pads strapped on, sits on an upturned bucket.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Helmet on her knee.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "DEACON BRUNO, 60s, driver, climbs down from the machine with a coffee.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Slow knees.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "You're late, Deacon.", "name": "LUCIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "You're early, Lu.", "name": "DEACON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "He sits on a second bucket.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Offers the coffee.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She shakes her head.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Compressor thrum.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Three hundred shots.", "name": "LUCIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "That a goal?", "name": "DEACON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "That's tonight. Before they flood the ice.", "name": "LUCIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "You'll wear a hole in the crease.", "name": "DEACON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Good.", "name": "LUCIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "A wall speaker CRACKLES.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Deacon, you in the bay?", "name": "BARTOSZ", "speaker": 2, "ext": ["V.O."], "paren": ["over PA, tinny"], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Where else.", "name": "DEACON", "speaker": 1, "ext": [], "paren": ["not moving"], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Hold the flood. Coach wants Luciana out there another hour.", "name": "BARTOSZ", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Deacon looks at Luciana.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "She looks at the floor.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "She's already here, Bart.", "name": "DEACON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Then she's early. Tell her thanks.", "name": "BARTOSZ", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Click.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Silence.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "He doesn't know I'm out of the lineup.", "name": "LUCIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Tell him.", "name": "DEACON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Tomorrow.", "name": "LUCIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Tomorrow, Lu, I'll be flooding ice you're not on.", "name": "DEACON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "She pulls her helmet down.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Stands.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Bangs her stick twice on the concrete.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Open the door, Deacon.", "name": "LUCIANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "He climbs back on the machine.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Lifts the gate.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Cold light pours across the ice.", "para": 9, "sent": 2, "present": [0, 1, 2]}]}