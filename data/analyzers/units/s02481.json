{"scene_id": "s02481", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02481.fountain", "heading": "INT. SMOKEHOUSE KITCHEN - ICELANDIC FISHING VILLAGE - NIGHT", "cast": [{"id": 0, "name": "HELGA SIGURDARDOTTIR", "names": ["HELGA SIGURDARDOTTIR", "HELGA"], "gender": "f", "first": 4, "spoke": 17}, {"id": 1, "name": "BJARNI", "names": ["BJARNI"], "gender": "?", "first": 6, "spoke": 14}, {"id": 2, "name": "ASGEIR THORVALDSSON", "names": ["ASGEIR THORVALDSSON", "ASGEIR"], "gender": "f", "first": 51, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. SMOKEHOUSE KITCHEN - ICELANDIC FISHING VILLAGE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Tin walls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Hooks of cod hang in blue smoke.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A woodstove ticks.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "HELGA SIGURDARDOTTIR, 40s, rubber apron, forearms scarred from knives, slices a split haddock.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Fast, precise.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "BJARNI, 16, headphones around his neck, stands in the doorway with a duffel bag.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He has been standing there a while.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Helga doesn't look up.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Shut the door. You're letting out the smoke.", "name": "HELGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He steps in.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Closes it.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Doesn't put down the bag.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "I got into the school.", "name": "BJARNI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "In Reykjavik.", "name": "HELGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "You knew?", "name": "BJARNI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "The letter was on the table.", "name": "HELGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "You read my letter.", "name": "BJARNI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "It was on the table.", "name": "HELGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "She wipes the knife.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Lays it down, parallel to the board.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "When's the bus?", "name": "HELGA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Six.", "name": "BJARNI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "In the morning?", "name": "HELGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Tonight.", "name": "BJARNI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "She turns.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Looks at the duffel.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Looks at him.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "You were going to leave without telling me.", "name": "HELGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "I'm telling you.", "name": "BJARNI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "After you packed.", "name": "HELGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "He shrugs.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "She picks up a fish and slaps it on the board.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Cuts.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Cuts again.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "He winces at each blow.", "para": 7, "sent": 4, "present": [0, 1]}, {"u": 36, "kind": "dialogue", "text": "Mamma.", "name": "BJARNI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Hand me the salt.", "name": "HELGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "He sets down the duffel at last.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Crosses to the shelf.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "Brings a tin of coarse salt.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "She takes it without a word and pours a ridge down the haddock's spine.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Dad would've said go.", "name": "BJARNI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Your father would've said go and then not paid for it.", "name": "HELGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "That's not fair.", "name": "BJARNI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "It's smoked fish. Nothing is fair.", "name": "HELGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "A silence.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Smoke drifts between them.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Helga glances up through it, and for a moment her face almost opens.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "The back door scrapes.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "Cold air, a flurry of snow.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "ASGEIR THORVALDSSON, 80, her father-in-law, enormous in a wool coat and a seal-fur hat, shoulders in carrying a crate of frozen herring.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Who died?", "name": "ASGEIR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Nobody, Asgeir.", "name": "HELGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "Then why do you both look like funerals?", "name": "ASGEIR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "He sets the crate on the table with a crash.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "Notices the duffel.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Notices Bjarni.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Understands.", "para": 12, "sent": 3, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "Ah.", "name": "ASGEIR", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "action", "text": "He sits on a stool.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 61, "kind": "action", "text": "Takes off his hat.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 62, "kind": "action", "text": "Rubs his bald head.", "para": 13, "sent": 2, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "When?", "name": "ASGEIR", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "Tonight.", "name": "BJARNI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "dialogue", "text": "Good. A boy should leave in the dark. Less to look back at.", "name": "ASGEIR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 66, "kind": "dialogue", "text": "Don't encourage him.", "name": "HELGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 67, "kind": "dialogue", "text": "He has your jaw, Helga. He'll go whether I encourage or no.", "name": "ASGEIR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "Helga laughs, short, and turns her back to hide it.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 69, "kind": "action", "text": "She scrubs her knife at the sink.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 70, "kind": "action", "text": "Bjarni steps toward her, hand half-raised.", "para": 14, "sent": 2, "present": [0, 1, 2]}, {"u": 71, "kind": "action", "text": "Asgeir stands, pulls the boy into a crushing hug that lifts him off the floor.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 72, "kind": "action", "text": "Bjarni yelps.", "para": 15, "sent": 1, "present": [0, 1, 2]}, {"u": 73, "kind": "action", "text": "Helga turns, drying her hands, fighting a smile.", "para": 15, "sent": 2, "present": [0, 1, 2]}, {"u": 74, "kind": "action", "text": "The boy squirms, red-faced, and Asgeir finally sets him down.", "para": 15, "sent": 3, "present": [0, 1, 2]}, {"u": 75, "kind": "action", "text": "He cuffs the back of Bjarni's head, tenderly.", "para": 15, "sent": 4, "present": [0, 1, 2]}, {"u": 76, "kind": "dialogue", "text": "Go. Take the herring.", "name": "ASGEIR", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 77, "kind": "dialogue", "text": "It's frozen.", "name": "BJARNI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 78, "kind": "dialogue", "text": "It travels well.", "name": "ASGEIR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 79, "kind": "action", "text": "Helga takes a paper bag from a drawer and begins to wrap smoked haddock in it.", "para": 16, "sent": 0, "present": [0, 1, 2]}, {"u": 80, "kind": "action", "text": "Her hands are steady.", "para": 16, "sent": 1, "present": [0, 1, 2]}, {"u": 81, "kind": "action", "text": "Her eyes are not.", "para": 16, "sent": 2, "present": [0, 1, 2]}, {"u": 82, "kind": "dialogue", "text": "Six fillets. And the dried fish for the bus.", "name": "HELGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 83, "kind": "dialogue", "text": "It stinks.", "name": "BJARNI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 84, "kind": "dialogue", "text": "That's how you'll find your way home.", "name": "HELGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 85, "kind": "action", "text": "He takes the parcel.", "para": 17, "sent": 0, "present": [0, 1, 2]}, {"u": 86, "kind": "action", "text": "Holds it with both hands.", "para": 17, "sent": 1, "present": [0, 1, 2]}, {"u": 87, "kind": "action", "text": "For a long moment the three of them stand in the blue smoke, none of them moving.", "para": 17, "sent": 2, "present": [0, 1, 2]}, {"u": 88, "kind": "action", "text": "Then Bjarni picks up the duffel.", "para": 18, "sent": 0, "present": [0, 1, 2]}, {"u": 89, "kind": "action", "text": "Crosses to the door.", "para": 18, "sent": 1, "present": [0, 1, 2]}, {"u": 90, "kind": "action", "text": "Stops with his hand on the latch.", "para": 18, "sent": 2, "present": [0, 1, 2]}, {"u": 91, "kind": "dialogue", "text": "Mamma. I'll call Sundays.", "name": "BJARNI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 92, "kind": "dialogue", "text": "Call when you've got something to say.", "name": "HELGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 93, "kind": "dialogue", "text": "Sundays, then.", "name": "BJARNI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 94, "kind": "action", "text": "He goes.", "para": 19, "sent": 0, "present": [0, 1, 2]}, {"u": 95, "kind": "action", "text": "The door shuts.", "para": 19, "sent": 1, "present": [0, 1, 2]}, {"u": 96, "kind": "action", "text": "Snow swirls in the gap and settles on the floor.", "para": 19, "sent": 2, "present": [0, 1, 2]}, {"u": 97, "kind": "action", "text": "Asgeir takes a stool.", "para": 20, "sent": 0, "present": [0, 1, 2]}, {"u": 98, "kind": "action", "text": "Helga returns to the haddock.", "para": 20, "sent": 1, "present": [0, 1, 2]}, {"u": 99, "kind": "dialogue", "text": "He'll be fine.", "name": "ASGEIR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 100, "kind": "dialogue", "text": "He'll eat badly.", "name": "HELGA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 101, "kind": "dialogue", "text": "So did his father.", "name": "ASGEIR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 102, "kind": "action", "text": "She sniffs.", "para": 21, "sent": 0, "present": [0, 1, 2]}, {"u": 103, "kind": "action", "text": "Presses the knife into the fish.", "para": 21, "sent": 1, "present": [0, 1, 2]}, {"u": 104, "kind": "action", "text": "Cuts clean through.", "para": 21, "sent": 2, "present": [0, 1, 2]}, {"u": 105, "kind": "action", "text": "She stops.", "para": 22, "sent": 0, "present": [0, 1, 2]}, {"u": 106, "kind": "action", "text": "Sets the knife down.", "para": 22, "sent": 1, "present": [0, 1, 2]}, {"u": 107, "kind": "action", "text": "Her shoulders drop, just once.", "para": 22, "sent": 2, "present": [0, 1, 2]}, {"u": 108, "kind": "action", "text": "Asgeir reaches across the table and pats her hand with a fish-scented glove.", "para": 23, "sent": 0, "present": [0, 1, 2]}]}