[], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He picks up a jar of eyes.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Rattles it.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Puts it back.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Package for Mr. Pemberton.", "name": "DEVRIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Leave it on the desk.", "name": "ORLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "He has to sign.", "name": "DEVRIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "He's upstairs.", "name": "ORLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "An intercom box on the wall crackles.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Orla. Is that the courier?", "name": "PEMBERTON", "speaker": 2, "ext": ["V.O."], "paren": ["through the speaker, dry"], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "He's here.", "name": "ORLA", "speaker": 0, "ext": [], "paren": ["to the box"], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Send him up. Door's open.", "name": "PEMBERTON", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Orla smiles at Devrim.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Door's open.", "name": "ORLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Where's the stairs?", "name": "DEVRIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "She points with the scalpel.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Behind a curtain.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Devrim goes.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "His footsteps on wood.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "A pause.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "A door creaks.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Then nothing.", "para": 7, "sent": 4, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Orla keeps stitching.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "The badger's fur parts under her thumb.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Orla. Who's the boy?", "name": "PEMBERTON", "speaker": 2, "ext": ["V.O.", "CONT'D"], "paren": ["through the speaker, much closer"], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "She stops.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "The thread hangs from her needle.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "What do you mean?", "name": "ORLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "I'm standing in the shop. Behind you.", "name": "PEMBERTON", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Orla does not turn.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "She sets down the scalpel.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Very, very slowly.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "On the speaker, upstairs, a muffled thump.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Footsteps run overhead.", "para": 11, "sent": 1, "present": [0, 1, 2]}]}