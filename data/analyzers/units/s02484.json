{"scene_id": "s02484", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02484.fountain", "heading": "INT. PAWNSHOP - NIGHT", "cast": [{"id": 0, "name": "HUGO VANTERPOOL", "names": ["HUGO VANTERPOOL", "HUGO"], "gender": "m", "first": 4, "spoke": 5}, {"id": 1, "name": "STRANGER", "names": ["STRANGER"], "gender": "m", "first": 6, "spoke": 5}, {"id": 2, "name": "SABINE ARCHAMBAULT", "names": ["SABINE ARCHAMBAULT", "ARCHAMBAULT"], "gender": "f", "first": 17, "spoke": 11}, {"id": 3, "name": "WALLACE", "names": ["WALLACE"], "gender": "?", "first": 36, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. PAWNSHOP - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Guitars on the wall.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Glass cases of rings and watches.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Barred windows glow with neon.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "HUGO VANTERPOOL, 60s, pawnbroker, cardigan, shuffles behind the counter.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He looks up as the door chime sounds.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "A STRANGER, 30s, wet coat, gaunt, enters.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He keeps his right hand in his pocket.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "He wanders to the cases.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Help you?", "name": "HUGO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Browsing.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "We close in ten minutes.", "name": "HUGO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Then I'll be quick.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He stops at a case of wedding bands.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Taps the glass.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Hugo pays him no mind, flips through a ledger.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "The door chimes again.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "DET. SABINE ARCHAMBAULT, 40s, trench coat, badge on her belt, steps in.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "She nods at Hugo.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Her eyes land on the Stranger.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Then slide away.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Evening, Hugo.", "name": "ARCHAMBAULT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Detective.", "name": "HUGO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Anything come in today?", "name": "ARCHAMBAULT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "A banjo. A set of knives. A ring.", "name": "HUGO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Which ring?", "name": "ARCHAMBAULT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Hugo gestures at the case the Stranger is standing over.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "The Stranger's hand tightens in his pocket.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Sir, can I see your hands?", "name": "ARCHAMBAULT", "speaker": 2, "ext": ["CONT'D"], "paren": ["mild"], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Why?", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Humour me.", "name": "ARCHAMBAULT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The Stranger takes out his hand.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "It's empty and trembling.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "He holds it up, palm out.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "I'm just looking at rings.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "What's your name?", "name": "ARCHAMBAULT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Wallace.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Wallace what?", "name": "ARCHAMBAULT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Teague. I live on Delancey.", "name": "WALLACE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Mr. Teague. A woman reported her ring stolen last Friday. Gold, with a small sapphire.", "name": "ARCHAMBAULT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Hugo pulls a velvet box from under the counter.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Opens it.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "A gold ring with a small sapphire.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Wallace sold me this on Saturday.", "name": "HUGO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "It was my mother's.", "name": "WALLACE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Whose ring was it before it was your mother's?", "name": "ARCHAMBAULT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Wallace's shoulders sag.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "He sits on a stool by the guitars.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Puts his face in his hands.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "I needed rent.", "name": "WALLACE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Archambault sighs.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Takes the ring from the box.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Closes her fingers around it.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Hugo, keep the shop open. I'll be back with the owner.", "name": "ARCHAMBAULT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "She nods at Wallace.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "You're coming with me.", "name": "ARCHAMBAULT", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "He rises.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Follows her to the door.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "The chime sounds as they leave.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "Hugo lets out a long breath and goes back to his ledger.", "para": 11, "sent": 3, "present": [0, 1, 2, 3]}]}