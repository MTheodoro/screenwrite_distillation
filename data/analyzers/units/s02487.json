{"scene_id": "s02487", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02487.fountain", "heading": "INT. THE DAILY CHRONICLE - COMPOSING ROOM - NIGHT - 1888", "cast": [{"id": 0, "name": "ALDOUS FENWICK", "names": ["ALDOUS FENWICK", "ALDOUS"], "gender": "m", "first": 5, "spoke": 5}, {"id": 1, "name": "BRIDIE QUINN", "names": ["BRIDIE QUINN", "BRIDIE"], "gender": "f", "first": 6, "spoke": 1}, {"id": 2, "name": "TOMASZ KRAWCZYK", "names": ["TOMASZ KRAWCZYK", "TOMASZ"], "gender": "?", "first": 7, "spoke": 1}, {"id": 3, "name": "PERPETUA LISLE", "names": ["PERPETUA LISLE", "PERPETUA"], "gender": "?", "first": 8, "spoke": 1}, {"id": 4, "name": "CYRIL BEAMISH", "names": ["CYRIL BEAMISH", "CYRIL"], "gender": "?", "first": 9, "spoke": 1}, {"id": 5, "name": "LORD HASTWELL", "names": ["LORD HASTWELL"], "gender": "?", "first": 13, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. THE DAILY CHRONICLE - COMPOSING ROOM - NIGHT - 1888", "present": []}, {"u": 1, "kind": "action", "text": "Gaslight.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cases of type.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Ink-black walls.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A press thumps below.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ALDOUS FENWICK, 50s, foreman, rolls his sleeves.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "BRIDIE QUINN, 20s, compositor, sets type with quick fingers.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "TOMASZ KRAWCZYK, 30s, pressman, hauls a forme.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "PERPETUA LISLE, 40s, proofreader, spectacles on a ribbon, scowls at a galley.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "CYRIL BEAMISH, 17, devil, sweeps.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "A brass speaking tube on the wall WHISTLES.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Everyone freezes.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Composing room.", "name": "ALDOUS", "speaker": 0, "ext": [], "paren": ["to the tube"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Fenwick. The front page.", "name": "LORD HASTWELL", "speaker": 5, "ext": ["V.O."], "paren": ["muffled, imperious"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Set and locked, my lord.", "name": "ALDOUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Pull it. A fire in Whitechapel. Use my headline.", "name": "LORD HASTWELL", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "There's no room.", "name": "BRIDIE", "speaker": 1, "ext": [], "paren": ["under her breath"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Hush, girl.", "name": "ALDOUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Was that a woman?", "name": "LORD HASTWELL", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "A compositor, sir.", "name": "ALDOUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Dismiss her.", "name": "LORD HASTWELL", "speaker": 5, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Bridie's hand closes over her composing stick.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Tomasz steps toward the tube.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Dismiss me too.", "name": "TOMASZ", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "And me.", "name": "PERPETUA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "And me.", "name": "CYRIL", "speaker": 4, "ext": [], "paren": ["squeaking"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Aldous pushes the cover onto the tube.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "The whistle dies.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "He turns slowly to face the room, and a smile breaks across his face.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Gentlemen. Ladies. Set the page.", "name": "ALDOUS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}