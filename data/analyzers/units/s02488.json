{"scene_id": "s02488", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02488.fountain", "heading": "EXT. RIVER OF ASH - FERRY - TWILIGHT", "cast": [{"id": 0, "name": "IXARA", "names": ["IXARA"], "gender": "?", "first": 3, "spoke": 9}, {"id": 1, "name": "BRUM", "names": ["BRUM"], "gender": "m", "first": 4, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "EXT. RIVER OF ASH - FERRY - TWILIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A black skiff drifts on slow grey water.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Pale ash falls like snow.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "IXARA, 30s, ferrywoman, silver-white hair, poles in silence.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "BRUM, 50s, a traveler in a cloak, sits upright with a lantern at his feet.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "Where to?", "name": "IXARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "The far shore.", "name": "BRUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Everyone says the far shore.", "name": "IXARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Everyone's headed there.", "name": "BRUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Not everyone has the fare.", "name": "IXARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I have the fare.", "name": "BRUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "What is it?", "name": "IXARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "A name.", "name": "BRUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Whose?", "name": "IXARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Yours.", "name": "BRUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Mine's not for sale.", "name": "IXARA", "speaker": 0, "ext": [], "paren": ["carefully"], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "It's not for sale. It's for the toll. You told it to the last passenger, and he told it to me. You have been Ixara for nine hundred years. Before that you were someone else.", "name": "BRUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Hush.", "name": "IXARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "They had a name for you in the old tongue. I have it here.", "name": "BRUM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Stop.", "name": "IXARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Do not speak it.", "name": "IXARA", "speaker": 0, "ext": [], "paren": ["together"], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "I'm going to speak it.", "name": "BRUM", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Ash thickens.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "The lantern gutters.", "para": 2, "sent": 1, "present": [0, 1]}]}