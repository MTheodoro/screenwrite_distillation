{"scene_id": "s02489", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02489.fountain", "heading": "INT. STARLIGHT ROLLER RINK - NIGHT", "cast": [{"id": 0, "name": "TARIQ OKAFOR-LANE", "names": ["TARIQ OKAFOR-LANE", "TARIQ"], "gender": "f", "first": 5, "spoke": 17}, {"id": 1, "name": "JOJO", "names": ["JOJO"], "gender": "?", "first": 6, "spoke": 20}, {"id": 2, "name": "VARGAS", "names": ["VARGAS"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "LINDQVIST", "names": ["LINDQVIST", "MR. LINDQVIST"], "gender": "?", "first": 7, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. STARLIGHT ROLLER RINK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Disco ball.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Carpeted walls.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A faded sign: LAST SKATE.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The speakers play a slow song nobody asked for.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "TARIQ OKAFOR-LANE, 17, rental skates two sizes too big, clings to the rail.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "JOSEFINA \"JOJO\" VARGAS, 17, graceful on her own wheels, skates backward in front of him.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "MR. LINDQVIST, 60s, owner, apron over a windbreaker, stacks plastic baskets at the snack counter, listening.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "You're doing it wrong.", "name": "JOJO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "I'm doing it.", "name": "TARIQ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "You're clutching.", "name": "JOJO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "It's called balance.", "name": "TARIQ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "It's called terror.", "name": "JOJO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "He lets go.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Windmills.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Grabs the rail again.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Jojo laughs and sails away, spins, comes back.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Come on, Tariq. Last night in the building. Let me see you skate.", "name": "JOJO", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "It's closing?", "name": "TARIQ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Mr. Lindqvist sold it. Condos.", "name": "JOJO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Tariq glances at the counter.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Mr. Lindqvist is wiping a spotless surface.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Why didn't you say?", "name": "TARIQ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "I'm saying.", "name": "JOJO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "I mean before.", "name": "TARIQ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Before, you weren't talking to me.", "name": "JOJO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "You weren't talking to me.", "name": "TARIQ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "They look at each other.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Disco light slides across their faces.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "I'm sorry, Jo.", "name": "TARIQ", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "For what?", "name": "JOJO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "For what I said in the cafeteria.", "name": "TARIQ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Which part?", "name": "JOJO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "All of it.", "name": "TARIQ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "She skates to him.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Holds out both hands.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Come on. Let go of the wall.", "name": "JOJO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "He lets go.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Takes her hands.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "She backs away slowly, pulling him across the floor.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "He wobbles.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Straightens.", "para": 6, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "I'm doing it.", "name": "TARIQ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "You're doing it.", "name": "JOJO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "They circle.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Behind them the song fades into a different song.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Mr. Lindqvist dims the lights another notch.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Five more minutes, you two.", "name": "MR. LINDQVIST", "speaker": 3, "ext": ["O.S."], "paren": ["calling from the counter"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Ten, Mr. L!", "name": "JOJO", "speaker": 1, "ext": [], "paren": ["calling back"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Five!", "name": "MR. LINDQVIST", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Tariq grins.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "For a lap, his skating looks almost natural.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Where will you go? After?", "name": "TARIQ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "There's a rink in Eastbrook.", "name": "JOJO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "That's forty minutes.", "name": "TARIQ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "I've got a bike.", "name": "JOJO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "I haven't.", "name": "TARIQ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "Then borrow one.", "name": "JOJO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "Tariq nods.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "The ball spins.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "They skate in silence for a long time.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "My dad's moving us in June.", "name": "JOJO", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "Where?", "name": "TARIQ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "Tucson.", "name": "JOJO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "He stumbles.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "She catches him.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "You were going to tell me?", "name": "TARIQ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "I'm telling you.", "name": "JOJO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "Same as the rink.", "name": "TARIQ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "dialogue", "text": "Same as the rink.", "name": "JOJO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "He steadies himself.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "They keep circling.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "action", "text": "The song ends.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "action", "text": "The overhead lights flicker once, twice.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "Mr. Lindqvist's silhouette stands at the switch.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "dialogue", "text": "That's it, kids.", "name": "MR. LINDQVIST", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "Tariq doesn't let go of her hand.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "dialogue", "text": "One more lap.", "name": "TARIQ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "dialogue", "text": "Mr. L!", "name": "JOJO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "dialogue", "text": "One more lap.", "name": "MR. LINDQVIST", "speaker": 3, "ext": ["O.S."], "paren": ["a long beat"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "action", "text": "He kills the music.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "action", "text": "In the silence there is only the soft rumble of two sets of wheels on old boards, going round and round.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}]}