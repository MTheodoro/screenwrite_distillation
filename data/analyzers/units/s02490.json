{"scene_id": "s02490", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02490.fountain", "heading": "INT. GRUYERES AGING CELLAR - NIGHT", "cast": [{"id": 0, "name": "PETRA VOLKOVA", "names": ["PETRA VOLKOVA", "PETRA"], "gender": "m", "first": 4, "spoke": 16}, {"id": 1, "name": "MILOS DRAGIC", "names": ["MILOS DRAGIC", "MILOS"], "gender": "?", "first": 5, "spoke": 10}, {"id": 2, "name": "AKIKO TANABE", "names": ["AKIKO TANABE", "AKIKO"], "gender": "?", "first": 6, "spoke": 13}, {"id": 3, "name": "NAILAH ROSS", "names": ["NAILAH ROSS", "NAILAH"], "gender": "?", "first": 7, "spoke": 11}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRUYERES AGING CELLAR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A limestone cave lit by work lamps.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Ten thousand wheels of cheese on spruce shelves, rising in towers to the vault.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The air smells of ammonia and cold stone.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "PETRA VOLKOVA, 40s, crew boss, headlamp, climbing harness.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "MILOS DRAGIC, 30s, rigger, clips a carabiner.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "AKIKO TANABE, 20s, hacker, crouched over a ruggedised laptop on a cheese crate.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "NAILAH ROSS, 30s, driver, stands at the cellar door with a thermal flask.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Report.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Cameras on a loop. Eleven minutes of grace.", "name": "AKIKO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Eleven is plenty.", "name": "MILOS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Truck's at the barn. Engine warm.", "name": "NAILAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Milo\u0161, rope.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "He tosses a coil.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "She catches it.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Anchors it to a pillar.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Tests the tension with her whole weight.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "The vault door is on a thermal sensor. If it drops below four degrees, it locks.", "name": "AKIKO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "It's twelve in here.", "name": "MILOS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "It's twelve out here. Inside it's six.", "name": "AKIKO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Then we bring a heater.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "I've got a heater.", "name": "NAILAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "She lifts a silver case.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Opens it.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "A compact space heater.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Brought two.", "name": "NAILAH", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "You think of everything.", "name": "MILOS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "I think of heaters.", "name": "NAILAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Akiko, how long on the lock?", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Four minutes.", "name": "AKIKO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Make it three.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Make me a coffee.", "name": "AKIKO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "You want coffee?", "name": "NAILAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "I want three minutes. Coffee is a metaphor.", "name": "AKIKO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "It's a good one.", "name": "MILOS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "They move to the vault door.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "A circular steel hatch set into the rock, rimed with frost.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Petra runs a glove over it.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Seventeen wheels in there, aged forty years. Each one worth a Porsche.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "They smell like feet.", "name": "MILOS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Porsches don't.", "name": "NAILAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Focus.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Akiko plugs a cable.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "Taps a key.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "The hatch ticks.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Two minutes forty.", "name": "AKIKO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "That was fast.", "name": "MILOS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "It's a cheap lock. They trusted the cheese.", "name": "AKIKO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Milo\u0161, harness.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "He steps in.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Petra clips him on.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "Akiko cracks the hatch.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Cold air floods out.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Inside, the wheels gleam amber in the work lamps.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Beautiful.", "name": "MILOS", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Don't sing to it.", "name": "NAILAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Nailah, the dolly.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "She rolls it over.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "Together they lift the first wheel, a hundred pounds of rind and rot.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "It sits on the dolly like a sleeping animal.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "Eight minutes left.", "name": "AKIKO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "Faster.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "I've got it.", "name": "MILOS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "I've got the second.", "name": "NAILAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "They work.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "A rhythm.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "Grunts, breath, the click of the dolly.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "Third.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "Third.", "name": "MILOS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "dialogue", "text": "Seven minutes.", "name": "AKIKO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "dialogue", "text": "Fourth.", "name": "NAILAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "dialogue", "text": "Good.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "action", "text": "Lamplight swings across the stacked wheels.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "action", "text": "A distant sound.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "All four stop.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "dialogue", "text": "Was that the door?", "name": "NAILAH", "speaker": 3, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "dialogue", "text": "Cat.", "name": "AKIKO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "dialogue", "text": "There's no cat.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "dialogue", "text": "Cat in the barn.", "name": "AKIKO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "dialogue", "text": "Keep working.", "name": "PETRA", "speaker": 0, "ext": [], "paren": ["a beat"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "action", "text": "They keep working.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "action", "text": "Fifth wheel.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "action", "text": "Sixth.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "dialogue", "text": "Five minutes.", "name": "AKIKO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 84, "kind": "dialogue", "text": "Seventh.", "name": "MILOS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 85, "kind": "dialogue", "text": "We have room for nine.", "name": "NAILAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 86, "kind": "dialogue", "text": "Then we take nine.", "name": "PETRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 87, "kind": "action", "text": "They load.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 88, "kind": "action", "text": "The truck horn, faint, beeps twice from outside.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 89, "kind": "action", "text": "All four glance up.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 90, "kind": "dialogue", "text": "That's the signal. Out.", "name": "PETRA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 91, "kind": "action", "text": "They dismantle the rig.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 92, "kind": "action", "text": "Rope coils.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 93, "kind": "action", "text": "Lamp clicks off.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 94, "kind": "action", "text": "The vault door seals.", "para": 13, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 95, "kind": "action", "text": "They file out into the night, one wheel short of nine, and none of them says so.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}]}