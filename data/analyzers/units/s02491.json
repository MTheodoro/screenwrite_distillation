{"scene_id": "s02491", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02491.fountain", "heading": "INT. HARBORSIDE TACKLE SHOP - DAY", "cast": [{"id": 0, "name": "EUNICE MARLOWE", "names": ["EUNICE MARLOWE", "EUNICE"], "gender": "?", "first": 5, "spoke": 17}, {"id": 1, "name": "DARIUS MARLOWE", "names": ["DARIUS MARLOWE", "DARIUS"], "gender": "?", "first": 5, "spoke": 18}], "units": [{"u": 0, "kind": "heading", "text": "INT. HARBORSIDE TACKLE SHOP - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Fishing rods in racks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Lures in glass jars.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A cat sleeps on a coil of rope.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain on the window.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "EUNICE MARLOWE, 60s, cardigan, glasses pushed up in her hair, sorts hooks into little drawers.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "She works without hurry.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "The bell on the door jingles.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "DARIUS MARLOWE, 30s, her son, damp jacket, steps in, shaking out his umbrella.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Mom.", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "You're early.", "name": "EUNICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Train was on time.", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "That never happens.", "name": "EUNICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He leans on the counter.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "She doesn't stop sorting.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "You look tired.", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "I'm sixty-three.", "name": "EUNICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "You look tired for sixty-three.", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She smiles at the drawer.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Closes it.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "There's tea in the back.", "name": "EUNICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "I'm fine.", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Then there's tea for me.", "name": "EUNICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She goes through the curtain.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "He wanders the aisles.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Lifts a lure shaped like a tiny silver fish.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Turns it in the light.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "She returns with two cups.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Sets one by him, not looking at him.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "He takes it.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Dad's rods are still on the wall.", "name": "DARIUS", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Where else would they be?", "name": "EUNICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "You could sell them.", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "They're not for sale.", "name": "EUNICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "You're closing the shop.", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Her cup stops halfway to her mouth.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "She sets it down.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "Who told you?", "name": "EUNICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Harbour Authority sent a letter to me. I'm still on the lease.", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "I forgot that.", "name": "EUNICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "You forgot a lot of things.", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Darius.", "name": "EUNICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "How long, Mom?", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "She drums her fingers on the counter.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "The cat stirs.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "April. They gave me till April.", "name": "EUNICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "And the rest?", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "What rest?", "name": "EUNICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "The rest that's in the folder you hid in the register.", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "She stares at him.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "He opens the till.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "Takes out a manila folder.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "Lays it on the counter between them.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "Dr. Anand called me too.", "name": "DARIUS", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "He had no right.", "name": "EUNICE", "speaker": 0, "ext": [], "paren": ["very quietly"], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "dialogue", "text": "He had a patient's son's number.", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "She slides the folder to her side.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "Opens it.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "Closes it.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "Her hand rests on top.", "para": 10, "sent": 3, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "I wanted to tell you at Easter.", "name": "EUNICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "It's April now, Mom.", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "She laughs, shakily.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "Wipes her eye with the heel of her hand.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "Would you like the rods?", "name": "EUNICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "dialogue", "text": "I'd like you to come live with me.", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 66, "kind": "dialogue", "text": "I'd have to bring the cat.", "name": "EUNICE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 67, "kind": "dialogue", "text": "Bring the cat.", "name": "DARIUS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "Bring the rods.", "name": "EUNICE", "speaker": 0, "ext": [], "paren": ["a beat"], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "action", "text": "He nods.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 70, "kind": "action", "text": "The rain softens against the glass.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "The cat jumps onto the counter and settles on the folder.", "para": 12, "sent": 2, "present": [0, 1]}]}