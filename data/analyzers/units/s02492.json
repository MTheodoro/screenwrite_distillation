false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "It's meant to.", "name": "EPHRAIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Not my best vase. Not my best vase at all.", "name": "WILFRED", "speaker": 3, "ext": [], "paren": ["muttering, to himself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Wilfred, pressure with the heel of your hand.", "name": "YETUNDE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "That's what I'm doing.", "name": "WILFRED", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "His vase leans, folds, and slides off the wheel.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Better luck.", "name": "EPHRAIM", "speaker": 1, "ext": [], "paren": ["to Wilfred"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Take a breath. Pottery is patience.", "name": "YETUNDE", "speaker": 0, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "The kiln timer BUZZES.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Everyone jumps.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Mariska flings a handful of slip across Ephraim's shirt.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Sorry!", "name": "MARISKA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Should've taken up golf.", "name": "EPHRAIM", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Yetunde sets down her bowl.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Sighs.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Looks at the wreckage.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Wilfred looks at the vase on the floor.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Would anyone mind if I just threw it out?", "name": "WILFRED", "speaker": 3, "ext": [], "paren": ["soft"], "dual": false, "present": [0, 1, 2, 3]}]}