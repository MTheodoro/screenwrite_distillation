{"scene_id": "s02494", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02494.fountain", "heading": "INT. TIDE MILL MUSEUM - NIGHT", "cast": [{"id": 0, "name": "MADAME ODILE FONTAINE", "names": ["MADAME ODILE FONTAINE", "ODILE"], "gender": "?", "first": 5, "spoke": 5}, {"id": 1, "name": "FENWICK PRIDDY", "names": ["FENWICK PRIDDY", "FENWICK"], "gender": "?", "first": 6, "spoke": 4}, {"id": 2, "name": "LAKSHMI IYER", "names": ["LAKSHMI IYER", "LAKSHMI"], "gender": "?", "first": 7, "spoke": 2}, {"id": 3, "name": "ULRICH BAUMANN", "names": ["ULRICH BAUMANN"], "gender": "?", "first": 8, "spoke": 0}, {"id": 4, "name": "DELILAH MWANGI", "names": ["DELILAH MWANGI", "DELILAH"], "gender": "f", "first": 9, "spoke": 4}, {"id": 5, "name": "FRANK", "names": ["FRANK"], "gender": "?", "first": 42, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. TIDE MILL MUSEUM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A great timber wheel hangs motionless in a dry race.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Pale moonlight leaks through slatted windows and lays long bars across the floor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Millstones the size of cartwheels sit in their cases like fallen moons.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Five figures in dark clothes drop one by one from a skylight on ropes.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "MADAME ODILE FONTAINE, 60s, the planner, lands first, soundless, silver hair under a black scarf.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "FENWICK PRIDDY, 50s, the safecracker, follows, wheezing.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "LAKSHMI IYER, 30s, the electrician, lands lightly.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "ULRICH BAUMANN, 40s, the muscle, thuds down last and winces at the noise.", "para": 1, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "And DELILAH MWANGI, 30s, the inside woman, steps out of the shadows in a museum fleece, a lanyard around her neck.", "para": 1, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Positions.", "name": "ODILE", "speaker": 0, "ext": [], "paren": ["to the group"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "They scatter without a word.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Lakshmi to the fuse box.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Ulrich to the stairwell.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Forty years since I did a window.", "name": "FENWICK", "speaker": 1, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "You did it last month.", "name": "ODILE", "speaker": 0, "ext": [], "paren": ["to Fenwick"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "That was a different window.", "name": "FENWICK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Power's mine in ninety seconds.", "name": "LAKSHMI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "The case is on the second floor. Under the gears.", "name": "DELILAH", "speaker": 4, "ext": [], "paren": ["to Odile"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "And the guard?", "name": "ODILE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Asleep. I put something in his tea.", "name": "DELILAH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Good girl.", "name": "ODILE", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "They climb.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Wooden stairs complain under each step.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "On the second floor, behind a cluster of cogs, a glass case holds a bronze tide-clock the size of a loaf.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Fenwick kneels.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Puts his stethoscope to the lock.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Closes his eyes.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Come on, sweetheart.", "name": "FENWICK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Lights in five.", "name": "LAKSHMI", "speaker": 2, "ext": ["O.S."], "paren": ["from below, a stage whisper"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Hold your breath.", "name": "ODILE", "speaker": 0, "ext": [], "paren": ["to everyone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "The mill goes black.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "In the dark, a click.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "A second click.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "The case glass lifts.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Fenwick lifts the clock out with both hands.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Cradles it like an infant.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Got her.", "name": "FENWICK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "A beam of white light sweeps the room.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "The guard in the doorway, rubbing his eyes.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "A thermos in his hand.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Everyone freezes.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Delilah?", "name": "FRANK", "speaker": 5, "ext": ["O.S."], "paren": ["slurred"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Delilah steps forward, into the light, smiling.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Frank. You should be asleep.", "name": "DELILAH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "I was. Had a dream.", "name": "FRANK", "speaker": 5, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "She crosses to him.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "Slips an arm round his shoulder.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "Turns him around.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "Back to bed, Frank.", "name": "DELILAH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "He lets himself be steered.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Odile exhales.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "The beam retreats.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "Ulrich's fist unclenches.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "Fenwick tucks the clock into a velvet bag.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "They file toward the skylight, silent and fast.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "Last up the rope, Odile glances back at the great wheel.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "She touches two fingers to her lips and presses them to the timber as she passes.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}