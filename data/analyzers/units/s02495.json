{"scene_id": "s02495", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02495.fountain", "heading": "INT. DIALYSIS UNIT - NIGHT", "cast": [{"id": 0, "name": "ABIOLA SOYINKA", "names": ["ABIOLA SOYINKA", "ABIOLA"], "gender": "?", "first": 5, "spoke": 11}, {"id": 1, "name": "CASTELLANOS", "names": ["CASTELLANOS"], "gender": "?", "first": 6, "spoke": 11}], "units": [{"u": 0, "kind": "heading", "text": "INT. DIALYSIS UNIT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Chairs in a row.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Machines whirring.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "One patient.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "One nurse.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ABIOLA SOYINKA, 40s, nurse, ID badge clipped to scrubs, checks a monitor.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "MR. CASTELLANOS, 70s, patient, in the third chair, arm in the machine, stares at the ceiling.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Pressure's good.", "name": "ABIOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Always is.", "name": "CASTELLANOS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Tonight?", "name": "ABIOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Always.", "name": "CASTELLANOS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She adjusts the line.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He doesn't flinch.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Quiet.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "The machine hums.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "My daughter called.", "name": "CASTELLANOS", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "That's nice.", "name": "ABIOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "She's coming Thursday.", "name": "CASTELLANOS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "That's nice.", "name": "ABIOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He turns his head.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Studies her.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "You say that twice.", "name": "CASTELLANOS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Do I?", "name": "ABIOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "You do when you don't believe it.", "name": "CASTELLANOS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She smiles.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "A small one.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Checks the clock.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "An alarm shrieks.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Both flinch.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Abiola spins to the monitor.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Red.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Mr. Castellanos. Look at me.", "name": "ABIOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "I'm fine.", "name": "CASTELLANOS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Stay still.", "name": "ABIOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "She reaches for his arm.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "He pulls it away.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "The line tugs.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Blood beads at the needle.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Don't.", "name": "CASTELLANOS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "You'll hurt yourself.", "name": "ABIOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "I want to go home.", "name": "CASTELLANOS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "Not yet.", "name": "ABIOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "He rips at the tape.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "She seizes his wrist.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "For a moment they grapple, nurse and patient, old hands and young.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "The machine screams.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "The chair rocks.", "para": 8, "sent": 4, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "Then he stops.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Goes limp.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "She holds his wrist.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "He holds her gaze.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "Thursday.", "name": "CASTELLANOS", "speaker": 1, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Thursday.", "name": "ABIOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "She resets the machine.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "The alarm falls silent.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "She presses gauze to his arm.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "He lets her.", "para": 10, "sent": 3, "present": [0, 1]}, {"u": 57, "kind": "dialogue", "text": "You say it right that time.", "name": "CASTELLANOS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "I know.", "name": "ABIOLA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "She tapes the gauze down.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "Checks the line.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "Pats his hand.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "Neither speaks.", "para": 11, "sent": 3, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "The machine settles back into its slow, patient hum.", "para": 11, "sent": 4, "present": [0, 1]}]}