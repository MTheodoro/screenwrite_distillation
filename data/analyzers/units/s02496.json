{"scene_id": "s02496", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02496.fountain", "heading": "EXT. LISTENING POST - NO MAN'S LAND - NIGHT - 1917", "cast": [{"id": 0, "name": "DRUMMOND", "names": ["DRUMMOND"], "gender": "m", "first": 4, "spoke": 7}, {"id": 1, "name": "YUSUF ARSLAN", "names": ["YUSUF ARSLAN", "ARSLAN"], "gender": "m", "first": 5, "spoke": 5}, {"id": 2, "name": "CAPTIVE", "names": ["CAPTIVE"], "gender": "?", "first": 6, "spoke": 1}, {"id": 3, "name": "LEOPOLD", "names": ["LEOPOLD"], "gender": "m", "first": 14, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. LISTENING POST - NO MAN'S LAND - NIGHT - 1917", "present": []}, {"u": 1, "kind": "action", "text": "A shell crater, ankle-deep in water.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Barbed wire above.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Star shells pop on the horizon.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SGT. DRUMMOND, 30s, mud to the thighs, kneels at the lip with a rifle.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "LT. YUSUF ARSLAN, 20s, officer, binoculars round his neck, crouches beside him.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "A CAPTIVE, 20s, hands tied, kneels in the water at their feet, shivering in a grey tunic.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "He's a boy.", "name": "DRUMMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "He's a prisoner.", "name": "ARSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "He's a boy, sir.", "name": "DRUMMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Ask his name.", "name": "ARSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Name?", "name": "DRUMMOND", "speaker": 0, "ext": [], "paren": ["to the Captive"], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "The Captive says nothing.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Drummond prods him with the rifle.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Leopold.", "name": "CAPTIVE", "speaker": 2, "ext": [], "paren": ["thick accent"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Leopold what?", "name": "DRUMMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Just Leopold.", "name": "LEOPOLD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Ask him where the machine gun is.", "name": "ARSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Where's the gun, Leopold?", "name": "DRUMMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "No gun.", "name": "LEOPOLD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "He's lying.", "name": "ARSLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "A shell whistles overhead.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "The three duck.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "The crater erupts in mud.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Leopold breaks for the wire, bound hands in front of him.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Drummond lunges and catches his ankle.", "para": 3, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Arslan grabs his collar.", "para": 3, "sent": 5, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "All three go down in the water, thrashing.", "para": 3, "sent": 6, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Drummond pins him.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Leopold goes limp.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Arslan pulls Drummond off.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Enough.", "name": "ARSLAN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "They crouch, breathing.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Leopold lies in the water, chest heaving.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "My brother is in your trench. Joachim. He surrendered in March.", "name": "LEOPOLD", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Drummond looks at Arslan.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Joachim? Big lad, cigarette burns?", "name": "DRUMMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Yes.", "name": "LEOPOLD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "He's at the aid post. Alive.", "name": "DRUMMOND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Leopold closes his eyes.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Arslan lowers the binoculars.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Drummond cuts the rope on the boy's wrists.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "Another shell.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "They duck again.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Leopold, free, stays down.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}]}