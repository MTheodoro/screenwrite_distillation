{"scene_id": "s02497", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02497.fountain", "heading": "INT. WHALE-BONE APOTHECARY - NIGHT", "cast": [{"id": 0, "name": "SORREL VANE", "names": ["SORREL VANE", "SORREL"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "OSWIN GRIST", "names": ["OSWIN GRIST", "OSWIN"], "gender": "?", "first": 19, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. WHALE-BONE APOTHECARY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A shop built inside the ribcage of a dead leviathan.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Ribs arch overhead like cathedral beams.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Jars glow green on bone shelves.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SORREL VANE, 20s, apprentice, grinds something blue in a mortar.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "A cauldron simmers behind her.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "The door swings open on a gust of salt air.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "No one is there.", "para": 2, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "Sorrel looks up.", "para": 2, "sent": 2, "present": [0]}, {"u": 9, "kind": "dialogue", "text": "Hello?", "name": "SORREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 10, "kind": "action", "text": "The jars hum.", "para": 3, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "A drip falls from the roof of the ribcage.", "para": 3, "sent": 1, "present": [0]}, {"u": 12, "kind": "action", "text": "Another.", "para": 3, "sent": 2, "present": [0]}, {"u": 13, "kind": "dialogue", "text": "We're closed.", "name": "SORREL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 14, "kind": "action", "text": "The bell above the door rings, by itself.", "para": 4, "sent": 0, "present": [0]}, {"u": 15, "kind": "dialogue", "text": "Show yourself.", "name": "SORREL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0]}, {"u": 16, "kind": "action", "text": "A shape in the corner thickens.", "para": 5, "sent": 0, "present": [0]}, {"u": 17, "kind": "action", "text": "Flickers.", "para": 5, "sent": 1, "present": [0]}, {"u": 18, "kind": "action", "text": "Resolves.", "para": 5, "sent": 2, "present": [0]}, {"u": 19, "kind": "action", "text": "OSWIN GRIST, ancient, barnacle-crusted, a drowned sailor in a coat of kelp, steps from the shadows.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Water pours from his sleeves.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "I need a remedy, girl.", "name": "OSWIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "For what?", "name": "SORREL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Breathing.", "name": "OSWIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Sorrel sets down the mortar.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "The cauldron boils over.", "para": 7, "sent": 1, "present": [0, 1]}]}