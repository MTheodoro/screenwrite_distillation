{"scene_id": "s02498", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02498.fountain", "heading": "INT. LIGHTHOUSE KEEPER'S COTTAGE - CHRISTMAS EVE - NIGHT - 1948", "cast": [{"id": 0, "name": "AMBROSE FINCH", "names": ["AMBROSE FINCH", "AMBROSE"], "gender": "f", "first": 5, "spoke": 8}, {"id": 1, "name": "GLADYS FINCH", "names": ["GLADYS FINCH", "GLADYS"], "gender": "f", "first": 5, "spoke": 6}, {"id": 2, "name": "TILLY", "names": ["TILLY"], "gender": "?", "first": 7, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. LIGHTHOUSE KEEPER'S COTTAGE - CHRISTMAS EVE - NIGHT - 1948", "present": []}, {"u": 1, "kind": "action", "text": "A small, snug kitchen.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Snow against the window.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A fir tree no taller than a broom stands in a bucket, hung with paper stars.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The big lamp turns slowly above them, sweeping its beam through the frost.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "AMBROSE FINCH, 40s, the keeper, in a heavy jersey, carves a goose.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "His wife, GLADYS FINCH, 40s, bustles with a gravy boat.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Their daughter TILLY, 8, hides under the table with a stuffed rabbit.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Dinner in five!", "name": "GLADYS", "speaker": 1, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Come out, poppet.", "name": "AMBROSE", "speaker": 0, "ext": [], "paren": ["to Tilly"], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "No.", "name": "TILLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Why not?", "name": "AMBROSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Santa'll see the lamp and think we're a ship.", "name": "TILLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Ambrose puts the carving knife down.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Crouches.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Looks under the table.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Santa's got a better chart than that.", "name": "AMBROSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Does he?", "name": "TILLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Best in the world.", "name": "AMBROSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "I hope he's got a better goose than this.", "name": "GLADYS", "speaker": 1, "ext": [], "paren": ["muttering, at the stove"], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I heard that.", "name": "AMBROSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Tilly slides out.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Rabbit in hand.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Ambrose lifts her.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Gladys sets the gravy on the table and the three of them stand there, laughing.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "The rabbit falls.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Tilly lunges for it.", "para": 3, "sent": 5, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Ambrose steps back.", "para": 3, "sent": 6, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Gladys catches the gravy boat as it tips.", "para": 3, "sent": 7, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Everything clatters.", "para": 3, "sent": 8, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Sorry!", "name": "TILLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Merry Christmas.", "name": "GLADYS", "speaker": 1, "ext": [], "paren": ["to herself"], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Ambrose rights the chairs.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "A knock at the door.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "They freeze.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Who'd come up here tonight?", "name": "AMBROSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Gladys opens the door.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Wind, snow, nobody.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "A parcel in brown paper on the step.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Hello?", "name": "GLADYS", "speaker": 1, "ext": [], "paren": ["calling into the dark"], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "It's Santa!", "name": "TILLY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Gladys. Close the door.", "name": "AMBROSE", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "She closes it.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "The parcel sits on the table.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Tilly claps.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Ambrose cuts the string.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Inside, a small brass ship's bell and a card.", "para": 6, "sent": 4, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "What does it say?", "name": "GLADYS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "\"To the light that brought us home.\"", "name": "AMBROSE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Ambrose rings the bell once.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Soft.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "The lamp above turns on, steady and bright.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Gladys wipes her eyes with the corner of her apron.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "Eat before it gets cold.", "name": "GLADYS", "speaker": 1, "ext": [], "paren": ["to everyone"], "dual": false, "present": [0, 1, 2]}]}