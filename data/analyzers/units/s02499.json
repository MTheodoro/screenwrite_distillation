{"scene_id": "s02499", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02499.fountain", "heading": "INT. RIVERBOAT COURTROOM - DAY - 1936", "cast": [{"id": 0, "name": "JUDGE PRENDERGAST HOLCOMB", "names": ["JUDGE PRENDERGAST HOLCOMB", "JUDGE HOLCOMB"], "gender": "?", "first": 4, "spoke": 4}, {"id": 1, "name": "VIOLA STARLING", "names": ["VIOLA STARLING", "VIOLA"], "gender": "f", "first": 5, "spoke": 4}, {"id": 2, "name": "SILAS DELACROIX", "names": ["SILAS DELACROIX", "SILAS"], "gender": "?", "first": 6, "spoke": 4}, {"id": 3, "name": "WITNESS", "names": ["WITNESS"], "gender": "?", "first": 7, "spoke": 0}, {"id": 4, "name": "ODELL BANKS", "names": ["ODELL BANKS", "ODELL"], "gender": "?", "first": 7, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. RIVERBOAT COURTROOM - DAY - 1936", "present": []}, {"u": 1, "kind": "action", "text": "A converted paddle steamer docked at a Mississippi landing, its saloon turned into a courtroom.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A chandelier sways.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Through the porthole windows brown water slides past.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "JUDGE PRENDERGAST HOLCOMB, 70s, white-whiskered, ancient, presides from a bench made of a bar counter.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "VIOLA STARLING, 30s, defence counsel in a navy suit and pearls, stands with her notes.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "At the prosecution table, SILAS DELACROIX, 50s, pot-bellied, in a cream suit, fans himself with a folder.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "On the witness stand, a rattled WITNESS, 40s, grips the rail: ODELL BANKS.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "dialogue", "text": "Mr. Banks, where were you on the night of the fourteenth?", "name": "VIOLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "At the landing, ma'am.", "name": "ODELL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Objection! Leading!", "name": "SILAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Sustained. Rephrase.", "name": "JUDGE HOLCOMB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Where were you?", "name": "VIOLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "I told you. The landing.", "name": "ODELL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "He's answered!", "name": "SILAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "He's repeated himself!", "name": "VIOLA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Order, both of you!", "name": "JUDGE HOLCOMB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "The steamer lurches on its moorings.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Silas grabs the table.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Viola steadies herself on the witness rail.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Odell squeaks.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "The judge's gavel rolls off the bar counter and clatters to the floor.", "para": 2, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Your Honour, the court is moving!", "name": "SILAS", "speaker": 2, "ext": [], "paren": ["to the judge"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "The court is a boat, Mr. Delacroix.", "name": "JUDGE HOLCOMB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Mr. Banks, did you see the defendant at the landing?", "name": "VIOLA", "speaker": 1, "ext": [], "paren": ["over him"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "I saw somebody.", "name": "ODELL", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Hearsay!", "name": "SILAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Overruled. I've been seasick since nine.", "name": "JUDGE HOLCOMB", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "The room erupts in laughter.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Silas turns crimson.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "The chandelier swings.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Viola presses a handkerchief to her lips, hiding a smile.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}]}