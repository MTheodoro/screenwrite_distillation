{"scene_id": "s02500", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02500.fountain", "heading": "INT. GARAGE - TOMATO CANNING DAY - MORNING", "cast": [{"id": 0, "name": "AUNT PRUDENCE", "names": ["AUNT PRUDENCE", "PRUDENCE"], "gender": "f", "first": 5, "spoke": 6}, {"id": 1, "name": "HORTENSE", "names": ["HORTENSE"], "gender": "?", "first": 6, "spoke": 5}, {"id": 2, "name": "LEANDRO", "names": ["LEANDRO"], "gender": "?", "first": 7, "spoke": 0}, {"id": 3, "name": "INEZ", "names": ["INEZ"], "gender": "?", "first": 8, "spoke": 0}, {"id": 4, "name": "NOAH", "names": ["NOAH"], "gender": "m", "first": 9, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. GARAGE - TOMATO CANNING DAY - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Open door, hot sun.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Crates of tomatoes stacked to the rafters.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Two enormous pots boil on camp stoves.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Mason jars gleam in rows on a folding table.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "AUNT PRUDENCE, 70, in a flowered apron, stirs a pot with an oar-sized spoon.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her sister HORTENSE, 68, in an identical apron, slices tomatoes by the hundred.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Cousin LEANDRO, 30s, carries a crate.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "INEZ, 9, sits on an upturned bucket labelling jars with a marker.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "NOAH, 16, scrolls on his phone and leans on the workbench.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Noah. Gloves.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Why?", "name": "NOAH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Because she said so.", "name": "HORTENSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "She means me.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "She means both of us.", "name": "HORTENSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Inez giggles.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Prudence glares at her.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "She hides her face in the jar.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Leandro sets the crate down with a crash.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "A tomato bursts.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Juice sprays Hortense's apron.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "She looks at him.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "He looks at the tomato.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "She laughs, then she does not, and she picks up the knife again.", "para": 3, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Prudence turns from the pot.", "para": 3, "sent": 6, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "She watches Hortense, and she lowers the spoon.", "para": 3, "sent": 7, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "You've gone quiet.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "I'm cutting.", "name": "HORTENSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "You only cut that fast when you're angry.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "She's got a pot boiling over.", "name": "HORTENSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Prudence spins.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "The pot foams.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "She snatches the lid, burns her hand, and drops it.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "It clangs on the concrete.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Inez shrieks.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Noah looks up from his phone.", "para": 4, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Leandro grabs a dish towel.", "para": 4, "sent": 6, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Hortense grabs Prudence's wrist and runs it under the spigot while Noah backs away, scrolling again.", "para": 4, "sent": 7, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "I'm fine.", "name": "PRUDENCE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "You're not.", "name": "HORTENSE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "She's right, Noah. Gloves.", "name": "PRUDENCE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Noah pockets the phone, takes the gloves, and pulls them on without a word.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}]}