{"scene_id": "s02501", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02501.fountain", "heading": "EXT. LIFE RAFT - OPEN OCEAN - DAWN", "cast": [{"id": 0, "name": "AMARA OKONJO", "names": ["AMARA OKONJO", "AMARA"], "gender": "f", "first": 4, "spoke": 3}, {"id": 1, "name": "JIN PARK-LEE", "names": ["JIN PARK-LEE", "JIN"], "gender": "?", "first": 5, "spoke": 2}, {"id": 2, "name": "BENEDICT AINSWORTH", "names": ["BENEDICT AINSWORTH", "BENEDICT"], "gender": "m", "first": 6, "spoke": 1}, {"id": 3, "name": "SOLVEIG HANSEN", "names": ["SOLVEIG HANSEN", "SOLVEIG"], "gender": "f", "first": 7, "spoke": 2}, {"id": 4, "name": "TAVITA FUIMAONO", "names": ["TAVITA FUIMAONO", "TAVITA"], "gender": "?", "first": 8, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. LIFE RAFT - OPEN OCEAN - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "A yellow canopy raft rides a glassy swell under a pink sky.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Gulls circle far off.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The water is flat as a plate.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "AMARA OKONJO, 40s, the captain, sits at the opening with a signal mirror in her lap, still in her torn oilskin.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "JIN PARK-LEE, 20s, a deckhand, bails with a cup.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "BENEDICT AINSWORTH, 60s, the passenger, in a soaked tuxedo jacket, sleeps with his mouth open.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "SOLVEIG HANSEN, 30s, the cook, counts biscuits into piles of five.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "TAVITA FUIMAONO, 30s, the engineer, stares at the horizon with a thousand-yard look.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "Calm.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "The first calm in six days.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Rations?", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Two days. Three if we skip tonight.", "name": "SOLVEIG", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Is it breakfast?", "name": "BENEDICT", "speaker": 2, "ext": [], "paren": ["waking"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "It's Tuesday.", "name": "JIN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "It's quiet.", "name": "TAVITA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Quiet's good.", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "No. Listen.", "name": "TAVITA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "They listen.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "A faint drone, like a bee in the next room.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Jin's cup stops.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Amara lifts the mirror, flashes it at the sun.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Solveig stands, rocking the raft, and shades her eyes.", "para": 3, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Benedict sits up.", "para": 3, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Tavita rises on one knee, mouth open.", "para": 3, "sent": 6, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "A white speck.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Growing.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Plane?", "name": "SOLVEIG", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Drone.", "name": "TAVITA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Whose?", "name": "AMARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "The speck banks, circles above the raft, and drops a small orange canister that splashes ten feet off.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Jin dives.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Surfaces with it.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Pops the lid.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Inside: a satellite phone and a note.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "\"Do not signal the cargo ship. They are not coming to rescue you.\"", "name": "JIN", "speaker": 1, "ext": [], "paren": ["reading"], "dual": false, "present": [0, 1, 2, 3, 4]}]}