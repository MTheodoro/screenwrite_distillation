{"scene_id": "s02502", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02502.fountain", "heading": "EXT. GLACIER - CREVASSE LIP - DAY", "cast": [{"id": 0, "name": "LEILANI KEAWE", "names": ["LEILANI KEAWE", "LEILANI"], "gender": "?", "first": 4, "spoke": 8}, {"id": 1, "name": "CORMAC BRANNIGAN", "names": ["CORMAC BRANNIGAN", "CORMAC"], "gender": "?", "first": 5, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. GLACIER - CREVASSE LIP - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Wind.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Blue ice.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Two climbers roped together on a slope that ends in air.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LEILANI KEAWE, 30s, hauling on a rope, braced against an axe.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "CORMAC BRANNIGAN, 40s, dangling thirty feet below in a harness, face white.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Hold on!", "name": "LEILANI", "speaker": 0, "ext": [], "paren": ["shouting down"], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "I'm holding!", "name": "CORMAC", "speaker": 1, "ext": [], "paren": ["shouting up"], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Come on, come on, come on.", "name": "LEILANI", "speaker": 0, "ext": [], "paren": ["to both of them"], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "The rope creaks.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Ice crumbles.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She grunts.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Digs in.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Don't look down. Don't look down.", "name": "LEILANI", "speaker": 0, "ext": ["CONT'D"], "paren": ["to herself"], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Leilani! My leg!", "name": "CORMAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "What about it?", "name": "LEILANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "It's gone numb!", "name": "CORMAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Of course it is.", "name": "LEILANI", "speaker": 0, "ext": [], "paren": ["to the ice"], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She heaves.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He rises a foot.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "The axe slips.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She jams it deeper.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Kick the wall! Find a hold!", "name": "LEILANI", "speaker": 0, "ext": ["CONT'D"], "paren": ["to Cormac"], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "I can't feel anything!", "name": "CORMAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Please.", "name": "LEILANI", "speaker": 0, "ext": [], "paren": ["to the sky"], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Cormac swings.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Boots scrape ice.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "A foothold.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "He steadies.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "I've got something!", "name": "CORMAC", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Then climb!", "name": "LEILANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}