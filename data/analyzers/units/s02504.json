{"scene_id": "s02504", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02504.fountain", "heading": "INT. CONVERTED CHURCH - \"SYNERGY HUB\" - DAY", "cast": [{"id": 0, "name": "PENELOPE DRAKE-OYELARIN", "names": ["PENELOPE DRAKE-OYELARIN", "PENELOPE"], "gender": "f", "first": 4, "spoke": 9}, {"id": 1, "name": "LIONEL GRAVES", "names": ["LIONEL GRAVES", "LIONEL"], "gender": "m", "first": 5, "spoke": 3}, {"id": 2, "name": "RAMONA TSAI", "names": ["RAMONA TSAI", "RAMONA"], "gender": "f", "first": 6, "spoke": 3}, {"id": 3, "name": "TREVOR ASHBY-NKEMELU", "names": ["TREVOR ASHBY-NKEMELU", "TREVOR"], "gender": "?", "first": 45, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. CONVERTED CHURCH - \"SYNERGY HUB\" - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Pews turned into desks.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A stained-glass window glows behind a standing whiteboard.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A banner: WE ARE FAMILY.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "PENELOPE DRAKE-OYELARIN, 40s, HR lead, headset mic, claps for attention.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "LIONEL GRAVES, 50s, sales, sits slumped in a pew with a latte.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "RAMONA TSAI, 30s, engineer, stares at the ceiling.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "She rubs her hands together.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Beams.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Okay, team. Icebreaker. Share one word that describes your week.", "name": "PENELOPE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Lionel sips.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Ramona stares.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Don't be shy.", "name": "PENELOPE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Soggy.", "name": "LIONEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Love that. Ramona?", "name": "PENELOPE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Fine.", "name": "RAMONA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Fine is a feeling!", "name": "PENELOPE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Ramona lifts her eyebrows at the ceiling.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Doesn't answer.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "She writes SOGGY on the whiteboard.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Underlines it twice.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Caps the marker.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "It squeaks.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Now, trust fall.", "name": "PENELOPE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "No.", "name": "LIONEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "It's a bonding exercise.", "name": "PENELOPE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "I have a back.", "name": "LIONEL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "She ignores him.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Pulls Ramona to the altar step.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Ramona goes stiff.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Penelope turns her around, steps back, and spreads her arms.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Whenever you're ready.", "name": "PENELOPE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Ramona does not fall.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "She turns, looks at Penelope, then at the whiteboard, then at the window, and takes a long breath.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "I quit.", "name": "RAMONA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Lionel chokes on his latte.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Penelope's smile locks.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "That's not a word that describes your week.", "name": "PENELOPE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "It is today.", "name": "RAMONA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "She walks down the nave.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Her heels echo.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Penelope scrambles after her.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Lionel lowers his cup.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "The main doors bang open.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "A shaft of daylight cuts the room.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "TREVOR ASHBY-NKEMELU, 60s, CEO, in a three-piece suit and a clerical collar for no clear reason, strides in with an iPad.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Who's quitting?", "name": "TREVOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Silence.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Ramona stops in the aisle.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Penelope stops behind her.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Lionel slowly raises his hand.", "para": 12, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Splendid. Lionel, my office. Ramona, my office. Penelope, a word.", "name": "TREVOR", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "He claps once and walks to the pulpit.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "I did the trust fall.", "name": "PENELOPE", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Trevor taps the iPad.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "His face hardens.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Ramona smirks.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Lionel gets up and walks, slowly, to the door.", "para": 14, "sent": 3, "present": [0, 1, 2, 3]}]}