{"scene_id": "s02505", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02505.fountain", "heading": "INT. ABANDONED FAIRGROUND - CAROUSEL PAVILION - NIGHT", "cast": [{"id": 0, "name": "NELL BRANNOCK", "names": ["NELL BRANNOCK", "NELL"], "gender": "m", "first": 5, "spoke": 4}, {"id": 1, "name": "ARCHIE DOYLE", "names": ["ARCHIE DOYLE", "ARCHIE"], "gender": "m", "first": 6, "spoke": 5}, {"id": 2, "name": "TOMOKO HAYASHI", "names": ["TOMOKO HAYASHI", "TOMOKO"], "gender": "?", "first": 7, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. ABANDONED FAIRGROUND - CAROUSEL PAVILION - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A wrought-iron roof over a silent carousel.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Painted horses frozen mid-gallop, lacquer cracked, glass eyes dull.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Leaves on the platform.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A work lamp throws long shadows.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "NELL BRANNOCK, 30s, restorer, overalls, kneels with a screwdriver at the central pole.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "ARCHIE DOYLE, 60s, the caretaker, stands at the edge of the platform with a torch, jingling keys.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "TOMOKO HAYASHI, 20s, an assistant, kneels by a toolbox, unscrewing a horse's saddle.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Nell works.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "The pole creaks.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Archie steps back.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He keeps one hand on the iron post.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Done soon.", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Take your time.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "It's three a.m.", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "I'm used to it.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Tomoko holds up a brass plate from inside the saddle.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Reads it.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "\"For Margaret, who loved the white horse.\"", "name": "TOMOKO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Who's Margaret?", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Archie says nothing.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Looks at the lamp.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "There's a date. Nineteen fifty-nine.", "name": "TOMOKO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Put it back.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": ["too fast"], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Why?", "name": "TOMOKO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "It's not ours.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Nell glances at him.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Her screwdriver stops.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Overhead, an iron beam ticks.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Tomoko slides the plate back and closes the saddle.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Her hands shake.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The carousel moves.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "A quarter turn.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "The horses lurch one step, then stop.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Nobody has touched it.", "para": 6, "sent": 3, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Nell stands, very slowly.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Archie. Is there power to this?", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Disconnected in sixty-one.", "name": "ARCHIE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "The platform shifts again.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "A calliope note, thin and wrong, from somewhere far inside the machine.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Tomoko backs toward the exit.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Archie drops his keys.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "They ring on the iron.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "The white horse turns its head.", "para": 10, "sent": 0, "present": [0, 1, 2]}]}