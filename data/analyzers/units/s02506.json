{"scene_id": "s02506", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02506.fountain", "heading": "INT. SURVEILLANCE VAN - NIGHT", "cast": [{"id": 0, "name": "COLM BRADSHAW", "names": ["COLM BRADSHAW", "COLM"], "gender": "?", "first": 6, "spoke": 21}, {"id": 1, "name": "OFFICER JUNE ALVAREZ-PARK", "names": ["OFFICER JUNE ALVAREZ-PARK", "JUNE"], "gender": "f", "first": 7, "spoke": 13}, {"id": 2, "name": "WOMAN", "names": ["WOMAN"], "gender": "?", "first": 33, "spoke": 7}, {"id": 3, "name": "FELICITY", "names": ["FELICITY"], "gender": "?", "first": 53, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. SURVEILLANCE VAN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cramped.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Monitors.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Cold coffee in paper cups.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A rain-streaked windshield looks out on a street of shuttered shops.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Across the road, a dry cleaner's sign glows pink: DAN'S EXPRESS.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "DET. COLM BRADSHAW, 50s, rumpled coat, eats a gas-station sandwich.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "OFFICER JUNE ALVAREZ-PARK, 20s, headphones around her neck, monitors a camera feed.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Anything?", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "A cat.", "name": "JUNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "That counts?", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "It's more than we had at midnight.", "name": "JUNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He chews.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Looks at the clock.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "2:07.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "You eaten?", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Granola bar.", "name": "JUNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "That's not eating.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "It's got nuts.", "name": "JUNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Fair.", "name": "COLM", "speaker": 0, "ext": [], "paren": ["shrugging"], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Rain on the roof.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Does it always take this long?", "name": "JUNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Always.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "How do you not go crazy?", "name": "JUNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I do. Slowly. Over thirty years.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "She laughs.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "He sips cold coffee.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Winces.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "A knock on the side window.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Both freeze.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "June drops a hand to her holster.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Colm slides the window open an inch.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "A WOMAN, 40s, umbrella, rain jacket, stands there holding a plastic bag.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Excuse me. Is this your van?", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Can I help you, ma'am?", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "It's been parked here three nights. My husband says it's a stakeout.", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "June stares at Colm.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Colm stares at the Woman.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "We're from the gas company.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "At two in the morning?", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Emergency leak.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Smells fine to me.", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "That's the problem.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "She lifts the bag.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "I brought you sandwiches.", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "June blinks.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Sandwiches?", "name": "JUNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Egg salad. You looked hungry.", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Colm takes the bag.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Peers in.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Two wrapped sandwiches, a thermos.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Thank you.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "I'm Felicity. I run the florist next door.", "name": "WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "dialogue", "text": "Colm.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Is it going to be a long night, Colm?", "name": "FELICITY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Could be.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "Then I'll bring tea at four.", "name": "FELICITY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "She turns.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "Walks off, umbrella bobbing, and disappears into the rain.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "June looks at the sandwiches.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "She made us.", "name": "JUNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "Of course she did. It's a florist.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "Do we move the van?", "name": "JUNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "No.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "Why not?", "name": "JUNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "Because she's bringing tea.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "June laughs.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "Unwraps a sandwich.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "Takes a bite.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "Passes the other one to Colm.", "para": 13, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "On the monitor, a light goes on in the dry cleaner's back window.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "action", "text": "They both look up.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "action", "text": "The sandwich hovers.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "dialogue", "text": "Four a.m.", "name": "JUNE", "speaker": 1, "ext": [], "paren": ["sighing"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "dialogue", "text": "Four a.m.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "June eats.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "Colm adjusts the zoom.", "para": 15, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "action", "text": "Rain falls.", "para": 15, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "action", "text": "The sign glows.", "para": 15, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "action", "text": "Nothing happens.", "para": 15, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "dialogue", "text": "She's right about the smell, though.", "name": "JUNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "dialogue", "text": "What smell?", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "dialogue", "text": "Egg salad.", "name": "JUNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 84, "kind": "dialogue", "text": "It's a stakeout. Open a window.", "name": "COLM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 85, "kind": "action", "text": "She cracks the window.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 86, "kind": "action", "text": "Cold wet air fills the van.", "para": 16, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 87, "kind": "action", "text": "Colm shuts it.", "para": 16, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 88, "kind": "dialogue", "text": "Not that much.", "name": "COLM", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}