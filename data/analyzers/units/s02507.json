{"scene_id": "s02507", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02507.fountain", "heading": "EXT. DESERT RAIL HALT - TELEGRAPH OFFICE - LATE AFTERNOON", "cast": [{"id": 0, "name": "EZRA CALLOWAY", "names": ["EZRA CALLOWAY", "EZRA"], "gender": "m", "first": 9, "spoke": 17}, {"id": 1, "name": "MARISOL VEGA", "names": ["MARISOL VEGA", "MARISOL"], "gender": "f", "first": 10, "spoke": 16}, {"id": 2, "name": "HAWTHORNE", "names": ["HAWTHORNE"], "gender": "?", "first": 39, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DESERT RAIL HALT - TELEGRAPH OFFICE - LATE AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "A single wooden shack beside a single rail line, a thousand miles from anywhere.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The platform boards are bleached silver.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Sage grass trembles in a hot wind.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The horizon is a thin blade of light.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A windmill creaks over a stock tank.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "Inside the shack, a dusty window throws a bar of gold across a roll-top desk.", "para": 1, "sent": 0, "present": []}, {"u": 7, "kind": "action", "text": "A telegraph key sits at its centre like a small brass insect, silent.", "para": 1, "sent": 1, "present": []}, {"u": 8, "kind": "action", "text": "A clock ticks on the wall.", "para": 1, "sent": 2, "present": []}, {"u": 9, "kind": "action", "text": "EZRA CALLOWAY, 60s, stationmaster, sleeves held up by arm garters, sits with his boots on the desk reading a seed catalogue.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "MARISOL VEGA, 30s, a widow in a travelling dress the colour of dust, sits upright on the waiting bench with a carpetbag on her knees.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She has been there since morning.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "The clock ticks.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Ezra turns a page.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Marisol watches a fly crawl across the window.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Train's due at four.", "name": "EZRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "It's ten past.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "It'll come.", "name": "EZRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "You said that at noon.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "I did.", "name": "EZRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Another page.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "The fly lifts off, whirs, settles on the key.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "You headed far?", "name": "EZRA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Far enough.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "West?", "name": "EZRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "West.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "There's nothing west.", "name": "EZRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Then it'll be quiet.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Ezra smiles into his catalogue.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "She smoothes her skirt.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Her fingers find a small tin locket at her throat.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "She holds it, lets go.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "My wife used to say a person only goes west to forget.", "name": "EZRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Did she forget?", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "She went east.", "name": "EZRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "A faint sound.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "A rumble, far down the line, no louder than a stomach.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Ezra lowers his boots.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "Marisol stands.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Smoke on the horizon, Ezra!", "name": "HAWTHORNE", "speaker": 2, "ext": ["O.S."], "paren": ["calling from the platform"], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Ezra goes to the door.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Squints.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Comes back.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "That's her.", "name": "EZRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Is she on time?", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "An hour late.", "name": "EZRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Good.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Good?", "name": "EZRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "I wasn't ready.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "She picks up her bag.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Sets it down again.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Ezra looks at her.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "Sees her.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Doesn't say anything.", "para": 8, "sent": 4, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "The rumble grows.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "The rails begin to sing.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "The windmill turns faster.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "Through the window, a smudge of black smoke climbs the sky.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 58, "kind": "dialogue", "text": "Two minutes!", "name": "HAWTHORNE", "speaker": 2, "ext": ["O.S."], "paren": ["closer"], "dual": false, "present": [0, 1, 2]}, {"u": 59, "kind": "dialogue", "text": "You've got a ticket?", "name": "EZRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "Bought it in Fort Aurelius.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "West of here?", "name": "EZRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "East.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "Then you're going the wrong way.", "name": "EZRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 64, "kind": "dialogue", "text": "I know.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 65, "kind": "action", "text": "She smiles a small, tired smile.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 66, "kind": "action", "text": "Ezra nods.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 67, "kind": "action", "text": "Takes his hat from a peg.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 68, "kind": "action", "text": "He takes her carpetbag, without asking, and carries it to the door.", "para": 10, "sent": 3, "present": [0, 1, 2]}, {"u": 69, "kind": "dialogue", "text": "The platform's uneven. Mind the third board.", "name": "EZRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 70, "kind": "dialogue", "text": "Thank you, Mr. Calloway.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 71, "kind": "dialogue", "text": "Ezra.", "name": "EZRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 72, "kind": "dialogue", "text": "Ezra.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 73, "kind": "action", "text": "They step out into the light.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 74, "kind": "action", "text": "The rumble becomes a roar.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 75, "kind": "action", "text": "Wind pulls at Marisol's hair.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 76, "kind": "action", "text": "She holds the locket against her throat.", "para": 11, "sent": 3, "present": [0, 1, 2]}, {"u": 77, "kind": "dialogue", "text": "She's coming in hot!", "name": "HAWTHORNE", "speaker": 2, "ext": ["O.S."], "paren": ["shouting over the engine"], "dual": false, "present": [0, 1, 2]}, {"u": 78, "kind": "action", "text": "The locomotive thunders into frame, steam and iron and sun.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 79, "kind": "action", "text": "Ezra holds Marisol's bag out of the dust.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 80, "kind": "action", "text": "The brakes scream.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 81, "kind": "action", "text": "The train stops.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 82, "kind": "action", "text": "Silence, and the hiss of steam.", "para": 13, "sent": 2, "present": [0, 1, 2]}, {"u": 83, "kind": "action", "text": "Ezra hands up the bag.", "para": 13, "sent": 3, "present": [0, 1, 2]}, {"u": 84, "kind": "action", "text": "Marisol climbs the step, turns once.", "para": 13, "sent": 4, "present": [0, 1, 2]}, {"u": 85, "kind": "dialogue", "text": "Ezra.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 86, "kind": "dialogue", "text": "Ma'am.", "name": "EZRA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 87, "kind": "dialogue", "text": "Plant the tomatoes in May.", "name": "MARISOL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 88, "kind": "action", "text": "He touches his hat.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 89, "kind": "action", "text": "The conductor's whistle sounds.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 90, "kind": "action", "text": "The train begins to move.", "para": 14, "sent": 2, "present": [0, 1, 2]}, {"u": 91, "kind": "action", "text": "Ezra watches until it is a smudge again, then a line, then nothing.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 92, "kind": "action", "text": "He walks back into the office, sits, and takes up the seed catalogue.", "para": 15, "sent": 1, "present": [0, 1, 2]}, {"u": 93, "kind": "action", "text": "The key on the desk begins to chatter.", "para": 16, "sent": 0, "present": [0, 1, 2]}]}