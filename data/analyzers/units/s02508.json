{"scene_id": "s02508", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02508.fountain", "heading": "INT. FUNERAL HOME - KITCHEN - NIGHT", "cast": [{"id": 0, "name": "BRONAGH QUILTY", "names": ["BRONAGH QUILTY", "BRONAGH"], "gender": "?", "first": 4, "spoke": 10}, {"id": 1, "name": "EMEKA QUILTY", "names": ["EMEKA QUILTY", "EMEKA"], "gender": "?", "first": 4, "spoke": 9}, {"id": 2, "name": "CORDELIA QUILTY", "names": ["CORDELIA QUILTY", "CORDELIA"], "gender": "?", "first": 4, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. FUNERAL HOME - KITCHEN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Foil-covered casseroles.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wilting lilies.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A kettle starts to whistle.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "BRONAGH QUILTY, 50s, black dress, cuts a cake.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 5, "kind": "action", "text": "EMEKA QUILTY, 40s, her brother, loosens his tie.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "CORDELIA QUILTY, 30s, the youngest, sits on the counter with her shoes in her hand.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Somebody get that.", "name": "BRONAGH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "I've got it.", "name": "EMEKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "He's got it.", "name": "CORDELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Emeka snatches the kettle off the burner.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "The whistle dies.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Mind the cake.", "name": "BRONAGH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Nobody wants the cake.", "name": "CORDELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I want the cake.", "name": "EMEKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Nobody wants your cake, Emeka.", "name": "BRONAGH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Mam made that cake.", "name": "EMEKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Mam made that cake in nineteen ninety-four.", "name": "BRONAGH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "That's why it's hard.", "name": "CORDELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "It's tradition.", "name": "EMEKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "It's a doorstop.", "name": "BRONAGH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Emeka sets the kettle down.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Hard.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "She's been in the ground four hours.", "name": "EMEKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "I know.", "name": "BRONAGH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "You're slicing her cake like it's a bake sale.", "name": "EMEKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Somebody has to feed the neighbours.", "name": "BRONAGH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "You didn't have to put on the apron.", "name": "CORDELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "It's Mam's apron.", "name": "BRONAGH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "That's what I mean.", "name": "CORDELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Bronagh puts down the knife.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Silence.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "A fridge hums.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Emeka pulls out a chair.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Sits.", "para": 4, "sent": 4, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Puts his head in his hands.", "para": 4, "sent": 5, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "I never said goodbye.", "name": "EMEKA", "speaker": 1, "ext": [], "paren": ["muffled"], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "You said it on Tuesday.", "name": "CORDELIA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "She was asleep.", "name": "EMEKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "She heard you.", "name": "BRONAGH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "You don't know that.", "name": "EMEKA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "I know she squeezed my hand when I said your name.", "name": "BRONAGH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "He looks up.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "His eyes are red.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Cordelia slides off the counter.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Bronagh picks up the knife again, and cuts the cake, slowly, into three pieces.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "She puts one in front of each of them.", "para": 6, "sent": 0, "present": [0, 1, 2]}]}