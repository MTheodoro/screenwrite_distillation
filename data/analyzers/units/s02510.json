{"scene_id": "s02510", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02510.fountain", "heading": "INT. WESTBROOK HIGH - RADIO BOOTH - MORNING", "cast": [{"id": 0, "name": "ENID PAYNE-ORTEGA", "names": ["ENID PAYNE-ORTEGA", "ENID"], "gender": "f", "first": 4, "spoke": 14}, {"id": 1, "name": "MARCELO FIGUEIREDO", "names": ["MARCELO FIGUEIREDO", "MARCELO"], "gender": "f", "first": 5, "spoke": 15}, {"id": 2, "name": "PRINCIPAL KRISTENSEN", "names": ["PRINCIPAL KRISTENSEN"], "gender": "?", "first": 22, "spoke": 2}, {"id": 3, "name": "AIR", "names": ["AIR"], "gender": "?", "first": 3, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. WESTBROOK HIGH - RADIO BOOTH - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "A closet-sized booth.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Egg-crate foam on the walls, a mixing board, a dusty microphone.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A red ON AIR light glows.", "para": 0, "sent": 2, "present": [3]}, {"u": 4, "kind": "action", "text": "ENID PAYNE-ORTEGA, 17, headphones, ink on her fingers, sits at the mixer.", "para": 1, "sent": 0, "present": [0, 3]}, {"u": 5, "kind": "action", "text": "MARCELO FIGUEIREDO, 16, her co-host, drums a pencil on the desk and fidgets with a stack of index cards.", "para": 1, "sent": 1, "present": [0, 1, 3]}, {"u": 6, "kind": "action", "text": "Through the glass, the empty hallway.", "para": 1, "sent": 2, "present": [0, 1, 3]}, {"u": 7, "kind": "dialogue", "text": "Good morning, Westbrook. It's seven forty-five on a rainy Thursday.", "name": "ENID", "speaker": 0, "ext": [], "paren": ["into the mic"], "dual": false, "present": [0, 1, 3]}, {"u": 8, "kind": "dialogue", "text": "And you're listening to the Morning Grind.", "name": "MARCELO", "speaker": 1, "ext": [], "paren": ["into the mic"], "dual": false, "present": [0, 1, 3]}, {"u": 9, "kind": "dialogue", "text": "Today's news: the cafeteria has run out of tater tots.", "name": "ENID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 10, "kind": "dialogue", "text": "Riots are expected.", "name": "MARCELO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 11, "kind": "dialogue", "text": "Also, announcements.", "name": "ENID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 12, "kind": "action", "text": "She slides a card across.", "para": 2, "sent": 0, "present": [0, 1, 3]}, {"u": 13, "kind": "action", "text": "Marcelo reads it with his eyes, then, to her horror, stops mid-line.", "para": 2, "sent": 1, "present": [0, 1, 3]}, {"u": 14, "kind": "dialogue", "text": "Uh. The card says the prom committee needs volunteers.", "name": "MARCELO", "speaker": 1, "ext": [], "paren": ["into the mic"], "dual": false, "present": [0, 1, 3]}, {"u": 15, "kind": "dialogue", "text": "That's not what the card says.", "name": "ENID", "speaker": 0, "ext": [], "paren": ["low, off-mic"], "dual": false, "present": [0, 1, 3]}, {"u": 16, "kind": "dialogue", "text": "It's the card I wrote.", "name": "MARCELO", "speaker": 1, "ext": [], "paren": ["off-mic"], "dual": false, "present": [0, 1, 3]}, {"u": 17, "kind": "action", "text": "She snatches it.", "para": 3, "sent": 0, "present": [0, 1, 3]}, {"u": 18, "kind": "action", "text": "Reads.", "para": 3, "sent": 1, "present": [0, 1, 3]}, {"u": 19, "kind": "action", "text": "Her face drops.", "para": 3, "sent": 2, "present": [0, 1, 3]}, {"u": 20, "kind": "dialogue", "text": "You rewrote the announcements?", "name": "ENID", "speaker": 0, "ext": [], "paren": ["off-mic"], "dual": false, "present": [0, 1, 3]}, {"u": 21, "kind": "dialogue", "text": "I wanted it to be good.", "name": "MARCELO", "speaker": 1, "ext": [], "paren": ["off-mic"], "dual": false, "present": [0, 1, 3]}, {"u": 22, "kind": "dialogue", "text": "Miss Payne-Ortega. Mr. Figueiredo. My office.", "name": "PRINCIPAL KRISTENSEN", "speaker": 2, "ext": ["V.O."], "paren": ["through the PA, severe"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Enid hits the cough switch.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Marcelo flicks off the mic.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "The ON AIR light dies.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Did she hear that?", "name": "ENID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Everyone heard that.", "name": "MARCELO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Why would you do this?", "name": "ENID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Because you wouldn't. You've been writing these cards for two years and you never once said anything real.", "name": "MARCELO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "That's the job!", "name": "ENID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "It's the job for a person who is scared.", "name": "MARCELO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Don't.", "name": "ENID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "You asked.", "name": "MARCELO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "I didn't ask.", "name": "ENID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "You did, with your eyes. Every morning.", "name": "MARCELO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Enid rips off her headphones.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Throws them.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "They hit the foam and slide down the wall.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Marcelo flinches.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Her chest heaves.", "para": 5, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Read the card again.", "name": "ENID", "speaker": 0, "ext": [], "paren": ["very quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "It says \"Enid, will you go to prom with me.\"", "name": "MARCELO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "In front of the entire school.", "name": "ENID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "It was only the on-air light.", "name": "MARCELO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "It was ON.", "name": "ENID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "No. The cough switch was ON. I checked.", "name": "MARCELO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "She looks at the board.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "He is right.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "The red light is dark.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "She sits down on the edge of the desk, stunned.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "You're an idiot.", "name": "ENID", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Yes.", "name": "MARCELO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "She laughs.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Covers her face.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "He waits, card in hand, trembling.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Is somebody going to answer me?", "name": "PRINCIPAL KRISTENSEN", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Marcelo looks at Enid.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "She gives the smallest nod.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "He leans over and presses the intercom.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "Yes, ma'am. Yes. We're coming.", "name": "MARCELO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}