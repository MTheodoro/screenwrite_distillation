{"scene_id": "s02511", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02511.fountain", "heading": "INT. SKI PATROL HUT - SUMMIT - NIGHT", "cast": [{"id": 0, "name": "THORVALD EKLUND", "names": ["THORVALD EKLUND", "THORVALD"], "gender": "m", "first": 6, "spoke": 5}, {"id": 1, "name": "ELOISE MAKINDE", "names": ["ELOISE MAKINDE", "ELOISE"], "gender": "?", "first": 7, "spoke": 6}, {"id": 2, "name": "KAMAU NJOROGE", "names": ["KAMAU NJOROGE", "KAMAU"], "gender": "?", "first": 8, "spoke": 3}, {"id": 3, "name": "ISADORA VANCE", "names": ["ISADORA VANCE", "ISADORA"], "gender": "f", "first": 9, "spoke": 9}, {"id": 4, "name": "NANDI", "names": ["NANDI"], "gender": "?", "first": 24, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. SKI PATROL HUT - SUMMIT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A cedar-lined cabin clinging to a ridge.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Frost patterns bloom on the windows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A woodstove glows orange.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Skis in racks, avalanche probes in a barrel, a first-aid sled by the door.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Wind presses against the walls.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "THORVALD EKLUND, 50s, patrol chief, weathered, beard crusted with ice, pours coffee at the stove.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "ELOISE MAKINDE, 30s, a doctor in a red jacket, adjusts a radio.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "KAMAU NJOROGE, 20s, rookie patroller, laces a boot.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "ISADORA VANCE, 40s, a guest in a designer parka, sits by the stove with a thermos, her gloves still on.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "The mood is warm.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Sleepy.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "A deck of cards lies half-dealt on the table.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Last run's clear. We close at ten.", "name": "THORVALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Big storm tomorrow?", "name": "KAMAU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Big one.", "name": "THORVALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "I can't believe you let me stay. I'm grateful.", "name": "ISADORA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "You were stuck.", "name": "ELOISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "I was lost.", "name": "ISADORA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "You were on the wrong side of the ridge.", "name": "KAMAU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Somebody put the sign in the wrong place.", "name": "ISADORA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Nobody touched the sign.", "name": "THORVALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Then it fell.", "name": "ISADORA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "The radio crackles.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Base to summit. Come in, summit.", "name": "NANDI", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Eloise lifts the handset.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Summit.", "name": "ELOISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Doctor, I need a headcount.", "name": "NANDI", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Four in the hut. Thorvald, me, Kamau, and a guest.", "name": "ELOISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "A guest?", "name": "NANDI", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Lost skier. Isadora Vance.", "name": "ELOISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Silence on the line.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Static.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "The stove ticks.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Thorvald sets down his coffee.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Doctor. The only Isadora Vance on the lift manifest checked out at noon.", "name": "NANDI", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Say again?", "name": "ELOISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "She went down at noon. She's in the bar.", "name": "NANDI", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Isadora's smile doesn't change.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "The thermos in her lap clicks as she turns the lid.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Maybe there's two.", "name": "KAMAU", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "There's not two.", "name": "THORVALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "There is, actually.", "name": "ISADORA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "She stands.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Her glove slips.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Beneath it: a wrist wrapped in a hospital bracelet, the name blacked out.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "I'd hoped to rest longer.", "name": "ISADORA", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "Who are you?", "name": "ELOISE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "The woman who didn't make it down.", "name": "ISADORA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Thorvald draws the avalanche probe from the barrel.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Kamau backs against the wall.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Eloise drops the handset.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "It swings on its cord.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "Thorvald. Eleven years ago. The east chute.", "name": "ISADORA", "speaker": 3, "ext": ["CONT'D"], "paren": ["gentle"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "His knuckles go white on the probe.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "You were dead.", "name": "THORVALD", "speaker": 0, "ext": [], "paren": ["hoarse"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "And you were the one who dug.", "name": "ISADORA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "The wind drops.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "The stove goes out.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}]}