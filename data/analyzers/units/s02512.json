{"scene_id": "s02512", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02512.fountain", "heading": "EXT. DRIVING TEST CENTRE - SNOWY PARKING LOT - DAY", "cast": [{"id": 0, "name": "MILLICENT OYELOWO-FARR", "names": ["MILLICENT OYELOWO-FARR", "MILLICENT"], "gender": "?", "first": 4, "spoke": 12}, {"id": 1, "name": "EXAMINER", "names": ["EXAMINER"], "gender": "?", "first": 5, "spoke": 8}, {"id": 2, "name": "BOGDAN", "names": ["BOGDAN"], "gender": "m", "first": 34, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DRIVING TEST CENTRE - SNOWY PARKING LOT - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Flurries.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A small hatchback idles at a cone.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The wipers beat.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MILLICENT OYELOWO-FARR, 17, white-knuckled at the wheel.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "In the passenger seat, an EXAMINER, 50s, thick coat, clipboard, a face that gave up expecting surprises.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Signal left.", "name": "EXAMINER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Left.", "name": "MILLICENT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She flips the signal.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Wrong direction.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Your other left.", "name": "EXAMINER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She switches.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "The car creeps forward.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Slower.", "name": "EXAMINER", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "I'm barely moving.", "name": "MILLICENT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Slower than barely.", "name": "EXAMINER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "The car rolls three feet and stops.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Done.", "name": "MILLICENT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "That's the parking lot.", "name": "EXAMINER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "I know.", "name": "MILLICENT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "The Examiner writes something.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She watches the pen.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "What are you writing?", "name": "MILLICENT", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Weather observations.", "name": "EXAMINER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Is that on the form?", "name": "MILLICENT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "It's on my form.", "name": "EXAMINER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "She exhales.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "The wipers beat.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Snow collects on the glass.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "What's your name?", "name": "MILLICENT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "It's on the badge.", "name": "EXAMINER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "It's turned around.", "name": "MILLICENT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "He looks down.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Flips the badge.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Bogdan.", "name": "BOGDAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Bogdan. I'm Millicent.", "name": "MILLICENT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "I know. It's on my form.", "name": "BOGDAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Did I pass?", "name": "MILLICENT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "You parked.", "name": "BOGDAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Is that a yes?", "name": "MILLICENT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "It's a yes if you shut off the engine.", "name": "BOGDAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "She reaches for the key.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Hesitates.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Can I just sit here a minute?", "name": "MILLICENT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Bogdan puts his clipboard on the dashboard.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Leans back.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Take your time. It's snowing.", "name": "BOGDAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}