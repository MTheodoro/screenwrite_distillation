{"scene_id": "s02513", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02513.fountain", "heading": "INT. CALIFORNIA ZEPHYR - DINING CAR - NIGHT - 1953", "cast": [{"id": 0, "name": "LUCILLE MERCER", "names": ["LUCILLE MERCER", "LUCILLE"], "gender": "f", "first": 4, "spoke": 11}, {"id": 1, "name": "HENRY BOYLAN", "names": ["HENRY BOYLAN", "HENRY"], "gender": "m", "first": 5, "spoke": 8}, {"id": 2, "name": "WAITER", "names": ["WAITER"], "gender": "?", "first": 6, "spoke": 0}, {"id": 3, "name": "ARMAND", "names": ["ARMAND"], "gender": "?", "first": 6, "spoke": 5}, {"id": 4, "name": "BELINDA CROSS", "names": ["BELINDA CROSS", "BELINDA"], "gender": "f", "first": 7, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. CALIFORNIA ZEPHYR - DINING CAR - NIGHT - 1953", "present": []}, {"u": 1, "kind": "action", "text": "White linen, silver, a vase with a single carnation on each table.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The window shows a dark prairie slipping by under a quarter moon.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A pianist in the corner plays something soft.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "LUCILLE MERCER, 30s, in an emerald dress and long gloves, sits alone at a table for two, a cocktail untouched at her elbow.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across the aisle, HENRY BOYLAN, 30s, in a grey suit with a loosened tie, reads a menu he is not seeing.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "A WAITER named ARMAND, 50s, white jacket, pencil behind his ear, hovers between them.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "At the far table, BELINDA CROSS, 30s, in sapphire, sips champagne and watches them both over the rim of her glass.", "para": 1, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 8, "kind": "action", "text": "Calm.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "Murmurs.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "The clink of cutlery.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Your companion has not arrived, madam?", "name": "ARMAND", "speaker": 3, "ext": [], "paren": ["to Lucille"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "He's late.", "name": "LUCILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Shall I bring the soup?", "name": "ARMAND", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "In a moment, Armand.", "name": "LUCILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Henry glances up.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Lucille's eyes meet his across the aisle.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "He looks away.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "And you, sir? The sole?", "name": "ARMAND", "speaker": 3, "ext": ["CONT'D"], "paren": ["to Henry"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Please.", "name": "HENRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Henry.", "name": "LUCILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Henry lowers the menu.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Lucille.", "name": "HENRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "I didn't think you'd come.", "name": "LUCILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "I didn't think you'd come.", "name": "HENRY", "speaker": 1, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "They stop.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Lucille laughs, a small helpless sound.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Henry shakes his head and gets up.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "He crosses the aisle, steadies himself against the lurch of the train, and sits opposite her.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Belinda lowers her glass.", "para": 5, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Armand discreetly withdraws a step and examines the carnation.", "para": 5, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "You look well.", "name": "LUCILLE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "You look better.", "name": "HENRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Armand, a second place, please.", "name": "LUCILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Of course, madam.", "name": "ARMAND", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Henry lifts her cocktail, sniffs it, grimaces, and sets it down.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Still gin and nothing.", "name": "HENRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Still a coward.", "name": "LUCILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Still right.", "name": "HENRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Belinda rises.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Smooths her gown.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Crosses to their table with a smile that doesn't reach her eyes.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Henry, darling. You promised me the first dance.", "name": "BELINDA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Lucille's gloved hand closes on the stem of her glass.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Belinda. This is Lucille.", "name": "HENRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Of course it is.", "name": "BELINDA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "We've met.", "name": "LUCILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "In Chicago. At the hospital benefit.", "name": "BELINDA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "You wore sapphire then, too.", "name": "LUCILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "It suits me.", "name": "BELINDA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Henry stands.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "He moves between them as the train lurches into a curve, and the carnation vase slides off the table and shatters.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "dialogue", "text": "I shall fetch a broom.", "name": "ARMAND", "speaker": 3, "ext": [], "paren": ["from a distance"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Henry looks at the broken glass.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "Then at Lucille, and Belinda, and the carnation on the floor.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "I should have written.", "name": "HENRY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "You should have.", "name": "LUCILLE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "He has been writing me for a year.", "name": "BELINDA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Lucille slowly turns her head.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "Belinda is smiling now, genuinely, as though she has been waiting for this moment since Chicago.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "Henry. Is that true?", "name": "LUCILLE", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "Henry opens his mouth.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "The train whistle shrieks.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "The pianist, at last, stops playing.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}]}