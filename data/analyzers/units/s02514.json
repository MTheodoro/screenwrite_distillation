{"scene_id": "s02514", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02514.fountain", "heading": "INT. 24-HOUR LAUNDROMAT - NIGHT", "cast": [{"id": 0, "name": "GIRL", "names": ["GIRL"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "TALL MAN", "names": ["TALL MAN"], "gender": "?", "first": 6, "spoke": 6}, {"id": 2, "name": "FELIX", "names": ["FELIX"], "gender": "?", "first": 25, "spoke": 3}, {"id": 3, "name": "WYNONA", "names": ["WYNONA"], "gender": "?", "first": 26, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. 24-HOUR LAUNDROMAT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent hum.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A row of dryers turning.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Orange plastic chairs bolted to the floor.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A GIRL, 20s, hoodie, headphones, sits on top of a washing machine with a paperback.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She doesn't look up.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "A TALL MAN, 30s, rumpled, enters with a pillowcase of clothes.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He scans the machines.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Only one is free: the one under her.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Is that one taken?", "name": "TALL MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "You're welcome to it.", "name": "GIRL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "You're sitting on it.", "name": "TALL MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "It's running.", "name": "GIRL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He studies the machine.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "It vibrates under her.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Is it?", "name": "TALL MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Spin cycle.", "name": "GIRL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He leans on the dryer next to her.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "She turns a page.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "Good book?", "name": "TALL MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "It's okay.", "name": "GIRL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "What's it about?", "name": "TALL MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "A man who talks to strangers in laundromats.", "name": "GIRL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "He laughs.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "She almost smiles.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I'm Felix.", "name": "TALL MAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Wynonona. Wynona.", "name": "GIRL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Which?", "name": "FELIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "The second one.", "name": "WYNONA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Nice to meet you, Wynona.", "name": "FELIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "She closes the book.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Slides off the machine.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "It shudders to a halt.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "All yours.", "name": "WYNONA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Thanks.", "name": "FELIX", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "He empties the pillowcase into the drum.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "A single sock falls to the floor.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "She hands it back.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}]}