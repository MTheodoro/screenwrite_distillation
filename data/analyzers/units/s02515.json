{"scene_id": "s02515", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02515.fountain", "heading": "INT. FIREHOUSE KITCHEN - NIGHT", "cast": [{"id": 0, "name": "CAPTAIN LORETTA BAXTER", "names": ["CAPTAIN LORETTA BAXTER", "LORETTA"], "gender": "?", "first": 5, "spoke": 5}, {"id": 1, "name": "DMITRI VOLKOV", "names": ["DMITRI VOLKOV", "DMITRI"], "gender": "?", "first": 6, "spoke": 1}, {"id": 2, "name": "FAYE MCALLISTER", "names": ["FAYE MCALLISTER", "FAYE"], "gender": "?", "first": 7, "spoke": 3}, {"id": 3, "name": "CASPIAN ROURKE", "names": ["CASPIAN ROURKE", "CASPIAN"], "gender": "m", "first": 8, "spoke": 1}, {"id": 4, "name": "YOLANDA DEVEREAUX", "names": ["YOLANDA DEVEREAUX"], "gender": "f", "first": 9, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. FIREHOUSE KITCHEN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A long steel table scarred by forty years of dinners.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Pots hang from a rack.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A framed photo of a fire engine hangs crooked over the stove.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The scanner on the shelf murmurs in a low, sleepy voice.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CAPTAIN LORETTA BAXTER, 50s, iron-grey crop, broad shoulders, stirs a pot of chili.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "DMITRI VOLKOV, 30s, firefighter, sits at the table in a station t-shirt, peeling an orange.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "FAYE MCALLISTER, 20s, the probie, mops the floor with great, nervous strokes.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "CASPIAN ROURKE, 40s, driver, slumps in a chair with his boots on the table.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "YOLANDA DEVEREAUX, 30s, EMT, cleans her glasses on the hem of her shirt.", "para": 1, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Chili in five.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "You said that an hour ago.", "name": "CASPIAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "It's been four minutes.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "She's right. I've been watching.", "name": "DMITRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Captain, I finished the floor.", "name": "FAYE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Do it again.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "But it's finished.", "name": "FAYE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Then do it better.", "name": "LORETTA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Faye looks at the mop.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "At Loretta.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Wrings it out.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Starts again.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "The scanner crackles.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "A tone.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "A flat dispatch voice reads out: Engine Six, structure fire, forty-one Maple.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Everyone stops.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Chairs scrape.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Dmitri drops the orange.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Caspian's boots hit the floor.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Yolanda shoves her glasses on.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Faye flings the mop and it clatters against the stove.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Loretta turns off the burner, and in one motion drags the pot to the back.", "para": 4, "sent": 5, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Rolling!", "name": "LORETTA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "They run, boots pounding, through the swinging door and into the bay.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "The kitchen empties.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "The pot ticks.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "The scanner murmurs on to nobody.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "A moment passes.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Then Faye reappears at the door, panting, mop in hand.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "She sees the empty room.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Sets down the mop gently, with the tenderness of a person who has run out of reasons to be afraid.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Bring them home.", "name": "FAYE", "speaker": 2, "ext": [], "paren": ["to the empty kitchen"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "She follows them out.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "The scanner crackles again.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "The chili simmers.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}]}