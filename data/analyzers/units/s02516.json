{"scene_id": "s02516", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02516.fountain", "heading": "INT. SKI-JUMP SAUNA - EVENING", "cast": [{"id": 0, "name": "SIGRID LAARSEN", "names": ["SIGRID LAARSEN", "SIGRID"], "gender": "f", "first": 4, "spoke": 4}, {"id": 1, "name": "ANTTI MAKELA", "names": ["ANTTI MAKELA"], "gender": "f", "first": 5, "spoke": 0}, {"id": 2, "name": "COACH VESA", "names": ["COACH VESA", "VESA"], "gender": "?", "first": 6, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. SKI-JUMP SAUNA - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Cedar benches.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Steam.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A tiny window shows the great jump in the dusk, floodlights burning.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "SIGRID LAARSEN, 20s, towel round her shoulders, sits hunched on the top bench.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "ANTTI MAKELA, 30s, sits beside her and doesn't talk.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "COACH VESA, 60s, pours water on the stones.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "The hiss fills the room.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Sigrid stares at her feet.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Fourth.", "name": "VESA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I know.", "name": "SIGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Fourth is a good place.", "name": "VESA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "It's not a medal.", "name": "SIGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "No.", "name": "VESA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Antti hands her a water bottle.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "She doesn't take it.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "He sets it on the bench between them.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I was ten metres short.", "name": "SIGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Wind.", "name": "VESA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "No.", "name": "SIGRID", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Vesa ladles another scoop.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "The steam rolls over them.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Nobody speaks.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Outside, the floodlights flick off one by one.", "para": 4, "sent": 3, "present": [0, 1, 2]}]}