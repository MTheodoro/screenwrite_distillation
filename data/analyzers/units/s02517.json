{"scene_id": "s02517", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02517.fountain", "heading": "INT. DAGUERREOTYPE STUDIO - DAY - 1843", "cast": [{"id": 0, "name": "ELIJAH THORNBURY", "names": ["ELIJAH THORNBURY", "ELIJAH"], "gender": "?", "first": 6, "spoke": 10}, {"id": 1, "name": "MISS CORNELIA PEMBERLEY", "names": ["MISS CORNELIA PEMBERLEY", "CORNELIA"], "gender": "m", "first": 7, "spoke": 8}], "units": [{"u": 0, "kind": "heading", "text": "INT. DAGUERREOTYPE STUDIO - DAY - 1843", "present": []}, {"u": 1, "kind": "action", "text": "A top-floor room in Boston.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Skylight, white drapes, a posing chair with a headrest clamp.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A wooden camera on a tripod.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Silver plates in a rack.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The smell of mercury and iodine.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "ELIJAH THORNBURY, 40s, in a stained frock coat, adjusts the camera with practiced fingers.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "MISS CORNELIA PEMBERLEY, 30s, in a black mourning dress and bonnet, stands in the doorway holding a small wrapped bundle.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Come in, miss.", "name": "ELIJAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Thank you.", "name": "CORNELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "You are the lady who wrote.", "name": "ELIJAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I am.", "name": "CORNELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "You said it was a portrait of a child.", "name": "ELIJAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She enters.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Her step is careful.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "She sets the bundle on the table beside the plates, and unfolds the cloth.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "A small girl, five years old, in a white christening gown, asleep.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Elijah goes quiet.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He wipes his hands on his coat.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "When?", "name": "ELIJAH", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Sunday.", "name": "CORNELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "I am sorry.", "name": "ELIJAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "She never had a likeness made. I thought, if I could just. If you could.", "name": "CORNELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "I have done it before. It is not an easy thing.", "name": "ELIJAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "I will pay double.", "name": "CORNELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Miss Pemberley. I will not take your money.", "name": "ELIJAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "She nods.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Her lips shake.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "She straightens the child's gown.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "Where shall I put her?", "name": "CORNELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Elijah brings the posing chair into the light.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "He tilts the headrest.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "He kneels, and with great delicacy folds the little hands across the gown.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Here. Where the sun can find her.", "name": "ELIJAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Cornelia stands beside him.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "He steps to the camera.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Slides in the plate.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "She watches him without breathing.", "para": 6, "sent": 3, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "You must be very still, Miss Pemberley.", "name": "ELIJAH", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "I will.", "name": "CORNELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Even your breath.", "name": "ELIJAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "I will not breathe.", "name": "CORNELIA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "He removes the lens cap.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "They hold, the three of them, in the white light.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "The seconds pass.", "para": 7, "sent": 2, "present": [0, 1]}]}