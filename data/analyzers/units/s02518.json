{"scene_id": "s02518", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02518.fountain", "heading": "EXT. RIVER BOATHOUSE - DAWN", "cast": [{"id": 0, "name": "COACH ARCHIBALD PELHAM-GREENE", "names": ["COACH ARCHIBALD PELHAM-GREENE", "ARCHIBALD"], "gender": "?", "first": 5, "spoke": 12}, {"id": 1, "name": "JASPER OKUMURA", "names": ["JASPER OKUMURA", "JASPER"], "gender": "m", "first": 6, "spoke": 3}, {"id": 2, "name": "DOLORES RIVAS", "names": ["DOLORES RIVAS", "DOLORES"], "gender": "f", "first": 7, "spoke": 4}, {"id": 3, "name": "ANSELM TREMAINE", "names": ["ANSELM TREMAINE", "ANSELM"], "gender": "m", "first": 8, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. RIVER BOATHOUSE - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Mist rising off a flat brown river.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Racing shells rest on racks like sleeping insects.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Dew on the dock boards.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single crow on a piling.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "COACH ARCHIBALD PELHAM-GREENE, 60s, tweed jacket and megaphone, stands at the end of the dock.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "JASPER OKUMURA, 20s, stroke, sits on the edge with his oar across his knees.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "DOLORES RIVAS, 20s, coxswain, tiny in an oversized windbreaker, studies a clipboard.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "ANSELM TREMAINE, 20s, bow, ties his shoes with great ceremony.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Eights in five.", "name": "ARCHIBALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "We're ready.", "name": "DOLORES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Are you?", "name": "ARCHIBALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Yes, Coach.", "name": "JASPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Anselm?", "name": "ARCHIBALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Yes, Coach.", "name": "ANSELM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "You look like a man tying his shoes.", "name": "ARCHIBALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "I am.", "name": "ANSELM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Tie them faster.", "name": "ARCHIBALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Anselm ties them slower.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Dolores stifles a laugh.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Regatta in nine days. Their stroke rate is thirty-eight.", "name": "ARCHIBALD", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Ours is thirty-six.", "name": "JASPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Ours is thirty-six and clean.", "name": "ARCHIBALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Clean wins.", "name": "JASPER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Clean wins eventually.", "name": "ARCHIBALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Dolores raises her hand.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Coach, can I say something?", "name": "DOLORES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "You may.", "name": "ARCHIBALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "I've been counting strokes since March.", "name": "DOLORES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "And?", "name": "ARCHIBALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "We're never as bad as we think we are.", "name": "DOLORES", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "A silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Archibald looks at the river.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "The crow flies off.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "That's the best thing anyone's said all season.", "name": "ARCHIBALD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "He raps the megaphone on the post.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Boat on the water.", "name": "ARCHIBALD", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "They stand.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Four people lift a shell with the unhurried care of men carrying a coffin.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Nobody speaks.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "The mist parts.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}]}