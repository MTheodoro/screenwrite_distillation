{"scene_id": "s02519", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s02519.fountain", "heading": "INT. BANKRUPT BAKERY - ARBITRATION - DAY", "cast": [{"id": 0, "name": "ARBITRATOR VASHTI NAKASHIMA-REID", "names": ["ARBITRATOR VASHTI NAKASHIMA-REID", "VASHTI"], "gender": "f", "first": 4, "spoke": 17}, {"id": 1, "name": "GWENDOLYN OKORO", "names": ["GWENDOLYN OKORO", "GWENDOLYN"], "gender": "f", "first": 6, "spoke": 13}], "units": [{"u": 0, "kind": "heading", "text": "INT. BANKRUPT BAKERY - ARBITRATION - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Empty display cases.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Flour dust on the floor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A single steel table in the middle of the shop, two chairs, a stack of papers.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ARBITRATOR VASHTI NAKASHIMA-REID, 50s, grey suit, tablet, sits at the head, scrolling.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She looks at her watch.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "dialogue", "text": "Ms. Okoro is late.", "name": "VASHTI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "She puts down the tablet.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Rests her hands.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "The shop is quiet.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "A ceiling fan turns very slowly.", "para": 2, "sent": 3, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "The bell above the door jangles.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "GWENDOLYN OKORO, 40s, the baker, apron over a black dress, flour on her shoes, hurries in with a banker's box.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She sets it on the table.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Her hands shake.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "I'm sorry. Traffic.", "name": "GWENDOLYN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "There is no traffic.", "name": "VASHTI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "There was a duck.", "name": "GWENDOLYN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "A duck.", "name": "VASHTI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "On the road. I stopped.", "name": "GWENDOLYN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Vashti stares.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Gwendolyn sits.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "She opens the box and removes a stack of ledgers.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Vashti watches her put them in order, one by one, with the care of a woman putting off a conversation.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Shall we begin?", "name": "VASHTI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Please.", "name": "GWENDOLYN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "You are claiming the landlord broke the lease when he padlocked the ovens.", "name": "VASHTI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Yes.", "name": "GWENDOLYN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "He claims you were four months in arrears.", "name": "VASHTI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "I was three.", "name": "GWENDOLYN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "The records show four.", "name": "VASHTI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "The records are wrong.", "name": "GWENDOLYN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Can you prove it?", "name": "VASHTI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Gwendolyn lays a hand on the top ledger.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "She slides it across.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Vashti opens it, turns the pages, and reads.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Her finger traces a column.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Stops.", "para": 5, "sent": 4, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "This is dated March.", "name": "VASHTI", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "Yes.", "name": "GWENDOLYN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "It's a deposit. Three thousand.", "name": "VASHTI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "The landlord's own bank stamp.", "name": "GWENDOLYN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Vashti sets the ledger down.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Takes off her glasses.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "Ms. Okoro, why didn't you bring this at the preliminary?", "name": "VASHTI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Because I didn't know it was there.", "name": "GWENDOLYN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "I don't follow.", "name": "VASHTI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "My husband kept the books. He died in April. I found them last night.", "name": "GWENDOLYN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "Vashti is quiet.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "The fan turns.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "A tear rolls down Gwendolyn's cheek and falls on the ledger.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "She wipes it with her sleeve, ashamed.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "I'm sorry.", "name": "VASHTI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "It was a stupid, small thing. He never missed a deposit in thirty years.", "name": "GWENDOLYN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "dialogue", "text": "It's not small.", "name": "VASHTI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "She gets up.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "Walks to the glass case.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "Rests her palm on it, looking at the empty shelves.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "My mother had a bakery. In Osaka. When it closed she sat in the dark for a week.", "name": "VASHTI", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "What did she do after?", "name": "GWENDOLYN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "She opened another.", "name": "VASHTI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "Gwendolyn laughs through tears.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "Vashti returns to the table.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "Straightens the ledgers, and picks up her pen.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "I'm going to rule in your favour. Then I'm going to ask you what's on the menu.", "name": "VASHTI", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}]}