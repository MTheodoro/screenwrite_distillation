{"scene_id": "s05000", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05000.fountain", "heading": "INT. COMMUNITY GYM - EVENING", "cast": [{"id": 0, "name": "PRIYA OKAFOR", "names": ["PRIYA OKAFOR", "PRIYA"], "gender": "f", "first": 3, "spoke": 8}, {"id": 1, "name": "COACH TOBIAS REEVE", "names": ["COACH TOBIAS REEVE", "COACH REEVE"], "gender": "m", "first": 4, "spoke": 5}, {"id": 2, "name": "HOODIE GUY", "names": ["HOODIE GUY"], "gender": "?", "first": 5, "spoke": 1}, {"id": 3, "name": "DESMOND", "names": ["DESMOND"], "gender": "m", "first": 18, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. COMMUNITY GYM - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent hum.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A half-empty weight room.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "PRIYA OKAFOR, 17, wraps her hands at the mirror.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "COACH TOBIAS REEVE, 50s, stacks plates.", "para": 0, "sent": 3, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "In the corner, a HOODIE GUY sits on a bench, hood up, not lifting.", "para": 0, "sent": 4, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Ten minutes, people. Anyone who isn't warm in ten minutes is a spectator, and I don't coach spectators.", "name": "COACH REEVE", "speaker": 1, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "Nobody's here but us.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": ["under her breath"], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "She tightens the tape.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "The HOODIE GUY doesn't move.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Coach, who is that? He's been sitting there since I came in.", "name": "PRIYA", "speaker": 0, "ext": ["CONT'D"], "paren": ["to Reeve"], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Ask him.", "name": "COACH REEVE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "I'm asking you.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Then I'd say he's someone waiting for the right moment. Which, at his age, is the only kind of training that matters. You wait, you watch, you tell yourself you're not ready. And then one day the whole building is empty and you're still on the bench.", "name": "COACH REEVE", "speaker": 1, "ext": [], "paren": ["beat"], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "The front door SLAMS.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Priya flinches.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "The HOODIE GUY stands.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Priya. It's me.", "name": "HOODIE GUY", "speaker": 2, "ext": [], "paren": ["pushing back his hood"], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Desmond?", "name": "PRIYA", "speaker": 0, "ext": [], "paren": ["beat"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Two years, Pri. Two years and you didn't even look.", "name": "DESMOND", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "You told everyone you were moving. You told me you were done with all of this.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "I said a lot of things.", "name": "DESMOND", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "A phone BUZZES on the bench.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "He ignores it.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Does anyone else know about this? Coach? Because it feels like everyone knew but me.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": ["to the room, loud"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "I knew he'd come back. I didn't know when.", "name": "COACH REEVE", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Unbelievable.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Say it to me. Whatever it is. I'd rather you hit me than go quiet.", "name": "DESMOND", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "A weight plate RATTLES on its stand.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "I was going to hit you. I practiced it. Every night I stood in front of that mirror and I practiced what I'd do, and now you're standing here with your stupid hood and I just want to know if you ate.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": ["beat"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "I ate.", "name": "DESMOND", "speaker": 3, "ext": [], "paren": ["laughing, wet-eyed"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Right. Wraps on, both of you. Ten minutes.", "name": "COACH REEVE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Priya tosses Desmond a roll of tape.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "He catches it.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}]}