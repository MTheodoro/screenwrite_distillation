{"scene_id": "s05002", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05002.fountain", "heading": "INT. VILLAGE HALL - FUNERAL RECEPTION - AFTERNOON", "cast": [{"id": 0, "name": "WAITER", "names": ["WAITER"], "gender": "m", "first": 4, "spoke": 0}, {"id": 1, "name": "TEENAGERS", "names": ["TEENAGERS"], "gender": "?", "first": 5, "spoke": 0}, {"id": 2, "name": "HARRIET PEMBERTON", "names": ["HARRIET PEMBERTON", "HARRIET"], "gender": "f", "first": 7, "spoke": 11}, {"id": 3, "name": "GILES PEMBERTON", "names": ["GILES PEMBERTON", "GILES"], "gender": "m", "first": 8, "spoke": 7}, {"id": 4, "name": "THIN WOMAN", "names": ["THIN WOMAN", "WOMAN", "THE WOMAN"], "gender": "f", "first": 14, "spoke": 3}, {"id": 5, "name": "TEENAGER", "names": ["TEENAGER"], "gender": "?", "first": 25, "spoke": 0}, {"id": 6, "name": "NELL PEMBERTON", "names": ["NELL PEMBERTON", "NELL"], "gender": "f", "first": 28, "spoke": 3}, {"id": 7, "name": "MARGARET", "names": ["MARGARET"], "gender": "f", "first": 31, "spoke": 2}, {"id": 8, "name": "^NELL", "names": ["^NELL"], "gender": "?", "first": 40, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. VILLAGE HALL - FUNERAL RECEPTION - AFTERNOON", "present": []}, {"u": 1, "kind": "action", "text": "Rain on the tin roof.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Grey light through tall windows.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Trestle tables, sandwiches curling at the corners, an urn of tea gone lukewarm.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A WAITER circles with a tray of sherry.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Two TEENAGERS in borrowed black hover by the biscuits.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "A spaniel sleeps under a table.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "HARRIET PEMBERTON, 50s, pearls and a brittle smile, pours tea.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Her brother GILES PEMBERTON, 50s, tweed and tired, takes a cup.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Rather a good turnout, don't you think?", "name": "GILES", "speaker": 3, "ext": [], "paren": ["accepting the tea, not drinking it"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Rather. Considering Dad didn't speak to half of them.", "name": "HARRIET", "speaker": 2, "ext": [], "paren": ["straightening a doily"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Outside, the rain thickens.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "A gutter gurgles.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Whose dog is that?", "name": "GILES", "speaker": 3, "ext": [], "paren": ["glancing at the spaniel"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "The vicar's, I should think. Or nobody's.", "name": "HARRIET", "speaker": 2, "ext": [], "paren": ["shrugging"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "A THIN WOMAN in a dark mac stands by the door, dripping, a bag clutched to her chest.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "She looks at the room as one looks at a station timetable.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Do you know her?", "name": "GILES", "speaker": 3, "ext": [], "paren": ["low, to Harriet"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Wasn't she at the church? Back pew?", "name": "HARRIET", "speaker": 2, "ext": [], "paren": ["not looking"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Thunder, distant, politely.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "THE WOMAN crosses the room.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "She stops in front of Harriet.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "I'm sorry to intrude. I did think about not coming.", "name": "THE WOMAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Not at all. Do have a sandwich.", "name": "HARRIET", "speaker": 2, "ext": [], "paren": ["a small cold smile"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "That's kind.", "name": "THE WOMAN", "speaker": 4, "ext": [], "paren": ["taking one, holding it"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "A TEENAGER giggles.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "The other elbows him.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "The waiter passes with sherry; the woman declines.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "NELL PEMBERTON, 20s, Harriet's daughter, arrives with an umbrella, shaking it dry.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "Uncle G, the car park's flooded. Mum, who's this?", "name": "NELL", "speaker": 6, "ext": [], "paren": ["to Giles"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "We were just about to find out.", "name": "HARRIET", "speaker": 2, "ext": [], "paren": ["brightly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "dialogue", "text": "My name is Margaret Dunne. Your father and I were together for nineteen years.", "name": "THE WOMAN", "speaker": 4, "ext": [], "paren": ["setting the sandwich down"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 32, "kind": "action", "text": "Silence.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 33, "kind": "action", "text": "The urn ticks as it cools.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 34, "kind": "action", "text": "The spaniel sighs.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 35, "kind": "dialogue", "text": "I think there's been some mistake.", "name": "GILES", "speaker": 3, "ext": [], "paren": ["a little laugh that isn't one"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 36, "kind": "dialogue", "text": "Nineteen years. Dad was married to Mum for thirty-one.", "name": "HARRIET", "speaker": 2, "ext": [], "paren": ["very calm"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 37, "kind": "dialogue", "text": "Yes. That's rather the difficulty.", "name": "MARGARET", "speaker": 7, "ext": [], "paren": ["opening her bag"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 38, "kind": "dialogue", "text": "Harriet.", "name": "GILES", "speaker": 3, "ext": [], "paren": ["standing very still"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 39, "kind": "dialogue", "text": "Giles.", "name": "HARRIET", "speaker": 2, "ext": [], "paren": ["still pouring, tea overflowing the cup"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7]}, {"u": 40, "kind": "dialogue", "text": "Stop it, both of you, you're being appalling.", "name": "^NELL", "speaker": 8, "ext": [], "paren": ["stepping between them"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 41, "kind": "dialogue", "text": "Darling, go and find your cousins.", "name": "GILES", "speaker": 3, "ext": [], "paren": ["to Nell, gentle"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 42, "kind": "dialogue", "text": "No.", "name": "NELL", "speaker": 6, "ext": [], "paren": ["refusing"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 43, "kind": "action", "text": "Margaret takes out an envelope and holds it out.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 44, "kind": "action", "text": "Nobody takes it.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 45, "kind": "dialogue", "text": "He asked me to give this to you, Harriet. After. Not before. He was very specific.", "name": "MARGARET", "speaker": 7, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 46, "kind": "dialogue", "text": "That does sound like Dad.", "name": "HARRIET", "speaker": 2, "ext": [], "paren": ["finally setting the pot down"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 47, "kind": "action", "text": "She takes the envelope.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 48, "kind": "action", "text": "Turns it over.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 49, "kind": "action", "text": "Her thumb finds the seal.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 50, "kind": "dialogue", "text": "Giles, do be a love and see that Mrs Dunne has a proper cup of tea.", "name": "HARRIET", "speaker": 2, "ext": ["CONT'D"], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 51, "kind": "dialogue", "text": "Of course.", "name": "GILES", "speaker": 3, "ext": [], "paren": ["beat"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 52, "kind": "action", "text": "He pours.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 53, "kind": "action", "text": "His hands shake.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 54, "kind": "action", "text": "Rain on the roof, steady now.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 55, "kind": "dialogue", "text": "Nineteen years. And not one word.", "name": "HARRIET", "speaker": 2, "ext": [], "paren": ["opening the envelope"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 56, "kind": "action", "text": "She reads.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 57, "kind": "action", "text": "Her face doesn't change.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 58, "kind": "action", "text": "The teenagers have stopped giggling.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 59, "kind": "dialogue", "text": "Mum?", "name": "NELL", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 60, "kind": "dialogue", "text": "He's left her the house.", "name": "HARRIET", "speaker": 2, "ext": [], "paren": ["folding the page"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 61, "kind": "action", "text": "The spaniel lifts its head.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}, {"u": 62, "kind": "action", "text": "The waiter, discreetly, withdraws with his tray.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6, 7, 8]}]}