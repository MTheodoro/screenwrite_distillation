{"scene_id": "s05003", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05003.fountain", "heading": "EXT. FISHING BOAT - DECK - DAWN", "cast": [{"id": 0, "name": "SEA WREN", "names": ["SEA WREN"], "gender": "?", "first": 3, "spoke": 0}, {"id": 1, "name": "MAYA TORRES", "names": ["MAYA TORRES", "MAYA"], "gender": "f", "first": 6, "spoke": 9}, {"id": 2, "name": "LUCAS TORRES", "names": ["LUCAS TORRES", "LUCAS"], "gender": "m", "first": 13, "spoke": 8}, {"id": 3, "name": "INSERT - PHONE SCREEN", "names": ["INSERT - PHONE SCREEN"], "gender": "?", "first": 21, "spoke": 1}, {"id": 4, "name": "JESS", "names": ["JESS"], "gender": "m", "first": 29, "spoke": 4}, {"id": 5, "name": "THE CREW", "names": ["THE CREW"], "gender": "?", "first": 26, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FISHING BOAT - DECK - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Grey sea.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Grey sky.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A trawler, the SEA WREN, rolling slow.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "Diesel.", "para": 0, "sent": 3, "present": [0]}, {"u": 5, "kind": "action", "text": "Salt.", "para": 0, "sent": 4, "present": [0]}, {"u": 6, "kind": "action", "text": "MAYA TORRES, 16, hoodie soaked, sits on an overturned crate.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "She holds her phone up.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "One bar.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Flickering.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Her father's boat.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Her first trip out.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Her last.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "LUCAS TORRES, 40s, at the winch, doesn't look at her.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "He hauls a net.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "She films him.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Say hi to the internet, Dad.", "name": "MAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "No.", "name": "LUCAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "She lowers the phone.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Checks it.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Notifications stacking.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "ON PHONE: jess_wells: where r u ON PHONE: jess_wells: ur literally everywhere rn ON PHONE: jess_wells: maya answer", "name": "INSERT - PHONE SCREEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Maya's thumb hovers.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Wind.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "A gull.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Busy.", "name": "MAYA", "speaker": 1, "ext": [], "paren": ["typing, murmuring"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "The phone BUZZES.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 5]}, {"u": 27, "kind": "action", "text": "A call.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 5]}, {"u": 28, "kind": "action", "text": "She takes it.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 5]}, {"u": 29, "kind": "dialogue", "text": "Oh my god, finally. Have you seen it?", "name": "JESS", "speaker": 4, "ext": ["V.O."], "paren": ["tinny, breathless"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "I'm on a boat, Jess.", "name": "MAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Your video has two million views. Two. Million.", "name": "JESS", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Maya looks at Lucas.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "He is hauling.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "action", "text": "He didn't hear.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "dialogue", "text": "Which video?", "name": "MAYA", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "The one from the dock. Your dad. Yelling at the inspector.", "name": "JESS", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Silence.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Maya's stomach drops.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "She turns her back to him.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "I deleted that.", "name": "MAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "Somebody reposted it. They're calling him the angriest fisherman in America. There's like a hashtag.", "name": "JESS", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Waves.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Rope creaking.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Who's on the phone?", "name": "LUCAS", "speaker": 2, "ext": [], "paren": ["not turning"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Nobody.", "name": "MAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Maya.", "name": "LUCAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "She ends the call.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "Phone dark.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "Heart loud.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "THE CREW OF THE NEIGHBOURING BOAT lines the rail, forty yards off.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Phones raised.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "They are filming Lucas.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "They cheer.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "Angry Fisherman! Angry Fisherman!", "name": "THE CREW", "speaker": 5, "ext": [], "paren": ["in unison, waving"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "Lucas stops.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "Turns.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "Looks at them.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "Then at her.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "Nothing.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "How long have you known?", "name": "LUCAS", "speaker": 2, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "dialogue", "text": "Since the dock. I posted it. I was going to take it down.", "name": "MAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "dialogue", "text": "You posted it.", "name": "LUCAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "dialogue", "text": "It wasn't supposed to blow up. I just thought, people should see what they do to us.", "name": "MAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "He wipes his hands on his coat.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "Slowly.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "action", "text": "He walks toward her.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "action", "text": "She stands.", "para": 14, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "action", "text": "He stops an arm's length away.", "para": 14, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "action", "text": "His face.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "action", "text": "Unreadable.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "action", "text": "Rain begins.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "action", "text": "Soft, then not.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "dialogue", "text": "Give me the phone.", "name": "LUCAS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "action", "text": "She doesn't.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 75, "kind": "dialogue", "text": "Maya. The phone.", "name": "LUCAS", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 76, "kind": "action", "text": "She holds it out.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 77, "kind": "action", "text": "He takes it.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 78, "kind": "action", "text": "Looks at the screen.", "para": 18, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 79, "kind": "action", "text": "Her face on it.", "para": 18, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 80, "kind": "action", "text": "His face on it.", "para": 18, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 81, "kind": "action", "text": "Two million.", "para": 18, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}, {"u": 82, "kind": "action", "text": "Wind.", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 83, "kind": "action", "text": "He holds it over the rail.", "para": 20, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 84, "kind": "dialogue", "text": "Dad, don't.", "name": "MAYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 85, "kind": "dialogue", "text": "Show me how to make it say something else.", "name": "LUCAS", "speaker": 2, "ext": [], "paren": ["beat"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 86, "kind": "action", "text": "She stares.", "para": 21, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 87, "kind": "action", "text": "Then, shaking, she steps beside him, and takes the phone back.", "para": 21, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 88, "kind": "dialogue", "text": "Angry Fisherman! Angry Fisherman!", "name": "THE CREW", "speaker": 5, "ext": [], "paren": ["distant, still chanting"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 89, "kind": "action", "text": "Maya raises the phone.", "para": 22, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 90, "kind": "action", "text": "Turns the camera on both of them.", "para": 22, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}