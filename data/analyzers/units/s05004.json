{"scene_id": "s05004", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05004.fountain", "heading": "INT. SUBURBAN KITCHEN - NIGHT", "cast": [{"id": 0, "name": "WINIFRED LAWSON", "names": ["WINIFRED LAWSON", "WINIFRED"], "gender": "f", "first": 5, "spoke": 3}, {"id": 1, "name": "ARTHUR LAWSON", "names": ["ARTHUR LAWSON", "ARTHUR"], "gender": "m", "first": 6, "spoke": 3}, {"id": 2, "name": "RIVER LAWSON", "names": ["RIVER LAWSON", "RIVER"], "gender": "?", "first": 7, "spoke": 2}, {"id": 3, "name": "DOLORES FINCH", "names": ["DOLORES FINCH", "DOLORES"], "gender": "f", "first": 8, "spoke": 1}, {"id": 4, "name": "THE CHILDREN", "names": ["CHILDREN", "THE CHILDREN"], "gender": "p", "first": 9, "spoke": 1}, {"id": 5, "name": "INSERT - PHONE", "names": ["INSERT - PHONE"], "gender": "?", "first": 23, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. SUBURBAN KITCHEN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dark.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Candles.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A power cut.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Pots on the stove, stone cold.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "WINIFRED LAWSON, 60s, stirs a bowl of soup by torchlight.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Her husband ARTHUR LAWSON, 60s, kneels at the fuse box.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Their kid RIVER LAWSON, 20s, they/them, scrolls a dead phone.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Their neighbour DOLORES FINCH, 70s, has wandered in with a casserole.", "para": 1, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "THE CHILDREN, three nephews in matching pyjamas, sit on the counter in a row.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "It isn't the fuse. It isn't the breaker, it isn't the meter, it is the entire street, and I have told the electricity company four times that the grid in this neighbourhood has been held together by optimism since 1987.", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Arthur.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "I'm saying that when we moved here, there was a man who came round and said, don't worry about the cables, they're very modern. Modern! They've got moss on them.", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": ["beat"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Mine are fine.", "name": "DOLORES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Yours is on the other transformer, Dolores. You're a different civilisation.", "name": "ARTHUR", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "River holds up the black phone.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Dead.", "name": "RIVER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Then talk to us. We're the next best thing.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "We're hungry.", "name": "THE CHILDREN", "speaker": 4, "ext": [], "paren": ["in unison"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Candle flicker.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "A fridge hum, absent.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "River's phone lights up, wakes, flickers.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "1 percent.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "ON PHONE: mum: are u ok?? power's out everywhere", "name": "INSERT - PHONE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Mum's texting. From the next room.", "name": "RIVER", "speaker": 2, "ext": [], "paren": ["smiling"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "She is not.", "name": "WINIFRED", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "River turns the screen round.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Winifred reads.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Laughs.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "The lights snap on.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Everyone blinks.", "para": 6, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Arthur stands there with a screwdriver, triumphant, wrong.", "para": 6, "sent": 5, "present": [0, 1, 2, 3, 4, 5]}]}