{"scene_id": "s05006", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05006.fountain", "heading": "INT. SUBWAY CAR - MOVING - DAY", "cast": [{"id": 0, "name": "KENJI ABARA", "names": ["KENJI ABARA", "KENJI"], "gender": "m", "first": 5, "spoke": 5}, {"id": 1, "name": "JAMAL STRICKLAND", "names": ["JAMAL STRICKLAND", "JAMAL"], "gender": "m", "first": 8, "spoke": 2}, {"id": 2, "name": "COMMUTERS", "names": ["COMMUTERS"], "gender": "?", "first": 14, "spoke": 1}, {"id": 3, "name": "DEE ABARA", "names": ["DEE ABARA"], "gender": "f", "first": 26, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. SUBWAY CAR - MOVING - DAY", "present": []}, {"u": 1, "kind": "action", "text": "ON CAMERA: handheld, shaky.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rush hour.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Bodies.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Breath.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "KENJI ABARA, 17, holds a camcorder at chest height.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Narrating low to his lens.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "dialogue", "text": "Day three. Same car. Same guy.", "name": "KENJI", "speaker": 0, "ext": [], "paren": ["whispering, to camera"], "dual": false, "present": [0]}, {"u": 8, "kind": "action", "text": "PAN to JAMAL STRICKLAND, 40s, suit, earbuds in, pressed against the doors.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Not looking at anyone.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Crowd.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "He gets on at Fulton. Every day. Stands right there. Takes up the whole pole.", "name": "KENJI", "speaker": 0, "ext": ["CONT'D"], "paren": ["still whispering"], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Train lurches.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Squeal of brakes.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "THE COMMUTERS shift as one, a wall of coats and elbows.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "A bag swings into Kenji.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Sorry. Excuse me. Mind the door.", "name": "COMMUTERS", "speaker": 2, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Kenji lowers the camera.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Raises it again, slightly higher.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Hey. Your hand's on my sister's bag.", "name": "KENJI", "speaker": 0, "ext": [], "paren": ["to Jamal"], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "What?", "name": "JAMAL", "speaker": 1, "ext": [], "paren": ["pulling an earbud, flat"], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Her bag. You've been touching it for three stops.", "name": "KENJI", "speaker": 0, "ext": [], "paren": ["louder"], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Nothing.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The car goes quiet around them.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Someone looks at their shoes.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "A young woman, DEE ABARA, 15, Kenji's sister, edges forward, clutching the strap against her chest.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "She doesn't look up.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Kid's confused. Crowded train. It happens.", "name": "JAMAL", "speaker": 1, "ext": [], "paren": ["smiling thinly, to the car"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Kenji's grip on the camera whitens.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "The light on the lens glows red.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Say it again. Into the camera.", "name": "KENJI", "speaker": 0, "ext": [], "paren": ["very quiet"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Jamal's smile drops.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "He lunges for the lens, Kenji pulls back, Dee shoves between them, a briefcase hits the floor, THE COMMUTERS surge back, the pole shakes, a stranger shouts for the emergency cord.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "The camera tumbles.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Spins.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "The floor.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Shoes.", "para": 12, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Black.", "para": 12, "sent": 4, "present": [0, 1, 2, 3]}]}