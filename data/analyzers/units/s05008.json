{"scene_id": "s05008", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05008.fountain", "heading": "INT. HOTEL - 9TH FLOOR CORRIDOR - NIGHT", "cast": [{"id": 0, "name": "CELIA VANCE", "names": ["CELIA VANCE", "CELIA"], "gender": "f", "first": 6, "spoke": 7}, {"id": 1, "name": "STRANGER", "names": ["STRANGER"], "gender": "m", "first": 7, "spoke": 2}, {"id": 2, "name": "DAD", "names": ["DAD"], "gender": "?", "first": 8, "spoke": 2}, {"id": 3, "name": "MARCUS", "names": ["MARCUS"], "gender": "m", "first": 24, "spoke": 3}, {"id": 4, "name": "PRIYANKA", "names": ["PRIYANKA"], "gender": "f", "first": 36, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOTEL - 9TH FLOOR CORRIDOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Long.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Carpeted.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Quiet as a held breath.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Brass numbers glow on doors.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A housekeeping cart sits abandoned by the elevators, a room-service tray on the floor, a single shoe in the hall.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "CELIA VANCE, 30s, evening dress, heels in hand, walks fast with a phone to her ear.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Behind her, a STRANGER in a grey suit follows at a polite distance.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Dad I told you I'm fine, the party was fine, I'm in the hallway now, I'm literally at my door.", "name": "CELIA", "speaker": 0, "ext": [], "paren": ["into phone"], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "You sound off. Is somebody with you?", "name": "DAD", "speaker": 2, "ext": ["V.O."], "paren": ["over phone, warm"], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "She glances back.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "The STRANGER stops, checks his watch, smiles.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "No. Nobody.", "name": "CELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She reaches her door.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Swipes.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Red light.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Swipes again.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Red.", "para": 3, "sent": 4, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "ON PHONE: Front Desk: Your key has expired.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Please visit reception.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Great. Perfect.", "name": "CELIA", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "The STRANGER steps closer, hands visible.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Having trouble? I can call down. I'm in 912, just there.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "I'm fine thank you", "name": "CELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Of course. I'm Marcus by the way. Marcus Hale. We met at the bar, I bought you the gin.", "name": "STRANGER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Celia freezes.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "A beat.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Her face loosens.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Oh my god. Marcus. You're the one who spilled it on my coat.", "name": "CELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Guilty. I've been trying to apologise all night. Honestly I followed you because I felt terrible.", "name": "MARCUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "She laughs, relieved, the phone drooping at her side.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Dad's tiny voice keeps talking.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Celia? Celia are you there", "name": "DAD", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Dad I'll call you back", "name": "CELIA", "speaker": 0, "ext": [], "paren": ["into phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "She hangs up.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "The corridor settles.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Down the hall an elevator DINGS and the doors slide, and out walks a woman in a hotel blazer, name badge reading PRIYANKA, and behind her two men in dark coats who are definitely not guests.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Don't turn around. Walk with me.", "name": "MARCUS", "speaker": 3, "ext": [], "paren": ["low, not smiling now"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "What", "name": "CELIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Your father sold something he shouldn't have. They're here for you. I'm the one who's here to get you out.", "name": "MARCUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "The housekeeper sets down her cart.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Her hand goes to her pocket.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}]}