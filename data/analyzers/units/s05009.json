{"scene_id": "s05009", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05009.fountain", "heading": "EXT. BORDER CHECKPOINT - DUSTY ROAD - DAY", "cast": [{"id": 0, "name": "MARSHAL ELIAS CROWE", "names": ["MARSHAL ELIAS CROWE", "CROWE"], "gender": "f", "first": 5, "spoke": 8}, {"id": 1, "name": "ROSALIND BEAUMONT", "names": ["ROSALIND BEAUMONT", "ROSALIND"], "gender": "f", "first": 6, "spoke": 5}, {"id": 2, "name": "SHERIFF", "names": ["SHERIFF"], "gender": "?", "first": 17, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. BORDER CHECKPOINT - DUSTY ROAD - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A single wooden gate.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A booth.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A flag that has given up.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Heat shimmer over the gravel.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "MARSHAL ELIAS CROWE, 50s, dust on his hat, leans out of the booth.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Before him, on a mule, sits ROSALIND BEAUMONT, 40s, rifle across her lap, face like closed shutters.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Papers.", "name": "CROWE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Ain't got none.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Then you ain't crossing.", "name": "CROWE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "You know what the last man who said that to me said after?", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": ["beat"], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I'd wager nothing.", "name": "CROWE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Nothing. That's right. Funny how that works.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Crowe's phone RINGS in the booth.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "An old landline, cord and all.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "He lifts it.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Checkpoint.", "name": "CROWE", "speaker": 0, "ext": [], "paren": ["into receiver"], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Elias, hold her. Don't let her through. She's got a warrant out in three counties.", "name": "SHERIFF", "speaker": 2, "ext": ["V.O."], "paren": ["crackling"], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Crowe looks at Rosalind.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "She hasn't moved.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "He lowers the receiver slowly.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Sheriff says I should hold you.", "name": "CROWE", "speaker": 0, "ext": [], "paren": ["to her"], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "And what do you say?", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "I say it's hot. And I'm tired. And in thirty years nobody ever asked me what I wanted. Not once.", "name": "CROWE", "speaker": 0, "ext": [], "paren": ["long beat"], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "He hangs up the phone.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Opens the gate.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Go on. Before I think better of it.", "name": "CROWE", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "You'll regret it.", "name": "ROSALIND", "speaker": 1, "ext": [], "paren": ["touching her hat"], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Probably. That's what the gate's for.", "name": "CROWE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "She clicks her tongue.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "The mule crosses.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Dust rises.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Crowe watches until she is a speck, then picks the receiver up again, and tells the sheriff she never came.", "para": 5, "sent": 3, "present": [0, 1, 2]}]}