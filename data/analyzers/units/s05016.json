{"scene_id": "s05016", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05016.fountain", "heading": "EXT. BORDER CHECKPOINT - DAY", "cast": [{"id": 0, "name": "KIT", "names": ["KIT"], "gender": "?", "first": 2, "spoke": 7}, {"id": 1, "name": "LEO", "names": ["LEO"], "gender": "m", "first": 3, "spoke": 4}, {"id": 2, "name": "OKOYE", "names": ["OKOYE"], "gender": "?", "first": 7, "spoke": 4}, {"id": 3, "name": "BRANDT", "names": ["BRANDT"], "gender": "m", "first": 19, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. BORDER CHECKPOINT - DAY", "present": []}, {"u": 1, "kind": "action", "text": "heat coming off the asphalt. a line of cars not moving. a dog on a leash sniffs a tire while a man in a vest watches it like it might say something.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Kit, 30s, sits behind the wheel of a dusty hatchback, window down, passport already in hand.", "para": 1, "sent": 0, "present": [0]}, {"u": 3, "kind": "action", "text": "Beside her, her brother Leo, 20s, picks at the seam of the seat.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 4, "kind": "dialogue", "text": "ok so if he asks, we're visiting our aunt", "name": "KIT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "we don't have an aunt", "name": "LEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "we do now", "name": "KIT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Officer Daria Okoye, 40s, walks up to the window, clipboard tucked under one arm.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "morning. where you headed today", "name": "OKOYE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "to see our aunt. she's, um. she's not well.", "name": "KIT", "speaker": 0, "ext": [], "paren": ["too fast"], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "she have a name", "name": "OKOYE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "yeah. it's. Marguerite.", "name": "KIT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Margaret.", "name": "LEO", "speaker": 1, "ext": [], "paren": ["at the same moment"], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "They look at each other.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Okoye does not move.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "which is it", "name": "OKOYE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "both. it's a nickname thing, she goes by both, it's a whole thing in the family", "name": "KIT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Behind them, a kid in the next car presses his face to the glass.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "His mom pulls him back.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "A second officer, Brandt, 50s, drifts toward the hatchback from the other side, hand resting near his belt.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "trunk, please", "name": "BRANDT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "there's nothing in it", "name": "LEO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "then it'll be quick", "name": "BRANDT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Kit and Leo both freeze.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "The dog lifts its head.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Brandt and Okoye exchange a look.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "if you run i swear to god", "name": "KIT", "speaker": 0, "ext": [], "paren": ["very quiet, to Leo"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "i'm not running. you're the one who wanted to come this way", "name": "LEO", "speaker": 1, "ext": [], "paren": ["equally quiet"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Leo pops the trunk.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Brandt lifts the lid.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Inside: a cooler, a sleeping bag, a framed photograph of an older woman.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Marguerite Margaret Vance. 1951.", "name": "BRANDT", "speaker": 3, "ext": [], "paren": ["reading the back"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "told you", "name": "KIT", "speaker": 0, "ext": [], "paren": ["exhaling"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Okoye lowers the clipboard.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "For a second nobody speaks.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Then Okoye almost smiles.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "go on. drive safe. and say hi to your aunt for me", "name": "OKOYE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Kit and Leo both laugh, a little too loud, as the barrier lifts and the cars behind them start to honk.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}]}