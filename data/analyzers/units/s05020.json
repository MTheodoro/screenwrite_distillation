{"scene_id": "s05020", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05020.fountain", "heading": "INT. FOOD TRUCK - NIGHT", "cast": [{"id": 0, "name": "KIM", "names": ["KIM"], "gender": "f", "first": 2, "spoke": 7}, {"id": 1, "name": "KIP", "names": ["KIP"], "gender": "m", "first": 6, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. FOOD TRUCK - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Grill hissing.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Kim flips a patty, eyes on the window.", "para": 0, "sent": 1, "present": [0]}, {"u": 3, "kind": "action", "text": "Her phone BUZZES on the counter.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "She puts it on speaker.", "para": 1, "sent": 1, "present": [0]}, {"u": 5, "kind": "dialogue", "text": "Where are you?", "name": "KIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 6, "kind": "dialogue", "text": "Two minutes out. Is he there?", "name": "KIP", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Black sedan. Same spot. Engine running.", "name": "KIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Don't look at him.", "name": "KIP", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "I'm not looking.", "name": "KIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She looks.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Quick.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Back to the grill.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Kim.", "name": "KIP", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "I know.", "name": "KIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Hand me the bag when I knock. Don't say a word.", "name": "KIP", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "You said the bag was clean.", "name": "KIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "It is.", "name": "KIP", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "A beat.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "The sedan's door OPENS.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Kip. He's walking over.", "name": "KIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Stall him.", "name": "KIP", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Kim wipes her hands.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Smiles.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Slides the window open.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "What can I get you?", "name": "KIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}]}