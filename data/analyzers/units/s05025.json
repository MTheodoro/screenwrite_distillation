{"scene_id": "s05025", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05025.fountain", "heading": "INT. NIGHT BUS - MOVING - NIGHT", "cast": [{"id": 0, "name": "TESS", "names": ["TESS"], "gender": "f", "first": 3, "spoke": 5}, {"id": 1, "name": "LORNA", "names": ["LORNA"], "gender": "f", "first": 18, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT BUS - MOVING - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "WE SEE a half-empty bus crossing the city in heavy rain.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rain.", "para": 1, "sent": 0, "present": []}, {"u": 3, "kind": "action", "text": "CLOSE ON TESS, 17, forehead against the cold window.", "para": 2, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "She is angry, and she is trying to hide that she is angry, which is very obvious to the audience.", "para": 2, "sent": 1, "present": [0]}, {"u": 5, "kind": "action", "text": "Her phone.", "para": 3, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Dead.", "para": 3, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Dark streets.", "para": 4, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Nothing.", "para": 4, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "A woman's phone RINGS from Tess's bag.", "para": 5, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "Not Tess's phone.", "para": 5, "sent": 1, "present": [0]}, {"u": 11, "kind": "action", "text": "Her mother's old phone, which she took without asking.", "para": 5, "sent": 2, "present": [0]}, {"u": 12, "kind": "action", "text": "INSERT - PHONE SCREEN: \"MUM CALLING\".", "para": 6, "sent": 0, "present": [0]}, {"u": 13, "kind": "action", "text": "Tess looks at it.", "para": 7, "sent": 0, "present": [0]}, {"u": 14, "kind": "action", "text": "Does not answer.", "para": 7, "sent": 1, "present": [0]}, {"u": 15, "kind": "action", "text": "It rings again.", "para": 7, "sent": 2, "present": [0]}, {"u": 16, "kind": "action", "text": "Silence.", "para": 8, "sent": 0, "present": [0]}, {"u": 17, "kind": "action", "text": "She answers.", "para": 9, "sent": 0, "present": [0]}, {"u": 18, "kind": "dialogue", "text": "Tess? Where are you? It's one in the morning!", "name": "LORNA", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "On a bus.", "name": "TESS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "Which bus? Which road? I have been calling for hours.", "name": "LORNA", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "You were calling the other phone. The dead one.", "name": "TESS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "ANGLE ON Tess's hand, gripping the phone so hard her knuckles go white.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "This is the last time they will speak before everything changes.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Come home. We can talk about Dad in the morning.", "name": "LORNA", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "There is nothing to talk about. You didn't tell me, Mum. He's been gone for a month and you let me think he was on a trip.", "name": "TESS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Nothing.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "I was trying to protect you.", "name": "LORNA", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "You were protecting YOURSELF!", "name": "TESS", "speaker": 0, "ext": [], "paren": ["screaming now"], "dual": false, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "The other passengers turn.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "The driver's eyes in the mirror.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "BACK TO SCENE.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Tess stands, the phone raised like she will throw it.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Don't call me again!", "name": "TESS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "She throws it.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "It SMASHES against the bus floor.", "para": 14, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Rain.", "para": 15, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Only rain.", "para": 15, "sent": 1, "present": [0, 1]}]}