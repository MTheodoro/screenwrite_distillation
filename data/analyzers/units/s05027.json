{"scene_id": "s05027", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05027.fountain", "heading": "EXT. RIVERSIDE PARK - FOUNTAIN - DAY", "cast": [{"id": 0, "name": "KIKI", "names": ["KIKI"], "gender": "f", "first": 1, "spoke": 8}, {"id": 1, "name": "KAI", "names": ["KAI"], "gender": "f", "first": 2, "spoke": 6}, {"id": 2, "name": "JADA", "names": ["JADA"], "gender": "f", "first": 3, "spoke": 4}, {"id": 3, "name": "STRANGER", "names": ["STRANGER"], "gender": "?", "first": 19, "spoke": 3}, {"id": 4, "name": "MARCUS", "names": ["MARCUS"], "gender": "m", "first": 31, "spoke": 2}, {"id": 5, "name": "SQUEAL", "names": ["SQUEAL"], "gender": "?", "first": 37, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "EXT. RIVERSIDE PARK - FOUNTAIN - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Kiki, 19, ring light clipped to her phone, stands on the fountain's edge in a yellow jacket.", "para": 0, "sent": 0, "present": [0]}, {"u": 2, "kind": "action", "text": "Kai, her cousin, holds the tripod.", "para": 0, "sent": 1, "present": [0, 1]}, {"u": 3, "kind": "action", "text": "Jada, 17, stands off to the side eating chips.", "para": 0, "sent": 2, "present": [0, 1, 2]}, {"u": 4, "kind": "dialogue", "text": "Everyone thinks the camera shows the truth. It shows what you point it at. That's the whole trick.", "name": "KIKI", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "Okay, okay, take four. Kai, don't breathe on the mic.", "name": "KIKI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "I'm not breathing on it.", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "He's breathing on it.", "name": "JADA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "I'm literally holding my breath.", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "The phone BUZZES on the tripod.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "ON PHONE: unknown number: stop filming. go home.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Kiki laughs.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Shows Kai.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Kai doesn't laugh.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "That's a bit.", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "It's a bit. Some bot. Rolling.", "name": "KIKI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "She starts the dance.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Two bars in, a man in a grey coat walks into the frame behind her, and does not walk out.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Excuse me, sir? We're filming!", "name": "KIKI", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "You're filming me.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Nobody's filming you.", "name": "JADA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Dude, you're in the shot, step back.", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "You posted this fountain at nine this morning. Caption said \"no one ever comes here.\"", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "It's a caption!", "name": "KIKI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "ON PHONE: unknown number: he's not joking. walk away.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Kiki's smile goes.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "The tripod light blinks red.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "A pigeon bursts off the fountain, SCREAMING away over the trees.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Who is texting you?", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Jada?", "name": "KIKI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "It's not me! I'm right here!", "name": "JADA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "My name is Marcus. I'm the one who texted you. Look behind you, Kiki.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Funny. I only said \"Kiki\" in the video. Never my last name. Never where we live.", "name": "KIKI", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Put the phone down.", "name": "MARCUS", "speaker": 4, "ext": [], "paren": ["to Kai, calm"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "What? No!", "name": "KAI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Kiki, we should go.", "name": "JADA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Go where, Jada, he's--", "name": "KIKI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "A black van pulls up on the gravel path with a SQUEAL of tires.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "The side door SLIDES open.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Now, please. All three.", "name": "MARCUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}