{"scene_id": "s05028", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05028.fountain", "heading": "INT. DUSTY ROAD STUDIOS - RECORDING ROOM - NIGHT", "cast": [{"id": 0, "name": "CAMERA", "names": ["CAMERA"], "gender": "m", "first": 4, "spoke": 0}, {"id": 1, "name": "MO", "names": ["MO"], "gender": "?", "first": 2, "spoke": 3}, {"id": 2, "name": "BIG DAVE", "names": ["BIG DAVE"], "gender": "m", "first": 6, "spoke": 4}, {"id": 3, "name": "THE WOMAN", "names": ["THE WOMAN"], "gender": "?", "first": 11, "spoke": 3}, {"id": 4, "name": "JEN", "names": ["JEN"], "gender": "f", "first": 7, "spoke": 1}, {"id": 5, "name": "LOU", "names": ["LOU"], "gender": "m", "first": 25, "spoke": 1}, {"id": 6, "name": "WHIRS", "names": ["WHIRS"], "gender": "m", "first": 30, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. DUSTY ROAD STUDIOS - RECORDING ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "HANDHELD.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A documentary crew's camera follows Mo, 30s, through the control room.", "para": 0, "sent": 1, "present": [1]}, {"u": 3, "kind": "action", "text": "Red light on.", "para": 0, "sent": 2, "present": [1]}, {"u": 4, "kind": "action", "text": "ON CAMERA, he turns and talks to the lens.", "para": 0, "sent": 3, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "This is the room where it all got made. Forty years of cowboy ballads and bad decisions.", "name": "MO", "speaker": 1, "ext": [], "paren": ["to camera"], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Big Dave, 50s, hat the size of a dinner plate, sits at the console with his boots on the desk.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Jen, 20s, stands in the booth behind glass, headphones around her neck.", "para": 1, "sent": 1, "present": [0, 1, 2, 4]}, {"u": 8, "kind": "dialogue", "text": "Tell them about the ghost, Mo.", "name": "BIG DAVE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 9, "kind": "dialogue", "text": "There's no ghost.", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 10, "kind": "dialogue", "text": "There's a ghost.", "name": "BIG DAVE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 11, "kind": "action", "text": "The studio door SLAMS.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "A woman in a long duster coat stands in it, dripping.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Nobody knows her.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "The camera swings.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Mo and Big Dave both freeze.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Jen drops her headphones.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Can we help you, ma'am?", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Looking for the tape. Nineteen ninety-four. Session nine.", "name": "THE WOMAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "We don't give out tapes.", "name": "BIG DAVE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "I'm not asking.", "name": "THE WOMAN", "speaker": 3, "ext": [], "paren": ["stepping forward"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Jen runs out of the booth and the three of them end up in a clump by the console, the camera shaking, the cables tangled around everyone's boots.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "I don't know her. I swear to God.", "name": "JEN", "speaker": 4, "ext": [], "paren": ["to camera, whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "You will.", "name": "THE WOMAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "She puts a battered cassette on the console.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "The label reads: LOU CALDER - DO NOT PLAY.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "dialogue", "text": "Lou. Lou Calder. That's you.", "name": "BIG DAVE", "speaker": 2, "ext": [], "paren": ["quiet, taking off the hat"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Played it once, Dave. Never again. Press record.", "name": "LOU", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "Mo reaches for the board.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Jen backs against the wall.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "The tape machine WHIRS, and the speakers CRACKLE with a man's voice singing, far away, in a language none of them know.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "The camera drops.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "action", "text": "Static.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "action", "text": "Cut.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}]}