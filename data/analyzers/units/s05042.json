{"scene_id": "s05042", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05042.fountain", "heading": "INT. CAR (MOVING) - NIGHT", "cast": [{"id": 0, "name": "MO", "names": ["MO"], "gender": "?", "first": 3, "spoke": 3}, {"id": 1, "name": "THE WOMAN", "names": ["WOMAN", "THE WOMAN"], "gender": "f", "first": 4, "spoke": 2}, {"id": 2, "name": "DR. NAIR", "names": ["DR. NAIR"], "gender": "?", "first": 12, "spoke": 3}, {"id": 3, "name": "JEN", "names": ["JEN"], "gender": "?", "first": 14, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. CAR (MOVING) - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "SUPER: \"2:04 AM\"", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Wet streetlights slide across the windshield.", "para": 1, "sent": 0, "present": []}, {"u": 3, "kind": "action", "text": "MO, 30s, rideshare driver, hands at ten and two.", "para": 1, "sent": 1, "present": [0]}, {"u": 4, "kind": "action", "text": "In the back, THE WOMAN, 40s, scrubs under a grey coat, a cooler bag on her lap, thumb hovering over her phone.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "CLOSE ON the cooler bag.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "A biohazard sticker.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "A digital display on it blinking: 03:12.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Hospital's six minutes out. You said the drop's at the transplant door?", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Side entrance. Don't stop at the main.", "name": "THE WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Her phone BUZZES.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "She answers on speaker.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Where are you? The patient is on the table and the clock's running.", "name": "DR. NAIR", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Six minutes. Maybe five.", "name": "THE WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Jen, the courier crashed. I'm told you're riding with a stranger.", "name": "DR. NAIR", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Here we go.", "name": "JEN", "speaker": 3, "ext": [], "paren": ["low, to herself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "ANGLE ON Mo's eyes in the rear-view mirror.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "A red light ahead.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "He slows, then runs it.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Sorry. Hold on.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "INSERT - THE COOLER DISPLAY", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "03:09.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "03:08.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "WE SEE headlights swing in behind them, high beams, closing fast.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Mo, who is that?", "name": "JEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Not my brother-in-law. Seatbelt.", "name": "MO", "speaker": 0, "ext": [], "paren": ["flooring it"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "BACK TO SCENE", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Jen? Jen, talk to me.", "name": "DR. NAIR", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Keep the line open. We're not stopping.", "name": "JEN", "speaker": 3, "ext": [], "paren": ["gripping the door handle"], "dual": false, "present": [0, 1, 2, 3]}]}