{"scene_id": "s05050", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05050.fountain", "heading": "INT. HOLLOWAY KITCHEN - NIGHT", "cast": [{"id": 0, "name": "HANNAH", "names": ["HANNAH"], "gender": "f", "first": 1, "spoke": 2}, {"id": 1, "name": "BECK", "names": ["BECK"], "gender": "m", "first": 11, "spoke": 2}, {"id": 2, "name": "THE TWINS", "names": ["THE TWINS"], "gender": "?", "first": 1, "spoke": 3}, {"id": 3, "name": "ROSALIND", "names": ["ROSALIND"], "gender": "f", "first": 8, "spoke": 2}, {"id": 4, "name": "ILYA", "names": ["ILYA"], "gender": "?", "first": 9, "spoke": 2}, {"id": 5, "name": "DESMOND", "names": ["DESMOND"], "gender": "m", "first": 5, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOLLOWAY KITCHEN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "The power has been out for eleven minutes, and in that time Hannah Voss has built a small, ordinary world out of candles and tea lights, the way she once built forts out of couch cushions, certain that if the room looks cozy enough then nothing outside it can be wrong.", "para": 0, "sent": 0, "present": [0, 2]}, {"u": 2, "kind": "action", "text": "Dark.", "para": 1, "sent": 0, "present": [0, 2]}, {"u": 3, "kind": "action", "text": "Candle flames.", "para": 1, "sent": 1, "present": [0, 2]}, {"u": 4, "kind": "action", "text": "The fridge, silent.", "para": 1, "sent": 2, "present": [0, 2]}, {"u": 5, "kind": "action", "text": "Desmond, her husband, 40s, stands at the window with his phone held up like a lantern, and he is not looking at the sky.", "para": 2, "sent": 0, "present": [0, 2, 5]}, {"u": 6, "kind": "action", "text": "He is looking at the street.", "para": 2, "sent": 1, "present": [0, 2, 5]}, {"u": 7, "kind": "action", "text": "Every house on it is dark in exactly the same way.", "para": 2, "sent": 2, "present": [0, 2, 5]}, {"u": 8, "kind": "action", "text": "Rosalind, 16, sits on the counter swinging her heels.", "para": 3, "sent": 0, "present": [0, 2, 3, 5]}, {"u": 9, "kind": "action", "text": "Beside the stove, Ilya, Hannah's father, 70s, hums something tuneless and kind.", "para": 3, "sent": 1, "present": [0, 2, 3, 4, 5]}, {"u": 10, "kind": "action", "text": "Nothing wrong.", "para": 3, "sent": 2, "present": [0, 2, 3, 4, 5]}, {"u": 11, "kind": "action", "text": "Beck, the neighbour, 50s, leans in the back doorway with a flashlight pointed politely at the floor.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 12, "kind": "dialogue", "text": "Grid's down to the coast, Beck says. Probably a transformer.", "name": "HANNAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "Probably. Probably a transformer.", "name": "BECK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "Can we have the marshmallows now?", "name": "THE TWINS", "speaker": 2, "ext": [], "paren": ["together, from under the table"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "You had marshmallows.", "name": "ROSALIND", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "That was before.", "name": "THE TWINS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "Before what? Before what?", "name": "ILYA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "Hannah. Come here.", "name": "DESMOND", "speaker": 5, "ext": [], "paren": ["not turning"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "In a second, Des, the girls are...", "name": "HANNAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Now.", "name": "DESMOND", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "She crosses the kitchen.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Wax.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "Tea.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "The smell of home.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Outside, above the roofline, the stars are wrong.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Too many.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Too still.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "And one of them is moving toward the house.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "action", "text": "Her phone.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "action", "text": "Dead.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "That is not a transformer.", "name": "BECK", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "Mom?", "name": "ROSALIND", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Is it the visitors?", "name": "THE TWINS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "Nobody breathes.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "Hannah turns, slowly, and sees that Ilya has stopped humming, and that her father is smiling at the window like a man whose train has finally come in.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "dialogue", "text": "They said it would be in the evening.", "name": "ILYA", "speaker": 4, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}