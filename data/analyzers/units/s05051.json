{"scene_id": "s05051", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05051.fountain", "heading": "INT. NIGHT BUS - MOVING - NIGHT", "cast": [{"id": 0, "name": "NELL", "names": ["NELL"], "gender": "f", "first": 9, "spoke": 4}, {"id": 1, "name": "HOODIE GUY", "names": ["HOODIE GUY"], "gender": "?", "first": 10, "spoke": 2}, {"id": 2, "name": "BARROW", "names": ["BARROW"], "gender": "?", "first": 16, "spoke": 3}, {"id": 3, "name": "IRIS", "names": ["IRIS"], "gender": "f", "first": 26, "spoke": 2}, {"id": 4, "name": "SHRIEK", "names": ["SHRIEK"], "gender": "?", "first": 39, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT BUS - MOVING - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Rain on glass.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Neon smears past.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A battered double-decker, half empty, rattling through a city that does not appear on any map.", "para": 1, "sent": 0, "present": []}, {"u": 4, "kind": "action", "text": "Flickering strip lights.", "para": 1, "sent": 1, "present": []}, {"u": 5, "kind": "action", "text": "Vinyl seats slashed and taped.", "para": 1, "sent": 2, "present": []}, {"u": 6, "kind": "action", "text": "A bell that rings by itself.", "para": 1, "sent": 3, "present": []}, {"u": 7, "kind": "action", "text": "Two teenagers share earbuds in the back row.", "para": 2, "sent": 0, "present": []}, {"u": 8, "kind": "action", "text": "A scruffy terrier sleeps under a seat.", "para": 2, "sent": 1, "present": []}, {"u": 9, "kind": "action", "text": "Up front, NELL (20s, soot on her cheek, a sword wrapped in a rain poncho) grips the pole.", "para": 3, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "HOODIE GUY sits across the aisle.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Grey hood.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "No face.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Just a slow, steady grin in the dark.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "The engine COUGHS.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Nobody panic. We're ahead of them.", "name": "NELL", "speaker": 0, "ext": [], "paren": ["to the whole bus"], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Define ahead.", "name": "BARROW", "speaker": 2, "ext": [], "paren": ["a hulking man in a bus-driver's cap, hauling the wheel"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "BELL.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "DING.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "DING.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Come on, come on.", "name": "NELL", "speaker": 0, "ext": [], "paren": ["muttered"], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "The lights DIE.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Back on.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Silence.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Rain.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Nothing.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Something just landed up there.", "name": "IRIS", "speaker": 3, "ext": [], "paren": ["clutching a lantern, eyes on the roof"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "THUMP.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "THUMP.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "THUMP.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "The teenagers pull out their earbuds.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "The dog lifts its head.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Hold this thing steady.", "name": "BARROW", "speaker": 2, "ext": [], "paren": ["hands off the wheel, cracking his knuckles"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "You're not steering?", "name": "NELL", "speaker": 0, "ext": [], "paren": ["drawing the sword, glaring at the ceiling"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Not anymore.", "name": "BARROW", "speaker": 2, "ext": [], "paren": ["grinning"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "CRUNCH.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "A claw punches through the roof.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Let me.", "name": "HOODIE GUY", "speaker": 1, "ext": [], "paren": ["rising, pushing back his hood, calm"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "A flash of silver light.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "A SHRIEK from above.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Then a heavy body slides off the roof and is gone.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Silence.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Rain.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Who are you?", "name": "IRIS", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Cass. Once upon a time, I was the one they sent you to find.", "name": "HOODIE GUY", "speaker": 1, "ext": [], "paren": ["sitting back down"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Of course you were.", "name": "NELL", "speaker": 0, "ext": [], "paren": ["lowering the sword, to herself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "The bus hums on into the dark.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "The dog goes back to sleep.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}]}