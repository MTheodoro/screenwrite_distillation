{"scene_id": "s05053", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05053.fountain", "heading": "INT. WESTFIELD HIGH SCHOOL - BOYS' BATHROOM - DAY", "cast": [{"id": 0, "name": "SAM", "names": ["SAM"], "gender": "m", "first": 4, "spoke": 6}, {"id": 1, "name": "MO", "names": ["MO"], "gender": "?", "first": 5, "spoke": 5}, {"id": 2, "name": "BIG DAVE", "names": ["BIG DAVE"], "gender": "m", "first": 14, "spoke": 5}, {"id": 3, "name": "JEN", "names": ["JEN"], "gender": "?", "first": 18, "spoke": 5}, {"id": 4, "name": "MRS. K", "names": ["MRS. K"], "gender": "f", "first": 35, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. WESTFIELD HIGH SCHOOL - BOYS' BATHROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "ON CAMERA: handheld, shaky, filming through a gap between two stalls.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fluorescent hum.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A dripping tap.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Sam, 17, leans on the sink, phone in hand, in a hoodie.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Next to him, Mo, 17, washes his hands for far too long.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "The documentary crew is not supposed to be here.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "They are here anyway.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You said you wouldn't film this part.", "name": "SAM", "speaker": 0, "ext": [], "paren": ["to camera, quiet"], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Turn it off. Seriously.", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "The tap runs.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Nobody turns anything off.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "This is the last time they will all be in the same room before the hearing.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "A stall door SLAMS.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Big Dave, 18, steps out, shoulders filling the frame.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Who's talking? Who's talking about me?", "name": "BIG DAVE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Nobody.", "name": "SAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "We're not.", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "You're all still here? The hearing's in ten minutes.", "name": "JEN", "speaker": 3, "ext": [], "paren": ["from the doorway, a girl in a blazer, clipboard clutched"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "You think I don't know that?", "name": "BIG DAVE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Jen, you shouldn't be in here.", "name": "SAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Mrs. K said to find you.", "name": "JEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "She said what?", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "She said it's fine, they said it's fine, it's all fine.", "name": "BIG DAVE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Nobody said it's fine, Dave.", "name": "JEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Can we just", "name": "SAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Let her finish.", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "The statement has to match. Word for word. If one of you changes one thing.", "name": "JEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "I'm not changing anything.", "name": "BIG DAVE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "You already did. You said it was a door.", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "It WAS a door.", "name": "BIG DAVE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "It wasn't a door, man.", "name": "SAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Stop. Everyone stop.", "name": "JEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "The phone BUZZES in Sam's hand.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "He stares at it.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Samuel? Time.", "name": "MRS. K", "speaker": 4, "ext": ["O.S."], "paren": ["through the door"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Nobody moves.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "The tap drips.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Sam sets the phone on the sink, face down.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "I'm telling them.", "name": "SAM", "speaker": 0, "ext": [], "paren": ["barely a whisper"], "dual": false, "present": [0, 1, 2, 3, 4]}]}