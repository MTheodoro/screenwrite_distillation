{"scene_id": "s05055", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05055.fountain", "heading": "INT. SUBWAY CAR - EVENING", "cast": [{"id": 0, "name": "DASHA", "names": ["DASHA"], "gender": "f", "first": 1, "spoke": 2}, {"id": 1, "name": "IVO", "names": ["IVO"], "gender": "m", "first": 1, "spoke": 3}, {"id": 2, "name": "PAVEL", "names": ["PAVEL"], "gender": "m", "first": 1, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. SUBWAY CAR - EVENING", "present": []}, {"u": 1, "kind": "action", "text": "The train is very full and it is hot and a man named Ivo, 30s, with a blue bag between his feet, holds the pole with one hand and looks at the floor while a girl, Dasha, 20s, is pressed against him by the crowd and tries to read her phone over a shoulder, and at the far end of the car a thin man in a grey coat, Pavel, 40s, watches them both and does not look at anything else.", "para": 0, "sent": 0, "present": [0, 1, 2]}, {"u": 2, "kind": "action", "text": "ON PHONE: Dasha - where r u", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 3, "kind": "action", "text": "Dasha types with one thumb.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 4, "kind": "action", "text": "She looks up.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 5, "kind": "action", "text": "Ivo looks away.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "ON PHONE: Dasha - i see u. wave", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Ivo does not wave.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "His knuckles are white on the pole.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "You have what I need?", "name": "DASHA", "speaker": 0, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Not here.", "name": "IVO", "speaker": 1, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "The train brakes.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Everybody leans together.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Pavel moves two steps closer through the crowd, one hand in his coat pocket, and a woman with shopping bags says something sharp in another language that nobody answers.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "He is coming.", "name": "DASHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "I know.", "name": "IVO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "ON PHONE: Dasha - dont turn around", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Ivo turns around.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Pavel is very close now.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "The doors open.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Nobody gets off.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "You are in my seat, I think.", "name": "PAVEL", "speaker": 2, "ext": [], "paren": ["smiling"], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "There is no seat.", "name": "IVO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}