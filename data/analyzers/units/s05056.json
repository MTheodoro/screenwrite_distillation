{"scene_id": "s05056", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05056.fountain", "heading": "INT. SELF-STORAGE UNIT 114 - DAY", "cast": [{"id": 0, "name": "HOLLIS", "names": ["HOLLIS"], "gender": "m", "first": 3, "spoke": 7}, {"id": 1, "name": "THE WOMAN", "names": ["THE WOMAN"], "gender": "?", "first": 2, "spoke": 3}, {"id": 2, "name": "WADE", "names": ["WADE"], "gender": "m", "first": 18, "spoke": 3}, {"id": 3, "name": "ODALYS", "names": ["ODALYS"], "gender": "f", "first": 24, "spoke": 2}, {"id": 4, "name": "CAL", "names": ["CAL"], "gender": "m", "first": 33, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. SELF-STORAGE UNIT 114 - DAY", "present": []}, {"u": 1, "kind": "action", "text": "ON CAMERA: a roll-up door half open, daylight on concrete.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The camera operator's breathing is audible.", "para": 0, "sent": 1, "present": [1]}, {"u": 3, "kind": "action", "text": "Hollis, 60s, in a sweat-stained Stetson, kneels over a trunk.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "Behind him, boxes stacked to the ceiling, saddles, a dented tin lantern.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "A woman stands in the doorway with her arms crossed.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "She does not give her name.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "She has a leather satchel and a very flat voice.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Told the office it was all family stuff. Photographs. My granddad's saddle.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "And the brand book.", "name": "THE WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Didn't say a word about no brand book.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "You didn't have to.", "name": "THE WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Hollis opens the trunk.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Nothing.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Dust.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Well, it ain't here.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Hollis's phone RINGS.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "He answers on speaker.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "Pa? You in there yet? Don't open nothing till I get there.", "name": "WADE", "speaker": 2, "ext": ["V.O."], "paren": ["tinny"], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Too late, son.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Is somebody with you?", "name": "WADE", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Hollis looks at the woman.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "She looks at the camera.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "For a long time none of them say anything.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Tell him it's Odalys. Tell him I came the long way round.", "name": "THE WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "It's Odalys.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": ["into the phone"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "I'm ten minutes out. Stay put.", "name": "WADE", "speaker": 2, "ext": ["V.O."], "paren": ["a pause, then flat"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "The line goes dead.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Hollis puts the phone in his pocket and does not look up.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "He ain't gonna be happy.", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "No.", "name": "ODALYS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "You gonna wait?", "name": "HOLLIS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "I have waited thirty years, Mr. Hollis. Ten minutes is nothing.", "name": "ODALYS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Are we still rolling?", "name": "CAL", "speaker": 4, "ext": [], "paren": ["behind the camera"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Nobody answers him.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}]}