{"scene_id": "s05057", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05057.fountain", "heading": "INT. ST. AGATHA'S CLINIC - EXAMINATION ROOM - NIGHT (1957)", "cast": [{"id": 0, "name": "DR. HALE", "names": ["DR. HALE"], "gender": "?", "first": 7, "spoke": 4}, {"id": 1, "name": "EDITH", "names": ["EDITH"], "gender": "f", "first": 4, "spoke": 2}, {"id": 2, "name": "MARGARET", "names": ["MARGARET"], "gender": "f", "first": 5, "spoke": 2}, {"id": 3, "name": "PRUITT", "names": ["PRUITT"], "gender": "m", "first": 8, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. ST. AGATHA'S CLINIC - EXAMINATION ROOM - NIGHT (1957)", "present": []}, {"u": 1, "kind": "action", "text": "Gaslight.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The walls sweat.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Somewhere, a pipe knocks.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Edith, 30s, in a pale dressing gown, sits on the edge of the table, hands folded.", "para": 1, "sent": 0, "present": [1]}, {"u": 5, "kind": "action", "text": "Margaret, 40s, the matron, stands at the instrument tray with her back turned, and in the dark corridor beyond them both a trolley rolls slowly and stops.", "para": 1, "sent": 1, "present": [1, 2]}, {"u": 6, "kind": "action", "text": "Silence.", "para": 2, "sent": 0, "present": [1, 2]}, {"u": 7, "kind": "action", "text": "Dr. Hale, 50s, enters with a lamp.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Behind him comes Mr. Pruitt, 60s, the clinic's night porter, hat in hand, who will not meet anyone's eye.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "You are comfortable, Mrs. Ashby?", "name": "DR. HALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Yes, Doctor.", "name": "EDITH", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Margaret hands him something under a cloth.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "She watches her hand, then Edith's, then the door.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Knock.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Knock.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Knock.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "It comes from inside the wall.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Doctor.", "name": "MARGARET", "speaker": 2, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "The pipes.", "name": "DR. HALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Those are not the pipes.", "name": "MARGARET", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Edith slides off the table.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "She takes one step and stops.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "The lamp gutters.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "In the corner, Pruitt's hat has fallen from his hand and he is looking at the floor, where something dark spreads along the boards toward her feet.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "It's been listening since the third floor.", "name": "PRUITT", "speaker": 3, "ext": [], "paren": ["a whisper"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Pruitt, enough.", "name": "DR. HALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "The knocking stops.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Nothing.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "The lamp steadies.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "She lets out a breath and he lets out a breath and for one long moment no one moves.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Then the trolley in the corridor rolls away, quietly, and is gone.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Is it finished?", "name": "EDITH", "speaker": 1, "ext": [], "paren": ["very small"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Dr. Hale sets down the cloth.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Underneath is only a thermometer.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Yes. Quite finished.", "name": "DR. HALE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Margaret turns the lamp down.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "She tries to smile.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}]}