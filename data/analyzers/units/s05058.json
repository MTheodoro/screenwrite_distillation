{"scene_id": "s05058", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05058.fountain", "heading": "EXT. FISHING TRAWLER \"MARGIT ANN\" - DECK - DAWN", "cast": [{"id": 0, "name": "ANIKA", "names": ["ANIKA"], "gender": "f", "first": 8, "spoke": 9}, {"id": 1, "name": "ROY", "names": ["ROY"], "gender": "m", "first": 7, "spoke": 6}, {"id": 2, "name": "TEO", "names": ["TEO"], "gender": "m", "first": 20, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FISHING TRAWLER \"MARGIT ANN\" - DECK - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Grey sea.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Grey sky.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Gulls wheel overhead.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Two deckhands haul nets, whistling.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "A third coils rope and is bored out of his mind.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "Everything is fine.", "para": 1, "sent": 2, "present": []}, {"u": 7, "kind": "action", "text": "Captain Roy Dunmore, 50s, leans on the rail with a mug, watching the horizon.", "para": 2, "sent": 0, "present": [1]}, {"u": 8, "kind": "action", "text": "Beside him, Dr. Anika Rao, 30s, sits on an upturned crate, clipboard on her knee.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "She is the ship's medic by contract and by accident.", "para": 2, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Quietest trip I've had in months.", "name": "ANIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Don't say that.", "name": "ROY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Why not?", "name": "ANIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "You know why not.", "name": "ROY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "The deckhands laugh at something.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "A gull lands on the winch.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "WHAM.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "A net swings loose.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "It slams into the deckhand's back.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He goes down hard.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "TEO, 20s, a deckhand, lies on the planks, face grey, one arm pinned.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Don't move him!", "name": "ANIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Get the line off him!", "name": "ROY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "The two deckhands scramble.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The gulls scatter.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Roy and Anika drop to their knees at the same time and almost collide.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Teo. Teo, look at me. Can you feel your hands?", "name": "ANIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "No.", "name": "TEO", "speaker": 2, "ext": [], "paren": ["strained"], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Okay. That's okay. Roy, I need the board and I need it flat.", "name": "ANIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Board's in the wheelhouse. Two minutes.", "name": "ROY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "You don't have two minutes.", "name": "ANIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Then tell me what to do.", "name": "ROY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Hold his head. Gently. Like it's glass.", "name": "ANIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Roy does.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Anika's hands move fast, over the neck, the ribs, the pulse.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "Doc. Am I", "name": "TEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "You're not going anywhere. I promise.", "name": "ANIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "You can't promise that.", "name": "ROY", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Watch me.", "name": "ANIKA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "This is the last time any of them will take the sea for granted.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "The deckhands return with the board.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Together, they roll him.", "para": 10, "sent": 1, "present": [0, 1, 2]}]}