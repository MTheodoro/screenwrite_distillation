{"scene_id": "s05059", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05059.fountain", "heading": "INT. NORTHERN CHECKPOINT - INSPECTION BOOTH - NIGHT", "cast": [{"id": 0, "name": "OFFICER OKAFOR", "names": ["OFFICER OKAFOR", "OKAFOR"], "gender": "f", "first": 4, "spoke": 14}, {"id": 1, "name": "THE TRAVELER", "names": ["THE TRAVELER"], "gender": "?", "first": 7, "spoke": 5}, {"id": 2, "name": "SUPERVISOR DUNNE", "names": ["SUPERVISOR DUNNE", "DUNNE"], "gender": "m", "first": 5, "spoke": 11}, {"id": 3, "name": "MIRELA", "names": ["MIRELA"], "gender": "f", "first": 23, "spoke": 6}, {"id": 4, "name": "LUKAS", "names": ["LUKAS"], "gender": "m", "first": 33, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. NORTHERN CHECKPOINT - INSPECTION BOOTH - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A booth of steel and glass.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A scanner hums.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Beyond the window, a line of vehicles stretches into fog.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "OFFICER OKAFOR, 40s, sits behind the desk.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Opposite her, a figure stands in a long coat, face hidden by a respirator mask.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "dialogue", "text": "Papers.", "name": "OKAFOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 7, "kind": "dialogue", "text": "They are all there.", "name": "THE TRAVELER", "speaker": 1, "ext": [], "paren": ["sliding a card across"], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "This card was issued in a year that has not happened yet.", "name": "OKAFOR", "speaker": 0, "ext": [], "paren": ["reading, a long beat"], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Then it is early. I apologise.", "name": "THE TRAVELER", "speaker": 1, "ext": [], "paren": ["beat"], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Remove the mask.", "name": "OKAFOR", "speaker": 0, "ext": [], "paren": ["setting it down"], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "I would prefer not to.", "name": "THE TRAVELER", "speaker": 1, "ext": [], "paren": ["beat"], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "That was not a request.", "name": "OKAFOR", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "SUPERVISOR DUNNE, 50s, enters from the back office, jacket over one arm.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Problem?", "name": "DUNNE", "speaker": 2, "ext": [], "paren": ["low, to Okafor"], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "The scanner says there is nobody inside the coat.", "name": "OKAFOR", "speaker": 0, "ext": [], "paren": ["not turning"], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "The scanner is old.", "name": "DUNNE", "speaker": 2, "ext": [], "paren": ["glancing at the screen"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "The scanner is new.", "name": "OKAFOR", "speaker": 0, "ext": [], "paren": ["beat"], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Please. Do not be frightened.", "name": "THE TRAVELER", "speaker": 1, "ext": [], "paren": ["slowly, lifting the mask with both hands"], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Step back.", "name": "OKAFOR", "speaker": 0, "ext": [], "paren": ["rising, hand on her holster"], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Officer. Easy.", "name": "DUNNE", "speaker": 2, "ext": [], "paren": ["raising a hand"], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "The mask comes away.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Underneath is a woman of perhaps thirty, tired, ordinary, with a scar through one eyebrow.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "My name is Mirela. I was born in this booth.", "name": "THE TRAVELER", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "That is not possible.", "name": "OKAFOR", "speaker": 0, "ext": [], "paren": ["a laugh, no humour"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "My mother stood where you are standing. She was a guard, and she told me, one day a woman will come with a card from tomorrow.", "name": "MIRELA", "speaker": 3, "ext": [], "paren": ["beat"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "And what did she say to do?", "name": "DUNNE", "speaker": 2, "ext": [], "paren": ["carefully"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "She said to let me through.", "name": "MIRELA", "speaker": 3, "ext": [], "paren": ["beat"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "She is lying.", "name": "OKAFOR", "speaker": 0, "ext": [], "paren": ["to Dunne"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Who is your mother?", "name": "DUNNE", "speaker": 2, "ext": [], "paren": ["to Mirela"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Your wife.", "name": "MIRELA", "speaker": 3, "ext": [], "paren": ["simply"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Sir?", "name": "OKAFOR", "speaker": 0, "ext": [], "paren": ["stunned"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "My wife has no children.", "name": "DUNNE", "speaker": 2, "ext": [], "paren": ["very still"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Booth three, we have a breach on the east lane. Repeat, east lane.", "name": "LUKAS", "speaker": 4, "ext": ["V.O."], "paren": ["over the intercom, crackling"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Hold position, Lukas.", "name": "OKAFOR", "speaker": 0, "ext": [], "paren": ["into the radio"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Send everyone to the east gate.", "name": "DUNNE", "speaker": 2, "ext": [], "paren": ["at the same time"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Sir, you cannot order that.", "name": "OKAFOR", "speaker": 0, "ext": [], "paren": ["overlapping, sharp"], "dual": true, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Tell me what she looked like.", "name": "DUNNE", "speaker": 2, "ext": [], "paren": ["softly, to Mirela"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Like you, but she laughed.", "name": "MIRELA", "speaker": 3, "ext": [], "paren": ["beat, gentle"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Open the barrier.", "name": "DUNNE", "speaker": 2, "ext": [], "paren": ["a long silence, then hoarse"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Sir.", "name": "OKAFOR", "speaker": 0, "ext": [], "paren": ["beat"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Open it.", "name": "DUNNE", "speaker": 2, "ext": [], "paren": ["turning on her, gently"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Barrier is open.", "name": "OKAFOR", "speaker": 0, "ext": [], "paren": ["after a long moment, pressing a button"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Thank you. Both of you.", "name": "MIRELA", "speaker": 3, "ext": [], "paren": ["lifting the mask, but not wearing it"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Will I see her?", "name": "DUNNE", "speaker": 2, "ext": [], "paren": ["beat"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "You already did. That is why it is a loop.", "name": "MIRELA", "speaker": 3, "ext": [], "paren": ["at the door, a small smile"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "She exits.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Okafor and Dunne stand side by side, watching the barrier rise into the fog.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}]}