{"scene_id": "s05062", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05062.fountain", "heading": "INT. RIDESHARE CAR - NIGHT", "cast": [{"id": 0, "name": "GWEN", "names": ["GWEN"], "gender": "f", "first": 4, "spoke": 5}, {"id": 1, "name": "RICKY", "names": ["RICKY"], "gender": "m", "first": 5, "spoke": 3}, {"id": 2, "name": "TASHA", "names": ["TASHA"], "gender": "f", "first": 6, "spoke": 5}, {"id": 3, "name": "BOB", "names": ["BOB"], "gender": "m", "first": 7, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. RIDESHARE CAR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "2 AM.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rain.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A hatchback, wipers going.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "GWEN, bride-to-be, in a wedding dress, sits in back.", "para": 0, "sent": 3, "present": [0]}, {"u": 5, "kind": "action", "text": "Next to her, RICKY, her ex.", "para": 0, "sent": 4, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Up front, TASHA drives.", "para": 0, "sent": 5, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Beside her, BOB, a stranger with a trombone case.", "para": 0, "sent": 6, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "So to confirm. Four people. One dress. Zero explanations.", "name": "TASHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "He's not with me.", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "I'm totally with her.", "name": "RICKY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "He's not WITH me with me.", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Silence.", "para": 1, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Bob.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Trombone.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Nothing.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "I got in the wrong car.", "name": "BOB", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "You got in the right car. You got in the wrong, uh, situation.", "name": "TASHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Her phone.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Dead.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Does anyone have a charger", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Glovebox. Next to my dignity.", "name": "TASHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "He opens it.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Empty.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Rain.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Gwen, the groom is at the church. Everyone is at the church. Why are we in a Honda?", "name": "RICKY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Because I ran. Okay? I ran. In heels.", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "For what it's worth, I think you look fantastic.", "name": "BOB", "speaker": 3, "ext": [], "paren": ["raising trombone case"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Beat.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "All three turn to him.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Sir, you're not even supposed to be here.", "name": "TASHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "I'm just saying. Great dress.", "name": "BOB", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "She laughs, then cries, then laughs.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "He hands her a napkin from the case.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Why does he have napkins in a trombone case.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Nobody asks.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Tasha stops the car.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Church.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Lights on.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Doors open.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "The groom, tiny in the distance, waving.", "para": 7, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Oh no.", "name": "RICKY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Oh no.", "name": "GWEN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Five stars everybody. Thats the best ride I ever had.", "name": "TASHA", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}