15, "kind": "action", "text": "A scrape.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Slow.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Mo said the vault was empty. Mo said nobody's in the back.", "name": "KIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Dripping.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Somewhere behind the boxes.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Kim. Look at the lock.", "name": "KIP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "The rear door latch.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Turning.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "By itself.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Nothing.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Then a long metal groan.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "MO, 50s, soaked, gray stubble, a crowbar in one hand and a flashlight in the other, steps through the opening into the dome light, grinning like a man whos won something.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Told you I'd catch up. Miss me?", "name": "MO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Kim and Kip look at each other.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Neither moves.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Mo is up front. Driving.", "name": "KIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Mo's grin stays.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The scraping starts again, from his side of the van.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Black.", "para": 11, "sent": 0, "present": [0, 1, 2]}]}