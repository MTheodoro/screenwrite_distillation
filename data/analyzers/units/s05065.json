{"scene_id": "s05065", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05065.fountain", "heading": "INT. SAFEKEEP SELF-STORAGE - UNIT 114 - DAY", "cast": [{"id": 0, "name": "LORNA PRESCOTT", "names": ["LORNA PRESCOTT", "LORNA"], "gender": "m", "first": 10, "spoke": 8}, {"id": 1, "name": "WALT PRESCOTT", "names": ["WALT PRESCOTT", "WALT"], "gender": "m", "first": 10, "spoke": 7}, {"id": 2, "name": "INES", "names": ["INES"], "gender": "m", "first": 10, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. SAFEKEEP SELF-STORAGE - UNIT 114 - DAY", "present": []}, {"u": 1, "kind": "action", "text": "ON CAMERA.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A handheld camcorder, the red light blinking.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Orange roll-up door half raised, daylight in a bar across a concrete floor.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Dust in the air.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Boxes.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "A dressmaker's mannequin in a 1960s wedding gown yellowed to the colour of tea.", "para": 0, "sent": 5, "present": []}, {"u": 7, "kind": "action", "text": "A Singer sewing machine under a quilt.", "para": 0, "sent": 6, "present": []}, {"u": 8, "kind": "action", "text": "A record player.", "para": 0, "sent": 7, "present": []}, {"u": 9, "kind": "action", "text": "Stacks of Life magazines.", "para": 0, "sent": 8, "present": []}, {"u": 10, "kind": "action", "text": "LORNA PRESCOTT, 60s, cardigan, reading glasses on a chain, stands beside WALT PRESCOTT, 70, her brother, in a windbreaker and a cap that says Korea Veteran, and behind them, filming, INES, 20s, their niece, her sleeves rolled, the camera at her chest.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Silence.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Dust.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "She'd have hated this lighting.", "name": "LORNA", "speaker": 0, "ext": [], "paren": ["running a finger along the mannequin's sleeve"], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Everybody hates that lighting. Doesn't mean it's wrong.", "name": "WALT", "speaker": 1, "ext": [], "paren": ["not looking up from a box"], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Aunt Lorna, can you say what this is for the tape?", "name": "INES", "speaker": 2, "ext": [], "paren": ["from behind the camera, gently"], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "This is Mother's wedding dress. Nineteen sixty-two. She made it herself on that machine.", "name": "LORNA", "speaker": 0, "ext": [], "paren": ["sighing, turning to face the lens"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Nothing.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "A truck outside.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Reversing.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Patsy Cline. I told you she kept the records.", "name": "WALT", "speaker": 1, "ext": [], "paren": ["lifting out a record, reading the sleeve"], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "You told me she kept nothing.", "name": "LORNA", "speaker": 0, "ext": [], "paren": ["not unkindly"], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "I was wrong about a lot of things in 1985.", "name": "WALT", "speaker": 1, "ext": [], "paren": ["setting it down very carefully"], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Ines pans, slowly.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "A shelf of mason jars.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Buttons.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "A tin of thread.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "A child's shoe.", "para": 7, "sent": 4, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Whose is the shoe?", "name": "INES", "speaker": 2, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Mine. I think. Or Walter's. It's too small for either of us now.", "name": "LORNA", "speaker": 0, "ext": [], "paren": ["after a long moment, picking it up"], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Mine. See the heel. I wore it down running from Dad.", "name": "WALT", "speaker": 1, "ext": [], "paren": ["taking it from her hands, turning it over"], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "You never ran from Dad.", "name": "LORNA", "speaker": 0, "ext": [], "paren": ["laughing despite herself"], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Oh, I ran.", "name": "WALT", "speaker": 1, "ext": [], "paren": ["smiling, not looking at her"], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Dust.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Light.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Should we keep any of it?", "name": "INES", "speaker": 2, "ext": [], "paren": ["lowering the camera slightly, then raising it again"], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "That. And the dress.", "name": "LORNA", "speaker": 0, "ext": [], "paren": ["placing the shoe in her handbag, closing the clasp"], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "And this.", "name": "WALT", "speaker": 1, "ext": [], "paren": ["nodding, tapping the Singer"], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "You don't sew.", "name": "LORNA", "speaker": 0, "ext": [], "paren": ["wryly"], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "I might start.", "name": "WALT", "speaker": 1, "ext": [], "paren": ["grinning"], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Quiet.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "The three of them stand in the bar of daylight, looking at the unit, the long life of one woman in a ten-by-ten room.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Okay. That's the whole unit. I'm turning it off.", "name": "INES", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Leave it on a minute more.", "name": "LORNA", "speaker": 0, "ext": [], "paren": ["reaching toward the lens"], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "The red light blinks.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Nothing happens.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Nothing happens for a very long time.", "para": 10, "sent": 2, "present": [0, 1, 2]}]}