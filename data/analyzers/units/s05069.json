{"scene_id": "s05069", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05069.fountain", "heading": "INT. NIGHTBIRD STUDIOS - CONTROL ROOM - NIGHT", "cast": [{"id": 0, "name": "REGGIE", "names": ["REGGIE"], "gender": "m", "first": 5, "spoke": 6}, {"id": 1, "name": "SHAY", "names": ["SHAY"], "gender": "f", "first": 6, "spoke": 8}, {"id": 2, "name": "OMAR", "names": ["OMAR"], "gender": "m", "first": 7, "spoke": 9}, {"id": 3, "name": "KAT", "names": ["KAT"], "gender": "?", "first": 8, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHTBIRD STUDIOS - CONTROL ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Rain on the skylight.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Amber light from the console.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A dozen VU meters twitch in the dark.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Through the glass, the live room: a vocal booth, a lone mic on a stand, a grand piano under a sheet.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "REGGIE, 50s, owner, silver ponytail, a cardigan with a hole in the elbow, sits at the board.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Beside him, SHAY, 20s, the artist, hoodie up, headphones around her neck.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "By the door, leaning on the wall with a paper cup of coffee gone cold, OMAR, 40s, in a wool coat that is too good for the room.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "And on the leather couch, KAT, 30s, her laptop open on her knees, typing.", "para": 2, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "A clock above the door.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "1:12.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Thunder, distant.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "ON SCREEN: Kat's laptop.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "An email, subject line \"Master Delivery - FINAL\", sent 11:58 PM, from an address the label has never used.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Run it back.", "name": "REGGIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "He hits a key.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "The speakers fill with a vocal take, ghostly, a voice of ice.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "It ends.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Silence.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "That's the one.", "name": "SHAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "That's not the one.", "name": "OMAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Omar.", "name": "SHAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "That's a take. That's a very nice take. It's not the one that goes on the record.", "name": "OMAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "It's the one I meant.", "name": "SHAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "You meant it in July. You meant it in July with a different man in the room.", "name": "OMAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Reggie shifts in his chair.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "The meters twitch.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Don't.", "name": "SHAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "I'm just saying where the money is.", "name": "OMAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "The thunder again, closer.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "The wire cleared at eleven fifty-eight. Both accounts. Just so everybody knows.", "name": "KAT", "speaker": 3, "ext": [], "paren": ["without looking up"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Reggie stops.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Turns slowly.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "What wire?", "name": "REGGIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Oh. Nothing. Forget I said it.", "name": "KAT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Kat.", "name": "SHAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Kat.", "name": "OMAR", "speaker": 2, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "What wire, Kat?", "name": "REGGIE", "speaker": 0, "ext": [], "paren": ["standing"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "She closes the laptop.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Everything in the room seems to lean toward her.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Rain drums harder on the skylight.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "Reggie, you've been mixing other people's lies for thirty years. You really want to hear this one in your own studio?", "name": "KAT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "In my studio, yes.", "name": "REGGIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "The album isn't hers. Never was. The masters belong to a company in Nevada that belongs to a company in Delaware that belongs to Omar. Shay signed it in July. She didn't read it. Reggie, you didn't read it. I read it. I'm the only one who ever read it.", "name": "KAT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "You work for me.", "name": "REGGIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "I work for whoever pays the rent on the building you're about to lose.", "name": "KAT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Omar. Is that true?", "name": "SHAY", "speaker": 1, "ext": [], "paren": ["very quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Shay, it's a standard deal.", "name": "OMAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Is it true?", "name": "SHAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "It's business. It was always going to be business. You wanted to be heard by two million people, somebody has to own the room.", "name": "OMAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "You sat with me for six months. You told me my father's songs mattered.", "name": "SHAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "They do. They're worth a lot.", "name": "OMAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "A long stillness.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Shay takes the headphones from around her neck and sets them very gently on the console.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Reggie sits back down heavily.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "He looks suddenly old.", "para": 11, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Thirty years. Never once did I let anyone take the tape out of this building.", "name": "REGGIE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "The tape is the least of it.", "name": "KAT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "Rain.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "Thunder breaks directly overhead.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "In the live room, the piano sheet slides slowly off its shoulders and falls to the floor.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "The lights flicker.", "para": 12, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "When they come back, Omar is standing in front of the door, one hand on the knob, and he is no longer smiling.", "para": 12, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "Nobody's walking out of here with a copy.", "name": "OMAR", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "Shay reaches for the red button on the console marked RECORD, and presses it.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}]}