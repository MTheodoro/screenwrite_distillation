S", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Fair.", "name": "MAYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "She laughs.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "He doesn't look up.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "A drip lands in a bucket.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Plink.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Nothing.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Joss. Why are you holding your phone like that?", "name": "MAYA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Like what?", "name": "JOSS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Like it's a grenade.", "name": "MAYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "He turns the screen toward her.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "A group chat.", "para": 15, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Her name at the top.", "para": 15, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "A photo of her, at the till, from this afternoon.", "para": 15, "sent": 3, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Bee sent me this. Asked me to keep you here.", "name": "JOSS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Her phone.", "para": 16, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Buzzing.", "para": 16, "sen