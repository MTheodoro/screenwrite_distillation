{"scene_id": "s05071", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05071.fountain", "heading": "INT. NIGHT BUS - MOVING - NIGHT", "cast": [{"id": 0, "name": "SAM", "names": ["SAM"], "gender": "m", "first": 2, "spoke": 26}, {"id": 1, "name": "MO", "names": ["MO"], "gender": "?", "first": 2, "spoke": 23}, {"id": 2, "name": "THE BAND", "names": ["BAND", "THE BAND"], "gender": "p", "first": 3, "spoke": 3}, {"id": 3, "name": "BUS DRIVER", "names": ["BUS DRIVER", "DRIVER"], "gender": "m", "first": 7, "spoke": 2}, {"id": 4, "name": "OLD WOMAN", "names": ["OLD WOMAN"], "gender": "f", "first": 15, "spoke": 0}, {"id": 5, "name": "TEENAGERS", "names": ["TEENAGERS"], "gender": "?", "first": 29, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT BUS - MOVING - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "the 3am route out of the city. mostly empty. heater ticking. snow in the headlights, getting thicker.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "SAM, 30s, sits sideways across two seats with a backpack on his lap. across the aisle, MO, 20s, eats crisps out of a tiny bag.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 3, "kind": "action", "text": "at the back, THE BAND (four teenagers, guitar cases, one amp) slumps against each other, half asleep.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 4, "kind": "dialogue", "text": "is it me or are we going slower", "name": "SAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "we're going slower", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "cool. cool cool cool.", "name": "SAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "the BUS DRIVER, unseen but for his cap in the mirror, hums along to the radio.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "you want one", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "what are they", "name": "SAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "salt and vinegar. i think. the bag's gone soft.", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "yeah ok", "name": "SAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "mo tosses the bag. sam catches it, drops half.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "sorry", "name": "SAM", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "it's fine, sam. it's like, a crisp.", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "an OLD WOMAN at the front, asleep, a small DOG in her coat. the dog looks at sam. sam looks at the dog.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "that dog hates me", "name": "SAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "that dog's seen things", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "ten more minutes.", "name": "THE BAND", "speaker": 2, "ext": [], "paren": ["mumbling, in unison, not awake"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "they're asleep, right", "name": "SAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "they're so asleep", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "the bus slows. slows. the engine note drops.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "mo", "name": "SAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "yeah", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "that's not a stop", "name": "SAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "the bus rolls to a halt in the middle of a white nothing. the driver cuts the engine. the heater stops ticking.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "quiet. the radio hums on batteries.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "are we there", "name": "THE BAND", "speaker": 2, "ext": [], "paren": ["waking, in unison"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "not really, no", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "two TEENAGERS in school hoodies, a row ahead, look up from a shared pair of earbuds. look out the window. look back down.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "should we be worried", "name": "SAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "i think we should be a little worried", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "how much is a little", "name": "SAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "like. a sixth.", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "a sixth. ok. i can do a sixth.", "name": "SAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "the driver stands, pulls on a coat.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "dialogue", "text": "folks, bit of snow on the road. stay put. i'll radio in.", "name": "DRIVER", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "he steps off. the doors sigh. cold rolls down the aisle.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "he's going to radio in", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "from where", "name": "SAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "from outside, i guess", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "this is not a radio situation", "name": "SAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "sam", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "what", "name": "SAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "you're being weird. it's fine. people get stuck. buses get unstuck.", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "yeah", "name": "SAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "this is the last quiet moment before the night gets long.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "can we have the heater back", "name": "THE BAND", "speaker": 2, "ext": [], "paren": ["whispered, in unison"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "dialogue", "text": "i'm so sorry. the heater is gone.", "name": "SAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "dialogue", "text": "we'll take turns", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "dialogue", "text": "turns doing what", "name": "SAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "dialogue", "text": "being warm. it's a thing. you pass it.", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "sam laughs, a little, then stops.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "the old woman wakes up. looks around. says nothing. shuts her eyes again. the dog sighs.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "dialogue", "text": "mo", "name": "SAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "yeah", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "if this goes bad, i just want you to know i like your coat", "name": "SAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "it's my brother's coat", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "dialogue", "text": "i like him too", "name": "SAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "mo throws a crisp at him. it hits his forehead. he leaves it there.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "action", "text": "outside, the snow keeps falling. the road is gone. the windows fog.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "dialogue", "text": "big dave's gonna be so mad i'm late", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "dialogue", "text": "who's big dave", "name": "SAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "dialogue", "text": "my boss. he's not even big. we just have two daves.", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "dialogue", "text": "that's the worst reason", "name": "SAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "dialogue", "text": "it's the only reason", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "action", "text": "the driver climbs back on, shoulders white.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "dialogue", "text": "okay. we wait.", "name": "DRIVER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "action", "text": "he sits. takes off the cap. wipes his face.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "action", "text": "nobody speaks. the dog snores. somewhere in the dark, a plough, maybe, or just wind.", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "dialogue", "text": "mo", "name": "SAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "dialogue", "text": "yeah", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "dialogue", "text": "thanks for the crisps", "name": "SAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "dialogue", "text": "you didn't eat them", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "dialogue", "text": "i held them very respectfully", "name": "SAM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 75, "kind": "action", "text": "the bus creaks. the snow settles. they wait.", "para": 20, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}