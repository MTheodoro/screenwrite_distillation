{"scene_id": "s05072", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05072.fountain", "heading": "EXT. THE SALTY BISCUIT - FISHING BOAT - DAWN", "cast": [{"id": 0, "name": "CAPTAIN PIP", "names": ["CAPTAIN PIP"], "gender": "?", "first": 4, "spoke": 7}, {"id": 1, "name": "MARLO", "names": ["MARLO"], "gender": "?", "first": 5, "spoke": 3}, {"id": 2, "name": "BERNIE", "names": ["BERNIE"], "gender": "f", "first": 10, "spoke": 3}, {"id": 3, "name": "OLLIE", "names": ["OLLIE"], "gender": "?", "first": 14, "spoke": 3}, {"id": 4, "name": "NINA", "names": ["NINA"], "gender": "f", "first": 19, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. THE SALTY BISCUIT - FISHING BOAT - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Calm sea.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Pink sky.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A little wooden boat bobbing like a bath toy.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "dialogue", "text": "Nobody touch the net. Nobody even think about the net.", "name": "CAPTAIN PIP", "speaker": 0, "ext": [], "paren": ["polishing the brass compass with their sleeve, not looking up"], "dual": false, "present": [0]}, {"u": 5, "kind": "dialogue", "text": "I'm not thinking about it. I'm just... standing near it.", "name": "MARLO", "speaker": 1, "ext": [], "paren": ["a crab, hiding behind a bucket, tapping the net with one claw"], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Thinking loudly.", "name": "CAPTAIN PIP", "speaker": 0, "ext": [], "paren": ["without turning"], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Silence.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Gulls.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Far away.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Morning, Captain! Lovely morning for a completely innocent morning.", "name": "BERNIE", "speaker": 2, "ext": [], "paren": ["a seagull, landing on the rail with a flap, a fish in their beak that is clearly not theirs"], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Bernie.", "name": "CAPTAIN PIP", "speaker": 0, "ext": [], "paren": ["raising one eyebrow at the fish"], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "What fish?", "name": "BERNIE", "speaker": 2, "ext": [], "paren": ["swallowing it whole"], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Nothing.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Captain. The sea is humming again.", "name": "OLLIE", "speaker": 3, "ext": [], "paren": ["a brass lantern hanging from the mast, swinging, lighting up and dimming as they speak"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Hm.", "name": "CAPTAIN PIP", "speaker": 0, "ext": [], "paren": ["finally setting down the compass, listening"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Waves.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Slap, slap.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "It only hums when something's coming.", "name": "OLLIE", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Cocoa's ready. Who wants cocoa?", "name": "NINA", "speaker": 4, "ext": [], "paren": ["a girl of nine, in a yellow raincoat, climbing up from below deck with a mug"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Me.", "name": "MARLO", "speaker": 1, "ext": [], "paren": ["from behind the bucket, hopeful"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Me!", "name": "BERNIE", "speaker": 2, "ext": [], "paren": ["at the same time, wings out"], "dual": true, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Captain gets the first sip. That's the rule.", "name": "NINA", "speaker": 4, "ext": [], "paren": ["handing the mug to Captain Pip first, steady, careful not to spill"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "That's the rule.", "name": "CAPTAIN PIP", "speaker": 0, "ext": [], "paren": ["taking it, holding it with both hands, a very small smile"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "A bubble rises beside the boat.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Pop.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Another.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Pop.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "It's here.", "name": "OLLIE", "speaker": 3, "ext": [], "paren": ["flickering low"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Everyone freezes.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Even the gull.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Is it a big one?", "name": "NINA", "speaker": 4, "ext": [], "paren": ["very quietly, tucking her hand into the Captain's coat pocket"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Biggest I've ever seen.", "name": "CAPTAIN PIP", "speaker": 0, "ext": [], "paren": ["sipping, eyes on the water"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Rain.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "No. Just spray.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Should we run?", "name": "MARLO", "speaker": 1, "ext": [], "paren": ["creeping out from behind the bucket, claws up"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "We should say hello.", "name": "CAPTAIN PIP", "speaker": 0, "ext": [], "paren": ["setting the mug on the rail"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "The water rises, slow and glassy, a long blue curve.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Silence.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}]}