{"scene_id": "s05074", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05074.fountain", "heading": "INT. THE ROYAL OAK FUNCTION ROOM - NIGHT", "cast": [{"id": 0, "name": "TIM HARGREAVES", "names": ["TIM HARGREAVES", "TIM"], "gender": "m", "first": 6, "spoke": 12}, {"id": 1, "name": "TOM HARGRAVE", "names": ["TOM HARGRAVE", "TOM"], "gender": "m", "first": 7, "spoke": 11}, {"id": 2, "name": "WAITER", "names": ["WAITER"], "gender": "m", "first": 8, "spoke": 0}, {"id": 3, "name": "WEDDING GUEST'S DOG", "names": ["WEDDING GUEST'S DOG"], "gender": "?", "first": 10, "spoke": 0}, {"id": 4, "name": "HATTIE", "names": ["HATTIE"], "gender": "f", "first": 18, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. THE ROYAL OAK FUNCTION ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Bunting, half-fallen.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A disco ball turning slowly over an empty dance floor.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Somewhere, a speaker plays something by Take That, very quietly, as if embarrassed.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Outside, rain on the car park.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "The sort that can't be bothered to stop.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "TIM HARGREAVES (40s, tie round his head like a headband, pint in each hand) sits on a stack of chairs.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Opposite him, TOM HARGRAVE (40s, immaculate, one button undone, a medal in a velvet box on his knee).", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "A WAITER wheels a trolley of cold sausage rolls between them.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Neither takes one.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "A WEDDING GUEST'S DOG, a spaniel in a bow tie, sleeps under a table.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Lovely do.", "name": "TIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Mm.", "name": "TOM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Lovely speech, as well. The bit about the cricket.", "name": "TIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "I wasn't talking about cricket.", "name": "TOM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Weren't you? I thought you were.", "name": "TIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Quiet.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "The disco ball turns.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "HATTIE (30s, bridesmaid, shoes in hand) drifts over, a plate of trifle balanced on her wrist.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Right, you two. Dad says you're to stop sulking by the buffet.", "name": "HATTIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "We're not sulking, Hattie.", "name": "TOM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "We're discussing.", "name": "TIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "You're discussing a medal in a box, Tim. In the corner. At my sister's wedding.", "name": "HATTIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "It's Tom's medal.", "name": "TIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "It's our medal, strictly speaking.", "name": "TOM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Of course it is.", "name": "HATTIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "She eats a spoonful of trifle.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Looks from one to the other.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Tom. Tim. You were twenty-two. It was a relay. It was nineteen years ago.", "name": "HATTIE", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Nineteen and a half.", "name": "TIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "And I'd have won if someone had passed the baton.", "name": "TOM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "I passed the baton.", "name": "TIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "You threw the baton.", "name": "TOM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "A pause.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "The waiter reverses his trolley, very slowly, out of range.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "I tripped, Tom.", "name": "TIM", "speaker": 0, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "You tripped on purpose.", "name": "TOM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Don't be absurd.", "name": "TIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "You told Gillian I'd cheated at the trials. She told the committee.", "name": "TOM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "That was a joke!", "name": "TIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Nineteen years, Tim. Nineteen years, and every Christmas, it's a joke.", "name": "TOM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "The spaniel wakes.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Lifts its head.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Boys, please. My sister is cutting the cake in an hour.", "name": "HATTIE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "I am not having this, Tom. Not here.", "name": "TIM", "speaker": 0, "ext": [], "paren": ["standing"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Then where?", "name": "TOM", "speaker": 1, "ext": [], "paren": ["standing"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Beat.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Tim sets down both pints.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Tom puts the medal on the chair.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "The disco ball catches the light.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Outside.", "name": "TIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "dialogue", "text": "Outside.", "name": "TOM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "They go.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "The doors swing shut behind them.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "A single sausage roll rolls off the trolley and lands on the floor.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "Right. Well. That's the evening.", "name": "HATTIE", "speaker": 4, "ext": [], "paren": ["to the spaniel"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Rain.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "A shout, muffled.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "A crash of metal bins.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "The spaniel puts its head back down.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}]}