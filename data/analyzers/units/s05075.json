{"scene_id": "s05075", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05075.fountain", "heading": "INT. RIDESHARE CAR - MOVING - NIGHT", "cast": [{"id": 0, "name": "DRIVER", "names": ["DRIVER"], "gender": "m", "first": 5, "spoke": 9}, {"id": 1, "name": "THE TWINS", "names": ["TWINS", "THE TWINS"], "gender": "p", "first": 6, "spoke": 9}, {"id": 2, "name": "NARRATOR", "names": ["NARRATOR"], "gender": "?", "first": 12, "spoke": 1}, {"id": 3, "name": "PRIYA", "names": ["PRIYA"], "gender": "f", "first": 32, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. RIDESHARE CAR - MOVING - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "HANDHELD.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A dashboard camera and a small phone-cam on the headrest.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Grainy.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Streetlights smear past.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ON CAMERA: a DRIVER, 40s, hands at ten and two, eyes in the mirror.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "In the back seat, THE TWINS (nine, matching pyjama tops, one asleep on the other's shoulder).", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "You're sure you want me on camera? It's mostly just driving.", "name": "DRIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Yes.", "name": "THE TWINS", "speaker": 1, "ext": [], "paren": ["together, sleepy"], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Okay then. Hello, internet.", "name": "DRIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She laughs.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "The road hums.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "At two in the morning, every city looks like a memory of itself.", "name": "NARRATOR", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Red light.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "The car stops.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Nobody speaks.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "So. Where's your mum tonight?", "name": "DRIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Hospital.", "name": "THE TWINS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Oh. Sorry, love. Is she -- is she going to be all right?", "name": "DRIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "The baby's coming.", "name": "THE TWINS", "speaker": 1, "ext": [], "paren": ["together"], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Oh! Well, that's different. That's good.", "name": "DRIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "She turns round.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Smiles.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "They don't, quite.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "We're meant to be asleep at Nan's.", "name": "THE TWINS", "speaker": 1, "ext": [], "paren": ["together, small"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "And instead you're in a stranger's car at two a.m. with a camera pointed at you.", "name": "DRIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Dad's meeting us. He said ring a cab.", "name": "THE TWINS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "I'm not a cab. I'm a rideshare.", "name": "DRIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Is it different?", "name": "THE TWINS", "speaker": 1, "ext": [], "paren": ["together"], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "It's about four pounds different.", "name": "DRIVER", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Green light.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "They move.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "My name's Priya, by the way. Priya. In case your dad asks.", "name": "DRIVER", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "You can say it back to me. So I know you know it.", "name": "PRIYA", "speaker": 3, "ext": [], "paren": ["into the mirror"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Priya.", "name": "THE TWINS", "speaker": 1, "ext": [], "paren": ["together"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Good. That's one safety rule down.", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "She taps the wheel.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "The hospital sign, glowing, rises out of the dark.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "This is the last ride before the family changes shape.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Nearly there. She'll have the baby by the time we find a parking space.", "name": "PRIYA", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "She said that last time too.", "name": "THE TWINS", "speaker": 1, "ext": [], "paren": ["together"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "And was she right?", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Yes.", "name": "THE TWINS", "speaker": 1, "ext": [], "paren": ["together"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "The car slows.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "A man in a coat waves under the hospital canopy.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "The twins sit up, instantly awake.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "There he is.", "name": "PRIYA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "The door opens.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Cold air.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "They climb out, hand in hand, and run.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Priya watches them go, then turns the phone-cam toward herself.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Five stars, please. And if you're reading this, congratulations.", "name": "PRIYA", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "transition", "text": "CUT TO BLACK.", "present": [0, 1, 2, 3]}]}