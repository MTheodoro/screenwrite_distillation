{"scene_id": "s05076", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05076.fountain", "heading": "INT. BORDER CHECKPOINT - BOOTH - DAY", "cast": [{"id": 0, "name": "GUARD", "names": ["GUARD"], "gender": "m", "first": 5, "spoke": 8}, {"id": 1, "name": "THE BAND", "names": ["BAND", "THE BAND"], "gender": "p", "first": 8, "spoke": 7}, {"id": 2, "name": "WALT", "names": ["WALT"], "gender": "m", "first": 41, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. BORDER CHECKPOINT - BOOTH - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A cramped booth.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A fan that's seen better decades.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A gate arm.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A vending machine that only sells one flavour.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A GUARD (50s, belly, clipboard, tired eyes) sits and eats a sandwich.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A sign behind him reads: NEXT WINDOW PLEASE.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "A beat-up van pulls up outside.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Its side reads: THE GENTLE BASTARDS - TOUR 2025.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "THE BAND (four people, leather jackets, instruments) climbs out in a line and walks up to the window.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "Passports.", "name": "GUARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Hi!", "name": "THE BAND", "speaker": 1, "ext": [], "paren": ["in unison, ragged"], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "APPLAUSE.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "That's cute. Passports.", "name": "GUARD", "speaker": 0, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Here.", "name": "THE BAND", "speaker": 1, "ext": [], "paren": ["handing them over in a stack"], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "He flips through.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Stops.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "You're all Gary.", "name": "GUARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "It's a stage name.", "name": "THE BAND", "speaker": 1, "ext": [], "paren": ["shrugging"], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "dialogue", "text": "It's the same name on four passports.", "name": "GUARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "We're consistent.", "name": "THE BAND", "speaker": 1, "ext": [], "paren": ["proudly"], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "LAUGHS.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "The Guard sighs, puts down his sandwich and picks up his phone.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "A text lights up the screen.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "ON PHONE: dad where r u ON PHONE: ur shift ends in 10", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Busy, Mel. Border stuff.", "name": "GUARD", "speaker": 0, "ext": [], "paren": ["typing"], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "He puts it down.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Looks at the band again.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "A pause.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Too long.", "para": 9, "sent": 3, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Where's the drummer?", "name": "GUARD", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "What drummer?", "name": "THE BAND", "speaker": 1, "ext": [], "paren": ["looking at each other"], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "The one in the van.", "name": "GUARD", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Beat.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "The band turns slowly.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "In the van window, a tiny dog in sunglasses stares back at them.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "WOOF.", "para": 10, "sent": 3, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "APPLAUSE.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "That's not a drummer. That's a dog.", "name": "GUARD", "speaker": 0, "ext": ["CONT'D"], "paren": ["standing, finally"], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "He's a very good dog.", "name": "THE BAND", "speaker": 1, "ext": [], "paren": ["quietly, to each other"], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "The Guard reads the name on his badge, taps it.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "WALT.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "Call me Walt. And your dog goes in the quarantine bay.", "name": "WALT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "We've never been so insulted.", "name": "THE BAND", "speaker": 1, "ext": [], "paren": ["in unison"], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Walt hits a button.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "The gate arm drops.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "The fan whirs.", "para": 13, "sent": 2, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "That's two hours, folks. Enjoy the vending machine.", "name": "WALT", "speaker": 2, "ext": ["CONT'D"], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "A beat.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Then the vending machine, from nowhere, drops a can of soup.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "THUNK.", "para": 14, "sent": 2, "present": [0, 1, 2]}, {"u": 51, "kind": "transition", "text": "LAUGHS. APPLAUSE. CUT TO:", "present": [0, 1, 2]}]}