{"scene_id": "s05077", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05077.fountain", "heading": "INT. NOVALOOP STARTUP OFFICE - NIGHT", "cast": [{"id": 0, "name": "TEAM", "names": ["TEAM"], "gender": "p", "first": 5, "spoke": 0}, {"id": 1, "name": "KIM", "names": ["KIM"], "gender": "?", "first": 6, "spoke": 10}, {"id": 2, "name": "KIP", "names": ["KIP"], "gender": "m", "first": 7, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. NOVALOOP STARTUP OFFICE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "An open-plan office, lit only by monitors.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Beanbags.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A whiteboard covered in arrows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Takeaway boxes on every desk.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "THE TEAM (six developers) sits in a row of desks, headphones on, typing in perfect sync.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "KIM sits at a corner desk, laptop open, hood up.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "KIP, in a cardigan, approaches slowly with two mugs.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Kip sets one mug down.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Kim doesn't look up.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I made you tea.", "name": "KIP", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "Thanks.", "name": "KIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Kip waits.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Kim keeps typing.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "THE TEAM keeps typing.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "You've been on that file for an hour.", "name": "KIP", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Just tidying up.", "name": "KIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Kip glances at the screen.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Looks away.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Looks back.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "ON SCREEN: a file labelled CLIENTS_Q3.xlsx, uploading to an external server.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "67%.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "ON PHONE: (Kim's phone, face-up) you have 10 min. don't be late.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "That isn't tidying.", "name": "KIP", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "It's a backup.", "name": "KIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "To who?", "name": "KIP", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Kim stops typing.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Slowly closes the laptop halfway.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Looks up.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Kip.", "name": "KIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Kim. I'm not stupid. I wrote half that database.", "name": "KIP", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "I know.", "name": "KIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "THE TEAM stops typing.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "All six heads turn at once.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "They've got us on a deadline, and now you're sending the clients off the books.", "name": "KIP", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "It's a lot of money. More than I'll ever make here.", "name": "KIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "It's stealing.", "name": "KIP", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "It's leverage.", "name": "KIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "The upload bar pings.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "100%.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "Kip steps back.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "THE TEAM stands as one.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Nobody speaks.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "A printer somewhere clicks.", "para": 11, "sent": 3, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Please sit down. Please.", "name": "KIM", "speaker": 1, "ext": ["CONT'D"], "paren": ["softly"], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "No.", "name": "KIP", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "They turn and walk toward the exit.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Kim stands.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "Kip!", "name": "KIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Kip keeps walking.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "The door opens.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Kip stops in the frame.", "para": 13, "sent": 2, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "ON PHONE: (Kip's, buzzing) call me when ur out. we need to talk about kim.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Kip turns back, phone in hand, and holds it up.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Kim reads it.", "para": 15, "sent": 1, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Goes pale.", "para": 15, "sent": 2, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "That wasn't meant for you.", "name": "KIM", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "dialogue", "text": "I know. That's why it's so good.", "name": "KIP", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}