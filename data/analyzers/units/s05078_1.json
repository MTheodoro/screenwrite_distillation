{"scene_id": "s05078_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05078.fountain", "heading": "EXT. THE OLD PUMP STATION - CONTINUOUS", "cast": [{"id": 0, "name": "DANA", "names": ["DANA"], "gender": "f", "first": 3, "spoke": 5}, {"id": 1, "name": "COLE", "names": ["COLE"], "gender": "m", "first": 1, "spoke": 12}, {"id": 2, "name": "HANK", "names": ["HANK"], "gender": "m", "first": 2, "spoke": 5}, {"id": 3, "name": "ROSA", "names": ["ROSA"], "gender": "f", "first": 10, "spoke": 3}, {"id": 4, "name": "ELI", "names": ["ELI"], "gender": "m", "first": 12, "spoke": 3}, {"id": 5, "name": "TESS", "names": ["TESS"], "gender": "f", "first": 1, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "EXT. THE OLD PUMP STATION - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Cole stops ten feet from Tess.", "para": 0, "sent": 0, "present": [1, 5]}, {"u": 2, "kind": "action", "text": "Hank stops beside him.", "para": 0, "sent": 1, "present": [1, 2, 5]}, {"u": 3, "kind": "action", "text": "Dana lowers the megaphone.", "para": 0, "sent": 2, "present": [0, 1, 2, 5]}, {"u": 4, "kind": "action", "text": "The drum goes quiet.", "para": 0, "sent": 3, "present": [0, 1, 2, 5]}, {"u": 5, "kind": "dialogue", "text": "You're on public land, Cole.", "name": "DANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 5]}, {"u": 6, "kind": "dialogue", "text": "Dana. The lease says otherwise.", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 5]}, {"u": 7, "kind": "dialogue", "text": "Leases can be wrong.", "name": "DANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 5]}, {"u": 8, "kind": "dialogue", "text": "Not this one.", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 5]}, {"u": 9, "kind": "dialogue", "text": "Folks. It's a hundred and four degrees.", "name": "HANK", "speaker": 2, "ext": [], "paren": ["wearily"], "dual": false, "present": [0, 1, 2, 5]}, {"u": 10, "kind": "dialogue", "text": "Then you'll want to move that truck.", "name": "ROSA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5]}, {"u": 11, "kind": "dialogue", "text": "I've got a signed order.", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5]}, {"u": 12, "kind": "dialogue", "text": "We've got a river.", "name": "ELI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 13, "kind": "dialogue", "text": "You've got a barrel of concrete and a drum.", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 14, "kind": "dialogue", "text": "And a lot of water bottles.", "name": "TESS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 15, "kind": "dialogue", "text": "Tess, honey, this isn't what I signed up for.", "name": "HANK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 16, "kind": "dialogue", "text": "Sheriff, none of us signed up for the end of the world.", "name": "TESS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 17, "kind": "dialogue", "text": "That's a bit dramatic.", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 18, "kind": "dialogue", "text": "It's a drought, Cole. Seven years. You want dramatic, go look at Miller's well.", "name": "DANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "I've seen Miller's well.", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Then you know.", "name": "ROSA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "I know there's a hundred jobs on that derrick.", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "And a thousand people downriver.", "name": "ELI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "Cole, they've got a point.", "name": "HANK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Hank, whose side are you on?", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "dialogue", "text": "I'm on the side with the shade.", "name": "HANK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "A beat.", "para": 1, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "Dana almost laughs.", "para": 1, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Cole. Walk away. Take the order back to the office and tell them the town said no.", "name": "DANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "They won't hear it.", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Then make them.", "name": "DANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "You don't know what you're asking.", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "dialogue", "text": "We know exactly.", "name": "ROSA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "dialogue", "text": "We're not moving.", "name": "TESS", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Neither is the river.", "name": "ELI", "speaker": 4, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "A long silence.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "The wind lifts the banner.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "The drum, one soft BOOM.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "Cole takes off his hat.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "Looks at the derrick.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "At the line of faces.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "At Hank.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "Sheriff. Arrest the barrel.", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "Excuse me?", "name": "HANK", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "You heard me. It's a hazard. Roll it off the road.", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Dana and Eli lunge in front of Tess.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "Rosa grabs Hank's sleeve.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "The two teenagers scream.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "The coyote bolts.", "para": 4, "sent": 3, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "The whole crowd surges forward and then freezes as a siren WAILS in the distance.", "para": 4, "sent": 4, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "Everyone looks at the horizon.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "A cloud of dust, rolling toward them.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}