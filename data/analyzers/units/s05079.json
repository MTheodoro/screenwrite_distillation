{"scene_id": "s05079", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05079.fountain", "heading": "INT. MAPLE STREET VET CLINIC - RECEPTION - DAY", "cast": [{"id": 0, "name": "JUNE", "names": ["JUNE"], "gender": "f", "first": 5, "spoke": 7}, {"id": 1, "name": "LENA OKAFOR", "names": ["LENA OKAFOR", "LENA"], "gender": "f", "first": 7, "spoke": 3}, {"id": 2, "name": "THE CHEN KIDS", "names": ["CHEN KIDS", "THE CHEN KIDS"], "gender": "p", "first": 10, "spoke": 1}, {"id": 3, "name": "RIVER", "names": ["RIVER"], "gender": "?", "first": 13, "spoke": 5}, {"id": 4, "name": "HALVERSEN", "names": ["HALVERSEN", "MR. HALVERSEN"], "gender": "m", "first": 38, "spoke": 2}, {"id": 5, "name": "PARROT", "names": ["PARROT"], "gender": "?", "first": 42, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. MAPLE STREET VET CLINIC - RECEPTION - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Waiting room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Linoleum.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A fish tank.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A beagle howls from behind a door.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "JUNE (17, scrubs two sizes too big, first week) stacks leaflets at the desk.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She keeps checking the clock.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "LENA OKAFOR (40s, vet, white coat) strides through with a clipboard.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "June. Room two. Now.", "name": "LENA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Yes, Dr. Okafor.", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "THE CHEN KIDS (three siblings, matching backpacks) sit in a row on the bench, a cat carrier on their laps.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "It yowls.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "They flinch together.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "RIVER (20s, they/them, nose ring, rescue-shelter hoodie) leans on the counter.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Hey. I'm here for my appointment. Biscuit has the thing.", "name": "RIVER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "What thing?", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "The thing. Biscuit's a dog. Biscuit has the thing.", "name": "RIVER", "speaker": 3, "ext": [], "paren": ["shrugging"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "A black lab sits at their feet, head cocked.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Okay. Uh. Name?", "name": "JUNE", "speaker": 0, "ext": [], "paren": ["writing"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Biscuit. Last name Rivera-Hall. They go by Biscuit.", "name": "RIVER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Who goes by Biscuit?", "name": "JUNE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "The dog. Me too, honestly.", "name": "RIVER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "June blinks.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Writes.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Her pen skids across the page.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "June! Room two!", "name": "LENA", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Coming, coming, oh my God.", "name": "JUNE", "speaker": 0, "ext": [], "paren": ["under her breath"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "The cat carrier SCREECHES.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "The Chen Kids scream in unison.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "It's biting!", "name": "THE CHEN KIDS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "It's not biting. It's just upset.", "name": "RIVER", "speaker": 3, "ext": [], "paren": ["calmly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Don't panic. Don't panic.", "name": "JUNE", "speaker": 0, "ext": [], "paren": ["to herself, flipping a chart"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "She turns.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Grabs the carrier.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "The cat bolts out the front, a streak of grey fur, knocking over the fish tank stand.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Everybody stay calm!", "name": "JUNE", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Nobody is calm.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "The front door swings open.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "MR. HALVERSEN (60s, tweed coat, a parrot on his shoulder) steps in, drenched.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Which one of you is in charge?", "name": "MR. HALVERSEN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "That would be me.", "name": "LENA", "speaker": 1, "ext": [], "paren": ["emerging, hands up"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "My bird says your sign is wrong.", "name": "MR. HALVERSEN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Wrong! Wrong!", "name": "PARROT", "speaker": 5, "ext": [], "paren": ["from his shoulder"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "June puts her head on the desk.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "Biscuit the dog barks once, the cat yowls from the street, and the fish tank gently drips onto the floor.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}