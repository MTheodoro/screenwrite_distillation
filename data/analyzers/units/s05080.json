{"scene_id": "s05080", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05080.fountain", "heading": "INT. ST. BRIDGET'S CHURCH BASEMENT - NIGHT", "cast": [{"id": 0, "name": "TESS HALLORAN", "names": ["TESS HALLORAN", "TESS"], "gender": "f", "first": 7, "spoke": 9}, {"id": 1, "name": "DOOR BANGS", "names": ["DOOR BANGS"], "gender": "?", "first": 12, "spoke": 0}, {"id": 2, "name": "THE WOMAN", "names": ["WOMAN", "THE WOMAN"], "gender": "f", "first": 12, "spoke": 9}, {"id": 3, "name": "GRETA", "names": ["GRETA"], "gender": "f", "first": 56, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. ST. BRIDGET'S CHURCH BASEMENT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent tubes.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "HUMMING.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A coffee urn GURGLES.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Folding chairs in a circle.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "Eight empty.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "One taken.", "para": 1, "sent": 2, "present": []}, {"u": 7, "kind": "action", "text": "TESS HALLORAN, 17, slumps in it.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Backpack on her knees.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "Court-ordered slip crushed in her fist.", "para": 2, "sent": 2, "present": [0]}, {"u": 10, "kind": "action", "text": "Rain.", "para": 3, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "Hammering the high windows.", "para": 3, "sent": 1, "present": [0]}, {"u": 12, "kind": "action", "text": "The DOOR BANGS open.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "A WOMAN storms in.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Fifties.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Soaked.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Leather jacket.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Keys in a white-knuckle grip.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "She stops.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Stares at Tess.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "You're in my chair.", "name": "THE WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "There's no name on it.", "name": "TESS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "The Woman drops into the next seat.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The chair SCREECHES.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "You're a kid.", "name": "THE WOMAN", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Seventeen.", "name": "TESS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Seventeen. Great.", "name": "THE WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Tess pulls out her phone.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Taps.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Taps again.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Her phone.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Dead.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Nobody else is coming?", "name": "TESS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "Flooded out on Delancey. It's us.", "name": "THE WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "The urn CLICKS off.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Quiet.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Tess stands.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Grabs her bag.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Then I'm out. She said I only needed a signature.", "name": "TESS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "She who?", "name": "THE WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "The judge.", "name": "TESS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "She signs nothing unless you sit.", "name": "THE WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Tess freezes.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Thunder.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "A long ROLL.", "para": 13, "sent": 2, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Nothing.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "The Woman leans forward.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Elbows on knees.", "para": 15, "sent": 1, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "She meets Tess's eyes.", "para": 15, "sent": 2, "present": [0, 1, 2]}, {"u": 50, "kind": "dialogue", "text": "Eleven years sober. Tuesday. Her birthday. My daughter's.", "name": "THE WOMAN", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Why are you telling me that?", "name": "TESS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "Because she wouldn't open the door either.", "name": "THE WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Tess's jaw tightens.", "para": 16, "sent": 0, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "That's not fair.", "name": "TESS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "The Woman holds out a hand.", "para": 17, "sent": 0, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "Greta.", "name": "THE WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Tess stares at it.", "para": 18, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "A beat.", "para": 18, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "Lightning.", "para": 19, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "action", "text": "The lights FLICKER.", "para": 19, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "Tess shakes it.", "para": 20, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "Tess.", "name": "TESS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "Sit, Tess.", "name": "GRETA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "Tess sits.", "para": 21, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "Rain.", "para": 22, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "You go first.", "name": "GRETA", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "Hi. I'm Tess.", "name": "TESS", "speaker": 0, "ext": [], "paren": ["barely audible"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "Hi, Tess.", "name": "GRETA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "The lights HOLD.", "para": 23, "sent": 0, "present": [0, 1, 2, 3]}]}