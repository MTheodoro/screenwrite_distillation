{"scene_id": "s05081", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05081.fountain", "heading": "INT. SELF-STORAGE FACILITY - UNIT 214 - NIGHT", "cast": [{"id": 0, "name": "TICKS", "names": ["TICKS"], "gender": "?", "first": 3, "spoke": 0}, {"id": 1, "name": "VESPER", "names": ["VESPER"], "gender": "f", "first": 3, "spoke": 3}, {"id": 2, "name": "OKAFOR", "names": ["OKAFOR"], "gender": "m", "first": 3, "spoke": 2}, {"id": 3, "name": "DEL", "names": ["DEL"], "gender": "f", "first": 3, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. SELF-STORAGE FACILITY - UNIT 214 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A roll-up door, half raised.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cold light leaks under it.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Somewhere down the corridor a vent TICKS, TICKS, stops, and the silence after it is worse, and VESPER crouches at a stack of boxes while OKAFOR holds a flashlight on a padlock and DEL stands at the door with his back to them, listening to the building.", "para": 0, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 4, "kind": "dialogue", "text": "Okafor. Light.", "name": "VESPER", "speaker": 1, "ext": [], "paren": ["sets down the bolt cutters, slow"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 5, "kind": "dialogue", "text": "It's on, Vesper. It's on.", "name": "OKAFOR", "speaker": 2, "ext": [], "paren": ["steadies the beam, whispers"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "dialogue", "text": "Something moved on the stairs.", "name": "DEL", "speaker": 3, "ext": [], "paren": ["without turning"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "Del, it's a pipe. Say it's a pipe.", "name": "VESPER", "speaker": 1, "ext": [], "paren": ["freezes mid-reach"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Okafor, kill the light.", "name": "DEL", "speaker": 3, "ext": [], "paren": ["a long pause"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "", "name": "OKAFOR", "speaker": 2, "ext": [], "paren": ["clicks it off"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Dark.", "para": 1, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Nobody move.", "name": "DEL", "speaker": 3, "ext": [], "paren": ["barely breathing"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "We're not.", "name": "VESPER", "speaker": 1, "ext": [], "paren": ["a whisper, close to a laugh"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Far down the hall, a door SHUTS.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Soft.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Careful.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}]}