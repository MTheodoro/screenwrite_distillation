{"scene_id": "s05082", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05082.fountain", "heading": "INT. SUBWAY CAR - EVENING RUSH", "cast": [{"id": 0, "name": "POPPY NAKAMURA", "names": ["POPPY NAKAMURA", "POPPY"], "gender": "f", "first": 5, "spoke": 10}, {"id": 1, "name": "BISCUIT", "names": ["BISCUIT"], "gender": "?", "first": 7, "spoke": 2}, {"id": 2, "name": "MARCUS", "names": ["MARCUS"], "gender": "m", "first": 9, "spoke": 7}, {"id": 3, "name": "DELILAH OKONKWO", "names": ["DELILAH", "DELILAH OKONKWO"], "gender": "f", "first": 22, "spoke": 9}, {"id": 4, "name": "CLANG", "names": ["CLANG"], "gender": "?", "first": 36, "spoke": 0}, {"id": 5, "name": "TUNNEL WALL", "names": ["TUNNEL WALL"], "gender": "?", "first": 37, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. SUBWAY CAR - EVENING RUSH", "present": []}, {"u": 1, "kind": "action", "text": "A packed Number 6 train SCREECHES through the dark.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Straphangers sway like seaweed.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The lights flicker.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The car smells of pizza and wet umbrellas.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "CLOSE ON a tiny paper bag in the arms of POPPY NAKAMURA, 9, brave, braces on her teeth.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Inside the bag, a hamster peeks out.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "dialogue", "text": "Don't look, Biscuit. Crowds make you nervous.", "name": "POPPY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "I'm not nervous. You're nervous.", "name": "BISCUIT", "speaker": 1, "ext": ["O.S."], "paren": ["muffled squeak"], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "ANGLE ON Poppy's big brother, MARCUS, 15, headphones around his neck, glued to a dead phone.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Pop, we're four stops from home. Do not name-drop the hamster in public.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "He has a name, Marcus.", "name": "POPPY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "He has a name that means \"snack\" to every cat in Queens.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "The train JERKS.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Everybody lurches.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "A man's coffee flies.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "WE SEE the lights die.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Total black.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "A collective GASP.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "The train GROANS to a stop.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Marcus?", "name": "POPPY", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Right here, Pop.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "Everybody stay calm! I've been stuck down here before!", "name": "DELILAH", "speaker": 3, "ext": [], "paren": ["from the dark, a big voice"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Poppy squints.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "A small flashlight clicks on.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "It shines on DELILAH OKONKWO, 60s, a transit worker's vest, a thermos the size of a fire hydrant.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Ten minutes. Tops. Y'all hold hands if you gotta.", "name": "DELILAH", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Is that official?", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "It's a suggestion, baby.", "name": "DELILAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Delilah, I think Biscuit's scared.", "name": "POPPY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Biscuit is the hamster?", "name": "DELILAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "He's a very brave hamster.", "name": "POPPY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "He is literally shaking.", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Marcus, shush!", "name": "POPPY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Both of you shush. Hear that?", "name": "DELILAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Then a faint CLANG, CLANG, CLANG from the tunnel ahead.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "INSERT - THE TUNNEL WALL, a rusty pipe trembling.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "dialogue", "text": "That's not a ten-minute noise.", "name": "POPPY", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "No. It is not.", "name": "DELILAH", "speaker": 3, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "dialogue", "text": "Okay. Okay. What do we do?", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "dialogue", "text": "You and your sister stay by me. Poppy, you keep that little fella warm.", "name": "DELILAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "dialogue", "text": "You hear that, Biscuit? We're a team now.", "name": "POPPY", "speaker": 0, "ext": [], "paren": ["to the bag"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "Tell Marcus I said sorry about his sneakers.", "name": "BISCUIT", "speaker": 1, "ext": ["O.S."], "paren": ["squeak"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "What did he say?", "name": "MARCUS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "Nothing.", "name": "POPPY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "action", "text": "The clanging STOPS.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "The lights flash on.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "The train LURCHES forward.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "Everyone CHEERS.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "BACK TO SCENE", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "Marcus slumps against a pole, laughing with relief.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "action", "text": "Poppy squeezes the bag.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "Delilah screws the cap on her thermos.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "This is the last time the three of them will ever be strangers.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "dialogue", "text": "Next stop is yours, kids.", "name": "DELILAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "dialogue", "text": "Thank you, Delilah.", "name": "POPPY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "dialogue", "text": "Thank the hamster.", "name": "DELILAH", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}