{"scene_id": "s05083", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05083.fountain", "heading": "INT. NORTHSIDE REC CENTER - GYM - DAY", "cast": [{"id": 0, "name": "PRIYA", "names": ["PRIYA"], "gender": "m", "first": 11, "spoke": 5}, {"id": 1, "name": "JAYLEN", "names": ["JAYLEN"], "gender": "?", "first": 4, "spoke": 5}, {"id": 2, "name": "ADEYEMI", "names": ["ADEYEMI", "MS. ADEYEMI"], "gender": "f", "first": 28, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. NORTHSIDE REC CENTER - GYM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Squeaking sneakers.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A basketball THUMPS.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Nobody's playing.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Jaylen, 17, sits on the bottom bleacher, thumbs flying.", "para": 1, "sent": 0, "present": [1]}, {"u": 5, "kind": "action", "text": "Group chat blowing up.", "para": 1, "sent": 1, "present": [1]}, {"u": 6, "kind": "action", "text": "Forty-one unread.", "para": 1, "sent": 2, "present": [1]}, {"u": 7, "kind": "action", "text": "Her phone.", "para": 2, "sent": 0, "present": [1]}, {"u": 8, "kind": "action", "text": "Buzzing.", "para": 2, "sent": 1, "present": [1]}, {"u": 9, "kind": "action", "text": "Buzzing.", "para": 2, "sent": 2, "present": [1]}, {"u": 10, "kind": "action", "text": "Buzzing.", "para": 2, "sent": 3, "present": [1]}, {"u": 11, "kind": "action", "text": "Priya, 17, tall, hoodie up, drops next to him.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "So are you gonna answer or just let it ghost you?", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "It's the whole team. They all saw the screenshot.", "name": "JAYLEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Delete the app.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Priya, my lawyer said don't delete anything. Literal evidence.", "name": "JAYLEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Your lawyer's like twenty-six and she says \"no cap.\"", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "She's good, though.", "name": "JAYLEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "The ball rolls across the floor and stops.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Nothing.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Jaylen locks the phone.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Face down on his knee.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "This is the part where it stops being funny.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Priya nudges him.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "For real, tho. You didn't do it.", "name": "PRIYA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Everyone thinks I did.", "name": "JAYLEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "The double doors BANG open.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "MS. ADEYEMI, 40s, blazer, folder under her arm, strides in.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "The lawyer.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Jaylen. Deposition's moved to Thursday. Good news.", "name": "MS. ADEYEMI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Okay.", "name": "JAYLEN", "speaker": 1, "ext": [], "paren": ["small"], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Put the phone away, Priya.", "name": "MS. ADEYEMI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "I'm literally not on it.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Ms. Adeyemi sits on the bleacher above them.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Pulls out a pen.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "Start from the beginning.", "name": "MS. ADEYEMI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}