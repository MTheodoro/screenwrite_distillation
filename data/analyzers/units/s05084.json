{"scene_id": "s05084", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05084.fountain", "heading": "INT. ROSIE'S DINER - BOOTH BY THE WINDOW - NIGHT", "cast": [{"id": 0, "name": "MAYA", "names": ["MAYA"], "gender": "f", "first": 7, "spoke": 10}, {"id": 1, "name": "DESMOND", "names": ["DESMOND"], "gender": "m", "first": 8, "spoke": 10}, {"id": 2, "name": "THEO", "names": ["THEO"], "gender": "m", "first": 14, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. ROSIE'S DINER - BOOTH BY THE WINDOW - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A half-empty diner.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A neon sign BUZZES in the window.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Three strangers sit at one booth, three phones face-up on the table, none of them quite looking at each other, a plate of cold fries in the middle that nobody has touched, a waitress refilling coffee two booths over.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "CLOSE ON the middle phone.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "A group chat. \"nightowls_3am\" glowing at the top.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "WE SEE the last message, from \"moth\": \"ok so who's actually here.\"", "para": 2, "sent": 0, "present": []}, {"u": 7, "kind": "dialogue", "text": "so. um. i'm maya.", "name": "MAYA", "speaker": 0, "ext": [], "paren": ["turns her phone over, then back"], "dual": false, "present": [0]}, {"u": 8, "kind": "dialogue", "text": "desmond. i'm \"moth.\"", "name": "DESMOND", "speaker": 1, "ext": [], "paren": ["leaning back, arms crossed"], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "you're moth? you type like a forty year old.", "name": "MAYA", "speaker": 0, "ext": [], "paren": ["small laugh"], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "i am a forty year old.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": ["a shrug"], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "The waitress sets down a coffee.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Leaves.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "A beat.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "i didn't think anyone would actually show up.", "name": "THEO", "speaker": 2, "ext": [], "paren": ["pushing the fries a half inch toward them"], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "you set the time, theo.", "name": "MAYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "yeah. i know.", "name": "THEO", "speaker": 2, "ext": [], "paren": ["eyes on the table"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "so you're \"lantern.\"", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "yeah.", "name": "THEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "the one who said he found something in the old church.", "name": "MAYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "it was a long time ago.", "name": "THEO", "speaker": 2, "ext": [], "paren": ["a pause"], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "it was last tuesday.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "A phone BUZZES on the table.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Everyone looks.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "It's Maya's.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "She doesn't pick it up.", "para": 4, "sent": 3, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "it's my mom.", "name": "MAYA", "speaker": 0, "ext": [], "paren": ["flips it face down"], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "you can get it.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "no, it's fine.", "name": "MAYA", "speaker": 0, "ext": [], "paren": ["a thin smile"], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "ANGLE ON Theo's hand, tapping the table.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Tap.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Tap.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Tap.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "i didn't find anything. i wrote it. the whole thing. i made it up.", "name": "THEO", "speaker": 2, "ext": [], "paren": ["too quiet"], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "dialogue", "text": "okay.", "name": "MAYA", "speaker": 0, "ext": [], "paren": ["a beat, then, steady"], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "dialogue", "text": "why?", "name": "DESMOND", "speaker": 1, "ext": [], "paren": ["sits forward"], "dual": false, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "i wanted someone to message back.", "name": "THEO", "speaker": 2, "ext": [], "paren": ["shrugs, can't look up"], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "The neon BUZZES.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "A truck HISSES past outside.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "eat something, lantern.", "name": "MAYA", "speaker": 0, "ext": [], "paren": ["slides the fries closer"], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "it's theo.", "name": "THEO", "speaker": 2, "ext": [], "paren": ["a breath"], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "i know.", "name": "MAYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "these are terrible.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": ["picks up one fry, studies it"], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "yeah.", "name": "THEO", "speaker": 2, "ext": [], "paren": ["a short laugh, surprised at itself"], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "The three of them sit.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Desmond eats the fry.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Maya reaches over and takes one.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Theo, after a moment, takes the last.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "A door SLAMS somewhere in the back.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "All three flinch.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Nobody says anything.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "BACK TO SCENE", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "The waitress comes by.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "Tops off the coffees.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Looks at the three of them, then at the fries.", "para": 10, "sent": 2, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "can we get another plate of those?", "name": "DESMOND", "speaker": 1, "ext": [], "paren": ["to the waitress"], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "The waitress nods.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "Goes.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "The phones on the table light up at once, three at a time, the group chat filling with messages from people who aren't here.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "\"is everyone ok\"", "name": "MAYA", "speaker": 0, "ext": [], "paren": ["reading"], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "\"we're good.\"", "name": "DESMOND", "speaker": 1, "ext": [], "paren": ["typing, slowly, two fingers"], "dual": false, "present": [0, 1, 2]}, {"u": 62, "kind": "dialogue", "text": "you're still typing like a forty year old.", "name": "THEO", "speaker": 2, "ext": [], "paren": ["watching him"], "dual": false, "present": [0, 1, 2]}, {"u": 63, "kind": "dialogue", "text": "it's a gift.", "name": "DESMOND", "speaker": 1, "ext": [], "paren": ["without looking up"], "dual": false, "present": [0, 1, 2]}]}