{"scene_id": "s05085_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05085.fountain", "heading": "INT. WILLOWBROOK FERTILITY CLINIC - EXAM ROOM - CONTINUOUS", "cast": [{"id": 0, "name": "DR. PLUM", "names": ["DR. PLUM"], "gender": "?", "first": 1, "spoke": 8}, {"id": 1, "name": "BRIDGET", "names": ["BRIDGET"], "gender": "f", "first": 2, "spoke": 3}, {"id": 2, "name": "GARRETT", "names": ["GARRETT"], "gender": "m", "first": 3, "spoke": 3}, {"id": 3, "name": "INTERCOM", "names": ["INTERCOM"], "gender": "m", "first": 8, "spoke": 1}, {"id": 4, "name": "WINNIE", "names": ["WINNIE"], "gender": "f", "first": 9, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. WILLOWBROOK FERTILITY CLINIC - EXAM ROOM - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Dr. Plum shuts the door.", "para": 0, "sent": 0, "present": [0]}, {"u": 2, "kind": "action", "text": "Bridget perches on the table.", "para": 0, "sent": 1, "present": [0, 1]}, {"u": 3, "kind": "action", "text": "Garrett stays standing.", "para": 0, "sent": 2, "present": [0, 1, 2]}, {"u": 4, "kind": "dialogue", "text": "Now, the good news is, your tests came back magical.", "name": "DR. PLUM", "speaker": 0, "ext": [], "paren": ["clapping once"], "dual": false, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "Magical how?", "name": "BRIDGET", "speaker": 1, "ext": [], "paren": ["hopeful"], "dual": false, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Wonderfully magical. The bad news is, there's a small curse.", "name": "DR. PLUM", "speaker": 0, "ext": [], "paren": ["checking a scroll"], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "There's always a small curse.", "name": "GARRETT", "speaker": 2, "ext": [], "paren": ["flat"], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Dr. Plum, your two o'clock is here. And the stork is asking for a raise again.", "name": "INTERCOM", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Tell him we'll discuss it in the spring, Winnie.", "name": "DR. PLUM", "speaker": 0, "ext": [], "paren": ["to the ceiling"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "He says that's what you said last spring.", "name": "WINNIE", "speaker": 4, "ext": ["V.O."], "paren": ["from the intercom"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Storks.", "name": "DR. PLUM", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "CLOSE ON the scroll.", "para": 1, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "Written in glittery cursive: \"Hex of Perpetual Maybe.\"", "para": 1, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Perpetual Maybe?", "name": "BRIDGET", "speaker": 1, "ext": [], "paren": ["reading it, aghast"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Very common. Your great-aunt must've really wanted you to take your time.", "name": "DR. PLUM", "speaker": 0, "ext": [], "paren": ["brightly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "This is your aunt Millicent.", "name": "GARRETT", "speaker": 2, "ext": [], "paren": ["sighs, to Bridget"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "She hated my first boyfriend, too.", "name": "BRIDGET", "speaker": 1, "ext": [], "paren": ["tight smile"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Good news! It's reversible. We'll start with a gentle exorcism.", "name": "DR. PLUM", "speaker": 0, "ext": [], "paren": ["snaps fingers; a puff of glitter"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Gentle?", "name": "GARRETT", "speaker": 2, "ext": [], "paren": ["alarmed"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Light. Like a dentist.", "name": "DR. PLUM", "speaker": 0, "ext": [], "paren": ["already writing"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "BACK TO SCENE", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "The dragon pokes its head through the door.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Not now, Kevin.", "name": "DR. PLUM", "speaker": 0, "ext": ["CONT'D"], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "The dragon sighs.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "A small puff of smoke.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "It leaves.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}]}