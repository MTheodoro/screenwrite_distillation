{"scene_id": "s05088", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05088.fountain", "heading": "INT. LAKEVIEW BANQUET HALL - WEDDING AFTERPARTY - NIGHT", "cast": [{"id": 0, "name": "DJ", "names": ["DJ"], "gender": "?", "first": 3, "spoke": 0}, {"id": 1, "name": "WAITER", "names": ["WAITER"], "gender": "m", "first": 4, "spoke": 0}, {"id": 2, "name": "TEENAGERS", "names": ["TEENAGERS"], "gender": "?", "first": 5, "spoke": 0}, {"id": 3, "name": "NORA", "names": ["NORA"], "gender": "f", "first": 7, "spoke": 7}, {"id": 4, "name": "CALLUM", "names": ["CALLUM"], "gender": "m", "first": 8, "spoke": 5}, {"id": 5, "name": "DEVON", "names": ["DEVON"], "gender": "m", "first": 18, "spoke": 4}, {"id": 6, "name": "MARIN", "names": ["MARIN"], "gender": "f", "first": 28, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. LAKEVIEW BANQUET HALL - WEDDING AFTERPARTY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Streamers.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Half-eaten cake.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A DJ plays something slow to a nearly empty floor.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "A WAITER carries a tray of champagne flutes between tables.", "para": 0, "sent": 3, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Two TEENAGERS in matching rented suits hide behind a pillar, sharing a vape.", "para": 0, "sent": 4, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "A small WHITE DOG in a bow tie trots under the head table, hunting for crumbs.", "para": 0, "sent": 5, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "At a corner table, NORA, 28, bridesmaid, grips her clutch.", "para": 1, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Across from her sits CALLUM, 30s, the groom's cousin, loosening his tie.", "para": 1, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "dialogue", "text": "Don't look at the bar.", "name": "NORA", "speaker": 3, "ext": [], "paren": ["low, smiling for the room"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Which one is he?", "name": "CALLUM", "speaker": 4, "ext": [], "paren": ["looking at the bar"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Grey suit. Left of the cake.", "name": "NORA", "speaker": 3, "ext": [], "paren": ["sips water"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "That's the best man.", "name": "CALLUM", "speaker": 4, "ext": [], "paren": ["squints"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "That's not the best man.", "name": "NORA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "A beat.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "The Waiter passes.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Nora lifts a flute.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Sets it down untouched.", "para": 2, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "DEVON arrives, 30s, the real best man, grinning, a bit sweaty, and slides into the chair next to Callum.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 19, "kind": "dialogue", "text": "There you are! Where were you during the toast?", "name": "DEVON", "speaker": 5, "ext": [], "paren": ["clapping Callum on the shoulder"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Parking.", "name": "CALLUM", "speaker": 4, "ext": [], "paren": ["stiff"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "dialogue", "text": "And you owe me a dance.", "name": "DEVON", "speaker": 5, "ext": [], "paren": ["to Nora"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "dialogue", "text": "Later.", "name": "NORA", "speaker": 3, "ext": [], "paren": ["too bright"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "dialogue", "text": "You okay? You look pale.", "name": "DEVON", "speaker": 5, "ext": [], "paren": ["leaning in"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "dialogue", "text": "Long day.", "name": "NORA", "speaker": 3, "ext": [], "paren": ["squeezing the clutch"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "The Dog yips under the table.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "One of the Teenagers giggles.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "action", "text": "The other shushes him.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "action", "text": "MARIN, 50s, the bride's mother in a silver dress, glides up behind them.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 29, "kind": "dialogue", "text": "Dev, the photographer needs you. Now.", "name": "MARIN", "speaker": 6, "ext": [], "paren": ["tapping Devon's arm"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 30, "kind": "dialogue", "text": "Don't leave. We're doing shots at midnight.", "name": "DEVON", "speaker": 5, "ext": [], "paren": ["rising, to Callum"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 31, "kind": "action", "text": "He goes.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "action", "text": "Marin lingers, her eyes on Nora.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "He is lovely, isn't he?", "name": "MARIN", "speaker": 6, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "Very.", "name": "NORA", "speaker": 3, "ext": [], "paren": ["nodding, tight"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "And you. You'll keep an eye on her?", "name": "MARIN", "speaker": 6, "ext": [], "paren": ["turning to Callum"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "dialogue", "text": "Yes, ma'am.", "name": "CALLUM", "speaker": 4, "ext": [], "paren": ["a beat"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "Marin smiles and drifts away.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "Nora exhales.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "Callum turns to her.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "dialogue", "text": "Your clutch. What's in it?", "name": "CALLUM", "speaker": 4, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 41, "kind": "dialogue", "text": "Not here.", "name": "NORA", "speaker": 3, "ext": [], "paren": ["eyes on the dance floor"], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 42, "kind": "action", "text": "The DJ fades out the slow song.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 43, "kind": "action", "text": "The room claps, thinly.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 44, "kind": "action", "text": "The Waiter returns for the flute Nora never touched.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 45, "kind": "action", "text": "She hands it to him with a smile that does not reach her eyes.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}]}