{"scene_id": "s05089", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05089.fountain", "heading": "EXT. MAPLE HILL PARK - NEAR THE OLD FOUNTAIN - DUSK", "cast": [{"id": 0, "name": "JOGGER", "names": ["JOGGER"], "gender": "?", "first": 3, "spoke": 0}, {"id": 1, "name": "OLD MEN", "names": ["OLD MEN"], "gender": "p", "first": 4, "spoke": 0}, {"id": 2, "name": "LIN", "names": ["LIN"], "gender": "f", "first": 5, "spoke": 9}, {"id": 3, "name": "KOFI", "names": ["KOFI"], "gender": "m", "first": 8, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "EXT. MAPLE HILL PARK - NEAR THE OLD FOUNTAIN - DUSK", "present": []}, {"u": 1, "kind": "action", "text": "The sun is low.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The park is almost empty.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A JOGGER runs past with a small dog.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "Two OLD MEN play chess on a bench, not talking.", "para": 0, "sent": 3, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "LIN, 19, sets a phone on a tripod.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "She wears a bright yellow jacket.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "She checks the screen and fixes her hair.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "Beside her stands KOFI, 20, her friend.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "He holds a ring light.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "He is nervous but he does not say it.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Okay. We start. Hello, my friends. Today we go to the haunted fountain.", "name": "LIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Why are we saying haunted?", "name": "KOFI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Because people like it. More views.", "name": "LIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "But nobody say this fountain is haunted.", "name": "KOFI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Now they say.", "name": "LIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "She laughs.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "He does not.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "He looks at the dry stone fountain.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "He turns the ring light a little.", "para": 3, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "The Jogger is gone.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "The old men are gone too.", "para": 4, "sent": 1, "present": [1, 2, 3]}, {"u": 22, "kind": "action", "text": "The chessboard is still on the bench, pieces standing.", "para": 4, "sent": 2, "present": [1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Is very quiet here. Very, very quiet.", "name": "LIN", "speaker": 2, "ext": ["CONT'D"], "paren": ["to the camera"], "dual": false, "present": [1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Lin. The men. They left the game.", "name": "KOFI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "So? They are tired.", "name": "LIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Maybe.", "name": "KOFI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [1, 2, 3]}, {"u": 27, "kind": "action", "text": "She taps the screen.", "para": 5, "sent": 0, "present": [1, 2, 3]}, {"u": 28, "kind": "action", "text": "She frowns.", "para": 5, "sent": 1, "present": [1, 2, 3]}, {"u": 29, "kind": "action", "text": "She taps again.", "para": 5, "sent": 2, "present": [1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "The video, it stops. Always the same place.", "name": "LIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Maybe the phone is cold.", "name": "KOFI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Phones are not cold.", "name": "LIN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [1, 2, 3]}, {"u": 33, "kind": "action", "text": "A cold wind moves over the grass.", "para": 6, "sent": 0, "present": [1, 2, 3]}, {"u": 34, "kind": "action", "text": "The fountain makes a small sound, like a drop of water falling.", "para": 6, "sent": 1, "present": [1, 2, 3]}, {"u": 35, "kind": "action", "text": "But the fountain is dry.", "para": 6, "sent": 2, "present": [1, 2, 3]}, {"u": 36, "kind": "action", "text": "He steps back.", "para": 7, "sent": 0, "present": [1, 2, 3]}, {"u": 37, "kind": "action", "text": "She does not notice.", "para": 7, "sent": 1, "present": [1, 2, 3]}, {"u": 38, "kind": "action", "text": "She is still looking at the screen.", "para": 7, "sent": 2, "present": [1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Kofi. Look.", "name": "LIN", "speaker": 2, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [1, 2, 3]}, {"u": 40, "kind": "action", "text": "He comes closer.", "para": 8, "sent": 0, "present": [1, 2, 3]}, {"u": 41, "kind": "action", "text": "On the screen, behind her, there is someone in the water of the fountain.", "para": 8, "sent": 1, "present": [1, 2, 3]}, {"u": 42, "kind": "action", "text": "Only in the video.", "para": 8, "sent": 2, "present": [1, 2, 3]}, {"u": 43, "kind": "action", "text": "Not in the park.", "para": 8, "sent": 3, "present": [1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "I do not see anything.", "name": "KOFI", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Yes you do.", "name": "LIN", "speaker": 2, "ext": [], "paren": ["her voice thin"], "dual": false, "present": [1, 2, 3]}, {"u": 46, "kind": "action", "text": "He is silent.", "para": 9, "sent": 0, "present": [1, 2, 3]}, {"u": 47, "kind": "action", "text": "His hands shake on the ring light.", "para": 9, "sent": 1, "present": [1, 2, 3]}, {"u": 48, "kind": "action", "text": "It is the last video they will make together.", "para": 10, "sent": 0, "present": [1, 2, 3]}, {"u": 49, "kind": "action", "text": "She turns off the phone.", "para": 11, "sent": 0, "present": [1, 2, 3]}, {"u": 50, "kind": "action", "text": "Fast.", "para": 11, "sent": 1, "present": [1, 2, 3]}, {"u": 51, "kind": "action", "text": "She takes the tripod and walks to the path.", "para": 11, "sent": 2, "present": [1, 2, 3]}, {"u": 52, "kind": "action", "text": "He follows her.", "para": 11, "sent": 3, "present": [1, 2, 3]}, {"u": 53, "kind": "action", "text": "Neither of them looks back at the fountain.", "para": 11, "sent": 4, "present": [1, 2, 3]}, {"u": 54, "kind": "action", "text": "The wind stops.", "para": 12, "sent": 0, "present": [1, 2, 3]}, {"u": 55, "kind": "action", "text": "The water drips once more.", "para": 12, "sent": 1, "present": [1, 2, 3]}]}