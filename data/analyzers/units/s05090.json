{"scene_id": "s05090", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05090.fountain", "heading": "INT. BRIGHTSTART FERTILITY CLINIC - WAITING ROOM - DAY", "cast": [{"id": 0, "name": "TESS", "names": ["TESS"], "gender": "f", "first": 4, "spoke": 2}, {"id": 1, "name": "GORDON", "names": ["GORDON"], "gender": "m", "first": 3, "spoke": 6}, {"id": 2, "name": "ROSALIND", "names": ["ROSALIND"], "gender": "f", "first": 16, "spoke": 4}, {"id": 3, "name": "THE WOMAN", "names": ["THE WOMAN"], "gender": "?", "first": 18, "spoke": 3}, {"id": 4, "name": "DR. HALLORAN", "names": ["DR. HALLORAN"], "gender": "m", "first": 11, "spoke": 1}, {"id": 5, "name": "BEV", "names": ["BEV"], "gender": "?", "first": 57, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. BRIGHTSTART FERTILITY CLINIC - WAITING ROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "SUPER: \"TUESDAY.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "9:47 AM.\"", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Gordon, 40s, rumpled and sweating through a pastel polo, grips a paper cup and a clipboard.", "para": 1, "sent": 0, "present": [1]}, {"u": 4, "kind": "action", "text": "Tess, 20s, behind the front desk, smiles a smile that has seen things.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "INSERT - CLIPBOARD", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Line 14: \"Sample collected at home?", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Y / N\".", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Gordon's pen hovers.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He circles Y. Then N. Then Y.", "para": 3, "sent": 3, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "BACK TO SCENE", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Mr. Pruitt, Dr. Halloran will see you shortly.", "name": "TESS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 4]}, {"u": 12, "kind": "dialogue", "text": "Great. Fantastic. Shortly. Love shortly.", "name": "GORDON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 4]}, {"u": 13, "kind": "action", "text": "His phone BUZZES.", "para": 5, "sent": 0, "present": [0, 1, 4]}, {"u": 14, "kind": "action", "text": "He answers, too loud.", "para": 5, "sent": 1, "present": [0, 1, 4]}, {"u": 15, "kind": "dialogue", "text": "Ros? I'm here, I'm in the, I'm at the place.", "name": "GORDON", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 4]}, {"u": 16, "kind": "dialogue", "text": "Did you bring it. Gordon. Did you bring it.", "name": "ROSALIND", "speaker": 2, "ext": ["V.O."], "paren": ["tinny, speakerphone"], "dual": false, "present": [0, 1, 2, 4]}, {"u": 17, "kind": "dialogue", "text": "Define \"it\".", "name": "GORDON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 18, "kind": "dialogue", "text": "The jar, Gordon. The jar in the cooler bag, in the car, in the August heat.", "name": "ROSALIND", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Gordon looks at the empty cup in his hand.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Looks at the door.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "POV - THROUGH THE WINDOW", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "The parking lot.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "His Subaru.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Its trunk wide open.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "A Seagull the size of a toddler perches on the bumper.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "BACK TO SCENE", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "A woman in sunglasses and a long coat sits two chairs down, reading a pamphlet upside down.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "She has been there since the top of the scene.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "She has not blinked.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Okay. Okay okay okay.", "name": "GORDON", "speaker": 1, "ext": [], "paren": ["to himself"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Dr. Halloran, 50s, bow tie, enters from the hallway with a tablet.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "He and Gordon lock eyes.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "He raises a hand to wave.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "He sees the open trunk through the window.", "para": 11, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "He lowers it.", "para": 11, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "ANGLE ON THE WOMAN", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "She stands.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Slowly.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "She opens the coat.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Inside, a cooler bag, sweating, strapped to her like a bomb vest.", "para": 13, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Is this what you're looking for.", "name": "THE WOMAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Gordon and Halloran both freeze.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Tess drops her stapler.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "You STOLE my", "name": "GORDON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "I RESCUED your", "name": "THE WOMAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Everybody stay calm, that is a biohazard and also a federal, I think, a federal something.", "name": "DR. HALLORAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "What's happening. Why is everyone yelling. Gordon!", "name": "ROSALIND", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Gordon lunges for the bag.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "The woman spins away.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Halloran grabs him, he grabs the coat, and all three of them crash into the pamphlet rack.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Pamphlets rain down like confetti.", "para": 15, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Tess ducks under the desk.", "para": 15, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "INTERCUT - PARKING LOT / WAITING ROOM", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "The seagull hops into the trunk.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "It emerges with a sandwich.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Nobody sees.", "para": 17, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "dialogue", "text": "Bev! My name is Bev! I'm Rosalind's sister, you absolute walnut, she sent me to make sure you'd show up!", "name": "THE WOMAN", "speaker": 3, "ext": [], "paren": ["pinned, furious"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "Silence.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "Gordon, face down in pamphlets, slowly raises one finger.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "dialogue", "text": "...Did she also send you to steal it?", "name": "GORDON", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "dialogue", "text": "No. That was freelance.", "name": "BEV", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "dialogue", "text": "Oh my god. Bev. I said WATCH him. Not ambush him.", "name": "ROSALIND", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "action", "text": "Tess pops up from behind the desk, holding the cooler bag by one strap.", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "dialogue", "text": "So, uh. Who's paying the co-pay.", "name": "TESS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}]}