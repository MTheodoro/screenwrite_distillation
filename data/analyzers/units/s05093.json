{"scene_id": "s05093", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05093.fountain", "heading": "INT. SUBBASS SOUND - STUDIO B - DAY", "cast": [{"id": 0, "name": "LINUS", "names": ["LINUS"], "gender": "m", "first": 3, "spoke": 1}, {"id": 1, "name": "MO", "names": ["MO"], "gender": "?", "first": 2, "spoke": 5}, {"id": 2, "name": "WREN", "names": ["WREN"], "gender": "f", "first": 7, "spoke": 2}, {"id": 3, "name": "DENISE", "names": ["DENISE"], "gender": "f", "first": 12, "spoke": 3}, {"id": 4, "name": "PRIYA", "names": ["PRIYA"], "gender": "f", "first": 20, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. SUBBASS SOUND - STUDIO B - DAY", "present": []}, {"u": 1, "kind": "action", "text": "CLOSE ON a mixing console, faders crawling up and down by themselves.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Pull back to find Mo Delgado, 30s, producer, hoodie, three coffees deep, chewing a pen cap.", "para": 0, "sent": 1, "present": [1]}, {"u": 3, "kind": "action", "text": "Through the glass, in the vocal booth, Linus Thorne, 50s, a former one-hit wonder in a leather vest, stands before a mic with his eyes closed, singing very gently about a sandwich.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 4, "kind": "dialogue", "text": "\"Oh, ham, you were never mine...\"", "name": "LINUS", "speaker": 0, "ext": ["V.O."], "paren": ["through talkback, sincere"], "dual": false, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Mo presses the talkback button.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "That's great, Linus. Another take. Maybe less ham.", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Wren Okoye, 20s, the engineer, slumped at the second chair with a laptop, doesn't look up.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "We've done forty-one takes.", "name": "WREN", "speaker": 2, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Forty-two, with feeling. Forty-two.", "name": "MO", "speaker": 1, "ext": [], "paren": ["muttering, to himself"], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Mo's phone lights up on the desk.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "ANGLE ON PHONE SCREEN", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "\"LABEL - DENISE\".", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Mo answers on speaker.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Mo. Tell me the single is done.", "name": "DENISE", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "It's, uh, ripening.", "name": "MO", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "It's a song about lunch meat. Is it done.", "name": "DENISE", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Wren mouths \"No\" at the phone.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Mo waves her off.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Okay team! Quick huddle, we're gonna just, vibe.", "name": "MO", "speaker": 1, "ext": [], "paren": ["to everyone, bright"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Priya Ramanathan, 20s, the assistant, enters with a tray of tea, nods at nobody, sets it down, and sits.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "WE SEE Linus through the glass, tapping the window, mouthing something.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Everyone ignores him.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "He's asking if the lunch meat is \"emotionally honest\" enough.", "name": "PRIYA", "speaker": 4, "ext": [], "paren": ["to Mo only"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Tell him it's the most honest ham I've ever heard.", "name": "MO", "speaker": 1, "ext": [], "paren": ["to Priya"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "BACK TO SCENE", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "I'm updating my resume.", "name": "WREN", "speaker": 2, "ext": [], "paren": ["to herself, typing"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "I heard that.", "name": "DENISE", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Mo sinks into his chair.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Nobody speaks.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "The faders keep creeping.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Take forty-three begins, soft and sincere and terrible.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4]}]}