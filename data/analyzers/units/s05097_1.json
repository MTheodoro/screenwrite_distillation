{"scene_id": "s05097_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05097.fountain", "heading": "INT. COUNTY PAROLE OFFICE - CRUZ'S OFFICE - CONTINUOUS", "cast": [{"id": 0, "name": "CRUZ", "names": ["CRUZ"], "gender": "f", "first": 4, "spoke": 7}, {"id": 1, "name": "DARNELL", "names": ["DARNELL"], "gender": "f", "first": 5, "spoke": 7}, {"id": 2, "name": "GIDEON", "names": ["GIDEON"], "gender": "m", "first": 7, "spoke": 4}, {"id": 3, "name": "MARISOL", "names": ["MARISOL"], "gender": "f", "first": 32, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. COUNTY PAROLE OFFICE - CRUZ'S OFFICE - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "A cramped room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A dying ficus.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A window onto a brick wall.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Cruz sits.", "para": 0, "sent": 3, "present": [0]}, {"u": 5, "kind": "action", "text": "Darnell does not, until she nods.", "para": 0, "sent": 4, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Behind the glass partition, a second desk.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Gideon Pratt, 50s, supervisor, pretends to type.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "He is not typing.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "How's the halfway house treating you, Darnell?", "name": "CRUZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Quiet. Too quiet, some nights.", "name": "DARNELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "That's normal. Sleep comes.", "name": "CRUZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "A sound in the ceiling.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "A tick.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "A pause.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Another tick.", "para": 2, "sent": 3, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Darnell's eyes go up.", "para": 2, "sent": 4, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Cruz's don't.", "para": 2, "sent": 5, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "You hear that?", "name": "DARNELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Old building. Pipes.", "name": "CRUZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "The ticking again.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Slower.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Closer to the vent.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Whitfield. Employment verification.", "name": "GIDEON", "speaker": 2, "ext": [], "paren": ["through the glass, flat"], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Darnell hands over a crumpled slip.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Gideon reads it without looking up.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Dock work. Nights. Forty hours.", "name": "GIDEON", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Yes sir.", "name": "DARNELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Don't \"sir\" me. Save it for the judge.", "name": "GIDEON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Cruz shoots Gideon a look through the glass.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "He shrugs and goes back to not typing.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The door opens.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Marisol Teague, 20s, intern, leans in with a stack of forms.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Sorry. Officer Cruz? The drug screen, it's in. He's clean.", "name": "MARISOL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Thank you, Mari.", "name": "CRUZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Marisol lingers, eyeing Darnell with open curiosity.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Cruz clears her throat.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Marisol backs out.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "The tick in the ceiling stops.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "The silence that replaces it is worse.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Ms. Cruz. Eleven years, I counted ceiling tiles. Four hundred and twelve. Same as this room.", "name": "DARNELL", "speaker": 1, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "You don't have to count anymore.", "name": "CRUZ", "speaker": 0, "ext": [], "paren": ["gently"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Habit.", "name": "DARNELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "This is the last time he will sit in a room where someone else holds the door.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "dialogue", "text": "Next appointment's the fourteenth. Same time. Don't be late, Darnell.", "name": "CRUZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "dialogue", "text": "Wouldn't dream of it.", "name": "DARNELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "He stands.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "Shakes her hand.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "His grip lingers a second too long.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Thank you. For not treating me like a file.", "name": "DARNELL", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "Cruz smiles, small and real.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "You're a person. Go be one.", "name": "CRUZ", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "A buzz.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "The door opens.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Light from the hallway, harsh and white.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "He walks into it.", "para": 12, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Behind him, in the vent, one more tick.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Nobody turns.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "Damn pipes.", "name": "GIDEON", "speaker": 2, "ext": [], "paren": ["to the empty room"], "dual": false, "present": [0, 1, 2, 3]}]}