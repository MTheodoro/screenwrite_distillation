{"scene_id": "s05098", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05098.fountain", "heading": "INT. QUICKROUTE DELIVERY WAREHOUSE - NIGHT", "cast": [{"id": 0, "name": "TEO", "names": ["TEO"], "gender": "m", "first": 5, "spoke": 3}, {"id": 1, "name": "ALEX", "names": ["ALEX"], "gender": "m", "first": 6, "spoke": 2}, {"id": 2, "name": "KEIKO", "names": ["KEIKO"], "gender": "f", "first": 11, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. QUICKROUTE DELIVERY WAREHOUSE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Cavernous.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Steel shelving rises into dark.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Pallets stacked like gravestones.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A single forklift beeps somewhere unseen.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "ANGLE ON a loading bay: Teo Marchetti, 40s, broad shoulders, a scar through one eyebrow, scans a package.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Beside him, Alex Rowan, 17, they/them, oversized hi-vis vest, drags a box twice their size.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Easy. Lift with your legs.", "name": "TEO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "I am lifting with my legs, Dad.", "name": "ALEX", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Teo hides a smile.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "A voice crackles over the PA.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Teo, we've got a rush on bay six. Insurance audit tomorrow, so don't lose anything.", "name": "KEIKO", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Keiko Tanaka, 50s, floor manager, appears at the end of the aisle with a clipboard, gray hair under a hairnet.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "INSERT - THE PACKAGE LABEL", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "\"HANDLE WITH CARE.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "FRAGILE.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "THIS SIDE UP.\"", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Alex's box slips.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "It hits the concrete.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Something inside cracks.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Everyone freezes.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Alex.", "name": "TEO", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "It was heavy.", "name": "ALEX", "speaker": 1, "ext": [], "paren": ["small"], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "WE SEE Keiko's face harden, then soften.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Take the night off. Both of you.", "name": "KEIKO", "speaker": 2, "ext": [], "paren": ["to Teo"], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "BACK TO SCENE", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Teo kneels, lifts the box, shakes it gently.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "A rattle.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "A sigh.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Hey. Nobody's fired. It's a lamp. We'll buy the lamp.", "name": "TEO", "speaker": 0, "ext": [], "paren": ["to Alex, soft"], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Alex wipes their eyes with a glove.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Teo ruffles their hair.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "The forklift beeps on.", "para": 12, "sent": 2, "present": [0, 1, 2]}]}