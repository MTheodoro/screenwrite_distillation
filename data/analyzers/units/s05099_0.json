{"scene_id": "s05099_0", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05099.fountain", "heading": "INT. NEW DAWN FERTILITY CENTER - LOBBY - MORNING", "cast": [{"id": 0, "name": "KARINA", "names": ["KARINA"], "gender": "f", "first": 8, "spoke": 3}, {"id": 1, "name": "KARI", "names": ["KARI"], "gender": "f", "first": 8, "spoke": 3}, {"id": 2, "name": "PHONE", "names": ["PHONE"], "gender": "?", "first": 16, "spoke": 0}, {"id": 3, "name": "DEV", "names": ["DEV"], "gender": "?", "first": 15, "spoke": 4}, {"id": 4, "name": "MIRA", "names": ["MIRA"], "gender": "f", "first": 15, "spoke": 3}, {"id": 5, "name": "DR. FONTAINE", "names": ["DR. FONTAINE"], "gender": "?", "first": 41, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. NEW DAWN FERTILITY CENTER - LOBBY - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "SERIES OF SHOTS:", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "-- A fish tank, bubbling.", "para": 1, "sent": 0, "present": []}, {"u": 3, "kind": "action", "text": "Three clownfish circle a plastic castle.", "para": 1, "sent": 1, "present": []}, {"u": 4, "kind": "action", "text": "-- A clock on the wall: 8:02.", "para": 2, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "-- Hands on a clipboard.", "para": 3, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "Rings.", "para": 3, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "Nervous pens.", "para": 3, "sent": 2, "present": []}, {"u": 8, "kind": "action", "text": "Karina Bell, 30s, stands at the reception desk in scrubs, and beside her, Kari Beal, 20s, a trainee, also in scrubs.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "They share a look.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "The name tags are a coin flip.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "No, I'm Karina. You're Kari.", "name": "KARINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "That's what I said.", "name": "KARI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "You said Karina.", "name": "KARINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "It's eight in the morning.", "name": "KARI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Dev Anand, 30s, and his wife Mira, 30s, enter holding hands too tightly.", "para": 5, "sent": 0, "present": [0, 1, 3, 4]}, {"u": 16, "kind": "action", "text": "ON PHONE (INSERT): Dev's screen.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "A text from his mother: \"DID YOU GO YET?", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "WE ARE PRAYING.\"", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "She's praying.", "name": "DEV", "speaker": 3, "ext": [], "paren": ["pocketing it"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "She's always praying.", "name": "MIRA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Her prayers are very specific.", "name": "DEV", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Mira laughs.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "Almost.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "MONTAGE - THE WAITING ROOM", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "-- 8:20.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Dev reads a magazine upside down.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "-- 8:44.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Mira scrolls her phone.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "ON PHONE: \"How to not panic during IVF consult.\"", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "-- 9:15.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "The clownfish.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Still circling.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "-- 9:40.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Karina and Kari argue over a chart.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Karina holds it higher.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Kari jumps for it.", "para": 12, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Kari, give me the file.", "name": "KARINA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Karina, I'm helping.", "name": "KARI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Which one's our nurse?", "name": "DEV", "speaker": 3, "ext": [], "paren": ["to Mira, whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Both. Neither. I can't tell.", "name": "MIRA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Dr. Odette Fontaine, 50s, steps out of a back room.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Silver bob, calm, a stethoscope like jewelry.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "dialogue", "text": "Mr. and Mrs. Anand? Come in, please.", "name": "DR. FONTAINE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "They stand.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "action", "text": "Dev is shaking.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Mira, honey, I love you, and I'm scared.", "name": "DEV", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "Dev, I love you, and I'm also scared. Walk.", "name": "MIRA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "They follow Dr. Fontaine.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "The door closes.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}