{"scene_id": "s05099_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05099.fountain", "heading": "INT. NEW DAWN FERTILITY CENTER - HALLWAY - LATER", "cast": [{"id": 0, "name": "DEV", "names": ["DEV"], "gender": "?", "first": 2, "spoke": 6}, {"id": 1, "name": "MIRA", "names": ["MIRA"], "gender": "f", "first": 2, "spoke": 4}, {"id": 2, "name": "NERVOUS COURIER", "names": ["NERVOUS COURIER", "COURIER"], "gender": "m", "first": 14, "spoke": 2}, {"id": 3, "name": "KARINA", "names": ["KARINA"], "gender": "f", "first": 16, "spoke": 2}, {"id": 4, "name": "KARI", "names": ["KARI"], "gender": "f", "first": 17, "spoke": 2}, {"id": 5, "name": "DR. FONTAINE", "names": ["DR. FONTAINE"], "gender": "f", "first": 30, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. NEW DAWN FERTILITY CENTER - HALLWAY - LATER", "present": []}, {"u": 1, "kind": "action", "text": "SUPER: \"THREE WEEKS LATER.\"", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Dev and Mira stand outside the exam room.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 3, "kind": "action", "text": "In Mira's hand, a small white stick.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "She turns it over.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "ON PHONE: Mira's text to her sister: \"ITS POSITIVE!!!!", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "DONT TELL MA\"", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Dev reads it over her shoulder.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You texted your sister before me?", "name": "DEV", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "You were in the bathroom.", "name": "MIRA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "I'm always in the bathroom!", "name": "DEV", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Mira bursts out laughing, tears coming now.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "He pulls her in.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Suddenly the door at the end of the hall bangs open.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "A man in a pharmacy delivery jacket, NERVOUS COURIER, 20s, rushes in with a cooler.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Is there a, uh, Odette? I need a signature. This thing's been in my car for six hours.", "name": "COURIER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Don't sign! It's the wrong clinic!", "name": "KARINA", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "He's wearing the wrong jacket!", "name": "KARI", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "The courier looks at Dev and Mira.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Mira looks at Dev.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Is that, is that our...", "name": "DEV", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Anand? Yeah?", "name": "COURIER", "speaker": 2, "ext": [], "paren": ["checking tag"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "That's the second batch!", "name": "MIRA", "speaker": 1, "ext": [], "paren": ["a gasp"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "We've got a baby on the way and a cooler in the hall! Everybody stay calm!", "name": "DEV", "speaker": 0, "ext": [], "paren": ["grabbing the cooler"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Karina and Kari run in from opposite ends of the hall and collide.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Charts everywhere.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Kari!", "name": "KARINA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Karina!", "name": "KARI", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "They both reach for the cooler.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Dev holds it above his head.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Dr. Fontaine steps out of the exam room, sees the chaos, folds her arms.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Is this a delivery, or a rugby match?", "name": "DR. FONTAINE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 32, "kind": "action", "text": "Everyone freezes.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 33, "kind": "action", "text": "A beat.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 34, "kind": "dialogue", "text": "Both.", "name": "MIRA", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 35, "kind": "action", "text": "SERIES OF SHOTS:", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 36, "kind": "action", "text": "-- The cooler, opened.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 37, "kind": "action", "text": "Inside: a small vase of flowers and a card.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "-- ON CARD: \"From Ma.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "action", "text": "We are praying.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "P.S. Congratulations.\"", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "-- Dev and Mira stare.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "Then look at each other.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "Then at the ceiling.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "action", "text": "-- Karina and Kari, side by side, wiping their eyes.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "How did she know?", "name": "DEV", "speaker": 0, "ext": [], "paren": ["soft"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "My sister told her.", "name": "MIRA", "speaker": 1, "ext": [], "paren": ["wiping her eyes"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "dialogue", "text": "Of course she did.", "name": "DEV", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "Mira leans her head on his shoulder.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "The clownfish circle on.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "transition", "text": "FADE OUT.", "present": [0, 1, 2, 3, 4, 5]}]}