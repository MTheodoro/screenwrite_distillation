{"scene_id": "s05106", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05106.fountain", "heading": "INT. CORNERSTONE FITNESS - MORNING", "cast": [{"id": 0, "name": "CAL", "names": ["CAL"], "gender": "m", "first": 2, "spoke": 8}, {"id": 1, "name": "BOZ", "names": ["BOZ"], "gender": "?", "first": 3, "spoke": 6}, {"id": 2, "name": "PAT", "names": ["PAT"], "gender": "?", "first": 13, "spoke": 2}, {"id": 3, "name": "INES", "names": ["INES", "WOMAN", "THE WOMAN"], "gender": "f", "first": 1, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. CORNERSTONE FITNESS - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "cal is on the leg press doing about half the weight he thinks he's doing, and boz, the trainer, is next to him counting reps in a voice that says he's counted a lot of reps, and across the floor a woman in a faded blue hoodie sits on the mat doing nothing at all and pat at the front desk is eating a banana and pretending to read the sign-in sheet.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "dialogue", "text": "it's been like three weeks for me", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 3, "kind": "dialogue", "text": "it's been like three weeks for you for like six years", "name": "BOZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 4, "kind": "dialogue", "text": "that's fair", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "THE WOMAN looks over from the mat.", "para": 1, "sent": 0, "present": [0, 1, 3]}, {"u": 6, "kind": "action", "text": "She takes her time, then goes back to staring at her shoes.", "para": 1, "sent": 1, "present": [0, 1, 3]}, {"u": 7, "kind": "dialogue", "text": "that's the one who comes at 6 and just sits", "name": "BOZ", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 3]}, {"u": 8, "kind": "dialogue", "text": "what's her deal", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 9, "kind": "dialogue", "text": "didn't ask", "name": "BOZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 10, "kind": "dialogue", "text": "you ask everybody", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 11, "kind": "dialogue", "text": "not her", "name": "BOZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 12, "kind": "action", "text": "pat leans over the desk.", "para": 2, "sent": 0, "present": [0, 1, 3]}, {"u": 13, "kind": "dialogue", "text": "hey, she's got a bag. like a doctor bag. she carries it everywhere", "name": "PAT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "maybe she is a doctor", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "doctors go to nicer gyms", "name": "PAT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "They all go quiet.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "The woman gets up, opens her bag, takes out a small plastic case and a folded paper, and sets them both very carefully on the bench next to cal, then sits again.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "uh hi?", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "you left your pills in the locker room. i found them. i'm ines. i'm a nurse. you took a double dose today didn't you. your hands are doing that thing", "name": "THE WOMAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "cal looks at his hands. boz looks at cal's hands. pat puts down the banana.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "i'm fine", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "okay", "name": "INES", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "She picks up her bag and walks out.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "The door sighs shut behind her.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "The leg press clanks, once, and stays at the bottom.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "cal. sit down", "name": "BOZ", "speaker": 1, "ext": [], "paren": ["after a while"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "i am sitting", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "okay", "name": "BOZ", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}