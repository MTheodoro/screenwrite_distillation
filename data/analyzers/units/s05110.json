{"scene_id": "s05110", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05110.fountain", "heading": "INT. GLAMOUR NAILS - DAY", "cast": [{"id": 0, "name": "JEN", "names": ["JEN"], "gender": "?", "first": 8, "spoke": 0}, {"id": 1, "name": "MO", "names": ["MO"], "gender": "?", "first": 8, "spoke": 0}, {"id": 2, "name": "BIG DAVE", "names": ["BIG DAVE"], "gender": "m", "first": 8, "spoke": 1}, {"id": 3, "name": "LILY", "names": ["LILY"], "gender": "f", "first": 8, "spoke": 2}, {"id": 4, "name": "TASHA", "names": ["TASHA"], "gender": "f", "first": 8, "spoke": 4}, {"id": 5, "name": "MRS. K", "names": ["MRS. K"], "gender": "f", "first": 23, "spoke": 3}, {"id": 6, "name": "^MO", "names": ["^MO"], "gender": "?", "first": 31, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. GLAMOUR NAILS - DAY", "present": []}, {"u": 1, "kind": "action", "text": "SERIES OF SHOTS:", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "- Neon sign flickers on.", "para": 1, "sent": 0, "present": []}, {"u": 3, "kind": "action", "text": "OPEN.", "para": 1, "sent": 1, "present": []}, {"u": 4, "kind": "action", "text": "Pink light on cracked linoleum.", "para": 1, "sent": 2, "present": []}, {"u": 5, "kind": "action", "text": "- Rows of polish bottles, a hundred shades of nothing-to-say.", "para": 2, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "Acetone haze hangs over the room like weather.", "para": 2, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "MRS. K, 60, owner, tiny, reading glasses on a beaded chain, runs the front desk like an air traffic tower.", "para": 3, "sent": 0, "present": []}, {"u": 8, "kind": "action", "text": "Her niece JEN, 20s, ponytail and a tattoo of a swallow on her wrist, files a customer's thumbnail while MO, 30s, soft-spoken and the only one who ever sits down, paints stripes on a toddler's birthday set and BIG DAVE, 50s, a mountain of a man in a tiny salon chair, is getting his first pedicure of his life for his daughter's wedding and hating every second, and in the corner LILY, 70s, silver bob, oxygen-thin voice, flips a magazine she isn't reading, while TASHA, 30s, in scrubs, still wearing her hospital badge, waits her turn with her phone face down.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 9, "kind": "action", "text": "MONTAGE - THE AFTERNOON", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "- 1:15 PM.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Big Dave winces.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "Jen laughs.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "- 2:40 PM.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Lily's magazine slips.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Tasha glances over.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Looks away.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "- 3:30 PM.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Lily's hand shakes on the armrest.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Sweat on her lip.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Nobody else sees.", "para": 7, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Ma'am? You okay?", "name": "TASHA", "speaker": 4, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Just warm.", "name": "LILY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Jen, the fan!", "name": "MRS. K", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "Jen turns the fan.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "The air moves.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 26, "kind": "action", "text": "Lily's eyes don't.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 27, "kind": "dialogue", "text": "Lily, right? When did you last eat?", "name": "TASHA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 28, "kind": "dialogue", "text": "Breakfast. I think. I don't--", "name": "LILY", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 29, "kind": "dialogue", "text": "She's grey. Why is she grey?", "name": "BIG DAVE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 30, "kind": "dialogue", "text": "Nobody panic in my shop!", "name": "MRS. K", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 31, "kind": "dialogue", "text": "Call 911. Somebody call 911!", "name": "^MO", "speaker": 6, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 32, "kind": "action", "text": "Tasha is already on her knees, two fingers at Lily's neck, and Jen grabs the phone, and Mrs. K knocks over a tray of bottles that SHATTER across the floor, red polish spreading like blood while Big Dave lifts the whole chair with Lily in it and Mo screams for room.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 33, "kind": "dialogue", "text": "Get her flat! Flat! Now!", "name": "TASHA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 34, "kind": "dialogue", "text": "Don't tell me what to do in my shop!", "name": "MRS. K", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 35, "kind": "dialogue", "text": "Then watch her die in it!", "name": "TASHA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 36, "kind": "action", "text": "Silence.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 37, "kind": "action", "text": "Then Lily's chest rises.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 38, "kind": "action", "text": "Falls.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 39, "kind": "action", "text": "Rises.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4, 5, 6]}, {"u": 40, "kind": "action", "text": "Sirens, far off, growing.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5, 6]}]}