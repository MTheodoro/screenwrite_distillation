{"scene_id": "s05111_0", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05111.fountain", "heading": "INT. NIGHTBIRD STUDIOS - LIVE ROOM - NIGHT", "cast": [{"id": 0, "name": "RILEY", "names": ["RILEY"], "gender": "m", "first": 8, "spoke": 13}, {"id": 1, "name": "PRIYA", "names": ["PRIYA"], "gender": "f", "first": 11, "spoke": 7}, {"id": 2, "name": "COLE", "names": ["COLE"], "gender": "m", "first": 14, "spoke": 10}, {"id": 3, "name": "DEZ", "names": ["DEZ"], "gender": "m", "first": 46, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHTBIRD STUDIOS - LIVE ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Midnight.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rain on the roof.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "HISS of the tape machine.", "para": 1, "sent": 0, "present": []}, {"u": 4, "kind": "action", "text": "A red RECORD light.", "para": 1, "sent": 1, "present": []}, {"u": 5, "kind": "action", "text": "Foam panels.", "para": 2, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "Cables like veins.", "para": 2, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "A grand piano under a sheet.", "para": 2, "sent": 2, "present": []}, {"u": 8, "kind": "action", "text": "RILEY, 30s, producer, hunches over the console.", "para": 3, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "He rubs his eyes.", "para": 3, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "Coffee gone cold.", "para": 3, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "Behind the glass, PRIYA, 20s, singer, stands at the mic.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Headphones on.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Eyes closed.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "COLE, 40s, engineer, slouches by the patch bay.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "He chews a pen.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Take eleven. From the bridge.", "name": "RILEY", "speaker": 0, "ext": [], "paren": ["into talkback"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Can I hear the guide?", "name": "PRIYA", "speaker": 1, "ext": [], "paren": ["through speaker"], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "It's in your cans.", "name": "RILEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "It's not.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "He checks the fader.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Pushes it up.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "BZZZT.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Feedback.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Everyone flinches.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "That wasn't me.", "name": "COLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Mute the room mics.", "name": "RILEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "They're muted.", "name": "COLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Silence.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Then a soft sound in the speakers.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "A breath.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Not Priya's.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Riley? Who's in here with me?", "name": "PRIYA", "speaker": 1, "ext": [], "paren": ["through speaker"], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Nobody. It's the monitors.", "name": "RILEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "He taps the glass.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "She doesn't turn.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "PHONE BUZZES on the console.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "He grabs it.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "ON PHONE: where r u", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "ON PHONE: the door is open", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "He frowns.", "para": 16, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Looks at the live room door.", "para": 16, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Shut.", "para": 16, "sent": 2, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "Locked.", "para": 16, "sent": 3, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "Light off.", "para": 16, "sent": 4, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Who is it?", "name": "COLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Dez. He's not even in the building.", "name": "RILEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "He thumbs a call.", "para": 17, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "Puts it on speaker.", "para": 17, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "RING.", "para": 18, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "RING.", "para": 18, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Riley? Why are you calling from my house?", "name": "DEZ", "speaker": 3, "ext": ["V.O."], "paren": ["distorted, far"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "What? I'm at the studio.", "name": "RILEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "I'm at the studio. I'm in the live room. Priya's with me.", "name": "DEZ", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Beat.", "para": 19, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Riley looks through the glass.", "para": 20, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Priya is alone.", "para": 21, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Mouth open.", "para": 21, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "Singing.", "para": 21, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "No sound.", "para": 21, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "Kill the tape.", "name": "COLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "I'm trying.", "name": "RILEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "dialogue", "text": "Kill it!", "name": "COLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "dialogue", "text": "It's not responding!", "name": "RILEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "BANG.", "para": 22, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "The piano sheet FLIES off.", "para": 23, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "The keys PLUNGE.", "para": 24, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "action", "text": "Alone.", "para": 24, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "action", "text": "A chord.", "para": 25, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "Low.", "para": 25, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "Wrong.", "para": 25, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "dialogue", "text": "It knows my name.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": ["through speaker"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "Priya, come out. Now.", "name": "RILEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "dialogue", "text": "It's saying it.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": ["through speaker"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "dialogue", "text": "Saying what?", "name": "COLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "dialogue", "text": "Don't open the door.", "name": "DEZ", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "dialogue", "text": "Dez, where are you?", "name": "RILEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "dialogue", "text": "Don't open the door don't open the door--", "name": "DEZ", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "action", "text": "CLICK.", "para": 26, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "action", "text": "Dead line.", "para": 26, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "action", "text": "A dog BARKS outside.", "para": 27, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "action", "text": "Frantic.", "para": 27, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "action", "text": "A delivery kid on the sidewalk ducks under an awning, phone raised, filming the building.", "para": 27, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "action", "text": "The dog drags its leash toward the street.", "para": 27, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 84, "kind": "action", "text": "Inside, the lights DIE.", "para": 28, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 85, "kind": "action", "text": "Red RECORD light only.", "para": 29, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 86, "kind": "dialogue", "text": "Where's the exit?", "name": "COLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 87, "kind": "dialogue", "text": "Behind you.", "name": "RILEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 88, "kind": "dialogue", "text": "There's a wall behind me!", "name": "COLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 89, "kind": "dialogue", "text": "Riley. Riley. Riley.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": ["through speaker"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 90, "kind": "dialogue", "text": "I'm coming.", "name": "RILEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 91, "kind": "dialogue", "text": "Don't.", "name": "COLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 92, "kind": "dialogue", "text": "She's in there!", "name": "RILEY", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 93, "kind": "dialogue", "text": "She's not alone!", "name": "COLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 94, "kind": "action", "text": "The glass CRACKS.", "para": 30, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 95, "kind": "action", "text": "A line zigzags across it.", "para": 30, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 96, "kind": "action", "text": "Priya turns.", "para": 31, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 97, "kind": "action", "text": "Slowly.", "para": 31, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 98, "kind": "action", "text": "Her eyes are open.", "para": 32, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 99, "kind": "action", "text": "They aren't hers.", "para": 32, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 100, "kind": "dialogue", "text": "Take twelve.", "name": "PRIYA", "speaker": 1, "ext": [], "paren": ["her voice, doubled"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 101, "kind": "action", "text": "The speakers SCREAM.", "para": 33, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 102, "kind": "action", "text": "Every fader slams to the top.", "para": 34, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 103, "kind": "action", "text": "Riley grabs the door.", "para": 35, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 104, "kind": "action", "text": "It burns.", "para": 35, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 105, "kind": "action", "text": "He kicks it.", "para": 36, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 106, "kind": "action", "text": "SLAM.", "para": 36, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 107, "kind": "action", "text": "It gives.", "para": 36, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 108, "kind": "action", "text": "He drags Cole through.", "para": 37, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 109, "kind": "action", "text": "They hit the corridor running.", "para": 37, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 110, "kind": "action", "text": "The red light follows them.", "para": 38, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 111, "kind": "action", "text": "Down the hall.", "para": 38, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 112, "kind": "action", "text": "Faster.", "para": 38, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 113, "kind": "action", "text": "BOOM.", "para": 39, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 114, "kind": "action", "text": "The whole building exhales.", "para": 40, "sent": 0, "present": [0, 1, 2, 3]}]}