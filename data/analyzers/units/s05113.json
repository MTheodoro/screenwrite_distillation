{"scene_id": "s05113", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05113.fountain", "heading": "INT. ST. VINCENT'S - FOURTH FLOOR CORRIDOR - NIGHT", "cast": [{"id": 0, "name": "MARGUERITE", "names": ["MARGUERITE"], "gender": "f", "first": 6, "spoke": 3}, {"id": 1, "name": "KIM", "names": ["KIM"], "gender": "?", "first": 3, "spoke": 2}, {"id": 2, "name": "OZZIE", "names": ["OZZIE"], "gender": "m", "first": 10, "spoke": 1}, {"id": 3, "name": "KIP", "names": ["KIP"], "gender": "m", "first": 4, "spoke": 1}, {"id": 4, "name": "DR. HALE", "names": ["DR. HALE"], "gender": "m", "first": 22, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. ST. VINCENT'S - FOURTH FLOOR CORRIDOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent hum.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A gurney wheel squeaks somewhere unseen.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Kim, 40s, charge nurse, stands at the station with a chart.", "para": 1, "sent": 0, "present": [1]}, {"u": 4, "kind": "action", "text": "Kip, 20s, orderly, mops in slow circles nearby.", "para": 1, "sent": 1, "present": [1, 3]}, {"u": 5, "kind": "action", "text": "A visitor sleeps in a chair, mouth open.", "para": 1, "sent": 2, "present": [1, 3]}, {"u": 6, "kind": "action", "text": "Marguerite Voss, 50s, attorney in a wet trench coat, strides in with a leather folio.", "para": 2, "sent": 0, "present": [0, 1, 3]}, {"u": 7, "kind": "dialogue", "text": "I need the patient in 412. Now.", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 8, "kind": "dialogue", "text": "Visiting hours ended at nine.", "name": "KIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 9, "kind": "dialogue", "text": "He signed a statement tonight. I need it witnessed before--", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3]}, {"u": 10, "kind": "action", "text": "Ozzie, 30s, night nurse, they/them, appears from a doorway, pale, pen still in hand.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Nobody's in 412. They went down at ten.", "name": "OZZIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Went down where?", "name": "KIP", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Ozzie, what do you mean, went down?", "name": "KIM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Then who signed this?", "name": "MARGUERITE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "She lifts the page.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Wet ink.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "Fresh.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "A call light CHIMES.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "412.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "All four look down the hall.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "The door is open.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Dr. Hale, 60, in a rumpled white coat, steps out of 412.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "He wipes his hands on a towel.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "He does not look at them.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "He's resting.", "name": "DR. HALE", "speaker": 4, "ext": [], "paren": ["soft"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "The lights flicker.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Out.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "On.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "The sleeping visitor is gone.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "The chair still rocks.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}]}