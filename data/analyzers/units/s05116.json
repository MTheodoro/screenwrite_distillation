{"scene_id": "s05116", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05116.fountain", "heading": "INT. MERCY GENERAL - NURSES' STATION - NIGHT", "cast": [{"id": 0, "name": "INES", "names": ["INES"], "gender": "f", "first": 8, "spoke": 9}, {"id": 1, "name": "WALLY", "names": ["WALLY"], "gender": "m", "first": 11, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "INT. MERCY GENERAL - NURSES' STATION - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "3 a.m.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The hospital hums.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Vending machine glows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A mop bucket sits abandoned.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Rain on the windows.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "Its heritage week, so the whole floor is in costume.", "para": 1, "sent": 0, "present": []}, {"u": 7, "kind": "action", "text": "A banner reads \"MERCY GENERAL: 100 YEARS OF CARING.\"", "para": 1, "sent": 1, "present": []}, {"u": 8, "kind": "action", "text": "INES, 50s, night nurse, wears a starched 1920s nurse's cap and a cardigan.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "She counts pills.", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "Dry as toast.", "para": 2, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "WALLY, 30s, resident, bursts through the doors in a full Victorian surgeon's apron and top hat.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "(Applause beat.)", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Good evening Ines. Did you miss me?", "name": "WALLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Seven hours isn't long enough.", "name": "INES", "speaker": 0, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "ANGLE ON Wally, who tips the hat.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "It falls off.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "It was a very sturdy hat this morning.", "name": "WALLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "dialogue", "text": "They gave you the one with the moth.", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He picks it up.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Looks inside.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "A moth flutters out.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Well. It's alive. That's more than I can say for my evening.", "name": "WALLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She slides a chart across the counter without a word.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "INSERT - THE CHART.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Room 9.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Patient: M. Alder.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Allergies: none.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Next of kin: blank.", "para": 8, "sent": 4, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "BACK TO SCENE", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Whos Mr. Alder?", "name": "WALLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Brought in at midnight. No visitors. No calls.", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Maybe he's shy.", "name": "WALLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Maybe.", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "She sorts the pills again.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Same pills.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Same order.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "You've counted those three times.", "name": "WALLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "Four.", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "He looks at her.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "She doesn't look back.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "The vending machine HUMS.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "Ines. Is something", "name": "WALLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Pass me the pen.", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "He passes the pen.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "She writes \"Alder\" and then crosses it out and writes it again, slower.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "WE SEE through the glass of Room 9, a man's hand resting on the blanket, a wedding ring catching the light.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "You know him.", "name": "WALLY", "speaker": 1, "ext": [], "paren": ["softly"], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "I know a lot of people.", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "Ines.", "name": "WALLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "He was a medic. In the old days. We worked a flood together in '09. He carried me out of a basement.", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "She puts the pen down very carefully, like it might break.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "Shall I", "name": "WALLY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "dialogue", "text": "No. I'll go.", "name": "INES", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "She straightens her cap.", "para": 15, "sent": 0, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "Walks to Room 9.", "para": 15, "sent": 1, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "At the door she pauses, one hand on the frame, and for a second the whole floor is silent.", "para": 15, "sent": 2, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "Even the rain.", "para": 15, "sent": 3, "present": [0, 1]}, {"u": 58, "kind": "action", "text": "CLOSE ON Wally, who takes off his ridiculous hat and holds it against his chest.", "para": 16, "sent": 0, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "She goes in.", "para": 17, "sent": 0, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "The door closes.", "para": 17, "sent": 1, "present": [0, 1]}, {"u": 61, "kind": "action", "text": "The monitor beeps once.", "para": 18, "sent": 0, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "Then again, faster.", "para": 18, "sent": 1, "present": [0, 1]}]}