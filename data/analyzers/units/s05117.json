{"scene_id": "s05117", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05117.fountain", "heading": "INT. NEW DAWN FERTILITY CLINIC - RECEPTION - NIGHT", "cast": [{"id": 0, "name": "JO", "names": ["JO"], "gender": "f", "first": 7, "spoke": 3}, {"id": 1, "name": "RAY", "names": ["RAY"], "gender": "m", "first": 13, "spoke": 4}, {"id": 2, "name": "FREEZER DOOR SLAMS", "names": ["FREEZER DOOR SLAMS"], "gender": "?", "first": 16, "spoke": 0}, {"id": 3, "name": "BEA", "names": ["BEA"], "gender": "f", "first": 26, "spoke": 2}, {"id": 4, "name": "RADIO", "names": ["RADIO"], "gender": "m", "first": 35, "spoke": 1}, {"id": 5, "name": "VIC", "names": ["VIC"], "gender": "m", "first": 37, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. NEW DAWN FERTILITY CLINIC - RECEPTION - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Empty waiting room.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Soft jazz on a dead speaker.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain streaks the windows.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Orchids.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "Glossy brochures.", "para": 1, "sent": 1, "present": []}, {"u": 6, "kind": "action", "text": "A wall of baby photos.", "para": 1, "sent": 2, "present": []}, {"u": 7, "kind": "action", "text": "JO, 30s, receptionist, locks the front drawer.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Hurries.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "Her phone BUZZES.", "para": 3, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "She snatches it.", "para": 4, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "Reads.", "para": 4, "sent": 1, "present": [0]}, {"u": 12, "kind": "action", "text": "Pales.", "para": 4, "sent": 2, "present": [0]}, {"u": 13, "kind": "action", "text": "RAY, 40s, night security, strolls in with a flashlight and a donut.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Working late, Jo?", "name": "RAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Just leaving.", "name": "JO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Door's alarmed. Nobody leaves till eleven.", "name": "RAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "She backs toward the hall.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Ray. Please.", "name": "JO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "BEEP-BEEP-BEEP.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "The alarm panel blinks red.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Ray's smile dies.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "He drops the donut.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "What did you take?", "name": "RAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Down the hall, a FREEZER DOOR SLAMS.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Both turn.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "BEA, 30s, lab tech, sprints out of the lab with a steel canister in her arms.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Frost pours off it.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Her scrubs are soaked.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Go! Go! Go!", "name": "BEA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Put it down!", "name": "RAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Those are eleven families, Ray!", "name": "BEA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "She's right. Look at the logs. Somebody's been selling them.", "name": "JO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Ray hesitates.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "His radio CRACKLES.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Unit four, status?", "name": "RADIO", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "A shadow fills the glass front doors.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "VIC, 50s, in a black coat, a clinic director's badge swinging from his neck, raises a keycard.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 38, "kind": "action", "text": "The lock CLICKS.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 39, "kind": "dialogue", "text": "Nobody move.", "name": "VIC", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 40, "kind": "action", "text": "Jo grabs the canister.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 41, "kind": "action", "text": "Bea shoves Ray.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 42, "kind": "action", "text": "The alarm SCREAMS.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 43, "kind": "action", "text": "They bolt for the fire exit.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}