{"scene_id": "s05118_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05118.fountain", "heading": "INT. DR. OKAFOR'S OFFICE - CONTINUOUS", "cast": [{"id": 0, "name": "SASHA", "names": ["SASHA"], "gender": "f", "first": 3, "spoke": 2}, {"id": 1, "name": "AIDEN", "names": ["AIDEN"], "gender": "m", "first": 4, "spoke": 3}, {"id": 2, "name": "MARLON", "names": ["MARLON"], "gender": "m", "first": 5, "spoke": 1}, {"id": 3, "name": "DR. OKAFOR", "names": ["DR. OKAFOR", "OKAFOR"], "gender": "m", "first": 24, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. DR. OKAFOR'S OFFICE - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "CLOSE ON the safe.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A small grey box behind a framed diploma.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Sasha works the dial with a stethoscope pressed against the metal.", "para": 1, "sent": 0, "present": [0]}, {"u": 4, "kind": "action", "text": "Aiden holds the flashlight steady.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 5, "kind": "action", "text": "Marlon stands in the door and watches the hall.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 6, "kind": "dialogue", "text": "Twelve. Twenty-six. Three.", "name": "SASHA", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "CLICK.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "The safe swings open.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Inside, on a velvet cushion, sits a small box.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "INSERT - THE BOX.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Sasha opens it.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Inside is a plain gold ring and a folded note.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Aiden unfolds the note and reads.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "\"If you are reading this, you found out I never told her I was sorry.\"", "name": "AIDEN", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Sasha takes the note, reads it, and passes it to Marlon.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "I don't think we should take it.", "name": "MARLON", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "Neither do I.", "name": "AIDEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Put it back.", "name": "SASHA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Aiden closes the box.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Places it in the safe.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Spins the dial.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "They tiptoe out of the office as the front door CREAKS and a flashlight beam sweeps across the waiting room.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Hello?", "name": "DR. OKAFOR", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "BACK TO SCENE", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "The three of them freeze in the hallway.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Aiden puts a finger to his lips.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "The beagle barks once.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "DR. OKAFOR, 60s, in a raincoat, steps into the beam.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "He sees them.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "You found it.", "name": "DR. OKAFOR", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "We put it back.", "name": "AIDEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Good. Come in and have some tea.", "name": "DR. OKAFOR", "speaker": 3, "ext": [], "paren": ["after a long moment"], "dual": false, "present": [0, 1, 2, 3]}]}