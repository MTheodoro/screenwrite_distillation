u": 31, "kind": "action", "text": "Darkness.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Nothing.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Then a soft blue glow.", "para": 15, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "The backpack unzips by itself.", "para": 15, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Zed climbs out.", "para": 16, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "A little round robot, one antenna bent.", "para": 16, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "Hello, Mabel.", "name": "ZED", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Hello, Zed. You're late.", "name": "MABEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Pip's jaw drops.", "para": 17, "sent": 0, "present": [0, 1, 2]}]}