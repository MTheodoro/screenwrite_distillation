{"scene_id": "s05120", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05120.fountain", "heading": "INT. HOLLOWAY VETERINARY CLINIC - NIGHT", "cast": [{"id": 0, "name": "CAL BRANNIGAN", "names": ["CAL BRANNIGAN", "CAL"], "gender": "m", "first": 5, "spoke": 30}, {"id": 1, "name": "COLE CALLOWAY", "names": ["COLE", "COLE CALLOWAY"], "gender": "m", "first": 12, "spoke": 23}, {"id": 2, "name": "MARSHAL TUCKER", "names": ["MARSHAL TUCKER"], "gender": "m", "first": 73, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. HOLLOWAY VETERINARY CLINIC - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Rain on the tin roof.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "One lamp burning.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "ANGLE ON the front desk.", "para": 1, "sent": 0, "present": []}, {"u": 4, "kind": "action", "text": "A cracked leather saddle bag sits on it, open.", "para": 1, "sent": 1, "present": []}, {"u": 5, "kind": "action", "text": "CAL BRANNIGAN, 50s, sun-cured and slow, stands over a sleeping hound on the steel exam table.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "He strokes its ear with two rough fingers.", "para": 2, "sent": 1, "present": [0]}, {"u": 7, "kind": "dialogue", "text": "There. Easy, old man.", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 8, "kind": "action", "text": "He hums.", "para": 3, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Something half-remembered.", "para": 3, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "The back door CREAKS.", "para": 4, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "He doesn't turn.", "para": 4, "sent": 1, "present": [0]}, {"u": 12, "kind": "dialogue", "text": "Still got that dog's leg looked at?", "name": "COLE", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Sutured an hour ago.", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Good.", "name": "COLE", "speaker": 1, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Coffee's on the stove, Cole.", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "COLE CALLOWAY, 40s, enters from the dark of the kennel hall.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Duster coat.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Dripping.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He smiles like a man at a funeral that went well.", "para": 5, "sent": 3, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "You're a hard man to find.", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Not hard. Just ain't been looking.", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Cole sets his hat on the counter.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "Takes his time.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Sit.", "name": "CAL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "I'll stand.", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Suit yourself.", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "He pours two tin cups.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Slides one across.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Cole doesn't take it.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "CLOSE ON the cup, steam curling.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Remember when we pulled that mare out of the Platte?", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "dialogue", "text": "Spring of '09.", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "She had a foal in her.", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Dead already.", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "You cried anyway.", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Cal almost laughs.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "He looks at the hound instead.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "I was young.", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "You were thirty-eight.", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "A beat.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "The rain softens.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "Nothing but the clock.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Nice quiet place you've made.", "name": "COLE", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "dialogue", "text": "It does the job.", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 45, "kind": "dialogue", "text": "Folks bring you strays? Hurt things?", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 46, "kind": "dialogue", "text": "Mostly.", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "And you fix them.", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "When I can.", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "Cole nods.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "He walks the length of the counter, one hand trailing along it.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 51, "kind": "action", "text": "He stops at the saddle bag.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "INSERT - THE BAG", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "A leather pouch inside.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "Tied with red twine.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "BACK TO SCENE", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "Cole doesn't touch it.", "para": 15, "sent": 0, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "He just looks.", "para": 15, "sent": 1, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "Heavier than it ought to be.", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "Feed money.", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "Is that right.", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "That's right.", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "Cole smiles.", "para": 16, "sent": 0, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "Cal does not.", "para": 16, "sent": 1, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "A phone RINGS on the wall.", "para": 17, "sent": 0, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "Old black rotary.", "para": 17, "sent": 1, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "Neither man moves.", "para": 17, "sent": 2, "present": [0, 1]}, {"u": 67, "kind": "action", "text": "It rings five times, six.", "para": 17, "sent": 3, "present": [0, 1]}, {"u": 68, "kind": "dialogue", "text": "Let it ring.", "name": "CAL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "Could be somebody's sick animal.", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "Could be.", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "action", "text": "He lifts the receiver anyway.", "para": 18, "sent": 0, "present": [0, 1]}, {"u": 72, "kind": "action", "text": "Holds it between them so both can hear.", "para": 18, "sent": 1, "present": [0, 1]}, {"u": 73, "kind": "dialogue", "text": "Cal? That you? Got a rider heading your way. Cole Calloway. Armed, and he ain't alone.", "name": "MARSHAL TUCKER", "speaker": 2, "ext": ["V.O."], "paren": ["tinny, through the line"], "dual": false, "present": [0, 1, 2]}, {"u": 74, "kind": "action", "text": "Silence.", "para": 19, "sent": 0, "present": [0, 1, 2]}, {"u": 75, "kind": "action", "text": "Cole's smile hasn't moved.", "para": 19, "sent": 1, "present": [0, 1, 2]}, {"u": 76, "kind": "dialogue", "text": "He's here.", "name": "CAL", "speaker": 0, "ext": [], "paren": ["into the phone"], "dual": false, "present": [0, 1, 2]}, {"u": 77, "kind": "dialogue", "text": "Cal, get out of there.", "name": "MARSHAL TUCKER", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 78, "kind": "action", "text": "Cal hangs up.", "para": 20, "sent": 0, "present": [0, 1, 2]}, {"u": 79, "kind": "action", "text": "Gently.", "para": 20, "sent": 1, "present": [1, 2]}, {"u": 80, "kind": "dialogue", "text": "You knew.", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [1, 2]}, {"u": 81, "kind": "dialogue", "text": "Saw your horse. Tied behind the feed store.", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 82, "kind": "dialogue", "text": "And you made coffee.", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 83, "kind": "dialogue", "text": "Seemed polite.", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 84, "kind": "action", "text": "WE SEE Cole's hand drift to his coat.", "para": 21, "sent": 0, "present": [0, 1, 2]}, {"u": 85, "kind": "action", "text": "Slow.", "para": 21, "sent": 1, "present": [0, 1, 2]}, {"u": 86, "kind": "action", "text": "ANGLE ON Cal's other hand, under the counter.", "para": 22, "sent": 0, "present": [0, 1, 2]}, {"u": 87, "kind": "dialogue", "text": "That hound on the table.", "name": "CAL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 88, "kind": "dialogue", "text": "What of him?", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 89, "kind": "dialogue", "text": "You shot him. Day before yesterday. Outside Dunmore.", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 90, "kind": "action", "text": "Cole's hand stops.", "para": 23, "sent": 0, "present": [0, 1, 2]}, {"u": 91, "kind": "dialogue", "text": "Took me three hours to dig the lead out.", "name": "CAL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 92, "kind": "dialogue", "text": "He was on my trail.", "name": "COLE", "speaker": 1, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2]}, {"u": 93, "kind": "dialogue", "text": "He was a dog.", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 94, "kind": "action", "text": "The hound stirs.", "para": 24, "sent": 0, "present": [0, 1, 2]}, {"u": 95, "kind": "action", "text": "Lifts his head.", "para": 24, "sent": 1, "present": [0, 1, 2]}, {"u": 96, "kind": "action", "text": "Looks at Cole.", "para": 24, "sent": 2, "present": [0, 1, 2]}, {"u": 97, "kind": "action", "text": "A low growl, half asleep.", "para": 25, "sent": 0, "present": [0, 1, 2]}, {"u": 98, "kind": "dialogue", "text": "Hell.", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 99, "kind": "dialogue", "text": "Said you'd come for him.", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 100, "kind": "dialogue", "text": "Who said?", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 101, "kind": "dialogue", "text": "Nobody. He just kept looking at the door.", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 102, "kind": "action", "text": "Cole laughs, short.", "para": 26, "sent": 0, "present": [0, 1, 2]}, {"u": 103, "kind": "action", "text": "Then he doesn't.", "para": 26, "sent": 1, "present": [0, 1, 2]}, {"u": 104, "kind": "dialogue", "text": "What's under that counter, Cal?", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 105, "kind": "dialogue", "text": "Same thing that was under it in '09.", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 106, "kind": "action", "text": "Rain.", "para": 27, "sent": 0, "present": [0, 1, 2]}, {"u": 107, "kind": "action", "text": "Nothing else.", "para": 27, "sent": 1, "present": [0, 1, 2]}, {"u": 108, "kind": "action", "text": "Cole lets his hand fall away from the coat.", "para": 28, "sent": 0, "present": [0, 1, 2]}, {"u": 109, "kind": "dialogue", "text": "I'll be damned.", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 110, "kind": "dialogue", "text": "Likely.", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 111, "kind": "action", "text": "Cole picks up his hat.", "para": 29, "sent": 0, "present": [0, 1, 2]}, {"u": 112, "kind": "action", "text": "Puts it on.", "para": 29, "sent": 1, "present": [0, 1, 2]}, {"u": 113, "kind": "action", "text": "Turns for the door.", "para": 29, "sent": 2, "present": [0, 1, 2]}, {"u": 114, "kind": "dialogue", "text": "Cole.", "name": "CAL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 115, "kind": "action", "text": "He stops.", "para": 30, "sent": 0, "present": [0, 1, 2]}, {"u": 116, "kind": "dialogue", "text": "Leave the pouch.", "name": "CAL", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 117, "kind": "dialogue", "text": "It ain't yours.", "name": "COLE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 118, "kind": "dialogue", "text": "Not asking for me.", "name": "CAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 119, "kind": "action", "text": "Cole looks at the dog.", "para": 31, "sent": 0, "present": [0, 1, 2]}, {"u": 120, "kind": "action", "text": "Then at the bag.", "para": 31, "sent": 1, "present": [0, 1, 2]}, {"u": 121, "kind": "action", "text": "He lays the twine-tied pouch on the counter, gentle as a newborn.", "para": 31, "sent": 2, "present": [0, 1, 2]}, {"u": 122, "kind": "action", "text": "He goes out into the rain.", "para": 32, "sent": 0, "present": [0, 1, 2]}, {"u": 123, "kind": "action", "text": "Cal lets out a long breath.", "para": 33, "sent": 0, "present": [0, 1, 2]}, {"u": 124, "kind": "action", "text": "Brings his hand out from under the counter.", "para": 33, "sent": 1, "present": [0, 1, 2]}, {"u": 125, "kind": "action", "text": "It's holding a tin of dog biscuits.", "para": 34, "sent": 0, "present": [0, 1, 2]}, {"u": 126, "kind": "action", "text": "He gives the hound one.", "para": 35, "sent": 0, "present": [0, 1, 2]}]}