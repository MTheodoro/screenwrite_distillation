{"scene_id": "s05121", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05121.fountain", "heading": "INT. COUNTY PAROLE OFFICE - DAY", "cast": [{"id": 0, "name": "OFFICER DANA REYES", "names": ["OFFICER DANA REYES", "DANA"], "gender": "f", "first": 4, "spoke": 7}, {"id": 1, "name": "ELI COLLINS", "names": ["ELI COLLINS", "ELI"], "gender": "m", "first": 5, "spoke": 11}, {"id": 2, "name": "ELLIS", "names": ["ELLIS"], "gender": "m", "first": 6, "spoke": 7}, {"id": 3, "name": "SGT. HAYES", "names": ["SGT. HAYES"], "gender": "m", "first": 19, "spoke": 6}, {"id": 4, "name": "NORA", "names": ["NORA"], "gender": "f", "first": 26, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. COUNTY PAROLE OFFICE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Grey light through blinds.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rain on the window.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A heater ticks in the corner.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "OFFICER DANA REYES sits behind a metal desk.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "In front of her, ELI COLLINS, 30, in a thrift-store jacket, hands flat on his knees.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "His younger brother ELLIS stands behind the chair, too close.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "The wall clock hums.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 8, "kind": "action", "text": "The rain gets harder.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Eli, you missed two check-ins.", "name": "DANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Bus broke down. I told the desk.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "The desk says nothing.", "name": "DANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "He was with me. We walked.", "name": "ELLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Ellis, you're not on the list for this meeting.", "name": "DANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "I'm family.", "name": "ELLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Ellis. Sit.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Ellis doesn't.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "A cheap phone BUZZES on the desk.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Dana checks it, frowns, puts it on speaker.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Reyes? Hayes, Fort Dunmore. You've got Collins there?", "name": "SGT. HAYES", "speaker": 3, "ext": ["V.O."], "paren": ["over the phone, crackling"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Sitting in front of me.", "name": "DANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Tell him the review board turned down the appeal.", "name": "SGT. HAYES", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Eli stares at the desk.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Nothing moves in his face.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "What appeal? You said you were done with them.", "name": "ELLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "I never said that.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "NORA, a caseworker in a cardigan, leans in at the door with a folder.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Dana, sorry, the ten-thirty is early.", "name": "NORA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Give us a minute, Nora.", "name": "DANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "They don't get to decide that. Not after what he did over there.", "name": "ELLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Son, nobody's denying what he did.", "name": "SGT. HAYES", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Ellis, stop.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "They gave him a medal and a record!", "name": "ELLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Sir, please lower your voice.", "name": "NORA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Mr. Collins, sit down or I'll call it.", "name": "DANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "Call it! Go ahead!", "name": "ELLIS", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "Is somebody shouting?", "name": "SGT. HAYES", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Everybody stop.", "name": "ELI", "speaker": 1, "ext": [], "paren": ["rising, quiet"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "The room freezes.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "The heater ticks.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Eli looks at the phone like it's a person.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Sergeant. Eleven men walked out of that valley because I did what I did. You remember the number. You signed the paper.", "name": "ELI", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "I remember.", "name": "SGT. HAYES", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Then you know what I'm asking for isn't mercy. It's a pen.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "The pen isn't mine to lift.", "name": "SGT. HAYES", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Then whose is it?", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Nobody answers.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Rain.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "The line hisses.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Ellis kicks the chair over.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "It CRASHES against the wall.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Dana is on her feet.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Nora backs into the hallway.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "Fifteen months of this. Fifteen months of signing in like a dog.", "name": "ELLIS", "speaker": 2, "ext": [], "paren": ["shaking"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "Ellis.", "name": "ELI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "That's enough. Both of you.", "name": "DANA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "action", "text": "Eli puts a hand on his brother's chest.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "Ellis is breathing hard.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "dialogue", "text": "Go wait outside.", "name": "ELI", "speaker": 1, "ext": [], "paren": ["soft"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "Ellis goes.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "action", "text": "The door shuts.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "The blinds rattle.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "Eli sets the chair upright.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "action", "text": "Sits.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "Folds his hands.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "dialogue", "text": "Sorry about that. What do you need me to sign?", "name": "ELI", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}