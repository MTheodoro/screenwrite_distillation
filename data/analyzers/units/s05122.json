{"scene_id": "s05122", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05122.fountain", "heading": "INT. NORTHSIDE RECORDING STUDIO - NIGHT", "cast": [{"id": 0, "name": "TIM", "names": ["TIM"], "gender": "m", "first": 4, "spoke": 9}, {"id": 1, "name": "TOM", "names": ["TOM"], "gender": "m", "first": 8, "spoke": 8}, {"id": 2, "name": "ENGINEER", "names": ["ENGINEER"], "gender": "m", "first": 8, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. NORTHSIDE RECORDING STUDIO - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A small vocal booth.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Foam on the walls.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A red light is on.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "TIM, 28, boxer, stands at the microphone.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "He wears a hooded training jacket.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "His hands are wrapped.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "He holds a paper with lyrics, but he does not look at it.", "para": 1, "sent": 3, "present": [0]}, {"u": 8, "kind": "action", "text": "Behind the glass, his trainer TOM, 55, sits next to a young ENGINEER with big headphones.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "A sleepy bulldog lies under the mixing desk.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Okay. Take four.", "name": "ENGINEER", "speaker": 2, "ext": [], "paren": ["through speaker"], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "Tim nods.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Music starts, a heavy beat.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "He opens his mouth.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Nothing comes.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "The music stops.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "It's okay. Again.", "name": "TOM", "speaker": 1, "ext": [], "paren": ["through speaker"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Again.", "name": "TIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "The beat starts.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Tim says two words, then stops.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "He rubs his wrapped knuckles.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "You have the words?", "name": "TOM", "speaker": 1, "ext": [], "paren": ["through speaker"], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "dialogue", "text": "I have the words.", "name": "TIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Then say them.", "name": "TOM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "Tim looks at the paper.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Folds it.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Puts it in his pocket.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Is not a song. It is only noise.", "name": "TIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "Tomorrow forty thousand people hear this noise when you walk to the ring.", "name": "TOM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Yes. I know.", "name": "TIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "The Engineer looks at his screen.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Very busy suddenly.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Tom takes off his headphones and goes to the booth.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "He opens the door.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "The bulldog lifts its head, then lays it down again.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Tom stands close.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "He fixes Tim's collar.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "His hands are not quite steady.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Your father had the same face. Before his last fight.", "name": "TOM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "You said he was not afraid.", "name": "TIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "I said many things.", "name": "TOM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Tim looks at him a long time.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "Then he laughs once, short.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "You are a bad liar, Tom.", "name": "TIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "I am a good trainer.", "name": "TOM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Same thing, in your case.", "name": "TIM", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "Tom tries to smile.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "It doesn't hold.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "He goes back to the control room.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Sits.", "para": 11, "sent": 3, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "Puts on the headphones.", "para": 11, "sent": 4, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "From the top. Do not think. Just talk.", "name": "TOM", "speaker": 1, "ext": ["CONT'D"], "paren": ["through speaker"], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "The beat.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "Tim closes his eyes.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "He is waiting at the door. He is waiting for me.", "name": "TIM", "speaker": 0, "ext": [], "paren": ["quietly, to the beat"], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "Tom looks down at his own hands.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 56, "kind": "dialogue", "text": "Let him wait.", "name": "TIM", "speaker": 0, "ext": ["CONT'D"], "paren": ["a little louder"], "dual": false, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "The Engineer stops pretending to be busy.", "para": 14, "sent": 0, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "He is looking at Tim now.", "para": 14, "sent": 1, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "The red light stays on.", "para": 15, "sent": 0, "present": [0, 1, 2]}]}