{"scene_id": "s05123", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05123.fountain", "heading": "INT. NEONARENA GAMING TOURNAMENT - FINALS STAGE - DAY", "cast": [{"id": 0, "name": "ZED", "names": ["ZED"], "gender": "?", "first": 3, "spoke": 6}, {"id": 1, "name": "LIA", "names": ["LIA"], "gender": "f", "first": 3, "spoke": 5}, {"id": 2, "name": "OMAR", "names": ["OMAR"], "gender": "m", "first": 3, "spoke": 5}, {"id": 3, "name": "PRIYA", "names": ["PRIYA"], "gender": "f", "first": 3, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "INT. NEONARENA GAMING TOURNAMENT - FINALS STAGE - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Lights flash purple and green.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A crowd of four thousand is screaming.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Somewhere a commentator shouts about a \"clutch play\" and the huge screen above shows a frozen game of dragons, and under the stage a smoke machine is making too much smoke, and in the booth ZED the team captain, LIA the sniper, OMAR the coach and PRIYA the substitute are already sitting down in matching orange jerseys.", "para": 0, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 4, "kind": "dialogue", "text": "Okay okay okay we are fine", "name": "ZED", "speaker": 0, "ext": [], "paren": ["adjusting headset, whispering to himself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 5, "kind": "dialogue", "text": "Everybody is hearing me? Mic check one two.", "name": "LIA", "speaker": 1, "ext": [], "paren": ["to the group, loudly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "dialogue", "text": "Loud and clear", "name": "OMAR", "speaker": 2, "ext": [], "paren": ["thumbs up, chewing a protein bar"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "dialogue", "text": "You have the wrong crosshair she told us yesterday", "name": "PRIYA", "speaker": 3, "ext": [], "paren": ["to Lia, pointing at her screen"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "She is not the coach. Omar is the coach", "name": "LIA", "speaker": 1, "ext": [], "paren": ["not looking away from the screen"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Thank you Lia", "name": "OMAR", "speaker": 2, "ext": [], "paren": ["mouth full"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "The crowd roars.", "para": 1, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Cold air from the vents.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "A drone camera hovers near the booth like a very expensive fly.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "Strategy is simple. We go left. Always left.", "name": "ZED", "speaker": 0, "ext": [], "paren": ["to the whole team, hands shaking"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Left was how we lost the semi final", "name": "PRIYA", "speaker": 3, "ext": [], "paren": ["raising hand"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Left is good. Left is good.", "name": "ZED", "speaker": 0, "ext": [], "paren": ["ignoring her, muttering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Maybe also some right", "name": "OMAR", "speaker": 2, "ext": [], "paren": ["to Zed, gently"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "No right!", "name": "ZED", "speaker": 0, "ext": [], "paren": ["snapping"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "The announcer calls their team name.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "It is mispronounced.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "The audience laughs.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Please not the live stream. Please not my mother watching", "name": "LIA", "speaker": 1, "ext": [], "paren": ["to herself, quiet"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Your mother is watching. She is in the third row with a sign", "name": "PRIYA", "speaker": 3, "ext": [], "paren": ["to Lia, leaning over"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "She has a sign", "name": "LIA", "speaker": 1, "ext": [], "paren": ["horrified, covering her face"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Okay listen. One game. Nobody dies. We are here for the free pizza anyway", "name": "OMAR", "speaker": 2, "ext": [], "paren": ["to everyone, standing"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Is there pizza?", "name": "ZED", "speaker": 0, "ext": [], "paren": ["to Omar, hopeful"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "There is always pizza", "name": "OMAR", "speaker": 2, "ext": [], "paren": ["pointing off"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Then I am already winning", "name": "PRIYA", "speaker": 3, "ext": [], "paren": ["softly, to no one"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "The countdown begins.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "A big red three.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "Two.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Left.", "name": "LIA", "speaker": 1, "ext": [], "paren": ["eyes narrowed, whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Left.", "name": "ZED", "speaker": 0, "ext": [], "paren": ["whispering back"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Right.", "name": "PRIYA", "speaker": 3, "ext": [], "paren": ["under her breath"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "One.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "A horn BLARES.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}]}