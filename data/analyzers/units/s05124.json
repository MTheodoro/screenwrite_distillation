 "name": "NELL", "speaker": 0, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Then why are you whispering.", "name": "ROOK", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "She doesn't answer.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "Listens.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Dripping.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Somewhere, a pipe.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Nothing else.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Something's wrong.", "name": "NELL", "speaker": 0, "ext": [], "paren": ["beat"], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "Vault room is thirty metres. Keep walking.", "name": "ROOK", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She keeps walking.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Her shoes squeak on the concrete.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Squeak.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Squeak.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Stop.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "The squeaking continues.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Two steps behind her.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "She turns.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "Empty corridor.", "para": 15, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "A door, slightly open.", "para": 15, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "A shadow moves inside it.", "para": 16, "sent": 0, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "Neil?", "name": "NELL", "speaker": 0, "ext": [], "paren": ["barely audible"], "dual": false, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "NEIL, 30s, same hoodie, steps out.", "para": 17, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Sweating.", "para": 17, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Holding a drill case.", "para": 17, "sent": 2, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "You're late.", "name": "NEIL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "You're early.", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "I'm here since six. I was in the ceiling.", "name": "NEIL", "speaker": 2, "ext": [], "paren": ["tight"], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "She stares at him.", "para": 18, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "He is smiling.", "para": 18, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "It's wrong.", "para": 18, "sent": 2, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Nell? Who are you talking to?", "name": "ROOK", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "Neil's here.", "name": "NELL", "speaker": 0, "ext": [], "paren": ["into the earpiece"], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Neil is in the van.", "name": "ROOK", "speaker": 1, "ext": ["V.O."], "paren": ["pause"], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Silence.", "para": 19, "sent": 0, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "Her phone.", "para": 20, "sent": 0, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Dead.", "para": 20, "sent": 1, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "She looks up.", "para": 21, "sent": 0, "present": [0, 1, 2]}, {"u": 51, "kind": "action", "text": "Neil's smile fades.", "para": 21, "sent": 1, "present": [0, 1, 2]}, {"u": 52, "kind": "action", "text": "He glances at something behind her.", "para": 21, "sent": 2, "present": [0, 1, 2]}, {"u": 53, "kind": "action", "text": "A heavy footstep.", "para": 22, "sent": 0, "present": [0, 1, 2]}, {"u": 54, "kind": "action", "text": "A guard.", "para": 23, "sent": 0, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "BRAM, 40s, radio on his belt, hand resting on a holster.", "para": 23, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "He stands under the exit sign.", "para": 23, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "dialogue", "text": "Evening.", "name": "BRAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "Nobody moves.", "para": 24, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "The overhead light FLICKERS.", "para": 25, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "Which one of you is not on my list?", "name": "BRAM", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "action", "text": "The light dies.", "para": 26, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "Darkness.", "para": 27, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "A zipper.", "para": 28, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "A click.", "para": 28, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "Then one gunshot.", "para": 29,