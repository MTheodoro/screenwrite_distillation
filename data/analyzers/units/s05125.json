{"scene_id": "s05125", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05125.fountain", "heading": "INT. STATE PAROLE OFFICE - DAY", "cast": [{"id": 0, "name": "GLORIA PRUITT", "names": ["GLORIA", "GLORIA PRUITT"], "gender": "f", "first": 1, "spoke": 4}, {"id": 1, "name": "HARLAN", "names": ["HARLAN"], "gender": "f", "first": 5, "spoke": 1}, {"id": 2, "name": "WENDELL", "names": ["WENDELL"], "gender": "m", "first": 6, "spoke": 1}, {"id": 3, "name": "PETE", "names": ["PETE"], "gender": "m", "first": 11, "spoke": 1}, {"id": 4, "name": "FRANK", "names": ["FRANK"], "gender": "m", "first": 15, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. STATE PAROLE OFFICE - DAY", "present": []}, {"u": 1, "kind": "dialogue", "text": "Eleven years running parolees. You learn that nobody ever comes in on time, and nobody ever leaves happy.", "name": "GLORIA", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0]}, {"u": 2, "kind": "action", "text": "GLORIA PRUITT, 50s, reading glasses on a chain, sits at a desk stacked with folders.", "para": 0, "sent": 0, "present": [0]}, {"u": 3, "kind": "action", "text": "A wall clock TICKS.", "para": 0, "sent": 1, "present": [0]}, {"u": 4, "kind": "action", "text": "A fluorescent tube BUZZES.", "para": 0, "sent": 2, "present": [0]}, {"u": 5, "kind": "action", "text": "HARLAN, 40s, orange tie, sits across from her holding a paper cup.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Next to him, WENDELL, 40s, wears the same tie.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "You two are brothers?", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Twins.", "name": "HARLAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Fraternal.", "name": "WENDELL", "speaker": 2, "ext": [], "paren": [], "dual": true, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Both released the same morning. Both wearing the same tie. The state, in its wisdom, issued one tie per cell.", "name": "GLORIA", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "PETE, the clerk, sticks his head in the door.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Ms. Pruitt, your husband's on line two.", "name": "PETE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "The phone on her desk BUZZES.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "She picks it up.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Did you eat? You didn't eat.", "name": "FRANK", "speaker": 4, "ext": ["V.O."], "paren": ["on the phone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "I'm working, Frank.", "name": "GLORIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Harlan sips from the cup.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "It is empty.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "He keeps sipping anyway.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}]}