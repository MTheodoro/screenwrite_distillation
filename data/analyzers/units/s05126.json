{"scene_id": "s05126", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05126.fountain", "heading": "EXT. THE MARGARET ANN - NORTH SEA - DAY", "cast": [{"id": 0, "name": "SAL", "names": ["SAL"], "gender": "m", "first": 6, "spoke": 7}, {"id": 1, "name": "JEN", "names": ["JEN"], "gender": "?", "first": 8, "spoke": 5}, {"id": 2, "name": "MO", "names": ["MO"], "gender": "m", "first": 9, "spoke": 2}, {"id": 3, "name": "RO", "names": ["RO", "WOMAN", "THE WOMAN"], "gender": "f", "first": 5, "spoke": 6}, {"id": 4, "name": "BIG DAVE", "names": ["BIG DAVE"], "gender": "m", "first": 54, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. THE MARGARET ANN - NORTH SEA - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Grey water.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Grey sky.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Gulls.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A restored 1890s sailing smack, brown sails patched, bobbing hard.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "The crew wear wool jerseys and oilskins of the period, a living-history charter for tourists.", "para": 1, "sent": 1, "present": [3]}, {"u": 6, "kind": "action", "text": "SAL, 60, skipper, white beard, stands at the tiller.", "para": 2, "sent": 0, "present": [0, 3]}, {"u": 7, "kind": "action", "text": "Weather in every wrinkle.", "para": 2, "sent": 1, "present": [0, 3]}, {"u": 8, "kind": "action", "text": "JEN, 25, pulls a net hand over hand.", "para": 3, "sent": 0, "present": [0, 1, 3]}, {"u": 9, "kind": "action", "text": "MO, 19, coils rope badly.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Between them, near the mast, a WOMAN sits on an upturned crate.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Mid-30s.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "A city coat, no oilskin.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Dry shoes.", "para": 4, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "She watches the horizon like she's counting something.", "para": 4, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "action", "text": "Spray.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "Not like that. Over, under.", "name": "JEN", "speaker": 1, "ext": [], "paren": ["to Mo"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "That's what I did.", "name": "MO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "It's not.", "name": "JEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Mo tries again.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Worse.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Leave him, Jen. Sea'll teach him.", "name": "SAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Sea'll drown him.", "name": "JEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Same lesson.", "name": "SAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "The Woman almost smiles.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Wind.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Canvas SNAPS.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "You'll want to move, miss. Boom's coming round.", "name": "SAL", "speaker": 0, "ext": ["CONT'D"], "paren": ["to the Woman"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "I'm fine.", "name": "THE WOMAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "You're not.", "name": "SAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "She doesn't move.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Silence.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "A gull.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Then another.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "The boom swings.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Fast.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Jen dives.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Catches the Woman by the collar.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "They roll across the deck.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "The boom sails over, an inch above.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Quiet.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "Everyone breathing.", "para": 15, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Are you out of your mind?", "name": "JEN", "speaker": 1, "ext": [], "paren": ["shaking"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "dialogue", "text": "Probably.", "name": "THE WOMAN", "speaker": 3, "ext": [], "paren": ["flat"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Sal lashes the boom.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "Hard hands, hard face.", "para": 16, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "What's your name, miss?", "name": "SAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Ro.", "name": "THE WOMAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Rosalind?", "name": "SAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Just Ro.", "name": "RO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "You weren't scared.", "name": "MO", "speaker": 2, "ext": [], "paren": ["staring"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "I was.", "name": "RO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Another engine, from behind the fog.", "para": 17, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Out of the mist comes a harbour patrol launch.", "para": 18, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "At the rail, BIG DAVE, 50s, enormous in a yellow slicker, peaked cap, a clipboard in a fist like a shovel.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "Margaret Ann! Permit check!", "name": "BIG DAVE", "speaker": 4, "ext": [], "paren": ["through a megaphone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Of course.", "name": "SAL", "speaker": 0, "ext": [], "paren": ["muttering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "Big Dave looks across the water.", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "Finds Ro.", "para": 19, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "His expression softens.", "para": 19, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "Rosalind. Your mother's been calling the harbour all morning.", "name": "BIG DAVE", "speaker": 4, "ext": [], "paren": ["not on the megaphone"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "action", "text": "Ro closes her eyes.", "para": 20, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "dialogue", "text": "Your mother?", "name": "JEN", "speaker": 1, "ext": [], "paren": ["to Ro, quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "dialogue", "text": "I wanted to see where she grew up.", "name": "RO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "Mo goes back to his rope.", "para": 21, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "Over, under.", "para": 21, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "Right this time.", "para": 21, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "action", "text": "Rain begins.", "para": 22, "sent": 0, "present": [0, 1, 2, 3, 4]}]}