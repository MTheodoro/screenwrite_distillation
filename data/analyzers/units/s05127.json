{"scene_id": "s05127", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05127.fountain", "heading": "INT. GRAND MERIDIAN BALLROOM - WEDDING AFTERPARTY - NIGHT", "cast": [{"id": 0, "name": "DJ", "names": ["DJ"], "gender": "?", "first": 2, "spoke": 0}, {"id": 1, "name": "WAITER", "names": ["WAITER"], "gender": "m", "first": 3, "spoke": 1}, {"id": 2, "name": "TEENAGERS", "names": ["TEENAGERS"], "gender": "m", "first": 3, "spoke": 0}, {"id": 3, "name": "LEO MARCHETTI", "names": ["LEO MARCHETTI", "LEO"], "gender": "m", "first": 4, "spoke": 5}, {"id": 4, "name": "LEON", "names": ["LEON"], "gender": "m", "first": 9, "spoke": 6}], "units": [{"u": 0, "kind": "heading", "text": "INT. GRAND MERIDIAN BALLROOM - WEDDING AFTERPARTY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Warm lights.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A DJ plays a slow song.", "para": 0, "sent": 1, "present": [0]}, {"u": 3, "kind": "action", "text": "A WAITER carries a tray of champagne past two TEENAGERS filming each other on their phones.", "para": 0, "sent": 2, "present": [0, 1, 2]}, {"u": 4, "kind": "action", "text": "LEO MARCHETTI, 30s, tux, bow tie crooked, stands near the cake table.", "para": 1, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 5, "kind": "action", "text": "Sharp eyes.", "para": 1, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "action", "text": "Dead calm.", "para": 1, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "In his ear, a tiny flesh-coloured bud.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "In position. Cake table, east side.", "name": "LEO", "speaker": 3, "ext": [], "paren": ["murmuring, lips barely moving"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Copy. Vault camera loops in ninety seconds. On my mark.", "name": "LEON", "speaker": 4, "ext": ["V.O."], "paren": ["in earpiece, from the van"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "dialogue", "text": "Say again?", "name": "LEO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "dialogue", "text": "Ninety. Eighty-nine.", "name": "LEON", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "CLOSE ON Leo's wrist.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "action", "text": "A silver watch.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Seconds sweeping.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "ANGLE ON the bride, laughing, her diamond choker catching the light.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "WE SEE a tall man in grey, her uncle, drift toward the exit.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Subject moving. Door three.", "name": "LEO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Hold position. Do not engage.", "name": "LEON", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "A dog barks.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "A small terrier in a bow tie trots past the cake.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Nobody said there'd be a dog.", "name": "LEO", "speaker": 3, "ext": [], "paren": ["under his breath"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Sixty. Fifty-nine.", "name": "LEON", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "The waiter stops beside Leo.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Offers a glass.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Champagne, sir?", "name": "WAITER", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Please.", "name": "LEO", "speaker": 3, "ext": [], "paren": ["smiling"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "He takes it.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Drinks.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Doesn't blink.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Thirty. Twenty-nine.", "name": "LEON", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "BACK TO SCENE", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "The song swells.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "The bride lifts her hands to the crowd.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "Now.", "name": "LEON", "speaker": 4, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "The lights die.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "Darkness.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Screams, then laughter, then a drumroll from the DJ.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Leo is already gone.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}]}