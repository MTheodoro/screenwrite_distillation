{"scene_id": "s05128", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05128.fountain", "heading": "INT. NIGHT BUS 47 - MOVING - NIGHT", "cast": [{"id": 0, "name": "ASH", "names": ["ASH"], "gender": "?", "first": 4, "spoke": 7}, {"id": 1, "name": "BRI", "names": ["BRI"], "gender": "?", "first": 5, "spoke": 6}, {"id": 2, "name": "TEO", "names": ["TEO"], "gender": "m", "first": 6, "spoke": 5}, {"id": 3, "name": "DRIVER", "names": ["DRIVER"], "gender": "m", "first": 7, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT BUS 47 - MOVING - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Rain streaks the windows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sodium lights slide past.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "The engine drones.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "ASH, 17, headphones around their neck, sits in the back seat with their phone glowing in both hands.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Across the aisle, BRI, 17, hoodie up, chews her thumbnail.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Two rows ahead, TEO, 18, stares out at nothing.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Up front, the DRIVER hums along to the radio.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "A sleeping TEENAGER in a school jacket leans against the window.", "para": 2, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "Dead quiet, until Bri's phone BUZZES.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "INSERT - PHONE SCREEN", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "\"mom: where r u. answer me.\"", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "BACK TO SCENE", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "She's literally gonna kill me.", "name": "BRI", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "So answer.", "name": "ASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "And say what? \"Hi Mom, I'm on a bus to a city I've never been to\"?", "name": "BRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "You guys could keep it down.", "name": "TEO", "speaker": 2, "ext": [], "paren": ["turning around"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Nobody asked you, Teo.", "name": "ASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "I'm just saying, the driver.", "name": "TEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "He can't hear us.", "name": "BRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "He has a radio.", "name": "ASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "He has ears.", "name": "TEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "Ash, did you tell him about the video?", "name": "BRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "No, I told no one. They told me.", "name": "ASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Who told you what?", "name": "TEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "Stop, you two are being so loud.", "name": "BRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "We're not loud, you're loud.", "name": "ASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "You're both loud.", "name": "TEO", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "The bus brakes hard.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Everyone lurches.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "The sleeping teenager wakes, looks around, falls back asleep.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "This is the last time the three of them will be calm.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Hey. I don't think we're on the route anymore.", "name": "ASH", "speaker": 0, "ext": [], "paren": ["softer"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "What?", "name": "BRI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Look. That's the river. We should be going north.", "name": "ASH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Teo stands.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "The Driver's humming has stopped.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "The radio dies.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Only the rain.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "The Driver's eyes find them in the rear-view mirror.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Sit down, kids.", "name": "DRIVER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}