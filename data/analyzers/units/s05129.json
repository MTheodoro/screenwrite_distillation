{"scene_id": "s05129", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05129.fountain", "heading": "INT. GOLDEN LOTUS NAIL SALON - DAY", "cast": [{"id": 0, "name": "CUSTOMERS", "names": ["CUSTOMERS"], "gender": "?", "first": 7, "spoke": 0}, {"id": 1, "name": "KID", "names": ["KID"], "gender": "?", "first": 8, "spoke": 0}, {"id": 2, "name": "MARISOL", "names": ["MARISOL"], "gender": "f", "first": 11, "spoke": 17}, {"id": 3, "name": "CORINNE", "names": ["CORINNE", "WOMAN", "THE WOMAN"], "gender": "f", "first": 9, "spoke": 16}], "units": [{"u": 0, "kind": "heading", "text": "INT. GOLDEN LOTUS NAIL SALON - DAY", "present": []}, {"u": 1, "kind": "action", "text": "SUPER: \"CHICAGO.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "2:14 PM.\"", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Pastel walls.", "para": 1, "sent": 0, "present": []}, {"u": 4, "kind": "action", "text": "Acetone in the air.", "para": 1, "sent": 1, "present": []}, {"u": 5, "kind": "action", "text": "A wall of polish bottles in every colour.", "para": 1, "sent": 2, "present": []}, {"u": 6, "kind": "action", "text": "A TV in the corner plays a muted boxing replay.", "para": 1, "sent": 3, "present": []}, {"u": 7, "kind": "action", "text": "Two CUSTOMERS in the next chairs chat in Vietnamese.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "A KID in a school uniform does homework by the register.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "THE WOMAN, 40s, sunglasses, tailored coat, sits at the manicure station.", "para": 3, "sent": 0, "present": [0, 1, 3]}, {"u": 10, "kind": "action", "text": "Her phone lies face down.", "para": 3, "sent": 1, "present": [0, 1, 3]}, {"u": 11, "kind": "action", "text": "Across the table, MARISOL, 30s, white smock, files her nails.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "The file SCRAPES.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "A drier HUMS.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "You do a lovely job.", "name": "THE WOMAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Thank you.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "I mean it. Steady hands.", "name": "THE WOMAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Practice.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": ["smiling"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "She dips a brush.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Paints a stripe of red.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "INSERT - THE BOTTLE", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Label: \"Knockout.\"", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "BACK TO SCENE", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Funny name.", "name": "THE WOMAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "It sells.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "The Woman glances at the TV.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "The replay shows a boxer going down in the ninth.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "You watch the fights?", "name": "THE WOMAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "My father did.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Did?", "name": "THE WOMAN", "speaker": 3, "ext": [], "paren": ["carefully"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Every Saturday. He had a favourite. Danny Kessler.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "The Woman goes still.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Kessler retired.", "name": "THE WOMAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "He was told to.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "The brush keeps moving.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Steady.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Steady.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "I'm not sure what you mean.", "name": "THE WOMAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "My father bet the house on Danny. Round nine. Everybody knew it was fixed except him. He found out when the referee stopped it too early. A small man, tan suit, glasses. He looked at the floor so nobody could see his eyes.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": ["mild"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "(beat)", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "I was twelve.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "I remember my father holding the TV remote like it was a gun.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "action", "text": "I remember him saying one word, over and over.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "\"Why.\"", "para": 13, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "And then he stopped saying it.", "para": 13, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "The drier HUMS.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "The Kid turns a page.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Years later I found the referee. Gambling debts. He'd been told to stop the fight, or lose his daughter's school fees. The man in the tan suit was a coward. But the man who told him? He was the coward's boss.", "name": "MARISOL", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "(beat)", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "That boss has a very good manicurist.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "She says he comes every second Tuesday.", "para": 16, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Does she.", "name": "THE WOMAN", "speaker": 3, "ext": [], "paren": ["very still"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "She does.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "The Woman's hand, flat on the table, does not move.", "para": 17, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "A DOOR BELL RINGS.", "para": 18, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "Two men in dark jackets enter.", "para": 18, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "They look around, then settle near the entrance.", "para": 18, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "The Woman watches them in the mirror.", "para": 19, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "dialogue", "text": "You're quite sure of this.", "name": "THE WOMAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "I have his receipts. Every one.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "You're not a manicurist.", "name": "THE WOMAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "I'm a very good manicurist.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "She caps the bottle.", "para": 20, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "CLICK.", "para": 20, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "dialogue", "text": "My name is Marisol Kessler.", "name": "MARISOL", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "action", "text": "The Woman takes off her sunglasses.", "para": 21, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "action", "text": "Her eyes are old and tired.", "para": 21, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "Danny's daughter.", "name": "THE WOMAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "Yes.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "dialogue", "text": "Then you know my name.", "name": "THE WOMAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "dialogue", "text": "Corinne Vale.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "dialogue", "text": "He deserved a better life than he got.", "name": "CORINNE", "speaker": 3, "ext": [], "paren": ["a breath"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "dialogue", "text": "So did my father.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "action", "text": "Corinne looks at the red nails, her hands under the lamp.", "para": 22, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "dialogue", "text": "The men at the door. They're not mine.", "name": "CORINNE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "dialogue", "text": "No.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "dialogue", "text": "Yours?", "name": "CORINNE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 77, "kind": "action", "text": "Marisol nods slightly.", "para": 23, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 78, "kind": "dialogue", "text": "I came here for a manicure.", "name": "CORINNE", "speaker": 3, "ext": ["CONT'D"], "paren": ["a faint laugh"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 79, "kind": "dialogue", "text": "And you got one.", "name": "MARISOL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 80, "kind": "action", "text": "The TV roars.", "para": 24, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 81, "kind": "action", "text": "A crowd chanting a name that isn't Danny's.", "para": 24, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 82, "kind": "action", "text": "Corinne's phone BUZZES on the table.", "para": 25, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 83, "kind": "action", "text": "She doesn't touch it.", "para": 25, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 84, "kind": "action", "text": "It stops.", "para": 26, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 85, "kind": "action", "text": "The Kid looks up from his homework.", "para": 27, "sent": 0, "present": [0, 1, 2, 3]}]}