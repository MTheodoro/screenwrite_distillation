{"scene_id": "s05132", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05132.fountain", "heading": "EXT. CAR PARK, SEAFRONT - FOOD TRUCK - DAY", "cast": [{"id": 0, "name": "PAULINE ABBOTT", "names": ["PAULINE ABBOTT", "PAULINE"], "gender": "f", "first": 6, "spoke": 7}, {"id": 1, "name": "JUNE", "names": ["JUNE"], "gender": "f", "first": 7, "spoke": 3}, {"id": 2, "name": "GRAHAM LOCKE", "names": ["GRAHAM LOCKE", "GRAHAM"], "gender": "m", "first": 12, "spoke": 5}], "units": [{"u": 0, "kind": "heading", "text": "EXT. CAR PARK, SEAFRONT - FOOD TRUCK - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A battered Citro\u00ebn van with a hatch cut into its side, painted the colour of weak custard.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "\"NAN'S CHIPS\" is lettered above the hatch.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Drizzle.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Gulls.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "The sea has gone somewhere else for the afternoon.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "Inside, PAULINE ABBOTT, 60s, wiry, hair under a net, watches the fryer as if it owes her money.", "para": 1, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Her grandchild JUNE, 17, they/them, ink on their knuckles, wipes a counter that is already clean.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "You've got that look.", "name": "PAULINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "What look?", "name": "JUNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "The one your mother had before she told me about Leeds.", "name": "PAULINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "The hatch RATTLES.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "A man in a good coat, GRAHAM LOCKE, 50s, leans in, politely lost.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "dialogue", "text": "Sorry. Is this Pauline's?", "name": "GRAHAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Depends who's asking.", "name": "PAULINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Council. Licensing. It's, well, it's about the pitch.", "name": "GRAHAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "The fryer HISSES.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Nobody speaks.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "This is the afternoon Pauline will remember when she is asked what went wrong.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "They've already sold it, Nan. Haven't they.", "name": "JUNE", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "I wouldn't say sold.", "name": "GRAHAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Lovely. Chips, Graham? On the house.", "name": "PAULINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Her smile is perfectly fixed.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "She drops the basket into the oil.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "It SPITS.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "That's very kind, but I really shouldn't.", "name": "GRAHAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Oh, I insist.", "name": "PAULINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Nan.", "name": "JUNE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "It's only chips, June.", "name": "PAULINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "A pause.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "The gulls get on with it.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Graham takes the paper cone and, after a moment, eats one.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Bit good, this.", "name": "GRAHAM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Forty years.", "name": "PAULINE", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}]}