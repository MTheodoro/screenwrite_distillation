{"scene_id": "s05140", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05140.fountain", "heading": "INT. STORAGE UNIT 214 - DAY", "cast": [{"id": 0, "name": "PRIYA", "names": ["PRIYA"], "gender": "f", "first": 4, "spoke": 7}, {"id": 1, "name": "TEO", "names": ["TEO"], "gender": "m", "first": 18, "spoke": 2}, {"id": 2, "name": "MOVERS", "names": ["MOVERS", "THE MOVERS"], "gender": "?", "first": 2, "spoke": 1}, {"id": 3, "name": "WALT", "names": ["WALT", "OLD MAN"], "gender": "m", "first": 10, "spoke": 7}, {"id": 4, "name": "CREAKING", "names": ["CREAKING"], "gender": "?", "first": 38, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. STORAGE UNIT 214 - DAY", "present": []}, {"u": 1, "kind": "action", "text": "HANDHELD.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The camera wobbles down a corridor of orange roll-up doors.", "para": 0, "sent": 1, "present": [2]}, {"u": 3, "kind": "action", "text": "Fluorescent hum.", "para": 0, "sent": 2, "present": [2]}, {"u": 4, "kind": "action", "text": "Priya Nair, 30s, holds the lens on herself, then swings it to a padlocked unit.", "para": 0, "sent": 3, "present": [0, 2]}, {"u": 5, "kind": "dialogue", "text": "Day three of the interviews. Everyone says Mr. Okafor's unit is just old furniture.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": ["to camera"], "dual": false, "present": [0, 2]}, {"u": 6, "kind": "action", "text": "An old man in a faded field jacket stands by the door, keys in hand.", "para": 1, "sent": 0, "present": [0, 2]}, {"u": 7, "kind": "action", "text": "Not hostile.", "para": 1, "sent": 1, "present": [0, 2]}, {"u": 8, "kind": "action", "text": "Not welcoming either.", "para": 1, "sent": 2, "present": [0, 2]}, {"u": 9, "kind": "action", "text": "ON CAMERA: the old man rubs his thumb over the padlock.", "para": 2, "sent": 0, "present": [0, 2]}, {"u": 10, "kind": "dialogue", "text": "Furniture. Yes. My wife's chairs.", "name": "OLD MAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Can you say your name for the record?", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Is it recording now?", "name": "OLD MAN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3]}, {"u": 13, "kind": "action", "text": "The phone in Priya's pocket BUZZES.", "para": 3, "sent": 0, "present": [0, 2, 3]}, {"u": 14, "kind": "action", "text": "She checks it, winces.", "para": 3, "sent": 1, "present": [0, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "Sorry. My producer.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 2, 3]}, {"u": 16, "kind": "action", "text": "She thumbs the speaker on.", "para": 4, "sent": 0, "present": [0, 2, 3]}, {"u": 17, "kind": "action", "text": "Her phone crackles.", "para": 4, "sent": 1, "present": [0, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Are you inside yet? Legal wants the release signed before you open anything.", "name": "TEO", "speaker": 1, "ext": ["V.O."], "paren": ["tinny"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "He signed it. We're fine.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Priya, listen. The records came back. That name, Okafor, it's not --", "name": "TEO", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "The call DROPS.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Priya stares at the screen.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Three bars.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Nothing.", "para": 5, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "The old man slides the key in.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "The lock CLACKS open.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "The door RATTLES upward on its track.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Inside: two chairs.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "A lamp.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "And a dozen olive-green crates stacked to the ceiling, each stencilled with a unit patch.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "My name is Walt Okafor. I was never in the unit I told you about.", "name": "OLD MAN", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Behind them, THE MOVERS, three men in grey coveralls, wheel a dolly down the corridor and stop dead.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Mr. Okafor?", "name": "THE MOVERS", "speaker": 2, "ext": [], "paren": ["together"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "dialogue", "text": "Not yet, boys.", "name": "WALT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "Walt, what is in those crates?", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Open one.", "name": "WALT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "The camera drops.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "We hear only her breath, a lid CREAKING, and then silence.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "They are not mine. I only kept them.", "name": "WALT", "speaker": 3, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "These are names.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Four hundred and six.", "name": "WALT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Walt, stop. WALT ^ I'm done lying.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "The corridor lights FLICKER and go out.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}]}