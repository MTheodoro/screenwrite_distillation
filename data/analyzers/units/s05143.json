{"scene_id": "s05143", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05143.fountain", "heading": "EXT. MAPLE HOLLOW PARK - DAY", "cast": [{"id": 0, "name": "TESSA", "names": ["TESSA"], "gender": "f", "first": 4, "spoke": 8}, {"id": 1, "name": "CAM", "names": ["CAM"], "gender": "m", "first": 8, "spoke": 4}, {"id": 2, "name": "FLASH MOB", "names": ["FLASH MOB"], "gender": "p", "first": 32, "spoke": 0}, {"id": 3, "name": "DETECTIVE MARA ROY", "names": ["DETECTIVE MARA ROY", "MARA"], "gender": "f", "first": 44, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. MAPLE HOLLOW PARK - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Ring light on a tripod.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Phone on a gimbal.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A fake-casual dance setup at the edge of the lawn.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Tessa, 17, hair in a claw clip, loads the screen.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "She taps the red button twice and checks her follower count like it might have changed.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "ON PHONE: 41.2K followers.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "LIVE in 3...2...1", "para": 2, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "Cam, 17, stands behind the tripod pretending to adjust the light.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "He keeps looking at the tote bag at his feet.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 10, "kind": "dialogue", "text": "ok ok ok we're live. hi besties. today's trend is the sidewalk glide, pls do not judge us.", "name": "TESSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "You said no one would be here.", "name": "CAM", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "that's a ring light, not a spotlight. chill.", "name": "TESSA", "speaker": 0, "ext": [], "paren": ["through a smile"], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "She starts the dance.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He joins, stiff, limbs all wrong.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Across the lawn, a woman in a beige raincoat, dark glasses, newspaper folded under her arm, watches without blinking.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Who's that?", "name": "CAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Just some lady. keep going.", "name": "TESSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "He does not keep going.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He stops.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She spins mid-move and collides with him.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "bro. you're ruining the take.", "name": "TESSA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "She's been here since we got here. She's cop-energy.", "name": "CAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "she's reading a newspaper, Cam. nobody reads newspapers. that's what makes her fake.", "name": "TESSA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "The woman folds the paper, tucks it away, and starts toward them.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Slow.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Not hurrying.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "Tessa taps the screen.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "LIVE keeps running.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "ON PHONE: 3,900 watching. chat is flying. \"who is that\" \"behind u\" \"RUN\"", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "it's not funny anymore.", "name": "TESSA", "speaker": 0, "ext": ["CONT'D"], "paren": ["whispering"], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "It was never supposed to be.", "name": "CAM", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "THE FLASH MOB, twelve kids in matching hoodies who have been stretching by the fountain, break into a synced dance.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Phones up.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Music BLASTS from a speaker.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "The woman stops, confused, swallowed by the crowd.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "dialogue", "text": "go go go!", "name": "TESSA", "speaker": 0, "ext": ["CONT'D"], "paren": ["grinning"], "dual": false, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "He grabs the tote bag.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "She grabs the gimbal.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "They run for the gate, laughing, terrified, thumbs still on the screen.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "ON PHONE: 12K watching.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "\"WHERE ARE U GOING\"", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "At the gate, the woman is already there.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "She lifts her sunglasses.", "para": 13, "sent": 1, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Hi, Tessa. Hi, Cam. Mind if I ask what's in the bag?", "name": "DETECTIVE MARA ROY", "speaker": 3, "ext": [], "paren": ["calm"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "He freezes.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "She freezes.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "The phone keeps filming.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "it's just... props.", "name": "TESSA", "speaker": 0, "ext": [], "paren": ["very small"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "dialogue", "text": "Mm. That's what the last two said.", "name": "MARA", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "She holds out her hand.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}]}