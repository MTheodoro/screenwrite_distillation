{"scene_id": "s05145", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05145.fountain", "heading": "INT. RIVERSIDE BANQUET HALL - WEDDING AFTERPARTY - NIGHT", "cast": [{"id": 0, "name": "DJ", "names": ["DJ"], "gender": "?", "first": 3, "spoke": 5}, {"id": 1, "name": "GWEN", "names": ["GWEN"], "gender": "f", "first": 6, "spoke": 12}, {"id": 2, "name": "ASH", "names": ["ASH"], "gender": "?", "first": 9, "spoke": 11}], "units": [{"u": 0, "kind": "heading", "text": "INT. RIVERSIDE BANQUET HALL - WEDDING AFTERPARTY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Streamers.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Half-eaten cake.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A DJ booth abandoned mid-song.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "The last guests have gone.", "para": 0, "sent": 3, "present": [0]}, {"u": 5, "kind": "action", "text": "Two people remain.", "para": 0, "sent": 4, "present": [0]}, {"u": 6, "kind": "action", "text": "Gwen, 30s, in a bridesmaid dress and one shoe, drags a folding chair into the middle of the floor and drops onto it like she's been shot.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Best. Wedding. Ever.", "name": "GWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "The side door SLAMS open.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "Ash, 30s, they/them, enters in a velvet blazer, holding a tray of leftover champagne flutes like a waiter at a very strange restaurant.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "You did not say that during the toast.", "name": "ASH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "During the toast I was holding in a sneeze and a sob.", "name": "GWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Same thing, honestly.", "name": "ASH", "speaker": 2, "ext": [], "paren": ["setting down the tray"], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Gwen grabs a flute.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Ash takes one.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "They clink.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Neither drinks.", "para": 3, "sent": 3, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Okay. Real talk. Did you see the groom's uncle?", "name": "GWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "dialogue", "text": "The one who made the toast to \"his many wives\"?", "name": "ASH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "He has one wife.", "name": "GWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Then he's very ambitious.", "name": "ASH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Gwen cracks up.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Ash pretends not to be pleased.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "You're good at this, you know that? Making people feel like they're not at a funeral.", "name": "GWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "They are at a funeral. It's just a really good one.", "name": "ASH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "The overhead speaker CRACKLES.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "A distant voice, faint and metallic, comes through the PA.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "Hey, uh, last song's still queued up. Should I play it?", "name": "DJ", "speaker": 0, "ext": ["V.O."], "paren": ["over speaker"], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "What song?", "name": "GWEN", "speaker": 1, "ext": [], "paren": ["to the ceiling"], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "It's, uh... it's labeled \"DO NOT PLAY.\"", "name": "DJ", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Gwen and Ash exchange a look.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "Obviously play it.", "name": "ASH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Ash, no.", "name": "GWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "Gwen. Yes.", "name": "ASH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "The speakers hum.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "A single piano note.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Another.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Then a voice, a woman's voice, soft, singing in a language neither of them knows.", "para": 7, "sent": 3, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "The room goes still.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "The streamers stop swaying.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "The candles on the tables light themselves, one by one, in a perfect ring around the dance floor.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 41, "kind": "dialogue", "text": "Please tell me that's the DJ's idea of a joke.", "name": "GWEN", "speaker": 1, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2]}, {"u": 42, "kind": "dialogue", "text": "The DJ left at ten.", "name": "ASH", "speaker": 2, "ext": [], "paren": ["not joking"], "dual": false, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Guys... I'm still in the booth. I didn't press anything.", "name": "DJ", "speaker": 0, "ext": ["V.O."], "paren": ["over speaker, shaking"], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "action", "text": "The door at the end of the hall SWINGS open on its own.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "A figure in a long pale dress stands there, face hidden, hands folded in front like a bride.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 46, "kind": "dialogue", "text": "Is that... is that Priya's grandmother?", "name": "GWEN", "speaker": 1, "ext": [], "paren": ["small"], "dual": false, "present": [0, 1, 2]}, {"u": 47, "kind": "dialogue", "text": "Priya's grandmother died in March.", "name": "ASH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 48, "kind": "dialogue", "text": "So that's a no.", "name": "GWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "The figure takes one step.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "The candles all lean toward it.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "Okay. New plan.", "name": "ASH", "speaker": 2, "ext": [], "paren": ["very calm"], "dual": false, "present": [0, 1, 2]}, {"u": 52, "kind": "dialogue", "text": "I love a new plan.", "name": "GWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 53, "kind": "dialogue", "text": "We run.", "name": "ASH", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 54, "kind": "dialogue", "text": "Oh, I love that plan.", "name": "GWEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 55, "kind": "action", "text": "They bolt for the exit together.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 56, "kind": "action", "text": "The side door SLAMS shut behind them.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 57, "kind": "action", "text": "The song swells.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 58, "kind": "action", "text": "The figure lifts its veil.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 59, "kind": "action", "text": "Underneath, grinning, is the DJ.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 60, "kind": "dialogue", "text": "Gotcha.", "name": "DJ", "speaker": 0, "ext": [], "paren": ["lowering the headset"], "dual": false, "present": [0, 1, 2]}, {"u": 61, "kind": "dialogue", "text": "Hey! That's my line.", "name": "DJ", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": ["over speaker, offended"], "dual": false, "present": [0, 1, 2]}]}