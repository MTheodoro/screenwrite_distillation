{"scene_id": "s05147", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05147.fountain", "heading": "INT. IRONWORKS GYM - EARLY MORNING", "cast": [{"id": 0, "name": "NARRATOR", "names": ["NARRATOR"], "gender": "?", "first": 5, "spoke": 7}, {"id": 1, "name": "JESS", "names": ["JESS"], "gender": "f", "first": 6, "spoke": 10}, {"id": 2, "name": "KYLE", "names": ["KYLE", "HOODIE MAN"], "gender": "m", "first": 13, "spoke": 11}, {"id": 3, "name": "BIG MO", "names": ["BIG MO"], "gender": "m", "first": 48, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. IRONWORKS GYM - EARLY MORNING", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent tubes buzz awake one bank at a time.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Rubber mats.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Chalk dust drifting in the light.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A treadmill whirs somewhere in the back.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "dialogue", "text": "Every gym smells the same. Sweat, bleach, and people trying to outrun something.", "name": "NARRATOR", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0]}, {"u": 6, "kind": "action", "text": "Jess, 30s, a former detective turned personal trainer, wipes down a bench.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Her knuckles are scabbed.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She does not look like she sleeps.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "That's me. Jess. I used to chase the wrong people for a living. Now I help them chase their goals.", "name": "NARRATOR", "speaker": 0, "ext": ["V.O.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "The front door CHIMES.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "A man in a grey hoodie hovers by the desk, hood up, hands deep in his pockets.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "We're closed till six.", "name": "JESS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "I'm not here to train.", "name": "HOODIE MAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Quiet.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Then why?", "name": "JESS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Someone said you used to work cases.", "name": "HOODIE MAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Trouble always walks in with its hood up.", "name": "NARRATOR", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Jess sets down the towel.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Slowly.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Used to.", "name": "JESS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "He pulls out a photograph and slides it across the desk.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "A young woman, smiling, in a gym tank top.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "That's my sister. She trained here. Two weeks ago she stopped answering.", "name": "HOODIE MAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Lots of people quit. Gyms are full of people who quit.", "name": "JESS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Not her.", "name": "HOODIE MAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "Silence.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Jess studies the photo.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Then the man.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Then the photo again.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "The photo had a date on the back. A date she shouldn't have known.", "name": "NARRATOR", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "What's your name?", "name": "JESS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "Does it matter?", "name": "HOODIE MAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "dialogue", "text": "It does to me.", "name": "JESS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "He hesitates.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Pulls the hood down.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "Mid-thirties.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Tired eyes.", "para": 8, "sent": 3, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "Kyle.", "name": "HOODIE MAN", "speaker": 2, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "Kyle Brandt.", "name": "KYLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Brandt. I knew that name. I had buried that name.", "name": "NARRATOR", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Jess goes still.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "The treadmill in the back keeps whirring, steady, patient.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "dialogue", "text": "Kyle. How long have you known where I work?", "name": "JESS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Since the funeral.", "name": "KYLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "action", "text": "Nothing.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "A locker door CLANGS in the back.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "Both turn.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "From behind the lockers steps Big Mo, 50s, the gym owner, wiping his hands on a towel.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "He is too casual.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Everything okay out here?", "name": "BIG MO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "dialogue", "text": "Fine.", "name": "KYLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "dialogue", "text": "Fine.", "name": "JESS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "dialogue", "text": "Because it sounds like a conversation I should be in.", "name": "BIG MO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Nobody answers.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "The towel in his hand is red at the corner.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Mo kept a clean gym. Always. Except that morning.", "name": "NARRATOR", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Kyle's eyes drop to the towel.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "Then to Jess.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "dialogue", "text": "He's the last person who saw her.", "name": "KYLE", "speaker": 2, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 60, "kind": "dialogue", "text": "Kid, you don't want to say that.", "name": "BIG MO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 61, "kind": "dialogue", "text": "I just did.", "name": "KYLE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 62, "kind": "action", "text": "Silence.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 63, "kind": "action", "text": "Jess steps between them without seeming to.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 64, "kind": "action", "text": "Her hand finds the heavy kettlebell on the shelf.", "para": 16, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 65, "kind": "dialogue", "text": "Mo. Open the back room.", "name": "JESS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 66, "kind": "dialogue", "text": "It's just storage.", "name": "BIG MO", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 67, "kind": "dialogue", "text": "Then it won't take long.", "name": "JESS", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 68, "kind": "dialogue", "text": "That was the last honest thing any of us said in that building.", "name": "NARRATOR", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 69, "kind": "action", "text": "Mo smiles.", "para": 17, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 70, "kind": "action", "text": "It is not a happy smile.", "para": 17, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 71, "kind": "action", "text": "He drops the towel.", "para": 17, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 72, "kind": "action", "text": "Behind the lockers, a phone begins to RING.", "para": 18, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 73, "kind": "action", "text": "Soft.", "para": 18, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 74, "kind": "action", "text": "Persistent.", "para": 18, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 75, "kind": "action", "text": "All three look toward the sound.", "para": 19, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 76, "kind": "action", "text": "The ringtone is a pop song the sister used to hum while she lifted.", "para": 20, "sent": 0, "present": [0, 1, 2, 3]}]}