{"scene_id": "s05148_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05148.fountain", "heading": "INT. NEW BEGINNINGS FERTILITY CLINIC - HALLWAY - CONTINUOUS", "cast": [{"id": 0, "name": "DEV", "names": ["DEV"], "gender": "m", "first": 4, "spoke": 4}, {"id": 1, "name": "KAREN", "names": ["KAREN", "THE WOMAN"], "gender": "f", "first": 1, "spoke": 3}, {"id": 2, "name": "MAYA", "names": ["MAYA"], "gender": "f", "first": 15, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. NEW BEGINNINGS FERTILITY CLINIC - HALLWAY - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "The generator HUMS louder here.", "para": 0, "sent": 0, "present": [1]}, {"u": 2, "kind": "action", "text": "A row of steel tanks, each frosted with cold.", "para": 0, "sent": 1, "present": [1]}, {"u": 3, "kind": "action", "text": "The woman is already at the biggest one, pulling at its door.", "para": 0, "sent": 2, "present": [1]}, {"u": 4, "kind": "dialogue", "text": "Hey. Hey! You can't touch that.", "name": "DEV", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "The backup power's failing. Somebody has to move them.", "name": "THE WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Who are you?", "name": "DEV", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Karen Ellis. Lab tech. Eleven years.", "name": "THE WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Karen. My wife's in there right now.", "name": "DEV", "speaker": 0, "ext": [], "paren": ["quieter"], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Then you'd better help me lift.", "name": "KAREN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "He looks at the tank.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "At her.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "At the dark ceiling.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "Dev takes off his jacket and grabs the other handle.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Behind them, the swinging door opens.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Maya stands there, pale, with the nurse behind her.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Dev. What are you doing?", "name": "MAYA", "speaker": 2, "ext": [], "paren": ["very still"], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "Saving the thing we came here for.", "name": "DEV", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "This is the first time all week that anyone in this building has told the truth.", "para": 4, "sent": 0, "present": [0, 1, 2]}]}