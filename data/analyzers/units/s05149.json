{"scene_id": "s05149", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05149.fountain", "heading": "INT. COUNTY PAROLE OFFICE - NIGHT", "cast": [{"id": 0, "name": "THE WOMAN", "names": ["THE WOMAN"], "gender": "m", "first": 2, "spoke": 7}, {"id": 1, "name": "KIP", "names": ["KIP"], "gender": "m", "first": 21, "spoke": 1}, {"id": 2, "name": "KIM", "names": ["KIM"], "gender": "?", "first": 22, "spoke": 6}, {"id": 3, "name": "MARGARET", "names": ["MARGARET"], "gender": "f", "first": 51, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. COUNTY PAROLE OFFICE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent light.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The kind that hums.", "para": 0, "sent": 1, "present": [0]}, {"u": 3, "kind": "action", "text": "A corridor of closed doors and one open one at the end where a lamp burns yellow.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "Rain on the window.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Rain on the roof.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "The building ticks as it cools.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "He sits alone in the chair across from the empty desk.", "para": 2, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "Waiting.", "para": 2, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "His coat is still damp and he has not taken it off.", "para": 2, "sent": 2, "present": [0]}, {"u": 10, "kind": "action", "text": "His hands rest on his knees like something set down and forgotten.", "para": 2, "sent": 3, "present": [0]}, {"u": 11, "kind": "action", "text": "Nobody told him the office closed at five.", "para": 2, "sent": 4, "present": [0]}, {"u": 12, "kind": "action", "text": "Nobody told him anything.", "para": 2, "sent": 5, "present": [0]}, {"u": 13, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0]}, {"u": 14, "kind": "action", "text": "The wall clock says 9:41.", "para": 4, "sent": 0, "present": [0]}, {"u": 15, "kind": "action", "text": "The wall clock has said 9:41 since he walked in.", "para": 4, "sent": 1, "present": [0]}, {"u": 16, "kind": "action", "text": "A door opens down the hall.", "para": 5, "sent": 0, "present": [0]}, {"u": 17, "kind": "action", "text": "Footsteps, slow, and the squeak of rubber on linoleum.", "para": 5, "sent": 1, "present": [0]}, {"u": 18, "kind": "action", "text": "A woman in a long dark cardigan, grey hair pinned back, appears in the doorway with a mug in both hands.", "para": 5, "sent": 2, "present": [0]}, {"u": 19, "kind": "action", "text": "She does not look surprised to see him.", "para": 5, "sent": 3, "present": [0]}, {"u": 20, "kind": "action", "text": "She looks like she has been expecting him for years.", "para": 5, "sent": 4, "present": [0]}, {"u": 21, "kind": "dialogue", "text": "You're late Kip.", "name": "THE WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "I'm not Kip. I'm Kim.", "name": "KIP", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 23, "kind": "dialogue", "text": "Kim then.", "name": "THE WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "She sits behind the desk.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Opens the folder.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "The folder is very thin.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Nothing.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Her eyes move down the page and then up, and for a moment he thinks he sees something move behind her, a shape in the dark of the hallway, tall, patient.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Who else is here.", "name": "KIM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "Nobody. Just us.", "name": "THE WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "dialogue", "text": "I heard someone.", "name": "KIM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 32, "kind": "dialogue", "text": "You hear a lot of things, Kim. It's in your file.", "name": "THE WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "She turns the folder around so he can read.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "His name.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "His date of birth.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "A line of handwriting beneath, in red, that he cannot make himself read aloud.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "Rain.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "dialogue", "text": "That's not my handwriting.", "name": "KIM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 39, "kind": "dialogue", "text": "No. It's his.", "name": "THE WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 40, "kind": "dialogue", "text": "Whose?", "name": "KIM", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "She does not answer.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "The lamp flickers.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 43, "kind": "action", "text": "In the corridor, the footsteps start again, closer now, unhurried.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 44, "kind": "dialogue", "text": "Please tell me that's you.", "name": "KIM", "speaker": 2, "ext": ["CONT'D"], "paren": ["barely"], "dual": false, "present": [0, 1, 2]}, {"u": 45, "kind": "dialogue", "text": "I'm right here.", "name": "THE WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 46, "kind": "action", "text": "The footsteps stop at the door.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 47, "kind": "action", "text": "He does not turn around.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 48, "kind": "action", "text": "He cannot.", "para": 12, "sent": 2, "present": [0, 1, 2]}, {"u": 49, "kind": "action", "text": "Every muscle in his neck has locked.", "para": 12, "sent": 3, "present": [0, 1, 2]}, {"u": 50, "kind": "action", "text": "The Woman closes the folder gently.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 51, "kind": "dialogue", "text": "My name is Margaret. And that is Kip.", "name": "THE WOMAN", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Behind him, the door opens.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Nothing.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Then a breath that is not his own.", "para": 16, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "dialogue", "text": "Kip is dead.", "name": "KIM", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "dialogue", "text": "Yes.", "name": "MARGARET", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 57, "kind": "action", "text": "Silence.", "para": 17, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 58, "kind": "action", "text": "The clock moves.", "para": 18, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 59, "kind": "action", "text": "9:42.", "para": 18, "sent": 1, "present": [0, 1, 2, 3]}]}