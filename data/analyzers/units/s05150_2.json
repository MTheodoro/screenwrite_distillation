{"scene_id": "s05150_2", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05150.fountain", "heading": "INT. UNIT 214 - CONTINUOUS", "cast": [{"id": 0, "name": "THE WOMAN", "names": ["THE WOMAN"], "gender": "?", "first": 9, "spoke": 2}, {"id": 1, "name": "TEENAGE BOY", "names": ["TEENAGE BOY"], "gender": "m", "first": 14, "spoke": 0}, {"id": 2, "name": "TOBY", "names": ["TOBY"], "gender": "m", "first": 14, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. UNIT 214 - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Cardboard boxes.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A rocking horse under a sheet.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A dressing mirror turned to face the wall.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Everything neat, too neat, like someone arranged it for a visit.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "She pulls a box open.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "Photographs.", "para": 1, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "Her own face at ten years old, then at twelve, then at fourteen.", "para": 1, "sent": 2, "present": []}, {"u": 8, "kind": "action", "text": "Every one with the eyes scratched out.", "para": 1, "sent": 3, "present": []}, {"u": 9, "kind": "dialogue", "text": "Okay.", "name": "THE WOMAN", "speaker": 0, "ext": [], "paren": ["quiet"], "dual": false, "present": [0]}, {"u": 10, "kind": "action", "text": "Behind her the corridor lights go out one by one, towards her.", "para": 2, "sent": 0, "present": [0]}, {"u": 11, "kind": "action", "text": "Click.", "para": 2, "sent": 1, "present": [0]}, {"u": 12, "kind": "action", "text": "Click.", "para": 2, "sent": 2, "present": [0]}, {"u": 13, "kind": "action", "text": "Click.", "para": 2, "sent": 3, "present": [0]}, {"u": 14, "kind": "action", "text": "A TEENAGE BOY, TOBY, 17, hi-vis vest two sizes too big, stands in the open doorway holding a torch.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "Sorry! Sorry. Odell sent me. Said you might need a hand carrying.", "name": "TOBY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "Carrying what.", "name": "THE WOMAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "dialogue", "text": "...the mirror?", "name": "TOBY", "speaker": 2, "ext": [], "paren": ["looking past her"], "dual": false, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "She turns.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "The mirror is facing the room now.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Nobody touched it.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "TIME CUT:", "para": 5, "sent": 0, "present": [0, 1, 2]}]}