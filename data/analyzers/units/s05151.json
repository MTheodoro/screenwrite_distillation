{"scene_id": "s05151", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05151.fountain", "heading": "INT. CHURCH BASEMENT - AA MEETING - NIGHT", "cast": [{"id": 0, "name": "TIME", "names": ["TIME"], "gender": "?", "first": 3, "spoke": 0}, {"id": 1, "name": "THE WOMAN", "names": ["WOMAN", "THE WOMAN"], "gender": "f", "first": 6, "spoke": 7}], "units": [{"u": 0, "kind": "heading", "text": "INT. CHURCH BASEMENT - AA MEETING - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Folding chairs in a circle.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Burnt coffee.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A banner: \"ONE DAY AT A TIME.\"", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "Empty chairs, all of them.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "Except one.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "THE WOMAN, 40s, cardigan, big purse on her lap.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "She waves at nobody.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Hi everybody!", "name": "THE WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "(beat for the audience)", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She sits up.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Beams.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Waits for the applause that doesn't come.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Wow. Tough room.", "name": "THE WOMAN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Silence.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "A fluorescent buzz.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "So. Hi. I'm... let's say I'm new here. Three days sober. Well, \"sober.\" Dry. Technically damp.", "name": "THE WOMAN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "She laughs at herself.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Nobody joins.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "Her purse.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "It wiggles.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She pats it.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Smiles wider.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "That's just my sponsor. She's shy.", "name": "THE WOMAN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Nothing.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Another wiggle.", "para": 9, "sent": 1, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "A faint croak.", "para": 9, "sent": 2, "present": [0, 1]}, {"u": 27, "kind": "dialogue", "text": "Look, I know how this sounds. I had a little problem. Nothing major! A few wishes. A few... frogs.", "name": "THE WOMAN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "She opens the purse.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "Two bulging eyes peer out.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "Kim is the one on the left. Kip is the one on the right. Honestly, I never could tell which is which. My ex-husbands. They had names for a reason.", "name": "THE WOMAN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "The door at the top of the stairs creaks open.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Footsteps.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Heavy.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "The sound of a staff tapping the steps.", "para": 11, "sent": 3, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "She does not look up.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Her smile does not move.", "para": 12, "sent": 1, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "My name is Brenda. And I have been a witch for four hundred years.", "name": "THE WOMAN", "speaker": 1, "ext": ["CONT'D"], "paren": ["whispers to the purse"], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "The staff stops.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 39, "kind": "action", "text": "Right behind her.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 40, "kind": "action", "text": "She will not turn around.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "Rain on the high windows.", "para": 15, "sent": 0, "present": [0, 1]}]}