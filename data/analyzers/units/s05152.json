{"scene_id": "s05152", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05152.fountain", "heading": "INT. HELIX LABS - OPEN-PLAN OFFICE - NIGHT", "cast": [{"id": 0, "name": "IMANI", "names": ["IMANI"], "gender": "f", "first": 6, "spoke": 2}, {"id": 1, "name": "JONAH", "names": ["JONAH"], "gender": "m", "first": 10, "spoke": 4}, {"id": 2, "name": "IMANI'S", "names": ["IMANI'S"], "gender": "?", "first": 17, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. HELIX LABS - OPEN-PLAN OFFICE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "SUPER: \"DAY 4 OF THE LOCKDOWN\"", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Standing desks.", "para": 1, "sent": 0, "present": []}, {"u": 3, "kind": "action", "text": "Beanbags.", "para": 1, "sent": 1, "present": []}, {"u": 4, "kind": "action", "text": "A neon sign: MOVE FAST.", "para": 1, "sent": 2, "present": []}, {"u": 5, "kind": "action", "text": "The glass doors are chained from the inside.", "para": 1, "sent": 3, "present": []}, {"u": 6, "kind": "action", "text": "IMANI, 30s, sleeves rolled, crouches behind a kombucha fridge.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Her breath fogs.", "para": 2, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "INSERT - HER PHONE", "para": 3, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "A single bar of signal.", "para": 4, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "Contact: JONAH.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Ringing.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Across the floor, TWO TEENAGE INTERNS share a vending-machine bag of chips by a window, whispering.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "A golden retriever sleeps under a desk, ribs rising and falling.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Imani. Don't talk. Listen.", "name": "JONAH", "speaker": 1, "ext": ["V.O."], "paren": ["static, breathing"], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Where are you?", "name": "IMANI", "speaker": 0, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Stairwell. Below you. The thing's in the vents, it follows the heat. Kill the lights on the east side and it moves.", "name": "JONAH", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "IMANI'S POV - the east wall.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "A bank of switches.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "Forty feet of open floor between.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "That's forty feet in the open.", "name": "IMANI", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Then run.", "name": "JONAH", "speaker": 1, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "She runs.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Beanbags, cables, a skateboard she nearly trips on.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The dog lifts its head.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "action", "text": "Her hand slams the switches.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 26, "kind": "action", "text": "East side DARK.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "Silence.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "Then a metallic scrape in the ceiling, travelling away.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "Both interns give her a thumbs up.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "She almost laughs.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "The dog barks once.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Sharp.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "The scraping stops.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Reverses.", "para": 11, "sent": 3, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "The stairwell door BURSTS open.", "para": 12, "sent": 0, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "JONAH, 30s, bleeding at the temple, stumbles in with a fire axe.", "para": 12, "sent": 1, "present": [0, 1, 2]}, {"u": 37, "kind": "dialogue", "text": "It was never in the vents.", "name": "JONAH", "speaker": 1, "ext": [], "paren": ["not on the phone anymore"], "dual": false, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "He looks up.", "para": 13, "sent": 0, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "Slowly, so does she.", "para": 13, "sent": 1, "present": [0, 1, 2]}]}