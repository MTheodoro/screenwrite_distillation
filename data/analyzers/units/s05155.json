{"scene_id": "s05155", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05155.fountain", "heading": "INT. NIGHT BUS - ROUTE 47 - NIGHT", "cast": [{"id": 0, "name": "MAN", "names": ["MAN"], "gender": "m", "first": 5, "spoke": 0}, {"id": 1, "name": "HI-VIS JACKET", "names": ["HI-VIS JACKET"], "gender": "m", "first": 5, "spoke": 0}, {"id": 2, "name": "ANIKA", "names": ["ANIKA"], "gender": "f", "first": 6, "spoke": 14}, {"id": 3, "name": "RILEY", "names": ["RILEY"], "gender": "f", "first": 7, "spoke": 16}, {"id": 4, "name": "ANIKA'S", "names": ["ANIKA'S"], "gender": "?", "first": 9, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT BUS - ROUTE 47 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "SUPER: \"2:14 A.M.\"", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Sodium streetlights strobe past rain-streaked windows.", "para": 1, "sent": 0, "present": []}, {"u": 3, "kind": "action", "text": "The bus is nearly empty.", "para": 1, "sent": 1, "present": []}, {"u": 4, "kind": "action", "text": "At the back, TWO TEENAGERS share one pair of earbuds, asleep against each other.", "para": 1, "sent": 2, "present": []}, {"u": 5, "kind": "action", "text": "Near the front, a MAN IN A HI-VIS JACKET snores, a lunchbox on his knee.", "para": 1, "sent": 3, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "ANIKA, 40s, scrubs under a parka, sits by the middle doors, gripping a paper cup of coffee she isn't drinking.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "RILEY, 20s, they/them, climbs on at the next stop with a rucksack, taps a card.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "action", "text": "Sits across the aisle.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "action", "text": "INSERT - ANIKA'S HAND", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "The coffee cup trembles.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "Just slightly.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "action", "text": "She sets it on her knee to steady it.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Long shift?", "name": "RILEY", "speaker": 3, "ext": [], "paren": ["not looking over", "unzipping the rucksack"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Long enough.", "name": "ANIKA", "speaker": 2, "ext": [], "paren": ["pocketing her badge"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "You a nurse?", "name": "RILEY", "speaker": 3, "ext": [], "paren": ["taking out a water bottle"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Why?", "name": "ANIKA", "speaker": 2, "ext": [], "paren": ["beat"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Shoes.", "name": "RILEY", "speaker": 3, "ext": [], "paren": ["shrugging, drinking"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Right.", "name": "ANIKA", "speaker": 2, "ext": [], "paren": ["looks down at her own shoes, almost smiles"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "The bus brakes.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Hiss of the doors.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "Nobody gets on.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Nobody gets off.", "para": 6, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "My mum was a nurse. Fourteen years nights. She used to say you can tell who's had a bad one by how they hold a cup.", "name": "RILEY", "speaker": 3, "ext": [], "paren": ["screwing the cap back on"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "And how do they hold it?", "name": "ANIKA", "speaker": 2, "ext": [], "paren": ["turning the cup in her hands"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Like that.", "name": "RILEY", "speaker": 3, "ext": [], "paren": ["nodding at it"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Silence.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "The bus rolls through an underpass.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Orange light, dark, orange light.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "ANIKA'S POV - her phone, face-up on her thigh.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "A missed call.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "HOSPITAL (WARD 6).", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Seven times.", "para": 8, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "You can ring them back, you know.", "name": "RILEY", "speaker": 3, "ext": [], "paren": ["leaning back, closing their eyes"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "It's fine.", "name": "ANIKA", "speaker": 2, "ext": [], "paren": ["turning the phone over"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "It isn't, though.", "name": "RILEY", "speaker": 3, "ext": [], "paren": ["eyes still closed"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "You don't know anything about it.", "name": "ANIKA", "speaker": 2, "ext": [], "paren": ["sharp"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "No. I don't.", "name": "RILEY", "speaker": 3, "ext": [], "paren": ["opening one eye"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "The teenagers at the back stir, resettle.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "The man in the hi-vis snorts and swallows mid-snore.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "The driver's radio murmurs a football score.", "para": 9, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "There was a boy. Eleven. Appendix. Routine. I did the checks, I did all of them, twice. And I went on my break.", "name": "ANIKA", "speaker": 2, "ext": [], "paren": ["a long breath", "rubbing her thumb along the cup's rim"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Okay.", "name": "RILEY", "speaker": 3, "ext": [], "paren": ["quiet", "not moving"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Twelve minutes. I was gone twelve minutes.", "name": "ANIKA", "speaker": 2, "ext": [], "paren": ["not hearing them"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "And?", "name": "RILEY", "speaker": 3, "ext": [], "paren": ["sitting up, turning to face her"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "And the one who came on after me, she saw it. She caught it. Because she was looking at the monitor.", "name": "ANIKA", "speaker": 2, "ext": [], "paren": ["staring at the window"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "So he's alive.", "name": "RILEY", "speaker": 3, "ext": [], "paren": ["beat", "slowly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "He's alive.", "name": "ANIKA", "speaker": 2, "ext": [], "paren": ["nodding, once"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "So why are you on a night bus at two in the morning like it's a funeral?", "name": "RILEY", "speaker": 3, "ext": [], "paren": ["a small laugh, gentle"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "Because I wasn't looking.", "name": "ANIKA", "speaker": 2, "ext": [], "paren": ["finally looking at them"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "The bus lurches.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "The cup tips.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "Coffee spills across her knee and she doesn't flinch.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Riley takes a napkin from a pocket and holds it out, across the aisle, until she takes it.", "para": 10, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "dialogue", "text": "You looked, though. Every time you could. That's the whole job.", "name": "RILEY", "speaker": 3, "ext": [], "paren": ["softly", "sitting back"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "dialogue", "text": "Mm.", "name": "ANIKA", "speaker": 2, "ext": [], "paren": ["dabbing the stain", "not agreeing"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "This is me.", "name": "RILEY", "speaker": 3, "ext": [], "paren": ["pulling the cord for the next stop"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "The bus slows.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 58, "kind": "action", "text": "The bell DINGS.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 59, "kind": "action", "text": "Riley stands, shoulders the rucksack, swaying with the movement.", "para": 11, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 60, "kind": "dialogue", "text": "Ring the ward.", "name": "RILEY", "speaker": 3, "ext": ["CONT'D"], "paren": ["at the doors, over their shoulder"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 61, "kind": "dialogue", "text": "Go home, Riley.", "name": "ANIKA", "speaker": 2, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 62, "kind": "action", "text": "Riley stops.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 63, "kind": "dialogue", "text": "I didn't tell you my name.", "name": "RILEY", "speaker": 3, "ext": [], "paren": ["a beat, gentle"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 64, "kind": "action", "text": "Anika lifts her head.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 65, "kind": "action", "text": "Neither of them moves.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 66, "kind": "action", "text": "The doors hiss open onto the empty, wet street.", "para": 13, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 67, "kind": "action", "text": "Riley steps out and doesn't look back.", "para": 13, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 68, "kind": "action", "text": "The bus pulls away.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 69, "kind": "action", "text": "In the rear window, a small figure stands under a streetlight, watching it go.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 70, "kind": "action", "text": "Anika turns her phone over.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 71, "kind": "action", "text": "Her thumb hovers, then presses.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 72, "kind": "action", "text": "It rings once.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 73, "kind": "dialogue", "text": "It's Anika. Tell me how he is.", "name": "ANIKA", "speaker": 2, "ext": ["CONT'D"], "paren": ["into the phone, steady"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 74, "kind": "action", "text": "The man in the hi-vis opens his eyes and looks at her.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 75, "kind": "action", "text": "Then closes them again.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4]}]}