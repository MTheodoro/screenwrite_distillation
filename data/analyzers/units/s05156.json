{"scene_id": "s05156", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05156.fountain", "heading": "INT. NIGHT BUS - ROUTE N9 - NIGHT", "cast": [{"id": 0, "name": "LUCIA AND KATYA", "names": ["LUCIA", "LUCIA AND KATYA", "KATYA"], "gender": "f", "first": 5, "spoke": 8}, {"id": 1, "name": "KATYA", "names": ["KATYA"], "gender": "f", "first": 10, "spoke": 6}, {"id": 2, "name": "THUNK", "names": ["THUNK"], "gender": "?", "first": 19, "spoke": 0}, {"id": 3, "name": "DRIVER", "names": ["DRIVER"], "gender": "m", "first": 20, "spoke": 2}, {"id": 4, "name": "WINSTON", "names": ["WINSTON"], "gender": "m", "first": 29, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. NIGHT BUS - ROUTE N9 - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Rain on the windows.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The bus is a lit aquarium gliding through a dark city.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Neon smears past.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "In the back row, two teenagers share a bag of chips and a single, furious whisper.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Lucia, 30s, in a rumpled bridesmaid dress and trainers, sits with a bouquet she's clearly been dragging around for hours.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "She sneezes.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "The bouquet shakes.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "A petal lands on her phone.", "para": 1, "sent": 3, "present": [0]}, {"u": 9, "kind": "action", "text": "The doors HISS.", "para": 2, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "Katya, 30s, also in a bridesmaid dress, the same hideous mint green, climbs aboard, drenched, holding her heels in one hand.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "They see each other.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "Freeze.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "You.", "name": "LUCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "No.", "name": "KATYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "You're wearing it.", "name": "LUCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Everyone's wearing it. It's a bridal party. That's the horror of it.", "name": "KATYA", "speaker": 0, "ext": [], "paren": ["sitting across from her"], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "The bus lurches.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Katya slides, grabs a pole, and the heels go flying.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "One hits the driver's screen with a THUNK.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 20, "kind": "dialogue", "text": "Please keep all footwear to yourselves, ladies.", "name": "DRIVER", "speaker": 3, "ext": ["V.O."], "paren": ["over the intercom, bored"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Sorry!", "name": "KATYA", "speaker": 0, "ext": [], "paren": ["to the ceiling"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Lucia laughs despite herself.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "Katya laughs too.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "They both stop at once.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "She's still furious with you, you know. She's saying you ruined the cake.", "name": "LUCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "She is saying I ruined the cake? She's the one who told me to hold it.", "name": "KATYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "She's saying she didn't mean while you were dancing.", "name": "LUCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "She is not allowed to say that. She's the one who taught me the dance.", "name": "KATYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Winston, 20s, in a delivery jacket, steps on at the next stop with an enormous pizza box, tags in with a beep, and sits down between them without a word.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "The two women look at each other across him, then at the box.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "It's wrong order. It's pineapple. I'm not allowed to take it back.", "name": "WINSTON", "speaker": 4, "ext": [], "paren": ["opening it, sheepish"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Lucia and Katya both reach for a slice at the same moment.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "Their hands collide.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "Both gasp.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "She said she'd kill me.", "name": "LUCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "She said she'd kill me.", "name": "KATYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "Who did?", "name": "WINSTON", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "They answer together.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "The bride.", "name": "LUCIA AND KATYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Winston nods slowly, takes the slice, and offers the box to the teenagers behind him, who snatch it.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "The bus slows.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "The screen over the driver flickers: NEXT STOP: THE FUTURE.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "The three of them look up.", "para": 10, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "Sorry about that. Software update.", "name": "DRIVER", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "The doors HISS open on a street that is bright, white, and absolutely silent.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Is that normal?", "name": "KATYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "I've seen worse.", "name": "WINSTON", "speaker": 4, "ext": [], "paren": ["chewing"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Lucia stands.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Offers her the bouquet.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Come on. Let's go find out.", "name": "LUCIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}