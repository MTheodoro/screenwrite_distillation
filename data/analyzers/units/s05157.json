{"scene_id": "s05157", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05157.fountain", "heading": "INT. LINCOLN HIGH SCHOOL - GIRLS' BATHROOM - DAY", "cast": [{"id": 0, "name": "NADIA", "names": ["NADIA"], "gender": "f", "first": 7, "spoke": 4}, {"id": 1, "name": "PHONE", "names": ["PHONE"], "gender": "?", "first": 9, "spoke": 0}, {"id": 2, "name": "KOFI", "names": ["KOFI"], "gender": "m", "first": 17, "spoke": 4}, {"id": 3, "name": "LUCAS", "names": ["LUCAS"], "gender": "m", "first": 17, "spoke": 3}, {"id": 4, "name": "MS. BRANDT", "names": ["MS. BRANDT"], "gender": "f", "first": 40, "spoke": 3}, {"id": 5, "name": "JUNIORS", "names": ["JUNIORS"], "gender": "?", "first": 52, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. LINCOLN HIGH SCHOOL - GIRLS' BATHROOM - DAY", "present": []}, {"u": 1, "kind": "action", "text": "SUPER: \"DAY 11 OF THE SIEGE\"", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Cracked tile.", "para": 1, "sent": 0, "present": []}, {"u": 3, "kind": "action", "text": "A mirror with one long diagonal fracture.", "para": 1, "sent": 1, "present": []}, {"u": 4, "kind": "action", "text": "Dust sifts from the ceiling with every distant THUMP.", "para": 1, "sent": 2, "present": []}, {"u": 5, "kind": "action", "text": "Outside, beyond the frosted window, smoke.", "para": 2, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "Somewhere a siren winds down and stops.", "para": 2, "sent": 1, "present": []}, {"u": 7, "kind": "action", "text": "NADIA, 17, backpack on her chest, crouches in the end stall with her knees pulled up.", "para": 3, "sent": 0, "present": [0]}, {"u": 8, "kind": "action", "text": "She counts under her breath.", "para": 3, "sent": 1, "present": [0]}, {"u": 9, "kind": "action", "text": "ON PHONE (TEXT FROM MOM): where r u", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "ON PHONE (TEXT FROM MOM): please", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "No bars.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "The message sits there, sending.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "CLOSE ON the phone's battery icon.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "4%.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "The door SLAMS open.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Nadia flinches.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 17, "kind": "action", "text": "KOFI, 17, flashlight clipped to his collar, pushes in backwards, dragging LUCAS, 16, who is limping, by the strap of his bag.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Kofi kicks the door shut and wedges a mop handle under the knob.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Girls' bathroom. Seriously?", "name": "KOFI", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "It was the only one with a lock.", "name": "LUCAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "Silence.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "A drip.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "A fan that doesn't turn.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "It doesn't have a lock.", "name": "NADIA", "speaker": 0, "ext": [], "paren": ["from the stall"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Kofi spins, flashlight up.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Nadia opens the stall door an inch.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "She lowers her phone.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Nadia?", "name": "KOFI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "Put the light down.", "name": "NADIA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "He lowers it.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Lucas slumps against the sinks and slides to the floor, wincing.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "INSERT - LUCAS'S ANKLE.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Swollen, black at the edges.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "The wall behind them SHUDDERS.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Plaster falls.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "A long, low rumble passes through the floor, and the three of them freeze at once, hands on whatever is nearest, until it passes.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "Dust.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "action", "text": "Ringing.", "para": 15, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "action", "text": "Nothing.", "para": 15, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "Is anyone in there?", "name": "MS. BRANDT", "speaker": 4, "ext": ["O.S."], "paren": ["through the door, muffled"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "All three look at each other.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Kofi holds a finger to his lips and mouths NO. Nadia nods.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "It's Ms. Brandt. I can hear you breathing. Let me in.", "name": "MS. BRANDT", "speaker": 4, "ext": ["O.S.", "CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "dialogue", "text": "It's a trick.", "name": "LUCAS", "speaker": 3, "ext": [], "paren": ["mouthing"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "It's not a trick. It's Brandt.", "name": "NADIA", "speaker": 0, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Brandt left on the first bus.", "name": "KOFI", "speaker": 2, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Silence.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "The handle turns.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "Stops against the mop.", "para": 17, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "On the floor, light spills from under the door in a slow, even sweep.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Something glides past outside, and then another, and a third.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "THE JUNIORS, a dozen kids in the corridor, press flat to the wall, quiet as shadows, led by a hand-sign nobody dares to say aloud.", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "action", "text": "They pass the door.", "para": 19, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "They are gone.", "para": 19, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "ON PHONE (TEXT FROM MOM): I love you. whatever happens", "para": 20, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "Nadia reads it.", "para": 21, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 57, "kind": "action", "text": "She doesn't type back.", "para": 21, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 58, "kind": "action", "text": "She presses the phone to her chest.", "para": 21, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 59, "kind": "action", "text": "Kofi crawls to the door, listens, lets out a long breath.", "para": 22, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 60, "kind": "action", "text": "Lucas grabs his sleeve.", "para": 22, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 61, "kind": "dialogue", "text": "Don't open it.", "name": "LUCAS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 62, "kind": "dialogue", "text": "I'm not opening it.", "name": "KOFI", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 63, "kind": "dialogue", "text": "Then why are you still touching the mop?", "name": "NADIA", "speaker": 0, "ext": [], "paren": ["quiet, cold"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 64, "kind": "action", "text": "He looks down.", "para": 23, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 65, "kind": "action", "text": "His hand is on the handle.", "para": 23, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 66, "kind": "action", "text": "He pulls it back.", "para": 23, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 67, "kind": "dialogue", "text": "Last chance, kids. They are coming through the east wing.", "name": "MS. BRANDT", "speaker": 4, "ext": ["O.S."], "paren": ["close now, right behind the door"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 68, "kind": "action", "text": "The lights flicker.", "para": 24, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 69, "kind": "action", "text": "The mirror finishes cracking.", "para": 24, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 70, "kind": "action", "text": "A long, thin piece falls and shatters in the sink.", "para": 24, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 71, "kind": "action", "text": "Then a loud, clear BANG from the corridor, and every one of them dives under the sinks, arms over each other, as the door rattles and the mop handle holds.", "para": 25, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 72, "kind": "action", "text": "Smoke curls under the door.", "para": 26, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 73, "kind": "action", "text": "Nobody moves.", "para": 27, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 74, "kind": "action", "text": "Nobody speaks.", "para": 28, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 75, "kind": "action", "text": "Nothing.", "para": 29, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 76, "kind": "action", "text": "Nadia's phone buzzes.", "para": 30, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 77, "kind": "action", "text": "She does not look.", "para": 30, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 78, "kind": "action", "text": "ON PHONE (TEXT FROM MOM): I'm coming", "para": 31, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}