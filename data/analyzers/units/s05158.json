{"scene_id": "s05158", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05158.fountain", "heading": "EXT. BORDER CHECKPOINT - DAWN", "cast": [{"id": 0, "name": "OKONKWO", "names": ["OKONKWO"], "gender": "f", "first": 5, "spoke": 5}, {"id": 1, "name": "GRIEVE", "names": ["GRIEVE"], "gender": "?", "first": 4, "spoke": 5}, {"id": 2, "name": "HOBBS", "names": ["HOBBS"], "gender": "m", "first": 10, "spoke": 1}, {"id": 3, "name": "VANE", "names": ["VANE"], "gender": "?", "first": 22, "spoke": 1}, {"id": 4, "name": "LENA", "names": ["LENA"], "gender": "f", "first": 6, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. BORDER CHECKPOINT - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "Mist on a concrete lane.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A barrier arm, striped red and white.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A kiosk with one lit window.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Grieve, 50s, border officer, tired, holds a clipboard against the cold.", "para": 1, "sent": 0, "present": [1]}, {"u": 5, "kind": "action", "text": "Opposite him stands Okonkwo, 40s, a solicitor in a sodden trenchcoat, a briefcase at her feet.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Behind her in the car, Tomasz, 30s, and a small girl, Lena, 6, asleep on his shoulder.", "para": 1, "sent": 2, "present": [0, 1, 4]}, {"u": 7, "kind": "action", "text": "INSERT - THE PASSPORT.", "para": 2, "sent": 0, "present": [0, 1, 4]}, {"u": 8, "kind": "action", "text": "The photograph does not match the face in the car.", "para": 2, "sent": 1, "present": [0, 1, 4]}, {"u": 9, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 4]}, {"u": 10, "kind": "action", "text": "Hobbs, 30s, a sergeant, appears in the kiosk window with a phone to his ear.", "para": 4, "sent": 0, "present": [0, 1, 2, 4]}, {"u": 11, "kind": "dialogue", "text": "I've been very patient, Officer Grieve. I've been patient since four this morning. I would like to remind you that my client has a hearing at ten in Rotterdam, that the girl has a right to be with her father, and that the paperwork you are holding is, quite frankly, immaculate.", "name": "OKONKWO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 12, "kind": "dialogue", "text": "It is immaculate. That's what bothers me.", "name": "GRIEVE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 13, "kind": "dialogue", "text": "Is that a legal objection?", "name": "OKONKWO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 14, "kind": "dialogue", "text": "It's an observation.", "name": "GRIEVE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 15, "kind": "dialogue", "text": "Then you'll understand if I write it down.", "name": "OKONKWO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 16, "kind": "dialogue", "text": "Please do. Spell it with a \"k.\"", "name": "GRIEVE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 17, "kind": "dialogue", "text": "That's not funny.", "name": "OKONKWO", "speaker": 0, "ext": [], "paren": ["beat"], "dual": false, "present": [0, 1, 2, 4]}, {"u": 18, "kind": "dialogue", "text": "It wasn't meant to be.", "name": "GRIEVE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 19, "kind": "dialogue", "text": "Sir, I've got the Home Office on the line. They say the order's been revoked.", "name": "HOBBS", "speaker": 2, "ext": [], "paren": ["on the phone, from the kiosk"], "dual": false, "present": [0, 1, 2, 4]}, {"u": 20, "kind": "action", "text": "Grieve doesn't turn.", "para": 5, "sent": 0, "present": [0, 1, 2, 4]}, {"u": 21, "kind": "dialogue", "text": "Revoked when?", "name": "GRIEVE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 22, "kind": "dialogue", "text": "Eleven fifty-two last night, Mr Grieve. Mr Vane, Asylum Casework. Your man isn't who he says he is, and neither, I'm afraid, is she.", "name": "VANE", "speaker": 3, "ext": ["V.O."], "paren": ["on the phone, tinny, crisp"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "CLOSE ON Okonkwo.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Her face doesn't move.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Her hand goes to the briefcase.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "I think we should all take a breath.", "name": "OKONKWO", "speaker": 0, "ext": [], "paren": ["very quietly"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "The girl wakes.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Looks at the officers.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "Looks at Okonkwo.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Mummy?", "name": "LENA", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Grieve looks at Okonkwo.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Then he looks at the barrier arm, and he drops the clipboard.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "BACK TO SCENE.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}]}