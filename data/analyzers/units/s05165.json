{"scene_id": "s05165", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05165.fountain", "heading": "INT. COLDLINE DELIVERY WAREHOUSE - NIGHT", "cast": [{"id": 0, "name": "BOGDAN", "names": ["BOGDAN"], "gender": "f", "first": 3, "spoke": 7}, {"id": 1, "name": "THE WOMAN", "names": ["WOMAN", "THE WOMAN"], "gender": "f", "first": 3, "spoke": 6}, {"id": 2, "name": "ILSE", "names": ["ILSE"], "gender": "f", "first": 28, "spoke": 2}, {"id": 3, "name": "TWINS", "names": ["TWINS", "THE TWINS"], "gender": "p", "first": 35, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. COLDLINE DELIVERY WAREHOUSE - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Water is on the floor, ankle high.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The power is out.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A small camping lantern stands on a shelf and gives yellow light, and BOGDAN, 50s, is moving boxes of canned food from low shelves to high shelves one by one, and in the corner near the loading door THE WOMAN, 30s, wet coat, sits on a stack of pallets with her phone in her hand and she looks at the stairs and at the water and at him, and the rain on the metal roof is loud.", "para": 0, "sent": 2, "present": [0, 1]}, {"u": 4, "kind": "dialogue", "text": "This shelf is dry. Put your bag here.", "name": "BOGDAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "I keep my bag.", "name": "THE WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "OK.", "name": "BOGDAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "He lifts another box.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "She watches him.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "The water moves around his boots.", "para": 1, "sent": 2, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "ON PHONE: Message failed.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "No signal.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "She puts the phone in her pocket.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "How long you work here?", "name": "THE WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "dialogue", "text": "Eleven years. Never this much water.", "name": "BOGDAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "The driver did not come back.", "name": "THE WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "He will come.", "name": "BOGDAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "You say this like you do not think so.", "name": "THE WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Bogdan does not answer.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "He gives her a can of peaches and a plastic spoon.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "She takes it.", "para": 4, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "She does not open it.", "para": 4, "sent": 3, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "She holds it on her knee.", "para": 4, "sent": 4, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Open. Eat. We have enough.", "name": "BOGDAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Later.", "name": "THE WOMAN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "Bogdan sets the lantern higher.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Outside, a car horn sounds far away, two short notes, then stops.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "They both look at the door.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "dialogue", "text": "My name is Ilse. I should say it.", "name": "THE WOMAN", "speaker": 1, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "dialogue", "text": "Bogdan.", "name": "BOGDAN", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 30, "kind": "dialogue", "text": "I know. It is on your jacket.", "name": "ILSE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "He almost smiles.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "He looks at the stitching on his chest as if he forgot it.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "Then the side door BANGS open.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Water rushes in.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "THE TWINS, two boys about ten, soaked to the skin, in matching yellow raincoats, stand in the frame holding one backpack between them.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "They do not speak.", "para": 7, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "action", "text": "They look at the lantern.", "para": 7, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Come. Come inside. Close the door.", "name": "BOGDAN", "speaker": 0, "ext": ["CONT'D"], "paren": ["softly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "We are looking for our mother.", "name": "THE TWINS", "speaker": 3, "ext": [], "paren": ["together"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "action", "text": "Ilse stands up.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "action", "text": "She sets the can of peaches down on the shelf, open now, with the spoon in it, and she pulls off her coat and puts it over the two small shoulders.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Sit. Here. It is dry.", "name": "ILSE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "The boys sit on the pallets.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "Bogdan hands them the peaches.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "They share the spoon.", "para": 9, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "action", "text": "Rain.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "action", "text": "The lantern flickers, then holds.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "action", "text": "ON PHONE: one bar.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "A message comes through at last.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "action", "text": "ON PHONE: \"Where r u?", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "We are at the bridge.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "Boys with you?\"", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "Ilse reads it.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "She does not smile.", "para": 13, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "She turns the phone so the twins can see the screen, and she keeps her hand on the nearest small wet head.", "para": 13, "sent": 2, "present": [0, 1, 2, 3]}]}