{"scene_id": "s05167", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05167.fountain", "heading": "INT. GREENFIELD VETERINARY CLINIC - AFTER HOURS", "cast": [{"id": 0, "name": "LUCAS", "names": ["LUCAS"], "gender": "m", "first": 6, "spoke": 4}, {"id": 1, "name": "ALMA PRUITT", "names": ["ALMA PRUITT", "DR. PRUITT"], "gender": "f", "first": 7, "spoke": 3}, {"id": 2, "name": "ABERNATHY", "names": ["ABERNATHY", "MRS. ABERNATHY"], "gender": "f", "first": 8, "spoke": 1}, {"id": 3, "name": "DEPUTY HARLOW", "names": ["DEPUTY HARLOW"], "gender": "m", "first": 42, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. GREENFIELD VETERINARY CLINIC - AFTER HOURS", "present": []}, {"u": 1, "kind": "action", "text": "Rain.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "The waiting room.", "para": 1, "sent": 0, "present": []}, {"u": 3, "kind": "action", "text": "Empty chairs.", "para": 1, "sent": 1, "present": []}, {"u": 4, "kind": "action", "text": "A fish tank bubbling.", "para": 1, "sent": 2, "present": []}, {"u": 5, "kind": "action", "text": "A wall clock reads 11:48.", "para": 1, "sent": 3, "present": []}, {"u": 6, "kind": "action", "text": "LUCAS, 20s, a vet tech in scrubs, kneels beside the reception desk, a flashlight in his teeth, looking at the floor.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "DR. ALMA PRUITT, 50s, stands over him holding a clipboard.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "MRS. ABERNATHY, 70s, in a raincoat, sits in a plastic chair with an empty cat carrier on her lap.", "para": 2, "sent": 2, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "Lucas. Tell me again.", "name": "DR. PRUITT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "dialogue", "text": "She was in the carrier at nine. I checked her. I swear I checked her.", "name": "LUCAS", "speaker": 0, "ext": [], "paren": ["taking the flashlight out"], "dual": false, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Biscuit doesn't just disappear.", "name": "MRS. ABERNATHY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Nothing.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Lucas stands.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 15, "kind": "action", "text": "He crosses to the supply cabinet and opens it.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Bandages.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Syringes.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "A bag of kibble torn open, the floor under it dusted with crumbs.", "para": 5, "sent": 4, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "He crouches.", "para": 5, "sent": 5, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Small paw prints in the powder of spilled flea treatment, leading toward the back hall.", "para": 5, "sent": 6, "present": [0, 1, 2]}, {"u": 21, "kind": "dialogue", "text": "Look.", "name": "LUCAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Dr. Pruitt looks.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Mrs. Abernathy rises, the carrier trembling in her hands.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 24, "kind": "action", "text": "The prints stop at a closed door marked STAFF ONLY.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "That door's always locked.", "name": "DR. PRUITT", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "Not tonight.", "name": "LUCAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "action", "text": "The knob.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 28, "kind": "action", "text": "It turns by itself.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "A soft CLICK.", "para": 7, "sent": 2, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Mrs. Abernathy gasps.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "Dr. Pruitt steps in front of her.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 32, "kind": "action", "text": "Lucas lifts the flashlight like a weapon.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 33, "kind": "action", "text": "The door swings open.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 34, "kind": "action", "text": "Dark.", "para": 9, "sent": 1, "present": [0, 1, 2]}, {"u": 35, "kind": "action", "text": "Cold.", "para": 9, "sent": 2, "present": [0, 1, 2]}, {"u": 36, "kind": "action", "text": "The smell of antiseptic.", "para": 9, "sent": 3, "present": [0, 1, 2]}, {"u": 37, "kind": "action", "text": "A small shape.", "para": 10, "sent": 0, "present": [0, 1, 2]}, {"u": 38, "kind": "action", "text": "Two green eyes.", "para": 10, "sent": 1, "present": [0, 1, 2]}, {"u": 39, "kind": "action", "text": "And then, behind them, the front bell JANGLES.", "para": 11, "sent": 0, "present": [0, 1, 2]}, {"u": 40, "kind": "action", "text": "The glass door BANGS against the wall.", "para": 11, "sent": 1, "present": [0, 1, 2]}, {"u": 41, "kind": "action", "text": "Wind and rain flood in.", "para": 11, "sent": 2, "present": [0, 1, 2]}, {"u": 42, "kind": "action", "text": "DEPUTY HARLOW, 40s, hat dripping, steps inside and shuts the door behind him.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "He looks at the three of them.", "para": 12, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "At the open staff door.", "para": 12, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "At the cat carrier.", "para": 12, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Evening. Somebody called in a break-in at this address.", "name": "DEPUTY HARLOW", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "No. No break-in.", "name": "DR. PRUITT", "speaker": 1, "ext": [], "paren": ["too fast"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "Nobody called.", "name": "LUCAS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 49, "kind": "action", "text": "Silence.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 50, "kind": "dialogue", "text": "Funny. The call came from inside.", "name": "DEPUTY HARLOW", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 51, "kind": "action", "text": "The three of them turn, slowly, to the staff door.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 52, "kind": "action", "text": "The small shape in the dark steps forward into the light.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 53, "kind": "action", "text": "A gray cat.", "para": 14, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 54, "kind": "action", "text": "Biscuit.", "para": 14, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 55, "kind": "action", "text": "A tiny brass key hangs from her collar.", "para": 14, "sent": 4, "present": [0, 1, 2, 3]}, {"u": 56, "kind": "action", "text": "Nothing else moves.", "para": 15, "sent": 0, "present": [0, 1, 2, 3]}]}