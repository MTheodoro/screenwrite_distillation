{"scene_id": "s05170", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05170.fountain", "heading": "INT. ST. ANNE'S HOSPITAL - PEDIATRIC WAITING AREA - NIGHT", "cast": [{"id": 0, "name": "PRIYA", "names": ["PRIYA"], "gender": "f", "first": 5, "spoke": 9}, {"id": 1, "name": "TOBY", "names": ["TOBY"], "gender": "m", "first": 6, "spoke": 3}, {"id": 2, "name": "THE WOMAN", "names": ["WOMAN", "THE WOMAN"], "gender": "f", "first": 7, "spoke": 4}, {"id": 3, "name": "GUS", "names": ["GUS"], "gender": "m", "first": 7, "spoke": 1}, {"id": 4, "name": "OKAFOR", "names": ["OKAFOR", "DR. OKAFOR"], "gender": "m", "first": 43, "spoke": 2}, {"id": 5, "name": "DENISE", "names": ["DENISE"], "gender": "f", "first": 36, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. ST. ANNE'S HOSPITAL - PEDIATRIC WAITING AREA - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Fluorescent hum.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Half the lights off.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Rain on the tall windows.", "para": 1, "sent": 0, "present": []}, {"u": 4, "kind": "action", "text": "A vending machine glows blue in the corner.", "para": 1, "sent": 1, "present": []}, {"u": 5, "kind": "action", "text": "PRIYA (30s, scrubs, cardigan) wheels a med cart past rows of empty chairs.", "para": 2, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "A boy, TOBY (8), sits alone in a dinosaur pajama top, swinging his feet.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 7, "kind": "action", "text": "Next to him, a WOMAN in a damp raincoat stares at the floor, one hand clamped on the boy's backpack strap while GUS, the night security guard, sips coffee by the elevators and pretends not to watch her.", "para": 2, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Still waiting on the paperwork, sweetie?", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "She says we have to wait.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "action", "text": "Priya looks at THE WOMAN.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "The Woman doesn't look up.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Ma'am? Can I get you a blanket?", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "We're fine.", "name": "THE WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "action", "text": "Wind pushes the rain sideways against the glass.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "He's been here two hours. It's okay to tell me who you're waiting for.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": ["gentle"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "action", "text": "Gus wanders over, thumbs in his belt.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "Everything alright over here?", "name": "GUS", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "dialogue", "text": "Everything's fine, Gus.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Gus nods.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "action", "text": "Retreats.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "action", "text": "The elevator DINGS.", "para": 6, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "The doors slide open on empty air, then close again.", "para": 6, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "My mother's upstairs. Fourth floor. They won't let kids up after nine.", "name": "THE WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Grandma has a tube in her nose.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "I know. I'm on her floor tonight. I can sit with him right here.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "The Woman finally lifts her eyes.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Red-rimmed.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "Tired in a way sleep won't fix.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "You'd do that?", "name": "THE WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "It's a slow night.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "Somewhere a monitor beeps.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Steady.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Patient.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "A mop bucket squeaks down a far hallway.", "para": 8, "sent": 3, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "dialogue", "text": "I'm Priya.", "name": "PRIYA", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Denise.", "name": "THE WOMAN", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5]}, {"u": 37, "kind": "action", "text": "Denise lets go of the backpack strap, finger by finger.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 5]}, {"u": 38, "kind": "action", "text": "Toby scoots closer to Priya and examines her ID badge.", "para": 9, "sent": 1, "present": [0, 1, 2, 3, 5]}, {"u": 39, "kind": "dialogue", "text": "Your picture looks mad.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5]}, {"u": 40, "kind": "dialogue", "text": "I was. It was six a.m.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 5]}, {"u": 41, "kind": "action", "text": "Denise almost laughs.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 5]}, {"u": 42, "kind": "action", "text": "The elevator DINGS again.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 5]}, {"u": 43, "kind": "action", "text": "DR. OKAFOR (60s, rumpled, reading glasses on a cord) steps out, chart in hand, sneakers soaked through.", "para": 11, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 44, "kind": "dialogue", "text": "Denise Marlowe? Your mother's asking for you. And for the young man.", "name": "DR. OKAFOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 45, "kind": "dialogue", "text": "He's not allowed up.", "name": "DENISE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 46, "kind": "dialogue", "text": "Tonight he is.", "name": "DR. OKAFOR", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 47, "kind": "action", "text": "Toby grabs his backpack.", "para": 12, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 48, "kind": "action", "text": "Denise stands.", "para": 12, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 49, "kind": "action", "text": "Her knees crack.", "para": 12, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}, {"u": 50, "kind": "action", "text": "Outside, the rain thins to drizzle.", "para": 13, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 51, "kind": "action", "text": "The vending machine hums on.", "para": 13, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 52, "kind": "dialogue", "text": "Thank you.", "name": "DENISE", "speaker": 5, "ext": [], "paren": ["to Priya"], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 53, "kind": "dialogue", "text": "Go on.", "name": "PRIYA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 54, "kind": "action", "text": "They walk toward the elevator.", "para": 14, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 55, "kind": "action", "text": "Gus holds the door.", "para": 14, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 56, "kind": "action", "text": "Nobody says anything else.", "para": 14, "sent": 2, "present": [0, 1, 2, 3, 4, 5]}]}