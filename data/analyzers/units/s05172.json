{"scene_id": "s05172", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05172.fountain", "heading": "INT. JUNO'S BEDROOM - NIGHT", "cast": [{"id": 0, "name": "JUNO", "names": ["JUNO"], "gender": "f", "first": 6, "spoke": 2}, {"id": 1, "name": "THE BAND", "names": ["THE BAND"], "gender": "?", "first": 19, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "INT. JUNO'S BEDROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dark.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Fairy lights, half of them dead.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Posters.", "para": 1, "sent": 0, "present": []}, {"u": 4, "kind": "action", "text": "A beanbag.", "para": 1, "sent": 1, "present": []}, {"u": 5, "kind": "action", "text": "Laundry in a heap that could be anything.", "para": 1, "sent": 2, "present": []}, {"u": 6, "kind": "action", "text": "JUNO (16) lies in bed, earbuds out, eyes open.", "para": 2, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "She listens.", "para": 2, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "Silence.", "para": 3, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Then, through the wall: a thud.", "para": 4, "sent": 0, "present": [0]}, {"u": 10, "kind": "action", "text": "A slow one.", "para": 4, "sent": 1, "present": [0]}, {"u": 11, "kind": "action", "text": "She sits up.", "para": 5, "sent": 0, "present": [0]}, {"u": 12, "kind": "action", "text": "Another thud.", "para": 6, "sent": 0, "present": [0]}, {"u": 13, "kind": "action", "text": "Wood on wood.", "para": 6, "sent": 1, "present": [0]}, {"u": 14, "kind": "action", "text": "She grabs her phone.", "para": 7, "sent": 0, "present": [0]}, {"u": 15, "kind": "action", "text": "Taps it.", "para": 7, "sent": 1, "present": [0]}, {"u": 16, "kind": "action", "text": "Nothing.", "para": 7, "sent": 2, "present": [0]}, {"u": 17, "kind": "action", "text": "Her phone.", "para": 7, "sent": 3, "present": [0]}, {"u": 18, "kind": "action", "text": "Dead.", "para": 7, "sent": 4, "present": [0]}, {"u": 19, "kind": "action", "text": "The thudding finds a rhythm.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Four beats.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 21, "kind": "action", "text": "Four beats.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Under it, a low hum, wrong, like something breathing through a tube.", "para": 8, "sent": 3, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "Hello?", "name": "JUNO", "speaker": 0, "ext": [], "paren": ["whisper"], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "action", "text": "Nothing.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 25, "kind": "action", "text": "She swings her legs out.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 26, "kind": "action", "text": "Floorboard creaks.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "She freezes.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Waits.", "para": 10, "sent": 3, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "The wall goes quiet.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "Then a voice, muffled, lazy, sung half a note flat.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Wonderwall... one, two, three...", "name": "THE BAND", "speaker": 1, "ext": ["O.S."], "paren": ["muffled, through wall"], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Juno stares at the wall.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Sorry! Sorry! Dave, you're on the wrong key!", "name": "THE BAND", "speaker": 1, "ext": ["O.S.", "CONT'D"], "paren": ["muffled"], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "A cymbal CRASHES.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "A guitar squeals.", "para": 14, "sent": 1, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Juno exhales.", "para": 15, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "Her whole body unclenches.", "para": 15, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "She laughs, a short, shaky bark.", "para": 15, "sent": 2, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "It's one a.m.!", "name": "JUNO", "speaker": 0, "ext": [], "paren": ["to the wall"], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "Sorry, Juno!", "name": "THE BAND", "speaker": 1, "ext": ["O.S."], "paren": ["muffled"], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "action", "text": "A pause.", "para": 16, "sent": 0, "present": [0, 1]}, {"u": 42, "kind": "action", "text": "She lies back.", "para": 16, "sent": 1, "present": [0, 1]}, {"u": 43, "kind": "action", "text": "Pulls the duvet up.", "para": 16, "sent": 2, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "Quiet.", "para": 17, "sent": 0, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "Rain on the window.", "para": 18, "sent": 0, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "Her closet door, which was closed, is open now.", "para": 19, "sent": 0, "present": [0, 1]}, {"u": 47, "kind": "action", "text": "An inch.", "para": 19, "sent": 1, "present": [0, 1]}, {"u": 48, "kind": "action", "text": "She doesn't see it.", "para": 20, "sent": 0, "present": [0, 1]}, {"u": 49, "kind": "action", "text": "She closes her eyes.", "para": 20, "sent": 1, "present": [0, 1]}, {"u": 50, "kind": "action", "text": "From the wall, soft, in unison:", "para": 21, "sent": 0, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "...we're not in the garage, Juno.", "name": "THE BAND", "speaker": 1, "ext": ["O.S."], "paren": ["muffled, hushed"], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "action", "text": "Her eyes snap open.", "para": 22, "sent": 0, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "Silence.", "para": 23, "sent": 0, "present": [0, 1]}]}