": "dialogue", "text": "Marcus. Good. Marcus, who did this?", "name": "LENA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 4]}, {"u": 11, "kind": "action", "text": "JOSIE (20s, hoodie, folding socks) backs away from the counter, phone raised.", "para": 4, "sent": 0, "present": [0, 1, 2, 4]}, {"u": 12, "kind": "action", "text": "A tiny terrier on a leash YAPS at everyone.", "para": 4, "sent": 1, "present": [0, 1, 2, 4]}, {"u": 13, "kind": "dialogue", "text": "I'm calling nine-one-one!", "name": "JOSIE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 14, "kind": "action", "text": "A dryer BANGS open.", "para": 5, "sent": 0, "present": [0, 1, 2, 4]}, {"u": 15, "kind": "action", "text": "ABEL (50s, security vest) bursts through the back door, flashlight swinging.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Nobody move!", "name": "ABEL", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "Abel, he's gone out the front. Go!", "name": "MARCUS", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Abel does not go.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Officer KANE shoves through the front door, gun up, rain on his shoulders.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}, {"u": 20, "kind": "dialogue", "text": "Police! Hands!", "name": "KANE", "speaker": 5, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4, 5]}, {"u": 21, "kind": "action", "text": "Everyone raises their hands except Lena, who is still pressing a folded towel to a wound.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 22, "kind": "action", "text": "Two teenagers by the soap machine freeze mid-chew.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 23, "kind": "action", "text": "This is the last time any of them will be strangers.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 24, "kind": "action", "text": "The dryer THUDS.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}, {"u": 25, "kind": "action", "text": "Something inside it is still running.", "para": 10, "sent": 1, "present": [0, 1, 2, 3, 4, 5]}]}