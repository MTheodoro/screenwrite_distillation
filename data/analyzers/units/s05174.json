{"scene_id": "s05174", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05174.fountain", "heading": "INT. THE ROYAL OAK FUNCTION ROOM - WEDDING AFTERPARTY - NIGHT", "cast": [{"id": 0, "name": "MO", "names": ["MO"], "gender": "m", "first": 4, "spoke": 8}, {"id": 1, "name": "JEN", "names": ["JEN"], "gender": "f", "first": 5, "spoke": 9}], "units": [{"u": 0, "kind": "heading", "text": "INT. THE ROYAL OAK FUNCTION ROOM - WEDDING AFTERPARTY - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Half-deflated balloons.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A disco ball turns, one mirror missing.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Somewhere a slow song limps to its end.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "MO (50s, lanyard still around his neck under his dicky bow) holds a plastic cup of warm prosecco and has the look of a man cornered by a sofa.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "JEN (40s, heels in one hand) lowers herself into the chair opposite and says nothing for a good ten seconds.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "Congratulations, by the way.", "name": "JEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Cheers. I'm not the groom.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "No, but you did the seating plan.", "name": "JEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "Technically, I did the spreadsheet.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Jen nods, slowly.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "You sat Big Dave next to his ex.", "name": "JEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "I wasn't told.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "You were. In a meeting. Eleven times.", "name": "JEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "He opens his mouth.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Closes it.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 16, "kind": "action", "text": "Studies the carpet.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "Right.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "A door SLAMS somewhere out in the car park.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "They both flinch.", "para": 4, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "dialogue", "text": "That'll be Dave.", "name": "JEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "Probably.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "action", "text": "Jen sets her shoes on the table.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 23, "kind": "action", "text": "She looks at them, and then at him, and something in her shoulders gives.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "Honestly? It's the best wedding I've been to in years.", "name": "JEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Is it?", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "Mrs K cried at the vows. Dave cried at the buffet. Nobody's cried at work all year and I thought, there, that's a company away day.", "name": "JEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "He lets out a breath.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "Almost a laugh.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "dialogue", "text": "I did write that in the risk assessment.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 30, "kind": "action", "text": "His phone BUZZES on the table.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 31, "kind": "action", "text": "He reads it.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "Turns it face down.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 33, "kind": "dialogue", "text": "Who's that?", "name": "JEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 34, "kind": "dialogue", "text": "HR. They want a word about Monday.", "name": "MO", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 35, "kind": "dialogue", "text": "Tell them it's a Saturday.", "name": "JEN", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "He smiles.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 37, "kind": "action", "text": "She picks up her shoes.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 38, "kind": "action", "text": "For the first time in eleven years, they stay for the last song.", "para": 8, "sent": 2, "present": [0, 1]}]}