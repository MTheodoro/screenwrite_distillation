{"scene_id": "s05175", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05175.fountain", "heading": "INT. SUBURBAN KITCHEN - NIGHT", "cast": [{"id": 0, "name": "SAL", "names": ["SAL"], "gender": "f", "first": 4, "spoke": 8}, {"id": 1, "name": "KAY", "names": ["KAY"], "gender": "f", "first": 5, "spoke": 4}, {"id": 2, "name": "TEDDY", "names": ["TEDDY"], "gender": "f", "first": 5, "spoke": 3}, {"id": 3, "name": "BIG DAVE", "names": ["BIG DAVE"], "gender": "m", "first": 7, "spoke": 4}, {"id": 4, "name": "RUTH", "names": ["RUTH", "THE WOMAN"], "gender": "f", "first": 13, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. SUBURBAN KITCHEN - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Dark.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Candles on the counter.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A camping lantern hisses on the table.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "dialogue", "text": "Power went out at eight-fifteen. By nine, the whole street was in somebody's kitchen. That's how it works out here.", "name": "SAL", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0]}, {"u": 5, "kind": "action", "text": "SAL (40s, cardigan, tea towel on shoulder) stirs a pot on a gas ring, while KAY (60s, his mother-in-law) cuts bread at the table, TEDDY (9) kneels on a chair building a wobbly tower of mugs, and a golden retriever sleeps with its chin on Sal's slipper.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "Through the window, two teenagers from next door shine a phone torch over the fence, whispering and giggling.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "BIG DAVE (50s, huge, soaked) appears in the back doorway holding a bag of ice.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Freezer's gone at ours. Is yours alright?", "name": "BIG DAVE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Come in, Dave, you're letting the heat out.", "name": "SAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "There's no heat, Sal.", "name": "KAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Then you're letting the cold out.", "name": "SAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Teddy's tower collapses.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "The dog lifts its head, sighs, resumes sleeping.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "It wasn't me!", "name": "TEDDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "It's never you.", "name": "KAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Who's the lady out front?", "name": "BIG DAVE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "What lady?", "name": "SAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Standing on your drive. Umbrella. Been there ten minutes.", "name": "BIG DAVE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "They look.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Through the window: a figure at the end of the path, still, umbrella dripping.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "I didn't know her. That's all I'll say about that.", "name": "SAL", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "She looks lost.", "name": "KAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "She looks cold.", "name": "TEDDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Teddy, stay put.", "name": "SAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Sal opens the front door.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "The Woman (50s, neat grey coat) steps in out of the rain, folds her umbrella.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "I'm sorry. Is this number fourteen? My sister's number fourteen.", "name": "THE WOMAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "This is twelve.", "name": "SAL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "Oh. Ruth Aldana. Ruth. I'm so sorry.", "name": "THE WOMAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Ruth! Sit down, Ruth. Soup?", "name": "KAY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Fourteen's the one with the gnome.", "name": "BIG DAVE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "That's her.", "name": "RUTH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "We've got bread.", "name": "TEDDY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "There's no manual for strangers on a night like this. You just pull out another chair.", "name": "SAL", "speaker": 0, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "Ruth sits.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "action", "text": "The candle gutters and holds.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "The dog thumps its tail once on the lino.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}]}