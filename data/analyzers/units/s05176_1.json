{"scene_id": "s05176_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05176.fountain", "heading": "INT. TRAWLER - GALLEY - CONTINUOUS", "cast": [{"id": 0, "name": "JONAH", "names": ["JONAH"], "gender": "m", "first": 2, "spoke": 1}, {"id": 1, "name": "NELL", "names": ["NELL"], "gender": "f", "first": 3, "spoke": 2}, {"id": 2, "name": "HALE", "names": ["HALE"], "gender": "?", "first": 4, "spoke": 2}, {"id": 3, "name": "DR. SUN", "names": ["DR. SUN"], "gender": "?", "first": 5, "spoke": 2}, {"id": 4, "name": "PETE", "names": ["PETE"], "gender": "m", "first": 9, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "INT. TRAWLER - GALLEY - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "CLOSE ON a sat-phone on the table, its green light blinking.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Beside it, JONAH (20s) lies on a bench, shirt soaked red at the ribs.", "para": 0, "sent": 1, "present": [0]}, {"u": 3, "kind": "action", "text": "NELL (30s, oilskins, shaking hands) presses a rag to the wound.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "HALE (60s, the captain) stands in the doorway, staring at the ceiling.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 5, "kind": "dialogue", "text": "Stay with me, Jonah. Cap, get Dr. Sun on that thing.", "name": "NELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 6, "kind": "dialogue", "text": "Line's open.", "name": "HALE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 7, "kind": "action", "text": "Nell grabs the phone, thumb-hits speaker.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Nell? I can barely hear you. Is the bleeding steady?", "name": "DR. SUN", "speaker": 3, "ext": ["V.O."], "paren": ["crackling"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Steady-ish. It's deep. Pete's the only one who's done this before.", "name": "NELL", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 10, "kind": "action", "text": "ANGLE ON the hatch.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 11, "kind": "action", "text": "PETE (50s, grey beard) is on the ladder, face white, hands empty.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "I can't, Nell. I told you. I can't do it again.", "name": "PETE", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "Pete. Listen to me. You can.", "name": "DR. SUN", "speaker": 3, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "A heavy THUMP from above.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Something drags across the deck.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Everyone looks up.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "That wasn't the nets.", "name": "HALE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "WE SEE the hatch.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Bolted.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "Shaking.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "BACK TO SCENE:", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "Jonah grips Nell's wrist.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Nell... something's out there.", "name": "JONAH", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "The lights die.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}]}