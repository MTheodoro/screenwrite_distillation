{"scene_id": "s05179_3", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05179.fountain", "heading": "INT. FOOD TRUCK - CONTINUOUS", "cast": [{"id": 0, "name": "WELLS", "names": ["WELLS"], "gender": "f", "first": 1, "spoke": 6}, {"id": 1, "name": "ROSA", "names": ["ROSA"], "gender": "f", "first": 5, "spoke": 7}, {"id": 2, "name": "CHUY", "names": ["CHUY"], "gender": "?", "first": 7, "spoke": 2}, {"id": 3, "name": "SKYE", "names": ["SKYE"], "gender": "?", "first": 12, "spoke": 3}, {"id": 4, "name": "DANNY", "names": ["DANNY"], "gender": "m", "first": 13, "spoke": 3}, {"id": 5, "name": "FLICKERS", "names": ["FLICKERS"], "gender": "?", "first": 47, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. FOOD TRUCK - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Wells climbs in.", "para": 0, "sent": 0, "present": [0]}, {"u": 2, "kind": "action", "text": "Eyes the grill.", "para": 0, "sent": 1, "present": [0]}, {"u": 3, "kind": "action", "text": "Sniffs.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "dialogue", "text": "Do you smell gas?", "name": "WELLS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 5, "kind": "dialogue", "text": "Only the fresh tortillas.", "name": "ROSA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "That's gas, ma'am.", "name": "WELLS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Mija. Tell him.", "name": "CHUY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "Pap\u00e1, please.", "name": "ROSA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "action", "text": "ANGLE ON the hose behind the grill.", "para": 1, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "A hairline crack.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "The hiss now audible.", "para": 1, "sent": 2, "present": [0, 1, 2]}, {"u": 12, "kind": "dialogue", "text": "Rosa. The hose.", "name": "SKYE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "It's been like that since Friday.", "name": "DANNY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "action", "text": "Rosa freezes.", "para": 2, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "action", "text": "Slowly turns on her son.", "para": 2, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "dialogue", "text": "Since Friday?", "name": "ROSA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "dialogue", "text": "I told Abuelo. He said it was okay.", "name": "DANNY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "I said it would hold.", "name": "CHUY", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Hold?", "name": "ROSA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "I'm going to need everyone out of the truck.", "name": "WELLS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Nobody is leaving my truck.", "name": "ROSA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Ma'am...", "name": "WELLS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Thirty years. My husband built this grill. My father taught me this salsa. You don't come in here with a tablet and tell me to leave.", "name": "ROSA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "INSERT - THE TANK GAUGE.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Needle on red.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Rosa. Please.", "name": "SKYE", "speaker": 3, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Don't \"please\" me. You all knew.", "name": "ROSA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Silence.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "The hiss grows.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Customers outside have gone quiet.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "Mam\u00e1, I'm sorry.", "name": "DANNY", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Rosa's shoulders drop.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "action", "text": "She looks at him.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "action", "text": "At Chuy.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "action", "text": "At the hose.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "The ignition. The pilot's still lit.", "name": "WELLS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "BACK TO SCENE:", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "Rosa lunges for the shutoff valve.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Wells grabs her arm.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "Don't touch the burner!", "name": "WELLS", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "Everyone OUT!", "name": "SKYE", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "action", "text": "Chuy rises.", "para": 8, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "action", "text": "Danny grabs his grandfather's arm.", "para": 8, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Rosa wrenches free and cranks the valve.", "para": 8, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "The hiss stops.", "para": 9, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "action", "text": "Everyone stands still.", "para": 10, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "action", "text": "Then the pilot light FLICKERS, catches the last of the escaped gas, and the grill WHUMPS into a fireball that blows the order window across the lot.", "para": 11, "sent": 0, "present": [0, 1, 2, 3, 4, 5]}]}