{"scene_id": "s05181", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05181.fountain", "heading": "INT. ST. ALDWYN'S HOSPITAL - MAIN CORRIDOR - NIGHT", "cast": [{"id": 0, "name": "MARISOL VEGA", "names": ["MARISOL VEGA", "MARISOL"], "gender": "f", "first": 6, "spoke": 4}, {"id": 1, "name": "PHONE", "names": ["PHONE"], "gender": "f", "first": 9, "spoke": 0}, {"id": 2, "name": "HELEN TEAGUE", "names": ["HELEN TEAGUE", "TEAGUE"], "gender": "f", "first": 12, "spoke": 3}, {"id": 3, "name": "BRAM OKONKWO", "names": ["BRAM OKONKWO", "BRAM"], "gender": "m", "first": 23, "spoke": 3}, {"id": 4, "name": "JUNO", "names": ["JUNO"], "gender": "f", "first": 36, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. ST. ALDWYN'S HOSPITAL - MAIN CORRIDOR - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Victorian brick.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Gas-lamp fittings bolted to bare wiring.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Long and green and empty.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Rain hammers the tall windows.", "para": 1, "sent": 0, "present": []}, {"u": 5, "kind": "action", "text": "Wind HOWLS through a cracked pane.", "para": 2, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "MARISOL VEGA, 30s, night nurse, pushes a squeaking cart.", "para": 3, "sent": 0, "present": [0]}, {"u": 7, "kind": "action", "text": "Her badge swings.", "para": 3, "sent": 1, "present": [0]}, {"u": 8, "kind": "action", "text": "Her eyes don't.", "para": 3, "sent": 2, "present": [0]}, {"u": 9, "kind": "action", "text": "ON PHONE (TEXT): where r u", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "She doesn't answer.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Pockets it.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "DR. HELEN TEAGUE, 50s, surgeon, strides out of the stairwell.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "Coat open.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 14, "kind": "action", "text": "Coffee in a shaking fist.", "para": 6, "sent": 2, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "You're late with the rounds.", "name": "TEAGUE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "dialogue", "text": "You're early for the shift.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "Teague shrugs.", "para": 7, "sent": 0, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Drinks.", "para": 7, "sent": 1, "present": [0, 1, 2]}, {"u": 19, "kind": "action", "text": "The radiators CLANK.", "para": 8, "sent": 0, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "Pipes GROAN.", "para": 8, "sent": 1, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "A lamp flickers.", "para": 8, "sent": 2, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "Overhead, thunder ROLLS across the roof like furniture.", "para": 9, "sent": 0, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "BRAM OKONKWO, 20s, orderly, jogs in from the east wing.", "para": 10, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "action", "text": "Wet sneakers.", "para": 10, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Wide eyes.", "para": 10, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Ward Six. Bed nine. He's gone.", "name": "BRAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Gone how?", "name": "TEAGUE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "Gone gone. Bed's empty. Window's open.", "name": "BRAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Marisol and Teague trade a look.", "para": 11, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "action", "text": "She nods.", "para": 11, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "action", "text": "She nods.", "para": 11, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Marisol's phone BUZZES.", "para": 12, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "ON PHONE (TEXT): pick up. now.", "para": 13, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "She answers.", "para": 14, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Speaker on.", "para": 14, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "dialogue", "text": "Marisol, tell me you're still in the building.", "name": "JUNO", "speaker": 4, "ext": ["V.O."], "paren": ["filtered, tinny"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "dialogue", "text": "I'm in the corridor. With Teague.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Is she wearing the grey coat?", "name": "JUNO", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Marisol looks.", "para": 15, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "Teague looks down at her coat.", "para": 15, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Grey.", "para": 15, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 42, "kind": "dialogue", "text": "Yes.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 43, "kind": "dialogue", "text": "Then walk away from her. Slowly.", "name": "JUNO", "speaker": 4, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 44, "kind": "action", "text": "Teague sets her coffee down.", "para": 16, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 45, "kind": "action", "text": "Slowly.", "para": 16, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "Who is that?", "name": "TEAGUE", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "Nobody.", "name": "MARISOL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 48, "kind": "action", "text": "Pipes CLANK.", "para": 17, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 49, "kind": "action", "text": "The lamp DIES.", "para": 17, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 50, "kind": "action", "text": "Rain.", "para": 17, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 51, "kind": "action", "text": "Dark.", "para": 17, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 52, "kind": "action", "text": "A single emergency bulb hums red.", "para": 17, "sent": 4, "present": [0, 1, 2, 3, 4]}, {"u": 53, "kind": "action", "text": "Bram steps back.", "para": 18, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 54, "kind": "action", "text": "Teague steps forward.", "para": 18, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 55, "kind": "action", "text": "Marisol steps between.", "para": 18, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 56, "kind": "dialogue", "text": "Somebody tell me what's happening.", "name": "BRAM", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 57, "kind": "action", "text": "Nobody does.", "para": 19, "sent": 0, "present": [0, 1, 2, 3, 4]}]}