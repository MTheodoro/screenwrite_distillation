{"scene_id": "s05182", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05182.fountain", "heading": "INT. BLACKWATER SOUND - LIVE ROOM - NIGHT", "cast": [{"id": 0, "name": "BAND", "names": ["BAND", "THE BAND"], "gender": "p", "first": 4, "spoke": 9}, {"id": 1, "name": "SPARK", "names": ["SPARK"], "gender": "?", "first": 56, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. BLACKWATER SOUND - LIVE ROOM - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "A converted cannery.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Brick, baffles, foam.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Forty-eight channels on the console in the control room beyond the glass, every fader at unity.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "The red ON AIR light burns steadily over the door.", "para": 0, "sent": 3, "present": [0]}, {"u": 5, "kind": "action", "text": "Outside, a storm has been building since sunset.", "para": 1, "sent": 0, "present": [0]}, {"u": 6, "kind": "action", "text": "Wind leans on the roll-up door.", "para": 1, "sent": 1, "present": [0]}, {"u": 7, "kind": "action", "text": "Water beads along the skylight seams.", "para": 1, "sent": 2, "present": [0]}, {"u": 8, "kind": "action", "text": "THE BAND stands at their marks: drummer behind the kit, bassist with headphones half on, two guitarists sharing one tuner, a keyboardist leaning on a Rhodes.", "para": 2, "sent": 0, "present": [0]}, {"u": 9, "kind": "action", "text": "Take fourteen of \"Low Tide.\"", "para": 2, "sent": 1, "present": [0]}, {"u": 10, "kind": "action", "text": "Slate called.", "para": 2, "sent": 2, "present": [0]}, {"u": 11, "kind": "action", "text": "Click track in their cans.", "para": 2, "sent": 3, "present": [0]}, {"u": 12, "kind": "dialogue", "text": "One, two, three, four.", "name": "THE BAND", "speaker": 0, "ext": [], "paren": ["counting in, together"], "dual": false, "present": [0]}, {"u": 13, "kind": "action", "text": "They play.", "para": 3, "sent": 0, "present": [0]}, {"u": 14, "kind": "action", "text": "Tight.", "para": 3, "sent": 1, "present": [0]}, {"u": 15, "kind": "action", "text": "Almost right.", "para": 3, "sent": 2, "present": [0]}, {"u": 16, "kind": "action", "text": "The drummer drops a fill, the bassist drifts a hair behind the grid, and the track grinds to a halt on the bridge.", "para": 3, "sent": 3, "present": [0]}, {"u": 17, "kind": "dialogue", "text": "Stop. Stop. Sorry.", "name": "THE BAND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 18, "kind": "action", "text": "Talkback is dead.", "para": 4, "sent": 0, "present": [0]}, {"u": 19, "kind": "action", "text": "The glass shows only their reflection and the dark behind it.", "para": 4, "sent": 1, "present": [0]}, {"u": 20, "kind": "action", "text": "The click track keeps ticking in every headphone.", "para": 5, "sent": 0, "present": [0]}, {"u": 21, "kind": "action", "text": "Tick.", "para": 5, "sent": 1, "present": [0]}, {"u": 22, "kind": "action", "text": "Tick.", "para": 5, "sent": 2, "present": [0]}, {"u": 23, "kind": "action", "text": "Tick.", "para": 5, "sent": 3, "present": [0]}, {"u": 24, "kind": "dialogue", "text": "Engineer? Can we get a playback?", "name": "THE BAND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 25, "kind": "action", "text": "Nothing.", "para": 6, "sent": 0, "present": [0]}, {"u": 26, "kind": "action", "text": "The monitors hiss at -40 dB noise floor.", "para": 6, "sent": 1, "present": [0]}, {"u": 27, "kind": "action", "text": "The patch bay shows a row of green LEDs, then one by one they go amber.", "para": 6, "sent": 2, "present": [0]}, {"u": 28, "kind": "action", "text": "Rain begins to find a way through the roof.", "para": 7, "sent": 0, "present": [0]}, {"u": 29, "kind": "action", "text": "A drop lands on the snare.", "para": 7, "sent": 1, "present": [0]}, {"u": 30, "kind": "action", "text": "Another on the Rhodes lid.", "para": 7, "sent": 2, "present": [0]}, {"u": 31, "kind": "dialogue", "text": "Somebody check the breaker.", "name": "THE BAND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 32, "kind": "action", "text": "The guitarists unplug and cross to the panel by the loading door.", "para": 8, "sent": 0, "present": [0]}, {"u": 33, "kind": "action", "text": "The drummer lifts his sticks and freezes.", "para": 8, "sent": 1, "present": [0]}, {"u": 34, "kind": "action", "text": "The bassist freezes too.", "para": 8, "sent": 2, "present": [0]}, {"u": 35, "kind": "action", "text": "The click track stops.", "para": 8, "sent": 3, "present": [0]}, {"u": 36, "kind": "action", "text": "All five go still.", "para": 9, "sent": 0, "present": [0]}, {"u": 37, "kind": "action", "text": "Low in the walls, an electrical whine climbs.", "para": 10, "sent": 0, "present": [0]}, {"u": 38, "kind": "action", "text": "Pitch rising.", "para": 10, "sent": 1, "present": [0]}, {"u": 39, "kind": "action", "text": "Rising.", "para": 10, "sent": 2, "present": [0]}, {"u": 40, "kind": "dialogue", "text": "That's the transformer. Pull the plugs. Pull everything.", "name": "THE BAND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 41, "kind": "action", "text": "They scramble.", "para": 11, "sent": 0, "present": [0]}, {"u": 42, "kind": "action", "text": "The keyboardist yanks the Rhodes cable, the bassist rips his headphones off, the drummer dives for the floor tom, and two of them collide at the gear cart, tangle in a snake of XLR cables, and go down together, mics clattering around them.", "para": 11, "sent": 1, "present": [0]}, {"u": 43, "kind": "dialogue", "text": "Get up! Get off the mats, it's the floor, it's wet!", "name": "THE BAND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 44, "kind": "action", "text": "Water has pooled under the loading door and spreads across the hardwood in a thin black sheet toward the power strips.", "para": 12, "sent": 0, "present": [0]}, {"u": 45, "kind": "action", "text": "Silence.", "para": 13, "sent": 0, "present": [0]}, {"u": 46, "kind": "action", "text": "Drip.", "para": 13, "sent": 1, "present": [0]}, {"u": 47, "kind": "action", "text": "Drip.", "para": 13, "sent": 2, "present": [0]}, {"u": 48, "kind": "action", "text": "Then a hum.", "para": 14, "sent": 0, "present": [0]}, {"u": 49, "kind": "action", "text": "Deep.", "para": 14, "sent": 1, "present": [0]}, {"u": 50, "kind": "action", "text": "Everything in the room powers up at once, console, amps, monitors, and the speakers SCREAM a wall of feedback that shakes the foam from the ceiling.", "para": 14, "sent": 2, "present": [0]}, {"u": 51, "kind": "dialogue", "text": "Out! Everybody out, now!", "name": "THE BAND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 52, "kind": "action", "text": "They run.", "para": 15, "sent": 0, "present": [0]}, {"u": 53, "kind": "action", "text": "The group scatters for the emergency exit, one toward the stage door, two to the control room, one back for the master tape.", "para": 15, "sent": 1, "present": [0]}, {"u": 54, "kind": "action", "text": "The master tape wins.", "para": 15, "sent": 2, "present": [0]}, {"u": 55, "kind": "action", "text": "He grabs the reel under his arm.", "para": 15, "sent": 3, "present": [0]}, {"u": 56, "kind": "action", "text": "A SPARK jumps from the strip to the water.", "para": 16, "sent": 0, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "The overhead lights BURST one after another, glass raining down, and the whole live room goes white, then black, then white.", "para": 17, "sent": 0, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "Go! Go! Go!", "name": "THE BAND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "action", "text": "The fire door SLAMS open on the storm.", "para": 18, "sent": 0, "present": [0, 1]}, {"u": 60, "kind": "action", "text": "They pour into the rain, drenched, shouting names into the wind, and behind them the cannery windows flash blue and die.", "para": 18, "sent": 1, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "Count heads!", "name": "THE BAND", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "action", "text": "Five.", "para": 19, "sent": 0, "present": [0, 1]}, {"u": 63, "kind": "action", "text": "Five.", "para": 19, "sent": 1, "present": [0, 1]}, {"u": 64, "kind": "action", "text": "They count again to be sure.", "para": 19, "sent": 2, "present": [0, 1]}]}