{"scene_id": "s05187_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05187.fountain", "heading": "INT. GLASS CONFERENCE ROOM - CONTINUOUS", "cast": [{"id": 0, "name": "RHEA", "names": ["RHEA"], "gender": "f", "first": 1, "spoke": 5}, {"id": 1, "name": "TAVI", "names": ["TAVI"], "gender": "?", "first": 4, "spoke": 4}, {"id": 2, "name": "RECEPTIONIST", "names": ["RECEPTIONIST"], "gender": "?", "first": 13, "spoke": 2}, {"id": 3, "name": "PHONE", "names": ["PHONE"], "gender": "?", "first": 17, "spoke": 0}], "units": [{"u": 0, "kind": "heading", "text": "INT. GLASS CONFERENCE ROOM - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Rhea closes the door.", "para": 0, "sent": 0, "present": [0]}, {"u": 2, "kind": "action", "text": "Doesn't sit.", "para": 0, "sent": 1, "present": [0]}, {"u": 3, "kind": "dialogue", "text": "Series B didn't close.", "name": "RHEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0]}, {"u": 4, "kind": "dialogue", "text": "I saw the Slack.", "name": "TAVI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "Payroll's Friday.", "name": "RHEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "action", "text": "Tavi's thumb rubs the edge of the table.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "They told me they'd cover through spring.", "name": "TAVI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "Who did?", "name": "RHEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "dialogue", "text": "You did.", "name": "TAVI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Outside, Osei finally sets a monitor down.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 11, "kind": "action", "text": "Picks it up again.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 12, "kind": "action", "text": "The intercom CRACKLES.", "para": 3, "sent": 0, "present": [0, 1]}, {"u": 13, "kind": "dialogue", "text": "Rhea, there's a gentleman here from the board.", "name": "RECEPTIONIST", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "Tell him five minutes.", "name": "RHEA", "speaker": 0, "ext": [], "paren": ["into the room"], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "He says he's already on his way up.", "name": "RECEPTIONIST", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "Tavi's phone lights up on the table.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "ON PHONE (TEXT): osei: tell me u didn't sign it", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Tavi turns it face-down.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Rhea sees.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Did you?", "name": "RHEA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "I put my name where it was asked for.", "name": "TAVI", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "action", "text": "Through the glass, the dog stands, stretches, trots toward the elevator.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "action", "text": "The elevator DINGS.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}]}