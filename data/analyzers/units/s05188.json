{"scene_id": "s05188", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05188.fountain", "heading": "INT. CHURCH BASEMENT - NIGHT", "cast": [{"id": 0, "name": "PAT PELLETIER", "names": ["PAT PELLETIER", "PAT"], "gender": "?", "first": 6, "spoke": 12}, {"id": 1, "name": "PATSY PELLETIER", "names": ["PATSY PELLETIER", "PATSY"], "gender": "f", "first": 6, "spoke": 10}, {"id": 2, "name": "DEACON FLINT", "names": ["DEACON FLINT"], "gender": "m", "first": 6, "spoke": 8}, {"id": 3, "name": "CHOIR", "names": ["CHOIR", "THE CHOIR"], "gender": "p", "first": 7, "spoke": 3}], "units": [{"u": 0, "kind": "heading", "text": "INT. CHURCH BASEMENT - NIGHT", "present": []}, {"u": 1, "kind": "action", "text": "Gaslight hisses in brass sconces.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Steam drifts off a copper kettle on a woodstove.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Above, through the floorboards, the groan of an organ and a hundred muffled hymns.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A winter wind rattles the high, narrow windows.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "A ring of mismatched chairs.", "para": 1, "sent": 0, "present": []}, {"u": 6, "kind": "action", "text": "In it sit PAT PELLETIER, a rosy, round man in suspenders, and PATSY PELLETIER, his sister, in a bonnet, knitting something that is mostly knot, and DEACON FLINT, thin as a candlestick, who holds a hymnal like a shield.", "para": 1, "sent": 1, "present": [0, 1, 2]}, {"u": 7, "kind": "action", "text": "Overhead, THE CHOIR launches into a hymn.", "para": 2, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 8, "kind": "dialogue", "text": "Rock of Ages, cleft for me!", "name": "THE CHOIR", "speaker": 3, "ext": ["O.S."], "paren": ["muffled, soaring"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 9, "kind": "dialogue", "text": "Friends, we're going to begin.", "name": "PAT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 10, "kind": "dialogue", "text": "Pat, we've begun. You began when you sat down.", "name": "PATSY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "dialogue", "text": "Then we're beginning again, Patsy.", "name": "PAT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "dialogue", "text": "Is it the custom to speak all at once, or one by one?", "name": "DEACON FLINT", "speaker": 2, "ext": [], "paren": ["to the room"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "dialogue", "text": "One by one, Deacon.", "name": "PATSY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "Though some of us never stop.", "name": "PAT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "I heard that.", "name": "PATSY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "You were meant to.", "name": "PAT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "action", "text": "The kettle WHISTLES.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Everyone turns.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "dialogue", "text": "Lord, give me strength or give me a drink.", "name": "DEACON FLINT", "speaker": 2, "ext": [], "paren": ["muttering to himself"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Beg pardon, Deacon?", "name": "PAT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "Nothing. Hymn. I was humming a hymn.", "name": "DEACON FLINT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "You were not humming.", "name": "PATSY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "Let me hide myself in Thee!", "name": "THE CHOIR", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Everyone, here's the rule. What's said under the floor stays under the floor.", "name": "PAT", "speaker": 0, "ext": [], "paren": ["to the room, loud"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "dialogue", "text": "And what's said above?", "name": "PATSY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "dialogue", "text": "Is the Lord's business, Patsy.", "name": "PAT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "dialogue", "text": "Hold on. Patsy, you told me last week you'd quit.", "name": "DEACON FLINT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "dialogue", "text": "I did quit. Twice.", "name": "PATSY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "dialogue", "text": "She quit on Tuesday and again on Wednesday.", "name": "PAT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "Because Tuesday didn't take!", "name": "PATSY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "That's three drinks in three days, then.", "name": "DEACON FLINT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Two. The third was medicinal.", "name": "PAT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "dialogue", "text": "Pat!", "name": "PATSY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "The organ builds.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "The floorboards tremble.", "para": 4, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Dust sifts into the kettle steam.", "para": 4, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "I will not sit in a room of liars!", "name": "DEACON FLINT", "speaker": 2, "ext": [], "paren": ["rising"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "Sit down, Deacon!", "name": "PAT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 39, "kind": "dialogue", "text": "Pat, stop shouting!", "name": "PATSY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 40, "kind": "dialogue", "text": "You're the ones who are shouting!", "name": "DEACON FLINT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 41, "kind": "dialogue", "text": "We are discussing!", "name": "PAT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 42, "kind": "dialogue", "text": "Amen! AMEN!", "name": "THE CHOIR", "speaker": 3, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 43, "kind": "action", "text": "The chandelier above them SWINGS.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 44, "kind": "action", "text": "A jar of pickles rolls off a shelf and SMASHES.", "para": 5, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 45, "kind": "action", "text": "In the silence that follows, all three stare at the pickle brine spreading across the floor.", "para": 5, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 46, "kind": "dialogue", "text": "Well. That's a sign.", "name": "PATSY", "speaker": 1, "ext": [], "paren": ["quietly"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 47, "kind": "dialogue", "text": "Of what?", "name": "PAT", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 48, "kind": "dialogue", "text": "That I'd like a pickle.", "name": "DEACON FLINT", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}