{"scene_id": "s05190", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05190.fountain", "heading": "EXT. BORDER CHECKPOINT - DAY", "cast": [{"id": 0, "name": "VOSS", "names": ["VOSS"], "gender": "?", "first": 4, "spoke": 6}, {"id": 1, "name": "MARTA", "names": ["MARTA"], "gender": "f", "first": 7, "spoke": 4}, {"id": 2, "name": "PAVEL", "names": ["PAVEL"], "gender": "f", "first": 8, "spoke": 1}, {"id": 3, "name": "BAND", "names": ["BAND", "THE BAND"], "gender": "p", "first": 31, "spoke": 1}], "units": [{"u": 0, "kind": "heading", "text": "EXT. BORDER CHECKPOINT - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Rain.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "A striped barrier.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "A mud road choked with carts, 1948 plates on a single black sedan.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "Corporal Voss, 40s, wet wool coat, stamps papers without looking up.", "para": 1, "sent": 0, "present": [0]}, {"u": 5, "kind": "action", "text": "A dog sniffs the wheels of a cart.", "para": 1, "sent": 1, "present": [0]}, {"u": 6, "kind": "action", "text": "A boy in a flat cap watches it.", "para": 1, "sent": 2, "present": [0]}, {"u": 7, "kind": "action", "text": "Marta, 30s, steps up with a violin case.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Pavel, her brother, 20s, hangs back, hands in pockets.", "para": 2, "sent": 1, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Papers.", "name": "VOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "All in order.", "name": "MARTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 11, "kind": "action", "text": "He flips them.", "para": 3, "sent": 0, "present": [0, 1, 2]}, {"u": 12, "kind": "action", "text": "Stops.", "para": 3, "sent": 1, "present": [0, 1, 2]}, {"u": 13, "kind": "action", "text": "She holds her breath.", "para": 3, "sent": 2, "present": [0, 1, 2]}, {"u": 14, "kind": "dialogue", "text": "This stamp is from a town that doesn't exist.", "name": "VOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 15, "kind": "dialogue", "text": "It did last week.", "name": "MARTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 16, "kind": "action", "text": "A beat.", "para": 4, "sent": 0, "present": [0, 1, 2]}, {"u": 17, "kind": "action", "text": "He nearly smiles.", "para": 4, "sent": 1, "present": [0, 1, 2]}, {"u": 18, "kind": "action", "text": "Then the barrier SLAMS down between them.", "para": 4, "sent": 2, "present": [0, 1, 2]}, {"u": 19, "kind": "dialogue", "text": "Open the case.", "name": "VOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 20, "kind": "action", "text": "She does.", "para": 5, "sent": 0, "present": [0, 1, 2]}, {"u": 21, "kind": "action", "text": "Violin.", "para": 5, "sent": 1, "present": [0, 1, 2]}, {"u": 22, "kind": "action", "text": "He lifts it, shakes it.", "para": 5, "sent": 2, "present": [0, 1, 2]}, {"u": 23, "kind": "action", "text": "Something RATTLES inside.", "para": 5, "sent": 3, "present": [0, 1, 2]}, {"u": 24, "kind": "dialogue", "text": "Don't.", "name": "PAVEL", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 25, "kind": "dialogue", "text": "Quiet.", "name": "VOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 26, "kind": "dialogue", "text": "It's my mother's. It rattles because it is old. Please. You know what a thing like that is worth to a person. You have a mother. You had one. She stood in a line like this once, I promise you. Somebody looked at her papers and decided. That is all this is. Somebody decides. And today it is you, and you can decide to be the kind who lets a woman keep her mother's violin, or the kind who breaks it open to find nothing. There is nothing in there, Corporal. There is only the sound it made at her funeral.", "name": "MARTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 27, "kind": "dialogue", "text": "You talk a lot for someone with a bad stamp.", "name": "VOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 28, "kind": "dialogue", "text": "I talk when I am afraid.", "name": "MARTA", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 29, "kind": "action", "text": "He sets the violin down.", "para": 6, "sent": 0, "present": [0, 1, 2]}, {"u": 30, "kind": "action", "text": "Gently.", "para": 6, "sent": 1, "present": [0, 1, 2]}, {"u": 31, "kind": "action", "text": "From the road behind, THE BAND arrives, six brass players in muddy uniforms, instruments clutched like rifles.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "dialogue", "text": "Let us through, Corporal!", "name": "THE BAND", "speaker": 3, "ext": [], "paren": ["ragged, together"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "The dog BARKS.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "The boy bolts.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Voss looks at the band, at her, at the barrier.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "He lifts it.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "Go. Before I count.", "name": "VOSS", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}