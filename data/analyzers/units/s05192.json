{"scene_id": "s05192", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05192.fountain", "heading": "EXT. DUSTY MAIN STREET - DAY", "cast": [{"id": 0, "name": "COAL", "names": ["COAL"], "gender": "?", "first": 2, "spoke": 0}, {"id": 1, "name": "PIKE", "names": ["PIKE"], "gender": "m", "first": 7, "spoke": 2}, {"id": 2, "name": "JUNIPER", "names": ["JUNIPER"], "gender": "f", "first": 9, "spoke": 2}, {"id": 3, "name": "CORBIN", "names": ["CORBIN"], "gender": "m", "first": 11, "spoke": 1}, {"id": 4, "name": "SAM", "names": ["SAM"], "gender": "m", "first": 10, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "EXT. DUSTY MAIN STREET - DAY", "present": []}, {"u": 1, "kind": "action", "text": "Sun-bleached false-front buildings.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Handmade signs: NO COAL, NO FUTURE.", "para": 0, "sent": 1, "present": [0]}, {"u": 3, "kind": "action", "text": "A crowd of thirty blocks the doors of the Territorial Mining Bureau.", "para": 0, "sent": 2, "present": [0]}, {"u": 4, "kind": "action", "text": "A waiter on the saloon porch watches with a tray of untouched beer.", "para": 0, "sent": 3, "present": [0]}, {"u": 5, "kind": "action", "text": "Two teenagers on a hitching rail film it all on a phone.", "para": 0, "sent": 4, "present": [0]}, {"u": 6, "kind": "action", "text": "A mule brays.", "para": 0, "sent": 5, "present": [0]}, {"u": 7, "kind": "action", "text": "Sheriff Amos Pike, 50s, weathered, tin star, wide stance, stands on the steps.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 8, "kind": "action", "text": "Beside him Deputy Lucy Ferris, 20s, nervous, thumbs hooked in her belt.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "At the front of the crowd, Juniper Reyes, 30s, sun-browned, in a canvas duster painted with a dying river.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 10, "kind": "action", "text": "Next to Juniper, Sam, early 20s, they/them, buzzcut and bandanna, holding the end of a chain that runs through the Bureau's door handles.", "para": 2, "sent": 1, "present": [0, 1, 2, 4]}, {"u": 11, "kind": "action", "text": "Behind them an old rancher, Walt Dunmore, 60s, hat in hands, and Corbin Hale, 40s, in an expensive suit, mine agent, sweating through his collar.", "para": 2, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 12, "kind": "dialogue", "text": "Break it up. Ten seconds.", "name": "PIKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 13, "kind": "dialogue", "text": "You don't have ten seconds of water left in this county, Sheriff.", "name": "JUNIPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 14, "kind": "dialogue", "text": "Arrest them. All of them.", "name": "CORBIN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 15, "kind": "dialogue", "text": "Come try.", "name": "SAM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 16, "kind": "action", "text": "Ferris steps forward.", "para": 3, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 17, "kind": "action", "text": "Walt grabs her arm, she shakes him loose, Corbin shoves Walt, and then Juniper and Corbin go at each other, fists and hats, while the crowd roars and the teenagers whoop.", "para": 3, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "action", "text": "Sam hauls the chain tight.", "para": 3, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "action", "text": "Pike fires into the air.", "para": 3, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "action", "text": "BANG.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "action", "text": "They all freeze.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "action", "text": "The mule stops braying.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "action", "text": "The waiter drops the tray.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Now.", "name": "PIKE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "Quiet.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "action", "text": "Sam lets the chain go slack.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "Juniper wipes blood from a lip and laughs.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "He means it.", "name": "JUNIPER", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "The crowd scatters, slow, defeated, then regroups across the street.", "para": 7, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Sam sits in the dirt.", "para": 7, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "They look at the sky.", "para": 7, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "Still no rain.", "name": "SAM", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}]}