{"scene_id": "s05193", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05193.fountain", "heading": "EXT. CITY HALL PLAZA - DAY", "cast": [{"id": 0, "name": "GORDON", "names": ["GORDON"], "gender": "m", "first": 12, "spoke": 20}, {"id": 1, "name": "TERRENCE", "names": ["TERRENCE"], "gender": "m", "first": 9, "spoke": 17}], "units": [{"u": 0, "kind": "heading", "text": "EXT. CITY HALL PLAZA - DAY", "present": []}, {"u": 1, "kind": "action", "text": "A climate march, mid-afternoon.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "Banners.", "para": 0, "sent": 1, "present": []}, {"u": 3, "kind": "action", "text": "Drums.", "para": 0, "sent": 2, "present": []}, {"u": 4, "kind": "action", "text": "A hundred people sitting in a slow circle on the stone.", "para": 0, "sent": 3, "present": []}, {"u": 5, "kind": "action", "text": "Overhead, a sky the colour of old dishwater.", "para": 0, "sent": 4, "present": []}, {"u": 6, "kind": "action", "text": "A kid in a polar bear costume walks a cardboard iceberg through the crowd.", "para": 1, "sent": 0, "present": []}, {"u": 7, "kind": "action", "text": "A woman with a stroller hands out oat milk.", "para": 1, "sent": 1, "present": []}, {"u": 8, "kind": "action", "text": "A dog in a tiny \"Fossil Free\" vest sniffs the leg of a bench.", "para": 1, "sent": 2, "present": []}, {"u": 9, "kind": "action", "text": "On the bench: Terrence Bell, 40s, rumpled trench coat, a protest sign under his arm that says nothing at all.", "para": 2, "sent": 0, "present": [1]}, {"u": 10, "kind": "action", "text": "Blank cardboard.", "para": 2, "sent": 1, "present": [1]}, {"u": 11, "kind": "action", "text": "A man sits down beside him.", "para": 3, "sent": 0, "present": [1]}, {"u": 12, "kind": "action", "text": "Gordon Achebe, 50s, expensive jacket pretending to be cheap.", "para": 3, "sent": 1, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "He holds a thermos.", "para": 3, "sent": 2, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Neither looks at the other.", "para": 4, "sent": 0, "present": [0, 1]}, {"u": 15, "kind": "dialogue", "text": "Nice turnout.", "name": "GORDON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 16, "kind": "dialogue", "text": "Good cover.", "name": "TERRENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 17, "kind": "dialogue", "text": "That's what it's for.", "name": "GORDON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 18, "kind": "action", "text": "Terrence tilts the sign so the back is visible.", "para": 5, "sent": 0, "present": [0, 1]}, {"u": 19, "kind": "action", "text": "A taped floor plan of the building behind them.", "para": 5, "sent": 1, "present": [0, 1]}, {"u": 20, "kind": "action", "text": "Gordon glances, looks away.", "para": 5, "sent": 2, "present": [0, 1]}, {"u": 21, "kind": "dialogue", "text": "You added the east stairwell.", "name": "GORDON", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 22, "kind": "dialogue", "text": "It's the only one without a sensor.", "name": "TERRENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 23, "kind": "dialogue", "text": "I heard they installed one last week.", "name": "GORDON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 24, "kind": "dialogue", "text": "You heard wrong. He lied to you.", "name": "TERRENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 25, "kind": "dialogue", "text": "Who?", "name": "GORDON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 26, "kind": "dialogue", "text": "The contractor.", "name": "TERRENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 27, "kind": "action", "text": "A drum line starts up.", "para": 6, "sent": 0, "present": [0, 1]}, {"u": 28, "kind": "action", "text": "The crowd chants something about carbon.", "para": 6, "sent": 1, "present": [0, 1]}, {"u": 29, "kind": "action", "text": "A child shrieks with delight.", "para": 6, "sent": 2, "present": [0, 1]}, {"u": 30, "kind": "dialogue", "text": "He's my cousin.", "name": "GORDON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 31, "kind": "dialogue", "text": "Then he lied to you. Family does.", "name": "TERRENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 32, "kind": "action", "text": "A pause.", "para": 7, "sent": 0, "present": [0, 1]}, {"u": 33, "kind": "action", "text": "Gordon unscrews the thermos.", "para": 7, "sent": 1, "present": [0, 1]}, {"u": 34, "kind": "action", "text": "Pours.", "para": 7, "sent": 2, "present": [0, 1]}, {"u": 35, "kind": "action", "text": "Offers a cup.", "para": 7, "sent": 3, "present": [0, 1]}, {"u": 36, "kind": "action", "text": "Terrence takes it.", "para": 7, "sent": 4, "present": [0, 1]}, {"u": 37, "kind": "dialogue", "text": "It's tea.", "name": "GORDON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 38, "kind": "dialogue", "text": "I know. I can smell the cardamom.", "name": "TERRENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 39, "kind": "dialogue", "text": "My wife's.", "name": "GORDON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 40, "kind": "dialogue", "text": "She know what you're doing?", "name": "TERRENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 41, "kind": "dialogue", "text": "She thinks I'm at a rally.", "name": "GORDON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 42, "kind": "dialogue", "text": "You are at a rally.", "name": "TERRENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 43, "kind": "dialogue", "text": "Fair.", "name": "GORDON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 44, "kind": "action", "text": "The polar bear kid walks by.", "para": 8, "sent": 0, "present": [0, 1]}, {"u": 45, "kind": "action", "text": "Terrence nods at him.", "para": 8, "sent": 1, "present": [0, 1]}, {"u": 46, "kind": "action", "text": "The kid nods back, very seriously.", "para": 8, "sent": 2, "present": [0, 1]}, {"u": 47, "kind": "dialogue", "text": "You ever think about how many people here actually believe it?", "name": "TERRENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 48, "kind": "dialogue", "text": "All of them.", "name": "GORDON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 49, "kind": "dialogue", "text": "All of them.", "name": "TERRENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 50, "kind": "dialogue", "text": "That's why they sit like that. It's a thing you can only do if you believe.", "name": "GORDON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 51, "kind": "dialogue", "text": "And us?", "name": "TERRENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 52, "kind": "dialogue", "text": "We believe in a safe in a basement on the fourth floor.", "name": "GORDON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 53, "kind": "action", "text": "Terrence laughs, quietly, into the cup.", "para": 9, "sent": 0, "present": [0, 1]}, {"u": 54, "kind": "action", "text": "The dog trots over, sits at their feet, looks up.", "para": 10, "sent": 0, "present": [0, 1]}, {"u": 55, "kind": "action", "text": "Gordon breaks a biscuit from his pocket in half.", "para": 10, "sent": 1, "present": [0, 1]}, {"u": 56, "kind": "action", "text": "Gives half to the dog.", "para": 10, "sent": 2, "present": [0, 1]}, {"u": 57, "kind": "action", "text": "Eats the other.", "para": 10, "sent": 3, "present": [0, 1]}, {"u": 58, "kind": "dialogue", "text": "Nine o'clock.", "name": "GORDON", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 59, "kind": "dialogue", "text": "Nine.", "name": "TERRENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 60, "kind": "dialogue", "text": "Mayor's dinner. Everyone with a badge will be at it.", "name": "GORDON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 61, "kind": "dialogue", "text": "And the protesters?", "name": "TERRENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 62, "kind": "dialogue", "text": "Still sitting. They'll sit until midnight.", "name": "GORDON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 63, "kind": "dialogue", "text": "Good people.", "name": "TERRENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 64, "kind": "dialogue", "text": "Good enough to be useful.", "name": "GORDON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 65, "kind": "action", "text": "Terrence says nothing.", "para": 11, "sent": 0, "present": [0, 1]}, {"u": 66, "kind": "action", "text": "He looks at the circle of bodies on the stone.", "para": 11, "sent": 1, "present": [0, 1]}, {"u": 67, "kind": "action", "text": "He looks at his blank sign.", "para": 11, "sent": 2, "present": [0, 1]}, {"u": 68, "kind": "action", "text": "This is the last time they will speak before the building.", "para": 12, "sent": 0, "present": [0, 1]}, {"u": 69, "kind": "dialogue", "text": "You'll take the stairwell.", "name": "TERRENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 70, "kind": "dialogue", "text": "You'll take the elevator.", "name": "GORDON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 71, "kind": "dialogue", "text": "It's loud.", "name": "TERRENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 72, "kind": "dialogue", "text": "That's the point.", "name": "GORDON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 73, "kind": "action", "text": "A woman with a megaphone climbs onto a plinth.", "para": 13, "sent": 0, "present": [0, 1]}, {"u": 74, "kind": "action", "text": "The crowd quiets.", "para": 13, "sent": 1, "present": [0, 1]}, {"u": 75, "kind": "action", "text": "She begins to read names of drowned towns.", "para": 13, "sent": 2, "present": [0, 1]}, {"u": 76, "kind": "action", "text": "They listen.", "para": 14, "sent": 0, "present": [0, 1]}, {"u": 77, "kind": "action", "text": "Both of them.", "para": 14, "sent": 1, "present": [0, 1]}, {"u": 78, "kind": "action", "text": "Longer than they planned to.", "para": 14, "sent": 2, "present": [0, 1]}, {"u": 79, "kind": "action", "text": "Gordon stands.", "para": 15, "sent": 0, "present": [0, 1]}, {"u": 80, "kind": "action", "text": "Screws the lid on the thermos.", "para": 15, "sent": 1, "present": [0, 1]}, {"u": 81, "kind": "action", "text": "Pats Terrence's shoulder, once, a stranger's courtesy.", "para": 15, "sent": 2, "present": [0, 1]}, {"u": 82, "kind": "dialogue", "text": "Don't be late.", "name": "GORDON", "speaker": 0, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1]}, {"u": 83, "kind": "dialogue", "text": "I'm never late.", "name": "TERRENCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 84, "kind": "action", "text": "Gordon walks into the crowd.", "para": 16, "sent": 0, "present": [0, 1]}, {"u": 85, "kind": "action", "text": "A teenager hands him a flyer.", "para": 16, "sent": 1, "present": [0, 1]}, {"u": 86, "kind": "action", "text": "He takes it.", "para": 16, "sent": 2, "present": [0, 1]}, {"u": 87, "kind": "action", "text": "Folds it.", "para": 16, "sent": 3, "present": [0, 1]}, {"u": 88, "kind": "action", "text": "Pockets it.", "para": 16, "sent": 4, "present": [0, 1]}, {"u": 89, "kind": "action", "text": "Terrence stays on the bench.", "para": 17, "sent": 0, "present": [0, 1]}, {"u": 90, "kind": "action", "text": "Turns the sign face out.", "para": 17, "sent": 1, "present": [0, 1]}, {"u": 91, "kind": "action", "text": "Blank.", "para": 17, "sent": 2, "present": [0, 1]}, {"u": 92, "kind": "action", "text": "Holds it up with everyone else.", "para": 17, "sent": 3, "present": [0, 1]}, {"u": 93, "kind": "action", "text": "The woman reads on.", "para": 18, "sent": 0, "present": [0, 1]}]}