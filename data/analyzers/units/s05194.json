{"scene_id": "s05194", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05194.fountain", "heading": "EXT. FISHING BOAT \"MARGARET JEAN\" - DAWN", "cast": [{"id": 0, "name": "NELL", "names": ["NELL"], "gender": "f", "first": 2, "spoke": 6}, {"id": 1, "name": "TOBY", "names": ["TOBY"], "gender": "m", "first": 5, "spoke": 4}, {"id": 2, "name": "ROSALIND", "names": ["ROSALIND"], "gender": "m", "first": 5, "spoke": 3}, {"id": 3, "name": "OWEN", "names": ["OWEN", "STRANGER"], "gender": "m", "first": 10, "spoke": 4}], "units": [{"u": 0, "kind": "heading", "text": "EXT. FISHING BOAT \"MARGARET JEAN\" - DAWN", "present": []}, {"u": 1, "kind": "action", "text": "grey. flat. the engine ticking over.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "NELL, 30s, sits on a bait crate scrolling a phone.", "para": 1, "sent": 0, "present": [0]}, {"u": 3, "kind": "action", "text": "Her phone.", "para": 1, "sent": 1, "present": [0]}, {"u": 4, "kind": "action", "text": "No signal.", "para": 1, "sent": 2, "present": [0]}, {"u": 5, "kind": "action", "text": "Her brother TOBY, 30s, coils rope by the winch while their mother ROSALIND, 60s, leans in the wheelhouse door with a mug, and their dad's old deckhand, a man in a yellow slicker none of them have met before, stands at the rail.", "para": 1, "sent": 3, "present": [0, 1, 2]}, {"u": 6, "kind": "action", "text": "Silence.", "para": 2, "sent": 0, "present": [0, 1, 2]}, {"u": 7, "kind": "dialogue", "text": "so who's he again", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 8, "kind": "dialogue", "text": "dad's guy. from before.", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 9, "kind": "dialogue", "text": "Nobody calls me back about the boat, and then somebody turns up.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2]}, {"u": 10, "kind": "dialogue", "text": "I'm just here for the nets. Don't mind me.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 11, "kind": "action", "text": "Rain.", "para": 3, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 12, "kind": "action", "text": "Light.", "para": 3, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 13, "kind": "action", "text": "Then more of it.", "para": 3, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 14, "kind": "dialogue", "text": "we're not selling by the way", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 15, "kind": "dialogue", "text": "no one said selling", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 16, "kind": "dialogue", "text": "mum said selling", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 17, "kind": "dialogue", "text": "I said \"if\".", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 18, "kind": "action", "text": "Toby drops the rope, Nell stands, Rosalind sets down her mug on the winch and the stranger takes one step back, all of them tense in the little space between the net and the rail and the thing nobody's saying.", "para": 4, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 19, "kind": "action", "text": "Nothing.", "para": 5, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 20, "kind": "dialogue", "text": "Look, I'm Owen. Owen Pruett. Your dad hired me in 'ninety-eight. He'd want me here.", "name": "STRANGER", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 21, "kind": "dialogue", "text": "He told me if it came to it I should tell you where he hid the deed.", "name": "OWEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 22, "kind": "dialogue", "text": "what deed", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 23, "kind": "dialogue", "text": "there's a deed?", "name": "TOBY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 24, "kind": "dialogue", "text": "Oh for God's sake, Owen.", "name": "ROSALIND", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 25, "kind": "action", "text": "Her phone.", "para": 6, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 26, "kind": "action", "text": "Dead.", "para": 6, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 27, "kind": "action", "text": "Gulls.", "para": 7, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 28, "kind": "action", "text": "A wave slaps the hull.", "para": 7, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 29, "kind": "action", "text": "Nobody moves.", "para": 7, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 30, "kind": "dialogue", "text": "where", "name": "NELL", "speaker": 0, "ext": [], "paren": ["quiet"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 31, "kind": "dialogue", "text": "Under the third plank. Forward locker.", "name": "OWEN", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}, {"u": 32, "kind": "action", "text": "Toby looks at Nell.", "para": 8, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 33, "kind": "action", "text": "Nell looks at Rosalind.", "para": 8, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 34, "kind": "action", "text": "Rosalind looks at the water.", "para": 8, "sent": 2, "present": [0, 1, 2, 3]}, {"u": 35, "kind": "action", "text": "Engine.", "para": 9, "sent": 0, "present": [0, 1, 2, 3]}, {"u": 36, "kind": "action", "text": "Rain.", "para": 9, "sent": 1, "present": [0, 1, 2, 3]}, {"u": 37, "kind": "dialogue", "text": "we'll check later", "name": "TOBY", "speaker": 1, "ext": [], "paren": ["low"], "dual": false, "present": [0, 1, 2, 3]}, {"u": 38, "kind": "dialogue", "text": "yeah. later.", "name": "NELL", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3]}]}