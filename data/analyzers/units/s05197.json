{"scene_id": "s05197", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05197.fountain", "heading": "EXT. CRAB BOAT \"SECOND WIND\" - MORNING", "cast": [{"id": 0, "name": "LEON", "names": ["LEON"], "gender": "f", "first": 3, "spoke": 6}, {"id": 1, "name": "HOODIE GUY", "names": ["HOODIE GUY"], "gender": "m", "first": 4, "spoke": 1}, {"id": 2, "name": "MUM", "names": ["MUM"], "gender": "?", "first": 12, "spoke": 4}, {"id": 3, "name": "LEO", "names": ["LEO"], "gender": "m", "first": 21, "spoke": 1}, {"id": 4, "name": "HANNAH", "names": ["HANNAH", "WOMAN", "THE WOMAN"], "gender": "f", "first": 2, "spoke": 10}], "units": [{"u": 0, "kind": "heading", "text": "EXT. CRAB BOAT \"SECOND WIND\" - MORNING", "present": []}, {"u": 1, "kind": "action", "text": "flat sea. gulls. a thermos steaming on the gunwale.", "para": 0, "sent": 0, "present": []}, {"u": 2, "kind": "action", "text": "THE WOMAN, 30s, in a borrowed oilskin two sizes too big, sits on a coil of line holding her phone out over the water like a fishing rod.", "para": 1, "sent": 0, "present": [4]}, {"u": 3, "kind": "action", "text": "LEON, 30s, at the wheel, pretends not to watch her.", "para": 1, "sent": 1, "present": [0, 4]}, {"u": 4, "kind": "action", "text": "HOODIE GUY, 20s, sits on the hatch cover with his hood up eating a cold sausage roll.", "para": 1, "sent": 2, "present": [0, 1, 4]}, {"u": 5, "kind": "dialogue", "text": "you wont get signal out there either", "name": "LEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 4]}, {"u": 6, "kind": "dialogue", "text": "Worth a try", "name": "THE WOMAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 4]}, {"u": 7, "kind": "action", "text": "Her phone BUZZES.", "para": 2, "sent": 0, "present": [0, 1, 4]}, {"u": 8, "kind": "action", "text": "She jumps.", "para": 2, "sent": 1, "present": [0, 1, 4]}, {"u": 9, "kind": "action", "text": "Looks at the screen.", "para": 2, "sent": 2, "present": [0, 1, 4]}, {"u": 10, "kind": "action", "text": "Lifts it.", "para": 2, "sent": 3, "present": [0, 1, 4]}, {"u": 11, "kind": "dialogue", "text": "Hi mum", "name": "THE WOMAN", "speaker": 4, "ext": ["CONT'D"], "paren": ["into phone"], "dual": false, "present": [0, 1, 4]}, {"u": 12, "kind": "dialogue", "text": "Where ARE you. Your dad said you went off with a fisherman", "name": "MUM", "speaker": 2, "ext": ["V.O."], "paren": ["tinny"], "dual": false, "present": [0, 1, 2, 4]}, {"u": 13, "kind": "dialogue", "text": "Its a boat trip Mum. Its fine.", "name": "THE WOMAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 14, "kind": "dialogue", "text": "Is he nice", "name": "MUM", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 15, "kind": "dialogue", "text": "He's a, hes got a boat", "name": "THE WOMAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 16, "kind": "dialogue", "text": "That's not an answer", "name": "MUM", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 17, "kind": "action", "text": "Leon turns the wheel half a degree.", "para": 3, "sent": 0, "present": [0, 1, 2, 4]}, {"u": 18, "kind": "action", "text": "The boat leans.", "para": 3, "sent": 1, "present": [0, 1, 2, 4]}, {"u": 19, "kind": "action", "text": "Hoodie Guy lifts his hood back and looks at her, then at Leon, then at the sausage roll.", "para": 3, "sent": 2, "present": [0, 1, 2, 4]}, {"u": 20, "kind": "dialogue", "text": "She's got her mum on speaker", "name": "HOODIE GUY", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 4]}, {"u": 21, "kind": "dialogue", "text": "Shes not on speaker Leo", "name": "LEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "Its Leo.", "name": "THE WOMAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "Yeah Leo. He's my nephew. Leo, not Leon. Obviously.", "name": "LEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "dialogue", "text": "Everyone gets it wrong.", "name": "LEO", "speaker": 3, "ext": [], "paren": ["shrugging"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "dialogue", "text": "Who's Leo", "name": "MUM", "speaker": 2, "ext": ["V.O."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Nobody Mum bye", "name": "THE WOMAN", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "action", "text": "She ends the call.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "action", "text": "Silence.", "para": 4, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "action", "text": "The engine thrums.", "para": 4, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "dialogue", "text": "Im Hannah by the way. You never asked.", "name": "THE WOMAN", "speaker": 4, "ext": ["CONT'D"], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "dialogue", "text": "I didnt want to rush it", "name": "LEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "dialogue", "text": "You rushed the boat", "name": "HANNAH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "The boat was an emergency", "name": "LEON", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 34, "kind": "dialogue", "text": "I was on the pier for ten minutes and you said and I quote get in", "name": "HANNAH", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 35, "kind": "dialogue", "text": "And you did.", "name": "LEON", "speaker": 0, "ext": [], "paren": ["smiling at the horizon"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 36, "kind": "dialogue", "text": "^ LEO Get a room.", "name": "HANNAH", "speaker": 4, "ext": [], "paren": ["simultaneously, mouth full"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 37, "kind": "action", "text": "Hannah throws a glove at Leo.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 38, "kind": "action", "text": "He catches it.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 39, "kind": "action", "text": "Leon laughs and the boat rolls once, and Hannah steadies herself on his arm.", "para": 5, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 40, "kind": "action", "text": "She doesn't take her hand away.", "para": 5, "sent": 3, "present": [0, 1, 2, 3, 4]}, {"u": 41, "kind": "action", "text": "Gulls.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}]}