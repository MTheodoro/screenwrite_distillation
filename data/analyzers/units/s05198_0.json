ual": false, "present": [0, 1, 3, 4]}, {"u": 38, "kind": "dialogue", "text": "Mom said you needed support.", "name": "BRETT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3, 4]}, {"u": 39, "kind": "dialogue", "text": "Mom said that?", "name": "BRAD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3, 4]}, {"u": 40, "kind": "dialogue", "text": "She said you looked \"fragile.\"", "name": "BRETT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3, 4]}, {"u": 41, "kind": "dialogue", "text": "He does.", "name": "BRENDA", "speaker": 0, "ext": [], "paren": ["not looking up"], "dual": false, "present": [0, 1, 3, 4]}, {"u": 42, "kind": "action", "text": "ON PHONE: Brad's screen lights.", "para": 6, "sent": 0, "present": [0, 1, 3, 4]}, {"u": 43, "kind": "action", "text": "A text from an unknown number.", "para": 6, "sent": 1, "present": [0, 1, 3, 4]}, {"u": 44, "kind": "action", "text": "ON PHONE: \"dont let him in the room. hes not who u think.\"", "para": 7, "sent": 0, "present": [0, 1, 3, 4]}, {"u": 45, "kind": "dialogue", "text": "Oh.", "name": "BRAD", "speaker": 3, "ext": [], "paren": ["reading, pale"], "dual": false, "present": [0, 1, 3, 4]}, {"u": 46, "kind": "dialogue", "text": "What?", "name": "BRETT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3, 4]}, {"u": 47, "kind": "dialogue", "text": "Nothing. Spam.", "name": "BRAD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3, 4]}, {"u": 48, "kind": "dialogue", "text": "Let me see.", "name": "BRETT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3, 4]}, {"u": 49, "kind": "dialogue", "text": "No.", "name": "BRAD", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3, 4]}, {"u": 50, "kind": "dialogue", "text": "Brad.", "name": "BRETT", "speaker": 4, "ext": [], "paren": [], "dual": false, "present": [0, 1, 3, 4]}, {"u": 51, "kind": "action", "text": "They grapple for the phone, Brett lunges, Brad ducks, the bouquet goes flying and lands in the fish tank.", "para": 8, "sent": 0, "present": [0, 1, 3, 4]}, {"u": 52, "kind": "action", "text": "The fish, for the first time, looks interested.", "para": 8, "sent": 1, "present": [0, 1, 3, 4]}, {"u": 53, "kind": "dialogue", "text": "That's a four-hundred-dollar fish.", "name": "BRENDA", "speaker": 0, "ext": [], "paren": ["sighs"], "dual": false, "present": [0, 1, 3, 4]}]}