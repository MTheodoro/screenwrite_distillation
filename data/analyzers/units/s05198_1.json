{"scene_id": "s05198_1", "source": "/home/user/screenwrite-analyzers/data/analyzers/gen/scenes/s05198.fountain", "heading": "INT. NEW BEGINNINGS FERTILITY CLINIC - EXAM ROOM - CONTINUOUS", "cast": [{"id": 0, "name": "MARA", "names": ["MARA"], "gender": "f", "first": 1, "spoke": 4}, {"id": 1, "name": "DR. VANCE", "names": ["DR. VANCE"], "gender": "m", "first": 2, "spoke": 6}, {"id": 2, "name": "BRAD", "names": ["BRAD"], "gender": "m", "first": 17, "spoke": 2}, {"id": 3, "name": "BRETT", "names": ["BRETT"], "gender": "m", "first": 17, "spoke": 3}, {"id": 4, "name": "BRENDA", "names": ["BRENDA"], "gender": "f", "first": 15, "spoke": 2}], "units": [{"u": 0, "kind": "heading", "text": "INT. NEW BEGINNINGS FERTILITY CLINIC - EXAM ROOM - CONTINUOUS", "present": []}, {"u": 1, "kind": "action", "text": "Mara on the table, paper gown.", "para": 0, "sent": 0, "present": [0]}, {"u": 2, "kind": "action", "text": "Dr. Vance snaps on gloves, humming.", "para": 0, "sent": 1, "present": [0, 1]}, {"u": 3, "kind": "action", "text": "On the counter, a vial with a handwritten label.", "para": 0, "sent": 2, "present": [0, 1]}, {"u": 4, "kind": "action", "text": "She squints at it.", "para": 0, "sent": 3, "present": [0, 1]}, {"u": 5, "kind": "dialogue", "text": "That says Feldman.", "name": "MARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 6, "kind": "dialogue", "text": "It does.", "name": "DR. VANCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 7, "kind": "dialogue", "text": "Which Feldman?", "name": "MARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 8, "kind": "dialogue", "text": "The one who's paying.", "name": "DR. VANCE", "speaker": 1, "ext": [], "paren": ["gently"], "dual": false, "present": [0, 1]}, {"u": 9, "kind": "action", "text": "A pause.", "para": 1, "sent": 0, "present": [0, 1]}, {"u": 10, "kind": "action", "text": "Mara sits up.", "para": 1, "sent": 1, "present": [0, 1]}, {"u": 11, "kind": "dialogue", "text": "Doctor, which one is it?", "name": "MARA", "speaker": 0, "ext": [], "paren": [], "dual": false, "present": [0, 1]}, {"u": 12, "kind": "dialogue", "text": "Does it matter?", "name": "DR. VANCE", "speaker": 1, "ext": [], "paren": ["his smile never moves"], "dual": false, "present": [0, 1]}, {"u": 13, "kind": "action", "text": "The lights flicker.", "para": 2, "sent": 0, "present": [0, 1]}, {"u": 14, "kind": "action", "text": "Out in the waiting room, the fish tank bubbles.", "para": 2, "sent": 1, "present": [0, 1]}, {"u": 15, "kind": "action", "text": "Brenda, alone at her desk, quietly locks the front door.", "para": 2, "sent": 2, "present": [0, 1, 4]}, {"u": 16, "kind": "action", "text": "This is the last time anyone will ask that question.", "para": 3, "sent": 0, "present": [0, 1, 4]}, {"u": 17, "kind": "action", "text": "Brad and Brett burst through the inner door, panting, the soggy bouquet still in Brett's hand.", "para": 4, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 18, "kind": "dialogue", "text": "Mara, don't let him", "name": "BRAD", "speaker": 2, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 19, "kind": "dialogue", "text": "Honey, it's not what", "name": "BRETT", "speaker": 3, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 20, "kind": "dialogue", "text": "Gentlemen, please, this is a sterile environment.", "name": "DR. VANCE", "speaker": 1, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 21, "kind": "dialogue", "text": "Which of you?", "name": "MARA", "speaker": 0, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 22, "kind": "dialogue", "text": "It wasn't me!", "name": "BRAD", "speaker": 2, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 23, "kind": "dialogue", "text": "It was supposed to be a gift!", "name": "BRETT", "speaker": 3, "ext": [], "paren": ["overlapping"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 24, "kind": "action", "text": "Mara looks at one, then the other, then at the vial, then at Dr. Vance, who has quietly slipped a hand into his coat pocket.", "para": 5, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 25, "kind": "action", "text": "A cold gleam of metal.", "para": 5, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 26, "kind": "dialogue", "text": "Everyone stay very calm.", "name": "DR. VANCE", "speaker": 1, "ext": [], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 27, "kind": "dialogue", "text": "Doctor, your two o'clock is here!", "name": "BRENDA", "speaker": 4, "ext": ["O.S."], "paren": ["through the door"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 28, "kind": "dialogue", "text": "Reschedule her.", "name": "DR. VANCE", "speaker": 1, "ext": [], "paren": ["without turning"], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 29, "kind": "dialogue", "text": "She says she's the police.", "name": "BRENDA", "speaker": 4, "ext": ["O.S."], "paren": [], "dual": false, "present": [0, 1, 2, 3, 4]}, {"u": 30, "kind": "action", "text": "Everyone freezes.", "para": 6, "sent": 0, "present": [0, 1, 2, 3, 4]}, {"u": 31, "kind": "action", "text": "Dr. Vance's smile finally falls off his face.", "para": 6, "sent": 1, "present": [0, 1, 2, 3, 4]}, {"u": 32, "kind": "action", "text": "Brett holds up the soggy bouquet like a white flag.", "para": 6, "sent": 2, "present": [0, 1, 2, 3, 4]}, {"u": 33, "kind": "dialogue", "text": "Can I go now?", "name": "BRETT", "speaker": 3, "ext": [], "paren": ["whispering"], "dual": false, "present": [0, 1, 2, 3, 4]}]}